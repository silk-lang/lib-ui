#!/usr/bin/env node
// The last linker stack-size wins over Silk's default 1 MiB.
import { spawnSync } from 'node:child_process';
const args = process.argv.slice(2);
if (!args.some(arg => ['-c', '-S', '-E', '-v', '--version'].includes(arg))) args.push('-Wl,-z,stack-size=8388608');
const result = spawnSync(process.env.SILK_REAL_CLANG || process.env.SILK_CLANG || 'clang', args, { stdio: 'inherit' });
if (result.error) throw result.error;
process.exit(result.status ?? 1);
