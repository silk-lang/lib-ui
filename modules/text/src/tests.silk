//! Text system tests over the Noto, Amiri and M+ subsets in modules/text/tests/fonts: fallback by
//! coverage, line breaking with real advances, glyph runs behind fragments, run sharing and
//! hyphenation. `silk task browser chrome-text` checks positions in Chrome.
import system { TextSystem }
import fonts { TextStyle }
import set { FaceRule, FaceState, UnicodeRange }
import font_collection.lib { FontCollection, Family, Range }
import layout.lib as Engine
import layout.lib {
  Style,
  Dimension,
  Tree,
  LayoutTree,
  OptionalSize,
  InvalidNode,
  TextError,
  FragmentationError,
  FragmentKind,
  TextFragment
}

static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.platform.windows.host_input { WindowsHostInput }
  import silk.system.host_input { HostInput }
  import silk.collections.slice { Slice }
} else {
  import silk.platform.native.host_input { NativeHostInput }
}

import silk.system.host_input { HostInputError }
import silk.system.filesystem { Path, FileSystem, FileError }
import silk.system.filesystem_native { OsFileSystem }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.text.string { String }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.num.f32
import silk.num.usize

const SANS: string = "modules/text/tests/fonts/NotoSans-Regular.subset.ttf"

const ARABIC: string = "modules/text/tests/fonts/Amiri-Regular.subset.ttf"

const JAPANESE: string = "modules/text/tests/fonts/MPLUS1p-Regular.subset.ttf"

const SERIF: string = "modules/text/tests/fonts/NotoSerif-Regular.subset.ttf"

const BOLD: string = "modules/text/tests/fonts/NotoSans-Bold.subset.ttf"

effect fn workingDirectory() -> Bytes
  ! HostInputError | OutOfMemoryError
  ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    let mut inputs = run WindowsHostInput.capture()
    let directory = run HostInput.workingDirectory() |> Effect.provideMut<HostInput>(&mut inputs)
    return run plainName(move directory)
  } else {
    return run NativeHostInput.workingDirectory()
  }
}

static if Intrinsic.targetOperatingSystem() == "windows" {
  // `silk test` starts tests in an extended working directory (`\\?\C:\...`), which
  // OsFileSystem rejects as a root (silk#3042); use the plain drive or UNC name.
  effect fn plainName(directory: Bytes) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let bytes = Bytes.asSlice(&directory)
    if bytes.length <= 4 || bytes[0] != 92 || bytes[1] != 92 || bytes[2] != 63 || bytes[3] != 92 { return move directory }
    if bytes.length > 8 && bytes[4] == 85 && bytes[5] == 78 && bytes[6] == 67 && bytes[7] == 92 {
      let mut share = run Bytes.copy(b"\\\\")
      run Bytes.append(&mut share, Slice.view(bytes, 8, bytes.length - 8))
      return move share
    }
    return run Bytes.copy(Slice.view(bytes, 4, bytes.length - 4))
  }
}

/// Reads a file relative to the repository root (tests run from there).
effect fn readFile(relative: string) -> Bytes
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let cwd = run workingDirectory()
  let root = run Path.root()
  let path = run Path.resolve(&root, relative)
  let mut files = run OsFileSystem.makeBytes(Bytes.asSlice(&cwd))
  return run FileSystem.readFile(&path) |> Effect.provideMut<FileSystem>(&mut files)
}

effect fn fonts() -> FontCollection
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let mut collection = FontCollection.make()
  drop run collection.add(run readFile(SANS))
  drop run collection.add(run readFile(ARABIC))
  drop run collection.add(run readFile(JAPANESE))
  return move collection
}

effect fn sans(size: f32) -> TextStyle
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut families = List<Family>.make()
  run families.append(run Family.named(String.utf8Bytes("Noto Sans")))
  return TextStyle.make(move families, size)
}

/// Lays `text` out in a block `width` wide with font key `key`.
effect fn layout(system: &mut TextSystem<'_>, key: usize, width: f32, text: string) -> LayoutTree
  ! OutOfMemoryError | InvalidNode | TextError | FragmentationError
  ? &mut Allocator {
  let mut root = Style.make()
  root.width = Dimension.px(width)
  root.fontKey = key
  let mut tree = run Tree.make(move root)
  let value = run String.copy(text)
  let rootId = tree.root()
  drop run tree.appendText(rootId, move value)
  let mut output = LayoutTree.make()
  run Engine.compute(&tree, &mut output, &mut system, OptionalSize.definite(width, 100000.0))
  output.fragments.resolveLocations()
  return move output
}

/// The text fragments of `output`, with their y positions.
effect fn texts(output: &LayoutTree, out: &mut List<TextFragment>, ys: &mut List<f32>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  out.clear()
  ys.clear()
  let fragments = output.fragments.values.asSlice()
  let mut index: usize = 0
  while index < fragments.length {
    let fragment = &fragments[index]
    if fragment.kind == FragmentKind.Text && fragment.textData != usize.MAX {
      run out.append(output.fragments.texts.get(fragment.textData))
      run ys.append(fragment.worldLocation.y)
    }
    index = index + 1
  }
}

fn near(a: f32, b: f32) -> bool {
  return f32.abs(a - b) < 0.01
}

effect fn fontMetricsComeFromTheFaceBody() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fonts()
  run Testing.expect(collection.faceCount() == 3, "three faces load")
  let mut system = TextSystem.make(&collection)
  let key = run system.addStyle(run sans(16.0))
  let info = system.keyInfo(key)
  run Testing.expect(info.face == 0, "Noto Sans is face 0")
  let metrics = system.fonts.metricsOf(key)

  // Noto Sans: ascender 1069, descender -293 at 1000 units per em.
  run Testing.expect(metrics.ascent > 16.0 && metrics.ascent < 18.0, "ascent is about 1.07 em")
  run Testing.expect(metrics.descent > 4.0 && metrics.descent < 6.0, "descent is about 0.29 em")
}

effect fn latinTextWrapsAtWordBoundariesBody() -> ()
  ! AssertionError<'static>
    | FileError
    | HostInputError
    | OutOfMemoryError
    | InvalidNode
    | TextError
    | FragmentationError
  ? &mut Allocator {
  let collection = run fonts()
  let mut system = TextSystem.make(&collection)
  let key = run system.addStyle(run sans(16.0))
  let wide = run layout(&mut system, key, 1000.0, "The quick brown fox jumps")
  let mut found = List<TextFragment>.make()
  let mut ys = List<f32>.make()
  run texts(&wide, &mut found, &mut ys)
  run Testing.expect(found.length() > 1, "fragments split at word boundaries")
  let mut index: usize = 1
  while index < found.length() {
    run Testing.expect(ys.get(index) == ys.get(0), "a wide block keeps one line")
    index = index + 1
  }
  run Testing.expect(found.get(0).sourceStart == 0, "the line starts at the text start")
  run Testing.expect(found.get(found.length() - 1).sourceEnd == 25, "the line ends at the text end")
  let narrow = run layout(&mut system, key, 60.0, "The quick brown fox jumps")
  run texts(&narrow, &mut found, &mut ys)
  let mut lines: usize = 1
  index = 1
  while index < found.length() {
    run Testing.expect(ys.get(index) >= ys.get(index - 1), "lines go down the page")
    if ys.get(index) > ys.get(index - 1) {
      lines = lines + 1
    }
    let previous = found.get(index - 1)
    run Testing.expect(
      found.get(index).sourceStart >= previous.sourceEnd,
      "fragments follow source order",
    )
    index = index + 1
  }
  run Testing.expect(lines >= 3, "a narrow block wraps onto several lines")
}

effect fn fallbackPicksTheFaceThatHasTheCharactersBody() -> ()
  ! AssertionError<'static>
    | FileError
    | HostInputError
    | OutOfMemoryError
    | InvalidNode
    | TextError
    | FragmentationError
  ? &mut Allocator {
  let collection = run fonts()
  let mut system = TextSystem.make(&collection)
  let key = run system.addStyle(run sans(20.0))
  let output = run layout(&mut system, key, 1000.0, "Hi مرحبا 漢字")
  let mut found = List<TextFragment>.make()
  let mut ys = List<f32>.make()
  run texts(&output, &mut found, &mut ys)
  let mut arabic = false
  let mut japanese = false
  let mut latin = false
  let mut index: usize = 0
  while index < found.length() {
    let fragment = found.get(index)
    let run_ = system.glyphRun(fragment.shapeKey)
    if run_.face == 1 {
      arabic = true
      run Testing.expect(fragment.bidiLevel == 1, "Arabic is right to left")
      run Testing.expect(run_.rtl, "the Arabic run is shaped right to left")
    } else if run_.face == 2 {
      japanese = true
    } else if run_.face == 0 {
      latin = true
    }
    run Testing.expect(
      system.keyInfo(fragment.fontKey).face == run_.face,
      "the fragment's font key names the run's face",
    )
    index = index + 1
  }
  run Testing.expect(latin && arabic && japanese, "each script falls back to a face that covers it")
}

effect fn glyphRunsMatchTheirFragmentsBody() -> ()
  ! AssertionError<'static>
    | FileError
    | HostInputError
    | OutOfMemoryError
    | InvalidNode
    | TextError
    | FragmentationError
  ? &mut Allocator {
  let collection = run fonts()
  let mut system = TextSystem.make(&collection)
  let key = run system.addStyle(run sans(16.0))
  let output = run layout(&mut system, key, 1000.0, "AVA office")
  let fragments = output.fragments.values.asSlice()
  let mut checked: usize = 0
  let mut index: usize = 0
  while index < fragments.length {
    let fragment = &fragments[index]
    if fragment.kind == FragmentKind.Text && fragment.textData != usize.MAX {
      let data = output.fragments.texts.get(fragment.textData)
      let glyphRun = system.glyphRun(data.shapeKey)
      let glyphs = system.runGlyphs(data.shapeKey)
      run Testing.expect(glyphs.length > 0, "the run has glyphs")
      run Testing.expect(
        near(glyphRun.advance, fragment.size.width),
        "the run advance is the fragment width",
      )
      run Testing.expect(glyphRun.size == 16.0, "the run keeps the font size")
      let mut pen: f32 = 0.0
      let mut at: usize = 0
      while at < glyphs.length {
        run Testing.expect(near(glyphs[at].x, pen), "glyphs sit at the running pen position")
        pen = pen + glyphs[at].advance
        at = at + 1
      }
      checked = checked + 1
    }
    index = index + 1
  }
  run Testing.expect(checked >= 2, "each word has a run")
}

effect fn identicalRunsShareAShapeKeyBody() -> ()
  ! AssertionError<'static>
    | FileError
    | HostInputError
    | OutOfMemoryError
    | InvalidNode
    | TextError
    | FragmentationError
  ? &mut Allocator {
  let collection = run fonts()
  let mut system = TextSystem.make(&collection)
  let key = run system.addStyle(run sans(16.0))
  let first = run layout(&mut system, key, 80.0, "same words here")
  let count = system.glyphs.length()
  let second = run layout(&mut system, key, 80.0, "same words here")
  run Testing.expect(system.glyphs.length() == count, "laying out the same text again adds no runs")
  let mut a = List<TextFragment>.make()
  let mut b = List<TextFragment>.make()
  let mut ys = List<f32>.make()
  run texts(&first, &mut a, &mut ys)
  run texts(&second, &mut b, &mut ys)
  run Testing.expect(a.length() == b.length(), "the same lines")
  let mut index: usize = 0
  while index < a.length() {
    run Testing.expect(a.get(index).shapeKey == b.get(index).shapeKey, "the same keys")
    index = index + 1
  }
  system.glyphs.clear()
  run Testing.expect(system.glyphs.length() == 0, "clear forgets every run")

  // Lines kept from before the clear hold keys of forgotten runs, so they are shaped again.
  let third = run layout(&mut system, key, 80.0, "same words here")
  run Testing.expect(system.glyphs.length() == count, "the text is shaped again after a clear")
  run texts(&third, &mut b, &mut ys)
  run Testing.expect(a.length() == b.length(), "the same lines after a clear")
  index = 0
  while index < b.length() {
    run Testing.expect(system.runGlyphs(b.get(index).shapeKey).length > 0, "the keys name live runs")
    index = index + 1
  }
}

effect fn softHyphensBreakAndShowAHyphenBody() -> ()
  ! AssertionError<'static>
    | FileError
    | HostInputError
    | OutOfMemoryError
    | InvalidNode
    | TextError
    | FragmentationError
  ? &mut Allocator {
  let collection = run fonts()
  let mut system = TextSystem.make(&collection)
  let key = run system.addStyle(run sans(16.0))

  // "extra\u{AD}ordinary": a block too narrow for the word breaks at the soft hyphen.
  let output = run layout(&mut system, key, 50.0, "extra\u{AD}ordinary")
  let mut found = List<TextFragment>.make()
  let mut ys = List<f32>.make()
  run texts(&output, &mut found, &mut ys)
  run Testing.expect(found.length() == 2, "the word breaks once")
  let head = found.get(0)
  let glyphs = system.runGlyphs(head.shapeKey)

  // Five letters plus the hyphen (the soft hyphen itself shapes to nothing visible).
  run Testing.expect(glyphs.length >= 6, "the first line ends in a hyphen glyph")
  run Testing.expect(ys.get(1) > ys.get(0), "the rest goes on the next line")
}

