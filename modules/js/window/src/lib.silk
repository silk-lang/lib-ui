//! A ui-js application as a client of the window host.
//!
//! [`JsApp`] holds the JavaScript host and the allocator its memory is counted on.
//! [`JsClient`] is the `WindowClient` that runs it: the entry module at start, event records
//! between the tree's `begin` and `finish`, timers and animation frames on the host's clock,
//! and console lines on standard error. An uncaught exception is printed as the browser
//! console prints it, and the window keeps running.
//!
//! What a production build does not need stays out of this package: reloading on a new
//! build and the development server are [`JsTools`] that the package `ui-js-window-dev`
//! provides. A production host runs [`NoTools`], so none of that code is in its program.
//!
//! ```silk
//! let domain = run WaiterDomain.make()
//! let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
//! let memory = run allocator.observe()
//! let mut app = run JsApp.open(&memory, move allocator, domain.handle())
//! run app.define(b"@silk/ui", library)
//! run app.entry(b"app.js", source)
//! let mut client = JsClient.make(NoTools {})
//! let status = run runWindow(&mut app, &fonts, List<Mutation>.make(), options, Inspector.off(), &mut client)
//! run app.close()
//! ```
import ui_js.lib { JsHost, JsError }
import opener { Openers }
import ui_tree.legacy { UiTree, TreeError }
import ui_tree_window.host { WindowClient }
import ui_tree_window.platform_thread { HostPlatform }
import ui_tree_window.console { StderrWriter }
import silkjs.js_atomics_native { Domain }
import silkjs.runtime_memory { RuntimeAllocator, AllocationObserver }
import window.types { WindowError, WindowId }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { Writer }
import silk.mem.allocator { Allocator, OutOfMemoryError, SystemAllocator }
import silk.text.string { String }

/// A module given to [`JsApp.define`], kept to define it again after a reload.
struct Defined {
  name: List<u8>,
  source: List<u8>,
}

/// A JavaScript application and what it runs on.
pub struct JsApp<'m> {
  host: JsHost<'m>,
  /// JavaScript memory is counted here, apart from the tree's and the window's.
  allocator: RuntimeAllocator<SystemAllocator>,
  memory: &'m AllocationObserver,
  domain: Domain,
  modules: List<Defined>,
  name: List<u8>,
  source: List<u8>,
  /// The system programs started for `window.open`.
  openers: Openers,
}

/// Writes `text` to standard error.
pub fn write(text: string) -> () {
  let mut out = StderrWriter.make()
  drop run Writer.writeString(text) |> Effect.provideMut<Writer>(&mut out) |> Effect.result
}

/// Prints an uncaught exception as a browser console does.
fn uncaught(error: JsError) -> () {
  let message = String.view(&error.message)
  write("Uncaught ")
  write(message)
  write("\n")
  // The usual cause of a missing global here is a web or Node API: say what a realm has.
  if String.startsWith(message, "ReferenceError: ") && String.endsWith(message, " is not defined") {
    write("  A ui-js realm has ECMAScript, timers, console and @silk/ui. It has no other web or Node API\n")
    write("  (fetch, URL, Intl, document, process and the like). @silk/vite lists the ones a build uses.\n")
  }
}

impl<'m> JsApp<'m> {
  /// A realm for one application. `allocator` is the one `memory` observes.
  pub effect fn open(memory: &'m AllocationObserver, allocator: RuntimeAllocator<SystemAllocator>, domain: Domain) -> JsApp<'m>
    ! OutOfMemoryError | JsError
    ? &mut Allocator {
    let mut own = move allocator
    let host = run JsHost.open(memory, domain) |> Effect.provideMut<Allocator>(&mut own)
    return JsApp {
      host: move host,
      allocator: move own,
      memory: memory,
      domain: domain,
      modules: List<Defined>.make(),
      name: List<u8>.make(),
      source: List<u8>.make(),
      openers: Openers.make(),
    }
  }

  /// Makes `source` importable as `name` (see `JsHost.define`).
  pub effect fn define(self: &mut Self, name: &[u8], source: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.host.define(name, source) |> Effect.provideMut<Allocator>(&mut self.allocator)
    let mut nameCopy = List<u8>.make()
    run nameCopy.appendSlice(name)
    let mut sourceCopy = List<u8>.make()
    run sourceCopy.appendSlice(source)
    run self.modules.append(Defined { name: move nameCopy, source: move sourceCopy })
  }

  /// The ES module the window runs when it starts.
  pub effect fn entry(self: &mut Self, name: &[u8], source: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
    self.name.clear()
    run self.name.appendSlice(name)
    self.source.clear()
    run self.source.appendSlice(source)
  }

  /// Replaces the entry's source, keeping its name; [`JsApp.startEntry`] runs it.
  pub fn replaceEntry(self: &mut Self, source: List<u8>) -> () {
    self.source = move source
  }

  /// The JavaScript host, for tools that talk to it directly.
  pub fn javascript(self: &mut Self) -> &mut JsHost<'m> {
    return &mut self.host
  }

  /// Frees the realm.
  pub effect fn close(self: &mut Self) -> () ? &mut Allocator {
    run self.host.close() |> Effect.provideMut<Allocator>(&mut self.allocator)
  }

  /// Runs the entry module and applies what it built.
  pub effect fn startEntry(self: &mut Self, tree: &mut UiTree<'_>) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
    let ran = run Effect.result(self.host.module(self.source.asSlice(), self.name.asSlice())) |> Effect.provideMut<Allocator>(&mut self.allocator)
    run self.settle(move ran)
    run self.host.flushRaw(&mut tree)
  }

  /// Runs `source` as a script named `name`, prints what it wrote and threw, and applies
  /// what it built.
  pub effect fn script(self: &mut Self, tree: &mut UiTree<'_>, source: &[u8], name: &[u8]) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
    let ran = run Effect.result(self.host.evaluate(source, name)) |> Effect.provideMut<Allocator>(&mut self.allocator)
    run self.settle(move ran)
    run self.host.flushRaw(&mut tree)
  }

  /// Hands `line`, a message from a development server, to JavaScript (`__ui.devMessage`),
  /// prints what it wrote and threw, and applies what it built.
  pub effect fn message(self: &mut Self, tree: &mut UiTree<'_>, line: string) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
    let handed = run Effect.result(self.host.devMessage(line)) |> Effect.provideMut<Allocator>(&mut self.allocator)
    run self.settle(move handed)
    run self.host.flushRaw(&mut tree)
  }

  /// Destroys the application's nodes and replaces the realm, with the modules given to
  /// [`JsApp.define`] defined again. Says whether there is a new realm; the window keeps
  /// the old one when there is not.
  pub effect fn fresh(self: &mut Self, tree: &mut UiTree<'_>) -> bool ! TreeError | OutOfMemoryError ? &mut Allocator {
    let unloaded = run Effect.result(self.host.unload()) |> Effect.provideMut<Allocator>(&mut self.allocator)
    run self.settle(move unloaded)
    run self.host.flushRaw(&mut tree)
    run self.host.close() |> Effect.provideMut<Allocator>(&mut self.allocator)
    let opened = run Effect.result(JsHost.open(self.memory, self.domain)) |> Effect.provideMut<Allocator>(&mut self.allocator)
    match move opened {
      Result<JsHost<'m>, OutOfMemoryError | JsError>.Success { value } => { self.host = move value }
      Result<JsHost<'m>, OutOfMemoryError | JsError>.Failure { error } => match move error {
        OutOfMemoryError allocation => { fail move allocation }
        JsError { message } => {
          uncaught(JsError { message: move message })
          return false
        }
      }
    }
    let items = self.modules.asSlice()
    let mut i: usize = 0
    while i < items.length {
      run self.host.define(items[i].name.asSlice(), items[i].source.asSlice()) |> Effect.provideMut<Allocator>(&mut self.allocator)
      i = i + 1
    }
    return true
  }

  /// Prints what JavaScript wrote to the console, and `outcome`'s exception when it failed.
  pub effect fn settle(self: &mut Self, outcome: Result<(), OutOfMemoryError | JsError>) -> () ! OutOfMemoryError {
    let logs = self.host.takeLogs()
    let lines = logs.asSlice()
    let mut i: usize = 0
    while i < lines.length {
      write(String.view(&lines[i].text))
      write("\n")
      i = i + 1
    }
    let opened = self.host.takeOpened()
    let addresses = opened.asSlice()
    i = 0
    while i < addresses.length {
      let address = String.utf8Bytes(String.view(&addresses[i]))
      let started = run self.openers.open(address) |> Effect.provideMut<Allocator>(&mut self.allocator)
      if !started {
        write("Could not open ")
        write(String.view(&addresses[i]))
        write("\n")
      }
      i = i + 1
    }
    match move outcome {
      Result<(), OutOfMemoryError | JsError>.Success { .. } => ()
      Result<(), OutOfMemoryError | JsError>.Failure { error } => match move error {
        OutOfMemoryError allocation => { fail move allocation }
        JsError { message } => { uncaught(JsError { message: move message }) }
      }
    }
  }

  /// Delivers the tree's queued records and reports the listener exceptions. Says whether a
  /// listener prevented a default.
  effect fn handle(self: &mut Self, tree: &mut UiTree<'_>) -> bool ! TreeError | OutOfMemoryError ? &mut Allocator {
    let delivered = run Effect.result(self.host.deliverRaw(&mut tree)) |> Effect.provideMut<Allocator>(&mut self.allocator)
    let mut prevented = false
    let outcome = match move delivered {
      Result<bool, OutOfMemoryError | JsError>.Success { value } => {
        prevented = value
        run Effect.result(self.host.report()) |> Effect.provideMut<Allocator>(&mut self.allocator)
      }
      Result<bool, OutOfMemoryError | JsError>.Failure { error } => Result<(), OutOfMemoryError | JsError>.Failure { error: move error }
    }
    run self.settle(move outcome)
    run self.host.flushRaw(&mut tree)
    return prevented
  }
}

/// What a window adds to an application beyond running it: reloading it when a new build
/// arrives, taking it from a development server. A production build has none ([`NoTools`]);
/// `ui-js-window-dev` has the development ones.
pub interface JsTools {
  /// Whether the window runs the entry given to [`JsApp.entry`] when it starts. A tool that
  /// brings the application itself (a development server) says no.
  fn startsEntry(self: &Self) -> bool { return true }
  /// The window is open. `platform` wakes the window's loop.
  effect fn opened<'m>(self: &mut Self, app: &mut JsApp<'m>, platform: &HostPlatform) -> () ! OutOfMemoryError ? &mut Allocator {}
  /// Called on every turn of the window's loop. Says whether it changed the tree.
  effect fn poll<'m>(self: &mut Self, app: &mut JsApp<'m>, tree: &mut UiTree<'_>, time: f64) -> bool ! TreeError | OutOfMemoryError ? &mut Allocator { return false }
  /// How soon the loop should turn again for [`JsTools.poll`], in seconds, or none.
  fn wakeAfter(self: &Self) -> Option<f64> { return Option<f64>.None }
  /// Whether the window serves the inspector. When it does not, the window host's
  /// inspector code is left out of the program.
  fn servesInspector(self: &Self) -> bool { return false }
}

/// No tools: the application runs as it was built. What a production build uses.
pub struct NoTools {}

impl JsTools for NoTools {}

/// The window client of a [`JsApp`], with the tools `T`.
pub struct JsClient<T> {
  pub tools: T,
}

impl<T: JsTools> JsClient<T> {
  pub fn make(tools: T) -> JsClient<T> {
    return JsClient<T> { tools: move tools }
  }
}

impl<'m, T: JsTools> WindowClient<JsApp<'m>, never, never> for JsClient<T> {
  effect fn start(self: &mut Self, state: &mut JsApp<'m>, tree: &mut UiTree<'_>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if self.tools.startsEntry() { run state.startEntry(&mut tree) }
  }

  effect fn opened(self: &mut Self, state: &mut JsApp<'m>, platform: &mut HostPlatform, window: WindowId) -> ()
    ! WindowError | OutOfMemoryError
    ? &mut Allocator {
    run self.tools.opened(&mut state, &platform.*)
  }

  effect fn poll(self: &mut Self, state: &mut JsApp<'m>, tree: &mut UiTree<'_>, time: f64) -> bool
    ! WindowError | TreeError | OutOfMemoryError
    ? &mut Allocator {
    return run self.tools.poll(&mut state, &mut tree, time)
  }

  fn wakeAfter(self: &Self, state: &JsApp<'m>) -> Option<f64> {
    return self.tools.wakeAfter()
  }

  fn servesInspector(self: &Self) -> bool {
    return self.tools.servesInspector()
  }

  effect fn pump(self: &mut Self, state: &mut JsApp<'m>, tree: &mut UiTree<'_>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    drop run state.handle(&mut tree)
  }

  effect fn decide(self: &mut Self, state: &mut JsApp<'m>, tree: &mut UiTree<'_>) -> bool
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    return run state.handle(&mut tree)
  }

  effect fn tick(self: &mut Self, state: &mut JsApp<'m>, tree: &mut UiTree<'_>, time: f64, animation: bool) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let ran = run Effect.result(state.host.tick(time, animation)) |> Effect.provideMut<Allocator>(&mut state.allocator)
    run state.settle(move ran)
    run state.host.flushRaw(&mut tree)
  }

  fn nextDeadline(self: &Self, state: &JsApp<'m>) -> Option<f64> {
    return state.host.nextDeadline()
  }

  fn wantsFrames(self: &Self, state: &JsApp<'m>) -> bool {
    return state.host.wantsFrame()
  }
}
