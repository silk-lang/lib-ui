#!/usr/bin/env python3
"""Prepares the SilkJS runtime that ui-js-node builds against.

The runtime's built-in JavaScript (src/runtime/embedded.silk) and its native libraries
(build/native: libuv, OpenSSL, nghttp2, zstd, Brotli, uvwasi, WAMR) are made by its own
tools/build.py, not by Silk. This runs `tools/build.py --prepare` in the copy of lib-silkjs that
Silk fetched for modules/js/node/silk.toml, once per revision. It needs what that script needs:
pkg-config finding static libuv, OpenSSL, nghttp2, zstd and Brotli (see lib-silkjs's
modules/runtime/README.md).

    python3 modules/js/node/scripts/prepare [--release]
"""
import os
from pathlib import Path
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[4]
MANIFEST = ROOT / 'modules/js/node/silk.toml'


def runtime_directory():
    text = MANIFEST.read_text()
    found = re.search(r'node_runtime = \{ (?:git = "[^"]+", rev = "([0-9a-f]+)", path = "([^"]+)"|path = "([^"]+)")', text)
    if found is None:
        raise SystemExit(f'{MANIFEST} names no node_runtime dependency')
    if found.group(3):
        return (MANIFEST.parent / found.group(3)).resolve()
    rev, path = found.group(1), found.group(2)
    directory = Path(os.environ.get('SILK_HOME', Path.home() / '.silk')) / 'git' / rev / path
    if not directory.is_dir():
        # A check fetches the dependency; it fails until the runtime is prepared.
        subprocess.run(['silk', 'check', '--no-server', '--manifest-path', str(MANIFEST), '--quiet'], cwd=ROOT, capture_output=True)
    if not directory.is_dir():
        raise SystemExit(f'Silk did not fetch lib-silkjs {rev} to {directory}')
    return directory


def main():
    directory = runtime_directory()
    if (directory / 'build/prepared').is_file() and (directory / 'src/runtime/embedded.silk').is_file():
        print(f'{directory} is prepared')
        return
    command = [sys.executable, 'tools/build.py', '--prepare', *sys.argv[1:]]
    subprocess.run(command, cwd=directory, check=True)
    (directory / 'build/prepared').write_text('')
    print(f'prepared {directory}')


if __name__ == '__main__':
    main()
