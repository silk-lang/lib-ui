#!/usr/bin/env python3
"""Runs the network check of ui-js-node: fixtures/net.js in the runtime-backed realm against
fixtures/server.mjs on 127.0.0.1.

    python3 modules/js/node/scripts/check <ui-js-node-check binary>

Build the binary first: silk build --manifest-path modules/js/node/tests/silk.toml (it lands in
modules/js/node/tests/build/llvm/<target>/debug/ui-js-node-check).
"""
import os
from pathlib import Path
import subprocess
import sys

TESTS = Path(__file__).resolve().parents[1] / 'tests'


def main():
    if len(sys.argv) != 2:
        raise SystemExit(__doc__)
    binary = Path(sys.argv[1]).resolve()
    server = subprocess.Popen(['node', str(TESTS / 'fixtures/server.mjs')], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
    try:
        port = server.stdout.readline().strip()
        if not port.isdigit():
            raise SystemExit('the test server did not start')
        result = subprocess.run([str(binary), str(TESTS / 'fixtures/net.js')], env={**os.environ, 'SILK_TEST_PORT': port},
                                capture_output=True, text=True, timeout=120, stdin=subprocess.DEVNULL)
    finally:
        server.stdin.close()
        server.wait(timeout=10)
    if result.returncode != 0:
        print(f'ui-js-node network check failed: status {result.returncode}')
        print('stdout:\n' + result.stdout)
        print('stderr:\n' + result.stderr)
        sys.exit(1)
    print('ui-js-node network check passed')


if __name__ == '__main__':
    main()
