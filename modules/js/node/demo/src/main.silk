//! A ui-js application on the SilkJS runtime, in a window: `ui-js-node-demo [--check] [entry.js]`.
//! Without an entry it runs the starter page, `modules/js/demo/app.js` from the repository's
//! root. --check is the window host's GPU smoke test: it clicks the counter and expects
//! CLICKED.
import ui_js.lib { uiPackage }
import ui_js_node.lib { NodeWindow, NodeClient }
import ui_tree.legacy { TreeError }
import ui_tree_window.host { RunOptions, StartedGpu, startGpu }
import ui_tree_window.platform_thread { Launched, launch }
import ui_tree_window.console { StderrWriter }
import ui_fixtures.fixtures as fixtures
import font_collection.lib { Generic }
import silkjs.js_atomics_native { SynchronizationError }
import silkjs.js_libc_platform as platform
import window.types { WindowError, TitleBar }
import webgpu.runtime { GpuError }
import atlas.atlas { AtlasError }
import vector.geometry_error { GeometryError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.host_input { HostInput }

effect fn program(check: bool, entry: &[u8], launched: Option<Launched>) -> i32
  ! TreeError | WindowError | GpuError | AtlasError | GeometryError | OutOfMemoryError | SynchronizationError | platform.PlatformError
  ? &mut Allocator {
  let gpu = run startGpu(check)
  let mut fonts = run fixtures.fonts()
  run fonts.addGeneric(Generic.SansSerif, b"Noto Sans")
  run fonts.addGeneric(Generic.SystemUi, b"Noto Sans")
  run fonts.addGeneric(Generic.Monospace, b"Geist Mono")
  let mut client = NodeClient.make()
  client.titleBar = TitleBar.Transparent
  client.titleBarHeight = 56.0
  let options = RunOptions {
    title: "Silk UI",
    width: 1040.0,
    height: 720.0,
    check: check,
    checkClick: "counter",
    checkExpect: "CLICKED",
    lowestLatency: false,
    platform: move launched,
    gpu: Option<StartedGpu>.some(move gpu),
  }
  let mut window = NodeWindow.make(&fonts, move options, move client)
  run window.define(b"@silk/ui", uiPackage())
  let mut source = List<u8>.make()
  if entry.length == 0 { source = run platform.readFile(b"modules/js/demo/app.js") } else { source = run platform.readFile(entry) }
  run window.entry(b"/ui-js-node-demo/app.js", source.asSlice())
  return run window.start(b"ui-js-node-demo")
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  StderrWriter.print("The JavaScript window host failed\n", &())
  return 2
}

effect fn noArgument<E>(error: E) -> Option<Bytes> {
  drop error
  return Option<Bytes>.None
}

effect fn noArguments<E>(error: E) -> usize {
  drop error
  return 0
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] { return false }
    i = i + 1
  }
  return true
}

fn runApp(check: bool, entry: Bytes, launched: Option<Launched>) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(program(check, Bytes.asSlice(&entry), move launched), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

pub effect fn main() -> i32 ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let count = run Effect.catchAll(HostInput.argumentCount(), noArguments)
  let mut check = false
  let mut entry = Bytes.make()
  let mut i: usize = 1
  while i < count {
    if let Option<Bytes>.Some { value } = run Effect.catchAll(HostInput.argument(i), noArgument) |> Effect.provideMut<Allocator>(&mut allocator) {
      if same(Bytes.asSlice(&value), b"--check") { check = true } else { entry = move value }
    }
    i = i + 1
  }
  let checking = check
  let path = move entry
  // The main thread keeps the OS event loop; the application and the runtime run on their own.
  return run Effect.catchAll(
    launch(fn(launched: Option<Launched>) -> i32 { return runApp(checking, move path, move launched) }),
    failed,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}
