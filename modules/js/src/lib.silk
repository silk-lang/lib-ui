//! A JavaScript application on a UI tree, with the SilkJS engine embedded in the process.
//!
//! JavaScript runs on the thread that owns the tree. It builds nodes through native functions
//! that append to one ui-protocol batch, and it receives each event between the tree's `begin`
//! and `finish`, so `preventDefault()` in a handler decides that event's default action. Start
//! at [`JsHost`].
pub import host { JsHost, JsError, kindCode, numbersOf, firstString, secondString, thirdString, fourthString }
pub import bridge { Bridge, LogEntry, Outcome }
import generated_library { library }

/// The source of the `@silk/ui` package ([packages/ui](../packages/ui)), for a host to
/// define in its realm: `app.define(b"@silk/ui", uiPackage())`. It is part of the program,
/// so a host does not read it from disk.
pub fn uiPackage() -> &'static [u8] {
  return library()
}
