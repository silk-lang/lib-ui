//! The native half of the bridge: what the engine calls when JavaScript calls `__ui.*`.
//!
//! Every node call appends to one batch and returns; nothing reaches the tree until the host
//! flushes. The functions take plain numbers and strings, so a call costs tens of nanoseconds.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.collections.slice { Slice }
import silk.num.i32
import silk.num.f64
import ui_tree.css { Declaration }
import ui_tree.legacy { Batch, NodeKind, Attribute, Mutation, StyleState, Cursor, Keyframe, Role }
import css_style.tokens { CssError }
import css_style.written as written
import silkjs.js_engine { Engine }
import silkjs.js_engine_host { EngineServices }
import silkjs.js_value { ValueBits }
import silkjs.js_realm { Realm, Arguments }
import silkjs.js_owned_value { ValueRef }
import silkjs.js_exceptions { JsException }
import silkjs.js_strings { Strings }
import silkjs.js_core_types { NativeFunctionId, NativeErrorKind, ModuleDef }
import silkjs.js_heap { CellRef }
import silkjs.js_coercion_host { CoercionHooks }
import silkjs.js_eval as evaluation
import silkjs.js_eval_compile as flags

/// `__ui.create(id, kind)`: kind 0 is a box, 1 text, 2 an input, 3 an image, 4 an icon,
/// 5 a canvas.
pub const CREATE: u32 = 1
/// `__ui.append(parent, child)`.
pub const APPEND: u32 = 2
/// `__ui.insertBefore(parent, child, before)`.
pub const INSERT_BEFORE: u32 = 3
/// `__ui.root(id)`.
pub const ROOT: u32 = 4
/// `__ui.setText(id, value)`.
pub const SET_TEXT: u32 = 5
/// `__ui.listen(id, flags)`: the ui-protocol `LISTEN_*` flags.
pub const LISTEN: u32 = 6
/// `__ui.style(id, css, state)`: sets the declarations of `css` (`"width: 10px; color: red"`)
/// in a look of the node. State 0 is the base look, 1 hover, 2 active, 3 focus, 4
/// focus-visible. Declarations that do not parse are dropped, as in CSS.
pub const STYLE: u32 = 7
/// `__ui.clearStyle(id, state)`: forgets every declaration of that look.
pub const CLEAR_STYLE: u32 = 8
/// `__ui.attribute(id, name, value)`. Throws a `TypeError` for a name the tree does not have.
/// `role` takes ARIA role text and returns whether one of its words is a role the tree has
/// (the node has no role otherwise). `__ui.attribute(id, "valueRange", min, max, now)` sets
/// the value range, and without numbers clears it.
pub const ATTRIBUTE: u32 = 9
/// `__ui.focus(id)`.
pub const FOCUS: u32 = 10
/// `__ui.remove(id)`: detaches the node and its subtree; it can be inserted again.
pub const REMOVE: u32 = 11
/// `__ui.destroy(id)`: detaches and frees the node and its subtree.
pub const DESTROY: u32 = 12
/// `__ui.scrollTo(id, x, y)`.
pub const SCROLL_TO: u32 = 13
/// `__ui.select(id, anchor, focus)`: UTF-8 byte offsets in an input's value.
pub const SELECT: u32 = 14
/// `__ui.log(level, text)`: a console line. Level 0 is debug, 1 log, 2 warn, 3 error.
pub const LOG: u32 = 15
/// `__ui.now()`: the host's clock in milliseconds, as `performance.now()`.
pub const NOW: u32 = 16
/// `__ui.timer(id, delay)`: asks for `__ui.fire(id)` once, `delay` milliseconds from now.
/// Asking again for the same id moves it.
pub const TIMER: u32 = 17
/// `__ui.cancelTimer(id)`.
pub const CANCEL_TIMER: u32 = 18
/// `__ui.requestFrame()`: asks for `__ui.frame(time)` before the next frame.
pub const REQUEST_FRAME: u32 = 19
/// `__ui.devSend(line)`: a line for the development server the host is connected to.
pub const DEV_SEND: u32 = 20
/// `__ui.devReload()`: asks the host to start a new realm and run the application again.
pub const DEV_RELOAD: u32 = 21
/// `__ui.fontFamily(id, names)`: defines family list `id` from CSS `font-family` text, for
/// `font-family: <id>` in a style.
pub const FONT_FAMILY: u32 = 22
/// `__ui.open(url)`: asks the host to open an address outside the application.
pub const OPEN: u32 = 23
/// `__ui.defineIcon(resource, markup)`: parses SVG markup as icon resource `resource`.
pub const DEFINE_ICON: u32 = 24
/// `__ui.source(id, resource)`: points an image or icon node at a resource.
pub const SOURCE: u32 = 25
/// `__ui.release(resource)`: forgets a resource no node shows any more.
pub const RELEASE: u32 = 26
/// `__ui.keyframe(offset, css)`: adds a frame (offset 0 to 1, CSS declarations) to the
/// `@keyframes` rule that the next `__ui.keyframes` defines.
pub const KEYFRAME: u32 = 27
/// `__ui.keyframes(name)`: defines `@keyframes name` from the frames added since the last
/// one; none removes it.
pub const KEYFRAMES: u32 = 28
/// The number of native functions, for the installer.
pub const LAST: u32 = 28

/// The runtime's module loader callback: [`Bridge`] answers it from the defined modules.
pub const MODULE_LOAD: u32 = 100

/// A module an application can import by `name`.
pub struct ModuleSource {
  pub name: List<u8>,
  pub source: List<u8>,
}

/// A timer JavaScript asked for: `__ui.fire(id)` is due at `due`, in the host clock's
/// milliseconds.
pub struct Timer {
  pub id: u32,
  pub due: f64,
}

impl Copy for Timer {}

/// A console line. `level` 0 is debug, 1 log, 2 warn, 3 error.
pub struct LogEntry {
  pub level: u32,
  pub text: String,
}

/// The engine's services for a UI host: the batch JavaScript appends to, the modules it can
/// import, and what its timers, frame requests and console calls left for the host.
pub struct Bridge {
  pub batch: Batch,
  pub modules: List<ModuleSource>,
  /// The host clock in milliseconds, as of the host's last `advance`.
  pub now: f64,
  pub timers: List<Timer>,
  /// Whether JavaScript asked for an animation frame callback.
  pub frame: bool,
  pub logs: List<LogEntry>,
  /// Lines JavaScript sent to the development server, oldest first.
  pub outbox: List<String>,
  /// Whether JavaScript asked for a new realm.
  pub reload: bool,
  /// Addresses JavaScript asked the host to open, oldest first.
  pub opened: List<String>,
  /// The frames `__ui.keyframe` added for the next `__ui.keyframes`.
  pub frames: List<Keyframe>,
}

impl Bridge {
  pub fn make() -> Bridge {
    return Bridge {
      batch: Batch.make(),
      modules: List<ModuleSource>.make(),
      now: 0.0,
      timers: List<Timer>.make(),
      frame: false,
      logs: List<LogEntry>.make(),
      outbox: List<String>.make(),
      reload: false,
      opened: List<String>.make(),
      frames: List<Keyframe>.make(),
    }
  }

  /// Takes timer `id` out. Says whether it was there.
  pub fn cancel(self: &mut Self, id: u32) -> bool {
    let items = self.timers.asSlice()
    let mut i: usize = 0
    while i < items.length {
      if items[i].id == id {
        drop self.timers.remove(i)
        return true
      }
      i = i + 1
    }
    return false
  }

  fn find(self: &Self, name: &[u8]) -> Option<usize> {
    let items = self.modules.asSlice()
    let mut i: usize = 0
    while i < items.length {
      if same(items[i].name.asSlice(), name) { return Option<usize>.some(i) }
      i = i + 1
    }
    return Option<usize>.none()
  }
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] { return false }
    i = i + 1
  }
  return true
}

/// The JavaScript name of native function `id`.
pub fn name(id: u32) -> &'static [u8] {
  if id == CREATE { return b"create" }
  if id == APPEND { return b"append" }
  if id == INSERT_BEFORE { return b"insertBefore" }
  if id == ROOT { return b"root" }
  if id == SET_TEXT { return b"setText" }
  if id == LISTEN { return b"listen" }
  if id == STYLE { return b"style" }
  if id == CLEAR_STYLE { return b"clearStyle" }
  if id == ATTRIBUTE { return b"attribute" }
  if id == FOCUS { return b"focus" }
  if id == REMOVE { return b"remove" }
  if id == DESTROY { return b"destroy" }
  if id == SCROLL_TO { return b"scrollTo" }
  if id == SELECT { return b"select" }
  if id == LOG { return b"log" }
  if id == NOW { return b"now" }
  if id == TIMER { return b"timer" }
  if id == CANCEL_TIMER { return b"cancelTimer" }
  if id == DEV_SEND { return b"devSend" }
  if id == DEV_RELOAD { return b"devReload" }
  if id == FONT_FAMILY { return b"fontFamily" }
  if id == OPEN { return b"open" }
  if id == DEFINE_ICON { return b"defineIcon" }
  if id == SOURCE { return b"source" }
  if id == RELEASE { return b"release" }
  if id == KEYFRAME { return b"keyframe" }
  if id == KEYFRAMES { return b"keyframes" }
  return b"requestFrame"
}

/// The declared argument count of native function `id`.
pub fn arity(id: u32) -> i32 {
  if id == NOW || id == REQUEST_FRAME || id == DEV_RELOAD { return 0 }
  if id == DEV_SEND || id == OPEN || id == KEYFRAMES { return 1 }
  if id == ROOT || id == FOCUS || id == REMOVE || id == DESTROY || id == CANCEL_TIMER || id == RELEASE { return 1 }
  if id == INSERT_BEFORE || id == STYLE || id == ATTRIBUTE || id == SCROLL_TO || id == SELECT { return 3 }
  return 2
}

fn number(value: ValueBits) -> f64 {
  return match value {
    ValueBits.Int { value: integer } => i32.toF64(integer)
    ValueBits.Float64 { value: float } => float
    _ => 0.0
  }
}

fn id(value: ValueBits) -> u32 {
  return match value {
    ValueBits.Int { value: integer } => i32.toU32(integer)
    ValueBits.Float64 { value: float } => f64.toU32(float)
    _ => 0
  }
}

fn truthy(value: ValueBits) -> bool {
  return match value {
    ValueBits.Bool { value: flag } => flag
    ValueBits.Int { value: integer } => integer != 0
    ValueBits.Float64 { value: float } => float != 0.0
    ValueBits.Undefined => false
    ValueBits.Null => false
    _ => true
  }
}

fn kind(code: u32) -> NodeKind {
  if code == 1 { return NodeKind.Text }
  if code == 2 { return NodeKind.Input }
  if code == 3 { return NodeKind.Image }
  if code == 4 { return NodeKind.Icon }
  if code == 5 { return NodeKind.Canvas }
  return NodeKind.Box
}

fn state(code: u32) -> StyleState {
  if code == 1 { return StyleState.Hover }
  if code == 2 { return StyleState.Active }
  if code == 3 { return StyleState.Focus }
  if code == 4 { return StyleState.FocusVisible }
  if code == 5 { return StyleState.Starting }
  return StyleState.Base
}

effect fn text<'v>(value: ValueRef<'v>) -> String ! OutOfMemoryError ? &mut Allocator {
  if !value.view().isString() { return String.make() }
  let bytes = run Strings.toUtf8(value.view(), false)
  return run String.copy(unsafe String.fromUtf8Unchecked(bytes.asSlice()))
}

/// The attribute `name` with `value`, or None for a name the tree does not have.
effect fn attributeOf<'v>(name: string, value: ValueRef<'v>) -> Option<Attribute> ! OutOfMemoryError ? &mut Allocator {
  let bits = value.view()
  if name == "tabIndex" { return Option<Attribute>.some(Attribute.TabIndex { value: f64.toI32(number(bits)) }) }
  if name == "disabled" { return Option<Attribute>.some(Attribute.Disabled { value: truthy(bits) }) }
  if name == "focusTrap" { return Option<Attribute>.some(Attribute.FocusTrap { value: truthy(bits) }) }
  if name == "multiline" { return Option<Attribute>.some(Attribute.Multiline { value: truthy(bits) }) }
  if name == "readOnly" { return Option<Attribute>.some(Attribute.ReadOnly { value: truthy(bits) }) }
  if name == "checked" { return Option<Attribute>.some(Attribute.Checked { value: truthy(bits) }) }
  if name == "selected" { return Option<Attribute>.some(Attribute.Selected { value: truthy(bits) }) }
  if name == "expanded" { return Option<Attribute>.some(Attribute.Expanded { value: truthy(bits) }) }
  if name == "label" { return Option<Attribute>.some(Attribute.Label { value: run text(value) }) }
  if name == "testId" { return Option<Attribute>.some(Attribute.TestId { value: run text(value) }) }
  if name == "placeholder" { return Option<Attribute>.some(Attribute.Placeholder { value: run text(value) }) }
  if name == "href" { return Option<Attribute>.some(Attribute.Href { value: run text(value) }) }
  if name == "transition" { return Option<Attribute>.some(Attribute.Transition { value: run text(value) }) }
  if name == "cursor" {
    let word = run text(value)
    return Option<Attribute>.some(Attribute.Cursor { value: cursorOf(String.utf8Bytes(String.view(&word))) })
  }
  return Option<Attribute>.none()
}

/// The first role in ARIA role text the tree has: words are separated by spaces, and later
/// ones are fallbacks, as in `role="switch checkbox"`. `none` and `presentation` are no role.
fn roleOf(words: &[u8]) -> Option<Role> {
  let mut start: usize = 0
  while start < words.length {
    let mut end = start
    while end < words.length && !space(words[end]) { end = end + 1 }
    if end > start {
      match namedRole(Slice.view(words, start, end - start)) {
        Option<Role>.Some { value } => { return Option<Role>.some(value) }
        Option<Role>.None => {}
      }
    }
    start = end + 1
  }
  return Option<Role>.none()
}

fn space(byte: u8) -> bool {
  return byte == 32 || byte == 9 || byte == 10 || byte == 12 || byte == 13
}

/// The tree's role for one ARIA role name.
fn namedRole(word: &[u8]) -> Option<Role> {
  if same(word, b"none") || same(word, b"presentation") { return Option<Role>.some(Role.None) }
  if same(word, b"generic") { return Option<Role>.some(Role.Generic) }
  if same(word, b"button") { return Option<Role>.some(Role.Button) }
  if same(word, b"link") { return Option<Role>.some(Role.Link) }
  if same(word, b"checkbox") { return Option<Role>.some(Role.Checkbox) }
  if same(word, b"radio") { return Option<Role>.some(Role.Radio) }
  if same(word, b"textbox") { return Option<Role>.some(Role.TextBox) }
  if same(word, b"heading") { return Option<Role>.some(Role.Heading) }
  if same(word, b"paragraph") { return Option<Role>.some(Role.Paragraph) }
  if same(word, b"list") { return Option<Role>.some(Role.List) }
  if same(word, b"listitem") { return Option<Role>.some(Role.ListItem) }
  if same(word, b"img") || same(word, b"image") { return Option<Role>.some(Role.Image) }
  if same(word, b"dialog") { return Option<Role>.some(Role.Dialog) }
  if same(word, b"menu") { return Option<Role>.some(Role.Menu) }
  if same(word, b"menuitem") { return Option<Role>.some(Role.MenuItem) }
  if same(word, b"tab") { return Option<Role>.some(Role.Tab) }
  if same(word, b"tablist") { return Option<Role>.some(Role.TabList) }
  if same(word, b"tabpanel") { return Option<Role>.some(Role.TabPanel) }
  if same(word, b"toolbar") { return Option<Role>.some(Role.Toolbar) }
  if same(word, b"navigation") { return Option<Role>.some(Role.Navigation) }
  if same(word, b"main") { return Option<Role>.some(Role.Main) }
  if same(word, b"form") { return Option<Role>.some(Role.Form) }
  if same(word, b"group") { return Option<Role>.some(Role.Group) }
  if same(word, b"slider") { return Option<Role>.some(Role.Slider) }
  if same(word, b"switch") { return Option<Role>.some(Role.Switch) }
  if same(word, b"listbox") { return Option<Role>.some(Role.ListBox) }
  if same(word, b"option") { return Option<Role>.some(Role.Option) }
  if same(word, b"tooltip") { return Option<Role>.some(Role.Tooltip) }
  return Option<Role>.none()
}

/// The tree's cursor for a CSS `cursor` keyword. A keyword the tree has no cursor for is the
/// default arrow.
fn cursorOf(word: &[u8]) -> Cursor {
  if same(word, b"pointer") { return Cursor.Pointer }
  if same(word, b"text") { return Cursor.Text }
  if same(word, b"move") { return Cursor.Move }
  if same(word, b"grab") { return Cursor.Grab }
  if same(word, b"grabbing") { return Cursor.Grabbing }
  if same(word, b"not-allowed") { return Cursor.NotAllowed }
  if same(word, b"ew-resize") || same(word, b"col-resize") { return Cursor.ResizeHorizontal }
  if same(word, b"ns-resize") || same(word, b"row-resize") { return Cursor.ResizeVertical }
  if same(word, b"nwse-resize") { return Cursor.ResizeNorthWestSouthEast }
  if same(word, b"nesw-resize") { return Cursor.ResizeNorthEastSouthWest }
  if same(word, b"crosshair") { return Cursor.Crosshair }
  return Cursor.Default
}

/// The declarations of `css`. Text the tokenizer rejects sets nothing.
effect fn declarationsOf(css: &String) -> List<Declaration> ! OutOfMemoryError ? &mut Allocator {
  let parsed = run Effect.result(written.declarations(String.utf8Bytes(String.view(css))))
  return match move parsed {
    Result<List<Declaration>, CssError | OutOfMemoryError>.Success { value } => move value
    Result<List<Declaration>, CssError | OutOfMemoryError>.Failure { error } => match move error {
      OutOfMemoryError allocation => { fail move allocation }
      CssError _ => List<Declaration>.make()
    }
  }
}

/// What a `__ui` native function did: returned a value, or asked for a `TypeError`.
pub union Outcome {
  Returned { pub value: ValueBits },
  TypeError { pub message: List<u8> },
}

/// Runs `__ui` native function `function` on `state`. A host whose engine services are not a
/// `Bridge` (an embedded runtime's) calls it from its own native dispatch.
pub effect fn call<'w>(bridge: &mut Bridge, function: u32, argv: Arguments<'w>) -> Outcome ! OutOfMemoryError ? &mut Allocator {
  let first = id(argv.get(0).view())
  if function == CREATE {
    run bridge.batch.create(first, kind(id(argv.get(1).view())))
  } else if function == APPEND {
    run bridge.batch.append(first, id(argv.get(1).view()))
  } else if function == INSERT_BEFORE {
    run bridge.batch.insertBefore(first, id(argv.get(1).view()), id(argv.get(2).view()))
  } else if function == ROOT {
    run bridge.batch.root(first)
  } else if function == SET_TEXT {
    let value = run text(argv.get(1))
    run bridge.batch.setText(first, String.view(&value))
  } else if function == LISTEN {
    run bridge.batch.listen(first, id(argv.get(1).view()))
  } else if function == STYLE {
    let css = run text(argv.get(1))
    let declarations = run declarationsOf(&css)
    run bridge.batch.push(Mutation.SetStyle { id: first, state: state(id(argv.get(2).view())), declarations: move declarations })
  } else if function == CLEAR_STYLE {
    run bridge.batch.push(Mutation.ClearStyle { id: first, state: state(id(argv.get(1).view())) })
  } else if function == ATTRIBUTE {
    let attribute = run text(argv.get(1))
    if String.view(&attribute) == "valueRange" {
      let range = if argv.get(2).view().isNumber() {
        Attribute.ValueRange { min: f64.toF32(number(argv.get(2).view())), max: f64.toF32(number(argv.get(3).view())), value: f64.toF32(number(argv.get(4).view())) }
      } else { Attribute.ClearValueRange }
      run bridge.batch.attribute(first, move range)
      return Outcome.Returned { value: ValueBits.Undefined }
    }
    if String.view(&attribute) == "role" {
      let words = run text(argv.get(2))
      let bytes = String.utf8Bytes(String.view(&words))
      let mut known = bytes.length == 0
      let mut value = Role.None
      match roleOf(bytes) {
        Option<Role>.Some { value: found } => {
          known = true
          value = found
        }
        Option<Role>.None => {}
      }
      run bridge.batch.attribute(first, Attribute.Role { value: value })
      return Outcome.Returned { value: ValueBits.Bool { value: known } }
    }
    match run attributeOf(String.view(&attribute), argv.get(2)) {
      Option<Attribute>.Some { value } => { run bridge.batch.attribute(first, move value) }
      Option<Attribute>.None => {
        let mut message = List<u8>.make()
        run message.appendSlice(b"the tree has no attribute '")
        run message.appendSlice(String.utf8Bytes(String.view(&attribute)))
        run message.append(39)
        return Outcome.TypeError { message: move message }
      }
    }
  } else if function == FOCUS {
    run bridge.batch.focus(first)
  } else if function == REMOVE {
    run bridge.batch.push(Mutation.Remove { id: first })
  } else if function == DESTROY {
    run bridge.batch.push(Mutation.Destroy { id: first })
  } else if function == SCROLL_TO {
    run bridge.batch.scrollTo(first, f64.toF32(number(argv.get(1).view())), f64.toF32(number(argv.get(2).view())))
  } else if function == LOG {
    let line = run text(argv.get(1))
    run bridge.logs.append(LogEntry { level: first, text: move line })
  } else if function == NOW {
    return Outcome.Returned { value: ValueBits.number(bridge.now) }
  } else if function == TIMER {
    drop bridge.cancel(first)
    let delay = number(argv.get(1).view())
    run bridge.timers.append(Timer { id: first, due: bridge.now + if delay > 0.0 { delay } else { 0.0 } })
  } else if function == CANCEL_TIMER {
    drop bridge.cancel(first)
  } else if function == REQUEST_FRAME {
    bridge.frame = true
  } else if function == DEV_SEND {
    let line = run text(argv.get(0))
    run bridge.outbox.append(move line)
  } else if function == OPEN {
    let address = run text(argv.get(0))
    run bridge.opened.append(move address)
  } else if function == DEV_RELOAD {
    bridge.reload = true
  } else if function == FONT_FAMILY {
    let names = run text(argv.get(1))
    run bridge.batch.fontFamily(first, String.view(&names))
  } else if function == DEFINE_ICON {
    let markup = run text(argv.get(1))
    run bridge.batch.icon(first, String.utf8Bytes(String.view(&markup)))
  } else if function == SOURCE {
    run bridge.batch.source(first, id(argv.get(1).view()))
  } else if function == RELEASE {
    run bridge.batch.releaseResource(first)
  } else if function == KEYFRAME {
    let css = run text(argv.get(1))
    let declarations = run declarationsOf(&css)
    let offset = f64.toF32(number(argv.get(0).view()))
    run bridge.frames.append(Keyframe { offset: offset, declarations: move declarations })
  } else if function == KEYFRAMES {
    let name = run text(argv.get(0))
    let frames = Intrinsic.replace(bridge.frames, List<Keyframe>.make())
    run bridge.batch.keyframes(String.view(&name), move frames)
  } else if function == SELECT {
    run bridge.batch.select(first, f64.toUsize(number(argv.get(1).view())), f64.toUsize(number(argv.get(2).view())))
  }
  return Outcome.Returned { value: ValueBits.Undefined }
}

impl EngineServices for Bridge {
  /// A realm here has ECMAScript without ECMA-402 or Temporal (the prelude installs neither),
  /// so their code and CLDR tables stay out of the program.
  fn includesIntl<'m>(engine: &Engine<'m, Self>) -> bool { return false }
  fn includesTemporal<'m>(engine: &Engine<'m, Self>) -> bool { return false }
  /// No host globals: a shadow realm has its intrinsics alone.
  effect fn initializeShadowRealm<'r, 's, 'm>(engine: &mut Engine<'m, Self>, caller: Realm<'r>, created: Realm<'s>) -> () ! JsException ? &mut Allocator {}

  effect fn dynamicImportStarted<'r, 'v, 'w, 'x, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>, specifier: ValueRef<'v>, referrer: ValueRef<'w>, promise: ValueRef<'x>) -> ValueBits ! JsException ? &mut Allocator {
    return promise.dup().intoBits()
  }

  effect fn nativeGeneric<'r, 'v, 'm, 'w>(engine: &mut Engine<'m, Self>, function: u32, realm: Realm<'r>,
    receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let outcome = run call(&mut engine.services, function, argv)
    return match move outcome {
      Outcome.Returned { value } => value
      Outcome.TypeError { message } => run engine.throwError(realm, NativeErrorKind.Type, message.asSlice())
    }
  }

  /// A module the application defined, compiled when something first imports it.
  unsafe effect fn loadModule<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>,
    callback: NativeFunctionId, opaque: ?*mut u8, name: &[u8], attributes: ValueRef<'v>) -> CellRef<ModuleDef> ! OutOfMemoryError | JsException ? &mut Allocator {
    let source = match engine.services.find(name) {
      Option<usize>.Some { value: index } => {
        let mut copy = List<u8>.make()
        run copy.appendSlice(engine.services.modules.asSlice()[index].source.asSlice())
        move copy
      }
      Option<usize>.None => {
        let mut message = List<u8>.make()
        run message.appendSlice(b"could not load module '")
        run message.appendSlice(name)
        run message.append(39)
        return run engine.throwError(realm, NativeErrorKind.Reference, message.asSlice())
      }
    }
    let memory = engine.memory
    let compiled = run evaluation.evaluate(&mut engine, memory, realm, source.asSlice(), name, flags.TYPE_MODULE | flags.FLAG_COMPILE_ONLY)
    return match compiled.view() {
      ValueBits.Module { reference } => unsafe CellRef<ModuleDef>.of(reference)
      _ => Intrinsic.trap("the module compiler returned something else")
    }
  }
}
