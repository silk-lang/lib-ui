/// How much native stack JavaScript may use below the frame that opened the host.
const STACK_BYTES: usize = 4194304

/// JavaScript threw and nothing caught it. `message` is the thrown value as a string.
pub struct JsError {
  pub message: String,
}

/// A JavaScript realm bound to a UI tree's client side.
///
/// Every effect here allocates JavaScript memory, so provide the `RuntimeAllocator` that
/// `memory` observes as their `Allocator`. Call [`JsHost.close`] before dropping the host.
pub struct JsHost<'m> {
  engine: Engine<'m, Bridge>,
  runtime: *mut HeapHeader,
  context: *mut HeapHeader,
  closed: bool,
}

/// `bytes` as a string of one code unit per byte (a "binary string").
effect fn jsLatin1(bytes: &[u8]) -> Value ! OutOfMemoryError ? &mut Allocator {
  let made = run Effect.result(Strings.fromLatin1(bytes))
  return match move made {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value: bits } => unsafe Value.adoptBits(bits)
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => match move error {
      OutOfMemoryError allocation => { fail move allocation }
      StringLengthError _ => Value.immediate(ValueBits.Undefined)
    }
  }
}

/// A JavaScript string of `value`, or undefined when it is too long to be one.
effect fn jsString(value: string) -> Value ! OutOfMemoryError ? &mut Allocator {
  let made = run Effect.result(Strings.fromUtf8(String.utf8Bytes(value)))
  return match move made {
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value: bits } => unsafe Value.adoptBits(bits)
    Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => match move error {
      OutOfMemoryError allocation => { fail move allocation }
      StringLengthError _ => Value.immediate(ValueBits.Undefined)
    }
  }
}

/// The two strings of an event: key and code for key events, the value and the input type
/// for input, a paste's text and HTML, a beforeinput's data and input type, undefined
/// otherwise.
pub effect fn firstString(event: &Event) -> Value ! OutOfMemoryError ? &mut Allocator {
  return match &event.* {
    Event.KeyDown { key, .. } => run jsString(String.view(&key.key))
    Event.KeyUp { key } => run jsString(String.view(&key.key))
    Event.Input { change } => run jsString(String.view(&change.value))
    Event.Paste { data } => run jsString(String.view(&data.text))
    Event.BeforeInput { data, .. } => run jsString(String.view(&data))
    _ => match motionOf(event) {
      Option<&Motion>.Some { value: motion } => run jsString(String.view(&motion.name))
      Option<&Motion>.None => Value.immediate(ValueBits.Undefined)
    }
  }
}

pub effect fn secondString(event: &Event) -> Value ! OutOfMemoryError ? &mut Allocator {
  return match &event.* {
    Event.KeyDown { key, .. } => run jsString(String.view(&key.code))
    Event.KeyUp { key } => run jsString(String.view(&key.code))
    Event.Input { change } => run jsString(change.inputType.name())
    Event.Paste { data } => run jsString(String.view(&data.html))
    Event.BeforeInput { inputType, .. } => run jsString(inputType.name())
    _ => match motionOf(event) {
      Option<&Motion>.Some { value: motion } => run jsString(String.view(&motion.pseudoElement))
      Option<&Motion>.None => Value.immediate(ValueBits.Undefined)
    }
  }
}

/// The third and fourth strings of an event: a rich input's marks and atoms, packed as
/// `__ui.richText` takes them, and a paste's PNG as a binary string (empty for every other
/// record).
pub effect fn thirdString(event: &Event) -> Value ! OutOfMemoryError ? &mut Allocator {
  if let Event.Paste { data } = &event.* {
    return run jsLatin1(data.image.asSlice())
  }
  let packed = run richStrings(event)
  return run jsString(String.view(&packed[0]))
}

pub effect fn fourthString(event: &Event) -> Value ! OutOfMemoryError ? &mut Allocator {
  let packed = run richStrings(event)
  return run jsString(String.view(&packed[1]))
}

effect fn define<'a, 'b, 'm>(engine: &mut Engine<'m, Bridge>, realm: Realm<'a>, object: ValueRef<'b>, native: bridge.Native) -> () ! JsException ? &mut Allocator {
  let memory = engine.memory
  let function = run functions.newFunction(&mut engine, memory, realm, NativeFunctionId.Host { id: bridge.nativeId(native.name) }, native.name, native.arity, NativeCallProtocol.Generic, 0)
  run common.define(&mut engine, realm, object.borrow(), native.name, unsafe Value.adoptBits(function), 7)
}

effect fn install<'a, 'm>(engine: &mut Engine<'m, Bridge>, realm: Realm<'a>) -> () ! OutOfMemoryError | JsException ? &mut Allocator {
  let memory = engine.memory
  let ui = run objects.newObject(&mut engine, memory, realm)
  let mut at: usize = 0
  while true {
    match bridge.native(at) {
      Option.Some { value } => { run define(&mut engine, realm, ui.borrow(), value) }
      Option.None => { break }
    }
    at = at + 1
  }
  run common.define(&mut engine, realm, realm.globalObject(), b"__ui", move ui, 7)
}

/// `value` as a `JsError`: its string form, with the stack when it is an error that has one.
effect fn describe<'a, 'm>(engine: &mut Engine<'m, Bridge>, realm: Realm<'a>, value: Value) -> JsError ! OutOfMemoryError ? &mut Allocator {
  let converted = run Effect.result(common.toString(&mut engine, realm, value.borrow()))
  let mut message = String.make()
  match move converted {
    Result<Value, JsException>.Success { value: text } => {
      let bytes = run Strings.toUtf8(text.borrow().view(), false)
      message = run String.copy(unsafe String.fromUtf8Unchecked(bytes.asSlice()))
      realm.release(&mut engine, move text)
    }
    Result<Value, JsException>.Failure { .. } => {
      let again = realm.takeException()
      realm.release(&mut engine, move again)
      message = run String.copy("an exception that could not be converted to a string")
    }
  }
  realm.release(&mut engine, move value)
  return JsError { message: move message }
}

/// Takes the pending exception as a `JsError`.
effect fn thrown<'a, 'm>(engine: &mut Engine<'m, Bridge>, realm: Realm<'a>) -> JsError ! OutOfMemoryError ? &mut Allocator {
  return run describe(&mut engine, realm, realm.takeException())
}

/// Runs promise jobs until none is queued, as the microtask checkpoint after a script or a
/// callback. A job that throws fails with what it threw.
effect fn drainIn<'a, 'm>(engine: &mut Engine<'m, Bridge>, realm: Realm<'a>) -> () ! OutOfMemoryError | JsError ? &mut Allocator {
  run runJobs(&mut engine, realm)
  run reportRejections(&mut engine, realm)
}

/// The promise jobs alone, for a caller that reports one of the rejections itself.
effect fn runJobs<'a, 'm>(engine: &mut Engine<'m, Bridge>, realm: Realm<'a>) -> () ! OutOfMemoryError | JsError ? &mut Allocator {
  let rt = realm.runtime()
  while unsafe jobs.isJobPending(rt) {
    let job = run unsafe jobs.executePendingJob(&mut engine, rt)
    if job.status < 0 { fail run thrown(&mut engine, realm) }
  }
}

/// Takes `promise` out of the unhandled rejections: its caller reports the failure.
fn forget<'a, 'v, 'm>(engine: &mut Engine<'m, Bridge>, realm: Realm<'a>, promise: ValueRef<'v>) -> () {
  let items = engine.services.rejections.asSlice()
  let mut i: usize = 0
  while i < items.length {
    if unsafe core.sameValue(items[i].promise.view(), promise.view()) {
      let Rejected { promise: kept, reason } = engine.services.rejections.remove(i)
      realm.release(&mut engine, move kept)
      realm.release(&mut engine, move reason)
      return
    }
    i = i + 1
  }
}

/// Writes a console error for each promise that is still rejected with no handler now that
/// the promise jobs ran, and forgets them: a handler added later is too late, as on the web.
effect fn reportRejections<'a, 'm>(engine: &mut Engine<'m, Bridge>, realm: Realm<'a>) -> () ! OutOfMemoryError ? &mut Allocator {
  let rejections = Intrinsic.replace(engine.services.rejections, List<Rejected>.make())
  let mut rest = move rejections
  while rest.length() > 0 {
    let Rejected { promise: rejected, reason } = rest.remove(0)
    let handled = run rejectionHandled(&mut engine, realm, rejected.borrow(), reason.borrow())
    realm.release(&mut engine, move rejected)
    if handled {
      realm.release(&mut engine, move reason)
      continue
    }
    let JsError { message } = run describe(&mut engine, realm, move reason)
    let mut line = run String.copy("Uncaught (in promise) ")
    run line.append(String.view(&message))
    run engine.services.logs.append(LogEntry { level: 3, text: move line })
  }
}

effect fn evaluateIn<'a, 'm>(engine: &mut Engine<'m, Bridge>, realm: Realm<'a>, source: &[u8], name: &[u8], mode: i32) -> Value ! JsException ? &mut Allocator {
  let memory = engine.memory
  return run evaluation.evaluate(&mut engine, memory, realm, source, name, mode)
}

/// Whether `bytes` is a bytecode image the engine linked into this program can load: one
/// its own build wrote ([`JsHost.writeImage`]). An image from another engine build is not,
/// and its source runs instead.
pub fn imageLoadable(bytes: &[u8]) -> bool {
  return image.loadable(bytes)
}

/// The engine build an image was written by, as its header says (0 for bytes too short to
/// have one), and the one this program links: equal for an image that loads.
pub fn imageBuild(bytes: &[u8]) -> u64 {
  if bytes.length < 16 { return 0 }
  return readU64(bytes, 8)
}

pub fn engineBuild() -> u64 {
  return image.identity()
}

/// The compiled module of an image this engine build wrote, with nothing parsed.
///
/// Safety: the engine reads each function's code from `bytes` when it is first called, until
/// the runtime is destroyed.
unsafe effect fn loadImage<'a, 'm>(engine: &mut Engine<'m, Bridge>, realm: Realm<'a>, bytes: &[u8]) -> Value ! JsException ? &mut Allocator {
  return run unsafe image.load(&mut engine, realm, Pointer.fromRef<u8>(&bytes[0]), bytes.length)
}

effect fn writeImageIn<'a, 'm>(engine: &mut Engine<'m, Bridge>, realm: Realm<'a>, source: &[u8], name: &[u8]) -> List<u8> ! JsException ? &mut Allocator {
  let memory = engine.memory
  return run image.write(&mut engine, memory, realm, source, name, flags.TYPE_MODULE)
}

/// Runs what a compile-only evaluate returned.
effect fn runCompiled<'a, 'm>(engine: &mut Engine<'m, Bridge>, realm: Realm<'a>, compiled: Value) -> Value ! JsException ? &mut Allocator {
  let memory = engine.memory
  return run evaluation.evaluateFunction(&mut engine, memory, realm, move compiled)
}

/// Calls `__ui.dispatch(kind, target, a, b, modifiers, d, e, first, second, third, fourth)`
/// (the last two are a rich input's packed marks and atoms) when the
/// application installed one (see `numbersOf` for the numbers and `firstString` for the
/// strings), and says whether it returned true, which means a handler prevented the default.
effect fn dispatchIn<'a, 'm>(engine: &mut Engine<'m, Bridge>, realm: Realm<'a>, record: &EventRecord) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
  let ui = run common.get(&mut engine, realm, realm.globalObject(), b"__ui")
  let function = run common.get(&mut engine, realm, ui.borrow(), b"dispatch")
  let mut prevented = false
  if function.borrow().view().isObject() {
    let numbers = numbersOf(&record.event)
    let first = run firstString(&record.event)
    let second = run secondString(&record.event)
    let third = run thirdString(&record.event)
    let fourth = run fourthString(&record.event)
    let arguments = [
      ValueBits.number(u32.toF64(kindCode(record.event.kind()))),
      ValueBits.number(u32.toF64(record.target.raw())),
      ValueBits.number(numbers[0]),
      ValueBits.number(numbers[1]),
      ValueBits.number(numbers[2]),
      ValueBits.number(numbers[3]),
      ValueBits.number(numbers[4]),
      first.borrow().view(),
      second.borrow().view(),
      third.borrow().view(),
      fourth.borrow().view(),
    ]
    let called = run Effect.result(promise.call(&mut engine, realm, function.borrow(), ui.borrow(), &arguments))
    match move called {
      Result<Value, JsException>.Success { value } => {
        prevented = match value.borrow().view() {
          ValueBits.Bool { value: flag } => flag
          _ => false
        }
        realm.release(&mut engine, move value)
      }
      Result<Value, JsException>.Failure { error } => {
        realm.release(&mut engine, move function)
        realm.release(&mut engine, move ui)
        fail move error
      }
    }
  }
  realm.release(&mut engine, move function)
  realm.release(&mut engine, move ui)
  return prevented
}

/// Asks `__ui.rejected(promise, reason)`, the prelude's `unhandledrejection` event, whether a
/// listener prevented the default; then the host does not report the rejection. A listener
/// that throws counts as not preventing it.
effect fn rejectionHandled<'a, 'v, 'm>(engine: &mut Engine<'m, Bridge>, realm: Realm<'a>, rejected: ValueRef<'v>, reason: ValueRef<'v>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let arguments = [rejected.view(), reason.view()]
  let called = run Effect.result(callUiValue(&mut engine, realm, b"rejected", &arguments))
  return match move called {
    Result<bool, JsException>.Success { value } => value
    Result<bool, JsException>.Failure { .. } => {
      let thrown = realm.takeException()
      realm.release(&mut engine, move thrown)
      false
    }
  }
}

/// Calls `__ui.<name>(...arguments)` when that is a function, and says whether it returned true.
effect fn callUiValue<'a, 'm>(engine: &mut Engine<'m, Bridge>, realm: Realm<'a>, name: &[u8], arguments: &[ValueBits]) -> bool ! JsException ? &mut Allocator {
  let ui = run common.get(&mut engine, realm, realm.globalObject(), b"__ui")
  let function = run common.get(&mut engine, realm, ui.borrow(), name)
  let mut answer = false
  if function.borrow().view().isObject() {
    let called = run Effect.result(promise.call(&mut engine, realm, function.borrow(), ui.borrow(), arguments))
    match move called {
      Result<Value, JsException>.Success { value } => {
        answer = match value.borrow().view() {
          ValueBits.Bool { value: flag } => flag
          _ => false
        }
        realm.release(&mut engine, move value)
      }
      Result<Value, JsException>.Failure { error } => {
        realm.release(&mut engine, move function)
        realm.release(&mut engine, move ui)
        fail move error
      }
    }
  }
  realm.release(&mut engine, move function)
  realm.release(&mut engine, move ui)
  return answer
}

/// Calls `__ui.<name>(...arguments)` when that is a function, and drops what it returns.
effect fn callUi<'a, 'm>(engine: &mut Engine<'m, Bridge>, realm: Realm<'a>, name: &[u8], arguments: &[ValueBits]) -> () ! JsException ? &mut Allocator {
  let ui = run common.get(&mut engine, realm, realm.globalObject(), b"__ui")
  let function = run common.get(&mut engine, realm, ui.borrow(), name)
  if function.borrow().view().isObject() {
    let called = run Effect.result(promise.call(&mut engine, realm, function.borrow(), ui.borrow(), arguments))
    match move called {
      Result<Value, JsException>.Success { value } => { realm.release(&mut engine, move value) }
      Result<Value, JsException>.Failure { error } => {
        realm.release(&mut engine, move function)
        realm.release(&mut engine, move ui)
        fail move error
      }
    }
  }
  realm.release(&mut engine, move function)
  realm.release(&mut engine, move ui)
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] { return false }
    i = i + 1
  }
  return true
}

impl<'m> JsHost<'m> {
  pub fn setStylesheetCompiler(self: &mut Self, compiler: Compiler) -> () { self.engine.services.stylesheetCompiler = compiler }
  pub fn stylesheetCompiler(self: &Self) -> Compiler { return self.engine.services.stylesheetCompiler }
  /// The app's exported Silk functions, which `__ui.native` calls.
  pub fn setNatives(self: &mut Self, natives: Natives) -> () { self.engine.services.natives = natives }

  /// A realm with the standard intrinsics, the `__ui` native functions, and the web globals
  /// of `prelude.js`: timers, animation frames, a console, `queueMicrotask`,
  /// `performance.now` and `reportError`.
  pub effect fn open(memory: &'m AllocationObserver, domain: Domain) -> JsHost<'m> ! OutOfMemoryError | JsError ? &mut Allocator {
    let rt = run runtime.allocateRuntimeStorage(stack.currentFrameAddress())
    // The engine's own default is 1 MiB, which a React render in a debug build passes. Silk
    // threads and main threads have 8 MiB, so half of that is safe below this frame.
    unsafe runtime.setMaxStackSize(rt, STACK_BYTES)
    let mut engine = Engine { memory: memory, domain: domain, services: Bridge.make() }
    let created = run Effect.result(unsafe intrinsics.create(&mut engine, memory, rt))
    let context = match move created {
      Result<*mut HeapHeader, OutOfMemoryError | JsException>.Success { value } => value
      Result<*mut HeapHeader, OutOfMemoryError | JsException>.Failure { .. } => {
        run unsafe gc.destroyRuntime(&mut engine, rt)
        fail JsError { message: run String.copy("the JavaScript realm could not be created") }
      }
    }
    unsafe runtime.setPromiseRejectionTracker(rt, HostHook { callback: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: bridge.REJECTION }), opaque: Pointer.null<u8>() })
    unsafe loader.setLoader(rt, Option<NativeFunctionId>.none(), Option<NativeFunctionId>.some(NativeFunctionId.Host { id: bridge.MODULE_LOAD }), Pointer.null<u8>())
    let mut host = JsHost { engine: move engine, runtime: rt, context: context, closed: false }
    let installed = run Effect.result(install(&mut host.engine, unsafe lendRealm(&context, context)))
    match move installed {
      Result<(), OutOfMemoryError | JsException>.Success { .. } => ()
      Result<(), OutOfMemoryError | JsException>.Failure { .. } => {
        run host.close()
        fail JsError { message: run String.copy("the __ui functions could not be installed") }
      }
    }
    let prepared = run Effect.result(host.evaluate(prelude(), b"ui-js:prelude"))
    match move prepared {
      Result<(), OutOfMemoryError | JsError>.Success { .. } => ()
      Result<(), OutOfMemoryError | JsError>.Failure { error } => {
        run host.close()
        fail move error
      }
    }
    return move host
  }

  /// Runs `source` as a script, then the promise jobs it queued. `name` is the file name
  /// stack traces show.
  pub effect fn evaluate(self: &mut Self, source: &[u8], name: &[u8]) -> () ! OutOfMemoryError | JsError ? &mut Allocator {
    let context = self.context
    let realm = unsafe lendRealm(&context, context)
    let ran = run Effect.result(evaluateIn(&mut self.engine, realm, source, name, flags.TYPE_GLOBAL))
    match move ran {
      Result<Value, JsException>.Success { value } => { realm.release(&mut self.engine, move value) }
      Result<Value, JsException>.Failure { .. } => { fail run thrown(&mut self.engine, realm) }
    }
    run drainIn(&mut self.engine, realm)
  }

  /// Makes `source` importable as `name`: `import { x } from "name"` in a module run later
  /// finds it. Relative specifiers resolve against the importing module's name, so a module
  /// named `app/main.js` imports `./view.js` as `app/view.js`. Defining a name again replaces
  /// the source for modules that have not imported it yet.
  pub effect fn define(self: &mut Self, name: &[u8], source: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.defineImaged(name, source, b"")
  }

  /// [`JsHost.define`] for a module that was also compiled when the program was built:
  /// `compiledImage` is what [`JsHost.writeImage`] returned for `source` and `name`, embedded
  /// in the program. The first import of `name` starts from it and parses nothing when this
  /// engine build wrote it; otherwise, or when it is empty, `source` is compiled.
  pub effect fn defineImaged(self: &mut Self, name: &[u8], source: &[u8], compiledImage: &'static [u8]) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut nameCopy = List<u8>.make()
    run nameCopy.appendSlice(name)
    let mut sourceCopy = List<u8>.make()
    run sourceCopy.appendSlice(source)
    let entry = ModuleSource { name: move nameCopy, source: move sourceCopy, image: compiledImage }
    let items = self.engine.services.modules.asSlice()
    let mut i: usize = 0
    while i < items.length {
      if sameBytes(items[i].name.asSlice(), name) {
        self.engine.services.modules.set(i, move entry)
        return
      }
      i = i + 1
    }
    run self.engine.services.modules.append(move entry)
  }

  /// Runs `source` as an ES module named `name`, with its imports loaded from the defined
  /// modules, then the promise jobs it queued. A module that throws while it evaluates fails
  /// with what it threw; one still waiting on a top-level `await` is left to finish later.
  pub effect fn module(self: &mut Self, source: &[u8], name: &[u8]) -> () ! OutOfMemoryError | JsError ? &mut Allocator {
    drop run self.moduleFrom(b"", source, name)
  }

  /// [`JsHost.module`] for a module that was also compiled when the program was built:
  /// `compiledImage` is what [`JsHost.writeImage`] returned for `source` and `name`, embedded in the
  /// program (the engine reads it for as long as the realm lives, so it is `'static`). When
  /// this engine build wrote the image, the module starts from it and nothing is parsed;
  /// an image another build wrote ([`imageLoadable`] says no), or an empty one, is left
  /// alone and `source` is compiled as [`JsHost.module`] does. Says which one ran.
  pub effect fn moduleFrom(self: &mut Self, compiledImage: &'static [u8], source: &[u8], name: &[u8]) -> bool ! OutOfMemoryError | JsError ? &mut Allocator {
    return run unsafe self.moduleFromHeld(compiledImage, source, name)
  }

  /// [`JsHost.moduleFrom`] for an image that is not part of the program: a file the caller
  /// mapped or read.
  ///
  /// Safety: the engine reads each function's code from `compiledImage` when it is first
  /// called, so the bytes stay readable and unchanged until [`JsHost.close`]. They are an
  /// image the caller's own build wrote: an image is trusted, not checked.
  pub unsafe effect fn moduleFromHeld(self: &mut Self, compiledImage: &[u8], source: &[u8], name: &[u8]) -> bool ! OutOfMemoryError | JsError ? &mut Allocator {
    let context = self.context
    let realm = unsafe lendRealm(&context, context)
    let imaged = compiledImage.length != 0 && imageLoadable(compiledImage)
    // Compiled (or loaded), then run: what one evaluate of the source does.
    let prepared = if imaged {
      run Effect.result(unsafe loadImage(&mut self.engine, realm, compiledImage))
    } else {
      run Effect.result(evaluateIn(&mut self.engine, realm, source, name, flags.TYPE_MODULE | flags.FLAG_COMPILE_ONLY))
    }
    let compiled = match move prepared {
      Result<Value, JsException>.Success { value } => move value
      Result<Value, JsException>.Failure { .. } => { fail run thrown(&mut self.engine, realm) }
    }
    let ran = run Effect.result(runCompiled(&mut self.engine, realm, move compiled))
    let completion = match move ran {
      Result<Value, JsException>.Success { value } => move value
      Result<Value, JsException>.Failure { .. } => { fail run thrown(&mut self.engine, realm) }
    }
    let drained = run Effect.result(runJobs(&mut self.engine, realm))
    // The module's own failure is this call's failure, not an unhandled rejection.
    forget(&mut self.engine, realm, completion.borrow())
    run reportRejections(&mut self.engine, realm)
    let rejected = promise.stateOf(completion.borrow()) == promise.REJECTED
    let reason = promise.resultOf(completion.borrow())
    realm.release(&mut self.engine, move completion)
    match move drained {
      Result<(), OutOfMemoryError | JsError>.Success { .. } => ()
      Result<(), OutOfMemoryError | JsError>.Failure { error } => {
        realm.release(&mut self.engine, move reason)
        fail move error
      }
    }
    if rejected { fail run describe(&mut self.engine, realm, move reason) }
    realm.release(&mut self.engine, move reason)
    return imaged
  }

  /// Compiles the ES module `source` named `name` into a bytecode image without running
  /// it: every function's bytecode, for [`JsHost.moduleFrom`] to start from in a program
  /// that links this same engine build. Its imports must be defined ([`JsHost.define`]).
  /// A build step's call (`silkui_window.image`); the image is trusted input at launch, so
  /// only the app's own build writes it.
  pub effect fn writeImage(self: &mut Self, source: &[u8], name: &[u8]) -> List<u8> ! OutOfMemoryError | JsError ? &mut Allocator {
    let context = self.context
    let realm = unsafe lendRealm(&context, context)
    let written = run Effect.result(writeImageIn(&mut self.engine, realm, source, name))
    return match move written {
      Result<List<u8>, JsException>.Success { value } => move value
      Result<List<u8>, JsException>.Failure { .. } => { fail run thrown(&mut self.engine, realm) }
    }
  }

  /// Runs the promise jobs queued since the last script, module or event.
  pub effect fn drain(self: &mut Self) -> () ! OutOfMemoryError | JsError ? &mut Allocator {
    let context = self.context
    run drainIn(&mut self.engine, unsafe lendRealm(&context, context))
  }

  /// How many mutations JavaScript queued since the last flush.
  pub fn pending(self: &Self) -> usize {
    return self.engine.services.batch.length()
  }

  /// Lets `getComputedStyle` read `tree`: call it before each call that runs JavaScript, with
  /// the tree [`JsHost.flushRaw`] applies to. The tree must stay where it is while it runs.
  pub fn attach<'t>(self: &mut Self, tree: &mut UiTree<'t>) -> () { self.engine.services.attach(&mut tree) }

  /// Applies what JavaScript queued to `tree`.
  pub effect fn flush(self: &mut Self, tree: &mut Tree<'_>) -> () ! ProtocolError | OutOfMemoryError ? &mut Allocator {
    if self.engine.services.batch.length() == 0 { return }
    run tree.apply(run self.engine.services.batch.take())
  }

  /// [`JsHost.flush`] for a host that holds the engine's tree, as the window host does.
  pub effect fn flushRaw(self: &mut Self, tree: &mut UiTree<'_>) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
    tree.work.bridgeCalls = self.engine.services.calls
    if self.engine.services.batch.length() == 0 { return }
    run tree.apply(run self.engine.services.batch.take())
  }

  /// What the JavaScript engine and the bindings hold and did, for the bench census.
  pub effect fn census(self: &mut Self, out: &mut Census) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut rows = Rows.make()
    run unsafe js_census.collect(self.runtime, self.engine.memory, &mut rows)
    let names = rows.names.asSlice()
    let values = rows.values.asSlice()
    let mut index: usize = 0
    while index < names.length {
      let kind = values[index * 4]
      if kind == js_census.HELD { run out.held(names[index], values[index * 4 + 1], values[index * 4 + 2], values[index * 4 + 3]) }
      else if kind == js_census.UNIT { run out.unit(names[index], values[index * 4 + 1]) }
      else { run out.work(names[index], values[index * 4 + 1]) }
      index = index + 1
    }
    let services = &self.engine.services
    let mut moduleBytes: usize = 0
    let mut at: usize = 0
    while at < services.modules.length() {
      moduleBytes = moduleBytes + services.modules.asSlice()[at].source.capacity()
      at = at + 1
    }
    run out.held("js.host.module-sources(kept by the bridge)", services.modules.length(), services.modules.capacity(), 0)
    run out.bytes("js.host.module-sources.bytes", moduleBytes, moduleBytes)
    run out.held("js.host.timers", services.timers.length(), services.timers.capacity(), 16)
    run out.held("js.host.pending-batch", services.batch.length(), services.batch.length(), 0)
    run out.work("js.gc.bytes-live-when-begun", services.gcScannedBytes)
    run out.work("js.gc.bytes-freed", services.gcFreedBytes)
  }

  /// Hands the tree's queued event records to JavaScript now, running promise jobs after
  /// each one. Says whether a handler prevented a default.
  pub effect fn deliver(self: &mut Self, tree: &mut Tree<'_>) -> bool ! OutOfMemoryError | JsError ? &mut Allocator {
    let events = run tree.events()
    return run self.dispatch(events.asSlice())
  }

  /// [`JsHost.deliver`] for a host that holds the engine's tree.
  pub effect fn deliverRaw(self: &mut Self, tree: &mut UiTree<'_>) -> bool ! OutOfMemoryError | JsError ? &mut Allocator {
    let mut raw = List<RawEvent>.make()
    run tree.takeEvents(&mut raw)
    let mut events = List<EventRecord>.make()
    let items = raw.asSlice()
    let mut i: usize = 0
    while i < items.length {
      run events.append(run EventRecord.lift(&items[i]))
      i = i + 1
    }
    return run self.dispatch(events.asSlice())
  }

  /// Hands `records` to JavaScript in order, running promise jobs after each one. Says
  /// whether a handler prevented a default.
  pub effect fn dispatch(self: &mut Self, records: &[EventRecord]) -> bool ! OutOfMemoryError | JsError ? &mut Allocator {
    let context = self.context
    let realm = unsafe lendRealm(&context, context)
    let mut prevented = false
    let mut i: usize = 0
    while i < records.length {
      let outcome = run Effect.result(dispatchIn(&mut self.engine, realm, &records[i]))
      match move outcome {
        Result<bool, OutOfMemoryError | JsException>.Success { value } => { if value { prevented = true } }
        Result<bool, OutOfMemoryError | JsException>.Failure { error } => match move error {
          OutOfMemoryError allocation => { fail move allocation }
          JsException _ => { fail run thrown(&mut self.engine, realm) }
        }
      }
      run drainIn(&mut self.engine, realm)
      i = i + 1
    }
    return prevented
  }

  /// Throws what `__ui.takeError` throws, when the application library installed one: the
  /// first exception a listener threw since the last call. Listeners that throw do not stop
  /// a dispatch, as on the web, so the exception surfaces here afterwards.
  pub effect fn report(self: &mut Self) -> () ! OutOfMemoryError | JsError ? &mut Allocator {
    let context = self.context
    let realm = unsafe lendRealm(&context, context)
    let empty: [ValueBits; 0] = []
    let taken = run Effect.result(callUi(&mut self.engine, realm, b"takeError", &empty))
    match move taken {
      Result<(), JsException>.Success { .. } => ()
      Result<(), JsException>.Failure { .. } => { fail run thrown(&mut self.engine, realm) }
    }
  }

  /// One input, start to finish: the tree queues its event records, JavaScript handles them
  /// and may prevent the default, the tree runs or skips the default, JavaScript handles what
  /// that queued (a click, a focus change), and the mutations it made reach the tree. When
  /// JavaScript fails, the tree still finishes the input (with its default) and takes the
  /// mutations made so far, and then the failure is reported.
  pub effect fn input(self: &mut Self, tree: &mut Tree<'_>, value: Input) -> () ! ProtocolError | OutOfMemoryError | JsError ? &mut Allocator {
    let mut next = Option<PendingInput>.some(run tree.begin(move value))
    let mut failure = Option<JsError>.none()

    // The input, then each one the tree queued after it (a shortcut's copy, a paste's edit).
    while let Option<PendingInput>.Some { value: pending } = move next {
      let mut prevented = false
      if failure.isNone() {
        let handled = run Effect.result(self.deliver(&mut tree))
        match move handled {
          Result<bool, OutOfMemoryError | JsError>.Success { value: flag } => { prevented = flag }
          Result<bool, OutOfMemoryError | JsError>.Failure { error } => match move error {
            OutOfMemoryError allocation => { fail move allocation }
            JsError { message } => { failure = Option<JsError>.some(JsError { message: move message }) }
          }
        }
      }
      run tree.finish(move pending, prevented)
      if failure.isNone() {
        let after = run Effect.result(self.deliver(&mut tree))
        match move after {
          Result<bool, OutOfMemoryError | JsError>.Success { .. } => ()
          Result<bool, OutOfMemoryError | JsError>.Failure { error } => match move error {
            OutOfMemoryError allocation => { fail move allocation }
            JsError { message } => { failure = Option<JsError>.some(JsError { message: move message }) }
          }
        }
      }
      next = run tree.beginFollowUp()
    }
    run self.flush(&mut tree)
    match move failure {
      Option<JsError>.Some { value: error } => { fail move error }
      Option<JsError>.None => ()
    }
    run self.report()
  }

  /// Asks the application library to destroy every node it made (`__ui.unload`), so a new
  /// realm can start on an empty tree. Flush afterwards, then close this host.
  pub effect fn unload(self: &mut Self) -> () ! OutOfMemoryError | JsError ? &mut Allocator {
    let context = self.context
    let realm = unsafe lendRealm(&context, context)
    let empty: [ValueBits; 0] = []
    let called = run Effect.result(callUi(&mut self.engine, realm, b"unload", &empty))
    match move called {
      Result<(), JsException>.Success { .. } => ()
      Result<(), JsException>.Failure { .. } => { fail run thrown(&mut self.engine, realm) }
    }
  }

  /// Hands JavaScript the frames the window presented, for `frameStats()` (see
  /// [`Bridge.presented`]).
  pub effect fn presented(self: &mut Self, intervals: &[f64], dropped: u64) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.engine.services.presented(intervals, dropped)
  }

  /// Sets the clock JavaScript reads, in seconds since the host started.
  pub fn advance(self: &mut Self, seconds: f64) -> () {
    self.engine.services.now = seconds * 1000.0
  }

  /// The clock JavaScript reads, in seconds since the host started.
  pub fn clock(self: &Self) -> f64 {
    return self.engine.services.now / 1000.0
  }

  /// When the next timer is due, in the clock's seconds, or None without timers.
  pub fn nextDeadline(self: &Self) -> Option<f64> {
    let items = self.engine.services.timers.asSlice()
    if items.length == 0 { return Option<f64>.none() }
    let mut earliest = items[0].due
    let mut i: usize = 1
    while i < items.length {
      if items[i].due < earliest { earliest = items[i].due }
      i = i + 1
    }
    return Option<f64>.some(earliest / 1000.0)
  }

  /// Whether JavaScript waits for an animation frame callback.
  pub fn wantsFrame(self: &Self) -> bool {
    return self.engine.services.frame
  }

  /// Whether `media` differs from the media scripts see now, so [`JsHost.setMedia`] would
  /// run them.
  pub fn mediaChanges(self: &Self, media: &MediaState) -> bool { return self.engine.services.media.differs(media) }

  /// Takes the media of the frame about to be drawn. When a query could answer differently,
  /// `__ui.media()` runs, which sends the `change` events of `matchMedia` lists.
  pub effect fn setMedia(self: &mut Self, media: MediaState) -> () ! OutOfMemoryError | JsError ? &mut Allocator {
    if !self.engine.services.media.differs(&media) { return () }
    self.engine.services.media = media
    let context = self.context
    let realm = unsafe lendRealm(&context, context)
    let ran = run Effect.result(callUi(&mut self.engine, realm, b"media", &[]))
    match move ran {
      Result<(), JsException>.Success { .. } => ()
      Result<(), JsException>.Failure { .. } => { fail run thrown(&mut self.engine, realm) }
    }
    run drainIn(&mut self.engine, realm)
  }

  /// Moves the clock to `seconds` and runs the timers that are due, earliest first, with
  /// promise jobs after each. With `animation`, the `requestAnimationFrame` callbacks run
  /// after them. A timer set while this runs waits for the next call. When a callback
  /// throws, the rest stay queued and the failure is reported.
  pub effect fn tick(self: &mut Self, seconds: f64, animation: bool) -> () ! OutOfMemoryError | JsError ? &mut Allocator {
    self.advance(seconds)
    let context = self.context
    let realm = unsafe lendRealm(&context, context)
    let now = self.engine.services.now
    // The ids due now, earliest first: timers set by the callbacks are not among them.
    let mut due = List<Timer>.make()
    let items = self.engine.services.timers.asSlice()
    let mut i: usize = 0
    while i < items.length {
      if items[i].due <= now {
        let mut at = due.length()
        while at > 0 && due.get(at - 1).due > items[i].due { at = at - 1 }
        run due.insertSlice(at, &[items[i]])
      }
      i = i + 1
    }
    i = 0
    while i < due.length() {
      let timer = due.get(i)
      // A callback may have cancelled it, or moved it past now.
      if self.engine.services.cancel(timer.id) {
        let arguments = [ValueBits.number(u32.toF64(timer.id))]
        let fired = run Effect.result(callUi(&mut self.engine, realm, b"fire", &arguments))
        match move fired {
          Result<(), JsException>.Success { .. } => ()
          Result<(), JsException>.Failure { .. } => { fail run thrown(&mut self.engine, realm) }
        }
        run drainIn(&mut self.engine, realm)
      }
      i = i + 1
    }
    if animation && self.engine.services.frame {
      self.engine.services.frame = false
      let arguments = [ValueBits.number(now)]
      let framed = run Effect.result(callUi(&mut self.engine, realm, b"frame", &arguments))
      match move framed {
        Result<(), JsException>.Success { .. } => ()
        Result<(), JsException>.Failure { .. } => { fail run thrown(&mut self.engine, realm) }
      }
      run drainIn(&mut self.engine, realm)
    }
  }

  /// Whether IntersectionObserver or ResizeObserver watch anything.
  pub fn observing(self: &Self) -> bool { return self.engine.services.observers.any() }

  /// Runs IntersectionObserver and ResizeObserver on `tree`'s last layout. When an observation
  /// changed, JavaScript gets the entries (`__ui.observed(count)`, read with `__ui.geometry`).
  /// Call after each layout, before paint. Without observations it does nothing.
  pub effect fn observe<'t>(self: &mut Self, tree: &mut UiTree<'t>) -> () ! OutOfMemoryError | JsError ? &mut Allocator {
    if !self.engine.services.observers.any() { return () }
    self.engine.services.geometry.clear()
    let count = run self.engine.services.observers.update(&tree.*, &mut self.engine.services.geometry)
    if count == 0 { return () }
    self.attach(&mut tree)
    let context = self.context
    let realm = unsafe lendRealm(&context, context)
    let arguments = [ValueBits.number(usize.toF64(count))]
    let called = run Effect.result(callUi(&mut self.engine, realm, b"observed", &arguments))
    match move called {
      Result<(), JsException>.Success { .. } => ()
      Result<(), JsException>.Failure { .. } => { fail run thrown(&mut self.engine, realm) }
    }
    run drainIn(&mut self.engine, realm)
  }

  /// Hands `line`, a message from the development server, to JavaScript (`__ui.devMessage`).
  pub effect fn devMessage(self: &mut Self, line: string) -> () ! OutOfMemoryError | JsError ? &mut Allocator {
    let context = self.context
    let realm = unsafe lendRealm(&context, context)
    let text = run jsString(line)
    let arguments = [text.borrow().view()]
    let called = run Effect.result(callUi(&mut self.engine, realm, b"devMessage", &arguments))
    match move called {
      Result<(), JsException>.Success { .. } => ()
      Result<(), JsException>.Failure { .. } => { fail run thrown(&mut self.engine, realm) }
    }
    run drainIn(&mut self.engine, realm)
  }

  /// Takes the lines JavaScript sent to the development server since the last call.
  pub fn takeOutbox(self: &mut Self) -> List<String> {
    return Intrinsic.replace(self.engine.services.outbox, List<String>.make())
  }

  /// Whether JavaScript asked for a new realm since the last call.
  pub fn takeReload(self: &mut Self) -> bool {
    let asked = self.engine.services.reload
    self.engine.services.reload = false
    return asked
  }

  /// Takes the addresses JavaScript asked to open (`window.open`) since the last call,
  /// oldest first. The host decides what opening means.
  pub fn takeOpened(self: &mut Self) -> List<String> {
    return Intrinsic.replace(self.engine.services.opened, List<String>.make())
  }

  /// Takes the clipboard reads and writes JavaScript asked for (`navigator.clipboard`) since
  /// the last call, oldest first. The host answers each with [`JsHost.answerClipboard`].
  pub fn takeClipboard(self: &mut Self) -> List<ClipboardRequest> {
    return Intrinsic.replace(self.engine.services.clipboard, List<ClipboardRequest>.make())
  }

  /// Settles clipboard call `call`: a text read with the clipboard's `text` (none when it
  /// holds no text), an item read with its `item`, a write with neither.
  pub effect fn answerClipboard(self: &mut Self, call: u32, text: Option<String>, item: Option<EncodedItem>) -> () ! OutOfMemoryError | JsError ? &mut Allocator {
    let context = self.context
    let realm = unsafe lendRealm(&context, context)
    if let Option<EncodedItem>.Some { value: encoded } = move item {
      let header = run jsString(encoded.header.view())
      let body = run jsLatin1(encoded.body.asSlice())
      let arguments = [ValueBits.number(u32.toF64(call)), header.borrow().view(), body.borrow().view()]
      let called = run Effect.result(callUi(&mut self.engine, realm, b"clipboardItem", &arguments))
      realm.release(&mut self.engine, move header)
      realm.release(&mut self.engine, move body)
      match move called {
        Result<(), JsException>.Success { .. } => ()
        Result<(), JsException>.Failure { .. } => { fail run thrown(&mut self.engine, realm) }
      }
      return ()
    }
    let value = match move text {
      Option.Some { value } => run jsString(String.view(&value))
      Option.None => Value.immediate(ValueBits.Undefined)
    }
    let arguments = [ValueBits.number(u32.toF64(call)), value.borrow().view()]
    let called = run Effect.result(callUi(&mut self.engine, realm, b"clipboard", &arguments))
    realm.release(&mut self.engine, move value)
    match move called {
      Result<(), JsException>.Success { .. } => ()
      Result<(), JsException>.Failure { .. } => { fail run thrown(&mut self.engine, realm) }
    }
    run drainIn(&mut self.engine, realm)
  }

  /// The app's exported Silk functions.
  pub fn natives(self: &Self) -> Natives { return self.engine.services.natives }

  /// Takes the `__ui.nativeStart` calls JavaScript made since the last call, oldest first. The
  /// host runs each and answers it with [`JsHost.answerNative`].
  pub fn takeStartedNatives(self: &mut Self) -> List<StartedNative> {
    return Intrinsic.replace(self.engine.services.started, List<StartedNative>.make())
  }

  /// Settles the promise of `__ui.nativeStart` call `token` with what the function replied.
  pub effect fn answerNative(self: &mut Self, token: u32, reply: Reply) -> () ! OutOfMemoryError | JsError ? &mut Allocator {
    let context = self.context
    let realm = unsafe lendRealm(&context, context)
    let mut kind: f64 = 0.0
    let value = match move reply {
      Reply.Nothing => Value.immediate(ValueBits.Undefined)
      Reply.Number { value: number } => Value.immediate(ValueBits.number(number))
      Reply.Flag { value: flag } => Value.immediate(ValueBits.Bool { value: flag })
      Reply.Text { value: text } => run jsString(String.view(&text))
      Reply.TypeError { message } => {
        kind = 1.0
        run jsString(String.view(&message))
      }
      Reply.Failed { message } => {
        kind = 2.0
        run jsString(String.view(&message))
      }
      Reply.OutOfMemory => {
        kind = 2.0
        run jsString("out of memory")
      }
    }
    let arguments = [ValueBits.number(u32.toF64(token)), ValueBits.number(kind), value.borrow().view()]
    let called = run Effect.result(callUi(&mut self.engine, realm, b"nativeDone", &arguments))
    realm.release(&mut self.engine, move value)
    match move called {
      Result<(), JsException>.Success { .. } => ()
      Result<(), JsException>.Failure { .. } => { fail run thrown(&mut self.engine, realm) }
    }
    run drainIn(&mut self.engine, realm)
  }

  /// Has `navigator.gpu` there from now on: the host runs the WebGPU commands it takes with
  /// [`JsHost.takeGpuCommands`] and answers them with [`JsHost.answerGpu`].
  pub fn enableGpu(self: &mut Self) -> () {
    self.engine.services.gpuEnabled = true
    self.engine.services.canvas2dEnabled = true
  }

  /// Takes the WebGPU commands JavaScript wrote since the last call (see `webgpu.js`).
  pub fn takeGpuCommands(self: &mut Self) -> List<u8> {
    return Intrinsic.replace(self.engine.services.gpuCommands, List<u8>.make())
  }

  /// Hands JavaScript what the GPU service answered: its promises settle and their jobs run.
  pub effect fn answerGpu(self: &mut Self, replies: List<GpuReply>) -> () ! OutOfMemoryError | JsError ? &mut Allocator {
    if replies.length() == 0 { return () }
    let context = self.context
    let realm = unsafe lendRealm(&context, context)
    let count = replies.length()
    self.engine.services.gpuReplies = move replies
    let arguments = [ValueBits.number(usize.toF64(count))]
    let called = run Effect.result(callUi(&mut self.engine, realm, b"gpuReplies", &arguments))
    self.engine.services.gpuReplies = List<GpuReply>.make()
    match move called {
      Result<(), JsException>.Success { .. } => ()
      Result<(), JsException>.Failure { .. } => { fail run thrown(&mut self.engine, realm) }
    }
    run drainIn(&mut self.engine, realm)
  }

  /// Takes the desktop calls JavaScript asked for since the last call, oldest first. The
  /// host answers each with [`JsHost.answerShell`].
  pub fn takeShell(self: &mut Self) -> List<ShellRequest> {
    return Intrinsic.replace(self.engine.services.shell, List<ShellRequest>.make())
  }

  /// Answers desktop call `call` with `value` (`__ui.shellAnswer`).
  pub effect fn answerShell(self: &mut Self, call: u32, value: f64) -> () ! OutOfMemoryError | JsError ? &mut Allocator {
    let context = self.context
    let realm = unsafe lendRealm(&context, context)
    let arguments = [ValueBits.number(u32.toF64(call)), ValueBits.number(value)]
    let called = run Effect.result(callUi(&mut self.engine, realm, b"shellAnswer", &arguments))
    match move called {
      Result<(), JsException>.Success { .. } => ()
      Result<(), JsException>.Failure { .. } => { fail run thrown(&mut self.engine, realm) }
    }
    run drainIn(&mut self.engine, realm)
  }

  /// Hands a desktop event to JavaScript (`__ui.shellEvent(kind, a, x, y, text)`): kinds 0
  /// to 3 are a file drag entering, moving over, leaving and dropping on node `a` at `x`,
  /// `y`, with the paths one per line in `text`; 4 is global shortcut `a`; 5 a click on the
  /// tray with `MouseEvent.button` `a`; 6 menu item `a` (the tray's, the menu bar's or a
  /// context menu's); 7 a click on notification `a`; 8 dialog `a` closed with the paths in
  /// `text`; 9 the context menu closed without a choice; 10 full screen is `a` (1 or 0); 11
  /// the page zoom is `a`.
  pub effect fn shellEvent(self: &mut Self, kind: u32, a: f64, x: f64, y: f64, text: string) -> () ! OutOfMemoryError | JsError ? &mut Allocator {
    let context = self.context
    let realm = unsafe lendRealm(&context, context)
    let value = run jsString(text)
    let arguments = [
      ValueBits.number(u32.toF64(kind)),
      ValueBits.number(a),
      ValueBits.number(x),
      ValueBits.number(y),
      value.borrow().view(),
    ]
    let called = run Effect.result(callUi(&mut self.engine, realm, b"shellEvent", &arguments))
    realm.release(&mut self.engine, move value)
    match move called {
      Result<(), JsException>.Success { .. } => ()
      Result<(), JsException>.Failure { .. } => { fail run thrown(&mut self.engine, realm) }
    }
    run drainIn(&mut self.engine, realm)
  }

  /// Takes the console lines JavaScript wrote since the last call, oldest first.
  pub fn takeLogs(self: &mut Self) -> List<LogEntry> {
    return Intrinsic.replace(self.engine.services.logs, List<LogEntry>.make())
  }

  /// Collects garbage now, cycles included (the engine frees other garbage as it goes). A
  /// host can call it when it is idle; the engine also collects on its own as it allocates.
  /// It is the engine's own full collection, so the engine's next one is reckoned from what
  /// this one left, not from the heap before it.
  pub effect fn collect(self: &mut Self) -> () ? &mut Allocator {
    if self.closed { return }
    let memory = self.engine.memory
    drop run unsafe runtime.triggerGC(memory, &mut self.engine, self.runtime, 0, true)
  }

  /// Gives the engine's wholly idle arenas back to the system, keeping `reserve` bytes of
  /// them for the next allocations, and returns the bytes released. The arenas the last
  /// collection emptied are let go of first; on macOS the pool can give back no other.
  pub fn releaseIdle(self: &mut Self, reserve: usize) -> usize {
    if self.closed { return 0 }
    return unsafe runtime.releaseIdle(self.engine.memory, self.runtime, reserve)
  }

  /// Frees the realm and the runtime. Safe to call twice.
  pub effect fn close(self: &mut Self) -> () ? &mut Allocator {
    if self.closed { return }
    let context = self.context
    let realm = unsafe lendRealm(&context, context)
    let mut rest = Intrinsic.replace(self.engine.services.rejections, List<Rejected>.make())
    while rest.length() > 0 {
      let Rejected { promise: rejected, reason } = rest.remove(0)
      realm.release(&mut self.engine, move rejected)
      realm.release(&mut self.engine, move reason)
    }
    unsafe gc.releaseHeader(&mut self.engine, self.runtime, self.context)
    run unsafe gc.destroyRuntime(&mut self.engine, self.runtime)
    self.closed = true
  }
}
