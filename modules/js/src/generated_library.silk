rent. */\x0aexport class Text extends Node {\x0a  #data = \x22\x22;\x0a\x0a  constructor(data = \x22\x22) {\x0a    super(\x22text\x22);\x0a    this.data = data;\x0a  }\x0a\x0a  get data() {\x0a    return this.#data;\x0a  }\x0a\x0a  set data(value) {\x0a    value = String(value);\x0a    if (value === this.#data && value !== \x22\x22) return;\x0a    this.#data = value;\x0a    native.setText(this.id, value);\x0a  }\x0a\x0a  get textContent() {\x0a    return this.#data;\x0a  }\x0a\x0a  set textContent(value) {\x0a    this.data = value;\x0a  }\x0a}\x0a\x0a/** An editable text field. `value` follows what the user types. */\x0aexport class Input extends Node {\x0a  #value = \x22\x22;\x0a\x0a  constructor() {\x0a    super(\x22input\x22);\x0a    this.selectionStart = 0;\x0a    this.selectionEnd = 0;\x0a  }\x0a\x0a  get value() {\x0a    return this.#value;\x0a  }\x0a\x0a  set value(value) {\x0a    this.#value = String(value);\x0a    native.setText(this.id, this.#value);\x0a  }\x0a\x0a  /** Selects from `anchor` to `focus`, as UTF-8 byte offsets in the value. */\x0a  setSelectionRange(anchor, focus) {\x0a    native.select(this.id, anchor, focus);\x0a  }\x0a\x0a  _changed(value, anchor, focus) {\x0a    this.#value = value;\x0a    this.selectionStart = Math.min(anchor, focus);\x0a    this.selectionEnd = Math.max(anchor, focus);\x0a  }\x0a}\x0a\x0afunction forget(node) {\x0a  nodes.delete(node.id);\x0a  for (const child of node.childNodes) {\x0a    child.parentNode = null;\x0a    forget(child);\x0a  }\x0a  node.childNodes = [];\x0a}\x0a\x0aexport function createNode(kind) {\x0a  if (!(kind in KINDS)) throw new TypeError(\x22the tree has no node kind '\x22 + kind + \x22'\x22);\x0a  if (kind === \x22text\x22) return new Text();\x0a  if (kind === \x22input\x22) return new Input();\x0a  return new Node(kind);\x0a}\x0a\x0a/** A box with `style` as its base look and `children` appended. */\x0aexport function createBox(style, ...children) {\x0a  const box = new Node(\x22box\x22);\x0a  if (style) box.style.set(style);\x0a  box.append(...children);\x0a  return box;\x0a}\x0a\x0aexport function createText(data = \x22\x22) {\x0a  return new Text(data);\x0a}\x0a\x0aexport function createInput(style) {\x0a  const input = new Input();\x0a  if (style) input.style.set(style);\x0a  return input;\x0a}\x0a\x0alet rootNode = null;\x0a\x0a/** Makes `node` the root of the window's tree. */\x0a/**\x0a * Defines `@keyframes name` as CSS would: `{ from: { opacity: 0 }, \x2250%\x22: {...}, to: {...} }`,\x0a * with selectors such as `\x220%, 100%\x22` too. Style objects name it in `animation` or\x0a * `animationName`. Defining a name again replaces its rule; `null` removes it.\x0a */\x0aexport function defineKeyframes(name, frames) {\x0a  for (const selector of Object.keys(frames ?? {})) {\x0a    let css = \x22\x22;\x0a    const declarations = frames[selector];\x0a    for (const property of Object.keys(declarations)) {\x0a      const value = declarations[property];\x0a      if (value === null || value === undefined || value === \x22\x22) continue;\x0a      css += cssName(property) + \x22:\x22 + cssValue(property, value) + \x22;\x22;\x0a    }\x0a    for (const part of selector.split(\x22,\x22)) {\x0a      const text = part.trim().toLowerCase();\x0a      const offset = text === \x22from\x22 ? 0 : text === \x22to\x22 ? 1 : parseFloat(text) / 100;\x0a      if (!(offset >= 0 && offset <= 1)) throw new Error(`@silk/ui: bad keyframe selector '${part}'`);\x0a      native.keyframe(offset, css);\x0a    }\x0a  }\x0a  native.keyframes(String(name));\x0a}\x0a\x0aexport function mount(node) {\x0a  rootNode = node;\x0a  native.root(node.id);\x0a  return node;\x0a}\x0a\x0aexport function root() {\x0a  return rootNode;\x0a}\x0a\x0a/** The node with tree id `id`, for hosts and tools. */\x0aexport function nodeById(id) {\x0a  return nodes.get(id) ?? null;\x0a}\x0a\x0alet errorHandler = null;\x0alet pendingError = null;\x0a\x0a/**\x0a * What happens to an exception a listener throws. As on the web, it does not stop the\x0a * dispatch. Without a handler, the host reports the first one after the input is handled.\x0a */\x0aexport function setErrorHandler(handler) {\x0a  errorHandler = handler;\x0a}\x0a\x0afunction reportError(error) {\x0a  if (errorHandler) errorHandler(error);\x0a  else pendingError ??= { error };\x0a}\x0a\x0a/** An event of the tree, with the members of the DOM event it corresponds to. */\x0aexport class Event {\x0a  constructor(type, target) {\x0a    this.type = type;\x0a    this.target = target;\x0a    this.currentTarget = null;\x0a    this.eventPhase = 0;\x0a    this.bubbles = !NO_BUBBLE.has(type);\x0a    this.cancelable = CANCELABLE.has(type);\x0a    this.defaultPrevented = false;\x0a    this._stopped = false;\x0a    this._immediate = false;\x0a  }\x0a\x0a  preventDefault() {\x0a    if (this.cancelable) this.defaultPrevented = true;\x0a  }\x0a\x0a  stopPropagation() {\x0a    this._stopped = true;\x0a  }\x0a\x0a  stopImmediatePropagation() {\x0a    this._stopped = true;\x0a    this._immediate = true;\x0a  }\x0a\x0a  /** The nodes the event passes, target first. */\x0a  composedPath() {\x0a    const path = [];\x0a    for (let node = this.target; node; node = node.parentNode) path.push(node);\x0a    return path;\x0a  }\x0a}\x0a\x0afunction fill(event, kind, a, b, modifiers, d, e, first, second) {\x0a  if (kind <= 6 || kind === 14) {\x0a    event.clientX = event.x = a;\x0a    event.clientY = event.y = b;\x0a  }\x0a  if (kind <= 8 || kind === 14) {\x0a    event.shiftKey = (modifiers & 1) !== 0;\x0a    event.ctrlKey = (modifiers & 2) !== 0;\x0a    event.altKey = (modifiers & 4) !== 0;\x0a    event.metaKey = (modifiers & 8) !== 0;\x0a  }\x0a  if (kind <= 2) {\x0a    event.button = d;\x0a    event.detail = e;\x0a  } else if (kind === 6) {\x0a    event.deltaX = d;\x0a    event.deltaY = e;\x0a  } else if (kind === 7 || kind === 8) {\x0a    event.key = first;\x0a    event.code = second;\x0a    event.repeat = d !== 0;\x0a  } else if (kind === 11) {\x0a    event.value = first;\x0a    event.inputType = second;\x0a    event.target._changed?.(first, a, b);\x0a  } else if (kind === 12) {\x0a    event.scrollLeft = a;\x0a    event.scrollTop = b;\x0a  } else if (kind === 13) {\x0a    event.bounds = { x: a, y: b, width: d, height: e };\x0a  } else if (kind >= 19 && kind <= 22) {\x0a    event.propertyName = first;\x0a    event.elapsedTime = a;\x0a    event.pseudoElement = \x22\x22;\x0a  } else if (kind >= 23) {\x0a    event.animationName = first;\x0a    event.elapsedTime = a;\x0a    event.pseudoElement = \x22\x22;\x0a  }\x0a}\x0a\x0a/**\x0a * Runs `event` through the tree as the DOM does: the capture phase from the root down, the\x0a * target, then the bubble phase back up for events that bubble. Returns false when a\x0a * listener prevented the default.\x0a */\x0aexport function dispatchEvent(event) {\x0a  const path = event.composedPath();\x0a  for (let i = path.length - 1; i > 0 && !event._stopped; i--) {\x0a    event.eventPhase = 1;\x0a    event.currentTarget = path[i];\x0a    path[i]._run(event, true);\x0a  }\x0a  if (!event._stopped) {\x0a    event.eventPhase = 2;\x0a    event.currentTarget = path[0];\x0a    path[0]._run(event, true);\x0a    if (!event._stopped) path[0]._run(event, false);\x0a  }\x0a  if (event.bubbles) {\x0a    for (let i = 1; i < path.length && !event._stopped; i++) {\x0a      event.eventPhase = 3;\x0a      event.currentTarget = path[i];\x0a      path[i]._run(event, false);\x0a    }\x0a  }\x0a  event.eventPhase = 0;\x0a  event.currentTarget = null;\x0a  return !event.defaultPrevented;\x0a}\x0a\x0a// The host calls this for every event record, before the tree runs the default action.\x0anative.dispatch = function (kind, id, a, b, modifiers, d, e, first, second) {\x0a  const target = nodes.get(id);\x0a  if (!target) return false;\x0a  const event = new Event(TYPES[kind], target);\x0a  fill(event, kind, a, b, modifiers, d, e, first, second);\x0a  dispatchEvent(event);\x0a  if (kind === CLICK && !event.defaultPrevented) follow(target);\x0a  return event.defaultPrevented;\x0a};\x0a\x0a// The default action of a click: the nearest link around the target opens.\x0afunction follow(target) {\x0a  for (let node = target; node; node = node.parentNode) {\x0a    if (node._href) {\x0a      try {\x0a        globalThis.open(node._href);\x0a      } catch (error) {\x0a        reportError(error);\x0a      }\x0a      return;\x0a    }\x0a  }\x0a}\x0a\x0a// The host calls this before it replaces the realm, on a reload: every node goes, so the\x0a// next realm starts on an empty tree.\x0anative.unload = function () {\x0a  for (const node of [...nodes.values()]) if (!node.parentNode && nodes.has(node.id)) node.destroy();\x0a  rootNode = null;\x0a};\x0a\x0a// The host calls this after it handled an input: an exception a listener threw surfaces here.\x0anative.takeError = function () {\x0a  if (!pendingError) return;\x0a  const { error } = pendingError;\x0a  pendingError = null;\x0a  throw error;\x0a};\x0a" }
