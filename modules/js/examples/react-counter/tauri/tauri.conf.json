{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Silk UI",
  "version": "0.1.0",
  "identifier": "dev.silk.react-counter",
  "build": { "frontendDist": "../dist-web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Silk UI",
        "width": 1040,
        "height": 720,
        "backgroundColor": "#040405",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}
