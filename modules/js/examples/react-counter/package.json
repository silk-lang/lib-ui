{
  "name": "react-counter",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "watch": "vite build --watch --mode development",
    "build:web": "vite build --config vite.web.config.js",
    "dev:web": "vite --config vite.web.config.js",
    "electron": "npm run build:web && npm start --prefix electron",
    "tauri": "npm run build:web && cargo run --release --manifest-path tauri/Cargo.toml"
  },
  "dependencies": {
    "@silk/ui-react": "0.1.0",
    "@silk/ui": "0.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@silk/vite": "0.1.0",
    "vite": "^8.3.0"
  }
}
