//! The bundled examples on the embedded engine, without a window. Build them first
//! (`npm ci && npm run build` in modules/js), then run from the repository root:
//! `silk test --manifest-path modules/js/examples/tests/silk.toml --root src/tests.silk`.
import ui_js.lib { JsHost, JsError }
import ui_tree.lib { Tree, TreeError, ProtocolError, Viewport, Input }
import ui_tree.inspect { findAll, info, NodeInfo }
import ui_fixtures.fixtures as fixtures
import silkjs.js_atomics_native { WaiterDomain, SynchronizationError }
import silkjs.runtime_memory { RuntimeAllocator }
import silkjs.js_libc_platform as platform
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

/// The size the demo host opens its window at: the counter is on screen without scrolling.
fn viewport() -> Viewport {
  return Viewport { width: 1040.0, height: 720.0, scale: 1.0 }
}

/// Whether a node has `value` as its test id, label or text.
effect fn shows(tree: &Tree<'_>, value: string) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut found = List<u32>.make()
  run findAll(tree.engine(), value, &mut found)
  return found.length() > 0
}

/// Presses and releases the primary button in the middle of the node named `value`.
effect fn click(host: &mut JsHost<'_>, tree: &mut Tree<'_>, value: string<'static>) -> ()
  ! ProtocolError | OutOfMemoryError | JsError | AssertionError<'static>
  ? &mut Allocator {
  let mut found = List<u32>.make()
  run findAll(tree.engine(), value, &mut found)
  run Testing.expect(found.length() > 0, value)
  let mut x: f32 = 0.0
  let mut y: f32 = 0.0
  if let Option<NodeInfo>.Some { value: node } = run info(tree.engine(), found.get(0)) {
    x = (node.bounds.xMin + node.bounds.xMax) * 0.5
    y = (node.bounds.yMin + node.bounds.yMax) * 0.5
  }
  run host.input(&mut tree, Input.press(x, y))
  run host.input(&mut tree, Input.release(x, y))
}

/// React 19 with hooks: the first render is there when `render` returns, a click commits a
/// state change before the mutations apply, and the page's motion runs on the host's
/// animation frames, on nodes it reached by ref.
effect fn reactCounter(host: &mut JsHost<'_>, tree: &mut Tree<'_>) -> ()
  ! TreeError | ProtocolError | OutOfMemoryError | JsError | platform.PlatformError | AssertionError<'static>
  ? &mut Allocator {
  let bundle = run platform.readFile(b"modules/js/examples/react-counter/dist/app.js")
  run host.module(bundle.asSlice(), b"app.js")
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.0)
  run Testing.expect(run shows(&tree.*, "CLICK ANYWHERE"), "the first render shows the page")
  run Testing.expect(run shows(&tree.*, "0"), "the count starts at zero")

  // The effect that starts the motion runs on a timer of React's scheduler.
  run host.tick(0.5, true)
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.5)

  run click(&mut host, &mut tree, "counter")
  drop run tree.frame(viewport(), 0.6)
  run Testing.expect(run shows(&tree.*, "CLICKED"), "the click changed the words")
  run Testing.expect(run shows(&tree.*, "1"), "the click counted")

  // Frames after the click: its rings and sparks move, then go.
  run host.tick(0.7, true)
  run host.tick(1.5, true)
  run host.tick(3.0, true)
  run host.tick(3.1, true)
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 3.1)

  run click(&mut host, &mut tree, "theme")
  drop run tree.frame(viewport(), 3.2)
  run Testing.expect(run shows(&tree.*, "DARK"), "the switch changed the theme")
  run Testing.expect(run shows(&tree.*, "CLICKED"), "and a click on it did not count")
}

effect fn withHost() -> ()
  ! TreeError | ProtocolError | OutOfMemoryError | JsError | SynchronizationError | platform.PlatformError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run Tree.make(&fonts)
  let domain = run WaiterDomain.make()
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run allocator.observe()
  let mut host = run JsHost.open(&memory, domain.handle()) |> Effect.provideMut<Allocator>(&mut allocator)
  let ran = run Effect.result(reactCounter(&mut host, &mut tree)) |> Effect.provideMut<Allocator>(&mut allocator)
  run host.close() |> Effect.provideMut<Allocator>(&mut allocator)
  match move ran {
    Result<(), TreeError | ProtocolError | OutOfMemoryError | JsError | platform.PlatformError | AssertionError<'static>>.Success { .. } => ()
    Result<(), TreeError | ProtocolError | OutOfMemoryError | JsError | platform.PlatformError | AssertionError<'static>>.Failure { error } => { fail move error }
  }
}

test effect fn reactCounterRunsOnTheEmbeddedEngine() -> ()
  ! TreeError | ProtocolError | OutOfMemoryError | JsError | SynchronizationError | platform.PlatformError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run withHost() |> Effect.provideMut<Allocator>(&mut allocator)
}
