//! The production host of the JavaScript counter: the development host (`main.silk`)
//! without its tools. No reload on a new build, no development server, no inspector: none
//! of their code is in this program. Built by `silk build --profile production`.
//! `ui-js-demo [--check] [bundle.js]`, from the repository root.
import app { program, failed, same, argument, argumentCount }
import ui_js_window.lib { NoTools }
import ui_tree_window.platform_thread { Launched, launch }
import ui_inspect_server.lib { Inspector }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator }
import silk.system.host_input { HostInput }

fn runApp(check: bool, entry: Bytes, launched: Option<Launched>) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(program(check, Bytes.asSlice(&entry), NoTools {}, Inspector.off(), move launched), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

/// Opens the JavaScript counter, or verifies its GPU output with --check.
pub effect fn main() -> i32
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let count = run argumentCount()
  let mut check = false
  let mut entry = Bytes.make()
  let mut i: usize = 1
  while i < count {
    if let Option<Bytes>.Some { value } = run argument(i) |> Effect.provideMut<Allocator>(&mut allocator) {
      if same(Bytes.asSlice(&value), b"--check") {
        check = true
      } else {
        entry = move value
      }
    }
    i = i + 1
  }
  let checking = check
  let path = move entry
  // The main thread keeps the OS event loop; the app runs on its own thread.
  return run Effect.catchAll(
    launch(
      fn(launched: Option<Launched>) -> i32 {
        return runApp(checking, move path, move launched)
      },
    ),
    failed,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}
