//! A counter written in JavaScript, in a native window with the SilkJS engine embedded: the
//! development host. `@silk/ui`, the starter page (`app.js`) and the fonts are part of the
//! binary, so it runs from any directory. Pass --check for a GPU smoke test, and the path
//! of another entry module (a bundle, for example) to run that instead. With --watch the entry is reloaded whenever the file `<entry>.stamp` changes,
//! which `@silk/vite` writes after each build. With --dev <port> the application comes from
//! the development server at that port on this machine, as `vite` with `@silk/vite` runs
//! one. --fonts <directory> adds the font files in it to the bundled ones. A debug build
//! serves the inspector when SILK_UI_INSPECT is set.
//!
//! `silk build --profile production` builds `production.silk` instead: the same host
//! without these tools.
import app { program, failed, same, argument, argumentCount }
import ui_js_window_dev.lib { DevTools }
import ui_tree_window.host { startInspector }
import ui_tree_window.platform_thread { Launched, launch }
import ui_inspect_server.lib { InspectorOptions }
import ui_js.lib { JsError }
import ui_tree.legacy { TreeError }
import silkjs.js_atomics_native { SynchronizationError }
import silkjs.js_libc_platform as platform
import window.types { WindowError }
import webgpu.runtime { GpuError }
import atlas.atlas { AtlasError }
import vector.geometry_error { GeometryError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.u32
import silk.system.host_input { HostInput }

/// The port number `text` spells, or 0 when it is not one.
fn portOf(text: &[u8]) -> u16 {
  let mut value: u32 = 0
  let mut i: usize = 0
  while i < text.length {
    if text[i] < 48 || text[i] > 57 { return 0 }
    value = value * 10 + u8.toU32(text[i] - 48)
    if value > 65535 { return 0 }
    i = i + 1
  }
  return u32.toU16(value)
}

fn runApp(check: bool, watch: bool, port: u16, entry: Bytes, fonts: Bytes, launched: Option<Launched>) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(develop(check, watch, port, Bytes.asSlice(&entry), Bytes.asSlice(&fonts), move launched), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn develop(check: bool, watch: bool, port: u16, entry: &[u8], fonts: &[u8], launched: Option<Launched>) -> i32
  ! TreeError | WindowError | GpuError | AtlasError | GeometryError | OutOfMemoryError | JsError | SynchronizationError | platform.PlatformError
  ? &mut Allocator {
  let mut tools = DevTools.make()
  if port != 0 { tools.server(port) }
  if watch && entry.length != 0 {
    let mut stamp = List<u8>.make()
    run stamp.appendSlice(entry)
    run stamp.appendSlice(b".stamp")
    run tools.watch(entry, stamp.asSlice())
  }
  let inspector = run startInspector(InspectorOptions.make())
  return run program(check, entry, fonts, move tools, move inspector, move launched)
}

/// `path` from the working directory when it is relative.
effect fn absolute(path: Bytes) -> Bytes ? &mut HostInput | &mut Allocator {
  let bytes = Bytes.asSlice(&path)
  if bytes.length == 0 || bytes[0] == 47 || (bytes.length > 1 && bytes[1] == 58) { return move path }
  if let Result.Success { value: cwd } = run Effect.result(HostInput.workingDirectory()) {
    let mut joined = move cwd
    if let Result.Success { value } = run Effect.result(Bytes.append(&mut joined, b"/")) { drop value }
    if let Result.Success { value } = run Effect.result(Bytes.append(&mut joined, bytes)) { drop value }
    return move joined
  }
  return move path
}

/// Opens the JavaScript counter, or verifies its GPU output with --check.
pub effect fn main() -> i32
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let count = run argumentCount()
  let mut check = false
  let mut watch = false
  let mut port: u16 = 0
  let mut portNext = false
  let mut fontsNext = false
  let mut fonts = Bytes.make()
  let mut entry = Bytes.make()
  let mut i: usize = 1
  while i < count {
    if let Option<Bytes>.Some { value } = run argument(i) |> Effect.provideMut<Allocator>(&mut allocator) {
      if portNext {
        portNext = false
        port = portOf(Bytes.asSlice(&value))
      } else if fontsNext {
        fontsNext = false
        fonts = move value
      } else if same(Bytes.asSlice(&value), b"--fonts") {
        fontsNext = true
      } else if same(Bytes.asSlice(&value), b"--dev") {
        portNext = true
      } else if same(Bytes.asSlice(&value), b"--check") {
        check = true
      } else if same(Bytes.asSlice(&value), b"--watch") {
        watch = true
      } else {
        entry = move value
      }
    }
    i = i + 1
  }
  let checking = check
  let watching = watch
  let serving = port
  let path = move entry
  let directory = run absolute(move fonts) |> Effect.provideMut<Allocator>(&mut allocator)
  // The main thread keeps the OS event loop; the app runs on its own thread.
  return run Effect.catchAll(
    launch(
      fn(launched: Option<Launched>) -> i32 {
        return runApp(checking, watching, serving, move path, move directory, move launched)
      },
    ),
    failed,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}
