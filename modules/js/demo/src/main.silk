//! A counter written in JavaScript, in a native window with the SilkJS engine embedded.
//! Run it from the repository root: it reads `@silk/ui` and `modules/js/demo/app.js` from
//! there, as the fixture fonts are. Pass --check for a GPU smoke test, and the path of
//! another entry module (a bundle, for example) to run that instead. With --watch the entry
//! is reloaded whenever the file `<entry>.stamp` changes, which `@silk/vite` writes after
//! each build. With --dev <port> the application comes from the development server at
//! that port on this machine, as `vite` with `@silk/vite` runs one.
import ui_js.lib { JsError }
import ui_js_window.lib { JsApp, JsClient }
import ui_tree.legacy { TreeError, Mutation }
import ui_tree_window.host { RunOptions, runWindow, startInspector }
import ui_tree_window.platform_thread { Launched, launch }
import ui_tree_window.console { StderrWriter }
import ui_fixtures.fixtures as fixtures
import ui_inspect_server.lib { InspectorOptions }
import silkjs.js_atomics_native { WaiterDomain, SynchronizationError }
import silkjs.runtime_memory { RuntimeAllocator }
import silkjs.js_libc_platform as platform
import window.types { WindowError }
import webgpu.runtime { GpuError }
import atlas.atlas { AtlasError }
import vector.geometry_error { GeometryError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.u32
import silk.system.host_input { HostInput }

effect fn program(check: bool, watch: bool, port: u16, entry: &[u8], launched: Option<Launched>) -> i32
  ! TreeError | WindowError | GpuError | AtlasError | GeometryError | OutOfMemoryError | JsError | SynchronizationError | platform.PlatformError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let library = run platform.readFile(b"modules/js/packages/ui/src/index.js")
  let source = if entry.length == 0 {
    run platform.readFile(b"modules/js/demo/app.js")
  } else {
    run platform.readFile(entry)
  }
  let domain = run WaiterDomain.make()
  let allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run allocator.observe()
  let mut app = run JsApp.open(&memory, move allocator, domain.handle())
  run app.define(b"@silk/ui", library.asSlice())
  run app.entry(b"app.js", source.asSlice())
  if port != 0 { app.dev(port) }
  if watch && entry.length != 0 {
    let mut stamp = List<u8>.make()
    run stamp.appendSlice(entry)
    run stamp.appendSlice(b".stamp")
    run app.watch(entry, stamp.asSlice())
  }
  let mut client = JsClient {}
  let options = RunOptions {
    title: "JavaScript on the tree",
    width: 400.0,
    height: 250.0,
    check: check,
    checkClick: "counter",
    checkExpect: "Clicked",
    lowestLatency: false,
    platform: move launched,
  }
  let inspector = run startInspector(InspectorOptions.make())
  let status = run Effect.result(runWindow(&mut app, &fonts, List<Mutation>.make(), move options, move inspector, &mut client))
  run app.close()
  return match move status {
    Result<i32, WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError>.Success { value } => value
    Result<i32, WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError>.Failure { error } => { fail move error }
  }
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  StderrWriter.print("The JavaScript window host failed\n", &())
  return 2
}

fn runApp(check: bool, watch: bool, port: u16, entry: Bytes, launched: Option<Launched>) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(program(check, watch, port, Bytes.asSlice(&entry), move launched), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn noArguments<E>(error: E) -> usize {
  drop error
  return 0
}

effect fn noArgument<E>(error: E) -> Option<Bytes> {
  drop error
  return Option<Bytes>.None
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] { return false }
    i = i + 1
  }
  return true
}

/// The port number `text` spells, or 0 when it is not one.
fn portOf(text: &[u8]) -> u16 {
  let mut value: u32 = 0
  let mut i: usize = 0
  while i < text.length {
    if text[i] < 48 || text[i] > 57 { return 0 }
    value = value * 10 + u8.toU32(text[i] - 48)
    if value > 65535 { return 0 }
    i = i + 1
  }
  return u32.toU16(value)
}

/// Opens the JavaScript counter, or verifies its GPU output with --check.
pub effect fn main() -> i32
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let count = run Effect.catchAll(HostInput.argumentCount(), noArguments)
  let mut check = false
  let mut watch = false
  let mut port: u16 = 0
  let mut portNext = false
  let mut entry = Bytes.make()
  let mut i: usize = 1
  while i < count {
    if let Option<Bytes>.Some { value } = run Effect.catchAll(HostInput.argument(i), noArgument) |> Effect.provideMut<Allocator>(&mut allocator) {
      if portNext {
        portNext = false
        port = portOf(Bytes.asSlice(&value))
      } else if same(Bytes.asSlice(&value), b"--dev") {
        portNext = true
      } else if same(Bytes.asSlice(&value), b"--check") {
        check = true
      } else if same(Bytes.asSlice(&value), b"--watch") {
        watch = true
      } else {
        entry = move value
      }
    }
    i = i + 1
  }
  let checking = check
  let watching = watch
  let serving = port
  let path = move entry
  // The main thread keeps the OS event loop; the app runs on its own thread.
  return run Effect.catchAll(
    launch(
      fn(launched: Option<Launched>) -> i32 {
        return runApp(checking, watching, serving, move path, move launched)
      },
    ),
    failed,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}
