//! The highlight overlay, in an isolated layer on top of the tree's frame: the nodes pointed at
//! washed in cyan with a hairline around their border box, the selected ones ringed in amber a
//! little outside it, as the devtools draw them. The tree's own scene and paint caches are never
//! touched. [`boxModels`] gives the four boxes for clients that show them in numbers.
import ui_tree.engine { UiTree }
import ui_tree.node { NONE }
import ui_tree.inspect { FragmentInfo, fragmentsOf }
import layout.lib { FragmentKind }
import ui_scene.primitives { Quad, ContentMask, Background, Isolation, BorderStyle }
import ui_scene.scene { Scene }
import silk.collections.list { List }
import silk.color.rgba { Rgba }
import silk.core.ownership { Copy }
import silk.geometry.corners { Corners }
import silk.geometry.insets { Insets }
import silk.geometry.rect { Rect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.u32

/// The four boxes of one fragment of a node, in CSS pixels of the viewport.
pub struct BoxModel {
  pub margin: Rect<f32>,
  pub border: Rect<f32>,
  pub padding: Rect<f32>,
  pub content: Rect<f32>,
}

impl Copy for BoxModel {}

/// The box model of each of node `id`'s own fragments after the last layout: one for a block,
/// one per line for an inline box or a text node split across lines. Empty when the node has
/// no box.
pub effect fn boxModels(tree: &UiTree<'_>, id: u32, out: &mut List<BoxModel>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  out.clear()
  let slot = tree.slotOf(id)
  if slot == NONE {
    return ()
  }
  let css = tree.node(slot).css
  let values = tree.output.fragments.values.asSlice()
  let mut fragments = List<FragmentInfo>.make()
  run fragmentsOf(tree, slot, &mut fragments)
  let mut i: usize = 0
  while i < fragments.length() {
    let info = fragments.get(i)
    let f = &values[info.index]
    i = i + 1
    if f.source != css {
      continue
    }
    if f.kind == FragmentKind.Text {
      // Text comes as one fragment per run: one box per line box it occupies.
      let mut b = info.border
      while i < fragments.length() && fragments.get(i).parent == info.parent
        && values[fragments.get(i).index].source == css {
        b = merged(b, fragments.get(i).border)
        i = i + 1
      }
      run out.append(BoxModel { margin: b, border: b, padding: b, content: b })
      continue
    }
    let m = f.usedMargin
    let b = info.border
    run out.append(
      BoxModel {
        margin: Rect<f32>.new(b.xMin - m.left, b.yMin - m.top, b.xMax + m.right, b.yMax + m.bottom),
        border: b,
        padding: info.padding,
        content: info.content,
      },
    )
  }
}

fn merged(a: Rect<f32>, b: Rect<f32>) -> Rect<f32> {
  return Rect<f32>.new(
    f32.min(a.xMin, b.xMin),
    f32.min(a.yMin, b.yMin),
    f32.max(a.xMax, b.xMax),
    f32.max(a.yMax, b.yMax),
  )
}

/// The overlay's colors and widths. [`HighlightColors.devtools`] are the devtools': a pointed-at
/// node is washed in cyan with a hairline around its border box, a selected one gets an amber
/// ring a little outside it.
pub struct HighlightColors {
  /// Over the border box of a highlighted node.
  pub fill: Rgba<f32>,
  /// Just outside it, `outlineWidth` wide.
  pub outline: Rgba<f32>,
  pub outlineWidth: f32,
  /// The ring of a selected node: `ringWidth` wide, `ringOffset` outside its border box.
  pub ring: Rgba<f32>,
  pub ringWidth: f32,
  pub ringOffset: f32,
}

impl Copy for HighlightColors {}

/// `0xRRGGBB` with alpha `a` (0 to 255).
fn hex(value: u32, a: f32) -> Rgba<f32> {
  let r = u32.toF32(u32.bitAnd(u32.shiftRight(value, 16), 255)) / 255.0
  let g = u32.toF32(u32.bitAnd(u32.shiftRight(value, 8), 255)) / 255.0
  let b = u32.toF32(u32.bitAnd(value, 255)) / 255.0
  return Rgba<f32> { r: r, g: g, b: b, a: a / 255.0 }
}

impl HighlightColors {
  pub fn devtools() -> HighlightColors {
    return HighlightColors {
      fill: hex(0x5AC8FA, 71.0),
      outline: hex(0x5AC8FA, 255.0),
      outlineWidth: 1.0,
      ring: hex(0xFFB020, 255.0),
      ringWidth: 2.0,
      ringOffset: 2.0,
    }
  }
}

/// What to highlight.
pub struct Highlight {
  /// Client ids of the nodes pointed at (washed and outlined); unknown ids and nodes without a
  /// box are skipped.
  pub nodes: List<u32>,
  /// Client ids of the selected nodes (ringed).
  pub selected: List<u32>,
  pub colors: HighlightColors,
}

impl Highlight {
  pub fn make() -> Highlight {
    return Highlight {
      nodes: List<u32>.make(),
      selected: List<u32>.make(),
      colors: HighlightColors.devtools(),
    }
  }

  /// Whether it draws anything.
  pub fn any(self: &Self) -> bool {
    return self.nodes.length() != 0 || self.selected.length() != 0
  }

  /// A highlight of node `id` alone.
  pub effect fn of(id: u32) -> Highlight
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut h = Highlight.make()
    run h.nodes.append(id)
    return move h
  }
}

fn scaled(r: Rect<f32>, s: f32) -> Rect<f32> {
  return Rect<f32>.new(r.xMin * s, r.yMin * s, r.xMax * s, r.yMax * s)
}

fn transparent() -> Rgba<f32> {
  return Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }
}

/// The ring between `outer` and `inner` (device pixels) as one bordered quad, its outer
/// corners rounded by `radii`.
effect fn ring(
  scene: &mut Scene,
  outer: Rect<f32>,
  inner: Rect<f32>,
  mask: ContentMask,
  color: Rgba<f32>,
  radii: Corners<f32>,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let top = f32.max(0.0, inner.yMin - outer.yMin)
  let right = f32.max(0.0, outer.xMax - inner.xMax)
  let bottom = f32.max(0.0, outer.yMax - inner.yMax)
  let left = f32.max(0.0, inner.xMin - outer.xMin)
  if top == 0.0 && right == 0.0 && bottom == 0.0 && left == 0.0 {
    return ()
  }
  drop run scene.quad(
    Quad {
      bounds: outer,
      mask: mask,
      background: Background.solid(transparent()),
      cornerRadii: radii,
      borderWidths: Insets<f32>.new(top, right, bottom, left),
      borderColor: color,
      borderStyle: BorderStyle.Solid,
    },
  )
}

/// `r` grown by `by` on every side.
fn grown(r: Rect<f32>, by: f32) -> Rect<f32> {
  return Rect<f32>.new(r.xMin - by, r.yMin - by, r.xMax + by, r.yMax + by)
}

/// Node `id`'s corner radii in device pixels at scale `s`, grown by `by` where they round (an
/// outline follows the corner it goes round, as CSS draws one).
fn radiiOf(tree: &UiTree<'_>, id: u32, s: f32, by: f32) -> Corners<f32> {
  let slot = tree.slotOf(id)
  if slot == NONE {
    return Corners<f32>.uniform(0.0)
  }
  let r = tree.node(slot).computed.paint.radii
  return Corners<f32>.new(
    roundedBy(r.topLeft, s, by),
    roundedBy(r.topRight, s, by),
    roundedBy(r.bottomRight, s, by),
    roundedBy(r.bottomLeft, s, by),
  )
}

fn roundedBy(radius: f32, s: f32, by: f32) -> f32 {
  if radius <= 0.0 {
    return 0.0
  }
  return radius * s + by
}

/// Adds the highlight to `scene` (not finished) as one isolated layer over the whole viewport,
/// in the device pixels of the tree's last frame: the selected nodes' rings, then the nodes
/// pointed at, washed and outlined, on top.
pub effect fn paintHighlight(tree: &UiTree<'_>, highlight: &Highlight, scene: &mut Scene) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let s = tree.input.scale
  let viewport = Rect<f32>.new(0.0, 0.0, tree.input.width * s, tree.input.height * s)
  let mask = ContentMask.new(viewport)
  drop run scene.pushIsolatedLayer(viewport, mask, Isolation { opacity: 1.0, blend: 0 })
  let colors = highlight.colors
  let mut models = List<BoxModel>.make()
  let chosen = highlight.selected.asSlice()
  let mut k: usize = 0
  while k < chosen.length {
    run boxModels(tree, chosen[k], &mut models)
    let list = models.asSlice()
    let mut j: usize = 0
    while j < list.length {
      let border = scaled(list[j].border, s)
      let inner = grown(border, colors.ringOffset * s)
      let reach = (colors.ringOffset + colors.ringWidth) * s
      run ring(
        &mut scene,
        grown(inner, colors.ringWidth * s),
        inner,
        mask,
        colors.ring,
        radiiOf(tree, chosen[k], s, reach),
      )
      j = j + 1
    }
    k = k + 1
  }
  let ids = highlight.nodes.asSlice()
  let mut i: usize = 0
  while i < ids.length {
    run boxModels(tree, ids[i], &mut models)
    let list = models.asSlice()
    let mut j: usize = 0
    while j < list.length {
      let border = scaled(list[j].border, s)
      if border.xMax > border.xMin && border.yMax > border.yMin {
        let mut wash = Quad.fill(border, mask, Background.solid(colors.fill))
        wash.cornerRadii = radiiOf(tree, ids[i], s, 0.0)
        drop run scene.quad(wash)
      }
      run ring(
        &mut scene,
        grown(border, colors.outlineWidth * s),
        border,
        mask,
        colors.outline,
        radiiOf(tree, ids[i], s, colors.outlineWidth * s),
      )
      j = j + 1
    }
    i = i + 1
  }
  run scene.popLayer()
}

/// The tree's last frame with the highlight on top, as a finished scene in `out` (cleared
/// first). Draw `out` instead of `tree.scene()` while the overlay is on; the atlas tiles are
/// the tree's, so the uploads stay the same.
pub effect fn compose(tree: &UiTree<'_>, highlight: &Highlight, out: &mut Scene) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  out.clear()
  let frame = tree.scene()
  run out.replay(frame, 0, frame.operationCount())
  run paintHighlight(tree, highlight, &mut out)
  run out.finish()
}
