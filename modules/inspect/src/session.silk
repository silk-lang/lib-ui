//! Recording and replaying sessions. Everything that changes a tree is plain data (mutation
//! batches, input records and frame sizes), so a session is a list of those steps, and
//! replaying it into a fresh tree over the same fonts rebuilds the same tree: the same
//! `describe` output, the same pixels and the same event records.
import ui_tree.engine { UiTree, TreeError }
import ui_protocol.record { Event }
import ui_tree.node { FrameInput }
import ui_protocol.mutation { Mutation, Attribute, Declaration, CanvasCommand, Keyframe }
import properties.values
import ui_protocol.input { Input }
import ui_protocol.grid { Grid }
import ui_protocol.options { VirtualItem }
import ui_tree.rich
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.box { Box }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

// Copies. Mutations and inputs are moved into the tree, so the recorder keeps copies.

effect fn copyString(value: &String) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  return run String.copy(String.view(value))
}

effect fn copyDeclarations(items: &List<Declaration>) -> List<Declaration>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = run List<Declaration>.makeWithCapacity(items.length())
  let source = items.asSlice()
  let mut i: usize = 0
  while i < source.length {
    let copy = run values.cloneDeclaration(&source[i])
    run out.append(move copy)
    i = i + 1
  }
  return move out
}

/// A copy of `value`.
pub effect fn copyAttribute(value: &Attribute) -> Attribute
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &value.* {
    Attribute.Role { value: r } => Attribute.Role { value: r }
    Attribute.ValueRange { min, max, value: current } => Attribute.ValueRange {
      min: min,
      max: max,
      value: current,
    }
    Attribute.ClearValueRange => Attribute.ClearValueRange
    Attribute.Label { value: text } => Attribute.Label { value: run copyString(&text) }
    Attribute.TestId { value: text } => Attribute.TestId { value: run copyString(&text) }
    Attribute.TabIndex { value: index } => Attribute.TabIndex { value: index }
    Attribute.Cursor { value: c } => Attribute.Cursor { value: c }
    Attribute.Disabled { value: flag } => Attribute.Disabled { value: flag }
    Attribute.FocusTrap { value: flag } => Attribute.FocusTrap { value: flag }
    Attribute.Prevent { actions } => Attribute.Prevent { actions: actions }
    Attribute.Multiline { value: flag } => Attribute.Multiline { value: flag }
    Attribute.ReadOnly { value: flag } => Attribute.ReadOnly { value: flag }
    Attribute.Placeholder { value: text } => Attribute.Placeholder { value: run copyString(&text) }
    Attribute.Checked { value: flag } => Attribute.Checked { value: flag }
    Attribute.Selected { value: flag } => Attribute.Selected { value: flag }
    Attribute.Expanded { value: flag } => Attribute.Expanded { value: flag }
    Attribute.Href { value: text } => Attribute.Href { value: run copyString(&text) }
    Attribute.Transition { value: text } => Attribute.Transition { value: run copyString(&text) }
    Attribute.Element { name: text } => Attribute.Element { name: run copyString(&text) }
    Attribute.ClassName { value: text } => Attribute.ClassName { value: run copyString(&text) }
    Attribute.ElementId { value: text } => Attribute.ElementId { value: run copyString(&text) }
    Attribute.Hidden { value: v } => Attribute.Hidden { value: v }
    Attribute.Live { value: v } => Attribute.Live { value: v }
    Attribute.Atomic { value: v } => Attribute.Atomic { value: v }
    Attribute.Busy { value: v } => Attribute.Busy { value: v }
    Attribute.Pressed { value: v } => Attribute.Pressed { value: v }
    Attribute.Indeterminate { value: v } => Attribute.Indeterminate { value: v }
    Attribute.Required { value: v } => Attribute.Required { value: v }
    Attribute.Invalid { value: v } => Attribute.Invalid { value: v }
    Attribute.MultiSelectable { value: v } => Attribute.MultiSelectable { value: v }
    Attribute.Orientation { value: v } => Attribute.Orientation { value: v }
    Attribute.Level { value: v } => Attribute.Level { value: v }
    Attribute.PosInSet { value: v } => Attribute.PosInSet { value: v }
    Attribute.SetSize { value: v } => Attribute.SetSize { value: v }
    Attribute.Modal { value: v } => Attribute.Modal { value: v }
    Attribute.Description { value: text } => Attribute.Description { value: run copyString(&text) }
    Attribute.RoleDescription { value: text } => Attribute.RoleDescription { value: run copyString(&text) }
    Attribute.ValueText { value: text } => Attribute.ValueText { value: run copyString(&text) }
  }
}

/// A copy of `value`.
pub effect fn copyMutation(value: &Mutation) -> Mutation
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &value.* {
    Mutation.SetAnchor { id, target, options } => Mutation.SetAnchor {
      id: id,
      target: target,
      options: options,
    }
    Mutation.ClearAnchor { id } => Mutation.ClearAnchor { id: id }
    Mutation.SetVirtualList { id, count, options } => Mutation.SetVirtualList {
      id: id,
      count: count,
      options: options,
    }
    Mutation.SetVirtualItems { id, items } => {
      let mut copied = List<VirtualItem>.make()
      run copied.appendSlice(items.asSlice())
      Mutation.SetVirtualItems { id: id, items: move copied }
    }
    Mutation.ClearVirtualList { id } => Mutation.ClearVirtualList { id: id }
    Mutation.Create { id, kind } => Mutation.Create { id: id, kind: kind }
    Mutation.InsertBefore { parent, child, before } => Mutation.InsertBefore {
      parent: parent,
      child: child,
      before: before,
    }
    Mutation.Remove { id } => Mutation.Remove { id: id }
    Mutation.Destroy { id } => Mutation.Destroy { id: id }
    Mutation.SetStyle { id, state, declarations } => Mutation.SetStyle {
      id: id,
      state: state,
      declarations: run copyDeclarations(&declarations),
    }
    Mutation.ClearStyle { id, state } => Mutation.ClearStyle { id: id, state: state }
    Mutation.SetText { id, value: text } => Mutation.SetText {
      id: id,
      value: run copyString(&text),
    }
    Mutation.SetRichText { id, value: text, marks, atoms } => Mutation.SetRichText {
      id: id,
      value: run copyString(&text),
      marks: run rich.copySpans(&marks),
      atoms: run rich.copyAtoms(&atoms),
    }
    Mutation.DefineMark { id, mark, declarations } => Mutation.DefineMark {
      id: id,
      mark: mark,
      declarations: run copyDeclarations(&declarations),
    }
    Mutation.DefineAtom { id, kind, declarations } => Mutation.DefineAtom {
      id: id,
      kind: kind,
      declarations: run copyDeclarations(&declarations),
    }
    Mutation.Format { id, mark, on } => Mutation.Format { id: id, mark: mark, on: on }
    Mutation.InsertAtom { id, start, end, atom } => Mutation.InsertAtom {
      id: id,
      start: start,
      end: end,
      atom: run atom.copy(),
    }
    Mutation.SetAttribute { id, attribute } => Mutation.SetAttribute {
      id: id,
      attribute: run copyAttribute(&attribute),
    }
    Mutation.SetListeners { id, flags } => Mutation.SetListeners { id: id, flags: flags }
    Mutation.OpenRoot { root, node, options } => Mutation.OpenRoot {
      root: root,
      node: node,
      options: run options.copy(),
    }
    Mutation.UpdateRoot { root, options } => Mutation.UpdateRoot {
      root: root,
      options: run options.copy(),
    }
    Mutation.CloseRoot { root } => Mutation.CloseRoot { root: root }
    Mutation.Focus { id } => Mutation.Focus { id: id }
    Mutation.Blur => Mutation.Blur
    Mutation.SetPointerCapture { id } => Mutation.SetPointerCapture { id: id }
    Mutation.ReleasePointerCapture => Mutation.ReleasePointerCapture
    Mutation.ScrollTo { id, x, y } => Mutation.ScrollTo { id: id, x: x, y: y }
    Mutation.ScrollIntoView { id } => Mutation.ScrollIntoView { id: id }
    Mutation.SetSelection { id, anchor, focus } => Mutation.SetSelection {
      id: id,
      anchor: anchor,
      focus: focus,
    }
    Mutation.SetGrid { id, value: grid } => Mutation.SetGrid {
      id: id,
      value: run Box<Grid>.make(run grid.get()[0].copy()),
    }
    Mutation.SetSource { id, resource } => Mutation.SetSource { id: id, resource: resource }
    Mutation.SetCanvas { id, commands } => {
      let mut copied = List<CanvasCommand>.make()
      run copied.appendSlice(commands.asSlice())
      Mutation.SetCanvas { id: id, commands: move copied }
    }
    Mutation.DefineFontFamily { family, names } => Mutation.DefineFontFamily {
      family: family,
      names: run copyString(&names),
    }
    Mutation.DefineKeyframes { name, frames } => {
      let mut copied = List<Keyframe>.make()
      let items = frames.asSlice()
      let mut i: usize = 0
      while i < items.length {
        run copied.append(Keyframe {
          offset: items[i].offset,
          declarations: run copyDeclarations(&items[i].declarations),
        })
        i = i + 1
      }
      Mutation.DefineKeyframes { name: run copyString(&name), frames: move copied }
    }
    Mutation.DefineImage { resource, data } => Mutation.DefineImage {
      resource: resource,
      data: run Bytes.copy(data.asSlice()),
    }
    Mutation.DefineDecodedImage { resource, image } => Mutation.DefineDecodedImage {
      resource: resource,
      image: run image.copy(),
    }
    Mutation.ReleaseResource { resource } => Mutation.ReleaseResource { resource: resource }
    Mutation.DefineIcon { resource, data } => Mutation.DefineIcon {
      resource: resource,
      data: run Bytes.copy(data.asSlice()),
    }
    Mutation.LoadImage { resource, url } => Mutation.LoadImage {
      resource: resource,
      url: run copyString(&url),
    }
    Mutation.LoadIcon { resource, url } => Mutation.LoadIcon {
      resource: resource,
      url: run copyString(&url),
    }
    Mutation.DeclareFontFace {
      face,
      family,
      url,
      weightMin,
      weightMax,
      widthMin,
      widthMax,
      style,
      ranges,
    } => {
      let mut copied = List<u32>.make()
      run copied.appendSlice(ranges.asSlice())
      Mutation.DeclareFontFace {
        face: face,
        family: run copyString(&family),
        url: run copyString(&url),
        weightMin: weightMin,
        weightMax: weightMax,
        widthMin: widthMin,
        widthMax: widthMax,
        style: style,
        ranges: move copied,
      }
    }
    Mutation.LoadFontFace { face, url } => Mutation.LoadFontFace {
      face: face,
      url: run copyString(&url),
    }
    Mutation.LoadFontStylesheet { url } => Mutation.LoadFontStylesheet {
      url: run copyString(&url),
    }
  }
}

/// A copy of `batch`.
pub effect fn copyBatch(batch: &List<Mutation>) -> List<Mutation>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = List<Mutation>.make()
  let values = batch.asSlice()
  let mut i: usize = 0
  while i < values.length {
    run out.append(run copyMutation(&values[i]))
    i = i + 1
  }
  return move out
}

/// A copy of `value`.
pub effect fn copyInput(value: &Input) -> Input
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &value.* {
    Input.PointerMove { x, y, modifiers } => Input.PointerMove { x: x, y: y, modifiers: modifiers }
    Input.PointerDown { x, y, button, modifiers, clickCount } => Input.PointerDown {
      x: x,
      y: y,
      button: button,
      modifiers: modifiers,
      clickCount: clickCount,
    }
    Input.PointerUp { x, y, button, modifiers } => Input.PointerUp {
      x: x,
      y: y,
      button: button,
      modifiers: modifiers,
    }
    Input.PointerLeave => Input.PointerLeave
    Input.PointerCancel => Input.PointerCancel
    Input.Wheel { x, y, deltaX, deltaY, modifiers } => Input.Wheel {
      x: x,
      y: y,
      deltaX: deltaX,
      deltaY: deltaY,
      modifiers: modifiers,
    }
    Input.KeyDown { key, code, modifiers, repeat } => Input.KeyDown {
      key: run copyString(&key),
      code: run copyString(&code),
      modifiers: modifiers,
      repeat: repeat,
    }
    Input.KeyUp { key, code, modifiers } => Input.KeyUp {
      key: run copyString(&key),
      code: run copyString(&code),
      modifiers: modifiers,
    }
    Input.TextInput { text } => Input.TextInput { text: run copyString(&text) }
    Input.ImePreedit { text, selectionStart, selectionEnd } => Input.ImePreedit {
      text: run copyString(&text),
      selectionStart: selectionStart,
      selectionEnd: selectionEnd,
    }
    Input.Paste { target, text } => Input.Paste { target: target, text: run copyString(&text) }
  }
}

/// A copy of `value`.
pub effect fn copyEvent(value: &Event) -> Event
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut path = List<u32>.make()
  run path.appendSlice(value.path.asSlice())
  let mut out = Event.make(value.kind, value.target, move path)
  out.x = value.x
  out.y = value.y
  out.modifiers = value.modifiers
  out.button = value.button
  out.detail = value.detail
  out.deltaX = value.deltaX
  out.deltaY = value.deltaY
  out.key = run copyString(&value.key)
  out.code = run copyString(&value.code)
  out.repeat = value.repeat
  out.value = run copyString(&value.value)
  return move out
}

fn sameText(a: &String, b: &String) -> bool {
  let x = a.ownedUtf8Bytes()
  let y = b.ownedUtf8Bytes()
  if x.length != y.length {
    return false
  }
  let mut i: usize = 0
  while i < x.length {
    if x[i] != y[i] {
      return false
    }
    i = i + 1
  }
  return true
}

/// Whether two event records are the same in every field.
pub fn sameEvent(a: &Event, b: &Event) -> bool {
  if a.kind != b.kind || a.target != b.target || a.x != b.x || a.y != b.y
    || a.modifiers != b.modifiers
    || a.button != b.button
    || a.detail != b.detail
    || a.deltaX != b.deltaX
    || a.deltaY != b.deltaY
    || a.repeat != b.repeat {
    return false
  }
  let p = a.path.asSlice()
  let q = b.path.asSlice()
  if p.length != q.length {
    return false
  }
  let mut i: usize = 0
  while i < p.length {
    if p[i] != q[i] {
      return false
    }
    i = i + 1
  }
  return sameText(&a.key, &b.key) && sameText(&a.code, &b.code) && sameText(&a.value, &b.value)
}

// Sessions.

/// One recorded step.
pub union Step {
  /// A mutation batch applied with `UiTree.apply`.
  Apply { pub batch: List<Mutation> },
  /// An input record fed to `UiTree.dispatch`.
  Dispatch { pub input: Input },
  /// A frame drawn with `UiTree.frame`.
  Frame { pub input: FrameInput },
  /// The records the client took with `UiTree.takeEvents` at this point. Replay takes them
  /// again and compares.
  Events { pub events: List<Event> },
}

/// A recorder that drives a tree and keeps every step. Use its `apply`, `dispatch`, `frame`
/// and `takeEvents` in place of the tree's.
pub struct Session {
  pub steps: List<Step>,
}

/// What a replay found.
pub struct ReplayReport {
  /// Steps run.
  pub steps: usize,
  /// `Events` steps whose records came out different, and the index of the first such step
  /// (or the step count when all matched).
  pub eventMismatches: usize,
  pub firstMismatch: usize,
}

impl Copy for ReplayReport {}

impl Session {
  pub fn make() -> Session {
    return Session { steps: List<Step>.make() }
  }

  pub fn length(self: &Self) -> usize {
    return self.steps.length()
  }

  /// Records `batch` and applies it to `tree`.
  pub effect fn apply(self: &mut Self, tree: &mut UiTree<'_>, batch: List<Mutation>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.steps.append(Step.Apply { batch: run copyBatch(&batch) })
    run tree.apply(move batch)
  }

  /// Records `input` and dispatches it to `tree`.
  pub effect fn dispatch(self: &mut Self, tree: &mut UiTree<'_>, input: Input) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.steps.append(Step.Dispatch { input: run copyInput(&input) })
    run tree.dispatch(move input)
  }

  /// Records and dispatches each of `inputs`, in order.
  pub effect fn dispatchAll(self: &mut Self, tree: &mut UiTree<'_>, inputs: List<Input>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut list = move inputs
    let mut reversed = List<Input>.make()
    while true {
      match list.pop() {
        Option<Input>.Some { value } => {
          run reversed.append(move value)
        }
        Option<Input>.None => {
          break
        }
      }
    }
    while true {
      match reversed.pop() {
        Option<Input>.Some { value } => {
          run self.dispatch(&mut tree, move value)
        }
        Option<Input>.None => {
          break
        }
      }
    }
  }

  /// Records a frame and draws it.
  pub effect fn frame(self: &mut Self, tree: &mut UiTree<'_>, input: FrameInput) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.steps.append(Step.Frame { input: input })
    run tree.frame(input)
  }

  /// Takes the tree's queued records into `out` and records a copy of them.
  pub effect fn takeEvents(self: &mut Self, tree: &mut UiTree<'_>, out: &mut List<Event>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let start = out.length()
    run tree.takeEvents(&mut out)
    let mut copies = List<Event>.make()
    let values = out.asSlice()
    let mut i = start
    while i < values.length {
      run copies.append(run copyEvent(&values[i]))
      i = i + 1
    }
    run self.steps.append(Step.Events { events: move copies })
  }

  /// Runs the first `count` steps (all of them when `count` is larger) against `tree`, which
  /// should be a fresh tree over the same fonts. Records the tree queued before an `Events`
  /// step are taken and compared with the recorded ones; records left after the last step stay
  /// queued.
  pub effect fn replayInto(self: &Self, tree: &mut UiTree<'_>, count: usize) -> ReplayReport
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let steps = self.steps.asSlice()
    let last = if count < steps.length {
      count
    } else {
      steps.length
    }
    let mut report = ReplayReport { steps: 0, eventMismatches: 0, firstMismatch: last }
    let mut taken = List<Event>.make()
    let mut i: usize = 0
    while i < last {
      match &steps[i] {
        Step.Apply { batch } => {
          run tree.apply(run copyBatch(&batch))
        }
        Step.Dispatch { input } => {
          run tree.dispatch(run copyInput(&input))
        }
        Step.Frame { input } => {
          run tree.frame(input)
        }
        Step.Events { events } => {
          taken.clear()
          run tree.takeEvents(&mut taken)
          let expected = events.asSlice()
          let actual = taken.asSlice()
          let mut same = expected.length == actual.length
          let mut k: usize = 0
          while same && k < expected.length {
            same = sameEvent(&expected[k], &actual[k])
            k = k + 1
          }
          if !same {
            if report.eventMismatches == 0 {
              report.firstMismatch = i
            }
            report.eventMismatches = report.eventMismatches + 1
          }
        }
      }
      report.steps = report.steps + 1
      i = i + 1
    }
    return report
  }

  /// [`Session.replayInto`] of every step.
  pub effect fn replay(self: &Self, tree: &mut UiTree<'_>) -> ReplayReport
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    return run self.replayInto(&mut tree, self.steps.length())
  }

  /// How many steps of each kind the session holds: applies, dispatches, frames, event takes.
  pub fn counts(self: &Self) -> [usize; 4] {
    let mut out: [usize; 4] = [0, 0, 0, 0]
    let steps = self.steps.asSlice()
    let mut i: usize = 0
    while i < steps.length {
      let k: usize = match &steps[i] {
        Step.Apply { .. } => 0
        Step.Dispatch { .. } => 1
        Step.Frame { .. } => 2
        Step.Events { .. } => 3
      }
      out[k] = out[k] + 1
      i = i + 1
    }
    return out
  }
}
