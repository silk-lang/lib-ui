//! The live view of one node, like devtools' Elements side panel: what the node is, its
//! attributes, listeners and states, its box model, the style patches the client set per
//! state, and the computed style. Deterministic text, for people and agents alike.
import ui_protocol.css
import ui_protocol.css { px, number, normal, auto, keyword, Keyword, Declaration, Value, Property }
import properties.convert
import ui_protocol.mutation {
  BaselineSource,
  BoxDecorationBreak,
  BreakBetween,
  BreakInside,
  Clear,
  Float,
  LayoutTextAlign,
  MarginBreak,
  OverflowAlignment,
  ScrollbarGutter,
  ScrollbarWidth,
  TabSize,
  TextJustify,
  TextOrientation,
  TextWrap,
  UnicodeBidi,
  VerticalAlign,
  Visibility,
  WhiteSpaceCollapse,
  WritingMode,
  VerticalAlignKind,
  Dimension,
  DimensionKind,
}
import properties.computed { LineHeight as LayoutLineHeight }
import silk.num.usize
import ui_tree.engine { UiTree }
import ui_tree.node { NONE }
import properties.values
import ui_protocol.mutation {
  FlexDirection,
  FlexWrap,
  Align,
  Position,
  Overflow,
  BoxSizing,
  BorderStyle,
  FontStyle,
  TextAlign,
  WhiteSpace,
  Direction,
  Cursor,
  NOT_FOCUSABLE,
  LISTEN_POINTER_DOWN,
  LISTEN_POINTER_UP,
  LISTEN_CLICK,
  LISTEN_POINTER_MOVE,
  LISTEN_POINTER_ENTER,
  LISTEN_POINTER_LEAVE,
  LISTEN_WHEEL,
  LISTEN_KEY_DOWN,
  LISTEN_KEY_UP,
  LISTEN_FOCUS,
  LISTEN_BLUR,
  LISTEN_INPUT,
  LISTEN_SCROLL
}
import ui_protocol.mutation { Role, NodeKind }
import ui_tree.style { Computed, Fill }
import layout.lib { DisplayInside }
import ui_tree.inspect { kindName, roleName, writeInt, writeNumber }
import overlay { BoxModel, boxModels }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.result { Result }
import silk.color.rgba { Rgba }
import silk.geometry.corners { Corners }
import silk.geometry.rect { Rect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.i32
import silk.num.i64
import silk.num.u32
import silk.text.string { String, InvalidUtf8 }

// Values.

effect fn color(out: &mut String, c: Rgba<f32>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run out.append("rgba(")
  run writeInt(&mut out, f32.toU64(f32.floor(f32.max(0.0, f32.min(1.0, c.r)) * 255.0 + 0.5)))
  run out.append(",")
  run writeInt(&mut out, f32.toU64(f32.floor(f32.max(0.0, f32.min(1.0, c.g)) * 255.0 + 0.5)))
  run out.append(",")
  run writeInt(&mut out, f32.toU64(f32.floor(f32.max(0.0, f32.min(1.0, c.b)) * 255.0 + 0.5)))
  run out.append(",")
  run writeNumber(&mut out, c.a)
  run out.append(")")
}

effect fn writePx(out: &mut String, value: f32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run writeNumber(&mut out, value)
  run out.append("px")
}


effect fn rect(out: &mut String, r: Rect<f32>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run out.append("[")
  run writeNumber(&mut out, r.xMin)
  run out.append(",")
  run writeNumber(&mut out, r.yMin)
  run out.append(" ")
  run writeNumber(&mut out, r.xMax - r.xMin)
  run out.append("x")
  run writeNumber(&mut out, r.yMax - r.yMin)
  run out.append("]")
}

effect fn signed(out: &mut String, value: i32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if value < 0 {
    run out.append("-")
    run writeInt(&mut out, i64.toU64(-i32.toI64(value)))
  } else {
    run writeInt(&mut out, i64.toU64(i32.toI64(value)))
  }
}



fn directionName(value: FlexDirection) -> string<'static> {
  return match value {
    FlexDirection.Row => "row"
    FlexDirection.RowReverse => "row-reverse"
    FlexDirection.Column => "column"
    FlexDirection.ColumnReverse => "column-reverse"
  }
}

fn wrapName(value: FlexWrap) -> string<'static> {
  return match value {
    FlexWrap.NoWrap => "nowrap"
    FlexWrap.Wrap => "wrap"
    FlexWrap.WrapReverse => "wrap-reverse"
  }
}

fn alignName(value: Align) -> string<'static> {
  return match value {
    Align.Auto => "auto"
    Align.Normal => "normal"
    Align.Start => "start"
    Align.End => "end"
    Align.Center => "center"
    Align.Stretch => "stretch"
    Align.Baseline => "baseline"
    Align.SpaceBetween => "space-between"
    Align.SpaceAround => "space-around"
    Align.SpaceEvenly => "space-evenly"
    Align.FlexStart => "flex-start"
    Align.FlexEnd => "flex-end"
    Align.LastBaseline => "last-baseline"
    Align.SelfStart => "self-start"
    Align.SelfEnd => "self-end"
    Align.Left => "left"
    Align.Right => "right"
  }
}

fn positionName(value: Position) -> string<'static> {
  return match value {
    Position.Static => "static"
    Position.Relative => "relative"
    Position.Absolute => "absolute"
    Position.Fixed => "fixed"
    Position.Sticky => "sticky"
  }
}

fn overflowName(value: Overflow) -> string<'static> {
  return match value {
    Overflow.Visible => "visible"
    Overflow.Hidden => "hidden"
    Overflow.Clip => "clip"
    Overflow.Scroll => "scroll"
    Overflow.Auto => "auto"
  }
}

fn boxSizingName(value: BoxSizing) -> string<'static> {
  return match value {
    BoxSizing.ContentBox => "content-box"
    BoxSizing.BorderBox => "border-box"
  }
}

fn borderStyleName(value: BorderStyle) -> string<'static> {
  return match value {
    BorderStyle.None => "none"
    BorderStyle.Solid => "solid"
    BorderStyle.Dashed => "dashed"
  }
}

fn fontStyleName(value: FontStyle) -> string<'static> {
  return match value {
    FontStyle.Normal => "normal"
    FontStyle.Italic => "italic"
  }
}

fn textAlignName(value: TextAlign) -> string<'static> {
  return match value {
    TextAlign.Auto => "auto"
    TextAlign.Start => "start"
    TextAlign.End => "end"
    TextAlign.Left => "left"
    TextAlign.Right => "right"
    TextAlign.Center => "center"
    TextAlign.Justify => "justify"
  }
}

fn whiteSpaceName(value: WhiteSpace) -> string<'static> {
  return match value {
    WhiteSpace.Normal => "normal"
    WhiteSpace.NoWrap => "nowrap"
    WhiteSpace.Pre => "pre"
    WhiteSpace.PreWrap => "pre-wrap"
    WhiteSpace.PreLine => "pre-line"
  }
}

fn textDirectionName(value: Direction) -> string<'static> {
  return match value {
    Direction.Ltr => "ltr"
    Direction.Rtl => "rtl"
  }
}

pub fn cursorName(value: Cursor) -> string<'static> {
  return match value {
    Cursor.Default => "default"
    Cursor.Pointer => "pointer"
    Cursor.Text => "text"
    Cursor.Move => "move"
    Cursor.Grab => "grab"
    Cursor.Grabbing => "grabbing"
    Cursor.NotAllowed => "not-allowed"
    Cursor.ResizeHorizontal => "ew-resize"
    Cursor.ResizeVertical => "ns-resize"
    Cursor.ResizeNorthWestSouthEast => "nwse-resize"
    Cursor.ResizeNorthEastSouthWest => "nesw-resize"
    Cursor.Crosshair => "crosshair"
  }
}

effect fn corners(out: &mut String, r: Corners<f32>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run writePx(&mut out, r.topLeft)
  if r.topRight != r.topLeft || r.bottomRight != r.topLeft || r.bottomLeft != r.topLeft {
    run out.append(" ")
    run writePx(&mut out, r.topRight)
    run out.append(" ")
    run writePx(&mut out, r.bottomRight)
    run out.append(" ")
    run writePx(&mut out, r.bottomLeft)
  }
}

effect fn named(out: &mut String, name: string, value: string) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run out.append(name)
  run out.append(": ")
  run out.append(value)
}



/// The computed style of a node as properties. For a text node (`text`) only the inherited
/// text properties are listed: it has no box of its own to style.
pub effect fn computedProperties(c: &Computed, text: bool, out: &mut List<Declaration>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  out.clear()
  run out.append(css.unicodeBidi(c.layout.unicodeBidi))
  run out.append(css.writingMode(c.text.writingMode))
  run out.append(css.textOrientation(c.text.textOrientation))
  run out.append(css.verticalAlign(run verticalAlignValue(c.layout.verticalAlign)))
  run out.append(css.baselineSource(c.layout.baselineSource))
  run out.append(css.textAlignLast(c.text.textAlignLast))
  run out.append(css.textWrapMode(c.text.textWrap))
  run out.append(css.whiteSpaceCollapse(c.text.whiteSpaceCollapse))
  run out.append(css.textJustify(c.text.textJustify))
  run out.append(run css.textIndentWith(run convert.fromDimension(c.text.textIndent.value), c.text.textIndent.hanging, c.text.textIndent.eachLine))
  run out.append(
    css.tabSize(
      match c.text.tabSize {
        TabSize.Number { value } => number(value)
        TabSize.Length { value } => px(value)
      },
    ),
  )
  run out.append(css.boxDecorationBreak(c.layout.boxDecorationBreak))
  run out.append(css.marginBreak(c.layout.marginBreak))
  run out.append(css.breakBefore(c.layout.breakBefore))
  run out.append(css.breakAfter(c.layout.breakAfter))
  run out.append(css.breakInside(c.layout.breakInside))
  run out.append(css.orphans(c.text.orphans))
  run out.append(css.widows(c.text.widows))
  run out.append(css.order(c.layout.order))
  run out.append(run css.justifySelfWith(c.layout.justifySelf, c.layout.justifySelfSafety))
  run out.append(run css.justifyItemsWith(c.layout.justifyItems, c.layout.justifyItemsSafety))
  run out.append(css.scrollbarWidth(c.layout.scrollbarWidth))
  run out.append(run css.scrollbarGutter(c.layout.scrollbarGutter))
  run out.append(css.float(c.layout.float))
  run out.append(css.clear(c.layout.clear))
  run out.append(css.visibility(c.text.visibility))
  if !text {
    run boxProperties(c, &mut out)
    run out.append(css.objectFit(c.paint.objectFit))
    run out.append(run css.objectPosition(run convert.fromDimension(c.paint.objectX), run convert.fromDimension(c.paint.objectY)))
  }
  let t = c.text
  run out.append(css.fontFamily(t.family))
  run out.append(css.fontSize(px(t.size)))
  run out.append(css.fontWeight(t.weight))
  run out.append(css.fontStyle(t.style))
  run out.append(
    css.lineHeight(
      match t.lineHeight {
        LayoutLineHeight.Normal => normal()
        LayoutLineHeight.Number { value } => number(value)
        LayoutLineHeight.Length { value } => px(value)
      },
    ),
  )
  run out.append(css.color(t.color))
  run out.append(css.textAlign(t.align))
  run out.append(css.whiteSpace(t.whiteSpace))
  run out.append(css.direction(t.direction))
  run out.append(run css.textDecorationLines(t.decoration))
  if t.hasDecorationColor {
    run out.append(css.textDecorationColor(t.decorationColor))
  }
  run out.append(css.textDecorationWavy(t.wavy))
}

effect fn boxProperties(c: &Computed, out: &mut List<Declaration>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run out.append(css.display(convert.displayKeyword(c.layout.display)))
  run out.append(css.position(c.layout.position))
  run out.append(css.boxSizing(c.layout.boxSizing))
  run out.append(css.width(run convert.fromDimension(c.layout.width)))
  run out.append(css.height(run convert.fromDimension(c.layout.height)))
  run out.append(css.minWidth(run convert.fromDimension(c.layout.minWidth)))
  run out.append(css.minHeight(run convert.fromDimension(c.layout.minHeight)))
  run out.append(css.maxWidth(run convert.fromDimension(c.layout.maxWidth)))
  run out.append(css.maxHeight(run convert.fromDimension(c.layout.maxHeight)))
  run out.append(css.marginTop(run convert.fromDimension(c.layout.margin.top)))
  run out.append(css.marginRight(run convert.fromDimension(c.layout.margin.right)))
  run out.append(css.marginBottom(run convert.fromDimension(c.layout.margin.bottom)))
  run out.append(css.marginLeft(run convert.fromDimension(c.layout.margin.left)))
  run out.append(css.paddingTop(run convert.fromDimension(c.layout.padding.top)))
  run out.append(css.paddingRight(run convert.fromDimension(c.layout.padding.right)))
  run out.append(css.paddingBottom(run convert.fromDimension(c.layout.padding.bottom)))
  run out.append(css.paddingLeft(run convert.fromDimension(c.layout.padding.left)))
  run out.append(css.borderTopWidth(px(c.paint.border.top)))
  run out.append(css.borderRightWidth(px(c.paint.border.right)))
  run out.append(css.borderBottomWidth(px(c.paint.border.bottom)))
  run out.append(css.borderLeftWidth(px(c.paint.border.left)))
  if c.layout.position != Position.Static {
    run out.append(css.top(run convert.fromDimension(c.layout.inset.top)))
    run out.append(css.right(run convert.fromDimension(c.layout.inset.right)))
    run out.append(css.bottom(run convert.fromDimension(c.layout.inset.bottom)))
    run out.append(css.left(run convert.fromDimension(c.layout.inset.left)))
  }
  if c.layout.display.insideIs(DisplayInside.Flex) {
    run out.append(css.flexDirection(c.layout.flexDirection))
    run out.append(css.flexWrap(c.layout.flexWrap))
    run out.append(run css.justifyContentWith(c.layout.justifyContent, c.layout.justifyContentSafety))
    run out.append(run css.alignItemsWith(c.layout.alignItems, c.layout.alignItemsSafety))
    run out.append(run css.alignContentWith(c.layout.alignContent, c.layout.alignContentSafety))
    run out.append(css.rowGap(run convert.fromDimension(c.layout.rowGap)))
    run out.append(css.columnGap(run convert.fromDimension(c.layout.columnGap)))
  }
  run out.append(css.flexGrow(c.layout.flexGrow))
  run out.append(css.flexShrink(c.layout.flexShrink))
  run out.append(css.flexBasis(run convert.fromDimension(c.layout.flexBasis)))
  run out.append(run css.alignSelfWith(c.layout.alignSelf, c.layout.alignSelfSafety))
  run out.append(css.overflowX(c.layout.overflowX))
  run out.append(css.overflowY(c.layout.overflowY))
  if c.layout.aspectRatio <= 0.0 {
    run out.append(css.declare(Property.AspectRatio, auto()))
  } else if c.layout.aspectRatioAuto {
    run out.append(run css.aspectRatioAuto(c.layout.aspectRatio))
  } else {
    run out.append(css.aspectRatio(c.layout.aspectRatio))
  }
  match c.paint.background {
    Fill.None => {
      run out.append(
        css.backgroundColor(Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }),
      )
    }
    Fill.Solid { color: fill } => {
      run out.append(css.backgroundColor(fill))
    }
    Fill.Gradient { angle, from, to } => {
      run out.append(run css.backgroundGradient(angle, from, to))
    }
  }
  run out.append(css.borderColor(c.paint.borderColor))
  run out.append(css.borderStyle(c.paint.borderStyle))
  if c.paint.radii.topRight == c.paint.radii.topLeft && c.paint.radii.bottomRight == c.paint.radii.topLeft
    && c.paint.radii.bottomLeft == c.paint.radii.topLeft {
    run out.append(css.borderRadius(px(c.paint.radii.topLeft)))
  } else {
    run out.append(
      run css.borderRadii(c.paint.radii.topLeft, c.paint.radii.topRight, c.paint.radii.bottomRight, c.paint.radii.bottomLeft),
    )
  }
  if c.paint.hasShadow {
    run out.append(run css.boxShadow(c.paint.shadow))
  } else {
    run out.append(css.noBoxShadow())
  }
  run out.append(css.opacity(c.paint.opacity))
  run out.append(run css.backdropBlur(c.paint.backdropBlur))
  run out.append(css.pointerEvents(c.paint.pointerEvents))
}




/// A computed `vertical-align` as written.
effect fn verticalAlignValue(value: VerticalAlign) -> Value ! OutOfMemoryError ? &mut Allocator {
  let word = match value.kind {
    VerticalAlignKind.Shift => {
      let shift = run convert.fromDimension(value.shift)
      return move shift
    }
    VerticalAlignKind.Baseline => Keyword.Baseline
    VerticalAlignKind.Middle => Keyword.Middle
    VerticalAlignKind.TextTop => Keyword.TextTop
    VerticalAlignKind.TextBottom => Keyword.TextBottom
    VerticalAlignKind.Top => Keyword.Top
    VerticalAlignKind.Bottom => Keyword.Bottom
    VerticalAlignKind.Sub => Keyword.Sub
    VerticalAlignKind.Super => Keyword.Super
  }
  return keyword(word)
}

effect fn patch(out: &mut String, title: string, declarations: &List<Declaration>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if declarations.length() == 0 {
    return ()
  }
  run out.append("style ")
  run out.append(title)
  run out.append(" {\n")
  let items = declarations.asSlice()
  let mut i: usize = 0
  while i < items.length {
    run out.append("  ")
    run writeDeclaration(&mut out, &items[i])
    run out.append(";\n")
    i = i + 1
  }
  run out.append("}\n")
}

/// Writes `declaration` as CSS text without the semicolon, such as `padding-top: 6px`.
pub effect fn writeDeclaration(out: &mut String, declaration: &Declaration) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = Bytes.make()
  run values.writeDeclaration(&mut text, declaration)
  match String.fromUtf8(text.asSlice()) {
    Result<string, InvalidUtf8>.Success { value } => {
      run out.append(value)
    }
    Result<string, InvalidUtf8>.Failure { error: _ } => {}
  }
}

effect fn flag(out: &mut String, listeners: u32, bit: u32, name: string) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if u32.bitAnd(listeners, bit) != 0 {
    run out.append(" ")
    run out.append(name)
  }
}

effect fn quotedText(out: &mut String, value: string) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run out.append("\"")
  let bytes = String.utf8Bytes(value)
  let mut start: usize = 0
  let mut i: usize = 0
  while i < bytes.length {
    let b = bytes[i]
    if b == 34 || b == 92 || b == 10 {
      run out.append(String.slice(value, start, i - start))
      if b == 10 {
        run out.append("\\n")
      } else if b == 34 {
        run out.append("\\\"")
      } else {
        run out.append("\\\\")
      }
      start = i + 1
    }
    i = i + 1
  }
  run out.append(String.slice(value, start, bytes.length - start))
  run out.append("\"")
}

/// Ends a line, writing ` none` first when nothing followed its heading (which ends at byte
/// `headingEnd`).
effect fn noneAfter(out: &mut String, headingEnd: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if out.ownedByteLength() == headingEnd {
    run out.append(" none")
  }
  run out.append("\n")
}

/// What [`inspectNode`] writes besides the node, its attributes, states and box model.
pub struct InspectOptions {
  /// The style patches the client set, per state.
  pub patches: bool,
  /// The computed style.
  pub computed: bool,
}

impl InspectOptions {
  pub fn all() -> InspectOptions {
    return InspectOptions { patches: true, computed: true }
  }
}

/// Writes the live view of node `id` (from the last frame's styles and layout) to `out`:
///
/// ```text
/// box #10 role=button label="New" parent=#2 children=#11
/// attributes: tabIndex=0 cursor=pointer
/// listeners: pointerdown pointerup click ...
/// state: hovered pressed focused focus-visible
/// box model: margin [x,y wxh] border [..] padding [..] content [..]
/// style base { background-color: rgba(229,231,235,1); ... }
/// computed { display: block; ... }
/// ```
pub effect fn inspectNode(
  tree: &UiTree<'_>,
  id: u32,
  options: InspectOptions,
  out: &mut String,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let slot = tree.slotOf(id)
  if slot == NONE {
    run out.append("(no node #")
    run writeInt(&mut out, u32.toU64(id))
    run out.append(")\n")
    return ()
  }
  let node = tree.node(slot)
  run out.append(kindName(node.kind))
  run out.append(" #")
  run writeInt(&mut out, u32.toU64(node.id))
  if node.accessRole != Role.None {
    run out.append(" role=")
    run out.append(roleName(node.accessRole))
  }
  if node.hasValueRange {
    run out.append(" valueNow=")
    run writeNumber(&mut out, node.valueNow)
    run out.append(" valueMin=")
    run writeNumber(&mut out, node.valueMin)
    run out.append(" valueMax=")
    run writeNumber(&mut out, node.valueMax)
  }
  if node.label.ownedByteLength() != 0 {
    run out.append(" label=")
    run quotedText(&mut out, String.view(&node.label))
  }
  if node.testId.ownedByteLength() != 0 {
    run out.append(" testId=")
    run quotedText(&mut out, String.view(&node.testId))
  }
  if node.text.ownedByteLength() != 0 {
    run out.append(" text=")
    run quotedText(&mut out, String.view(&node.text))
  }
  run out.append(" parent=")
  if node.parent == NONE {
    if tree.root == slot {
      run out.append("(root)")
    } else {
      run out.append("(detached)")
    }
  } else {
    run out.append("#")
    run writeInt(&mut out, u32.toU64(tree.node(node.parent).id))
  }
  let mut children = List<u32>.make()
  run tree.childSlots(slot, &mut children)
  if children.length() != 0 {
    run out.append(" children=")
    let mut i: usize = 0
    while i < children.length() {
      if i != 0 {
        run out.append(",")
      }
      run out.append("#")
      run writeInt(&mut out, u32.toU64(tree.node(children.get(i)).id))
      i = i + 1
    }
  }
  run out.append("\n")

  let attributesAt = out.ownedByteLength()
  run out.append("attributes:")
  if node.tabIndex != NOT_FOCUSABLE {
    run out.append(" tabIndex=")
    run signed(&mut out, node.tabIndex)
  }
  if node.cursor != Cursor.Default {
    run out.append(" cursor=")
    run out.append(cursorName(node.cursor))
  }
  if node.disabled {
    run out.append(" disabled")
  }
  if node.focusTrap {
    run out.append(" focusTrap")
  }
  if node.checked {
    run out.append(" checked")
  }
  if node.selected {
    run out.append(" selected")
  }
  if node.expanded {
    run out.append(" expanded")
  }
  run noneAfter(&mut out, attributesAt + 11)

  let listenersAt = out.ownedByteLength()
  run out.append("listeners:")
  let l = node.listeners
  run flag(&mut out, l, LISTEN_POINTER_DOWN, "pointerdown")
  run flag(&mut out, l, LISTEN_POINTER_UP, "pointerup")
  run flag(&mut out, l, LISTEN_CLICK, "click")
  run flag(&mut out, l, LISTEN_POINTER_MOVE, "pointermove")
  run flag(&mut out, l, LISTEN_POINTER_ENTER, "pointerenter")
  run flag(&mut out, l, LISTEN_POINTER_LEAVE, "pointerleave")
  run flag(&mut out, l, LISTEN_WHEEL, "wheel")
  run flag(&mut out, l, LISTEN_KEY_DOWN, "keydown")
  run flag(&mut out, l, LISTEN_KEY_UP, "keyup")
  run flag(&mut out, l, LISTEN_FOCUS, "focus")
  run flag(&mut out, l, LISTEN_BLUR, "blur")
  run flag(&mut out, l, LISTEN_INPUT, "input")
  run flag(&mut out, l, LISTEN_SCROLL, "scroll")
  run noneAfter(&mut out, listenersAt + 10)

  let stateAt = out.ownedByteLength()
  run out.append("state:")
  if node.hovered {
    run out.append(" hovered")
  }
  if node.pressed {
    run out.append(" pressed")
  }
  if tree.focused == slot {
    run out.append(" focused")
    if tree.focusVisible {
      run out.append(" focus-visible")
    }
  }
  if node.scrollX != 0.0 || node.scrollY != 0.0 {
    run out.append(" scroll=")
    run writeNumber(&mut out, node.scrollX)
    run out.append(",")
    run writeNumber(&mut out, node.scrollY)
  }
  run noneAfter(&mut out, stateAt + 6)

  let mut models = List<BoxModel>.make()
  run boxModels(tree, id, &mut models)
  if models.length() == 0 {
    run out.append("box model: (no box)\n")
  }
  let list = models.asSlice()
  let mut m: usize = 0
  while m < list.length {
    run out.append("box model: margin ")
    run rect(&mut out, list[m].margin)
    run out.append(" border ")
    run rect(&mut out, list[m].border)
    run out.append(" padding ")
    run rect(&mut out, list[m].padding)
    run out.append(" content ")
    run rect(&mut out, list[m].content)
    run out.append("\n")
    m = m + 1
  }

  if options.patches {
    run patch(&mut out, "base", &node.base)
    run patch(&mut out, "hover", &node.hover)
    run patch(&mut out, "active", &node.active)
    run patch(&mut out, "focus", &node.focus)
    run patch(&mut out, "focus-visible", &node.focusVisible)
  }
  if options.computed {
    let mut computed = List<Declaration>.make()
    run computedProperties(&node.computed, node.kind == NodeKind.Text, &mut computed)
    run out.append("style computed {\n")
    let listed = computed.asSlice()
    let mut i: usize = 0
    while i < listed.length {
      run out.append("  ")
      run writeDeclaration(&mut out, &listed[i])
      run out.append(";\n")
      i = i + 1
    }
    run out.append("}\n")
  }
}

fn verticalName(value: VerticalAlignKind) -> string<'static> {
  return match value {
    VerticalAlignKind.Baseline => "baseline"
    VerticalAlignKind.Middle => "middle"
    VerticalAlignKind.TextTop => "text-top"
    VerticalAlignKind.TextBottom => "text-bottom"
    VerticalAlignKind.Top => "top"
    VerticalAlignKind.Bottom => "bottom"
    VerticalAlignKind.Sub => "sub"
    VerticalAlignKind.Super => "super"
    VerticalAlignKind.Shift => "shift"
  }
}

effect fn dimension(out: &mut String, value: Dimension) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match value.kind {
    DimensionKind.Length => {
      run writePx(&mut out, value.value)
    }
    DimensionKind.Percent => {
      run writeNumber(&mut out, value.percent * 100.0)
      run out.append("%")
    }
    DimensionKind.Calc => {
      run out.append("calc(")
      run writePx(&mut out, value.value)
      run out.append(" + ")
      run writeNumber(&mut out, value.percent * 100.0)
      run out.append("%)")
    }
    DimensionKind.Auto => {
      run out.append("auto")
    }
    DimensionKind.None => {
      run out.append("none")
    }
    DimensionKind.Normal => {
      run out.append("normal")
    }
    DimensionKind.Content => {
      run out.append("content")
    }
    DimensionKind.MinContent => {
      run out.append("min-content")
    }
    DimensionKind.MaxContent => {
      run out.append("max-content")
    }
    DimensionKind.FitContent => {
      run out.append("fit-content")
    }
  }
}

