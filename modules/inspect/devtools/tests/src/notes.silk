//! An extension that belongs to no framework, for the devtools tests: a notes list with a data
//! panel, read again when its topic says the notes changed.
import ui_inspect_server.extension { Extension, ExtensionHandler, News }
import ui_inspect_server.reply { begin, finish, putKey, writeString }
import silk.collections.list { List }
import silk.json.value { Value }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

pub const ID: string = "notes"

pub struct Notes {
  pub items: List<String>,
  pub changed: bool,
}

impl Notes {
  pub fn make() -> Notes {
    return Notes { items: List<String>.make(), changed: false }
  }

  pub effect fn extension() -> Extension
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut info = run Extension.make(ID, "1.0")
    run info.command("list")
    run info.topic("changed")
    run info.panel("list", "Notes", "list", "changed", false)
    return move info
  }

  pub effect fn add(self: &mut Self, text: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.items.append(run String.copy(text))
    self.changed = true
  }
}

impl ExtensionHandler for Notes {
  effect fn command(self: &mut Self, name: string, request: &Value, out: &mut String) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    if name != "list" {
      return false
    }
    run begin(&mut out, request)
    run putKey(&mut out, "notes")
    run out.append("[")
    let items = self.items.asSlice()
    let mut i: usize = 0
    while i < items.length {
      if i > 0 {
        run out.append(",")
      }
      run out.append("{\"text\":")
      run writeString(&mut out, String.view(&items[i]))
      run out.append(",\"done\":false}")
      i = i + 1
    }
    run out.append("]")
    run finish(&mut out)
    return true
  }

  effect fn topics(self: &mut Self, news: &mut News) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.changed {
      self.changed = false
      run news.post("changed", "")
    }
  }
}
