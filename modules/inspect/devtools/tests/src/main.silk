//! Goldens for the devtools window: each scene runs the devtools headless against the todo
//! example (through the inspector protocol, as the tests do), then compares the devtools tree's
//! `describe` snapshot (exactly) and its CPU drawing (each channel may differ by 2) with
//! `<scene>.txt` and `<scene>.png` in the goldens directory. Most scenes are at the design's
//! 1440 by 900; one is docked (1280 by 360), one narrow enough to stack the inspector. The last
//! scene is the todo app itself with the highlight the devtools asked for drawn over it.
//!
//! `ui-inspect-devtools-tests <goldens directory> [--update]`, from the repository root. With
//! `--update` it writes the files instead. Exits 0 when everything matches, 1 on a mismatch, 2
//! on an error.
import inspected { Inspected }
import replay { pullViews, clickView }
import ui_devtools.lib {
  Devtools,
  Message,
  Command,
  Link,
  ViewHost,
  FONT,
  MONO,
  UI_FAMILIES,
  MONO_FAMILIES
}
import ui_app.runtime { Runtime, drain, pump }
import ui_app.harness { click, hover, typeText }
import ui_inspect.query { Query, queryFirst }
import ui_fixtures.fixtures as fixtures
import ui_tree.legacy {
  UiTree,
  TreeError,
  Batch,
  FrameInput,
  CpuSnapshot,
  DescribeOptions,
  Role,
  describe,
  encodePng
}
import ui_tree.inspect { writeInt }
import font_collection.lib { FontCollection }
import codec.png
import codec.png { PngError }
import codec.image { ImageError }
import vector.geometry_error { GeometryError }
import vector.pixmap { Pixmap }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StderrWriter }
import silk.json.scanner { JsonError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.u8
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { String }

static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.platform.windows.path { WindowsPath }
}

const TOLERANCE: u32 = 2

const SCENES: u32 = 13

fn sceneName(index: u32) -> string<'static> {
  return match index {
    0 => "devtools-design"
    1 => "devtools-design-edited"
    2 => "devtools-autocomplete"
    3 => "devtools-styles"
    4 => "devtools-styles-edited"
    5 => "devtools-events"
    6 => "devtools-program"
    7 => "devtools-frames"
    8 => "devtools-audit"
    9 => "devtools-changes"
    10 => "devtools-docked"
    11 => "devtools-narrow"
    _ => "todo-highlight"
  }
}

/// The devtools at the design's size; docked at the bottom of a 1280 by 800 window (45%, the
/// dock's share); in a window narrow enough to stack the inspector.
fn viewport(index: u32) -> FrameInput {
  if index == 10 {
    return FrameInput { width: 1280.0, height: 360.0, scale: 1.0, time: 0.0 }
  }
  if index == 11 {
    return FrameInput { width: 720.0, height: 520.0, scale: 1.0, time: 0.0 }
  }
  return FrameInput { width: 1440.0, height: 900.0, scale: 1.0, time: 0.0 }
}

effect fn say(text: string) -> ()
  ! WriterError {
  let mut writer = StderrWriter.make()
  run Writer.writeString(text) |> Effect.provideMut<Writer>(&mut writer)
  run Writer.flush() |> Effect.provideMut<Writer>(&mut writer)
}

fn mismatches(actual: &[u8], expected: &[u8]) -> u32 {
  if actual.length != expected.length {
    return 4294967295
  }
  let mut count: u32 = 0
  let mut i: usize = 0
  while i < actual.length {
    let a = u8.toU32(actual[i])
    let b = u8.toU32(expected[i])
    let d = if a > b {
      a - b
    } else {
      b - a
    }
    if d > TOLERANCE {
      count = count + 1
    }
    i = i + 1
  }
  return count
}

fn sameBytes(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut i: usize = 0
  while i < a.length {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  return true
}

/// Edits on the Add button as the inspector or an agent make them: its padding and radius,
/// as the design shows, and a comment.
effect fn editAdd(app: &mut Inspected<'_>, comment: bool) -> ()
  ! TreeError | JsonError | OutOfMemoryError
  ? &mut Allocator {
  let mut reply = String.make()
  run app.ask(
    "{\"cmd\":\"setStyle\",\"role\":\"button\",\"name\":\"Add\",\"style\":\"padding: 4px 14px; border-radius: 8px\"}",
    &mut reply,
  )
  if comment {
    run app.ask(
      "{\"cmd\":\"comment\",\"role\":\"button\",\"name\":\"Add\",\"text\":\"Match the radius of the title input next to it.\",\"author\":\"julia\"}",
      &mut reply,
    )
  }
}

/// Runs the devtools against the todo app up to scene `index`.
effect fn script(index: u32, app: &mut Inspected<'_>, tree: &mut UiTree<'_>) -> ()
  ! TreeError | JsonError | OutOfMemoryError
  ? &mut Allocator {
  let at = viewport(index)
  let mut devtools = Runtime<Devtools, Message, Command>.make(run Devtools.make("todo (golden)"))
  run devtools.start(&mut tree, 0.0)
  devtools.send(Message.Refresh)
  run drain(&mut devtools, &mut tree) |> Effect.provideMut<Link>(&mut app)
  let add = run queryFirst(&app.tree, &run Query.byRoleNamed(Role.Button, "Add"))
  let mut row = run String.copy("element-")
  run writeInt(&mut row, u32.toU64(add))
  drop run click(&mut devtools, &mut tree, at, String.view(&row))
    |> Effect.provideMut<Link>(&mut app)
  if index == 1 || index == 4 || index == 9 {
    run editAdd(&mut app, index != 4)
    if index == 9 {
      let mut reply = String.make()
      run app.ask(
        "{\"cmd\":\"comment\",\"reply\":3,\"text\":\"Done in look.silk\",\"author\":\"agent\"}",
        &mut reply,
      )
      run app.ask("{\"cmd\":\"comment\",\"text\":\"The list looks cramped\"}", &mut reply)
      run app.ask(
        "{\"cmd\":\"setStyle\",\"role\":\"button\",\"name\":\"Add\",\"style\":\"font-weight: 600\"}",
        &mut reply,
      )
    }
    devtools.send(Message.Refresh)
    run drain(&mut devtools, &mut tree) |> Effect.provideMut<Link>(&mut app)
    if index == 9 {
      // The weight is resolved: the code does it now.
      let mut weight: u64 = 0
      let rows = devtools.model.changes.asSlice()
      let mut i: usize = 0
      while i < rows.length {
        if String.view(&rows[i].property) == "font-weight" {
          weight = rows[i].id
        }
        i = i + 1
      }
      devtools.send(Message.Resolve { id: weight, reopen: false })
      run drain(&mut devtools, &mut tree) |> Effect.provideMut<Link>(&mut app)
    }
  }
  if index == 2 {
    drop run click(&mut devtools, &mut tree, at, "style-draft") |> Effect.provideMut<Link>(&mut app)
    run typeText(&mut devtools, &mut tree, at, "font-") |> Effect.provideMut<Link>(&mut app)
  }
  if index == 3 || index == 4 {
    drop run click(&mut devtools, &mut tree, at, "Declarations")
      |> Effect.provideMut<Link>(&mut app)
  }
  if index == 5 {
    let mut reply = String.make()
    run app.ask("{\"cmd\":\"click\",\"role\":\"checkbox\",\"name\":\"Walk the dog\"}", &mut reply)
    run app.ask("{\"cmd\":\"click\",\"role\":\"button\",\"name\":\"Add\"}", &mut reply)
    drop run click(&mut devtools, &mut tree, at, "Events") |> Effect.provideMut<Link>(&mut app)
    devtools.send(Message.Refresh)
    run drain(&mut devtools, &mut tree) |> Effect.provideMut<Link>(&mut app)
  }
  if index == 6 || index == 10 {
    // silk-ui's Program panel: the app renders it, the devtools replay it.
    run app.reportProgram()
    drop run click(&mut devtools, &mut tree, at, "Program") |> Effect.provideMut<Link>(&mut app)
    let mut views = ViewHost.make()
    run pullViews(&mut devtools, &mut tree, &mut views, &mut app)
    drop run clickView(&mut devtools, &mut tree, at, &mut views, &mut app, "Added")
    run pullViews(&mut devtools, &mut tree, &mut views, &mut app)
  }
  if index == 7 {
    let mut reply = String.make()
    run app.ask("{\"cmd\":\"click\",\"role\":\"checkbox\",\"name\":\"Walk the dog\"}", &mut reply)
    run app.ask("{\"cmd\":\"click\",\"role\":\"button\",\"name\":\"Add\"}", &mut reply)
    drop run click(&mut devtools, &mut tree, at, "Frames") |> Effect.provideMut<Link>(&mut app)
  }
  if index == 8 {
    drop run click(&mut devtools, &mut tree, at, "Audit") |> Effect.provideMut<Link>(&mut app)
    drop run click(&mut devtools, &mut tree, at, "Run audit") |> Effect.provideMut<Link>(&mut app)
  }
  if index == 9 {
    drop run click(&mut devtools, &mut tree, at, "Edits") |> Effect.provideMut<Link>(&mut app)
  }
  if index == 11 {
    drop run click(&mut devtools, &mut tree, at, "Inspector") |> Effect.provideMut<Link>(&mut app)
  }
  if index == 0 || index == SCENES - 1 {
    // The pointer on another row: the app washes that node and keeps the selection's ring.
    let heading = run queryFirst(&app.tree, &run Query.byText("Todos"))
    let mut over = run String.copy("element-")
    run writeInt(&mut over, u32.toU64(heading))
    drop run hover(&mut devtools, &mut tree, at, String.view(&over))
      |> Effect.provideMut<Link>(&mut app)
  }

  // The last frame's layout records (the devtools' width) are taken before the picture.
  run tree.frame(at)
  drop run pump(&mut devtools, &mut tree) |> Effect.provideMut<Link>(&mut app)
}

/// Runs scene `index` and returns its pixels and snapshot.
effect fn draw(index: u32, collection: &FontCollection, text: &mut String) -> Pixmap
  ! TreeError | JsonError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let mut app = run Inspected.make(collection)
  let mut tree = run UiTree.make(collection)
  let mut batch = Batch.make()
  run batch.fontFamily(FONT, UI_FAMILIES)
  run batch.fontFamily(MONO, MONO_FAMILIES)
  run tree.apply(run batch.take())
  run script(index, &mut app, &mut tree)
  if index == SCENES - 1 {
    // The app as its window draws it while the devtools highlight the Add button.
    run app.frame()
    run describe(&app.tree, DescribeOptions.plain(), &mut text)
    return run app.pixels.renderScene(&app.tree, app.protocol.overlayScene())
  }
  run tree.frame(viewport(index))
  let mut snapshot = CpuSnapshot.make()
  run snapshot.sync(&mut tree)
  run describe(&tree, DescribeOptions.plain(), &mut text)
  return run snapshot.render(&tree)
}

effect fn check(directory: &Path, update: bool) -> u32
  ! TreeError
    | JsonError
    | GeometryError
    | OutOfMemoryError
    | WriterError
    | FileError
    | HostInputError
    | ImageError
    | PngError
  ? &mut FileSystem | &mut Allocator {
  let collection = run fixtures.fonts()
  let mut failures: u32 = 0
  let mut index: u32 = 0
  while index < SCENES {
    let mut text = String.make()
    let pixels = run draw(index, &collection, &mut text)
    let mut pngName = String.make()
    run pngName.append(sceneName(index))
    run pngName.append(".png")
    let mut textName = String.make()
    run textName.append(sceneName(index))
    run textName.append(".txt")
    let pngFile = run Path.join(directory, String.view(&pngName))
    let textFile = run Path.join(directory, String.view(&textName))
    let encoded = run encodePng(&pixels)
    if update {
      run FileSystem.writeFile(&pngFile, Bytes.asSlice(&encoded))
      run FileSystem.writeFile(&textFile, String.utf8Bytes(String.view(&text)))
      run say("wrote ")
    } else {
      let golden = run png.decode(Bytes.asSlice(&run FileSystem.readFile(&pngFile)))
      let actual = run png.decode(Bytes.asSlice(&encoded))
      let bad = mismatches(actual.data(), golden.data())
      let expected = run FileSystem.readFile(&textFile)
      let sameText = sameBytes(String.utf8Bytes(String.view(&text)), Bytes.asSlice(&expected))
      if bad == 0 && sameText {
        run say("ok ")
      } else {
        failures = failures + 1
        if bad != 0 {
          run say("PIXELS DIFFER ")
        }
        if !sameText {
          run say("SNAPSHOT DIFFERS ")
          run say(String.view(&text))
        }
      }
    }
    run say(sceneName(index))
    run say("\n")
    index = index + 1
  }
  return failures
}

effect fn process() -> i32
  ! TreeError
    | JsonError
    | GeometryError
    | OutOfMemoryError
    | WriterError
    | FileError
    | HostInputError
    | ImageError
    | PngError
  ? &mut HostInput | &mut Allocator {
  let count = run HostInput.argumentCount()
  if count < 2 {
    run say("usage: ui-inspect-devtools-tests <goldens directory> [--update]\n")
    return 2
  }
  let update = count > 2
  let raw = match run HostInput.argument(1) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => Bytes.make()
  }

  // Absolute arguments name the directory directly; relative ones resolve from the working directory.
  let directory = if Bytes.length(&raw) != 0 && Bytes.asSlice(&raw)[0] == 47 {
    run Path.fromBytes(Bytes.asSlice(&raw))
  } else {
    let cwd = run HostInput.workingDirectory()
    let base = run hostDirectory(Bytes.asSlice(&cwd))
    run Path.resolveBytes(&base, Bytes.asSlice(&raw))
  }
  let mut files = run MachineFileSystem.make()
  let failures = run check(&directory, update) |> Effect.provideMut<FileSystem>(&mut files)
  return if failures == 0 {
    0
  } else {
    1
  }
}

effect fn failed<E>(error: E) -> i32
  ! WriterError {
  drop error
  run say("ui-inspect-devtools-tests: running a scene, drawing, file access or PNG coding failed\n")
  return 2
}

effect fn failedQuietly<E>(error: E) -> i32 {
  drop error
  return 2
}

pub effect fn main() -> i32
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(Effect.catchAll(process(), failed), failedQuietly)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

// The working directory arrives in host spelling: `C:\...`, or an extended `\\?\` name, on Windows,
// which Path.fromBytes does not accept.
effect fn hostDirectory(bytes: &[u8]) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return run WindowsPath.fromNativeBytes(bytes)
  } else {
    return run Path.fromBytes(bytes)
  }
}
