//! Devtools tests: the devtools app runs headless in one tree and inspects the todo example
//! running in another, through the inspector protocol (`Protocol.handle` in place of the
//! socket). Clicks on the devtools go through the tree's real input path. Run from the
//! repository root (the fixtures read fonts from there).
import inspected { Inspected }
import replay { pullViews, clickView }
// Imported only to register the module's tests with this root.
import embedded as _embedded
import ui_devtools.lib {
  Devtools,
  Message,
  Command,
  Panel,
  Link,
  NO_PARENT,
  ViewHost,
  REMOTE_FIRST
}
import ui_app.runtime { Runtime, drain }
import ui_app.harness { click, hover, moveTo, press, snapshot, typeText }
import ui_inspect.query { Query, queryFirst }
import ui_fixtures.fixtures as fixtures
import ui_tree.legacy { UiTree, TreeError, Batch, FrameInput, Role }
import ui_tree.inspect { writeInt }
import font_collection.lib { FontCollection }
import silk.core.effect { Effect }
import silk.json.scanner { JsonError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.usize
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }

fn viewport() -> FrameInput {
  return FrameInput { width: 900.0, height: 560.0, scale: 1.0, time: 0.0 }
}

effect fn devtoolsTree(collection: &FontCollection) -> UiTree<'_>
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut tree = run UiTree.make(collection)
  let mut batch = Batch.make()
  run batch.fontFamily(1, "Noto Sans, sans-serif")
  run tree.apply(run batch.take())
  return move tree
}

/// "element-<id>".
effect fn rowId(id: u32) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = run String.copy("element-")
  run writeInt(&mut text, u32.toU64(id))
  return move text
}

effect fn highlighted(app: &Inspected<'_>, id: u32) -> bool {
  let list = app.protocol.highlight.nodes.asSlice()
  return list.length == 1 && list[0] == id
}

effect fn body() -> ()
  ! AssertionError<'static> | TreeError | JsonError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut app = run Inspected.make(&collection)
  let mut tree = run devtoolsTree(&collection)
  let mut devtools = Runtime<Devtools, Message, Command>.make(run Devtools.make("todo (test)"))
  run devtools.start(&mut tree, 0.0)

  // The first refresh reads the whole app.
  devtools.send(Message.Refresh)
  run drain(&mut devtools, &mut tree) |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(devtools.model.syncs == 1, "the refresh reached the app")
  run Testing.expect(devtools.model.error.ownedByteLength() == 0, "without an error")
  run Testing.expect(
    devtools.model.rows.length() == app.tree.nodeCount(),
    "one row per node of the app",
  )
  run Testing.expect(devtools.model.rows.asSlice()[0].id == 1, "the app's root comes first")
  run Testing.expect(devtools.model.rows.asSlice()[0].depth == 0, "at depth 0")
  run Testing.expect(
    String.contains(String.view(&devtools.model.status), "nodes"),
    "the status line counts nodes",
  )
  run Testing.expect(devtools.model.stats.length() > 10, "the frame stats are listed")
  let text = run snapshot(&mut tree, viewport())
  run Testing.expect(String.contains(String.view(&text), "button \\\"Add\\\""), "the Add row shows")

  // Clicking the Add button's row selects, inspects and highlights it in the app.
  let add = run queryFirst(&app.tree, &run Query.byRoleNamed(Role.Button, "Add"))
  run Testing.expect(add != 4294967295, "the todo app has an Add button")
  let addRow = run rowId(add)
  run Testing.expect(
    run click(&mut devtools, &mut tree, viewport(), String.view(&addRow))
      |> Effect.provideMut<Link>(&mut app),
    "the row is there",
  )
  run Testing.expect(devtools.model.selected == add, "the row is selected")
  run Testing.expect(run highlighted(&app, add), "the app highlights the node")
  run Testing.expect(devtools.model.detail.id == add, "the node is inspected")
  run Testing.expect(
    String.view(&devtools.model.detail.title) == "button \"Add\"",
    "titled by its role and name",
  )
  run Testing.expect(devtools.model.detail.lines.length() > 20, "with the node view's lines")
  run Testing.expect(devtools.model.detail.hasBox, "and a box model")
  run Testing.expect(devtools.model.detail.box.width > 10.0, "content width")
  run Testing.expect(devtools.model.detail.box.padding.left == 10.0, "padding from the look")
  run Testing.expect(devtools.model.detail.box.border.top == 1.0, "border from the look")
  let styles = run snapshot(&mut tree, viewport())
  run Testing.expect(
    String.contains(String.view(&styles), "\"  padding-left\""),
    "the styles panel shows the declarations",
  )

  // Hovering a row highlights its node in the app; leaving it gives the selection its
  // highlight back. Nothing waits for an answer.
  let root = devtools.model.rows.asSlice()[0].id
  let rootRow = run rowId(root)
  let requests = app.requests
  run Testing.expect(
    run hover(&mut devtools, &mut tree, viewport(), String.view(&rootRow))
      |> Effect.provideMut<Link>(&mut app),
    "the root's row is there",
  )
  run Testing.expect(devtools.model.hovered == root, "the row is hovered")
  run Testing.expect(run highlighted(&app, root), "the app highlights the hovered node")
  run Testing.expect(app.requests > requests, "the highlight went to the app")
  run moveTo(&mut devtools, &mut tree, viewport(), 880.0, 540.0)
    |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(devtools.model.hovered == NO_PARENT, "the pointer left the rows")
  run Testing.expect(run highlighted(&app, add), "the selection is highlighted again")

  // The box model tab.
  drop run click(&mut devtools, &mut tree, viewport(), "Box model")
    |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(devtools.model.panel == Panel.BoxModel, "the box model tab opens")
  let boxes = run snapshot(&mut tree, viewport())
  run Testing.expect(
    String.contains(String.view(&boxes), "testId=\"content\""),
    "content box drawn",
  )
  run Testing.expect(String.contains(String.view(&boxes), "testId=\"margin\""), "margin box drawn")

  // Input to the app is pushed: the devtools read the event log and the tree again.
  let mut reply = String.make()
  let syncs = devtools.model.syncs
  run app.ask("{\"cmd\":\"click\",\"role\":\"button\",\"name\":\"Add\"}", &mut reply)
  run Testing.expect(app.app.model.items.length() == 4, "the click reached the todo app")
  run Testing.expect(app.notified(), "the app tells the devtools")
  devtools.send(Message.Pull)
  run drain(&mut devtools, &mut tree) |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(devtools.model.syncs == syncs + 1, "they read what changed")
  run Testing.expect(devtools.model.events.length() >= 1, "the event log has the click")
  drop run click(&mut devtools, &mut tree, viewport(), "Events")
    |> Effect.provideMut<Link>(&mut app)
  let log = run snapshot(&mut tree, viewport())
  run Testing.expect(String.contains(String.view(&log), "\"click\""), "the log shows a click")
  run Testing.expect(
    devtools.model.rows.length() == app.tree.nodeCount(),
    "the new item's nodes are in the tree",
  )
  let before = devtools.model.events.length()
  devtools.send(Message.Refresh)
  run drain(&mut devtools, &mut tree) |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(devtools.model.events.length() == before, "records are read once")

  // Keys move the selection; Escape clears it and the highlight.
  run press(&mut devtools, &mut tree, viewport(), "ArrowDown", 0)
    |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(devtools.model.selected != add, "ArrowDown moves on")
  run Testing.expect(run highlighted(&app, devtools.model.selected), "and highlights there")
  run press(&mut devtools, &mut tree, viewport(), "Escape", 0) |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(devtools.model.selected == NO_PARENT, "Escape clears the selection")
  run Testing.expect(app.protocol.highlight.nodes.length() == 0, "and the highlight")

  // Folding the root hides everything below it.
  drop run click(&mut devtools, &mut tree, viewport(), "-") |> Effect.provideMut<Link>(&mut app)
  let mut visible: usize = 0
  let rows = devtools.model.rows.asSlice()
  let mut i: usize = 0
  while i < rows.length {
    if rows[i].visible {
      visible = visible + 1
    }
    i = i + 1
  }
  run Testing.expect(visible == 1, "folding the root leaves one row")
  drop run click(&mut devtools, &mut tree, viewport(), "+") |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(devtools.model.rows.asSlice()[1].visible, "unfolding shows them again")

  // silk-ui's Program panel: a view the app renders, replayed in the devtools' tree with ids
  // of their own, its clicks going back to the app.
  run app.reportProgram()
  drop run click(&mut devtools, &mut tree, viewport(), "Program")
    |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(devtools.model.panel == Panel.Extension, "the Program tab is the app's panel")
  run Testing.expect(app.silkUi.panelRunning(), "the app renders it while it is open")
  let mut views = ViewHost.make()
  run pullViews(&mut devtools, &mut tree, &mut views, &mut app)
  run Testing.expect(
    views.count() > 20 && views.applied == 2,
    "its nodes are replayed (the root, then the view)",
  )
  run Testing.expect(views.local(1) >= REMOTE_FIRST, "with ids of the devtools' own")
  let program = run snapshot(&mut tree, viewport())
  run Testing.expect(String.contains(String.view(&program), "click #12"), "a cause shows")
  run Testing.expect(String.contains(String.view(&program), "Save { count: 4 }"), "and a command")
  run Testing.expect(
    run clickView(&mut devtools, &mut tree, viewport(), &mut views, &mut app, "Added"),
    "a message row is clicked",
  )
  run pullViews(&mut devtools, &mut tree, &mut views, &mut app)
  let diff = run snapshot(&mut tree, viewport())
  run Testing.expect(String.contains(String.view(&diff), "  items: 4"), "the app opened its model")
  run Testing.expect(views.applied == 3, "and sent what changed")
  drop run clickView(&mut devtools, &mut tree, viewport(), &mut views, &mut app, "Added")
  run pullViews(&mut devtools, &mut tree, &mut views, &mut app)
  let closed = run snapshot(&mut tree, viewport())
  run Testing.expect(!String.contains(String.view(&closed), "  items: 4"), "and closes it")

  // Another tab closes the view: the app stops rendering it, and nothing more comes.
  drop run click(&mut devtools, &mut tree, viewport(), "Events")
    |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(!app.silkUi.panelRunning(), "the panel's program is gone")
  run app.reportProgram()
  run app.serveExtension()
  run pullViews(&mut devtools, &mut tree, &mut views, &mut app)
  run Testing.expect(views.applied == 4 && app.viewNotes.length() == 0, "no batches while closed")

  // The frame timeline.
  drop run click(&mut devtools, &mut tree, viewport(), "Frames")
    |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(devtools.model.frames.bars.length() > 3, "the frames are drawn")
  run Testing.expect(!devtools.model.frames.timed, "untimed by a host that does not time them")

  // The audit; an issue selects its node.
  drop run click(&mut devtools, &mut tree, viewport(), "Audit") |> Effect.provideMut<Link>(&mut app)
  drop run click(&mut devtools, &mut tree, viewport(), "Run audit")
    |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(
    String.contains(String.view(&devtools.model.auditLine), "nodes"),
    "the audit ran",
  )

  // A style typed into the styles panel lands on the node in the app.
  devtools.send(Message.Select { id: add })
  run drain(&mut devtools, &mut tree) |> Effect.provideMut<Link>(&mut app)
  drop run click(&mut devtools, &mut tree, viewport(), "Styles")
    |> Effect.provideMut<Link>(&mut app)
  let width = devtools.model.detail.box.width
  run Testing.expect(
    run click(&mut devtools, &mut tree, viewport(), "style-draft")
      |> Effect.provideMut<Link>(&mut app),
    "the styles panel has a field",
  )
  run typeText(&mut devtools, &mut tree, viewport(), "width: 200px")
    |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(String.view(&devtools.model.draft) == "width: 200px", "typing fills it")
  run press(&mut devtools, &mut tree, viewport(), "Enter", 0) |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(devtools.model.draft.ownedByteLength() == 0, "Enter applies it")
  run Testing.expect(devtools.model.detail.box.width > width, "the node is wider")
  run typeText(&mut devtools, &mut tree, viewport(), "no such thing")
    |> Effect.provideMut<Link>(&mut app)
  run press(&mut devtools, &mut tree, viewport(), "Enter", 0) |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(devtools.model.styleError.ownedByteLength() != 0, "a bad style says why")
  drop run click(&mut devtools, &mut tree, viewport(), "Reset") |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(devtools.model.detail.box.width == width, "Reset takes the edit back")

  // The filter hides the rows that do not match.
  drop run click(&mut devtools, &mut tree, viewport(), "search")
    |> Effect.provideMut<Link>(&mut app)
  run typeText(&mut devtools, &mut tree, viewport(), "BUTTON") |> Effect.provideMut<Link>(&mut app)
  let filtered = devtools.model.rows.asSlice()
  let mut shown: usize = 0
  let mut k: usize = 0
  while k < filtered.length {
    if filtered[k].visible {
      shown = shown + 1
      run Testing.expect(
        String.contains(String.view(&filtered[k].label), "button"),
        "only matching rows show",
      )
    }
    k = k + 1
  }
  run Testing.expect(shown > 0 && shown < filtered.length, "some rows, not all")
  devtools.send(Message.Search { value: String.make() })
  run drain(&mut devtools, &mut tree) |> Effect.provideMut<Link>(&mut app)

  // Pick: the press in the app's window selects here.
  run press(&mut devtools, &mut tree, viewport(), "Escape", 0) |> Effect.provideMut<Link>(&mut app)
  drop run click(&mut devtools, &mut tree, viewport(), "Pick") |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(devtools.model.picking && app.protocol.picking, "the app waits for a pick")
  app.protocol.picked = add
  app.protocol.picking = false
  app.protocol.changes.pick = true
  run app.frame()
  devtools.send(Message.Pull)
  run drain(&mut devtools, &mut tree) |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(!devtools.model.picking, "the pick ends")
  run Testing.expect(devtools.model.selected == add, "with the picked node selected")
  run Testing.expect(devtools.model.detail.id == add, "and inspected")

  // With Live off, the devtools unsubscribe: a change in the app is not pushed.
  drop run click(&mut devtools, &mut tree, viewport(), "Live") |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(!devtools.model.live, "Live toggles off")
  run app.ask("{\"cmd\":\"click\",\"role\":\"button\",\"name\":\"Add\"}", &mut reply)
  run Testing.expect(!app.notified(), "nothing is pushed while not live")
  let rowCount = devtools.model.rows.length()
  devtools.send(Message.Pull)
  run drain(&mut devtools, &mut tree) |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(devtools.model.rows.length() == rowCount, "and nothing is read")
  drop run click(&mut devtools, &mut tree, viewport(), "Live") |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(
    devtools.model.rows.length() == app.tree.nodeCount(),
    "Live on reads everything again",
  )

  // An app that cannot be reached shows in the status line.
  app.down = true
  devtools.send(Message.Refresh)
  run drain(&mut devtools, &mut tree) |> Effect.provideMut<Link>(&mut app)
  let down = run snapshot(&mut tree, viewport())
  run Testing.expect(
    String.contains(String.view(&down), "cannot reach the app: connection refused"),
    "the error is shown",
  )
  app.down = false
  devtools.send(Message.Refresh)
  run drain(&mut devtools, &mut tree) |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(devtools.model.error.ownedByteLength() == 0, "and cleared when it is back")
}

test effect fn devtoolsInspectTheTodoApp() -> ()
  ! AssertionError<'static> | TreeError | JsonError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run body() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// Takes what the app pushed and the replies that came, as the window does when the app wakes it.
effect fn pull(
  devtools: &mut Runtime<Devtools, Message, Command>,
  tree: &mut UiTree<'_>,
  app: &mut Inspected<'_>,
) -> ()
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  devtools.send(Message.Pull)
  run drain(&mut devtools, &mut tree) |> Effect.provideMut<Link>(&mut app)
}

effect fn dataPanelBody() -> ()
  ! AssertionError<'static> | TreeError | JsonError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut app = run Inspected.make(&collection)
  run app.addNotes()
  run app.notes.add("milk")
  let mut tree = run devtoolsTree(&collection)
  let mut devtools = Runtime<Devtools, Message, Command>.make(run Devtools.make("notes (test)"))
  run devtools.start(&mut tree, 0.0)
  devtools.send(Message.Refresh)
  run drain(&mut devtools, &mut tree) |> Effect.provideMut<Link>(&mut app)

  // The tab bar comes from hello: the extension's panel is a tab.
  run Testing.expect(devtools.model.panels.length() == 2, "hello lists the panel, after silk-ui's")
  let bar = run snapshot(&mut tree, viewport())
  run Testing.expect(String.contains(String.view(&bar), "\"Notes\""), "a tab for it")
  run Testing.expect(
    run click(&mut devtools, &mut tree, viewport(), "Notes") |> Effect.provideMut<Link>(&mut app),
    "the tab opens",
  )
  run Testing.expect(devtools.model.panel == Panel.Extension, "the extension's panel shows")

  // Its data comes when the app serves the extension, shown in rows.
  run pull(&mut devtools, &mut tree, &mut app)
  let shown = run snapshot(&mut tree, viewport())
  run Testing.expect(String.contains(String.view(&shown), "\"\\\"milk\\\"\""), "the data shows")
  run Testing.expect(String.contains(String.view(&shown), "\"done\""), "member by member")

  // The panel's topic says the data changed: it is read again.
  run app.notes.add("eggs")
  run app.serveExtension()
  run pull(&mut devtools, &mut tree, &mut app)
  run pull(&mut devtools, &mut tree, &mut app)
  let again = run snapshot(&mut tree, viewport())
  run Testing.expect(String.contains(String.view(&again), "\"\\\"eggs\\\"\""), "read again")
}

test effect fn devtoolsShowAnExtensionsDataPanel() -> ()
  ! AssertionError<'static> | TreeError | JsonError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run dataPanelBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
