//! The app the tests inspect: the todo example in its own tree, serving the inspector protocol
//! in the same process. It is the devtools' [`Link`]: a session over a memory channel, the same
//! `Session` the socket server runs. Each line the devtools send is served at once, and input a
//! request dispatches is pumped to the app and drawn, as the window loop does; after each frame
//! the session is told what changed. The app is a silk-ui program, so the `silk-ui` extension is
//! registered and served after each line, as the window host does.
import ui_devtools.link { Link, Requests }
import ui_app_examples.todo { Todo, Message as TodoMessage, Command as TodoCommand, Store }
import ui_app_examples.look { SANS }
import ui_app.runtime { Runtime, pump }
import ui_inspect_server.protocol { Protocol, Outcome }
import ui_inspect_server.channel { Channel, MemoryChannel, MemoryPair }
import ui_inspect_server.session { Session }
import ui_inspect_server.extension { Outgoing }
import ui_app_inspect.lib { SilkUi, ProgramStep, ID as SILK_UI }
import notes { Notes, ID as NOTES }
import silk.collections.list { List }
import ui_tree.legacy { UiTree, TreeError, Batch, FrameInput, CpuSnapshot }
import font_collection.lib { FontCollection }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.json.scanner { JsonError }
import silk.json.value { Json }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

pub struct NullStore {}

impl Store for NullStore {
  effect fn save(self: &mut Self, count: u64) -> u64 {
    return count
  }
}

pub fn appViewport() -> FrameInput {
  return FrameInput { width: 360.0, height: 300.0, scale: 1.0, time: 0.0 }
}

/// The todo app, its tree and its inspector state.
pub struct Inspected<'f> {
  pub tree: UiTree<'f>,
  pub app: Runtime<Todo, TodoMessage, TodoCommand>,
  pub protocol: Protocol,
  pub store: NullStore,
  /// The atlas on the CPU, for pictures of the app.
  pub pixels: CpuSnapshot,
  /// Requests served.
  pub requests: u64,
  /// When set, every request fails as if the app were gone.
  pub down: bool,
  /// The session, the app's end of its channel and the devtools' end.
  pub session: Session,
  /// The silk-ui extension of the todo app.
  pub silkUi: SilkUi,
  /// The view batches the app pushed, for the test to replay into the devtools' tree, as a
  /// window does (`ui_devtools.remote`).
  pub viewNotes: List<String>,
  /// An extension of no framework, once `addNotes` registered it.
  pub notes: Notes,
  withNotes: bool,
  end: MemoryChannel,
  client: MemoryChannel,
  numbering: Requests,
}

impl<'f> Inspected<'f> {
  pub effect fn make(collection: &'f FontCollection) -> Inspected<'f>
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut tree = run UiTree.make(collection)
    let mut batch = Batch.make()
    run batch.fontFamily(SANS, "Noto Sans, sans-serif")
    run tree.apply(run batch.take())
    let mut app = Runtime<Todo, TodoMessage, TodoCommand>.make(run Todo.make())
    run app.start(&mut tree, 0.0)
    let pair = run MemoryChannel.pair()
    let MemoryPair { first, second } = move pair
    let mut inspected = Inspected<'f> {
      tree: move tree,
      app: move app,
      protocol: Protocol.make(),
      store: NullStore {},
      pixels: CpuSnapshot.make(),
      requests: 0,
      down: false,
      session: Session.open(),
      silkUi: SilkUi.make(),
      viewNotes: List<String>.make(),
      notes: Notes.make(),
      withNotes: false,
      end: move first,
      client: move second,
      numbering: Requests.make(),
    }
    run inspected.protocol.extend(run SilkUi.extension())
    run inspected.frame()
    return move inspected
  }

  /// Draws a frame, lets the protocol see it and tells the session what changed, as the
  /// window loop does.
  pub effect fn frame(self: &mut Self) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.tree.frame(appViewport())
    run self.protocol.afterFrame(&self.tree)
    run self.pixels.sync(&mut self.tree)
    let topics = run self.protocol.takeChanges(&self.tree, self.session.topics)
    run self.session.publish(&self.protocol, &self.tree, topics)
      |> Effect.provideMut<Channel>(&mut self.end)
  }

  /// Serves the lines the devtools sent, each followed by the app's answer and a frame.
  effect fn serve(self: &mut Self) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    while run self.session.serveNext(&mut self.protocol, &mut self.tree)
      |> Effect.provideMut<Channel>(&mut self.end) {
      self.requests = self.requests + 1
      run self.answer()
    }
    run self.serveExtension()
  }

  /// Serves the silk-ui extension, as the window loop does on each turn: what waits for it is
  /// answered, and its news pushed.
  pub effect fn serveExtension(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.protocol.serveExtension(SILK_UI, &mut self.silkUi)
    if self.withNotes {
      run self.protocol.serveExtension(NOTES, &mut self.notes)
    }
    run self.session.deliver(&mut self.protocol) |> Effect.provideMut<Channel>(&mut self.end)
    let mut news = List<Outgoing>.make()
    run self.protocol.extensions.takeNews(&mut news)
    run self.session.publishNews(&news) |> Effect.provideMut<Channel>(&mut self.end)
  }

  /// Pumps input a request dispatched to the app, and draws.
  effect fn answer(self: &mut Self) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    while run self.protocol.dispatchNext(&mut self.tree) {
      run self.protocol.observe(&self.tree)
      drop run pump(&mut self.app, &mut self.tree) |> Effect.provideMut<Store>(&mut self.store)
    }
    if self.protocol.dispatched {
      run self.protocol.observe(&self.tree)
      drop run pump(&mut self.app, &mut self.tree) |> Effect.provideMut<Store>(&mut self.store)
      self.protocol.dispatched = false
    }
    self.protocol.repaint = false
    run self.frame()
  }

  /// Runs one request line from another client (as the CLI would send) and writes the reply
  /// line. The devtools' session hears what it changed.
  pub effect fn ask(self: &mut Self, line: string, reply: &mut String) -> ()
    ! JsonError | TreeError | OutOfMemoryError
    ? &mut Allocator {
    let request = run Json.parse(String.utf8Bytes(line))
    reply.clear()
    let outcome = run self.protocol.handle(&mut self.tree, &request, 0, &mut reply)
    if outcome == Outcome.Pending {
      run reply.append("{\"ok\":true,\"pending\":true}")
    }
    run self.answer()
  }

  /// Whether the app pushed notifications the devtools did not take yet.
  pub fn notified(self: &Self) -> bool {
    return self.client.pending() || self.numbering.notes.length() != 0
  }
}

impl<'f> Inspected<'f> {
  /// Registers the notes extension, which no framework has.
  pub effect fn addNotes(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.protocol.extend(run Notes.extension())
    self.withNotes = true
  }
}

/// A step of a program, as a host reports it.
effect fn step(
  seq: u64,
  cause: string,
  message: string,
  command: string,
  model: string,
) -> ProgramStep
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut commands = List<String>.make()
  if command != "" {
    run commands.append(run String.copy(command))
  }
  return ProgramStep {
    seq: seq,
    time: 0.5,
    cause: run String.copy(cause),
    message: run String.copy(message),
    commands: move commands,
    model: run String.copy(model),
  }
}

impl<'f> Inspected<'f> {
  /// Reports a program that handled three messages, as a silk-ui window does.
  pub effect fn reportProgram(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let log = &mut self.silkUi.log
    log.attached = true
    run log.subscriptions.append(run String.copy("every 1s"))
    run log.subscriptions.append(run String.copy("key n"))
    log.stats.messages = 3
    log.stats.commands = 1
    log.stats.renders = 4
    log.stats.mutations = 6
    log.stats.nodes = 40
    log.stats.reused = 31
    run log.add(
      run step(1, "init", "Started", "", "Todo {\n  draft: \"\"\n  items: 3\n  saved: 0\n}"),
    )
    run log.add(
      run step(
        2,
        "input #9",
        "Typed { value: \"Buy milk\" }",
        "",
        "Todo {\n  draft: \"Buy milk\"\n  items: 3\n  saved: 0\n}",
      ),
    )
    run log.add(
      run step(
        3,
        "click #12",
        "Added",
        "Save { count: 4 }",
        "Todo {\n  draft: \"\"\n  items: 4\n  saved: 0\n}",
      ),
    )
  }
}

impl<'f> Link for Inspected<'f> {
  effect fn request(self: &mut Self, line: string, reply: &mut String) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    reply.clear()
    if self.down {
      run reply.append("connection refused")
      return false
    }
    let id = run self.numbering.send(line) |> Effect.provideMut<Channel>(&mut self.client)
    if !run self.served() {
      run reply.append("the request failed")
      return false
    }
    if run self.numbering.collect(id, &mut reply) |> Effect.provideMut<Channel>(&mut self.client) {
      return true
    }
    run reply.append("no reply")
    return false
  }

  effect fn notify(self: &mut Self, line: string) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.down {
      return false
    }
    drop run Channel.send(line) |> Effect.provideMut<Channel>(&mut self.client)
    return run self.served()
  }

  effect fn ask(self: &mut Self, line: string) -> u64
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.down {
      return 0
    }
    let id = run self.numbering.ask(line) |> Effect.provideMut<Channel>(&mut self.client)
    if !run self.served() {
      return 0
    }
    return id
  }

  effect fn take(self: &mut Self, out: &mut List<String>) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut none = String.make()
    drop run self.numbering.collect(0, &mut none) |> Effect.provideMut<Channel>(&mut self.client)
    let mut notes = List<String>.make()
    run self.numbering.takeNotes(&mut notes)
    while notes.length() != 0 {
      let line = notes.remove(0)
      if String.contains(String.view(&line), "\"mutations\":") {
        run self.viewNotes.append(move line)
      } else {
        run out.append(move line)
      }
    }
    return true
  }
}

impl<'f> Inspected<'f> {
  /// `serve`, with a failure of the app's part reported as false.
  effect fn served(self: &mut Self) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let result = run Effect.result(self.serve())
    return match move result {
      Result<(), TreeError | OutOfMemoryError>.Success { value: _ } => true
      Result<(), TreeError | OutOfMemoryError>.Failure { error } => {
        drop error
        false
      }
    }
  }
}
