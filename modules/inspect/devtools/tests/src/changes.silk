//! The Changes panel and the editing in the Styles panel, against the todo example: completion
//! from the css tables, ArrowUp stepping a number live, the edit marked in the Styles panel and
//! listed (with a comment) in the Changes panel, resolve, reopen and reset there, and an edit
//! that outlasts the app re-rendering.
import inspected { Inspected }
import ui_devtools.lib {
  Devtools,
  Message,
  Command,
  Segment,
  Link,
  MARK_EDITED,
  MARK_OVERRIDDEN,
  FONT,
  MONO,
  UI_FAMILIES,
  MONO_FAMILIES,
  FIELD_PADDING,
  FIELD_RADIUS,
  fieldEdited
}
import ui_app.runtime { Runtime, drain }
import ui_app.harness { click, press, snapshot, typeText }
import ui_inspect.query { Query, queryFirst }
import ui_fixtures.fixtures as fixtures
import ui_tree.legacy { UiTree, TreeError, Batch, FrameInput, Role }
import ui_tree.inspect { writeInt }
import ui_tree.mutation { StyleState }
import ui_tree.input { MOD_SHIFT }
import font_collection.lib { FontCollection }
import silk.core.effect { Effect }
import silk.json.scanner { JsonError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }

/// The devtools' own window at its first size.
fn viewport() -> FrameInput {
  return FrameInput { width: 1280.0, height: 800.0, scale: 1.0, time: 0.0 }
}

effect fn devtoolsTree(collection: &FontCollection) -> UiTree<'_>
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut tree = run UiTree.make(collection)
  let mut batch = Batch.make()
  run batch.fontFamily(FONT, UI_FAMILIES)
  run batch.fontFamily(MONO, MONO_FAMILIES)
  run tree.apply(run batch.take())
  return move tree
}

/// `<kind>-<id>`, a test id in the Changes panel.
effect fn testId(kind: string, id: u64) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = run String.copy(kind)
  run text.append("-")
  run writeInt(&mut text, id)
  return move text
}

fn hasMark(devtools: &Runtime<Devtools, Message, Command>, mark: u8) -> bool {
  let marks = devtools.model.detail.marks.asSlice()
  let mut i: usize = 0
  while i < marks.length {
    if marks[i] == mark {
      return true
    }
    i = i + 1
  }
  return false
}

effect fn body() -> ()
  ! AssertionError<'static> | TreeError | JsonError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut app = run Inspected.make(&collection)
  let mut tree = run devtoolsTree(&collection)
  let mut devtools = Runtime<Devtools, Message, Command>.make(run Devtools.make("todo (test)"))
  run devtools.start(&mut tree, 0.0)
  devtools.send(Message.Refresh)
  run drain(&mut devtools, &mut tree) |> Effect.provideMut<Link>(&mut app)
  let add = run queryFirst(&app.tree, &run Query.byRoleNamed(Role.Button, "Add"))
  devtools.send(Message.Select { id: add })
  run drain(&mut devtools, &mut tree) |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(devtools.model.changes.length() == 0, "no changes yet")

  // Completion from the css package's property table, then the value typed.
  run Testing.expect(
    run click(&mut devtools, &mut tree, viewport(), "style-draft")
      |> Effect.provideMut<Link>(&mut app),
    "the declarations field",
  )
  run typeText(&mut devtools, &mut tree, viewport(), "padding-le")
    |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(
    devtools.model.suggestions.length() == 1
      && String.view(&devtools.model.suggestions.asSlice()[0]) == "padding-left",
    "the property completes",
  )
  let offered = run snapshot(&mut tree, viewport())
  run Testing.expect(String.contains(String.view(&offered), "testId=\"suggestions\""), "and shows")
  devtools.send(Message.Complete { index: 0 })
  run drain(&mut devtools, &mut tree) |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(String.view(&devtools.model.draft) == "padding-left: ", "with its colon")
  devtools.send(Message.StyleDraft { value: run String.copy("padding-left: in") })
  run drain(&mut devtools, &mut tree) |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(
    devtools.model.suggestions.length() == 2,
    "values complete too: inherit, initial",
  )
  devtools.send(Message.StyleDraft { value: run String.copy("padding-left: 20px") })
  run drain(&mut devtools, &mut tree) |> Effect.provideMut<Link>(&mut app)

  // ArrowUp steps the number and sets it at once; Shift steps by ten.
  run press(&mut devtools, &mut tree, viewport(), "ArrowUp", 0) |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(String.view(&devtools.model.draft) == "padding-left: 21px", "ArrowUp steps")
  run Testing.expect(
    app.protocol.edits.openCount() == 1 && app.tree.overridden(add, StyleState.Base),
    "and the app has the edit",
  )
  run press(&mut devtools, &mut tree, viewport(), "ArrowDown", MOD_SHIFT)
    |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(
    String.view(&devtools.model.draft) == "padding-left: 11px",
    "Shift steps by ten",
  )
  run Testing.expect(devtools.model.selected == add, "the arrows did not move the selection")
  run press(&mut devtools, &mut tree, viewport(), "Enter", 0) |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(devtools.model.draft.ownedByteLength() == 0, "Enter sets it and clears")
  run Testing.expect(
    devtools.model.changes.length() == 1 && devtools.model.openChanges == 1
      && String.view(&devtools.model.changes.asSlice()[0].after) == "11px"
      && String.view(&devtools.model.changes.asSlice()[0].before) == "10px",
    "one edit, from the app's 10px to the last value",
  )
  run Testing.expect(
    hasMark(&devtools, MARK_EDITED) && hasMark(&devtools, MARK_OVERRIDDEN),
    "the node view marks the edit and the app's declaration it hides",
  )
  drop run click(&mut devtools, &mut tree, viewport(), "Declarations")
    |> Effect.provideMut<Link>(&mut app)
  let styles = run snapshot(&mut tree, viewport())
  run Testing.expect(
    String.contains(String.view(&styles), "testId=\"edited-styles\""),
    "an edited section",
  )

  // A comment from the selected node, in the Edits segment.
  run Testing.expect(
    run click(&mut devtools, &mut tree, viewport(), "Edits") |> Effect.provideMut<Link>(&mut app),
    "the Edits segment",
  )
  run Testing.expect(devtools.model.segment == Segment.Edits, "opens")
  drop run click(&mut devtools, &mut tree, viewport(), "comment-draft")
    |> Effect.provideMut<Link>(&mut app)
  run typeText(&mut devtools, &mut tree, viewport(), "Rounder corners")
    |> Effect.provideMut<Link>(&mut app)
  run press(&mut devtools, &mut tree, viewport(), "Enter", 0) |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(
    devtools.model.openChanges == 2 && devtools.model.comment.ownedByteLength() == 0,
    "the comment is in the log",
  )

  // The Edits segment lists both, a card each.
  let listed = run snapshot(&mut tree, viewport())
  run Testing.expect(
    String.contains(String.view(&listed), " · padding-left\"")
      && String.contains(String.view(&listed), "\"10\"")
      && String.contains(String.view(&listed), "\"11\"")
      && String.contains(String.view(&listed), "\"Rounder corners\""),
    "with the edit, from 10 to 11, and the comment",
  )
  let edit = devtools.model.changes.asSlice()[0].id
  let note = devtools.model.changes.asSlice()[1].id

  // The app re-renders: the edit stays.
  let mut reply = String.make()
  run app.ask("{\"cmd\":\"click\",\"role\":\"button\",\"name\":\"Add\"}", &mut reply)
  run Testing.expect(app.tree.overridden(add, StyleState.Base), "the edit outlasts a re-render")

  // Resolve, reopen, reset.
  let resolve = run testId("resolve", edit)
  run Testing.expect(
    run click(&mut devtools, &mut tree, viewport(), String.view(&resolve))
      |> Effect.provideMut<Link>(&mut app),
    "the edit's Resolve",
  )
  run Testing.expect(
    !devtools.model.changes.asSlice()[0].open && !app.tree.overridden(add, StyleState.Base),
    "resolving takes the edit off the app",
  )
  let reopen = run testId("reopen", edit)
  drop run click(&mut devtools, &mut tree, viewport(), String.view(&reopen))
    |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(
    devtools.model.changes.asSlice()[0].open && app.tree.overridden(add, StyleState.Base),
    "reopening lays it on again",
  )
  let reset = run testId("reset", edit)
  drop run click(&mut devtools, &mut tree, viewport(), String.view(&reset))
    |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(
    devtools.model.changes.length() == 1 && !app.tree.overridden(add, StyleState.Base),
    "Reset takes the edit back and out of the log",
  )
  let resolveNote = run testId("resolve", note)
  drop run click(&mut devtools, &mut tree, viewport(), String.view(&resolveNote))
    |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(
    devtools.model.openChanges == 0 && devtools.model.changes.length() == 1,
    "a resolved comment stays, resolved",
  )
}

/// The Design segment's fields: one typed into lands in the app's edit log as a declaration,
/// is marked edited, and the arrows step a field's number and set it.
effect fn designBody() -> ()
  ! AssertionError<'static> | TreeError | JsonError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut app = run Inspected.make(&collection)
  let mut tree = run devtoolsTree(&collection)
  let mut devtools = Runtime<Devtools, Message, Command>.make(run Devtools.make("todo (test)"))
  run devtools.start(&mut tree, 0.0)
  devtools.send(Message.Refresh)
  run drain(&mut devtools, &mut tree) |> Effect.provideMut<Link>(&mut app)
  let add = run queryFirst(&app.tree, &run Query.byRoleNamed(Role.Button, "Add"))
  devtools.send(Message.Select { id: add })
  run drain(&mut devtools, &mut tree) |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(devtools.model.segment == Segment.Design, "Design shows first")
  run Testing.expect(!fieldEdited(&devtools.model.detail, FIELD_PADDING), "nothing edited yet")

  // Padding typed as the field shows it, set with Enter.
  run Testing.expect(
    run click(&mut devtools, &mut tree, viewport(), "field-padding")
      |> Effect.provideMut<Link>(&mut app),
    "the padding field",
  )
  devtools.send(Message.FieldInput { field: FIELD_PADDING, value: run String.copy("4 14") })
  run drain(&mut devtools, &mut tree) |> Effect.provideMut<Link>(&mut app)
  run press(&mut devtools, &mut tree, viewport(), "Enter", 0) |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(
    devtools.model.changes.length() == 1
      && String.view(&devtools.model.changes.asSlice()[0].property) == "padding"
      && String.view(&devtools.model.changes.asSlice()[0].after) == "4px 14px",
    "the edit log has the padding the field set",
  )
  run Testing.expect(
    app.protocol.edits.openCount() == 1 && app.tree.overridden(add, StyleState.Base),
    "laid over the app",
  )
  run Testing.expect(devtools.model.detail.box.padding.left == 14.0, "which draws it")
  run Testing.expect(fieldEdited(&devtools.model.detail, FIELD_PADDING), "the field is marked")
  let marked = run snapshot(&mut tree, viewport())
  run Testing.expect(
    String.contains(String.view(&marked), "testId=\"field-padding\" \"4 14\"")
      && String.contains(String.view(&marked), "label=\"edited\""),
    "with its value and the edited dot",
  )

  // ArrowUp in the radius field steps it and sets it at once.
  drop run click(&mut devtools, &mut tree, viewport(), "field-radius")
    |> Effect.provideMut<Link>(&mut app)
  run press(&mut devtools, &mut tree, viewport(), "ArrowUp", 0) |> Effect.provideMut<Link>(&mut app)
  run Testing.expect(
    devtools.model.changes.length() == 2 && fieldEdited(&devtools.model.detail, FIELD_RADIUS),
    "the radius is stepped into the log",
  )
  run Testing.expect(
    String.view(&devtools.model.changes.asSlice()[1].after) == "7px",
    "one up from the app's 6px",
  )
}

test effect fn devtoolsDesignFieldsEditThroughTheLog() -> ()
  ! AssertionError<'static> | TreeError | JsonError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run designBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn devtoolsEditAndListChanges() -> ()
  ! AssertionError<'static> | TreeError | JsonError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run body() |> Effect.provideMut<Allocator>(&mut allocator)
}
