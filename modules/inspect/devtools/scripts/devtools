#!/usr/bin/env node
// Debug applications serve SILK_UI_INSPECT; devtools is itself inspectable.
import { resolve } from 'node:path';
import { build } from '../../../../scripts/internal.mjs';
import { environment, execute, withDisplay, until } from '../../../../scripts/native-run.mjs';
import { inspectorCLI, program, expect, json, picture, work } from '../../../../scripts/inspector.mjs';
const args = process.argv.slice(2);
const value = flag => { const index = args.indexOf(flag); return index < 0 ? undefined : args[index + 1]; };
const mode = args[0] && !args[0].startsWith('--') ? args[0] : 'run';
if (!['run', 'todo', 'external', 'check'].includes(mode)) throw new Error('Usage: devtools [run|todo|check|external --app-binary PATH] [--connect ADDRESS] [--app-arg ARG] [--build-only]');
const toolsBinary = build('modules/inspect/devtools/app');
if (args.includes('--build-only')) console.log(toolsBinary);
else if (mode === 'run') await execute(toolsBinary, value('--connect') ? ['--connect', value('--connect')] : [], environment(), 2147483647);
else {
  const binary = mode === 'external' ? value('--app-binary') : build('modules/app/demo');
  if (!binary) throw new Error('external requires --app-binary PATH');
  const appArgs = args.flatMap((arg, index) => arg === '--app-arg' ? [args[index + 1]] : []);
  const cli = inspectorCLI();
  const launch = async env => {
    const app = await program('todo', resolve(binary), appArgs, env, cli);
    try {
      if (mode !== 'check') return await execute(toolsBinary, ['--connect', app.socket], env, 2147483647);
      const tools = await program('devtools', toolsBinary, ['--connect', app.socket], env, cli);
      try {
        const nodes = json(app.command('query', '--role', 'button', '--name', 'Add', '--exact')).nodes;
        expect(nodes.length === 1, 'todo has one Add button');
        const button = nodes[0].id;
        const row = `element-${button}`;
        expect(tools.command('wait', '--test-id', row, '--timeout', '20000').status === 0, 'devtools lists Add element');
        const snap = tools.command('snapshot');
        expect(snap.stdout.includes('label="button \\"Add\\""') && !snap.stdout.includes('cannot reach'), 'devtools labels role/name and has no connection error');
        expect(tools.command('click', '--test-id', row).status === 0, 'select Add row');
        await until(() => JSON.stringify(json(app.command('hello')).highlight) === JSON.stringify([button]), 'selected node highlights in todo', 15000);
        const title = tools.command('wait', '--test-id', 'detail-title', '--timeout', '10000');
        expect(title.status === 0, 'styles panel appears');
        const styles = tools.command('snapshot', '--node', String(json(title).node.id));
        expect(styles.stdout.includes('button \\"Add\\"'), 'styles title names Add');
        const panel = tools.command('snapshot', '--test-id', 'panel');
        expect(panel.stdout.includes('"  padding-left"') && panel.stdout.includes(': 10px;'), 'styles include todo button padding');
        expect(tools.command('click', '--role', 'button', '--name', 'Box model', '--exact').status === 0, 'open box model');
        expect(tools.command('wait', '--test-id', 'content', '--timeout', '10000').status === 0, 'content box is drawn');
        const boxes = tools.command('snapshot', '--test-id', 'box-model');
        expect(boxes.stdout.includes('testId="padding"') && boxes.stdout.includes('"10"'), 'box model displays padding widths');
        expect(app.command('click', '--role', 'button', '--name', 'Add', '--exact').status === 0, 'click Add in todo');
        expect(tools.command('click', '--role', 'button', '--name', 'Events', '--exact').status === 0, 'open events');
        expect(tools.command('wait', '--test-id', 'event-log', '--timeout', '10000').status === 0, 'event log appears');
        await until(() => {
          const log = tools.command('snapshot', '--test-id', 'event-log');
          return log.stdout.includes('"click"') && log.stdout.includes('button \\"Add\\"');
        }, 'event log records Add click', 15000);
        expect(tools.command('wait', '--text', 'Task 4', '--timeout', '10000').status === 0, 'devtools tree refreshes with new todo');
        expect(app.command('wait', '--text', 'Task 4', '--timeout', '10000').status === 0, 'todo displays new task');
        for (const [name, target] of [['devtools', tools], ['todo', app]]) {
          const shot = resolve(work, `${name}.png`);
          expect(target.command('screenshot', shot).status === 0, `${name} screenshot`);
          picture(shot);
        }
      } finally { await tools.close(); }
    } finally { await app.close(); }
  };
  if (mode === 'check') await withDisplay('x11', launch);
  else await launch(environment());
}
