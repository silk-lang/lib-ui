//! What the devtools window shows, read out of the inspector protocol's JSON replies: the
//! element tree (`tree`), a node's view and box model (`inspect`), the event log (`events`), the
//! frame stats (`stats`), the status line (`hello`), the program's messages and models
//! (`program`, `messages`, `model`), the frame timeline (`frames`) and the audit (`audit`).
//! Display text is made here, once per reply, so the view only lays it out.
import ui_inspect_server.reply { appendNumber, textField, numberField, idField, flagField, has }
import ui_tree.inspect { writeInt, writeNumber }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.json.value { Json, Value }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.text.string { String }

/// The parent of the top row.
pub const NO_PARENT: u32 = 4294967295

/// The longest accessible name a row shows, in bytes; longer names are cut at a character.
const NAME_LIMIT: usize = 48

/// One node of the element tree.
pub struct Row {
  pub id: u32,
  pub parent: u32,
  pub depth: u32,
  pub children: u32,
  /// What devtools prints for an element: the role (or the kind), the accessible name in
  /// quotes, and the test id in brackets: `button "Add"`, `box [items]`, `text "Buy milk"`.
  pub label: String,
  /// The id and the size: `#12  64 × 28`.
  pub detail: String,
  /// Whether no collapsed ancestor hides it.
  pub visible: bool,
}

/// The four sides of one box of the box model, in CSS pixels.
pub struct Sides {
  pub top: f32,
  pub right: f32,
  pub bottom: f32,
  pub left: f32,
}

impl Copy for Sides {}

/// The box model of a node's first fragment: margin, border and padding widths around the
/// content box.
pub struct BoxNumbers {
  pub margin: Sides,
  pub border: Sides,
  pub padding: Sides,
  pub width: f32,
  pub height: f32,
  pub x: f32,
  pub y: f32,
  /// How many fragments the node has (more than one for text and inline boxes split across
  /// lines; the numbers are the first one's).
  pub fragments: u32,
}

impl Copy for BoxNumbers {}

/// The inspected node.
pub struct Detail {
  /// The node, or NO_PARENT when nothing is inspected.
  pub id: u32,
  /// The row label of the node.
  pub title: String,
  /// The devtools node view (`inspect`'s text), one entry per line.
  pub lines: List<String>,
  /// Whether the node has a box (`box` holds its numbers).
  pub hasBox: bool,
  pub box: BoxNumbers,
}

/// One record of the event log.
pub struct LogRow {
  pub seq: u64,
  pub target: u32,
  /// `click`, `keydown`, ...
  pub kind: String,
  /// The rest: target, key or value, and position.
  pub text: String,
}

/// One frame stat.
pub struct Stat {
  pub name: String,
  pub value: String,
}

/// One message the program handled.
pub struct StepRow {
  pub seq: u64,
  /// What sent the message: `click #12`, `timer`, `command Save`.
  pub cause: String,
  pub message: String,
  /// The commands update returned, joined with commas.
  pub commands: String,
  /// Whether the step left the model different.
  pub changed: bool,
}

/// A line of a model that the step kept.
pub const KEPT: u8 = 0

/// A line of a model that the step added.
pub const ADDED: u8 = 1

/// A line the model before the step had and the one after it has not.
pub const REMOVED: u8 = 2

/// One line of a model against the model before it.
pub struct DiffLine {
  /// [`KEPT`], [`ADDED`] or [`REMOVED`].
  pub op: u8,
  pub text: String,
}

/// The model after one step, as a diff against the model before.
pub struct ModelView {
  /// The step, or 0 when none is open.
  pub seq: u64,
  pub lines: List<DiffLine>,
  /// How many lines the step added or removed.
  pub changed: u64,
}

/// What the program panel shows besides the messages.
pub struct ProgramView {
  /// Whether the app reports a program at all.
  pub attached: bool,
  /// The counters in one line.
  pub line: String,
  pub subscriptions: List<String>,
}

/// One frame of the timeline.
pub struct FrameBar {
  pub frame: u64,
  /// Milliseconds in layout and in paint; both zero when the host does not time frames.
  pub layout: f32,
  pub paint: f32,
  pub fragments: f32,
  pub skipped: bool,
}

impl Copy for FrameBar {}

/// The frame timeline.
pub struct FrameView {
  pub bars: List<FrameBar>,
  /// The summary under the bars.
  pub line: String,
  /// Whether the host times its frames; without it the bars show painted fragments.
  pub timed: bool,
  /// The value a full-height bar stands for: milliseconds when timed, fragments otherwise.
  pub scale: f32,
}

/// One finding of the audit.
pub struct Issue {
  /// `unnamed`, `no-role`, `not-focusable`, `small-target` or `contrast`.
  pub rule: String,
  pub message: String,
  pub node: u32,
  /// The row label of the node.
  pub label: String,
}

/// The parts of a [`Snapshot`] that were read: a refresh after a notification reads only what
/// it says changed.
pub const PART_STATUS: u32 = 1

pub const PART_ROWS: u32 = 2

pub const PART_STATS: u32 = 4

pub const PART_EVENTS: u32 = 8

pub const PART_DETAIL: u32 = 16

pub const PART_STEPS: u32 = 32

pub const PART_PICK: u32 = 64

/// Every part: a whole refresh.
pub const PART_ALL: u32 = 127

/// What one refresh read from the app.
pub struct Snapshot {
  /// What was read, as `PART_*` bits; the program and frames are there when they are Some.
  pub parts: u32,
  pub status: String,
  pub rows: List<Row>,
  pub stats: List<Stat>,
  pub events: List<LogRow>,
  /// The `seq` the next event record will get.
  pub next: u64,
  /// The inspected node again, when one was selected and still exists.
  pub detail: Option<Detail>,
  /// The program's messages after the last one read.
  pub steps: List<StepRow>,
  /// The `seq` the next message will get.
  pub stepNext: u64,
  /// The program panel's header, when it was asked for.
  pub program: Option<ProgramView>,
  /// The timeline, when it was asked for.
  pub frames: Option<FrameView>,
  /// Whether the app is still waiting for a pick.
  pub picking: bool,
  /// The node picked in the app's window, or NO_PARENT.
  pub picked: u32,
}

/// How long a frame may take at 60 frames a second, in milliseconds.
pub const FRAME_BUDGET: f32 = 16.7

fn zeroSides() -> Sides {
  return Sides { top: 0.0, right: 0.0, bottom: 0.0, left: 0.0 }
}

impl BoxNumbers {
  pub fn zero() -> BoxNumbers {
    return BoxNumbers {
      margin: zeroSides(),
      border: zeroSides(),
      padding: zeroSides(),
      width: 0.0,
      height: 0.0,
      x: 0.0,
      y: 0.0,
      fragments: 0,
    }
  }
}

impl ModelView {
  /// No step open.
  pub fn none() -> ModelView {
    return ModelView { seq: 0, lines: List<DiffLine>.make(), changed: 0 }
  }
}

impl FrameView {
  pub fn none() -> FrameView {
    return FrameView { bars: List<FrameBar>.make(), line: String.make(), timed: false, scale: 1.0 }
  }
}

impl Detail {
  /// Nothing inspected.
  pub fn none() -> Detail {
    return Detail {
      id: NO_PARENT,
      title: String.make(),
      lines: List<String>.make(),
      hasBox: false,
      box: BoxNumbers.zero(),
    }
  }
}

/// The elements of array `value`, or None when it is not an array.
fn items<'a>(value: Option<&'a Value>) -> Option<&'a List<Value>> {
  return match value {
    Option<&Value>.Some { value: v } => match &v.* {
      Value.Array { values } => Option<&List<Value>>.Some { value: &values }
      _ => Option<&List<Value>>.None
    }
    Option<&Value>.None => Option<&List<Value>>.None
  }
}

fn u32Field(value: &Value, key: string, fallback: u32) -> u32 {
  return match idField(value, key) {
    Option<u32>.Some { value: n } => n
    Option<u32>.None => fallback
  }
}

fn u64Field(value: &Value, key: string) -> u64 {
  return match Json.asU64(Json.field(value, key)) {
    Option<u64>.Some { value: n } => n
    Option<u64>.None => 0
  }
}

/// `text` cut to at most `limit` bytes at a character boundary, with an ellipsis when cut.
effect fn appendCut(out: &mut String, text: string, limit: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if String.byteLength(text) <= limit {
    run out.append(text)
    return ()
  }
  let mut end = limit
  while end > 0 && !String.isCharBoundary(text, end) {
    end = end - 1
  }
  run out.append(String.slice(text, 0, end))
  run out.append("...")
}

/// The row label of node object `node`.
pub effect fn labelOf(node: &Value, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let roleText = textField(node, "role")
  if roleText != "" {
    run out.append(roleText)
  } else {
    run out.append(textField(node, "kind"))
  }
  let name = textField(node, "name")
  if name != "" {
    run out.append(" \"")
    run appendCut(&mut out, name, NAME_LIMIT)
    run out.append("\"")
  }
  let testId = textField(node, "testId")
  if testId != "" {
    run out.append(" [")
    run out.append(testId)
    run out.append("]")
  }
}

/// Writes `value` with at most one decimal, as devtools prints box sizes.
pub effect fn writeSize(out: &mut String, value: f32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let tenths = f32.floor(value * 10.0 + 0.5) / 10.0
  run writeNumber(&mut out, tenths)
}

/// The rows of a `tree` reply, in tree order.
pub effect fn parseTree(reply: &Value, out: &mut List<Row>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  out.clear()
  let array = match items(Json.field(reply, "nodes")) {
    Option<&List<Value>>.Some { value } => value
    Option<&List<Value>>.None => {
      return ()
    }
  }
  let list = array.asSlice()
  let mut i: usize = 0
  while i < list.length {
    let node = &list[i]
    let mut label = String.make()
    run labelOf(node, &mut label)
    let mut detail = run String.copy("#")
    let id = u32Field(node, "id", 0)
    run writeInt(&mut detail, u32.toU64(id))
    if has(node, "width") {
      run detail.append("  ")
      run writeSize(&mut detail, numberField(node, "width", 0.0))
      run detail.append(" × ")
      run writeSize(&mut detail, numberField(node, "height", 0.0))
    }
    run out.append(
      Row {
        id: id,
        parent: u32Field(node, "parent", NO_PARENT),
        depth: u32Field(node, "depth", 0),
        children: u32Field(node, "children", 0),
        label: move label,
        detail: move detail,
        visible: true,
      },
    )
    i = i + 1
  }
}

fn rectOf(box: &Value, key: string) -> [f32; 4] {
  return match Json.field(box, key) {
    Option<&Value>.Some { value: r } => [
      numberField(r, "x", 0.0),
      numberField(r, "y", 0.0),
      numberField(r, "width", 0.0),
      numberField(r, "height", 0.0),
    ]
    Option<&Value>.None => [0.0, 0.0, 0.0, 0.0]
  }
}

/// The widths between rect `outer` and rect `inner` (x, y, width, height).
fn between(outer: [f32; 4], inner: [f32; 4]) -> Sides {
  return Sides {
    top: inner[1] - outer[1],
    right: outer[0] + outer[2] - (inner[0] + inner[2]),
    bottom: outer[1] + outer[3] - (inner[1] + inner[3]),
    left: inner[0] - outer[0],
  }
}

/// The inspected node out of an `inspect` reply.
pub effect fn parseDetail(reply: &Value) -> Detail
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut detail = Detail.none()
  match Json.field(reply, "node") {
    Option<&Value>.Some { value: node } => {
      detail.id = u32Field(node, "id", NO_PARENT)
      run labelOf(node, &mut detail.title)
    }
    Option<&Value>.None => {}
  }
  let text = textField(reply, "text")
  let mut lines = String.split(text, "\n")
  while true {
    match lines.next() {
      Option<string>.Some { value: line } => {
        if line != "" {
          run detail.lines.append(run String.copy(line))
        }
      }
      Option<string>.None => {
        break
      }
    }
  }
  match Json.field(reply, "box") {
    Option<&Value>.Some { value: box } => {
      let margin = rectOf(box, "margin")
      let border = rectOf(box, "border")
      let padding = rectOf(box, "padding")
      let content = rectOf(box, "content")
      detail.hasBox = true
      detail.box = BoxNumbers {
        margin: between(margin, border),
        border: between(border, padding),
        padding: between(padding, content),
        width: content[2],
        height: content[3],
        x: border[0],
        y: border[1],
        fragments: u32Field(box, "fragments", 1),
      }
    }
    Option<&Value>.None => {}
  }
  return move detail
}

/// The records of an `events` reply, appended to `out` oldest first. Returns the reply's `next`.
pub effect fn parseEvents(reply: &Value, out: &mut List<LogRow>) -> u64
  ! OutOfMemoryError
  ? &mut Allocator {
  let array = match items(Json.field(reply, "events")) {
    Option<&List<Value>>.Some { value } => value
    Option<&List<Value>>.None => {
      return u64Field(reply, "next")
    }
  }
  let list = array.asSlice()
  let mut i: usize = 0
  while i < list.length {
    let e = &list[i]
    let target = u32Field(e, "target", NO_PARENT)
    let mut text = run String.copy("#")
    run writeInt(&mut text, u32.toU64(target))
    let key = textField(e, "key")
    if key != "" {
      run text.append("  key ")
      run text.append(key)
    }
    if has(e, "value") {
      run text.append("  value \"")
      run appendCut(&mut text, textField(e, "value"), NAME_LIMIT)
      run text.append("\"")
    }
    if has(e, "x") {
      run text.append("  at ")
      run writeSize(&mut text, numberField(e, "x", 0.0))
      run text.append(", ")
      run writeSize(&mut text, numberField(e, "y", 0.0))
    }
    run out.append(
      LogRow {
        seq: u64Field(e, "seq"),
        target: target,
        kind: run String.copy(textField(e, "kind")),
        text: move text,
      },
    )
    i = i + 1
  }
  return u64Field(reply, "next")
}

/// Appends `name` and the value of JSON `value` (numbers in their shortest form, flags as yes or no).
effect fn addStat(out: &mut List<Stat>, name: string, value: &Value) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = String.make()
  match &value.* {
    Value.Number { value: number } => {
      run appendNumber(&mut text, &number)
    }
    Value.Bool { value: b } => {
      run text.append(
        if b {
          "yes"
        } else {
          "no"
        },
      )
    }
    Value.String { text: s } => {
      run text.append(String.view(&s))
    }
    _ => {
      return ()
    }
  }
  run out.append(Stat { name: run String.copy(name), value: move text })
}

/// The stats of a `stats` reply in reply order; nested objects (`layout`) give `layout passes`
/// and so on.
pub effect fn parseStats(reply: &Value, out: &mut List<Stat>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  out.clear()
  match &reply.* {
    Value.Object { entries } => {
      let members = entries.asSlice()
      let mut i: usize = 0
      while i < members.length {
        let entry = &members[i]
        let key = String.view(&entry.key)
        if key != "ok" && key != "id" {
          match &entry.value {
            Value.Object { entries: inner } => {
              let nested = inner.asSlice()
              let mut j: usize = 0
              while j < nested.length {
                let sub = &nested[j]
                let mut name = run String.copy(key)
                run name.append(" ")
                run name.append(String.view(&sub.key))
                run addStat(&mut out, String.view(&name), &sub.value)
                j = j + 1
              }
            }
            _ => {
              run addStat(&mut out, key, &entry.value)
            }
          }
        }
        i = i + 1
      }
    }
    _ => {}
  }
}

/// The status line out of a `hello` reply: frame, viewport and node count.
pub effect fn parseStatus(reply: &Value, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  out.clear()
  run out.append("frame ")
  run writeInt(&mut out, u64Field(reply, "frame"))
  run out.append("  ·  ")
  run writeSize(&mut out, numberField(reply, "width", 0.0))
  run out.append(" × ")
  run writeSize(&mut out, numberField(reply, "height", 0.0))
  run out.append(" @")
  run writeSize(&mut out, numberField(reply, "scale", 1.0))
  run out.append("x  ·  ")
  run writeInt(&mut out, u64Field(reply, "nodes"))
  run out.append(" nodes")
}

/// The strings of array `value` joined with `, `.
effect fn joined(value: Option<&Value>, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match items(value) {
    Option<&List<Value>>.Some { value: array } => {
      let list = array.asSlice()
      let mut i: usize = 0
      while i < list.length {
        match &list[i] {
          Value.String { text } => {
            if out.ownedByteLength() != 0 {
              run out.append(", ")
            }
            run out.append(String.view(&text))
          }
          _ => {}
        }
        i = i + 1
      }
    }
    Option<&List<Value>>.None => {}
  }
}

/// The steps of a `messages` reply, appended to `out` oldest first. Returns the reply's `next`.
pub effect fn parseSteps(reply: &Value, out: &mut List<StepRow>) -> u64
  ! OutOfMemoryError
  ? &mut Allocator {
  match items(Json.field(reply, "messages")) {
    Option<&List<Value>>.Some { value: array } => {
      let list = array.asSlice()
      let mut i: usize = 0
      while i < list.length {
        let step = &list[i]
        let mut commands = String.make()
        run joined(Json.field(step, "commands"), &mut commands)
        run out.append(
          StepRow {
            seq: u64Field(step, "seq"),
            cause: run String.copy(textField(step, "cause")),
            message: run String.copy(textField(step, "message")),
            commands: move commands,
            changed: flagField(step, "changed", false),
          },
        )
        i = i + 1
      }
    }
    Option<&List<Value>>.None => {}
  }
  return u64Field(reply, "next")
}

effect fn counter(out: &mut String, stats: &Value, key: string, unit: string) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if out.ownedByteLength() != 0 {
    run out.append("  ·  ")
  }
  run writeInt(&mut out, u64Field(stats, key))
  run out.append(" ")
  run out.append(unit)
}

/// The program panel's header out of a `program` reply.
pub effect fn parseProgram(reply: &Value) -> ProgramView
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut view = ProgramView {
    attached: flagField(reply, "attached", false),
    line: String.make(),
    subscriptions: List<String>.make(),
  }
  match Json.field(reply, "stats") {
    Option<&Value>.Some { value: stats } => {
      run counter(&mut view.line, stats, "messages", "messages")
      run counter(&mut view.line, stats, "commands", "commands")
      run counter(&mut view.line, stats, "renders", "renders")
      run counter(&mut view.line, stats, "mutations", "mutations in the last")
      run counter(&mut view.line, stats, "reused", "of")
      run view.line.append(" ")
      run writeInt(&mut view.line, u64Field(stats, "nodes"))
      run view.line.append(" nodes reused")
    }
    Option<&Value>.None => {}
  }
  match items(Json.field(reply, "subscriptions")) {
    Option<&List<Value>>.Some { value: array } => {
      let list = array.asSlice()
      let mut i: usize = 0
      while i < list.length {
        match &list[i] {
          Value.String { text } => {
            run view.subscriptions.append(run String.copy(String.view(&text)))
          }
          _ => {}
        }
        i = i + 1
      }
    }
    Option<&List<Value>>.None => {}
  }
  return move view
}

/// The model of a `model` reply as diff lines.
pub effect fn parseModel(reply: &Value) -> ModelView
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut view = ModelView.none()
  view.seq = u64Field(reply, "seq")
  view.changed = u64Field(reply, "changed")
  match items(Json.field(reply, "diff")) {
    Option<&List<Value>>.Some { value: array } => {
      let list = array.asSlice()
      let mut i: usize = 0
      while i < list.length {
        let op = textField(&list[i], "op")
        run view.lines.append(
          DiffLine {
            op: if op == "+" {
              ADDED
            } else if op == "-" {
              REMOVED
            } else {
              KEPT
            },
            text: run String.copy(textField(&list[i], "line")),
          },
        )
        i = i + 1
      }
    }
    Option<&List<Value>>.None => {}
  }
  return move view
}

/// The timeline out of a `frames` reply.
pub effect fn parseFrames(reply: &Value) -> FrameView
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut view = FrameView.none()
  let mut most: f32 = 1.0
  match items(Json.field(reply, "frames")) {
    Option<&List<Value>>.Some { value: array } => {
      let list = array.asSlice()
      let mut i: usize = 0
      while i < list.length {
        let f = &list[i]
        let bar = FrameBar {
          frame: u64Field(f, "frame"),
          layout: numberField(f, "layoutMs", 0.0),
          paint: numberField(f, "paintMs", 0.0),
          fragments: numberField(f, "fragments", 0.0),
          skipped: flagField(f, "layoutSkipped", false),
        }
        if bar.fragments > most {
          most = bar.fragments
        }
        run view.bars.append(bar)
        i = i + 1
      }
    }
    Option<&List<Value>>.None => {}
  }
  let slowest = numberField(reply, "slowestMs", 0.0)
  view.timed = slowest > 0.0
  run writeInt(&mut view.line, usize.toU64(view.bars.length()))
  run view.line.append(" frames  ·  ")
  if view.timed {
    view.scale = if slowest > FRAME_BUDGET {
      slowest
    } else {
      FRAME_BUDGET
    }
    run view.line.append("slowest ")
    run writeNumber(&mut view.line, f32.floor(slowest * 100.0 + 0.5) / 100.0)
    run view.line.append(" ms  ·  average ")
    run writeNumber(
      &mut view.line,
      f32.floor(numberField(reply, "averageMs", 0.0) * 100.0 + 0.5) / 100.0,
    )
    run view.line.append(" ms  ·  the full height is ")
    run writeSize(&mut view.line, view.scale)
    run view.line.append(" ms")
  } else {
    view.scale = most
    run view.line.append("this host does not time frames, the bars are painted fragments (most ")
    run writeSize(&mut view.line, most)
    run view.line.append(")")
  }
  return move view
}

/// The issues of an `audit` reply; `line` gets the summary.
pub effect fn parseIssues(reply: &Value, out: &mut List<Issue>, line: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  out.clear()
  line.clear()
  match items(Json.field(reply, "issues")) {
    Option<&List<Value>>.Some { value: array } => {
      let list = array.asSlice()
      let mut i: usize = 0
      while i < list.length {
        let issue = &list[i]
        let mut label = String.make()
        let mut id = NO_PARENT
        match Json.field(issue, "node") {
          Option<&Value>.Some { value: node } => {
            id = u32Field(node, "id", NO_PARENT)
            run labelOf(node, &mut label)
          }
          Option<&Value>.None => {}
        }
        run out.append(
          Issue {
            rule: run String.copy(textField(issue, "rule")),
            message: run String.copy(textField(issue, "message")),
            node: id,
            label: move label,
          },
        )
        i = i + 1
      }
    }
    Option<&List<Value>>.None => {}
  }
  let count = u64Field(reply, "count")
  if count == 0 {
    run line.append("No issues")
  } else {
    run writeInt(&mut line, count)
    run line.append(
      if count == 1 {
        " issue"
      } else {
        " issues"
      },
    )
  }
  run line.append(" in ")
  run writeInt(&mut line, u64Field(reply, "checked"))
  run line.append(" nodes")
}

fn lower(byte: u8) -> u8 {
  if byte >= 65 && byte <= 90 {
    return byte + 32
  }
  return byte
}

/// Whether `text` contains `wanted`, ASCII letters compared without case.
pub fn matches(text: string, wanted: string) -> bool {
  let a = String.utf8Bytes(text)
  let b = String.utf8Bytes(wanted)
  let mut at: usize = 0
  while at + b.length <= a.length {
    let mut i: usize = 0
    while i < b.length && lower(a[at + i]) == lower(b[i]) {
      i = i + 1
    }
    if i == b.length {
      return true
    }
    at = at + 1
  }
  return false
}
