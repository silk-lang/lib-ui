//! What the devtools window shows, read out of the inspector protocol's JSON replies: the
//! element tree (`tree`), a node's view and box model (`inspect`), the event log (`events`), the
//! frame stats (`stats`), the status line and the app's extensions (`hello`), the frame timeline
//! (`frames`), the audit (`audit`), the edit log (`edits`) and an extension panel's data (its
//! command's reply).
//! Display text is made here, once per reply, so the view only lays it out.
import ui_inspect_server.reply { appendNumber, textField, numberField, idField, flagField, has }
import ui_tree.inspect { writeInt, writeNumber }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.json.value { Json, Value }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.text.string { String, InvalidUtf8 }
import silk.num.u8
import properties.catalog

/// The parent of the top row.
pub const NO_PARENT: u32 = 4294967295

/// The longest accessible name a row shows, in bytes; longer names are cut at a character.
const NAME_LIMIT: usize = 48

/// One node of the element tree.
pub struct Row {
  pub id: u32,
  pub parent: u32,
  pub depth: u32,
  pub children: u32,
  /// What devtools prints for an element: the role (or the kind), the accessible name in
  /// quotes, and the test id in brackets: `button "Add"`, `box [items]`, `text "Buy milk"`.
  pub label: String,
  /// The id and the size: `#12  64 × 28`.
  pub detail: String,
  /// The label in the parts the row draws: the role or kind (`button`), the rest (`"Add"
  /// [add]`), and the size (`64×28`, empty without a box).
  pub kind: String,
  pub name: String,
  pub size: String,
  /// Whether no collapsed ancestor hides it.
  pub visible: bool,
}

/// The four sides of one box of the box model, in CSS pixels.
pub struct Sides {
  pub top: f32,
  pub right: f32,
  pub bottom: f32,
  pub left: f32,
}

impl Copy for Sides {}

/// The box model of a node's first fragment: margin, border and padding widths around the
/// content box.
pub struct BoxNumbers {
  pub margin: Sides,
  pub border: Sides,
  pub padding: Sides,
  pub width: f32,
  pub height: f32,
  pub x: f32,
  pub y: f32,
  /// How many fragments the node has (more than one for text and inline boxes split across
  /// lines; the numbers are the first one's).
  pub fragments: u32,
}

impl Copy for BoxNumbers {}

/// The inspected node.
pub struct Detail {
  /// The node, or NO_PARENT when nothing is inspected.
  pub id: u32,
  /// The row label of the node.
  pub title: String,
  /// The devtools node view (`inspect`'s text), one entry per line.
  pub lines: List<String>,
  /// What each of `lines` is in the node's styles: [`MARK_PLAIN`], [`MARK_EDITED`],
  /// [`MARK_OVERRIDDEN`] or [`MARK_EDIT_HEAD`].
  pub marks: List<u8>,
  /// Whether the node has a box (`box` holds its numbers).
  pub hasBox: bool,
  pub box: BoxNumbers,
}

/// One record of the event log.
pub struct LogRow {
  pub seq: u64,
  pub target: u32,
  /// `click`, `keydown`, ...
  pub kind: String,
  /// The rest: target, key or value, and position.
  pub text: String,
}

/// One frame stat.
pub struct Stat {
  pub name: String,
  pub value: String,
}

/// One frame of the timeline.
pub struct FrameBar {
  pub frame: u64,
  /// Milliseconds in layout and in paint; both zero when the host does not time frames.
  pub layout: f32,
  pub paint: f32,
  pub fragments: f32,
  pub skipped: bool,
}

impl Copy for FrameBar {}

/// The frame timeline.
pub struct FrameView {
  pub bars: List<FrameBar>,
  /// The summary under the bars.
  pub line: String,
  /// Whether the host times its frames; without it the bars show painted fragments.
  pub timed: bool,
  /// The value a full-height bar stands for: milliseconds when timed, fragments otherwise.
  pub scale: f32,
}

/// One finding of the audit.
pub struct Issue {
  /// `unnamed`, `no-role`, `not-focusable`, `small-target` or `contrast`.
  pub rule: String,
  pub message: String,
  pub node: u32,
  /// The row label of the node.
  pub label: String,
}

/// The parts of a [`Snapshot`] that were read: a refresh after a notification reads only what
/// it says changed.
pub const PART_STATUS: u32 = 1

pub const PART_ROWS: u32 = 2

pub const PART_STATS: u32 = 4

pub const PART_EVENTS: u32 = 8

pub const PART_DETAIL: u32 = 16

pub const PART_PICK: u32 = 32

/// Every part: a whole refresh.
/// The edit log.
pub const PART_EDITS: u32 = 64

pub const PART_ALL: u32 = 127

/// A panel an extension of the app adds (`hello`'s `extensions`), names in full.
pub struct PanelInfo {
  /// The extension's id.
  pub extension: String,
  pub id: String,
  pub title: String,
  /// The command whose reply is the panel's data, `<extension>.<command>`, or empty.
  pub data: String,
  /// The topic that says the data changed, or empty.
  pub topic: String,
  /// The topic the panel's view renders on, or empty for a panel without one.
  pub view: String,
}

/// One line of a panel's data as the generic view shows it: a member or an element, indented
/// by depth, with its value when that is not an object or an array.
pub struct DataRow {
  pub depth: u32,
  /// The member's name, or the element's index.
  pub key: String,
  /// The value as JSON text; empty for an object or an array, whose members follow.
  pub value: String,
}

/// The most rows the generic view shows of a panel's data.
pub const DATA_LIMIT: usize = 400

/// A request sent with `Link.ask` whose reply did not come yet, and what it is for.
pub struct Asked {
  pub id: u64,
  /// `ASK_*`.
  pub purpose: u32,
  /// The panel, for `ASK_DATA`.
  pub index: usize,
}

impl Copy for Asked {}

/// An extension panel's data.
pub const ASK_DATA: u32 = 1

/// What the top bar says about the app: its protocol, its open roots and which one is shown,
/// the frame, the node count and the viewport. Zero for what was not read.
pub struct AppInfo {
  pub protocol: u64,
  /// The open roots, and the root the element tree shows.
  pub roots: u64,
  pub root: u64,
  pub frame: u64,
  pub nodes: u64,
  pub width: f32,
  pub height: f32,
}

impl Copy for AppInfo {}

impl AppInfo {
  pub fn none() -> AppInfo {
    return AppInfo { protocol: 0, roots: 0, root: 0, frame: 0, nodes: 0, width: 0.0, height: 0.0 }
  }

  /// Takes what `newer` read (its members that are not zero).
  pub fn take(self: &mut Self, newer: AppInfo) -> () {
    if newer.protocol != 0 {
      self.protocol = newer.protocol
    }
    if newer.roots != 0 {
      self.roots = newer.roots
      self.root = newer.root
    }
    if newer.frame != 0 {
      self.frame = newer.frame
    }
    if newer.nodes != 0 {
      self.nodes = newer.nodes
    }
    if newer.width != 0.0 {
      self.width = newer.width
      self.height = newer.height
    }
  }
}

/// What a `hello` reply or a notification says about the app.
pub fn readInfo(reply: &Value) -> AppInfo {
  let mut info = AppInfo.none()
  info.protocol = u64Field(reply, "protocol")
  info.frame = u64Field(reply, "frame")
  info.nodes = u64Field(reply, "nodes")
  info.width = numberField(reply, "width", 0.0)
  info.height = numberField(reply, "height", 0.0)
  if let Option<&List<Value>>.Some { value: roots } = items(Json.field(reply, "roots")) {
    info.roots = usize.toU64(roots.length())
    info.root = u64Field(reply, "root")
  }
  return info
}

/// What one refresh read from the app.
pub struct Snapshot {
  /// What was read, as `PART_*` bits; the frames are there when they are Some.
  pub parts: u32,
  pub status: String,
  /// The facts of the top bar, with `PART_STATUS`.
  pub info: AppInfo,
  pub rows: List<Row>,
  pub stats: List<Stat>,
  pub events: List<LogRow>,
  /// The `seq` the next event record will get.
  pub next: u64,
  /// The inspected node again, when one was selected and still exists.
  pub detail: Option<Detail>,
  /// The extensions' ids and panels, when `hello` was read.
  pub extensions: Option<List<String>>,
  pub panels: List<PanelInfo>,
  /// The extension topics that changed, by name.
  pub news: List<String>,
  /// Replies to requests sent with `Link.ask`, as they came.
  pub replies: List<String>,
  /// The timeline, when it was asked for.
  pub frames: Option<FrameView>,
  /// Whether the app is still waiting for a pick.
  pub picking: bool,
  /// The node picked in the app's window, or NO_PARENT.
  pub picked: u32,
  /// The edit log, with `PART_EDITS`, and how many of its entries are open.
  pub changes: List<ChangeRow>,
  pub openChanges: usize,
}

/// How long a frame may take at 60 frames a second, in milliseconds.
pub const FRAME_BUDGET: f32 = 16.7

fn zeroSides() -> Sides {
  return Sides { top: 0.0, right: 0.0, bottom: 0.0, left: 0.0 }
}

impl BoxNumbers {
  pub fn zero() -> BoxNumbers {
    return BoxNumbers {
      margin: zeroSides(),
      border: zeroSides(),
      padding: zeroSides(),
      width: 0.0,
      height: 0.0,
      x: 0.0,
      y: 0.0,
      fragments: 0,
    }
  }
}

impl FrameView {
  pub fn none() -> FrameView {
    return FrameView { bars: List<FrameBar>.make(), line: String.make(), timed: false, scale: 1.0 }
  }
}

impl Detail {
  /// Nothing inspected.
  pub fn none() -> Detail {
    return Detail {
      id: NO_PARENT,
      title: String.make(),
      lines: List<String>.make(),
      marks: List<u8>.make(),
      hasBox: false,
      box: BoxNumbers.zero(),
    }
  }
}

/// The elements of array `value`, or None when it is not an array.
fn items<'a>(value: Option<&'a Value>) -> Option<&'a List<Value>> {
  return match value {
    Option<&Value>.Some { value: v } => match &v.* {
      Value.Array { values } => Option<&List<Value>>.Some { value: &values }
      _ => Option<&List<Value>>.None
    }
    Option<&Value>.None => Option<&List<Value>>.None
  }
}

fn u32Field(value: &Value, key: string, fallback: u32) -> u32 {
  return match idField(value, key) {
    Option<u32>.Some { value: n } => n
    Option<u32>.None => fallback
  }
}

fn u64Field(value: &Value, key: string) -> u64 {
  return match Json.asU64(Json.field(value, key)) {
    Option<u64>.Some { value: n } => n
    Option<u64>.None => 0
  }
}

/// `text` cut to at most `limit` bytes at a character boundary, with an ellipsis when cut.
effect fn appendCut(out: &mut String, text: string, limit: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if String.byteLength(text) <= limit {
    run out.append(text)
    return ()
  }
  let mut end = limit
  while end > 0 && !String.isCharBoundary(text, end) {
    end = end - 1
  }
  run out.append(String.slice(text, 0, end))
  run out.append("...")
}

/// What a row leads with: node object `node`'s role, or its kind.
pub fn kindOf(node: &Value) -> string {
  let roleText = textField(node, "role")
  if roleText != "" {
    return roleText
  }
  return textField(node, "kind")
}

/// The row label of node object `node`.
pub effect fn labelOf(node: &Value, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run out.append(kindOf(node))
  let name = textField(node, "name")
  if name != "" {
    run out.append(" \"")
    run appendCut(&mut out, name, NAME_LIMIT)
    run out.append("\"")
  }
  let testId = textField(node, "testId")
  if testId != "" {
    run out.append(" [")
    run out.append(testId)
    run out.append("]")
  }
}

/// Writes `value` with at most one decimal, as devtools prints box sizes.
pub effect fn writeSize(out: &mut String, value: f32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let tenths = f32.floor(value * 10.0 + 0.5) / 10.0
  run writeNumber(&mut out, tenths)
}

/// The rows of a `tree` reply, in tree order.
pub effect fn parseTree(reply: &Value, out: &mut List<Row>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  out.clear()
  let array = match items(Json.field(reply, "nodes")) {
    Option<&List<Value>>.Some { value } => value
    Option<&List<Value>>.None => {
      return ()
    }
  }
  let list = array.asSlice()
  let mut i: usize = 0
  while i < list.length {
    let node = &list[i]
    let mut label = String.make()
    run labelOf(node, &mut label)
    let mut detail = run String.copy("#")
    let id = u32Field(node, "id", 0)
    run writeInt(&mut detail, u32.toU64(id))
    let mut size = String.make()
    if has(node, "width") {
      run detail.append("  ")
      run writeSize(&mut detail, numberField(node, "width", 0.0))
      run detail.append(" × ")
      run writeSize(&mut detail, numberField(node, "height", 0.0))
      run writeSize(&mut size, numberField(node, "width", 0.0))
      run size.append("×")
      run writeSize(&mut size, numberField(node, "height", 0.0))
    }
    let kind = run String.copy(kindOf(node))
    let name = run String.copy(
      String.slice(
        String.view(&label),
        kind.ownedByteLength(),
        label.ownedByteLength() - kind.ownedByteLength(),
      ),
    )
    run out.append(
      Row {
        id: id,
        parent: u32Field(node, "parent", NO_PARENT),
        depth: u32Field(node, "depth", 0),
        children: u32Field(node, "children", 0),
        label: move label,
        detail: move detail,
        kind: move kind,
        name: move name,
        size: move size,
        visible: true,
      },
    )
    i = i + 1
  }
}

fn rectOf(box: &Value, key: string) -> [f32; 4] {
  return match Json.field(box, key) {
    Option<&Value>.Some { value: r } => [
      numberField(r, "x", 0.0),
      numberField(r, "y", 0.0),
      numberField(r, "width", 0.0),
      numberField(r, "height", 0.0),
    ]
    Option<&Value>.None => [0.0, 0.0, 0.0, 0.0]
  }
}

/// The widths between rect `outer` and rect `inner` (x, y, width, height).
fn between(outer: [f32; 4], inner: [f32; 4]) -> Sides {
  return Sides {
    top: inner[1] - outer[1],
    right: outer[0] + outer[2] - (inner[0] + inner[2]),
    bottom: outer[1] + outer[3] - (inner[1] + inner[3]),
    left: inner[0] - outer[0],
  }
}

/// The inspected node out of an `inspect` reply.
pub effect fn parseDetail(reply: &Value) -> Detail
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut detail = Detail.none()
  match Json.field(reply, "node") {
    Option<&Value>.Some { value: node } => {
      detail.id = u32Field(node, "id", NO_PARENT)
      run labelOf(node, &mut detail.title)
    }
    Option<&Value>.None => {}
  }
  let text = textField(reply, "text")
  let mut lines = String.split(text, "\n")
  let mut edited = false
  while true {
    match lines.next() {
      Option<string>.Some { value: line } => {
        if line != "" {
          let mut mark = MARK_PLAIN
          let mut shown = line
          if String.startsWith(line, "style ") {
            edited = String.contains(line, " edited")
            if edited {
              mark = MARK_EDIT_HEAD
            }
          } else if line == "}" {
            edited = false
          } else if edited {
            mark = MARK_EDITED
          } else if String.endsWith(line, OVERRIDDEN) {
            mark = MARK_OVERRIDDEN
            shown = String.slice(line, 0, String.byteLength(line) - String.byteLength(OVERRIDDEN))
          }
          run detail.lines.append(run String.copy(shown))
          run detail.marks.append(mark)
        }
      }
      Option<string>.None => {
        break
      }
    }
  }
  match Json.field(reply, "box") {
    Option<&Value>.Some { value: box } => {
      let margin = rectOf(box, "margin")
      let border = rectOf(box, "border")
      let padding = rectOf(box, "padding")
      let content = rectOf(box, "content")
      detail.hasBox = true
      detail.box = BoxNumbers {
        margin: between(margin, border),
        border: between(border, padding),
        padding: between(padding, content),
        width: content[2],
        height: content[3],
        x: border[0],
        y: border[1],
        fragments: u32Field(box, "fragments", 1),
      }
    }
    Option<&Value>.None => {}
  }
  return move detail
}

/// The records of an `events` reply, appended to `out` oldest first. Returns the reply's `next`.
pub effect fn parseEvents(reply: &Value, out: &mut List<LogRow>) -> u64
  ! OutOfMemoryError
  ? &mut Allocator {
  let array = match items(Json.field(reply, "events")) {
    Option<&List<Value>>.Some { value } => value
    Option<&List<Value>>.None => {
      return u64Field(reply, "next")
    }
  }
  let list = array.asSlice()
  let mut i: usize = 0
  while i < list.length {
    let e = &list[i]
    let target = u32Field(e, "target", NO_PARENT)
    let mut text = run String.copy("#")
    run writeInt(&mut text, u32.toU64(target))
    let key = textField(e, "key")
    if key != "" {
      run text.append("  key ")
      run text.append(key)
    }
    if has(e, "value") {
      run text.append("  value \"")
      run appendCut(&mut text, textField(e, "value"), NAME_LIMIT)
      run text.append("\"")
    }
    if has(e, "x") {
      run text.append("  at ")
      run writeSize(&mut text, numberField(e, "x", 0.0))
      run text.append(", ")
      run writeSize(&mut text, numberField(e, "y", 0.0))
    }
    run out.append(
      LogRow {
        seq: u64Field(e, "seq"),
        target: target,
        kind: run String.copy(textField(e, "kind")),
        text: move text,
      },
    )
    i = i + 1
  }
  return u64Field(reply, "next")
}

/// Appends `name` and the value of JSON `value` (numbers in their shortest form, flags as yes or no).
effect fn addStat(out: &mut List<Stat>, name: string, value: &Value) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = String.make()
  match &value.* {
    Value.Number { value: number } => {
      run appendNumber(&mut text, &number)
    }
    Value.Bool { value: b } => {
      run text.append(
        if b {
          "yes"
        } else {
          "no"
        },
      )
    }
    Value.String { text: s } => {
      run text.append(String.view(&s))
    }
    _ => {
      return ()
    }
  }
  run out.append(Stat { name: run String.copy(name), value: move text })
}

/// The stats of a `stats` reply in reply order; nested objects (`layout`) give `layout passes`
/// and so on.
pub effect fn parseStats(reply: &Value, out: &mut List<Stat>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  out.clear()
  match &reply.* {
    Value.Object { entries } => {
      let members = entries.asSlice()
      let mut i: usize = 0
      while i < members.length {
        let entry = &members[i]
        let key = String.view(&entry.key)
        if key != "ok" && key != "id" {
          match &entry.value {
            Value.Object { entries: inner } => {
              let nested = inner.asSlice()
              let mut j: usize = 0
              while j < nested.length {
                let sub = &nested[j]
                let mut name = run String.copy(key)
                run name.append(" ")
                run name.append(String.view(&sub.key))
                run addStat(&mut out, String.view(&name), &sub.value)
                j = j + 1
              }
            }
            _ => {
              run addStat(&mut out, key, &entry.value)
            }
          }
        }
        i = i + 1
      }
    }
    _ => {}
  }
}

/// The status line out of a `hello` reply: frame, viewport and node count.
pub effect fn parseStatus(reply: &Value, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  out.clear()
  run out.append("frame ")
  run writeInt(&mut out, u64Field(reply, "frame"))
  run out.append("  ·  ")
  run writeSize(&mut out, numberField(reply, "width", 0.0))
  run out.append(" × ")
  run writeSize(&mut out, numberField(reply, "height", 0.0))
  run out.append(" @")
  run writeSize(&mut out, numberField(reply, "scale", 1.0))
  run out.append("x  ·  ")
  run writeInt(&mut out, u64Field(reply, "nodes"))
  run out.append(" nodes")
}

effect fn fullName(out: &mut String, extension: string, name: string) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if name == "" {
    return ()
  }
  run out.append(extension)
  run out.append(".")
  run out.append(name)
}

/// The extensions a `hello` reply lists: their ids into `ids`, their panels into `panels`.
pub effect fn parseExtensions(
  reply: &Value,
  ids: &mut List<String>,
  panels: &mut List<PanelInfo>,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  ids.clear()
  panels.clear()
  match items(Json.field(reply, "extensions")) {
    Option<&List<Value>>.Some { value: array } => {
      let list = array.asSlice()
      let mut i: usize = 0
      while i < list.length {
        let id = textField(&list[i], "id")
        run ids.append(run String.copy(id))
        match items(Json.field(&list[i], "panels")) {
          Option<&List<Value>>.Some { value: shown } => {
            let all = shown.asSlice()
            let mut p: usize = 0
            while p < all.length {
              let panel = &all[p]
              let mut info = PanelInfo {
                extension: run String.copy(id),
                id: run String.copy(textField(panel, "id")),
                title: run String.copy(textField(panel, "title")),
                data: String.make(),
                topic: String.make(),
                view: String.make(),
              }
              run fullName(&mut info.data, id, textField(panel, "data"))
              run fullName(&mut info.topic, id, textField(panel, "topic"))
              run fullName(&mut info.view, id, textField(panel, "view"))
              run panels.append(move info)
              p = p + 1
            }
          }
          Option<&List<Value>>.None => {}
        }
        i = i + 1
      }
    }
    Option<&List<Value>>.None => {}
  }
}

/// Appends the rows of `value` at `depth`, under `key`, up to [`DATA_LIMIT`] rows.
effect fn dataRows(value: &Value, key: string, depth: u32, out: &mut List<DataRow>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if out.length() >= DATA_LIMIT {
    return ()
  }
  let mut text = String.make()
  match &value.* {
    Value.Object { entries } => {
      if key != "" {
        run out.append(DataRow { depth: depth, key: run String.copy(key), value: String.make() })
      }
      let members = entries.asSlice()
      let inner = if key == "" {
        depth
      } else {
        depth + 1
      }
      let mut i: usize = 0
      while i < members.length {
        let name = String.view(&members[i].key)
        if !(depth == 0 && key == "" && (name == "ok" || name == "id")) {
          run dataRows(&members[i].value, name, inner, &mut out)
        }
        i = i + 1
      }
      return ()
    }
    Value.Array { values } => {
      let list = values.asSlice()
      let empty = if list.length == 0 {
        run String.copy("[]")
      } else {
        String.make()
      }
      run out.append(DataRow { depth: depth, key: run String.copy(key), value: move empty })
      let mut i: usize = 0
      while i < list.length {
        let mut index = String.make()
        run writeInt(&mut index, usize.toU64(i))
        run dataRows(&list[i], String.view(&index), depth + 1, &mut out)
        i = i + 1
      }
      return ()
    }
    Value.String { text: s } => {
      run text.append("\"")
      run text.append(String.view(&s))
      run text.append("\"")
    }
    Value.Number { value: number } => {
      run appendNumber(&mut text, &number)
    }
    Value.Bool { value: b } => {
      run text.append(
        if b {
          "true"
        } else {
          "false"
        },
      )
    }
    Value.Null => {
      run text.append("null")
    }
  }
  run out.append(DataRow { depth: depth, key: run String.copy(key), value: move text })
}

/// A panel's data (the reply of its command, without `ok` and `id`) as rows for the generic
/// view: an object's members and an array's elements, nested ones indented.
pub effect fn parseData(reply: &Value, out: &mut List<DataRow>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  out.clear()
  run dataRows(reply, "", 0, &mut out)
}

/// The timeline out of a `frames` reply.
pub effect fn parseFrames(reply: &Value) -> FrameView
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut view = FrameView.none()
  let mut most: f32 = 1.0
  match items(Json.field(reply, "frames")) {
    Option<&List<Value>>.Some { value: array } => {
      let list = array.asSlice()
      let mut i: usize = 0
      while i < list.length {
        let f = &list[i]
        let bar = FrameBar {
          frame: u64Field(f, "frame"),
          layout: numberField(f, "layoutMs", 0.0),
          paint: numberField(f, "paintMs", 0.0),
          fragments: numberField(f, "fragments", 0.0),
          skipped: flagField(f, "layoutSkipped", false),
        }
        if bar.fragments > most {
          most = bar.fragments
        }
        run view.bars.append(bar)
        i = i + 1
      }
    }
    Option<&List<Value>>.None => {}
  }
  let slowest = numberField(reply, "slowestMs", 0.0)
  view.timed = slowest > 0.0
  run writeInt(&mut view.line, usize.toU64(view.bars.length()))
  run view.line.append(" frames  ·  ")
  if view.timed {
    view.scale = if slowest > FRAME_BUDGET {
      slowest
    } else {
      FRAME_BUDGET
    }
    run view.line.append("slowest ")
    run writeNumber(&mut view.line, f32.floor(slowest * 100.0 + 0.5) / 100.0)
    run view.line.append(" ms  ·  average ")
    run writeNumber(
      &mut view.line,
      f32.floor(numberField(reply, "averageMs", 0.0) * 100.0 + 0.5) / 100.0,
    )
    run view.line.append(" ms  ·  the full height is ")
    run writeSize(&mut view.line, view.scale)
    run view.line.append(" ms")
  } else {
    view.scale = most
    run view.line.append("this host does not time frames, the bars are painted fragments (most ")
    run writeSize(&mut view.line, most)
    run view.line.append(")")
  }
  return move view
}

/// The issues of an `audit` reply; `line` gets the summary.
pub effect fn parseIssues(reply: &Value, out: &mut List<Issue>, line: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  out.clear()
  line.clear()
  match items(Json.field(reply, "issues")) {
    Option<&List<Value>>.Some { value: array } => {
      let list = array.asSlice()
      let mut i: usize = 0
      while i < list.length {
        let issue = &list[i]
        let mut label = String.make()
        let mut id = NO_PARENT
        match Json.field(issue, "node") {
          Option<&Value>.Some { value: node } => {
            id = u32Field(node, "id", NO_PARENT)
            run labelOf(node, &mut label)
          }
          Option<&Value>.None => {}
        }
        run out.append(
          Issue {
            rule: run String.copy(textField(issue, "rule")),
            message: run String.copy(textField(issue, "message")),
            node: id,
            label: move label,
          },
        )
        i = i + 1
      }
    }
    Option<&List<Value>>.None => {}
  }
  let count = u64Field(reply, "count")
  if count == 0 {
    run line.append("No issues")
  } else {
    run writeInt(&mut line, count)
    run line.append(
      if count == 1 {
        " issue"
      } else {
        " issues"
      },
    )
  }
  run line.append(" in ")
  run writeInt(&mut line, u64Field(reply, "checked"))
  run line.append(" nodes")
}

fn lower(byte: u8) -> u8 {
  if byte >= 65 && byte <= 90 {
    return byte + 32
  }
  return byte
}

/// Whether `text` contains `wanted`, ASCII letters compared without case.
pub fn matches(text: string, wanted: string) -> bool {
  let a = String.utf8Bytes(text)
  let b = String.utf8Bytes(wanted)
  let mut at: usize = 0
  while at + b.length <= a.length {
    let mut i: usize = 0
    while i < b.length && lower(a[at + i]) == lower(b[i]) {
      i = i + 1
    }
    if i == b.length {
      return true
    }
    at = at + 1
  }
  return false
}

// The node view's style marks, and the edit log.

/// A line of the node view as it is.
pub const MARK_PLAIN: u8 = 0

/// A declaration of an edit laid over the client's (`style <state> edited { ... }`).
pub const MARK_EDITED: u8 = 1

/// A declaration of the client's that an edit hides.
pub const MARK_OVERRIDDEN: u8 = 2

/// The heading of an edit's section.
pub const MARK_EDIT_HEAD: u8 = 3

/// What the node view writes after a declaration of the client's that an edit hides
/// (`ui_inspect.view.OVERRIDDEN`).
const OVERRIDDEN: string = " /* overridden */"

/// One entry of the edit log, as the Changes panel shows it.
pub struct ChangeRow {
  pub id: u64,
  pub comment: bool,
  pub open: bool,
  /// An edit's declaration shows in the app now.
  pub applied: bool,
  /// The node it is about, or NO_PARENT for the app as a whole.
  pub node: u32,
  /// The node as the element rows label it (when the entry was made), or "App".
  pub label: String,
  /// An edit's state, property and values (`none` for none).
  pub state: String,
  pub property: String,
  pub before: String,
  pub after: String,
  /// A comment's text, its author, and its replies as `text (author)`.
  pub text: String,
  pub author: String,
  pub thread: List<String>,
}

effect fn valueText(entry: &Value, key: string, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let value = textField(entry, key)
  if value == "" {
    run out.append("none")
  } else {
    run out.append(value)
  }
}

effect fn changeRow(entry: &Value, comment: bool) -> ChangeRow
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut row = ChangeRow {
    id: u64Field(entry, "id"),
    comment: comment,
    open: textField(entry, "status") == "open",
    applied: flagField(entry, "applied", false),
    node: NO_PARENT,
    label: String.make(),
    state: run String.copy(textField(entry, "state")),
    property: run String.copy(textField(entry, "property")),
    before: String.make(),
    after: String.make(),
    text: run String.copy(textField(entry, "text")),
    author: run String.copy(textField(entry, "author")),
    thread: List<String>.make(),
  }
  match Json.field(entry, "target") {
    Option<&Value>.Some { value: target } => {
      row.node = u32Field(target, "node", NO_PARENT)
      match Json.field(target, "element") {
        Option<&Value>.Some { value: element } => {
          run labelOf(element, &mut row.label)
        }
        Option<&Value>.None => {
          run row.label.append("App")
        }
      }
    }
    Option<&Value>.None => {
      run row.label.append("App")
    }
  }
  if !comment {
    run valueText(entry, "before", &mut row.before)
    run valueText(entry, "after", &mut row.after)
  }
  if let Option<&List<Value>>.Some { value: replies } = items(Json.field(entry, "thread")) {
    let list = replies.asSlice()
    let mut i: usize = 0
    while i < list.length {
      let mut line = run String.copy(textField(&list[i], "text"))
      let author = textField(&list[i], "author")
      if author != "" {
        run line.append(" (")
        run line.append(author)
        run line.append(")")
      }
      run row.thread.append(move line)
      i = i + 1
    }
  }
  return move row
}

/// The entries of an `edits` reply, edits then comments, into `out`. Returns how many are open.
pub effect fn parseChanges(reply: &Value, out: &mut List<ChangeRow>) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  out.clear()
  let mut pass: usize = 0
  while pass < 2 {
    let key = if pass == 0 {
      "edits"
    } else {
      "comments"
    }
    if let Option<&List<Value>>.Some { value } = items(Json.field(reply, key)) {
      let list = value.asSlice()
      let mut i: usize = 0
      while i < list.length {
        run out.append(run changeRow(&list[i], pass == 1))
        i = i + 1
      }
    }
    pass = pass + 1
  }
  return match Json.asU64(Json.field(reply, "open")) {
    Option<u64>.Some { value } => u64.toUsize(value)
    Option<u64>.None => 0
  }
}

// The declaration editor: completion from the css package's tables, and number steps.

/// How many completions the editor offers.
pub const SUGGESTIONS: usize = 6

/// The declaration being typed: what follows the last `;` of `draft`, without leading spaces.
fn lastDeclaration(draft: string) -> usize {
  let bytes = String.utf8Bytes(draft)
  let mut start: usize = 0
  let mut i: usize = 0
  while i < bytes.length {
    if bytes[i] == 59 {
      start = i + 1
    }
    i = i + 1
  }
  while start < bytes.length && bytes[start] == 32 {
    start = start + 1
  }
  return start
}

/// Where the value of the declaration at `start` begins (after `:` and spaces), or `usize.MAX`
/// while its property is still being typed.
fn valueStart(draft: string, start: usize) -> usize {
  let bytes = String.utf8Bytes(draft)
  let mut i = start
  while i < bytes.length {
    if bytes[i] == 58 {
      let mut at = i + 1
      while at < bytes.length && bytes[at] == 32 {
        at = at + 1
      }
      return at
    }
    i = i + 1
  }
  return usize.MAX
}

/// The property of the declaration at `start` (before its `:`), trimmed.
fn propertyOf(draft: string, start: usize) -> string {
  let bytes = String.utf8Bytes(draft)
  let mut end = start
  while end < bytes.length && bytes[end] != 58 && bytes[end] != 32 {
    end = end + 1
  }
  return String.slice(draft, start, end - start)
}

/// Completions for the last declaration of `draft`: property names from the css package's
/// catalog while the property is typed, then for the value the property's initial value and
/// the CSS-wide keywords, all that start with what is typed. At most [`SUGGESTIONS`].
pub effect fn suggest(draft: string, out: &mut List<String>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  out.clear()
  let start = lastDeclaration(draft)
  let value = valueStart(draft, start)
  if value == usize.MAX {
    let typed = String.slice(draft, start, String.byteLength(draft) - start)
    if typed == "" {
      return ()
    }
    let all = catalog.all()
    let mut i: usize = 0
    while i < all.length && out.length() < SUGGESTIONS {
      if let Result<string, InvalidUtf8>.Success { value: name } = String.fromUtf8(
        catalog.name(all[i]),
      ) {
        if String.startsWith(name, typed) && name != typed && !String.startsWith(name, "-") {
          run out.append(run String.copy(name))
        }
      }
      i = i + 1
    }
    return ()
  }
  let typed = String.slice(draft, value, String.byteLength(draft) - value)
  let mut candidates = List<string>.make()
  if let Option<catalog.Property>.Some { value: property } = catalog.lookup(
    String.utf8Bytes(propertyOf(draft, start)),
  ) {
    if let Result<string, InvalidUtf8>.Success { value: initial } = String.fromUtf8(
      catalog.initial(property),
    ) {
      run candidates.append(initial)
    }
  } else {
    return ()
  }
  run candidates.append("inherit")
  run candidates.append("initial")
  run candidates.append("unset")
  let list = candidates.asSlice()
  let mut k: usize = 0
  while k < list.length && out.length() < SUGGESTIONS {
    if list[k] != "" && String.startsWith(list[k], typed) && list[k] != typed {
      run out.append(run String.copy(list[k]))
    }
    k = k + 1
  }
}

/// `draft` with what is being typed in its last declaration replaced by `chosen`, a completion
/// from [`suggest`]: a property gets its `: `.
pub effect fn complete(draft: string, chosen: string, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  out.clear()
  let start = lastDeclaration(draft)
  let value = valueStart(draft, start)
  if value == usize.MAX {
    run out.append(String.slice(draft, 0, start))
    run out.append(chosen)
    run out.append(": ")
    return ()
  }
  run out.append(String.slice(draft, 0, value))
  run out.append(chosen)
}

fn digit(b: u8) -> bool {
  return b >= 48 && b <= 57
}

/// `draft` with the last number in the value of its last declaration stepped by `by`, as the
/// arrow keys step numbers in a style editor (`padding: 4px 8px` steps the 8). False when that
/// value has no number.
pub effect fn step(draft: string, by: f32, out: &mut String) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  out.clear()
  let start = lastDeclaration(draft)
  let value = valueStart(draft, start)
  if value == usize.MAX {
    return false
  }
  let bytes = String.utf8Bytes(draft)
  let mut end = bytes.length
  while end > value && !digit(bytes[end - 1]) {
    end = end - 1
  }
  if end == value {
    return false
  }
  let mut begin = end
  while begin > value && (digit(bytes[begin - 1]) || bytes[begin - 1] == 46) {
    begin = begin - 1
  }
  let negative = begin > value && bytes[begin - 1] == 45

  // The number: digits, perhaps a point and more digits.
  let mut whole: f32 = 0.0
  let mut fraction: f32 = 0.0
  let mut scale: f32 = 1.0
  let mut point = false
  let mut i = begin
  while i < end {
    if bytes[i] == 46 {
      point = true
    } else if point {
      scale = scale / 10.0
      fraction = fraction + u8.toF32(bytes[i] - 48) * scale
    } else {
      whole = whole * 10.0 + u8.toF32(bytes[i] - 48)
    }
    i = i + 1
  }
  let mut number = whole + fraction
  if negative {
    number = -number
  }
  let stepped = f32.round((number + by) * 100.0) / 100.0
  let from = if negative {
    begin - 1
  } else {
    begin
  }
  run out.append(String.slice(draft, 0, from))
  run writeNumber(&mut out, stepped)
  run out.append(String.slice(draft, end, bytes.length - end))
  return true
}
