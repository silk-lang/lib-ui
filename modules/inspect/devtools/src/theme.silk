//! The devtools' look in one place: instrument black and amber, Geist for the interface and
//! Geist Mono for code and data, dense. Plain constants and small view helpers the panels share
//! (rows, tabs, badges, segmented controls, fields, section labels, cards, buttons, icons), so
//! every panel speaks the same language. Values are the design's ("Silk UI Devtools" in Paper).
import ui_tree.css
import ui_tree.css { px, Property, Keyword }
import ui_tree.mutation {
  Align,
  BorderStyle,
  BoxSizing,
  Overflow,
  WhiteSpace,
  TextAlign,
  CanvasCommand
}
import ui_app.ui { Ui }
import silk.color.rgba { Rgba }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.u32
import silk.text.string { String }

// The palette.

/// The ground of the columns.
pub const INK: u32 = 0x0E0E10

/// Raised surfaces: the top bar and the inspector column.
pub const SURFACE: u32 = 0x17171A

/// Rules, field borders, the selected segment and badges.
pub const LINE: u32 = 0x26262B

/// The border of popups.
pub const LINE_STRONG: u32 = 0x33333A

pub const TEXT: u32 = 0xEDEDEA

pub const MUTED: u32 = 0x8A8A90

/// Sizes, sequence numbers, hints: what is there but not read first.
pub const FAINT: u32 = 0x5C5C63

/// The amber LED: the selection, edits, the active tab, what changed.
pub const ACCENT: u32 = 0xFFB020

/// Amber text that goes with the accent (the rest of a selected row).
pub const ACCENT_DIM: u32 = 0xC99A45

/// The wash under a selected row or an added line, as alpha over the accent (0 to 255).
pub const ACCENT_WASH: u32 = 0x1F

/// The wash under the chosen completion.
pub const ACCENT_CHOSEN: u32 = 0x24

/// What the pointer is over, here and in the app.
pub const HOVER: u32 = 0x5AC8FA

pub const HOVER_WASH: u32 = 0x1A

/// Removed lines and errors.
pub const REMOVED: u32 = 0xF0857D

pub const REMOVED_WASH: u32 = 0xF05A50

// Type: sizes and line heights in CSS pixels.

pub const SIZE_SMALL: f32 = 10.0

pub const SIZE_LABEL: f32 = 11.0

pub const SIZE_BODY: f32 = 12.0

pub const SIZE_TITLE: f32 = 13.0

pub const LINE_TIGHT: f32 = 14.0

pub const LINE_BODY: f32 = 16.0

/// The line height of model text.
pub const LINE_CODE: f32 = 22.0

pub const WEIGHT_REGULAR: f32 = 400.0

pub const WEIGHT_MEDIUM: f32 = 500.0

pub const WEIGHT_STRONG: f32 = 600.0

// Sizes of the shell, in CSS pixels.

pub const TOP_BAR: f32 = 40.0

pub const TAB_BAR: f32 = 36.0

pub const TREE_ROW: f32 = 26.0

pub const LIST_ROW: f32 = 28.0

pub const SECTION_HEAD: f32 = 32.0

pub const FIELD: f32 = 28.0

/// The font families of the window that draws the devtools, as `font-family` lists.
pub const UI_FAMILIES: string = "Geist, Noto Sans, sans-serif"

pub const MONO_FAMILIES: string = "Geist Mono, Geist, Noto Sans, sans-serif"

/// The font family ids the devtools draw with: `ui` for the interface, `mono` for code and data.
pub struct Look {
  pub ui: u32,
  pub mono: u32,
}

impl Copy for Look {}

/// `0xRRGGBB`, opaque.
pub fn rgb(hex: u32) -> Rgba<f32> {
  return rgba(hex, 255)
}

/// `0xRRGGBB` with alpha `alpha` (0 to 255).
pub fn rgba(hex: u32, alpha: u32) -> Rgba<f32> {
  let r = u32.toF32(u32.bitAnd(u32.shiftRight(hex, 16), 255)) / 255.0
  let g = u32.toF32(u32.bitAnd(u32.shiftRight(hex, 8), 255)) / 255.0
  let b = u32.toF32(u32.bitAnd(hex, 255)) / 255.0
  return Rgba<f32> { r: r, g: g, b: b, a: u32.toF32(alpha) / 255.0 }
}

pub fn clear() -> Rgba<f32> {
  return Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }
}

/// Interface type on the open node: Geist at `size` on `line`.
pub fn sans<M>(ui: &mut Ui<M>, look: Look, size: f32, line: f32) -> () {
  ui.style(&[css.fontFamily(look.ui), css.fontSize(px(size)), css.lineHeight(px(line))])
}

/// Code and data type on the open node: Geist Mono at `size` on `line`.
pub fn mono<M>(ui: &mut Ui<M>, look: Look, size: f32, line: f32) -> () {
  ui.style(&[css.fontFamily(look.mono), css.fontSize(px(size)), css.lineHeight(px(line))])
}

pub fn weight<M>(ui: &mut Ui<M>, value: f32) -> () {
  ui.style(&[css.fontWeight(value)])
}

/// Padding: `block` above and below, `inline` on the sides.
pub fn pad<M>(ui: &mut Ui<M>, block: f32, inline: f32) -> () {
  ui.style(
    &[
      css.paddingTop(px(block)),
      css.paddingBottom(px(block)),
      css.paddingLeft(px(inline)),
      css.paddingRight(px(inline)),
    ],
  )
}

/// A one-pixel rule on side `side` (`Property.BorderBottomWidth` and so on) in `hex`.
pub fn rule<M>(ui: &mut Ui<M>, side: Property, hex: u32) -> () {
  ui.style(
    &[css.declare(side, px(1.0)), css.borderStyle(BorderStyle.Solid), css.borderColor(rgb(hex))],
  )
}

/// A one-pixel border all round in `hex`, with `radius`.
pub fn outline<M>(ui: &mut Ui<M>, hex: u32, radius: f32) -> () {
  ui.style(
    &[
      css.borderTopWidth(px(1.0)),
      css.borderRightWidth(px(1.0)),
      css.borderBottomWidth(px(1.0)),
      css.borderLeftWidth(px(1.0)),
      css.borderStyle(BorderStyle.Solid),
      css.borderColor(rgb(hex)),
      css.borderRadius(px(radius)),
    ],
  )
}

/// A fixed size.
pub fn size<M>(ui: &mut Ui<M>, width: f32, height: f32) -> () {
  ui.style(&[css.width(px(width)), css.height(px(height)), css.flexShrink(0.0)])
}

/// Takes the rest of a flex line, down to nothing.
pub fn fill<M>(ui: &mut Ui<M>) -> () {
  ui.style(&[css.flexGrow(1.0), css.flexShrink(1.0), css.flexBasis(px(0.0)), css.minWidth(px(0.0))])
}

/// One line, cut at the box's edge.
pub fn oneLine<M>(ui: &mut Ui<M>) -> () {
  ui.style(
    &[
      css.whiteSpace(WhiteSpace.Pre),
      css.overflowX(Overflow.Hidden),
      css.overflowY(Overflow.Hidden),
    ],
  )
}

/// A scrolling region that fills what is left of its flex parent.
pub fn scrolling<M>(ui: &mut Ui<M>) -> () {
  ui.style(
    &[
      css.flexGrow(1.0),
      css.flexShrink(1.0),
      css.flexBasis(px(0.0)),
      css.minHeight(px(0.0)),
      css.minWidth(px(0.0)),
      css.overflowY(Overflow.Scroll),
      css.overflowX(Overflow.Hidden),
    ],
  )
}

/// A box of text in `hex`.
pub fn ink<M>(ui: &mut Ui<M>, hex: u32, text: string) -> () {
  ui.box(
    |ui| {
      ui.color(rgb(hex))
      ui.text(text)
    },
  )
}

/// A box of text in `hex` that keeps its width.
pub fn fixed<M>(ui: &mut Ui<M>, hex: u32, text: string) -> () {
  ui.box(
    |ui| {
      ui.style(&[css.flexShrink(0.0), css.whiteSpace(WhiteSpace.Pre)])
      ui.color(rgb(hex))
      ui.text(text)
    },
  )
}

const LETTERS: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

/// `text` with ASCII letters in capitals: section labels are set in capitals (the tree has no
/// `text-transform`).
pub effect fn capitals(text: string) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let bytes = String.utf8Bytes(text)
  let mut out = String.make()
  let mut start: usize = 0
  let mut i: usize = 0
  while i < bytes.length {
    if bytes[i] >= 97 && bytes[i] <= 122 {
      run out.append(String.slice(text, start, i - start))
      run out.append(String.slice(LETTERS, u8.toUsize(bytes[i] - 97), 1))
      start = i + 1
    }
    i = i + 1
  }
  run out.append(String.slice(text, start, bytes.length - start))
  return move out
}

/// A section label: Geist 11 in capitals, muted. (Its 0.06em tracking needs `letter-spacing`,
/// which the tree does not have.)
pub fn sectionLabel<M>(ui: &mut Ui<M>, look: Look, text: string) -> () {
  ui.box(
    |ui| {
      sans(&mut ui, look, SIZE_LABEL, LINE_TIGHT)
      ui.style(&[css.flexShrink(0.0), css.whiteSpace(WhiteSpace.Pre)])
      ui.color(rgb(MUTED))
      let shown = ui.alloc(capitals(text))
      ui.text(String.view(&shown))
    },
  )
}

/// A count in a pill: Geist Mono 10 on the rule color.
pub fn badge<M>(ui: &mut Ui<M>, look: Look, text: string) -> () {
  ui.box(
    |ui| {
      mono(&mut ui, look, SIZE_SMALL, LINE_TIGHT)
      ui.style(&[css.flexShrink(0.0), css.borderRadius(px(7.0))])
      pad(&mut ui, 0.0, 5.0)
      ui.background(rgb(LINE))
      ui.color(rgb(TEXT))
      ui.text(text)
    },
  )
}

/// A tab of a tab bar: Geist 12, an amber underline when `selected`, then `hint` (dimmed, mono)
/// and `count` (a badge) when not empty.
pub fn tab<M>(
  ui: &mut Ui<M>,
  look: Look,
  label: string,
  hint: string,
  count: string,
  selected: bool,
  onPress: fn() -> M,
) -> () {
  ui.pressable(
    onPress,
    |ui| {
      ui.label(label)
      ui.style(
        &[
          css.display(Keyword.Flex),
          css.alignItems(Align.Center),
          css.columnGap(px(6.0)),
          css.flexShrink(0.0),
          css.whiteSpace(WhiteSpace.Pre),
          css.paddingLeft(px(12.0)),
          css.paddingRight(px(12.0)),
          css.borderBottomWidth(px(2.0)),
          css.borderStyle(BorderStyle.Solid),
          css.borderColor(
            if selected {
              rgb(ACCENT)
            } else {
              clear()
            },
          ),
        ],
      )
      sans(&mut ui, look, SIZE_BODY, LINE_BODY)
      if selected {
        weight(&mut ui, WEIGHT_MEDIUM)
        ui.color(rgb(TEXT))
      } else {
        ui.color(rgb(MUTED))
        ui.hover(&[css.color(rgb(TEXT))])
      }
      ui.focusVisible(&[css.backgroundColor(rgb(LINE))])
      ui.box(|ui| ui.text(label))
      if hint != "" {
        ui.box(
          |ui| {
            mono(&mut ui, look, SIZE_SMALL, LINE_BODY)
            weight(&mut ui, WEIGHT_REGULAR)
            ui.color(rgb(FAINT))
            ui.text(hint)
          },
        )
      }
      if count != "" {
        badge(&mut ui, look, count)
      }
    },
  )
}

/// A thin upright rule between groups of a bar.
pub fn separator<M>(ui: &mut Ui<M>, height: f32, inline: f32) -> () {
  ui.row(
    |ui| {
      ui.style(
        &[
          css.alignItems(Align.Center),
          css.flexShrink(0.0),
          css.paddingLeft(px(inline)),
          css.paddingRight(px(inline)),
        ],
      )
      ui.box(
        |ui| {
          size(&mut ui, 1.0, height)
          ui.background(rgb(LINE))
        },
      )
    },
  )
}

/// The frame of a segmented control; `wide` stretches its segments over the line (the
/// inspector's), otherwise they hug their labels (Diff / Full).
pub fn segmented<M>(ui: &mut Ui<M>, wide: bool, body: fn(&mut Ui<M>) -> ()) -> () {
  ui.row(
    |ui| {
      ui.style(
        &[
          css.alignItems(Align.Center),
          css.columnGap(px(2.0)),
          css.paddingTop(px(2.0)),
          css.paddingBottom(px(2.0)),
          css.paddingLeft(px(2.0)),
          css.paddingRight(px(2.0)),
          css.flexShrink(0.0),
        ],
      )
      outline(
        &mut ui,
        LINE,
        if wide {
          6.0
        } else {
          5.0
        },
      )
      ui.background(
        rgb(
          if wide {
            INK
          } else {
            SURFACE
          },
        ),
      )
      body(&mut ui)
    },
  )
}

/// One segment of a segmented control: the selected one on the rule color.
pub fn segment<M>(
  ui: &mut Ui<M>,
  look: Look,
  wide: bool,
  label: string,
  count: string,
  selected: bool,
  onPress: fn() -> M,
) -> () {
  ui.pressable(
    onPress,
    |ui| {
      ui.label(label)
      ui.style(
        &[
          css.display(Keyword.Flex),
          css.justifyContent(Align.Center),
          css.columnGap(px(4.0)),
          css.whiteSpace(WhiteSpace.Pre),
        ],
      )
      if wide {
        fill(&mut ui)
        pad(&mut ui, 3.0, 8.0)
        sans(&mut ui, look, SIZE_BODY, LINE_BODY)
        ui.style(&[css.borderRadius(px(4.0))])
      } else {
        pad(&mut ui, 2.0, 8.0)
        sans(&mut ui, look, SIZE_LABEL, LINE_TIGHT)
        ui.style(&[css.borderRadius(px(3.0))])
      }
      if selected {
        ui.background(rgb(LINE))
        ui.color(rgb(TEXT))
        if wide {
          weight(&mut ui, WEIGHT_MEDIUM)
        }
      } else {
        ui.color(rgb(MUTED))
        ui.hover(&[css.color(rgb(TEXT))])
      }
      ui.focusVisible(&[css.backgroundColor(rgb(LINE))])
      ui.box(|ui| ui.text(label))
      if count != "" {
        ui.box(
          |ui| {
            weight(&mut ui, WEIGHT_REGULAR)
            ui.color(rgb(ACCENT))
            ui.text(count)
          },
        )
      }
    },
  )
}

/// The look of a field: 28 high on the ink, a one-pixel rule round it, amber when `edited`.
pub fn fieldLook<M>(ui: &mut Ui<M>, edited: bool) -> () {
  ui.style(
    &[
      css.display(Keyword.Flex),
      css.alignItems(Align.Center),
      css.columnGap(px(8.0)),
      css.height(px(FIELD)),
      css.boxSizing(BoxSizing.BorderBox),
      css.paddingLeft(px(8.0)),
      css.paddingRight(px(8.0)),
      css.minWidth(px(0.0)),
    ],
  )
  outline(
    &mut ui,
    if edited {
      ACCENT
    } else {
      LINE
    },
    5.0,
  )
  ui.background(rgb(INK))
}

/// The amber dot of an edited field.
pub fn editedDot<M>(ui: &mut Ui<M>) -> () {
  ui.box(
    |ui| {
      ui.label("edited")
      size(&mut ui, 5.0, 5.0)
      ui.style(&[css.borderRadius(px(2.5))])
      ui.background(rgb(ACCENT))
    },
  )
}

/// A color swatch: filled with `color`, or an empty square when it is clear.
pub fn swatch<M>(ui: &mut Ui<M>, color: Rgba<f32>, empty: bool) -> () {
  ui.box(
    |ui| {
      size(&mut ui, 14.0, 14.0)
      if empty {
        outline(&mut ui, FAINT, 3.0)
      } else {
        ui.style(&[css.borderRadius(px(3.0))])
        ui.background(color)
      }
    },
  )
}

/// A card: the ink inside a rule, 6 round, 8 by 10 inside, its lines 6 apart.
pub fn card<M>(ui: &mut Ui<M>, body: fn(&mut Ui<M>) -> ()) -> () {
  ui.column(
    |ui| {
      ui.style(&[css.rowGap(px(6.0)), css.flexShrink(0.0)])
      pad(&mut ui, 8.0, 10.0)
      outline(&mut ui, LINE, 6.0)
      ui.background(rgb(INK))
      body(&mut ui)
    },
  )
}

/// A quiet button: muted Geist 12 that lights on hover, with test id `testId` when not empty.
pub fn ghostButton<M>(
  ui: &mut Ui<M>,
  look: Look,
  testId: string,
  label: string,
  onPress: fn() -> M,
) -> () {
  ui.pressable(
    onPress,
    |ui| {
      if testId != "" {
        ui.testId(testId)
      }
      ui.label(label)
      ui.style(&[css.flexShrink(0.0), css.whiteSpace(WhiteSpace.Pre), css.borderRadius(px(4.0))])
      pad(&mut ui, 2.0, 8.0)
      sans(&mut ui, look, SIZE_BODY, LINE_BODY)
      ui.color(rgb(MUTED))
      ui.hover(&[css.color(rgb(TEXT)), css.backgroundColor(rgb(LINE))])
      ui.focusVisible(&[css.backgroundColor(rgb(LINE))])
      ui.text(label)
    },
  )
}

/// The one loud button: amber, ink text, Geist 11 semibold.
pub fn accentButton<M>(
  ui: &mut Ui<M>,
  look: Look,
  testId: string,
  label: string,
  onPress: fn() -> M,
) -> () {
  ui.pressable(
    onPress,
    |ui| {
      if testId != "" {
        ui.testId(testId)
      }
      ui.label(label)
      ui.style(&[css.flexShrink(0.0), css.whiteSpace(WhiteSpace.Pre), css.borderRadius(px(4.0))])
      pad(&mut ui, 2.0, 8.0)
      sans(&mut ui, look, SIZE_LABEL, LINE_BODY)
      weight(&mut ui, WEIGHT_STRONG)
      ui.background(rgb(ACCENT))
      ui.color(rgb(INK))
      ui.hover(&[css.backgroundColor(rgb(0xFFC04D))])
      ui.focusVisible(&[css.backgroundColor(rgb(0xFFC04D))])
      ui.text(label)
    },
  )
}

/// The look of a list row `height` high: a cyan wash under the pointer, or when `selected` the
/// amber wash with a bar down its left side (two pixels taken from `left`, so the text stays).
pub fn rowLook<M>(ui: &mut Ui<M>, height: f32, left: f32, right: f32, selected: bool) -> () {
  ui.style(
    &[
      css.alignItems(Align.Center),
      css.height(px(height)),
      css.flexShrink(0.0),
      css.boxSizing(BoxSizing.BorderBox),
      css.paddingRight(px(right)),
    ],
  )
  if selected {
    ui.style(
      &[
        css.paddingLeft(px(left - 2.0)),
        css.borderLeftWidth(px(2.0)),
        css.borderStyle(BorderStyle.Solid),
        css.borderColor(rgb(ACCENT)),
        css.backgroundColor(rgba(ACCENT, ACCENT_WASH)),
      ],
    )
  } else {
    ui.style(&[css.paddingLeft(px(left))])
    ui.hover(&[css.backgroundColor(rgba(HOVER, HOVER_WASH))])
  }
  ui.focusVisible(&[css.backgroundColor(rgba(HOVER, HOVER_WASH))])
}

/// The small drawn icons.
pub enum Icon {
  /// A folded node: a triangle pointing right.
  Folded,
  /// An open node: a triangle pointing down.
  Open,
  /// The filter's magnifier.
  Search,
  /// Pick's arrow.
  Pointer,
}

/// Icon `icon`, 12 by 12 (the triangles 10 by 10), drawn in `hex`.
pub fn icon<M>(ui: &mut Ui<M>, kind: Icon, hex: u32) -> () {
  let color = rgb(hex)
  match kind {
    Icon.Folded => {
      ui.canvas(
        &[
          CanvasCommand.MoveTo { x: 3.5, y: 2.5 },
          CanvasCommand.LineTo { x: 7.5, y: 5.0 },
          CanvasCommand.LineTo { x: 3.5, y: 7.5 },
          CanvasCommand.Close,
          CanvasCommand.Fill { color: color },
        ],
        |ui| size(&mut ui, 10.0, 10.0),
      )
    }
    Icon.Open => {
      ui.canvas(
        &[
          CanvasCommand.MoveTo { x: 2.5, y: 3.5 },
          CanvasCommand.LineTo { x: 7.5, y: 3.5 },
          CanvasCommand.LineTo { x: 5.0, y: 7.5 },
          CanvasCommand.Close,
          CanvasCommand.Fill { color: color },
        ],
        |ui| size(&mut ui, 10.0, 10.0),
      )
    }
    Icon.Search => {
      ui.canvas(
        &[
          // A circle of radius 3.4 at (5.2, 5.2), in four quarter curves.
          CanvasCommand.MoveTo { x: 8.6, y: 5.2 },
          CanvasCommand.CubicTo { x1: 8.6, y1: 7.08, x2: 7.08, y2: 8.6, x: 5.2, y: 8.6 },
          CanvasCommand.CubicTo { x1: 3.32, y1: 8.6, x2: 1.8, y2: 7.08, x: 1.8, y: 5.2 },
          CanvasCommand.CubicTo { x1: 1.8, y1: 3.32, x2: 3.32, y2: 1.8, x: 5.2, y: 1.8 },
          CanvasCommand.CubicTo { x1: 7.08, y1: 1.8, x2: 8.6, y2: 3.32, x: 8.6, y: 5.2 },
          CanvasCommand.Close,
          CanvasCommand.Stroke { color: color, width: 1.2 },
          CanvasCommand.MoveTo { x: 8.0, y: 8.0 },
          CanvasCommand.LineTo { x: 10.4, y: 10.4 },
          CanvasCommand.Stroke { color: color, width: 1.2 },
        ],
        |ui| size(&mut ui, 12.0, 12.0),
      )
    }
    Icon.Pointer => {
      ui.canvas(
        &[
          CanvasCommand.MoveTo { x: 2.0, y: 2.0 },
          CanvasCommand.LineTo { x: 5.2, y: 10.0 },
          CanvasCommand.LineTo { x: 6.4, y: 6.6 },
          CanvasCommand.LineTo { x: 9.8, y: 5.4 },
          CanvasCommand.Close,
          CanvasCommand.Stroke { color: color, width: 1.2 },
        ],
        |ui| size(&mut ui, 12.0, 12.0),
      )
    }
  }
}

/// A dot `diameter` across in `hex`.
pub fn dot<M>(ui: &mut Ui<M>, hex: u32, diameter: f32, radius: f32) -> () {
  ui.box(
    |ui| {
      size(&mut ui, diameter, diameter)
      ui.style(&[css.borderRadius(px(radius))])
      ui.background(rgb(hex))
    },
  )
}

/// Right-aligned text in a slot `width` wide.
pub fn slot<M>(ui: &mut Ui<M>, width: f32, hex: u32, text: string) -> () {
  ui.box(
    |ui| {
      ui.style(
        &[
          css.width(px(width)),
          css.flexShrink(0.0),
          css.textAlign(TextAlign.Right),
          css.whiteSpace(WhiteSpace.Pre),
          css.overflowX(Overflow.Hidden),
        ],
      )
      ui.color(rgb(hex))
      ui.text(text)
    },
  )
}
