/// Seconds between tries while the app cannot be reached.
pub const RETRY_INTERVAL: f64 = 1.0

/// Seconds between the Frames panel's reads while the app draws: an app that draws every
/// frame would otherwise have the devtools read its timeline as often.
pub const FRAMES_INTERVAL: f64 = 0.1

/// How many event records the log keeps.
pub const MAX_LOG: usize = 200

/// The font families the host defines for the window: [`FONT`] for the interface
/// (`theme.UI_FAMILIES`) and [`MONO`] for code and data (`theme.MONO_FAMILIES`). Devtools in
/// the app's own tree use ids of their own (`Devtools.look`).
pub const FONT: u32 = 1

pub const MONO: u32 = 2

/// The tabs of the middle column.
pub enum Panel {
  Events,
  /// The frame timeline and the last frame's stats.
  Frames,
  Audit,
  /// A panel an extension of the app adds (`Devtools.shown` says which).
  Extension,
}

/// The segments of the inspector.
pub enum Segment {
  /// Fields for the common properties, the other declarations and the node's edits.
  Design,
  /// The node view, edited by typing declarations, and the box model.
  Declarations,
  /// The edit log: style edits and comments, to resolve, reopen or take back.
  Edits,
}

/// Below this width (in CSS pixels) the inspector is a tab of the middle column.
pub const STACKED_BELOW: f32 = 820.0

/// How wide the columns are in a window `width` wide: the tree and the inspector at their
/// designed 320 and 340 from 1180 up, narrower below, and under [`STACKED_BELOW`] the
/// inspector in the middle column (`inspector` 0, `stacked`). 0 (not laid out yet) is wide.
pub struct Columns {
  pub tree: f32,
  pub inspector: f32,
  pub stacked: bool,
}

pub fn columnsFor(width: f32) -> Columns {
  if width <= 0.0 || width >= 1180.0 {
    return Columns { tree: 320.0, inspector: 340.0, stacked: false }
  }
  if width >= 980.0 {
    return Columns { tree: 280.0, inspector: 320.0, stacked: false }
  }
  if width >= STACKED_BELOW {
    return Columns { tree: 240.0, inspector: 300.0, stacked: false }
  }
  let tree = f32.max(180.0, f32.min(260.0, f32.floor(width * 0.36)))
  return Columns { tree: tree, inspector: 0.0, stacked: true }
}

/// How many frames the timeline shows.
pub const MAX_FRAMES: u64 = 120

/// The height of the timeline's bars, in pixels.
const BAR_HEIGHT: f32 = 96.0

/// A bar's width, and the distance from one bar to the next.
const BAR_WIDTH: f32 = 3.0

const BAR_PITCH: f32 = 4.0

pub union Message {
  /// Read everything again.
  Refresh,
  /// The timer that tries again while the app cannot be reached, and reads the frames the app
  /// drew since the Frames panel last did.
  Tick { pub time: f64 },
  /// Notifications from the app wait: read what they say changed.
  Pull,
  /// The pointer entered or left the row of node `id`.
  Hover { pub id: u32 },
  Unhover { pub id: u32 },
  /// A notification went to the app.
  Sent,
  ToggleLive,
  /// Inspect and highlight node `id`.
  Select { pub id: u32 },
  /// Fold or unfold the children of node `id`.
  Collapse { pub id: u32 },
  Show { pub panel: Panel },
  /// Show the extension panel at `index` of `Devtools.panels`.
  ShowPanel { pub index: usize },
  /// Show a segment of the inspector.
  ShowSegment { pub segment: Segment },
  /// In a narrow window, show the inspector in the middle column (or the panel again).
  ShowInspector { pub shown: bool },
  /// The devtools' box is `width` wide.
  Resized { pub width: f32 },
  /// Text typed into Design field `field` (`design.FIELD_*`).
  FieldInput { pub field: u32, pub value: String },
  /// Set what field `field` holds on the selected node.
  ApplyField { pub field: u32 },
  /// Step the last number of field `field` by `by`, and set it.
  StepField { pub field: u32, pub by: f32 },
  SelectNext,
  SelectPrevious,
  ClearSelection,
  ClearEvents,
  /// The filter over the elements changed.
  Search { pub value: String },
  /// Start or stop picking in the app's window.
  TogglePick,
  Picking { pub on: bool },
  /// The declarations being typed for the selected node.
  StyleDraft { pub value: String },
  /// Set the typed declarations on the selected node.
  ApplyStyle,
  /// Step the last number of the typed declarations by `by`, and set them.
  StepStyle { pub by: f32 },
  /// Take completion `index` of the typed declarations.
  Complete { pub index: usize },
  /// Take the selected node's style edits back.
  ResetStyles,
  /// Take every style edit back.
  ResetAll,
  /// Take back the edit at `index` of `Devtools.changes`.
  ResetChange { pub index: usize },
  /// Mark entry `id` of the edit log resolved, or open again.
  Resolve { pub id: u64, pub reopen: bool },
  /// The comment being typed for the selected node.
  CommentDraft { pub value: String },
  /// Comment on the selected node.
  AddComment,
  /// The app took an edit: the edit log and `detail`, the selected node after it; `draft` says
  /// whether the typed declarations were set (and are cleared).
  Edited { pub changes: List<ChangeRow>, pub open: usize, pub detail: Detail, pub draft: bool },
  StyleRefused { pub error: String },
  /// A request went out whose reply comes with the notifications.
  Asked { pub asked: Asked },
  RunAudit,
  Audited { pub issues: List<Issue>, pub line: String },
  Synced { pub snapshot: Snapshot },
  Inspected { pub detail: Detail },
  Failed { pub error: String },
}

pub union Command {
  /// Subscribe to `topics` (`TOPIC_*` bits) and the extension topics `names`, then read
  /// status, tree, stats, the events after `since`, what `panel` shows besides, and node
  /// `selected` again.
  Sync {
    pub since: u64,
    pub selected: u32,
    pub panel: Panel,
    pub topics: u32,
    pub names: List<String>,
  },
  /// Take the app's notifications and read again what they say changed.
  Pull { pub since: u64, pub selected: u32, pub panel: Panel },
  /// Read the last frame's stats and the timeline.
  Frames,
  /// Subscribe to exactly `topics` and `names`.
  Subscribe { pub topics: u32, pub names: List<String> },
  /// Send request `line` without waiting; its reply comes with the notifications.
  Ask { pub line: String, pub purpose: u32, pub index: usize },
  /// Highlight node `node` as pointed at (nothing for NO_PARENT) and ring `selected` (nothing
  /// for NO_PARENT), without waiting for an answer.
  Highlight { pub node: u32, pub selected: u32 },
  /// Ring node `node` as selected and inspect it.
  Inspect { pub node: u32 },
  /// Clear the highlight.
  Unhighlight,
  /// Turn picking in the app's window on or off.
  Pick { pub on: bool },
  /// Set declarations `css` on node `node`; `draft` as in `Message.Edited`.
  SetStyle { pub node: u32, pub css: String, pub draft: bool },
  /// Send edit log request `line` (`resetStyles`, `resolve`, `comment`), then read the log and
  /// node `selected` again.
  Edit { pub line: String, pub selected: u32 },
  Audit,
}

/// The devtools model.
pub struct Devtools {
  /// Where the app is, as the status line names it.
  pub target: String,
  pub live: bool,
  pub panel: Panel,
  pub segment: Segment,
  /// In a narrow window: whether the middle column shows the inspector.
  pub inspector: bool,
  /// How wide the devtools' box is, once laid out (0 before).
  pub width: f32,
  /// The Design field being typed into (`design.NO_FIELD` for none), and what it holds.
  pub field: u32,
  pub fieldDraft: String,
  /// What the top bar says about the app.
  pub info: AppInfo,
  pub rows: List<Row>,
  /// Nodes whose children are folded.
  pub collapsed: List<u32>,
  /// The selected node, or NO_PARENT.
  pub selected: u32,
  pub detail: Detail,
  pub stats: List<Stat>,
  /// The newest [`MAX_LOG`] event records, oldest first.
  pub events: List<LogRow>,
  /// The `seq` of the last record read.
  pub since: u64,
  pub status: String,
  /// Why the last request failed, or empty.
  pub error: String,
  /// Refreshes that reached the app.
  pub syncs: u64,
  /// The filter over the elements; rows whose label does not contain it are hidden.
  pub search: String,
  /// Whether the app's window is waiting for a pick.
  pub picking: bool,
  /// The declarations being typed for the selected node, and the completions offered.
  pub draft: String,
  pub suggestions: List<String>,
  /// The comment being typed for the selected node.
  pub comment: String,
  /// The edit log, and how many of its entries are open.
  pub changes: List<ChangeRow>,
  pub openChanges: usize,
  /// Why the app refused the last style edit, or empty.
  pub styleError: String,
  pub frames: FrameView,
  /// The app drew frames the Frames panel has yet to read; it does every [`FRAMES_INTERVAL`].
  pub framesDue: bool,
  pub issues: List<Issue>,
  /// The audit's summary, or empty before the first one.
  pub auditLine: String,
  /// The node whose row the pointer is over, or NO_PARENT.
  pub hovered: u32,
  /// The topics subscribed to, as `TOPIC_*` bits.
  pub topics: u32,
  /// The font families the devtools draw with: [`FONT`] and [`MONO`] unless they share the
  /// app's tree.
  pub look: Look,
  /// The ids of the app's extensions, and the panels they add.
  pub extensions: List<String>,
  pub panels: List<PanelInfo>,
  /// The extension topics subscribed to.
  pub names: List<String>,
  /// The requests whose replies come with the notifications.
  pub asked: List<Asked>,
  /// The extension panel shown while `panel` is `Extension`, and its data as the generic view
  /// shows it.
  pub shown: usize,
  pub data: List<DataRow>,
}

impl Devtools {
  /// A window looking at the app at `target` (shown in the status line).
  pub effect fn make(target: string) -> Devtools
    ! OutOfMemoryError
    ? &mut Allocator {
    return Devtools {
      target: run String.copy(target),
      live: true,
      panel: Panel.Events,
      segment: Segment.Design,
      inspector: false,
      width: 0.0,
      field: NO_FIELD,
      fieldDraft: String.make(),
      info: AppInfo.none(),
      rows: List<Row>.make(),
      collapsed: List<u32>.make(),
      selected: NO_PARENT,
      detail: Detail.none(),
      stats: List<Stat>.make(),
      events: List<LogRow>.make(),
      since: 0,
      status: run String.copy("connecting"),
      error: String.make(),
      syncs: 0,
      search: String.make(),
      picking: false,
      draft: String.make(),
      suggestions: List<String>.make(),
      comment: String.make(),
      changes: List<ChangeRow>.make(),
      openChanges: 0,
      styleError: String.make(),
      frames: FrameView.none(),
      framesDue: false,
      issues: List<Issue>.make(),
      auditLine: String.make(),
      hovered: NO_PARENT,
      topics: 0,
      look: Look { ui: FONT, mono: MONO },
      extensions: List<String>.make(),
      panels: List<PanelInfo>.make(),
      names: List<String>.make(),
      asked: List<Asked>.make(),
      shown: 0,
      data: List<DataRow>.make(),
    }
  }

  /// The extension panel that shows, if one does.
  pub fn shownPanel(self: &Self) -> Option<&PanelInfo> {
    if self.panel != Panel.Extension || self.shown >= self.panels.length() {
      return Option<&PanelInfo>.None
    }
    return Option<&PanelInfo>.some(&self.panels.asSlice()[self.shown])
  }

  /// Whether the app has extension `id`.
  pub fn hasExtension(self: &Self, id: string) -> bool {
    let list = self.extensions.asSlice()
    let mut i: usize = 0
    while i < list.length {
      if String.view(&list[i]) == id {
        return true
      }
      i = i + 1
    }
    return false
  }

  /// The extension topics to subscribe to: the view of the extension panel that shows, or
  /// while live the topic that says its data changed.
  effect fn wantedNames(self: &Self) -> List<String>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut names = List<String>.make()
    if let Option<&PanelInfo>.Some { value: panel } = self.shownPanel() {
      if panel.view.ownedByteLength() != 0 {
        // A view shows what it shows, live or not, while it is open.
        run names.append(run String.copy(String.view(&panel.view)))
      } else if self.live && panel.topic.ownedByteLength() != 0 {
        run names.append(run String.copy(String.view(&panel.topic)))
      }
    }
    return move names
  }

  /// Reads the data of the extension panel that shows, when it has data.
  fn readPanel(self: &mut Self, cx: &mut Context<Command>) -> () {
    let mut line = String.make()
    if let Option<&PanelInfo>.Some { value: panel } = self.shownPanel() {
      if panel.data.ownedByteLength() != 0 && panel.view.ownedByteLength() == 0 {
        line = cx.alloc(String.copy("{\"cmd\":"))
        cx.alloc(writeString(&mut line, String.view(&panel.data)))
        cx.alloc(line.append("}"))
      }
    }
    if line.ownedByteLength() != 0 {
      let index = self.shown
      self.ask(&mut cx, String.view(&line), ASK_DATA, index)
    }
  }

  /// Whether `names` has the topic of the extension panel that shows.
  fn panelNews(self: &Self, names: &List<String>) -> bool {
    if let Option<&PanelInfo>.Some { value: panel } = self.shownPanel() {
      let list = names.asSlice()
      let mut i: usize = 0
      while i < list.length {
        if panel.topic.ownedByteLength() != 0
          && String.view(&list[i]) == String.view(&panel.topic) {
          return true
        }
        i = i + 1
      }
    }
    return false
  }

  /// Sends request `line` for `purpose` without waiting.
  fn ask(
    self: &mut Self,
    cx: &mut Context<Command>,
    line: string,
    purpose: u32,
    index: usize,
  ) -> () {
    let copied = cx.alloc(String.copy(line))
    cx.command(Command.Ask { line: move copied, purpose: purpose, index: index })
  }

  /// Takes the reply `line` to a request sent with `ask`.
  fn answered(self: &mut Self, line: &String, cx: &mut Context<Command>) -> () {
    let parsed = cx.alloc(Effect.result(Json.parse(line.ownedUtf8Bytes())))
    let reply = match move parsed {
      Result<Value, JsonError | OutOfMemoryError>.Success { value } => move value
      Result<Value, JsonError | OutOfMemoryError>.Failure { error } => {
        drop error
        return ()
      }
    }
    let id = match Json.asU64(Json.field(&reply, "id")) {
      Option<u64>.Some { value } => value
      Option<u64>.None => {
        return ()
      }
    }
    let mut at: usize = 0
    while at < self.asked.length() && self.asked.asSlice()[at].id != id {
      at = at + 1
    }
    if at == self.asked.length() {
      return ()
    }
    let asked = self.asked.remove(at)
    if !ok(&reply) {
      return ()
    }
    if asked.purpose == ASK_DATA && self.panel == Panel.Extension && asked.index == self.shown {
      cx.alloc(parseData(&reply, &mut self.data))
    }
  }

  fn isCollapsed(self: &Self, id: u32) -> bool {
    let list = self.collapsed.asSlice()
    let mut i: usize = 0
    while i < list.length {
      if list[i] == id {
        return true
      }
      i = i + 1
    }
    return false
  }

  /// Marks the rows under folded nodes hidden; with a filter, the rows that do not match it.
  fn updateVisibility(self: &mut Self) -> () {
    let mut hideBelow: u32 = 4294967295
    let n = self.rows.length()
    let mut i: usize = 0
    if self.search.ownedByteLength() != 0 {
      while i < n {
        let shown = matches(String.view(&self.rows.asSlice()[i].label), String.view(&self.search))
        let rows = self.rows.asMutSlice()
        rows[i].visible = shown
        i = i + 1
      }
      return ()
    }
    while i < n {
      let depth = self.rows.asSlice()[i].depth
      let id = self.rows.asSlice()[i].id
      let children = self.rows.asSlice()[i].children
      let visible = hideBelow == 4294967295 || depth <= hideBelow
      if visible {
        hideBelow = 4294967295
        if children > 0 && self.isCollapsed(id) {
          hideBelow = depth
        }
      }
      let rows = self.rows.asMutSlice()
      rows[i].visible = visible
      i = i + 1
    }
  }

  /// The row label of node `id`, or "".
  pub fn labelOf(self: &Self, id: u32) -> string {
    let rows = self.rows.asSlice()
    let mut i: usize = 0
    while i < rows.length {
      if rows[i].id == id {
        return String.view(&rows[i].label)
      }
      i = i + 1
    }
    return ""
  }

  /// The index of the selected row among the visible ones, or the row count.
  fn selectedIndex(self: &Self) -> usize {
    let rows = self.rows.asSlice()
    let mut i: usize = 0
    while i < rows.length {
      if rows[i].id == self.selected && rows[i].visible {
        return i
      }
      i = i + 1
    }
    return rows.length
  }

  /// The id of the visible row after (or before) the selected one.
  fn step(self: &Self, forward: bool) -> u32 {
    let rows = self.rows.asSlice()
    if rows.length == 0 {
      return NO_PARENT
    }
    let at = self.selectedIndex()
    if forward {
      let mut i = if at == rows.length {
        0
      } else {
        at + 1
      }
      while i < rows.length {
        if rows[i].visible {
          return rows[i].id
        }
        i = i + 1
      }
    } else {
      let mut i = if at == rows.length {
        rows.length
      } else {
        at
      }
      while i > 0 {
        i = i - 1
        if rows[i].visible {
          return rows[i].id
        }
      }
    }
    return self.selected
  }

  /// What to subscribe to: while live, the tree, its roots, the event log and the picker, and
  /// frames for the panels that show what each frame changes; the picker alone otherwise.
  pub fn wanted(self: &Self) -> u32 {
    if !self.live {
      return TOPIC_PICK
    }
    let mut topics = TOPIC_TREE | TOPIC_ROOTS | TOPIC_EVENTS | TOPIC_PICK | TOPIC_EDITS
    if self.panel == Panel.Frames {
      topics = topics | TOPIC_FRAME
    }
    return topics
  }

  /// Subscribes to what is wanted and reads everything.
  fn sync(self: &mut Self, cx: &mut Context<Command>) -> () {
    self.topics = self.wanted()
    self.names = cx.alloc(self.wantedNames())
    let names = cx.alloc(copyNames(&self.names))
    cx.command(
      Command.Sync {
        since: self.since,
        selected: self.selected,
        panel: self.panel,
        topics: self.topics,
        names: move names,
      },
    )
  }

  /// Subscribes to what is wanted, when that changed.
  fn resubscribe(self: &mut Self, cx: &mut Context<Command>) -> () {
    let names = cx.alloc(self.wantedNames())
    if self.wanted() != self.topics || !sameNames(&names, &self.names) {
      self.topics = self.wanted()
      self.names = move names
      let copy = cx.alloc(copyNames(&self.names))
      cx.command(Command.Subscribe { topics: self.topics, names: move copy })
    }
  }

  /// Unfolds what hides node `id` and drops a filter that does.
  fn expose(self: &mut Self, id: u32) -> () {
    let mut at = id
    while at != NO_PARENT {
      let rows = self.rows.asSlice()
      let mut parent = NO_PARENT
      let mut i: usize = 0
      while i < rows.length {
        if rows[i].id == at {
          parent = rows[i].parent
        }
        i = i + 1
      }
      let mut j: usize = 0
      while j < self.collapsed.length() {
        if self.collapsed.asSlice()[j] == parent {
          drop self.collapsed.remove(j)
        } else {
          j = j + 1
        }
      }
      at = parent
    }
    if self.search.ownedByteLength() != 0 && !matches(self.labelOf(id), String.view(&self.search)) {
      self.search.clear()
    }
    self.updateVisibility()
  }

  fn select(self: &mut Self, id: u32, cx: &mut Context<Command>) -> () {
    if id == NO_PARENT {
      return ()
    }
    self.selected = id
    self.field = NO_FIELD
    cx.command(Command.Inspect { node: id })
  }

  /// The Design field `field` as shown: what is typed into it, or the node's value.
  effect fn fieldShown(self: &Self, field: u32) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.field == field {
      return run String.copy(String.view(&self.fieldDraft))
    }
    let mut text = String.make()
    run fieldText(&self.detail, field, &mut text)
    return move text
  }

  /// The columns of the window as wide as the devtools are now.
  pub fn columns(self: &Self) -> Columns {
    return columnsFor(self.width)
  }
}

// Commands.

effect fn copyNames(names: &List<String>) -> List<String>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut copy = List<String>.make()
  let list = names.asSlice()
  let mut i: usize = 0
  while i < list.length {
    run copy.append(run String.copy(String.view(&list[i])))
    i = i + 1
  }
  return move copy
}

fn sameNames(a: &List<String>, b: &List<String>) -> bool {
  if a.length() != b.length() {
    return false
  }
  let x = a.asSlice()
  let y = b.asSlice()
  let mut i: usize = 0
  while i < x.length {
    if String.view(&x[i]) != String.view(&y[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

fn ok(reply: &Value) -> bool {
  return match Json.field(reply, "ok") {
    Option<&Value>.Some { value } => match &value.* {
      Value.Bool { value: b } => b
      _ => false
    }
    Option<&Value>.None => false
  }
}

/// Sends `line` and returns the reply, or None with the reason in `error`.
effect fn ask(line: string, error: &mut String) -> Option<Value>
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  let mut reply = String.make()
  if !run Link.request(line, &mut reply) {
    error.clear()
    run error.append("cannot reach the app: ")
    run error.append(String.view(&reply))
    return Option<Value>.None
  }
  let parsed = run Effect.result(Json.parse(reply.ownedUtf8Bytes()))
  return match move parsed {
    Result<Value, JsonError | OutOfMemoryError>.Success { value } => {
      if ok(&value) {
        return Option<Value>.Some { value: move value }
      }
      error.clear()
      run error.append("the app answered: ")
      run error.append(textField(&value, "error"))
      Option<Value>.None
    }
    Result<Value, JsonError | OutOfMemoryError>.Failure { error: e } => {
      drop e
      error.clear()
      run error.append("the app's reply is not JSON")
      Option<Value>.None
    }
  }
}

/// `{"cmd":"<cmd>","<key>":<value>}`.
effect fn requestLine(cmd: string, key: string, value: u64) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut line = run String.copy("{\"cmd\":\"")
  run line.append(cmd)
  run line.append("\",\"")
  run line.append(key)
  run line.append("\":")
  run writeInt(&mut line, value)
  run line.append("}")
  return move line
}

effect fn inspectNode(node: u32) -> Option<Detail>
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  let line = run requestLine("inspect", "node", u32.toU64(node))
  let mut error = String.make()
  return match run ask(String.view(&line), &mut error) {
    Option<Value>.Some { value } => Option<Detail>.Some { value: run parseDetail(&value) }
    Option<Value>.None => Option<Detail>.None
  }
}

/// `{"cmd":"subscribe","topics":[...]}` for `topics` (`TOPIC_*` bits) and extension topics
/// `names`.
effect fn subscribeLine(topics: u32, names: &List<String>) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut line = run String.copy("{\"cmd\":\"subscribe\",\"topics\":[")
  let mut first = true
  let mut i: usize = 0
  while i < TOPIC_COUNT {
    if u32.bitAnd(topics, u32.shiftLeft(1, usize.toU32(i))) != 0 {
      if !first {
        run line.append(",")
      }
      first = false
      run writeString(&mut line, TOPIC_NAMES[i])
    }
    i = i + 1
  }
  let list = names.asSlice()
  let mut k: usize = 0
  while k < list.length {
    if !first {
      run line.append(",")
    }
    first = false
    run writeString(&mut line, String.view(&list[k]))
    k = k + 1
  }
  run line.append("]}")
  return move line
}

/// Subscribes to exactly `topics`, with two notifications. The app handles lines in order, so
/// the requests sent after them see the subscription.
effect fn subscribe(topics: u32, names: &List<String>) -> bool
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  if !run Link.notify("{\"cmd\":\"unsubscribe\"}") {
    return false
  }
  let line = run subscribeLine(topics, names)
  return run Link.notify(String.view(&line))
}

/// A snapshot with nothing read yet.
fn emptySnapshot(since: u64) -> Snapshot {
  return Snapshot {
    parts: 0,
    status: String.make(),
    info: AppInfo.none(),
    rows: List<Row>.make(),
    stats: List<Stat>.make(),
    events: List<LogRow>.make(),
    next: since + 1,
    detail: Option<Detail>.None,
    extensions: Option<List<String>>.None,
    panels: List<PanelInfo>.make(),
    news: List<String>.make(),
    replies: List<String>.make(),
    frames: Option<FrameView>.None,
    drew: false,
    picking: false,
    picked: NO_PARENT,
    changes: List<ChangeRow>.make(),
    openChanges: 0,
  }
}

effect fn syncAll(
  since: u64,
  selected: u32,
  panel: Panel,
  topics: u32,
  names: &List<String>,
) -> Message
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  let mut error = String.make()
  let mut snapshot = emptySnapshot(since)
  snapshot.parts = PART_ALL
  match run ask("{\"cmd\":\"hello\"}", &mut error) {
    Option<Value>.Some { value } => {
      run parseStatus(&value, &mut snapshot.status)
      snapshot.info = readInfo(&value)
      let mut ids = List<String>.make()
      run parseExtensions(&value, &mut ids, &mut snapshot.panels)
      snapshot.extensions = Option<List<String>>.some(move ids)
    }
    Option<Value>.None => {
      return Message.Failed { error: move error }
    }
  }

  // Before the reads, so no change after them goes unheard.
  if !run subscribe(topics, names) {
    run error.append("cannot reach the app")
    return Message.Failed { error: move error }
  }
  match run ask("{\"cmd\":\"tree\"}", &mut error) {
    Option<Value>.Some { value } => {
      run parseTree(&value, &mut snapshot.rows)
    }
    Option<Value>.None => {
      return Message.Failed { error: move error }
    }
  }
  match run ask("{\"cmd\":\"stats\"}", &mut error) {
    Option<Value>.Some { value } => {
      run parseStats(&value, &mut snapshot.stats)
    }
    Option<Value>.None => {
      return Message.Failed { error: move error }
    }
  }
  let events = run requestLine("events", "since", since)
  match run ask(String.view(&events), &mut error) {
    Option<Value>.Some { value } => {
      snapshot.next = run parseEvents(&value, &mut snapshot.events)
    }
    Option<Value>.None => {
      return Message.Failed { error: move error }
    }
  }
  if selected != NO_PARENT {
    snapshot.detail = run inspectNode(selected)
  }

  // What came with protocol 2: an older app answers "unknown cmd" and the panels stay empty.
  let mut quiet = String.make()
  if panel == Panel.Frames {
    let frames = run requestLine("frames", "limit", MAX_FRAMES)
    match run ask(String.view(&frames), &mut quiet) {
      Option<Value>.Some { value } => {
        snapshot.frames = Option<FrameView>.Some { value: run parseFrames(&value) }
      }
      Option<Value>.None => {}
    }
  }
  match run ask("{\"cmd\":\"pickMode\"}", &mut quiet) {
    Option<Value>.Some { value } => {
      snapshot.picking = flagField(&value, "on", false)
      snapshot.picked = pickedOf(&value)
    }
    Option<Value>.None => {}
  }
  match run ask("{\"cmd\":\"edits\"}", &mut quiet) {
    Option<Value>.Some { value } => {
      snapshot.openChanges = run parseChanges(&value, &mut snapshot.changes)
    }
    Option<Value>.None => {}
  }
  return Message.Synced { snapshot: move snapshot }
}

fn pickedOf(reply: &Value) -> u32 {
  return match Json.field(reply, "picked") {
    Option<&Value>.Some { value: node } => match idField(node, "id") {
      Option<u32>.Some { value: id } => id
      Option<u32>.None => NO_PARENT
    }
    Option<&Value>.None => NO_PARENT
  }
}

/// Takes the app's notifications and reads again what they say changed: the element tree and
/// the selected node after `tree` or `roots`, the event log after `events`, the picker after
/// `pick`. A `frame` only marks the snapshot (`drew`) while `panel` is the Frames panel, which
/// reads at its own pace. The status line comes with `tree` and `frame`
/// notifications themselves; extension topics and the replies to `ask` go into the snapshot.
effect fn pull(since: u64, selected: u32, panel: Panel) -> Message
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  let mut notes = List<String>.make()
  let open = run Link.take(&mut notes)
  let mut snapshot = emptySnapshot(since)
  let mut changed: u32 = 0
  let list = notes.asSlice()
  let mut i: usize = 0
  while i < list.length {
    let parsed = run Effect.result(Json.parse(list[i].ownedUtf8Bytes()))
    match move parsed {
      Result<Value, JsonError | OutOfMemoryError>.Success { value } => {
        let event = textField(&value, "event")
        if event == "" {
          // The reply to a request sent with `ask`.
          run snapshot.replies.append(run String.copy(String.view(&list[i])))
        } else if topicNamed(event) == 0 {
          run snapshot.news.append(run String.copy(event))
        }
        let topic = topicNamed(event)
        changed = changed | topic
        if topic == TOPIC_TREE || topic == TOPIC_FRAME {
          run parseStatus(&value, &mut snapshot.status)
          snapshot.info.take(readInfo(&value))
          snapshot.parts = snapshot.parts | PART_STATUS
        }
      }
      Result<Value, JsonError | OutOfMemoryError>.Failure { error } => {
        drop error
      }
    }
    i = i + 1
  }
  let mut error = String.make()
  if !open && changed == 0 && snapshot.news.length() == 0 && snapshot.replies.length() == 0 {
    run error.append("cannot reach the app: it closed the session")
    return Message.Failed { error: move error }
  }
  if u32.bitAnd(changed, TOPIC_TREE | TOPIC_ROOTS) != 0 {
    match run ask("{\"cmd\":\"tree\"}", &mut error) {
      Option<Value>.Some { value } => {
        run parseTree(&value, &mut snapshot.rows)
        snapshot.parts = snapshot.parts | PART_ROWS
      }
      Option<Value>.None => {
        return Message.Failed { error: move error }
      }
    }
    if selected != NO_PARENT {
      snapshot.detail = run inspectNode(selected)
      snapshot.parts = snapshot.parts | PART_DETAIL
    }
  }
  if u32.bitAnd(changed, TOPIC_EVENTS) != 0 {
    let events = run requestLine("events", "since", since)
    match run ask(String.view(&events), &mut error) {
      Option<Value>.Some { value } => {
        snapshot.next = run parseEvents(&value, &mut snapshot.events)
        snapshot.parts = snapshot.parts | PART_EVENTS
      }
      Option<Value>.None => {
        return Message.Failed { error: move error }
      }
    }
  }
  let mut quiet = String.make()
  if u32.bitAnd(changed, TOPIC_FRAME | TOPIC_TREE) != 0 {
    snapshot.drew = panel == Panel.Frames
  }
  if u32.bitAnd(changed, TOPIC_PICK) != 0 {
    match run ask("{\"cmd\":\"pickMode\"}", &mut quiet) {
      Option<Value>.Some { value } => {
        snapshot.picking = flagField(&value, "on", false)
        snapshot.picked = pickedOf(&value)
        snapshot.parts = snapshot.parts | PART_PICK
      }
      Option<Value>.None => {}
    }
  }
  if u32.bitAnd(changed, TOPIC_EDITS) != 0 {
    match run ask("{\"cmd\":\"edits\"}", &mut quiet) {
      Option<Value>.Some { value } => {
        snapshot.openChanges = run parseChanges(&value, &mut snapshot.changes)
        snapshot.parts = snapshot.parts | PART_EDITS
      }
      Option<Value>.None => {}
    }
  }
  return Message.Synced { snapshot: move snapshot }
}

/// Reads the last frame's stats and the timeline.
effect fn readFrames() -> Message
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  let mut error = String.make()
  let mut snapshot = emptySnapshot(0)
  match run ask("{\"cmd\":\"stats\"}", &mut error) {
    Option<Value>.Some { value } => {
      run parseStats(&value, &mut snapshot.stats)
      snapshot.parts = snapshot.parts | PART_STATS
    }
    Option<Value>.None => {
      return Message.Failed { error: move error }
    }
  }
  let mut quiet = String.make()
  let frames = run requestLine("frames", "limit", MAX_FRAMES)
  match run ask(String.view(&frames), &mut quiet) {
    Option<Value>.Some { value } => {
      snapshot.frames = Option<FrameView>.Some { value: run parseFrames(&value) }
    }
    Option<Value>.None => {}
  }
  return Message.Synced { snapshot: move snapshot }
}

/// `{"cmd":"highlight",...}` pointing at `node` and ringing `selected` (either NO_PARENT for
/// none).
effect fn highlightLine(node: u32, selected: u32) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut line = run String.copy("{\"cmd\":\"highlight\"")
  if node != NO_PARENT {
    run line.append(",\"nodes\":[")
    run writeInt(&mut line, u32.toU64(node))
    run line.append("]")
  }
  if selected != NO_PARENT {
    run line.append(",\"selected\":[")
    run writeInt(&mut line, u32.toU64(selected))
    run line.append("]")
  }
  run line.append("}")
  return move line
}

/// highlight, as a notification: hovering rows sends many, and none waits for an answer.
effect fn highlightNode(node: u32, selected: u32) -> Message
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  let line = run highlightLine(node, selected)
  if !run Link.notify(String.view(&line)) {
    return Message.Failed { error: run String.copy("cannot reach the app") }
  }
  return Message.Sent
}

effect fn subscribed(topics: u32, names: &List<String>) -> Message
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  if !run subscribe(topics, names) {
    return Message.Failed { error: run String.copy("cannot reach the app") }
  }
  return Message.Sent
}

effect fn pick(on: bool) -> Message
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  let mut error = String.make()
  let line = if on {
    "{\"cmd\":\"pickMode\",\"on\":true}"
  } else {
    "{\"cmd\":\"pickMode\",\"on\":false}"
  }
  return match run ask(line, &mut error) {
    Option<Value>.Some { value } => Message.Picking { on: flagField(&value, "on", false) }
    Option<Value>.None => Message.Failed { error: move error }
  }
}

/// What the panels show after an edit: the edit log and the node again, or why the app
/// refused.
effect fn afterEdit(line: string, node: u32, draft: bool) -> Message
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  let mut error = String.make()
  match run ask(line, &mut error) {
    Option<Value>.Some { value: _ } => {}
    Option<Value>.None => {
      return Message.StyleRefused { error: move error }
    }
  }
  let mut changes = List<ChangeRow>.make()
  let mut open: usize = 0
  let mut quiet = String.make()
  if let Option<Value>.Some { value } = run ask("{\"cmd\":\"edits\"}", &mut quiet) {
    open = run parseChanges(&value, &mut changes)
  }
  let detail = if node == NO_PARENT {
    Detail.none()
  } else {
    match run inspectNode(node) {
      Option<Detail>.Some { value } => move value
      Option<Detail>.None => Detail.none()
    }
  }
  return Message.Edited { changes: move changes, open: open, detail: move detail, draft: draft }
}

effect fn setStyle(node: u32, declarations: string, draft: bool) -> Message
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  let mut line = run String.copy("{\"cmd\":\"setStyle\",\"node\":")
  run writeInt(&mut line, u32.toU64(node))
  run line.append(",\"style\":")
  run writeString(&mut line, declarations)
  run line.append("}")
  return run afterEdit(String.view(&line), node, draft)
}

/// Sends `line` without waiting for its reply.
effect fn askLater(line: string, purpose: u32, index: usize) -> Message
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  let id = run Link.ask(line)
  if id == 0 {
    return Message.Failed { error: run String.copy("cannot reach the app") }
  }
  return Message.Asked { asked: Asked { id: id, purpose: purpose, index: index } }
}

effect fn runAudit() -> Message
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  let mut error = String.make()
  return match run ask("{\"cmd\":\"audit\"}", &mut error) {
    Option<Value>.Some { value } => {
      let mut issues = List<Issue>.make()
      let mut line = String.make()
      run parseIssues(&value, &mut issues, &mut line)
      Message.Audited { issues: move issues, line: move line }
    }
    Option<Value>.None => Message.Failed { error: move error }
  }
}

effect fn highlightAndInspect(node: u32) -> Message
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  let mut error = String.make()
  let line = run highlightLine(NO_PARENT, node)
  match run ask(String.view(&line), &mut error) {
    Option<Value>.Some { value: _ } => {}
    Option<Value>.None => {
      return Message.Failed { error: move error }
    }
  }
  return match run inspectNode(node) {
    Option<Detail>.Some { value } => Message.Inspected { detail: move value }
    Option<Detail>.None => Message.Inspected { detail: Detail.none() }
  }
}

effect fn unhighlight() -> Message
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  let mut error = String.make()
  return match run ask("{\"cmd\":\"highlight\"}", &mut error) {
    Option<Value>.Some { value: _ } => Message.Inspected { detail: Detail.none() }
    Option<Value>.None => Message.Failed { error: move error }
  }
}

impl Perform<Message, OutOfMemoryError ? &mut Link | &mut Allocator> for Command {
  effect fn perform(self: Self) -> Message
    ! OutOfMemoryError
    ? &mut Link | &mut Allocator {
    return match &self {
      Command.Sync { since, selected, panel, topics, names } => run syncAll(
        since,
        selected,
        panel,
        topics,
        &names,
      )
      Command.Pull { since, selected, panel } => run pull(since, selected, panel)
      Command.Frames => run readFrames()
      Command.Subscribe { topics, names } => run subscribed(topics, &names)
      Command.Ask { line, purpose, index } => run askLater(String.view(&line), purpose, index)
      Command.Highlight { node, selected } => run highlightNode(node, selected)
      Command.Inspect { node } => run highlightAndInspect(node)
      Command.Unhighlight => run unhighlight()
      Command.Pick { on } => run pick(on)
      Command.SetStyle { node, css: declarations, draft } => run setStyle(
        node,
        String.view(&declarations),
        draft,
      )
      Command.Edit { line, selected } => run afterEdit(String.view(&line), selected, false)
      Command.Audit => run runAudit()
    }
  }
}

// The look: `theme.silk`'s palette and helpers.

/// The box model's layers on the instrument black: amber outside the border, cyan inside it,
/// as the highlight in the app draws a node.
fn layerColor(name: string) -> Rgba<f32> {
  if name == "margin" {
    return rgba(theme.ACCENT, 0x14)
  }
  if name == "border" {
    return rgba(theme.ACCENT, 0x2E)
  }
  return rgba(theme.HOVER, 0x1A)
}

/// What ArrowUp and ArrowDown do in a field that holds numbers: step the last number by 1, by
/// 10 with Shift, by 0.1 with Alt, instead of moving the caret. The step, or 0 for another key.
fn stepOf(event: &Event) -> f32 {
  let key = String.view(&event.key)
  if key != "ArrowUp" && key != "ArrowDown" {
    return 0.0
  }
  let mut by: f32 = 1.0
  if u32.bitAnd(event.modifiers, MOD_SHIFT) != 0 {
    by = 10.0
  } else if u32.bitAnd(event.modifiers, MOD_ALT) != 0 {
    by = 0.1
  }
  if key == "ArrowDown" {
    by = -by
  }
  return by
}

/// The declarations field's keys: the arrows step the last number; Tab takes the first
/// completion while there are some.
fn draftKey(event: &Event, completions: bool) -> Reply<Message> {
  let by = stepOf(event)
  if by != 0.0 {
    return Reply<Message>.Custom {
      message: Option<Message>.some(Message.StepStyle { by: by }),
      stopPropagation: true,
      preventDefault: true,
    }
  }
  if completions && String.view(&event.key) == "Tab" && event.modifiers == 0 {
    return Reply<Message>.Custom {
      message: Option<Message>.some(Message.Complete { index: 0 }),
      stopPropagation: true,
      preventDefault: true,
    }
  }
  return Reply<Message>.Pass
}

/// A Design field's keys: the arrows step its last number and set it.
fn fieldKey(event: &Event, field: u32) -> Reply<Message> {
  let by = stepOf(event)
  if by == 0.0 {
    return Reply<Message>.Pass
  }
  return Reply<Message>.Custom {
    message: Option<Message>.some(Message.StepField { field: field, by: by }),
    stopPropagation: true,
    preventDefault: true,
  }
}

/// The look of a text input inside a field: Geist Mono 12 on nothing, the field draws the box.
fn bareInput(ui: &mut Ui<Message>, look: Look) -> () {
  theme.mono(&mut ui, look, theme.SIZE_BODY, theme.LINE_BODY)
  theme.fill(&mut ui)
  ui.style(
    &[
      css.height(px(theme.LINE_BODY)),
      css.paddingTop(px(0.0)),
      css.paddingBottom(px(0.0)),
      css.paddingLeft(px(0.0)),
      css.paddingRight(px(0.0)),
      css.borderTopWidth(px(0.0)),
      css.borderRightWidth(px(0.0)),
      css.borderBottomWidth(px(0.0)),
      css.borderLeftWidth(px(0.0)),
      css.backgroundColor(theme.clear()),
      css.color(rgb(theme.TEXT)),
      css.caretColor(rgb(theme.ACCENT)),
      css.selectionColor(rgba(theme.ACCENT, 0x55)),
      css.placeholderColor(rgb(theme.MUTED)),
      css.whiteSpace(WhiteSpace.Pre),
    ],
  )
}

/// "element-<id>", the test id of a row.
effect fn rowTestId(id: u32) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = run String.copy("element-")
  run writeInt(&mut text, u32.toU64(id))
  return move text
}

effect fn sizeText(value: f32) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = String.make()
  if value == 0.0 {
    run text.append("-")
  } else {
    run writeSize(&mut text, value)
  }
  return move text
}

effect fn contentText(box: &BoxNumbers) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = String.make()
  run writeSize(&mut text, box.width)
  run text.append(" × ")
  run writeSize(&mut text, box.height)
  return move text
}

/// The border box's size, `88 × 28`.
effect fn borderBoxText(box: &BoxNumbers) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = String.make()
  run writeSize(
    &mut text,
    box.width + box.padding.left + box.padding.right + box.border.left + box.border.right,
  )
  run text.append(" × ")
  run writeSize(
    &mut text,
    box.height + box.padding.top + box.padding.bottom + box.border.top + box.border.bottom,
  )
  return move text
}

effect fn positionText(box: &BoxNumbers) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = run String.copy("at ")
  run writeSize(&mut text, box.x)
  run text.append(", ")
  run writeSize(&mut text, box.y)
  if box.fragments > 1 {
    run text.append("  ·  first of ")
    run writeInt(&mut text, u32.toU64(box.fragments))
    run text.append(" fragments")
  }
  return move text
}

effect fn kindTestId(kind: string, id: u64) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = run String.copy(kind)
  run text.append("-")
  run writeInt(&mut text, id)
  return move text
}

effect fn changeTestId(id: u64) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  return run kindTestId("change", id)
}

effect fn authorText(author: string) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = run String.copy("— ")
  run text.append(author)
  return move text
}

effect fn replyText(reply: string) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = run String.copy("↳ ")
  run text.append(reply)
  return move text
}

/// The Edits segment's summary line.
effect fn changesLine(open: usize, all: usize) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = String.make()
  run writeInt(&mut text, usize.toU64(open))
  run text.append(" open of ")
  run writeInt(&mut text, usize.toU64(all))
  run text.append(
    ". Edits stay over the app until resolved or reset; agents read them with ui_edits.",
  )
  return move text
}

/// "Edits · <n>".
effect fn countedText(label: string, count: usize) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = run String.copy(label)
  run text.append(" · ")
  run writeInt(&mut text, usize.toU64(count))
  return move text
}

/// An edit's title on its card: `button "Add" · padding-left`, with its state when not base.
effect fn changeTitle(row: &ChangeRow) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = run String.copy(String.view(&row.label))
  if !row.comment {
    run text.append(" · ")
    run text.append(String.view(&row.property))
    if String.view(&row.state) != "base" && row.state.ownedByteLength() != 0 {
      run text.append(" (")
      run text.append(String.view(&row.state))
      run text.append(")")
    }
  }
  return move text
}

/// `{"cmd":"resetStyles"}` for the selected node (`node`), or for every node with NO_PARENT;
/// for one state and property when `state` is not empty.
effect fn resetLine(node: u32, state: string, property: string) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut line = run String.copy("{\"cmd\":\"resetStyles\"")
  if node != NO_PARENT {
    run line.append(",\"node\":")
    run writeInt(&mut line, u32.toU64(node))
  }
  if state != "" {
    run line.append(",\"state\":")
    run writeString(&mut line, state)
    run line.append(",\"property\":")
    run writeString(&mut line, property)
  }
  run line.append("}")
  return move line
}

effect fn resolveLine(id: u64, reopen: bool) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut line = run String.copy("{\"cmd\":\"resolve\",\"entry\":")
  run writeInt(&mut line, id)
  if reopen {
    run line.append(",\"reopen\":true")
  }
  run line.append("}")
  return move line
}

effect fn commentLine(node: u32, text: string) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut line = run String.copy("{\"cmd\":\"comment\",\"text\":")
  run writeString(&mut line, text)
  if node != NO_PARENT {
    run line.append(",\"node\":")
    run writeInt(&mut line, u32.toU64(node))
  }
  run line.append("}")
  return move line
}

effect fn seqText(seq: u64) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = String.make()
  run writeInt(&mut text, seq)
  return move text
}

/// The top bar's facts: where the app is, its viewport, its nodes and its protocol.
effect fn factsText(target: string, info: AppInfo) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = run String.copy(target)
  if info.width != 0.0 {
    run text.append(" · ")
    run writeSize(&mut text, info.width)
    run text.append("×")
    run writeSize(&mut text, info.height)
  }
  if info.nodes != 0 {
    run text.append(" · ")
    run writeInt(&mut text, info.nodes)
    run text.append(" nodes")
  }
  if info.protocol != 0 {
    run text.append(" · protocol ")
    run writeInt(&mut text, info.protocol)
  }
  return move text
}

/// "<index> of <count>" for the window chip.
effect fn ofText(index: u64, count: u64) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = String.make()
  run writeInt(&mut text, index)
  run text.append(" of ")
  run writeInt(&mut text, count)
  return move text
}

/// A node title (`button "Add" [add]`) in its two parts: the role or kind, and the rest.
fn titleParts(title: string) -> [string; 2] {
  return match String.find(title, " ") {
    Option<usize>.Some { value: at } => [
      String.slice(title, 0, at),
      String.slice(title, at, String.byteLength(title) - at),
    ]
    Option<usize>.None => [title, ""]
  }
}

/// A name in two inks on one line: `first` in `lead`, `rest` after it in `follow`.
fn twoInks(
  ui: &mut Ui<Message>,
  first: string,
  rest: string,
  lead: u32,
  follow: u32,
  strong: bool,
) -> () {
  ui.box(
    |ui| {
      theme.fill(&mut ui)
      theme.oneLine(&mut ui)
      ui.color(rgb(lead))
      if strong {
        theme.weight(&mut ui, theme.WEIGHT_MEDIUM)
      }
      ui.text(first)
      if rest != "" {
        ui.box(
          |ui| {
            ui.style(&[css.display(Keyword.Inline)])
            ui.color(rgb(follow))
            if strong {
              theme.weight(&mut ui, theme.WEIGHT_REGULAR)
            }
            ui.text(rest)
          },
        )
      }
    },
  )
}

fn ruleColor(rule: string) -> u32 {
  if rule == "contrast" || rule == "small-target" {
    return theme.ACCENT
  }
  return theme.REMOVED
}

/// The height of a bar for `value` when `scale` fills the timeline, at least `least` pixels.
fn barHeight(value: f32, scale: f32, least: f32) -> f32 {
  let mut height: f32 = 0.0
  if scale > 0.0 {
    height = value / scale * BAR_HEIGHT
  }
  if height < least {
    return least
  }
  if height > BAR_HEIGHT {
    return BAR_HEIGHT
  }
  return height
}

/// A swatch and what it stands for, in the timeline's legend.
fn legend(ui: &mut Ui<Message>, color: Rgba<f32>, text: string) -> () {
  ui.row(
    |ui| {
      ui.style(&[css.alignItems(Align.Center), css.columnGap(px(6.0))])
      ui.box(
        |ui| {
          theme.size(&mut ui, 8.0, 8.0)
          ui.style(&[css.borderRadius(px(2.0))])
          ui.background(color)
        },
      )
      theme.ink(&mut ui, theme.MUTED, text)
    },
  )
}

/// One layer of the box model diagram: `name` in the corner, the side widths around `inner`.
fn layer(
  ui: &mut Ui<Message>,
  look: Look,
  name: string,
  sides: Sides,
  dashed: bool,
  inner: fn(&mut Ui<Message>) -> (),
) -> () {
  ui.column(
    |ui| {
      ui.testId(name)
      ui.background(layerColor(name))
      theme.outline(&mut ui, theme.LINE_STRONG, 4.0)
      if dashed {
        ui.style(&[css.borderStyle(BorderStyle.Dashed)])
      }
      ui.style(&[css.alignItems(Align.Stretch)])
      theme.pad(&mut ui, 2.0, 6.0)
      theme.mono(&mut ui, look, theme.SIZE_LABEL, theme.LINE_TIGHT)
      ui.row(
        |ui| {
          ui.box(
            |ui| {
              theme.fill(&mut ui)
              theme.sans(&mut ui, look, theme.SIZE_SMALL, theme.LINE_TIGHT)
              ui.color(rgb(theme.MUTED))
              ui.text(name)
            },
          )
          ui.box(
            |ui| {
              let text = ui.alloc(sizeText(sides.top))
              ui.text(String.view(&text))
            },
          )
          ui.box(|ui| theme.fill(&mut ui))
        },
      )
      ui.row(
        |ui| {
          ui.style(&[css.alignItems(Align.Center), css.columnGap(px(6.0))])
          ui.box(
            |ui| {
              let text = ui.alloc(sizeText(sides.left))
              ui.text(String.view(&text))
            },
          )
          ui.column(
            |ui| {
              ui.grow(1.0)
              inner(&mut ui)
            },
          )
          ui.box(
            |ui| {
              let text = ui.alloc(sizeText(sides.right))
              ui.text(String.view(&text))
            },
          )
        },
      )
      ui.row(
        |ui| {
          ui.style(&[css.justifyContent(Align.Center)])
          ui.box(
            |ui| {
              let text = ui.alloc(sizeText(sides.bottom))
              ui.text(String.view(&text))
            },
          )
        },
      )
    },
  )
}

/// A section of the inspector: rules under it, 10 above and 12 below, its lines 8 apart.
fn group(ui: &mut Ui<Message>, gap: f32, body: fn(&mut Ui<Message>) -> ()) -> () {
  ui.column(
    |ui| {
      ui.style(
        &[
          css.flexShrink(0.0),
          css.rowGap(px(gap)),
          css.paddingTop(px(10.0)),
          css.paddingBottom(px(12.0)),
          css.paddingLeft(px(12.0)),
          css.paddingRight(px(12.0)),
        ],
      )
      theme.rule(&mut ui, Property.BorderBottomWidth, theme.LINE)
      body(&mut ui)
    },
  )
}

/// A line of fields 8 apart.
fn fieldLine(ui: &mut Ui<Message>, body: fn(&mut Ui<Message>) -> ()) -> () {
  ui.row(
    |ui| {
      ui.style(&[css.columnGap(px(8.0)), css.flexShrink(0.0)])
      body(&mut ui)
    },
  )
}

/// The head of a list in the middle column: a section label, and at the right its count and
/// what else `trailing` adds.
fn listHead(
  ui: &mut Ui<Message>,
  look: Look,
  label: string,
  count: string,
  inline: f32,
  trailing: fn(&mut Ui<Message>) -> (),
) -> () {
  ui.row(
    |ui| {
      ui.style(
        &[
          css.alignItems(Align.Center),
          css.justifyContent(Align.SpaceBetween),
          css.height(px(theme.SECTION_HEAD)),
          css.flexShrink(0.0),
          css.columnGap(px(10.0)),
          css.paddingLeft(px(inline)),
          css.paddingRight(px(inline)),
        ],
      )
      theme.sectionLabel(&mut ui, look, label)
      ui.row(
        |ui| {
          ui.style(&[css.alignItems(Align.Center), css.columnGap(px(10.0))])
          if count != "" {
            ui.box(
              |ui| {
                theme.mono(&mut ui, look, theme.SIZE_LABEL, theme.LINE_TIGHT)
                ui.color(rgb(theme.MUTED))
                ui.text(count)
              },
            )
          }
          trailing(&mut ui)
        },
      )
    },
  )
}

/// Muted text in a padded box: what a panel says when it has nothing to show.
fn hint(ui: &mut Ui<Message>, look: Look, text: string) -> () {
  ui.box(
    |ui| {
      theme.pad(&mut ui, 10.0, 12.0)
      theme.sans(&mut ui, look, theme.SIZE_BODY, theme.LINE_BODY)
      ui.color(rgb(theme.MUTED))
      ui.text(text)
    },
  )
}

impl Devtools {
  fn topBar(self: &Self, ui: &mut Ui<Message>) -> () {
    let look = self.look
    ui.row(
      |ui| {
        ui.accessRole(Role.Toolbar)
        ui.testId("toolbar")
        ui.style(
          &[
            css.alignItems(Align.Center),
            css.justifyContent(Align.SpaceBetween),
            css.columnGap(px(14.0)),
            css.height(px(theme.TOP_BAR)),
            css.flexShrink(0.0),
            css.boxSizing(BoxSizing.BorderBox),
            css.paddingLeft(px(12.0)),
            css.paddingRight(px(12.0)),
            css.overflowX(Overflow.Hidden),
          ],
        )
        ui.background(rgb(theme.SURFACE))
        theme.rule(&mut ui, Property.BorderBottomWidth, theme.LINE)
        ui.row(
          |ui| {
            ui.style(&[css.alignItems(Align.Center), css.columnGap(px(14.0)), css.flexShrink(0.0)])
            ui.row(
              |ui| {
                ui.style(&[css.alignItems(Align.Center), css.columnGap(px(8.0))])
                theme.dot(&mut ui, theme.ACCENT, 8.0, 2.0)
                ui.box(
                  |ui| {
                    theme.sans(&mut ui, look, theme.SIZE_BODY, theme.LINE_BODY)
                    theme.weight(&mut ui, theme.WEIGHT_STRONG)
                    ui.style(&[css.whiteSpace(WhiteSpace.Pre)])
                    ui.color(rgb(theme.TEXT))
                    ui.text("silk-ui devtools")
                  },
                )
              },
            )
            theme.separator(&mut ui, 16.0, 0.0)
            self.pickButton(&mut ui)
            if self.info.roots != 0 {
              self.windowChip(&mut ui)
            }
          },
        )
        ui.row(
          |ui| {
            ui.style(
              &[css.alignItems(Align.Center), css.columnGap(px(14.0)), css.minWidth(px(0.0))],
            )
            ui.box(
              |ui| {
                ui.testId("status")
                theme.mono(&mut ui, look, theme.SIZE_LABEL, theme.LINE_BODY)
                theme.oneLine(&mut ui)
                ui.style(&[css.flexShrink(1.0), css.minWidth(px(0.0))])
                if self.error.ownedByteLength() != 0 {
                  ui.color(rgb(theme.REMOVED))
                  ui.text(String.view(&self.error))
                } else {
                  ui.color(rgb(theme.MUTED))
                  let facts = ui.alloc(factsText(String.view(&self.target), self.info))
                  ui.label(String.view(&self.status))
                  ui.text(String.view(&facts))
                }
              },
            )
            theme.ghostButton(&mut ui, look, "refresh", "Refresh", || Message.Refresh)
            ui.pressable(
              || Message.ToggleLive,
              |ui| {
                ui.label("Live")
                ui.style(
                  &[
                    css.display(Keyword.Flex),
                    css.alignItems(Align.Center),
                    css.columnGap(px(6.0)),
                    css.flexShrink(0.0),
                    css.borderRadius(px(4.0)),
                  ],
                )
                theme.pad(&mut ui, 2.0, 4.0)
                ui.hover(&[css.backgroundColor(rgb(theme.LINE))])
                ui.focusVisible(&[css.backgroundColor(rgb(theme.LINE))])
                theme.dot(
                  &mut ui,
                  if self.live {
                    theme.ACCENT
                  } else {
                    theme.FAINT
                  },
                  6.0,
                  3.0,
                )
                ui.box(
                  |ui| {
                    theme.sans(&mut ui, look, theme.SIZE_BODY, theme.LINE_BODY)
                    theme.weight(&mut ui, theme.WEIGHT_MEDIUM)
                    ui.color(
                      rgb(
                        if self.live {
                          theme.TEXT
                        } else {
                          theme.MUTED
                        },
                      ),
                    )
                    ui.text("Live")
                  },
                )
              },
            )
            if self.info.frame != 0 {
              ui.box(
                |ui| {
                  theme.mono(&mut ui, look, theme.SIZE_LABEL, theme.LINE_BODY)
                  ui.style(&[css.flexShrink(0.0), css.whiteSpace(WhiteSpace.Pre)])
                  ui.color(rgb(theme.MUTED))
                  let frame = ui.alloc(seqText(self.info.frame))
                  ui.text("frame ")
                  ui.text(String.view(&frame))
                },
              )
            }
          },
        )
      },
    )
  }

  /// Pick: amber on a wash; lit while the app waits for the pick.
  fn pickButton(self: &Self, ui: &mut Ui<Message>) -> () {
    let look = self.look
    let on = self.picking
    ui.pressable(
      || Message.TogglePick,
      |ui| {
        ui.label("Pick")
        ui.style(
          &[
            css.display(Keyword.Flex),
            css.alignItems(Align.Center),
            css.columnGap(px(6.0)),
            css.height(px(24.0)),
            css.flexShrink(0.0),
            css.borderRadius(px(5.0)),
            css.paddingLeft(px(8.0)),
            css.paddingRight(px(8.0)),
          ],
        )
        if on {
          ui.background(rgb(theme.ACCENT))
        } else {
          ui.background(rgba(theme.ACCENT, theme.ACCENT_WASH))
          ui.hover(&[css.backgroundColor(rgba(theme.ACCENT, 0x33))])
        }
        ui.focusVisible(&[css.backgroundColor(rgba(theme.ACCENT, 0x33))])
        theme.icon(
          &mut ui,
          Icon.Pointer,
          if on {
            theme.INK
          } else {
            theme.ACCENT
          },
        )
        ui.box(
          |ui| {
            theme.sans(&mut ui, look, theme.SIZE_BODY, theme.LINE_BODY)
            theme.weight(&mut ui, theme.WEIGHT_MEDIUM)
            ui.color(
              rgb(
                if on {
                  theme.INK
                } else {
                  theme.ACCENT
                },
              ),
            )
            ui.text("Pick")
          },
        )
      },
    )
  }

  /// Which of the app's open roots the tree shows, and how many there are.
  fn windowChip(self: &Self, ui: &mut Ui<Message>) -> () {
    let look = self.look
    ui.row(
      |ui| {
        ui.testId("window")
        ui.style(
          &[
            css.alignItems(Align.Center),
            css.columnGap(px(6.0)),
            css.height(px(24.0)),
            css.flexShrink(0.0),
            css.boxSizing(BoxSizing.BorderBox),
            css.paddingLeft(px(8.0)),
            css.paddingRight(px(8.0)),
            css.whiteSpace(WhiteSpace.Pre),
          ],
        )
        theme.outline(&mut ui, theme.LINE, 5.0)
        ui.box(
          |ui| {
            theme.sans(&mut ui, look, theme.SIZE_BODY, theme.LINE_BODY)
            ui.color(rgb(theme.MUTED))
            ui.text("window")
          },
        )
        ui.box(
          |ui| {
            theme.mono(&mut ui, look, theme.SIZE_BODY, theme.LINE_BODY)
            ui.color(rgb(theme.TEXT))
            let root = ui.alloc(seqText(self.info.root))
            ui.text("#")
            ui.text(String.view(&root))
          },
        )
        ui.box(
          |ui| {
            theme.mono(&mut ui, look, theme.SIZE_BODY, theme.LINE_BODY)
            ui.color(rgb(theme.MUTED))
            let of = ui.alloc(ofText(1, self.info.roots))
            ui.text(String.view(&of))
          },
        )
      },
    )
  }

  /// The element tree: the filter, then a row per node.
  fn elements(self: &Self, ui: &mut Ui<Message>, width: f32) -> () {
    let look = self.look
    ui.column(
      |ui| {
        ui.style(
          &[
            css.width(px(width)),
            css.flexShrink(0.0),
            css.minHeight(px(0.0)),
            css.boxSizing(BoxSizing.BorderBox),
          ],
        )
        ui.background(rgb(theme.INK))
        theme.rule(&mut ui, Property.BorderRightWidth, theme.LINE)
        ui.row(
          |ui| {
            ui.style(
              &[
                css.alignItems(Align.Center),
                css.columnGap(px(8.0)),
                css.height(px(theme.TAB_BAR)),
                css.flexShrink(0.0),
                css.boxSizing(BoxSizing.BorderBox),
                css.paddingLeft(px(12.0)),
                css.paddingRight(px(12.0)),
              ],
            )
            theme.rule(&mut ui, Property.BorderBottomWidth, theme.LINE)
            theme.icon(&mut ui, Icon.Search, theme.MUTED)
            ui.input(
              String.view(&self.search),
              |ui| {
                ui.testId("search")
                ui.label("Filter elements")
                ui.placeholder("Filter elements")
                bareInput(&mut ui, look)
                theme.sans(&mut ui, look, theme.SIZE_BODY, theme.LINE_BODY)
                ui.onInput(|value| Message.Search { value: move value })
              },
            )
            ui.box(
              |ui| {
                theme.mono(&mut ui, look, theme.SIZE_LABEL, theme.LINE_BODY)
                ui.style(&[css.flexShrink(0.0)])
                ui.color(rgb(theme.MUTED))
                let count = ui.alloc(seqText(usize.toU64(self.shownRows())))
                ui.text(String.view(&count))
              },
            )
          },
        )
        ui.column(
          |ui| {
            ui.testId("elements")
            ui.accessRole(Role.List)
            ui.label("Elements")
            theme.scrolling(&mut ui)
            theme.mono(&mut ui, look, theme.SIZE_BODY, theme.LINE_BODY)
            ui.style(&[css.paddingTop(px(6.0)), css.paddingBottom(px(6.0))])
            if self.rows.length() == 0 {
              hint(&mut ui, look, "No elements yet.")
            }
            ui.each(
              self.rows.asSlice(),
              |row| u32.toU64(row.id),
              |ui, row| {
                if row.visible {
                  self.elementRow(&mut ui, row)
                }
              },
            )
          },
        )
      },
    )
  }

  /// How many rows show.
  fn shownRows(self: &Self) -> usize {
    let rows = self.rows.asSlice()
    let mut count: usize = 0
    let mut i: usize = 0
    while i < rows.length {
      if rows[i].visible {
        count = count + 1
      }
      i = i + 1
    }
    return count
  }

  fn elementRow(self: &Self, ui: &mut Ui<Message>, row: &Row) -> () {
    let look = self.look
    let selected = row.id == self.selected
    let hovered = row.id == self.hovered && !selected
    let folded = self.isCollapsed(row.id)
    ui.row(
      |ui| {
        ui.accessRole(Role.ListItem)
        ui.label(String.view(&row.label))
        let testId = ui.alloc(rowTestId(row.id))
        ui.testId(String.view(&testId))
        ui.cursor(Cursor.Pointer)
        ui.onClick(|| Message.Select { id: row.id })

        // The app highlights the node under the pointer, as Chrome's devtools do.
        ui.on(
          EventKind.PointerEnter,
          |event| Reply<Message>.Emit { message: Message.Hover { id: row.id } },
        )
        ui.on(
          EventKind.PointerLeave,
          |event| Reply<Message>.Emit { message: Message.Unhover { id: row.id } },
        )
        theme.rowLook(&mut ui, theme.TREE_ROW, 12.0 + u32.toF32(row.depth) * 14.0, 12.0, selected)
        if hovered {
          ui.background(rgba(theme.HOVER, theme.HOVER_WASH))
        }
        ui.style(&[css.columnGap(px(6.0))])
        if selected {
          ui.reveal()
        }
        ui.box(
          |ui| {
            theme.size(&mut ui, 10.0, 10.0)
            if row.children > 0 {
              ui.label(
                if folded {
                  "Unfold"
                } else {
                  "Fold"
                },
              )
              ui.on(
                EventKind.Click,
                |event| Reply<Message>.EmitAndStop { message: Message.Collapse { id: row.id } },
              )
              theme.icon(
                &mut ui,
                if folded {
                  Icon.Folded
                } else {
                  Icon.Open
                },
                if selected {
                  theme.ACCENT_DIM
                } else {
                  theme.MUTED
                },
              )
            }
          },
        )
        twoInks(
          &mut ui,
          String.view(&row.kind),
          String.view(&row.name),
          if selected {
            theme.ACCENT
          } else {
            theme.TEXT
          },
          if selected {
            theme.ACCENT_DIM
          } else {
            theme.MUTED
          },
          selected,
        )
        ui.box(
          |ui| {
            theme.sans(&mut ui, look, theme.SIZE_LABEL, theme.LINE_TIGHT)
            ui.style(
              &[
                css.width(px(72.0)),
                css.flexShrink(0.0),
                css.textAlign(TextAlign.Right),
                css.whiteSpace(WhiteSpace.Pre),
              ],
            )
            ui.color(
              rgb(
                if selected {
                  theme.ACCENT_DIM
                } else if hovered {
                  theme.HOVER
                } else {
                  theme.FAINT
                },
              ),
            )
            ui.text(String.view(&row.size))
          },
        )
      },
    )
  }

  /// The middle column's tabs: the panels the app renders, the devtools' own, then the
  /// extensions' data panels after a rule, each with its extension's id.
  fn tabs(self: &Self, ui: &mut Ui<Message>, stacked: bool) -> () {
    let look = self.look
    let onPanel = !(stacked && self.inspector)
    ui.row(
      |ui| {
        ui.accessRole(Role.TabList)
        ui.style(
          &[
            css.height(px(theme.TAB_BAR)),
            css.flexShrink(0.0),
            css.boxSizing(BoxSizing.BorderBox),
            css.paddingLeft(px(8.0)),
            css.paddingRight(px(8.0)),
            css.overflowX(Overflow.Auto),
            css.overflowY(Overflow.Hidden),
            css.scrollbarWidth(ScrollbarWidth.None),
          ],
        )
        theme.rule(&mut ui, Property.BorderBottomWidth, theme.LINE)
        if stacked {
          ui.key(9001)
          theme.tab(
            &mut ui,
            look,
            "Inspector",
            "",
            "",
            self.inspector,
            || Message.ShowInspector { shown: true },
          )
        }
        ui.enumerate(
          self.panels.asSlice(),
          |panel| 0,
          |ui, index, panel| {
            if panel.view.ownedByteLength() != 0 {
              ui.key(usize.toU64(index) + 1)
              theme.tab(
                &mut ui,
                look,
                String.view(&panel.title),
                "",
                "",
                onPanel && self.panel == Panel.Extension && self.shown == index,
                || Message.ShowPanel { index: index },
              )
            }
          },
        )
        ui.key(9002)
        theme.tab(
          &mut ui,
          look,
          "Events",
          "",
          "",
          onPanel && self.panel == Panel.Events,
          || Message.Show { panel: Panel.Events },
        )
        ui.key(9003)
        theme.tab(
          &mut ui,
          look,
          "Frames",
          "",
          "",
          onPanel && self.panel == Panel.Frames,
          || Message.Show { panel: Panel.Frames },
        )
        let issues = if self.issues.length() != 0 {
          ui.alloc(seqText(usize.toU64(self.issues.length())))
        } else {
          String.make()
        }
        ui.key(9004)
        theme.tab(
          &mut ui,
          look,
          "Audit",
          "",
          String.view(&issues),
          onPanel && self.panel == Panel.Audit,
          || Message.Show { panel: Panel.Audit },
        )
        if self.hasDataPanels() {
          ui.key(9005)
          theme.separator(&mut ui, 14.0, 4.0)
        }
        ui.enumerate(
          self.panels.asSlice(),
          |panel| 0,
          |ui, index, panel| {
            if panel.view.ownedByteLength() == 0 {
              ui.key(usize.toU64(index) + 1)
              theme.tab(
                &mut ui,
                look,
                String.view(&panel.title),
                String.view(&panel.extension),
                "",
                onPanel && self.panel == Panel.Extension && self.shown == index,
                || Message.ShowPanel { index: index },
              )
            }
          },
        )
      },
    )
  }

  fn hasDataPanels(self: &Self) -> bool {
    let panels = self.panels.asSlice()
    let mut i: usize = 0
    while i < panels.length {
      if panels[i].view.ownedByteLength() == 0 {
        return true
      }
      i = i + 1
    }
    return false
  }

  /// The middle column: its tabs and the panel that shows (or, stacked, the inspector).
  fn centre(self: &Self, ui: &mut Ui<Message>, stacked: bool) -> () {
    ui.column(
      |ui| {
        theme.fill(&mut ui)
        ui.style(&[css.minHeight(px(0.0))])
        ui.background(rgb(theme.INK))
        self.tabs(&mut ui, stacked)
        if stacked && self.inspector {
          ui.key(1)
          self.inspectorBody(&mut ui)
        } else {
          ui.key(2)
          self.panelBody(&mut ui)
        }
      },
    )
  }

  /// The panel the middle column shows.
  fn panelBody(self: &Self, ui: &mut Ui<Message>) -> () {
    ui.column(
      |ui| {
        ui.accessRole(Role.TabPanel)
        ui.testId("panel")
        if self.panel == Panel.Extension && self.showsView() {
          // The app's view fills the column and scrolls its own lists.
          theme.fill(&mut ui)
          ui.style(&[css.minHeight(px(0.0)), css.overflowY(Overflow.Hidden)])
        } else {
          theme.scrolling(&mut ui)
        }
        match self.panel {
          Panel.Events => self.eventLog(&mut ui)
          Panel.Frames => self.framesPanel(&mut ui)
          Panel.Audit => self.auditPanel(&mut ui)
          Panel.Extension => self.extensionPanel(&mut ui)
        }
      },
    )
  }

  fn showsView(self: &Self) -> bool {
    return match self.shownPanel() {
      Option<&PanelInfo>.Some { value: panel } => panel.view.ownedByteLength() != 0
      Option<&PanelInfo>.None => false
    }
  }

  /// The inspector column.
  fn inspectorColumn(self: &Self, ui: &mut Ui<Message>, width: f32) -> () {
    ui.column(
      |ui| {
        ui.style(
          &[
            css.width(px(width)),
            css.flexShrink(0.0),
            css.minHeight(px(0.0)),
            css.boxSizing(BoxSizing.BorderBox),
          ],
        )
        ui.background(rgb(theme.SURFACE))
        theme.rule(&mut ui, Property.BorderLeftWidth, theme.LINE)
        self.inspectorBody(&mut ui)
      },
    )
  }

  /// The inspector: the selected node, its segments, and the one that shows.
  fn inspectorBody(self: &Self, ui: &mut Ui<Message>) -> () {
    let look = self.look
    ui.column(
      |ui| {
        ui.testId("inspector")
        ui.style(
          &[
            css.flexShrink(0.0),
            css.rowGap(px(8.0)),
            css.paddingTop(px(10.0)),
            css.paddingBottom(px(10.0)),
            css.paddingLeft(px(12.0)),
            css.paddingRight(px(12.0)),
          ],
        )
        theme.rule(&mut ui, Property.BorderBottomWidth, theme.LINE)
        ui.row(
          |ui| {
            ui.style(
              &[
                css.alignItems(Align.Center),
                css.justifyContent(Align.SpaceBetween),
                css.columnGap(px(8.0)),
              ],
            )
            ui.box(
              |ui| {
                ui.testId("detail-title")
                theme.mono(&mut ui, look, theme.SIZE_TITLE, theme.LINE_BODY)
                theme.fill(&mut ui)
                ui.style(&[css.display(Keyword.Flex)])
                if self.detail.id == NO_PARENT {
                  ui.box(
                    |ui| {
                      theme.sans(&mut ui, look, theme.SIZE_BODY, theme.LINE_BODY)
                      ui.color(rgb(theme.MUTED))
                      ui.text("No selection")
                    },
                  )
                } else {
                  let parts = titleParts(String.view(&self.detail.title))
                  twoInks(&mut ui, parts[0], parts[1], theme.TEXT, theme.MUTED, true)
                }
              },
            )
            if self.detail.hasBox {
              let size = ui.alloc(borderBoxText(&self.detail.box))
              ui.box(
                |ui| {
                  theme.mono(&mut ui, look, theme.SIZE_LABEL, theme.LINE_BODY)
                  ui.style(&[css.flexShrink(0.0), css.whiteSpace(WhiteSpace.Pre)])
                  ui.color(rgb(theme.MUTED))
                  ui.text(String.view(&size))
                },
              )
            }
          },
        )
        theme.segmented(
          &mut ui,
          true,
          |ui| {
            ui.accessRole(Role.TabList)
            theme.segment(
              &mut ui,
              look,
              true,
              "Design",
              "",
              self.segment == Segment.Design,
              || Message.ShowSegment { segment: Segment.Design },
            )
            theme.segment(
              &mut ui,
              look,
              true,
              "Declarations",
              "",
              self.segment == Segment.Declarations,
              || Message.ShowSegment { segment: Segment.Declarations },
            )
            let count = if self.openChanges != 0 {
              ui.alloc(seqText(usize.toU64(self.openChanges)))
            } else {
              String.make()
            }
            ui.row(
              |ui| {
                ui.testId("changes-tab")
                theme.fill(&mut ui)
                ui.style(&[css.display(Keyword.Flex)])
                theme.segment(
                  &mut ui,
                  look,
                  true,
                  "Edits",
                  String.view(&count),
                  self.segment == Segment.Edits,
                  || Message.ShowSegment { segment: Segment.Edits },
                )
              },
            )
          },
        )
      },
    )
    ui.column(
      |ui| {
        ui.accessRole(Role.TabPanel)
        ui.testId("segment")
        theme.scrolling(&mut ui)
        match self.segment {
          Segment.Design => self.designSegment(&mut ui)
          Segment.Declarations => self.declarationsSegment(&mut ui)
          Segment.Edits => self.editsSegment(&mut ui)
        }
      },
    )
  }

  fn nothingSelected(self: &Self, ui: &mut Ui<Message>) -> bool {
    if self.detail.id == NO_PARENT {
      hint(&mut ui, self.look, "Select an element on the left, or press the down arrow.")
      return true
    }
    return false
  }

  /// One Design field: its label (or swatch), its value to type over, the edited mark.
  fn designField(self: &Self, ui: &mut Ui<Message>, field: u32, labelWidth: f32, width: f32) -> () {
    let look = self.look
    let edited = fieldEdited(&self.detail, field)
    ui.row(
      |ui| {
        theme.fieldLook(&mut ui, edited)
        if width == 0.0 {
          theme.fill(&mut ui)
        } else {
          ui.style(&[css.width(px(width)), css.flexShrink(0.0)])
        }
        ui.onEnter(|| Message.ApplyField { field: field })
        if field == FIELD_FILL || field == FIELD_BORDER {
          let value = if field == FIELD_FILL {
            computed(&self.detail, "background-color")
          } else {
            computed(&self.detail, "border-color")
          }
          let mut shown = Option<Rgba<f32>>.None
          if field == FIELD_FILL || computed(&self.detail, "border-style") != "none" {
            shown = swatchOf(value)
          }
          match shown {
            Option<Rgba<f32>>.Some { value: color } => theme.swatch(&mut ui, color, false)
            Option<Rgba<f32>>.None => theme.swatch(&mut ui, theme.clear(), true)
          }
        } else if fieldLabel(field) != "" {
          ui.box(
            |ui| {
              theme.sans(&mut ui, look, theme.SIZE_BODY, theme.LINE_BODY)
              ui.style(
                &[css.width(px(labelWidth)), css.flexShrink(0.0), css.whiteSpace(WhiteSpace.Pre)],
              )
              ui.color(rgb(theme.MUTED))
              ui.text(fieldLabel(field))
            },
          )
        }
        let text = ui.alloc(self.fieldShown(field))
        ui.input(
          String.view(&text),
          |ui| {
            ui.testId(fieldTestId(field))
            ui.label(fieldName(field))
            bareInput(&mut ui, look)
            let quiet = String.view(&text) == "none" || String.view(&text) == "-"
            if quiet && self.field != field {
              ui.style(&[css.color(rgb(theme.MUTED))])
            }
            if field == FIELD_FONT {
              ui.readOnly(true)
            }
            ui.onInput(|value| Message.FieldInput { field: field, value: move value })
            ui.onKeyDown(|event| fieldKey(event, field))
          },
        )
        if edited {
          theme.editedDot(&mut ui)
        }
      },
    )
  }

  /// Design: Layout, Fill · Border and Text fields, the other declarations, and this node's
  /// edits.
  fn designSegment(self: &Self, ui: &mut Ui<Message>) -> () {
    if self.nothingSelected(&mut ui) {
      return ()
    }
    let look = self.look
    group(
      &mut ui,
      8.0,
      |ui| {
        ui.testId("design")
        theme.sectionLabel(&mut ui, look, "Layout")
        fieldLine(
          &mut ui,
          |ui| {
            self.designField(&mut ui, FIELD_WIDTH, 12.0, 0.0)
            self.designField(&mut ui, FIELD_HEIGHT, 12.0, 0.0)
          },
        )
        fieldLine(
          &mut ui,
          |ui| {
            self.designField(&mut ui, FIELD_DIRECTION, 12.0, 0.0)
            self.designField(&mut ui, FIELD_GAP, 24.0, 0.0)
          },
        )
        fieldLine(
          &mut ui,
          |ui| {
            self.designField(&mut ui, FIELD_PADDING, 24.0, 0.0)
            self.designField(&mut ui, FIELD_ALIGN, 36.0, 0.0)
          },
        )
      },
    )
    group(
      &mut ui,
      8.0,
      |ui| {
        theme.sectionLabel(&mut ui, look, "Fill · Border")
        self.designField(&mut ui, FIELD_FILL, 0.0, 0.0)
        fieldLine(
          &mut ui,
          |ui| {
            self.designField(&mut ui, FIELD_BORDER, 0.0, 0.0)
            self.designField(&mut ui, FIELD_RADIUS, 40.0, 0.0)
          },
        )
      },
    )
    group(
      &mut ui,
      8.0,
      |ui| {
        theme.sectionLabel(&mut ui, look, "Text")
        fieldLine(
          &mut ui,
          |ui| {
            self.designField(&mut ui, FIELD_FONT, 0.0, 0.0)
            self.designField(&mut ui, FIELD_TEXT, 0.0, 72.0)
            self.designField(&mut ui, FIELD_WEIGHT, 0.0, 56.0)
          },
        )
      },
    )
    group(
      &mut ui,
      2.0,
      |ui| {
        ui.box(
          |ui| {
            ui.style(&[css.paddingBottom(px(6.0))])
            theme.sectionLabel(&mut ui, look, "Other declarations")
          },
        )
        self.otherDeclarations(&mut ui)
        ui.box(
          |ui| {
            ui.style(&[css.paddingTop(px(4.0))])
            self.draftEditor(&mut ui)
          },
        )
      },
    )
    self.nodeEdits(&mut ui)
  }

  /// The declarations the app sets on the node's base state that no field shows.
  fn otherDeclarations(self: &Self, ui: &mut Ui<Message>) -> () {
    let look = self.look
    let lines = self.detail.lines.asSlice()
    let marks = self.detail.marks.asSlice()
    let mut base = false
    let mut shown: usize = 0
    let mut i: usize = 0
    while i < lines.length {
      let line = String.view(&lines[i])
      if String.startsWith(line, "style ") {
        base = line == "style base {" || line == "style base edited {"
      } else if line == "}" {
        base = false
      } else if base {
        let name = nameOf(line)
        let mark = if i < marks.length {
          marks[i]
        } else {
          0
        }
        if name != "" && !covered(name) && mark != MARK_OVERRIDDEN {
          ui.key(usize.toU64(i) + 1)
          ui.row(
            |ui| {
              ui.style(&[css.alignItems(Align.Center), css.height(px(22.0)), css.flexShrink(0.0)])
              theme.mono(&mut ui, look, theme.SIZE_BODY, theme.LINE_BODY)
              theme.oneLine(&mut ui)
              let edited = mark == MARK_EDITED
              theme.fixed(
                &mut ui,
                if edited {
                  theme.ACCENT_DIM
                } else {
                  theme.MUTED
                },
                name,
              )
              theme.fixed(&mut ui, theme.MUTED, ": ")
              theme.ink(
                &mut ui,
                if edited {
                  theme.ACCENT
                } else {
                  theme.TEXT
                },
                valueOf(line),
              )
            },
          )
          shown = shown + 1
        }
      }
      i = i + 1
    }
    if shown == 0 {
      ui.box(
        |ui| {
          theme.sans(&mut ui, look, theme.SIZE_BODY, theme.LINE_BODY)
          ui.style(&[css.height(px(22.0))])
          ui.color(rgb(theme.FAINT))
          ui.text("None beyond the fields above.")
        },
      )
    }
  }

  /// The field declarations are typed into, its completions in a popup under it, and why the
  /// app refused the last ones.
  fn draftEditor(self: &Self, ui: &mut Ui<Message>) -> () {
    let look = self.look
    let completions = self.suggestions.length() != 0
    ui.column(
      |ui| {
        ui.style(&[css.rowGap(px(4.0)), css.flexShrink(0.0)])
        ui.row(
          |ui| {
            ui.style(&[css.alignItems(Align.Center), css.columnGap(px(6.0))])
            ui.onEnter(|| Message.ApplyStyle)
            ui.input(
              String.view(&self.draft),
              |ui| {
                ui.testId("style-draft")
                ui.label("Declarations to set")
                ui.placeholder("property: value  (arrows step numbers)")
                bareInput(&mut ui, look)
                ui.style(
                  &[
                    css.height(px(20.0)),
                    css.boxSizing(BoxSizing.BorderBox),
                    css.paddingTop(px(1.0)),
                    css.paddingBottom(px(1.0)),
                    css.paddingLeft(px(4.0)),
                    css.paddingRight(px(4.0)),
                    css.placeholderColor(rgb(theme.FAINT)),
                    css.backgroundColor(rgb(theme.INK)),
                  ],
                )
                theme.outline(
                  &mut ui,
                  if self.draft.ownedByteLength() != 0 {
                    theme.ACCENT
                  } else {
                    theme.LINE
                  },
                  3.0,
                )
                ui.focused(&[css.borderColor(rgb(theme.ACCENT))])
                ui.onInput(|value| Message.StyleDraft { value: move value })
                ui.onKeyDown(|event| draftKey(event, completions))
              },
            )
          },
        )
        if completions {
          ui.column(
            |ui| {
              ui.testId("suggestions")
              ui.accessRole(Role.List)
              ui.label("Completions")
              ui.style(&[css.width(px(200.0)), css.flexShrink(0.0)])
              theme.pad(&mut ui, 4.0, 4.0)
              theme.outline(&mut ui, theme.LINE_STRONG, 6.0)
              ui.background(rgb(theme.INK))
              theme.mono(&mut ui, look, theme.SIZE_BODY, theme.LINE_BODY)
              ui.enumerate(
                self.suggestions.asSlice(),
                |suggestion| 0,
                |ui, index, suggestion| {
                  ui.key(usize.toU64(index))
                  ui.pressable(
                    || Message.Complete { index: index },
                    |ui| {
                      ui.accessRole(Role.Option)
                      ui.label(String.view(&suggestion))
                      ui.style(
                        &[
                          css.display(Keyword.Flex),
                          css.alignItems(Align.Center),
                          css.justifyContent(Align.SpaceBetween),
                          css.height(px(24.0)),
                          css.flexShrink(0.0),
                          css.paddingLeft(px(8.0)),
                          css.paddingRight(px(8.0)),
                          css.borderRadius(px(4.0)),
                        ],
                      )
                      if index == 0 {
                        ui.background(rgba(theme.ACCENT, theme.ACCENT_CHOSEN))
                        ui.color(rgb(theme.ACCENT))
                      } else {
                        ui.color(rgb(theme.TEXT))
                        ui.hover(&[css.backgroundColor(rgba(theme.HOVER, theme.HOVER_WASH))])
                      }
                      ui.box(|ui| ui.text(String.view(&suggestion)))
                      if index == 0 {
                        ui.box(
                          |ui| {
                            theme.sans(&mut ui, look, theme.SIZE_SMALL, theme.LINE_BODY)
                            ui.color(rgb(theme.ACCENT_DIM))
                            ui.text("tab")
                          },
                        )
                      }
                    },
                  )
                },
              )
            },
          )
        }
        if self.styleError.ownedByteLength() != 0 {
          ui.box(
            |ui| {
              ui.testId("style-error")
              theme.sans(&mut ui, look, theme.SIZE_BODY, theme.LINE_BODY)
              ui.color(rgb(theme.REMOVED))
              ui.text(String.view(&self.styleError))
            },
          )
        }
      },
    )
  }

  /// This node's edits and comments, as cards, under the Design fields.
  fn nodeEdits(self: &Self, ui: &mut Ui<Message>) -> () {
    let look = self.look
    let rows = self.changes.asSlice()
    let mut count: usize = 0
    let mut i: usize = 0
    while i < rows.length {
      if rows[i].node == self.selected && rows[i].open {
        count = count + 1
      }
      i = i + 1
    }
    ui.column(
      |ui| {
        ui.style(
          &[
            css.flexShrink(0.0),
            css.rowGap(px(8.0)),
            css.paddingTop(px(10.0)),
            css.paddingBottom(px(12.0)),
            css.paddingLeft(px(12.0)),
            css.paddingRight(px(12.0)),
          ],
        )
        ui.row(
          |ui| {
            ui.style(&[css.alignItems(Align.Center), css.justifyContent(Align.SpaceBetween)])
            let head = ui.alloc(countedText("Edits", count))
            theme.sectionLabel(&mut ui, look, String.view(&head))
            ui.box(
              |ui| {
                theme.sans(&mut ui, look, theme.SIZE_LABEL, theme.LINE_BODY)
                ui.style(&[css.whiteSpace(WhiteSpace.Pre)])
                ui.color(rgb(theme.MUTED))
                ui.text("shared with agents over MCP")
              },
            )
          },
        )
        if count == 0 {
          ui.box(
            |ui| {
              theme.sans(&mut ui, look, theme.SIZE_BODY, theme.LINE_BODY)
              ui.color(rgb(theme.FAINT))
              ui.text("Type over a field, or a declaration above; the app keeps the edit.")
            },
          )
        }
        ui.enumerate(
          rows,
          |row| row.id,
          |ui, index, row| {
            if row.node == self.selected && row.open {
              self.changeCard(&mut ui, index, row, false)
            }
          },
        )
      },
    )
  }

  /// A card of the edit log: what changed, from what to what, or a comment, its replies, and
  /// with `actions` the buttons that resolve, reopen or take it back.
  fn changeCard(
    self: &Self,
    ui: &mut Ui<Message>,
    index: usize,
    row: &ChangeRow,
    actions: bool,
  ) -> () {
    let look = self.look
    let open = row.open
    theme.card(
      &mut ui,
      |ui| {
        if actions {
          let testId = ui.alloc(changeTestId(row.id))
          ui.testId(String.view(&testId))
          ui.accessRole(Role.ListItem)
        }
        ui.row(
          |ui| {
            ui.style(&[css.alignItems(Align.Center), css.columnGap(px(8.0))])
            theme.mono(&mut ui, look, theme.SIZE_BODY, theme.LINE_BODY)
            let title = ui.alloc(changeTitle(row))
            ui.box(
              |ui| {
                theme.fill(&mut ui)
                theme.oneLine(&mut ui)
                ui.color(
                  rgb(
                    if open {
                      theme.TEXT
                    } else {
                      theme.MUTED
                    },
                  ),
                )
                if row.node != NO_PARENT {
                  ui.cursor(Cursor.Pointer)
                  ui.onClick(|| Message.Select { id: row.node })
                }
                ui.text(String.view(&title))
              },
            )
            if !row.comment {
              ui.box(
                |ui| {
                  ui.style(&[css.flexShrink(0.0), css.whiteSpace(WhiteSpace.Pre)])
                  ui.color(rgb(theme.MUTED))
                  if !open {
                    ui.style(&[css.textDecorationLine(Keyword.LineThrough)])
                  }
                  let mut before = String.make()
                  ui.alloc(shortValue(String.view(&row.before), &mut before))
                  ui.text(String.view(&before))
                },
              )
              theme.fixed(&mut ui, theme.FAINT, "→")
              let mut after = String.make()
              ui.alloc(shortValue(String.view(&row.after), &mut after))
              theme.fixed(
                &mut ui,
                if open {
                  theme.ACCENT
                } else {
                  theme.ACCENT_DIM
                },
                String.view(&after),
              )
            }
          },
        )
        if row.comment {
          ui.box(
            |ui| {
              theme.sans(&mut ui, look, theme.SIZE_BODY, theme.LINE_BODY)
              ui.color(
                rgb(
                  if open {
                    theme.TEXT
                  } else {
                    theme.MUTED
                  },
                ),
              )
              ui.text(String.view(&row.text))
              if row.author.ownedByteLength() != 0 {
                let author = ui.alloc(authorText(String.view(&row.author)))
                ui.box(
                  |ui| {
                    ui.style(&[css.display(Keyword.Inline)])
                    ui.color(rgb(theme.FAINT))
                    ui.text("  ")
                    ui.text(String.view(&author))
                  },
                )
              }
            },
          )
        }
        ui.enumerate(
          row.thread.asSlice(),
          |reply| 0,
          |ui, k, reply| {
            ui.key(usize.toU64(k))
            ui.box(
              |ui| {
                theme.sans(&mut ui, look, theme.SIZE_BODY, theme.LINE_BODY)
                ui.style(&[css.paddingLeft(px(12.0))])
                ui.color(rgb(theme.MUTED))
                let line = ui.alloc(replyText(String.view(&reply)))
                ui.text(String.view(&line))
              },
            )
          },
        )
        if open && !row.applied && !row.comment {
          ui.box(
            |ui| {
              theme.sans(&mut ui, look, theme.SIZE_LABEL, theme.LINE_BODY)
              ui.color(rgb(theme.REMOVED))
              ui.text("Not applied: the node is gone.")
            },
          )
        }
        if actions {
          let id = row.id
          ui.row(
            |ui| {
              ui.style(
                &[
                  css.alignItems(Align.Center),
                  css.justifyContent(Align.FlexEnd),
                  css.columnGap(px(4.0)),
                ],
              )
              if !open {
                ui.box(
                  |ui| {
                    theme.fill(&mut ui)
                    theme.sans(&mut ui, look, theme.SIZE_LABEL, theme.LINE_BODY)
                    ui.color(rgb(theme.FAINT))
                    ui.text("resolved")
                  },
                )
              }
              if open {
                let resolve = ui.alloc(kindTestId("resolve", id))
                theme.ghostButton(
                  &mut ui,
                  look,
                  String.view(&resolve),
                  "Resolve",
                  || Message.Resolve { id: id, reopen: false },
                )
                if !row.comment {
                  let reset = ui.alloc(kindTestId("reset", id))
                  theme.ghostButton(
                    &mut ui,
                    look,
                    String.view(&reset),
                    "Reset",
                    || Message.ResetChange { index: index },
                  )
                }
              } else {
                let reopen = ui.alloc(kindTestId("reopen", id))
                theme.ghostButton(
                  &mut ui,
                  look,
                  String.view(&reopen),
                  "Reopen",
                  || Message.Resolve { id: id, reopen: true },
                )
              }
            },
          )
        }
      },
    )
  }

  /// Declarations: the field to type them into, the box model, then the node view.
  fn declarationsSegment(self: &Self, ui: &mut Ui<Message>) -> () {
    if self.nothingSelected(&mut ui) {
      return ()
    }
    let look = self.look
    group(
      &mut ui,
      8.0,
      |ui| {
        ui.row(
          |ui| {
            ui.style(&[css.alignItems(Align.Center), css.justifyContent(Align.SpaceBetween)])
            theme.sectionLabel(&mut ui, look, "Set declarations")
            ui.row(
              |ui| {
                ui.style(&[css.columnGap(px(2.0))])
                theme.ghostButton(&mut ui, look, "apply", "Apply", || Message.ApplyStyle)
                theme.ghostButton(&mut ui, look, "reset-styles", "Reset", || Message.ResetStyles)
              },
            )
          },
        )
        self.draftEditor(&mut ui)
      },
    )
    if self.detail.hasBox {
      group(
        &mut ui,
        8.0,
        |ui| {
          theme.sectionLabel(&mut ui, look, "Box model")
          self.boxModel(&mut ui)
        },
      )
    }
    ui.column(
      |ui| {
        ui.testId("declarations")
        ui.style(
          &[
            css.flexShrink(0.0),
            css.paddingTop(px(8.0)),
            css.paddingBottom(px(12.0)),
            css.paddingLeft(px(12.0)),
            css.paddingRight(px(12.0)),
          ],
        )
        theme.mono(&mut ui, look, theme.SIZE_BODY, theme.LINE_BODY)
        let marks = self.detail.marks.asSlice()
        ui.enumerate(
          self.detail.lines.asSlice(),
          |line| 0,
          |ui, index, line| {
            let text = String.view(&line)
            let mark = if index < marks.length {
              marks[index]
            } else {
              0
            }
            ui.key(usize.toU64(index))
            self.declarationLine(&mut ui, text, mark)
          },
        )
      },
    )
  }

  /// A line of the node view: a section heading, a declaration (an edit's in amber down a bar,
  /// one an edit hides struck through), or a fact about the node.
  fn declarationLine(self: &Self, ui: &mut Ui<Message>, text: string, mark: u8) -> () {
    ui.row(
      |ui| {
        ui.style(
          &[
            css.whiteSpace(WhiteSpace.Pre),
            css.minHeight(px(20.0)),
            css.alignItems(Align.Center),
            css.flexShrink(0.0),
            css.overflowX(Overflow.Hidden),
          ],
        )
        if mark == MARK_EDITED || mark == MARK_EDIT_HEAD {
          // An edit laid over the app's declarations: marked down its left side.
          ui.background(rgba(theme.ACCENT, theme.ACCENT_WASH))
          ui.style(
            &[
              css.borderLeftWidth(px(2.0)),
              css.borderStyle(BorderStyle.Solid),
              css.borderColor(rgb(theme.ACCENT)),
              css.paddingLeft(px(4.0)),
            ],
          )
        }
        if String.startsWith(text, "style ") {
          ui.style(&[css.marginTop(px(6.0))])
          if mark == MARK_EDIT_HEAD {
            ui.testId("edited-styles")
            ui.color(rgb(theme.ACCENT))
          } else {
            ui.color(rgb(theme.MUTED))
          }
          ui.text(text)
        } else if String.startsWith(text, "  ") {
          if mark == MARK_OVERRIDDEN {
            // The app's own declaration, hidden by an edit.
            ui.style(&[css.textDecorationLine(Keyword.LineThrough)])
            ui.color(rgb(theme.FAINT))
            ui.label("overridden")
            ui.text(text)
          } else {
            match String.find(text, ": ") {
              Option<usize>.Some { value: colon } => {
                ui.box(
                  |ui| {
                    ui.color(
                      rgb(
                        if mark == MARK_EDITED {
                          theme.ACCENT_DIM
                        } else {
                          theme.MUTED
                        },
                      ),
                    )
                    ui.text(String.slice(text, 0, colon))
                  },
                )
                ui.box(
                  |ui| {
                    ui.color(
                      rgb(
                        if mark == MARK_EDITED {
                          theme.ACCENT
                        } else {
                          theme.TEXT
                        },
                      ),
                    )
                    ui.text(String.slice(text, colon, String.byteLength(text) - colon))
                  },
                )
              }
              Option<usize>.None => {
                ui.color(rgb(theme.MUTED))
                ui.text(text)
              }
            }
          }
        } else {
          ui.color(rgb(theme.MUTED))
          ui.text(text)
        }
      },
    )
  }

  /// Edits: the whole edit log, a comment on the selected node, and taking everything back.
  fn editsSegment(self: &Self, ui: &mut Ui<Message>) -> () {
    let look = self.look
    group(
      &mut ui,
      8.0,
      |ui| {
        ui.row(
          |ui| {
            ui.style(&[css.alignItems(Align.Center), css.justifyContent(Align.SpaceBetween)])
            let head = ui.alloc(countedText("Edits", self.openChanges))
            theme.sectionLabel(&mut ui, look, String.view(&head))
            theme.ghostButton(&mut ui, look, "reset-all", "Reset all", || Message.ResetAll)
          },
        )
        ui.box(
          |ui| {
            ui.testId("changes-line")
            theme.sans(&mut ui, look, theme.SIZE_LABEL, theme.LINE_BODY)
            ui.color(rgb(theme.MUTED))
            let line = ui.alloc(changesLine(self.openChanges, self.changes.length()))
            ui.text(String.view(&line))
          },
        )
        ui.row(
          |ui| {
            ui.style(&[css.alignItems(Align.Center), css.columnGap(px(6.0))])
            ui.onEnter(|| Message.AddComment)
            ui.row(
              |ui| {
                theme.fieldLook(&mut ui, false)
                theme.fill(&mut ui)
                ui.input(
                  String.view(&self.comment),
                  |ui| {
                    ui.testId("comment-draft")
                    ui.label("Comment on this element")
                    ui.placeholder(
                      if self.selected == NO_PARENT {
                        "Comment on the app"
                      } else {
                        "Comment on this element"
                      },
                    )
                    bareInput(&mut ui, look)
                    theme.sans(&mut ui, look, theme.SIZE_BODY, theme.LINE_BODY)
                    ui.onInput(|value| Message.CommentDraft { value: move value })
                  },
                )
              },
            )
            theme.ghostButton(&mut ui, look, "add-comment", "Comment", || Message.AddComment)
          },
        )
      },
    )
    if self.changes.length() == 0 {
      hint(
        &mut ui,
        look,
        "No edits yet. Type over a Design field or a declaration, or comment on an element; an agent reads them with ui_edits.",
      )
      return ()
    }
    ui.column(
      |ui| {
        ui.testId("changes")
        ui.accessRole(Role.List)
        ui.style(
          &[
            css.flexShrink(0.0),
            css.rowGap(px(8.0)),
            css.paddingTop(px(10.0)),
            css.paddingBottom(px(12.0)),
            css.paddingLeft(px(12.0)),
            css.paddingRight(px(12.0)),
          ],
        )
        ui.enumerate(
          self.changes.asSlice(),
          |row| row.id,
          |ui, index, row| self.changeCard(&mut ui, index, row, true),
        )
      },
    )
  }

  fn boxModel(self: &Self, ui: &mut Ui<Message>) -> () {
    let look = self.look
    let b = self.detail.box
    ui.column(
      |ui| {
        ui.testId("box-model")
        ui.style(&[css.rowGap(px(6.0)), css.flexShrink(0.0)])
        layer(
          &mut ui,
          look,
          "margin",
          b.margin,
          true,
          |ui| {
            layer(
              &mut ui,
              look,
              "border",
              b.border,
              false,
              |ui| {
                layer(
                  &mut ui,
                  look,
                  "padding",
                  b.padding,
                  true,
                  |ui| {
                    ui.box(
                      |ui| {
                        ui.testId("content")
                        ui.background(rgba(theme.HOVER, 0x33))
                        theme.outline(&mut ui, theme.HOVER, 3.0)
                        ui.style(&[css.textAlign(TextAlign.Center)])
                        theme.pad(&mut ui, 4.0, 6.0)
                        ui.color(rgb(theme.TEXT))
                        let size = ui.alloc(contentText(&b))
                        ui.text(String.view(&size))
                      },
                    )
                  },
                )
              },
            )
          },
        )
        ui.box(
          |ui| {
            theme.mono(&mut ui, look, theme.SIZE_LABEL, theme.LINE_BODY)
            ui.color(rgb(theme.MUTED))
            let position = ui.alloc(positionText(&b))
            ui.text(String.view(&position))
          },
        )
      },
    )
  }

  fn eventLog(self: &Self, ui: &mut Ui<Message>) -> () {
    let look = self.look
    let count = ui.alloc(seqText(usize.toU64(self.events.length())))
    listHead(
      &mut ui,
      look,
      "Events, newest first",
      String.view(&count),
      12.0,
      |ui| theme.ghostButton(&mut ui, look, "clear-events", "Clear", || Message.ClearEvents),
    )
    if self.events.length() == 0 {
      hint(&mut ui, look, "No events yet. Use the app, then look here.")
      return ()
    }
    ui.column(
      |ui| {
        ui.testId("event-log")
        ui.accessRole(Role.List)
        theme.mono(&mut ui, look, theme.SIZE_BODY, theme.LINE_BODY)
        let rows = self.events.asSlice()
        let mut i = rows.length
        while i > 0 {
          i = i - 1
          let e = &rows[i]
          ui.key(e.seq)
          ui.row(
            |ui| {
              ui.accessRole(Role.ListItem)
              theme.rowLook(&mut ui, theme.LIST_ROW, 12.0, 12.0, false)
              ui.style(&[css.columnGap(px(10.0)), css.whiteSpace(WhiteSpace.Pre)])
              ui.box(
                |ui| {
                  theme.mono(&mut ui, look, theme.SIZE_LABEL, theme.LINE_BODY)
                  let seq = ui.alloc(seqText(e.seq))
                  theme.slot(&mut ui, 24.0, theme.FAINT, String.view(&seq))
                },
              )
              ui.box(
                |ui| {
                  ui.style(&[css.width(px(96.0)), css.flexShrink(0.0)])
                  ui.color(rgb(theme.TEXT))
                  ui.text(String.view(&e.kind))
                },
              )
              ui.box(
                |ui| {
                  theme.fill(&mut ui)
                  theme.oneLine(&mut ui)
                  ui.color(rgb(theme.MUTED))
                  ui.text(self.labelOf(e.target))
                },
              )
              ui.box(
                |ui| {
                  theme.mono(&mut ui, look, theme.SIZE_LABEL, theme.LINE_BODY)
                  ui.style(&[css.flexShrink(0.0)])
                  ui.color(rgb(theme.FAINT))
                  ui.text(String.view(&e.text))
                },
              )
            },
          )
        }
      },
    )
  }

  /// The timeline's bars as one canvas' marks: a node a bar would have the devtools lay out
  /// every bar again for each frame the app draws.
  fn barMarks(self: &Self, ui: &mut Ui<Message>, marks: &mut List<CanvasCommand>) -> () {
    let timed = self.frames.timed
    let scale = self.frames.scale
    let bars = self.frames.bars.asSlice()
    let mut i: usize = 0
    while i < bars.length {
      let bar = bars[i]
      let x = usize.toF32(i) * BAR_PITCH
      if timed {
        let over = bar.layout + bar.paint > FRAME_BUDGET
        let paint = barHeight(bar.paint, scale, 1.0)
        let layout = f32.min(barHeight(bar.layout, scale, 0.0), BAR_HEIGHT - paint)
        ui.alloc(
          marks.append(
            CanvasCommand.FillRect {
              x: x,
              y: BAR_HEIGHT - paint - layout,
              width: BAR_WIDTH,
              height: layout,
              radius: 0.0,
              color: rgb(
                if over {
                  theme.REMOVED
                } else {
                  theme.ACCENT_DIM
                },
              ),
            },
          ),
        )
        ui.alloc(
          marks.append(
            CanvasCommand.FillRect {
              x: x,
              y: BAR_HEIGHT - paint,
              width: BAR_WIDTH,
              height: paint,
              radius: 0.0,
              color: rgb(
                if over {
                  theme.REMOVED
                } else {
                  theme.ACCENT
                },
              ),
            },
          ),
        )
      } else {
        let height = barHeight(bar.fragments, scale, 1.0)
        ui.alloc(
          marks.append(
            CanvasCommand.FillRect {
              x: x,
              y: BAR_HEIGHT - height,
              width: BAR_WIDTH,
              height: height,
              radius: 0.0,
              color: rgb(
                if bar.skipped {
                  theme.FAINT
                } else {
                  theme.ACCENT
                },
              ),
            },
          ),
        )
      }
      i = i + 1
    }
  }

  fn framesPanel(self: &Self, ui: &mut Ui<Message>) -> () {
    let look = self.look
    listHead(&mut ui, look, "Frames, oldest first", "", 12.0, |ui| {})
    if self.frames.bars.length() == 0 {
      hint(&mut ui, look, "No frames yet.")
    } else {
      let timed = self.frames.timed
      ui.column(
        |ui| {
          ui.style(
            &[
              css.flexShrink(0.0),
              css.rowGap(px(8.0)),
              css.paddingLeft(px(12.0)),
              css.paddingRight(px(12.0)),
            ],
          )
          ui.row(
            |ui| {
              ui.testId("frame-bars")
              ui.label("Frames, oldest first")
              ui.style(
                &[
                  css.height(px(BAR_HEIGHT)),
                  css.flexShrink(0.0),
                  css.alignItems(Align.FlexEnd),
                  css.columnGap(px(1.0)),
                  css.overflowX(Overflow.Hidden),
                  css.overflowY(Overflow.Hidden),
                  css.borderRadius(px(4.0)),
                ],
              )
              theme.pad(&mut ui, 0.0, 4.0)
              ui.background(rgb(theme.SURFACE))
              theme.rule(&mut ui, Property.BorderBottomWidth, theme.LINE)
              let mut marks = List<CanvasCommand>.make()
              self.barMarks(&mut ui, &mut marks)
              ui.canvas(
                marks.asSlice(),
                |ui| {
                  theme.size(
                    &mut ui,
                    usize.toF32(self.frames.bars.length()) * BAR_PITCH,
                    BAR_HEIGHT,
                  )
                },
              )
            },
          )
          ui.row(
            |ui| {
              ui.style(&[css.columnGap(px(14.0))])
              theme.sans(&mut ui, look, theme.SIZE_LABEL, theme.LINE_BODY)
              if timed {
                legend(&mut ui, rgb(theme.ACCENT_DIM), "layout")
                legend(&mut ui, rgb(theme.ACCENT), "paint")
                legend(&mut ui, rgb(theme.REMOVED), "over 16.7 ms")
              } else {
                legend(&mut ui, rgb(theme.ACCENT), "laid out and painted")
                legend(&mut ui, rgb(theme.FAINT), "layout skipped")
              }
            },
          )
          ui.box(
            |ui| {
              ui.testId("frame-line")
              theme.mono(&mut ui, look, theme.SIZE_LABEL, theme.LINE_BODY)
              ui.color(rgb(theme.MUTED))
              ui.text(String.view(&self.frames.line))
            },
          )
        },
      )
    }
    ui.box(|ui| ui.style(&[css.height(px(8.0)), css.flexShrink(0.0)]))
    listHead(&mut ui, look, "Last frame", "", 12.0, |ui| {})
    if self.stats.length() == 0 {
      hint(&mut ui, look, "No frame stats yet.")
      return ()
    }
    ui.column(
      |ui| {
        ui.testId("stats")
        theme.mono(&mut ui, look, theme.SIZE_BODY, theme.LINE_BODY)
        ui.style(&[css.flexShrink(0.0), css.paddingBottom(px(8.0))])
        ui.enumerate(
          self.stats.asSlice(),
          |stat| 0,
          |ui, index, stat| {
            ui.key(usize.toU64(index))
            ui.row(
              |ui| {
                ui.style(
                  &[
                    css.alignItems(Align.Center),
                    css.height(px(22.0)),
                    css.flexShrink(0.0),
                    css.paddingLeft(px(12.0)),
                    css.paddingRight(px(12.0)),
                  ],
                )
                ui.box(
                  |ui| {
                    ui.style(&[css.width(px(220.0)), css.flexShrink(0.0)])
                    ui.color(rgb(theme.MUTED))
                    ui.text(String.view(&stat.name))
                  },
                )
                theme.ink(&mut ui, theme.TEXT, String.view(&stat.value))
              },
            )
          },
        )
      },
    )
  }

  fn auditPanel(self: &Self, ui: &mut Ui<Message>) -> () {
    let look = self.look
    listHead(
      &mut ui,
      look,
      "Audit",
      "",
      12.0,
      |ui| theme.ghostButton(&mut ui, look, "run-audit", "Run audit", || Message.RunAudit),
    )
    ui.box(
      |ui| {
        ui.testId("audit-line")
        theme.sans(&mut ui, look, theme.SIZE_BODY, theme.LINE_BODY)
        ui.style(
          &[css.paddingLeft(px(12.0)), css.paddingRight(px(12.0)), css.paddingBottom(px(6.0))],
        )
        ui.color(rgb(theme.MUTED))
        if self.auditLine.ownedByteLength() == 0 {
          ui.text("Checks names, roles, keyboard reach, target sizes and text contrast.")
        } else {
          ui.text(String.view(&self.auditLine))
        }
      },
    )
    ui.column(
      |ui| {
        ui.testId("issues")
        ui.accessRole(Role.List)
        ui.enumerate(
          self.issues.asSlice(),
          |issue| 0,
          |ui, index, issue| {
            ui.key(usize.toU64(index))
            ui.row(
              |ui| {
                ui.accessRole(Role.Button)
                ui.tabIndex(0)
                ui.cursor(Cursor.Pointer)
                ui.onClick(|| Message.Select { id: issue.node })
                ui.onEnter(|| Message.Select { id: issue.node })
                let chosen = issue.node == self.selected
                ui.style(
                  &[
                    css.columnGap(px(10.0)),
                    css.flexShrink(0.0),
                    css.paddingTop(px(6.0)),
                    css.paddingBottom(px(6.0)),
                    css.paddingRight(px(12.0)),
                  ],
                )
                if chosen {
                  ui.style(
                    &[
                      css.paddingLeft(px(10.0)),
                      css.borderLeftWidth(px(2.0)),
                      css.borderStyle(BorderStyle.Solid),
                      css.borderColor(rgb(theme.ACCENT)),
                      css.backgroundColor(rgba(theme.ACCENT, theme.ACCENT_WASH)),
                    ],
                  )
                } else {
                  ui.style(&[css.paddingLeft(px(12.0))])
                  ui.hover(&[css.backgroundColor(rgba(theme.HOVER, theme.HOVER_WASH))])
                }
                ui.focusVisible(&[css.backgroundColor(rgba(theme.HOVER, theme.HOVER_WASH))])
                ui.box(
                  |ui| {
                    theme.mono(&mut ui, look, theme.SIZE_LABEL, theme.LINE_BODY)
                    ui.style(
                      &[css.width(px(96.0)), css.flexShrink(0.0), css.alignSelf(Align.FlexStart)],
                    )
                    ui.color(rgb(ruleColor(String.view(&issue.rule))))
                    ui.text(String.view(&issue.rule))
                  },
                )
                ui.column(
                  |ui| {
                    theme.fill(&mut ui)
                    ui.box(
                      |ui| {
                        theme.mono(&mut ui, look, theme.SIZE_BODY, theme.LINE_BODY)
                        theme.oneLine(&mut ui)
                        ui.color(
                          rgb(
                            if issue.node == self.selected {
                              theme.ACCENT
                            } else {
                              theme.TEXT
                            },
                          ),
                        )
                        ui.text(String.view(&issue.label))
                      },
                    )
                    ui.box(
                      |ui| {
                        theme.sans(&mut ui, look, theme.SIZE_BODY, theme.LINE_BODY)
                        ui.color(rgb(theme.MUTED))
                        ui.text(String.view(&issue.message))
                      },
                    )
                  },
                )
              },
            )
          },
        )
      },
    )
  }

  /// An extension's panel: the app's view of it, or its data, members and elements in rows,
  /// nested ones indented.
  fn extensionPanel(self: &Self, ui: &mut Ui<Message>) -> () {
    let look = self.look
    if let Option<&PanelInfo>.Some { value: panel } = self.shownPanel() {
      if panel.view.ownedByteLength() != 0 {
        // The app renders the panel: its batches are replayed under this box (see `remote`).
        ui.key(1)
        ui.column(
          |ui| {
            ui.testId(VIEW_HOST)
            theme.fill(&mut ui)
            ui.style(&[css.minHeight(px(0.0)), css.alignSelf(Align.Stretch)])
            ui.grow(1.0)
          },
        )
        return ()
      }
      let title = String.view(&panel.title)
      ui.key(2)
      listHead(&mut ui, look, title, String.view(&panel.extension), 12.0, |ui| {})
    }
    if self.data.length() == 0 {
      hint(&mut ui, look, "No data yet.")
      return ()
    }
    ui.column(
      |ui| {
        ui.testId("panel-data")
        ui.accessRole(Role.List)
        theme.mono(&mut ui, look, theme.SIZE_BODY, theme.LINE_BODY)
        ui.enumerate(
          self.data.asSlice(),
          |row| 0,
          |ui, index, row| {
            ui.key(usize.toU64(index))
            ui.row(
              |ui| {
                ui.accessRole(Role.ListItem)
                theme.rowLook(&mut ui, 22.0, 12.0 + u32.toF32(row.depth) * 14.0, 12.0, false)
                ui.style(&[css.whiteSpace(WhiteSpace.Pre), css.columnGap(px(8.0))])
                theme.fixed(&mut ui, theme.MUTED, String.view(&row.key))
                ui.box(
                  |ui| {
                    theme.fill(&mut ui)
                    theme.oneLine(&mut ui)
                    ui.color(rgb(theme.TEXT))
                    ui.text(String.view(&row.value))
                  },
                )
              },
            )
          },
        )
      },
    )
  }
}

impl App<Message, Command> for Devtools {
  fn view(self: &Self, ui: &mut Ui<Message>) -> () {
    let look = self.look
    let columns = self.columns()
    ui.style(
      &[
        css.fontFamily(look.ui),
        css.fontSize(px(theme.SIZE_BODY)),
        css.lineHeight(px(theme.LINE_BODY)),
        css.color(rgb(theme.TEXT)),
        css.backgroundColor(rgb(theme.INK)),
      ],
    )
    ui.onLayout(|bounds| Message.Resized { width: bounds.xMax - bounds.xMin })
    self.topBar(&mut ui)
    ui.row(
      |ui| {
        ui.testId("columns")
        ui.style(
          &[
            css.flexGrow(1.0),
            css.flexShrink(1.0),
            css.flexBasis(px(0.0)),
            css.minHeight(px(0.0)),
            css.minWidth(px(0.0)),
            css.overflowX(Overflow.Hidden),
            css.overflowY(Overflow.Hidden),
          ],
        )
        self.elements(&mut ui, columns.tree)
        self.centre(&mut ui, columns.stacked)
        if !columns.stacked {
          self.inspectorColumn(&mut ui, columns.inspector)
        }
      },
    )
  }

  fn update(self: &mut Self, message: Message, cx: &mut Context<Command>) -> () {
    match move message {
      Message.Refresh => {
        self.sync(&mut cx)
      }
      Message.Tick { time: _ } => {
        if self.error.ownedByteLength() != 0 {
          self.framesDue = false
          self.sync(&mut cx)
        } else if self.framesDue {
          self.framesDue = false
          if self.panel == Panel.Frames {
            cx.command(Command.Frames)
          }
        }
      }
      Message.Pull => {
        cx.command(Command.Pull { since: self.since, selected: self.selected, panel: self.panel })
      }
      Message.Hover { id } => {
        self.hovered = id
        cx.command(
          Command.Highlight {
            node: if id == self.selected {
              NO_PARENT
            } else {
              id
            },
            selected: self.selected,
          },
        )
      }
      Message.Unhover { id } => {
        // The selection keeps its ring; the pointer may already be on another row.
        if self.hovered == id {
          self.hovered = NO_PARENT
          cx.command(Command.Highlight { node: NO_PARENT, selected: self.selected })
        }
      }
      Message.Sent => {}
      Message.ToggleLive => {
        self.live = !self.live
        if self.live {
          self.sync(&mut cx)
        } else {
          self.resubscribe(&mut cx)
        }
      }
      Message.Select { id } => {
        self.select(id, &mut cx)
      }
      Message.Collapse { id } => {
        let mut i: usize = 0
        let mut found = false
        while i < self.collapsed.length() {
          if self.collapsed.asSlice()[i] == id {
            drop self.collapsed.remove(i)
            found = true
          } else {
            i = i + 1
          }
        }
        if !found {
          cx.alloc(self.collapsed.append(id))
        }
        self.updateVisibility()
      }
      Message.Show { panel } => {
        self.panel = panel
        self.inspector = false
        self.sync(&mut cx)
      }
      Message.ShowPanel { index } => {
        self.panel = Panel.Extension
        self.shown = index
        self.inspector = false
        self.data.clear()
        self.sync(&mut cx)
      }
      Message.ShowSegment { segment } => {
        self.segment = segment
      }
      Message.ShowInspector { shown } => {
        self.inspector = shown
      }
      Message.Resized { width } => {
        self.width = width
      }
      Message.FieldInput { field, value } => {
        self.field = field
        self.fieldDraft = move value
      }
      Message.ApplyField { field } => {
        if self.field == field && self.selected != NO_PARENT {
          let mut declarations = String.make()
          if cx.alloc(fieldCss(field, String.view(&self.fieldDraft), &mut declarations)) {
            cx.command(
              Command.SetStyle { node: self.selected, css: move declarations, draft: false },
            )
          }
          self.field = NO_FIELD
          self.fieldDraft.clear()
        }
      }
      Message.StepField { field, by } => {
        if self.selected != NO_PARENT {
          // Stepped as the value of a declaration, so the declarations field's rules apply.
          let shown = cx.alloc(self.fieldShown(field))
          let mut typed = cx.alloc(String.copy("v: "))
          cx.alloc(typed.append(String.view(&shown)))
          let mut stepped = String.make()
          if cx.alloc(step(String.view(&typed), by, &mut stepped)) {
            let value = String.slice(String.view(&stepped), 3, stepped.ownedByteLength() - 3)
            let mut declarations = String.make()
            if cx.alloc(fieldCss(field, value, &mut declarations)) {
              cx.command(
                Command.SetStyle { node: self.selected, css: move declarations, draft: false },
              )
            }
            self.field = field
            self.fieldDraft = cx.alloc(String.copy(value))
          }
        }
      }
      Message.Search { value } => {
        self.search = move value
        self.updateVisibility()
      }
      Message.TogglePick => {
        self.picking = !self.picking
        cx.command(Command.Pick { on: self.picking })
      }
      Message.Picking { on } => {
        self.picking = on
      }
      Message.StyleDraft { value } => {
        self.draft = move value
        cx.alloc(suggest(String.view(&self.draft), &mut self.suggestions))
      }
      Message.ApplyStyle => {
        if self.selected != NO_PARENT && self.draft.ownedByteLength() != 0 {
          let declarations = cx.alloc(String.copy(String.view(&self.draft)))
          cx.command(Command.SetStyle { node: self.selected, css: move declarations, draft: true })
        }
      }
      Message.StepStyle { by } => {
        let mut next = String.make()
        if self.selected != NO_PARENT && cx.alloc(step(String.view(&self.draft), by, &mut next)) {
          self.draft = move next
          self.suggestions.clear()
          let declarations = cx.alloc(String.copy(String.view(&self.draft)))
          cx.command(Command.SetStyle { node: self.selected, css: move declarations, draft: false })
        }
      }
      Message.Complete { index } => {
        if index < self.suggestions.length() {
          let mut next = String.make()
          cx.alloc(
            complete(
              String.view(&self.draft),
              String.view(&self.suggestions.asSlice()[index]),
              &mut next,
            ),
          )
          self.draft = move next
          cx.alloc(suggest(String.view(&self.draft), &mut self.suggestions))
        }
      }
      Message.ResetStyles => {
        let line = cx.alloc(resetLine(self.selected, "", ""))
        cx.command(Command.Edit { line: move line, selected: self.selected })
      }
      Message.ResetAll => {
        let line = cx.alloc(resetLine(NO_PARENT, "", ""))
        cx.command(Command.Edit { line: move line, selected: self.selected })
      }
      Message.ResetChange { index } => {
        if index < self.changes.length() {
          let row = &self.changes.asSlice()[index]
          let line = cx.alloc(
            resetLine(row.node, String.view(&row.state), String.view(&row.property)),
          )
          cx.command(Command.Edit { line: move line, selected: self.selected })
        }
      }
      Message.Resolve { id, reopen } => {
        let line = cx.alloc(resolveLine(id, reopen))
        cx.command(Command.Edit { line: move line, selected: self.selected })
      }
      Message.CommentDraft { value } => {
        self.comment = move value
      }
      Message.AddComment => {
        if self.comment.ownedByteLength() != 0 {
          let line = cx.alloc(commentLine(self.selected, String.view(&self.comment)))
          self.comment.clear()
          cx.command(Command.Edit { line: move line, selected: self.selected })
        }
      }
      Message.Edited { changes, open, detail, draft } => {
        self.styleError.clear()
        if draft {
          self.draft.clear()
          self.suggestions.clear()
        }
        self.changes = move changes
        self.openChanges = open
        if detail.id != NO_PARENT && detail.id == self.selected {
          self.detail = move detail
        }
      }
      Message.StyleRefused { error } => {
        self.styleError = move error
      }
      Message.Asked { asked } => {
        cx.alloc(self.asked.append(asked))
      }
      Message.RunAudit => {
        cx.command(Command.Audit)
      }
      Message.Audited { issues, line } => {
        self.issues = move issues
        self.auditLine = move line
      }
      Message.SelectNext => {
        let id = self.step(true)
        self.select(id, &mut cx)
      }
      Message.SelectPrevious => {
        let id = self.step(false)
        self.select(id, &mut cx)
      }
      Message.ClearSelection => {
        self.selected = NO_PARENT
        self.detail = Detail.none()
        self.field = NO_FIELD
        cx.command(Command.Unhighlight)
      }
      Message.ClearEvents => {
        self.events.clear()
      }
      Message.Synced { snapshot } => {
        let mut s = move snapshot
        while s.replies.length() != 0 {
          let line = s.replies.remove(0)
          self.answered(&line, &mut cx)
        }
        let full = s.parts == PART_ALL
        if let Option<List<String>>.Some { value } = Intrinsic.replace(
          s.extensions,
          Option<List<String>>.None,
        ) {
          self.extensions = move value
          self.panels = Intrinsic.replace(s.panels, List<PanelInfo>.make())
          if self.panel == Panel.Extension && self.shown >= self.panels.length() {
            self.panel = Panel.Events
          }
          self.resubscribe(&mut cx)
        }
        if full || self.panelNews(&s.news) {
          self.readPanel(&mut cx)
        }
        if s.drew {
          self.framesDue = true
        }
        if s.parts == 0 && s.frames.isNone() {
          return ()
        }
        self.syncs = self.syncs + 1
        self.error.clear()
        if u32.bitAnd(s.parts, PART_STATUS) != 0 {
          self.status = Intrinsic.replace(s.status, String.make())
          self.info.take(s.info)
        }
        if u32.bitAnd(s.parts, PART_ROWS) != 0 {
          self.rows = Intrinsic.replace(s.rows, List<Row>.make())
          self.updateVisibility()
        }
        if u32.bitAnd(s.parts, PART_STATS) != 0 {
          self.stats = Intrinsic.replace(s.stats, List<Stat>.make())
        }
        if u32.bitAnd(s.parts, PART_EDITS) != 0 {
          self.changes = Intrinsic.replace(s.changes, List<ChangeRow>.make())
          self.openChanges = s.openChanges
        }

        if u32.bitAnd(s.parts, PART_EVENTS) != 0 {
          // Two reads may be out at once and answer with the same records.
          while s.events.length() != 0 {
            let e = s.events.remove(0)
            if e.seq > self.since {
              cx.alloc(self.events.append(move e))
            }
          }
          while self.events.length() > MAX_LOG {
            drop self.events.remove(0)
          }

          // `next` is the seq the next record gets; ask for the ones after the last.
          self.since = if s.next > 0 {
            s.next - 1
          } else {
            0
          }
        }

        match Intrinsic.replace(s.frames, Option<FrameView>.None) {
          Option<FrameView>.Some { value } => {
            self.frames = move value
          }
          Option<FrameView>.None => {}
        }

        // The press in the app's window ends the pick: select what it chose.
        if u32.bitAnd(s.parts, PART_PICK) != 0 && self.picking && !s.picking {
          self.picking = false
          if s.picked != NO_PARENT {
            self.expose(s.picked)
            self.select(s.picked, &mut cx)
            return ()
          }
        }
        if u32.bitAnd(s.parts, PART_DETAIL) != 0 && self.selected != NO_PARENT {
          match Intrinsic.replace(s.detail, Option<Detail>.None) {
            Option<Detail>.Some { value } => {
              self.detail = move value
            }
            Option<Detail>.None => {
              // The node is gone.
              self.selected = NO_PARENT
              self.detail = Detail.none()
            }
          }
        }
      }
      Message.Inspected { detail } => {
        self.detail = move detail
        if self.detail.id == NO_PARENT {
          self.selected = NO_PARENT
        }
      }
      Message.Failed { error } => {
        self.error = move error
      }
    }
  }

  fn subscriptions(self: &Self, subs: &mut Subscriptions<Message>) -> () {
    if self.error.ownedByteLength() != 0 {
      subs.every(1, RETRY_INTERVAL, |time| Message.Tick { time: time })
    } else if self.framesDue {
      subs.every(6, FRAMES_INTERVAL, |time| Message.Tick { time: time })
    }
    subs.keyBinding(2, "ArrowDown", 0, || Message.SelectNext)
    subs.keyBinding(3, "ArrowUp", 0, || Message.SelectPrevious)
    subs.keyBinding(4, "Escape", 0, || Message.ClearSelection)
    subs.keyBinding(5, "F5", 0, || Message.Refresh)
  }
}
