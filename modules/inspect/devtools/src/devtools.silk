//! The devtools window as a ui-app app: the inspected app's element tree on the left, and on
//! the right the selected node's styles (which can be edited), its box model, the program's
//! messages with the model after each, the event log, the frame timeline, an accessibility
//! audit and the frame stats. It talks to the app only through the inspector protocol (the
//! same requests ui-inspect-cli and ui-inspect-mcp send), over a [`Link`] the host provides.
//!
//! Hovering a row highlights its node in the app's window; selecting a row inspects that node
//! and keeps it highlighted; Pick selects the node pressed in the app's window instead. While
//! live (the default), the devtools subscribe to the app's topics and read again only what a
//! notification says changed (the host sends [`Message.Pull`] when one comes); while the app
//! cannot be reached, they try again every [`RETRY_INTERVAL`] seconds. Keys: ArrowDown and
//! ArrowUp move the selection, Escape clears it, F5 refreshes.
import ui_tree.css
import ui_tree.css { px, percent, none, Property }
import data {
  Row,
  Detail,
  LogRow,
  Stat,
  Snapshot,
  BoxNumbers,
  Sides,
  NO_PARENT,
  parseTree,
  parseDetail,
  parseEvents,
  parseStats,
  parseStatus,
  parseSteps,
  parseProgram,
  parseModel,
  parseFrames,
  parseIssues,
  parseExtensions,
  parseData,
  matches,
  PanelInfo,
  DataRow,
  ASK_DATA,
  Asked,
  ASK_STEPS,
  ASK_PROGRAM,
  ASK_MODEL,
  writeSize,
  StepRow,
  ModelView,
  ProgramView,
  FrameView,
  Issue,
  ADDED,
  REMOVED,
  FRAME_BUDGET,
  PART_STATUS,
  PART_ROWS,
  PART_STATS,
  PART_EVENTS,
  PART_DETAIL,
  PART_PICK,
  PART_ALL
}
import link { Link }
import ui_inspect_server.topics {
  TOPIC_TREE,
  TOPIC_FRAME,
  TOPIC_EVENTS,
  TOPIC_ROOTS,
  TOPIC_PICK,
  TOPIC_COUNT,
  TOPIC_NAMES,
  topicNamed
}
import ui_app.app { App, Perform, Context, Subscriptions }
import ui_app.ui { Ui, Reply }
import ui_inspect_server.reply { textField, flagField, idField, writeString }
import ui_tree.inspect { writeInt }
import ui_tree.mutation { Align, Role, Cursor, BorderStyle, Overflow, WhiteSpace, TextAlign }
import ui_tree.node { EventKind }
import silk.collections.list { List }
import silk.color.rgba { Rgba }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.json.scanner { JsonError }
import silk.json.value { Json, Value }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.text.string { String }

/// Seconds between tries while the app cannot be reached.
pub const RETRY_INTERVAL: f64 = 1.0

/// How many event records the log keeps.
pub const MAX_LOG: usize = 200

/// The font family the host defines for the window (`Noto Sans, sans-serif` in the window and
/// the tests). Devtools in the app's own tree use one of their own (`Devtools.font`).
pub const FONT: u32 = 1

/// The tabs of the side panel.
pub enum Panel {
  Styles,
  BoxModel,
  /// The program's messages and the model after each.
  Program,
  Events,
  /// The frame timeline.
  Frames,
  Audit,
  Stats,
  /// A panel an extension of the app adds (`Devtools.shown` says which).
  Extension,
}

/// How many frames the timeline shows.
pub const MAX_FRAMES: u64 = 120

/// The height of the timeline's bars, in pixels.
const BAR_HEIGHT: f32 = 96.0

pub union Message {
  /// Read everything again.
  Refresh,
  /// The timer that tries again while the app cannot be reached.
  Tick { pub time: f64 },
  /// Notifications from the app wait: read what they say changed.
  Pull,
  /// The pointer entered or left the row of node `id`.
  Hover { pub id: u32 },
  Unhover { pub id: u32 },
  /// A notification went to the app.
  Sent,
  ToggleLive,
  /// Inspect and highlight node `id`.
  Select { pub id: u32 },
  /// Fold or unfold the children of node `id`.
  Collapse { pub id: u32 },
  Show { pub panel: Panel },
  /// Show the extension panel at `index` of `Devtools.panels`.
  ShowPanel { pub index: usize },
  SelectNext,
  SelectPrevious,
  ClearSelection,
  ClearEvents,
  /// The filter over the elements changed.
  Search { pub value: String },
  /// Start or stop picking in the app's window.
  TogglePick,
  Picking { pub on: bool },
  /// The declarations being typed for the selected node.
  StyleDraft { pub value: String },
  /// Set the typed declarations on the selected node.
  ApplyStyle,
  /// Take every style edit back.
  ResetStyles,
  /// The app took the edit; `detail` is the node after it.
  Styled { pub detail: Detail },
  StyleRefused { pub error: String },
  /// Open the model after message `seq`, or close it when it is open.
  OpenStep { pub seq: u64 },
  /// A request went out whose reply comes with the notifications.
  Asked { pub asked: Asked },
  ClearSteps,
  RunAudit,
  Audited { pub issues: List<Issue>, pub line: String },
  Synced { pub snapshot: Snapshot },
  Inspected { pub detail: Detail },
  Failed { pub error: String },
}

pub union Command {
  /// Subscribe to `topics` (`TOPIC_*` bits) and the extension topics `names`, then read
  /// status, tree, stats, the events after `since`, what `panel` shows besides, and node
  /// `selected` again.
  Sync {
    pub since: u64,
    pub selected: u32,
    pub panel: Panel,
    pub topics: u32,
    pub names: List<String>,
  },
  /// Take the app's notifications and read again what they say changed.
  Pull { pub since: u64, pub selected: u32, pub panel: Panel },
  /// Subscribe to exactly `topics` and `names`.
  Subscribe { pub topics: u32, pub names: List<String> },
  /// Send request `line` without waiting; its reply comes with the notifications.
  Ask { pub line: String, pub purpose: u32, pub index: usize },
  /// Highlight node `node` alone, or nothing for NO_PARENT, without waiting for an answer.
  Highlight { pub node: u32 },
  /// Highlight node `node` and inspect it.
  Inspect { pub node: u32 },
  /// Clear the highlight.
  Unhighlight,
  /// Turn picking in the app's window on or off.
  Pick { pub on: bool },
  /// Set declarations `css` on node `node`.
  SetStyle { pub node: u32, pub css: String },
  /// Take every style edit back, and inspect `selected` again.
  ResetStyles { pub selected: u32 },
  Audit,
}

/// The devtools model.
pub struct Devtools {
  /// Where the app is, as the status line names it.
  pub target: String,
  pub live: bool,
  pub panel: Panel,
  pub rows: List<Row>,
  /// Nodes whose children are folded.
  pub collapsed: List<u32>,
  /// The selected node, or NO_PARENT.
  pub selected: u32,
  pub detail: Detail,
  pub stats: List<Stat>,
  /// The newest [`MAX_LOG`] event records, oldest first.
  pub events: List<LogRow>,
  /// The `seq` of the last record read.
  pub since: u64,
  pub status: String,
  /// Why the last request failed, or empty.
  pub error: String,
  /// Refreshes that reached the app.
  pub syncs: u64,
  /// The filter over the elements; rows whose label does not contain it are hidden.
  pub search: String,
  /// Whether the app's window is waiting for a pick.
  pub picking: bool,
  /// The declarations being typed for the selected node.
  pub draft: String,
  /// Why the app refused the last style edit, or empty.
  pub styleError: String,
  pub program: ProgramView,
  /// The newest [`MAX_LOG`] messages the program handled, oldest first.
  pub steps: List<StepRow>,
  /// The `seq` of the last message read.
  pub sinceStep: u64,
  /// The model of the open step.
  pub opened: ModelView,
  pub frames: FrameView,
  pub issues: List<Issue>,
  /// The audit's summary, or empty before the first one.
  pub auditLine: String,
  /// The node whose row the pointer is over, or NO_PARENT.
  pub hovered: u32,
  /// The topics subscribed to, as `TOPIC_*` bits.
  pub topics: u32,
  /// The font family the devtools draw with: [`FONT`] unless they share the app's tree.
  pub font: u32,
  /// The ids of the app's extensions, and the panels they add.
  pub extensions: List<String>,
  pub panels: List<PanelInfo>,
  /// The extension topics subscribed to.
  pub names: List<String>,
  /// The requests whose replies come with the notifications.
  pub asked: List<Asked>,
  /// The extension panel shown while `panel` is `Extension`, and its data as the generic view
  /// shows it.
  pub shown: usize,
  pub data: List<DataRow>,
}

impl Devtools {
  /// A window looking at the app at `target` (shown in the status line).
  pub effect fn make(target: string) -> Devtools
    ! OutOfMemoryError
    ? &mut Allocator {
    return Devtools {
      target: run String.copy(target),
      live: true,
      panel: Panel.Styles,
      rows: List<Row>.make(),
      collapsed: List<u32>.make(),
      selected: NO_PARENT,
      detail: Detail.none(),
      stats: List<Stat>.make(),
      events: List<LogRow>.make(),
      since: 0,
      status: run String.copy("connecting"),
      error: String.make(),
      syncs: 0,
      search: String.make(),
      picking: false,
      draft: String.make(),
      styleError: String.make(),
      program: ProgramView {
        attached: false,
        line: String.make(),
        subscriptions: List<String>.make(),
      },
      steps: List<StepRow>.make(),
      sinceStep: 0,
      opened: ModelView.none(),
      frames: FrameView.none(),
      issues: List<Issue>.make(),
      auditLine: String.make(),
      hovered: NO_PARENT,
      topics: 0,
      font: FONT,
      extensions: List<String>.make(),
      panels: List<PanelInfo>.make(),
      names: List<String>.make(),
      asked: List<Asked>.make(),
      shown: 0,
      data: List<DataRow>.make(),
    }
  }

  /// The extension panel that shows, if one does.
  pub fn shownPanel(self: &Self) -> Option<&PanelInfo> {
    if self.panel != Panel.Extension || self.shown >= self.panels.length() {
      return Option<&PanelInfo>.None
    }
    return Option<&PanelInfo>.some(&self.panels.asSlice()[self.shown])
  }

  /// Whether the app has extension `id`.
  pub fn hasExtension(self: &Self, id: string) -> bool {
    let list = self.extensions.asSlice()
    let mut i: usize = 0
    while i < list.length {
      if String.view(&list[i]) == id {
        return true
      }
      i = i + 1
    }
    return false
  }

  /// Whether the Program panel can show: the app runs a silk-ui program.
  pub fn hasProgram(self: &Self) -> bool {
    return self.hasExtension("silk-ui")
  }

  /// The extension topics to subscribe to: while live, the program's messages while its panel
  /// shows.
  effect fn wantedNames(self: &Self) -> List<String>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut names = List<String>.make()
    if self.live && self.panel == Panel.Program && self.hasProgram() {
      run names.append(run String.copy("silk-ui.message"))
    }
    if self.live {
      if let Option<&PanelInfo>.Some { value: panel } = self.shownPanel() {
        if panel.topic.ownedByteLength() != 0 {
          run names.append(run String.copy(String.view(&panel.topic)))
        }
      }
    }
    return move names
  }

  /// Reads the data of the extension panel that shows, when it has data.
  fn readPanel(self: &mut Self, cx: &mut Context<Command>) -> () {
    let mut line = String.make()
    if let Option<&PanelInfo>.Some { value: panel } = self.shownPanel() {
      if panel.data.ownedByteLength() != 0 {
        line = cx.alloc(String.copy("{\"cmd\":"))
        cx.alloc(writeString(&mut line, String.view(&panel.data)))
        cx.alloc(line.append("}"))
      }
    }
    if line.ownedByteLength() != 0 {
      let index = self.shown
      self.ask(&mut cx, String.view(&line), ASK_DATA, index)
    }
  }

  /// Whether `names` has the topic of the extension panel that shows.
  fn panelNews(self: &Self, names: &List<String>) -> bool {
    if let Option<&PanelInfo>.Some { value: panel } = self.shownPanel() {
      let list = names.asSlice()
      let mut i: usize = 0
      while i < list.length {
        if panel.topic.ownedByteLength() != 0
          && String.view(&list[i]) == String.view(&panel.topic) {
          return true
        }
        i = i + 1
      }
    }
    return false
  }

  /// Sends request `line` for `purpose` without waiting.
  fn ask(
    self: &mut Self,
    cx: &mut Context<Command>,
    line: string,
    purpose: u32,
    index: usize,
  ) -> () {
    let copied = cx.alloc(String.copy(line))
    cx.command(Command.Ask { line: move copied, purpose: purpose, index: index })
  }

  /// Reads what the Program panel shows, when it shows.
  fn readProgram(self: &mut Self, cx: &mut Context<Command>) -> () {
    if self.panel != Panel.Program || !self.hasProgram() {
      return ()
    }
    let messages = cx.alloc(requestLine("silk-ui.messages", "since", self.sinceStep))
    self.ask(&mut cx, String.view(&messages), ASK_STEPS, 0)
    self.ask(&mut cx, "{\"cmd\":\"silk-ui.program\"}", ASK_PROGRAM, 0)
  }

  /// Takes the reply `line` to a request sent with `ask`.
  fn answered(self: &mut Self, line: &String, cx: &mut Context<Command>) -> () {
    let parsed = cx.alloc(Effect.result(Json.parse(line.ownedUtf8Bytes())))
    let reply = match move parsed {
      Result<Value, JsonError | OutOfMemoryError>.Success { value } => move value
      Result<Value, JsonError | OutOfMemoryError>.Failure { error } => {
        drop error
        return ()
      }
    }
    let id = match Json.asU64(Json.field(&reply, "id")) {
      Option<u64>.Some { value } => value
      Option<u64>.None => {
        return ()
      }
    }
    let mut at: usize = 0
    while at < self.asked.length() && self.asked.asSlice()[at].id != id {
      at = at + 1
    }
    if at == self.asked.length() {
      return ()
    }
    let asked = self.asked.remove(at)
    if !ok(&reply) {
      return ()
    }
    if asked.purpose == ASK_STEPS {
      let mut steps = List<StepRow>.make()
      let next = cx.alloc(parseSteps(&reply, &mut steps))
      self.addSteps(move steps, next, &mut cx)
    } else if asked.purpose == ASK_PROGRAM {
      self.program = cx.alloc(parseProgram(&reply))
    } else if asked.purpose == ASK_MODEL {
      self.opened = cx.alloc(parseModel(&reply))
    } else if asked.purpose == ASK_DATA && self.panel == Panel.Extension
      && asked.index == self.shown {
      cx.alloc(parseData(&reply, &mut self.data))
    }
  }

  /// Adds the messages read after the last one, `next` the seq the next one gets.
  fn addSteps(self: &mut Self, steps: List<StepRow>, next: u64, cx: &mut Context<Command>) -> () {
    let mut list = move steps

    // A program that started again counts from one: what was read is another run's.
    if next <= self.sinceStep {
      self.steps.clear()
      self.opened = ModelView.none()
    }
    let mut held: u64 = 0
    if self.steps.length() != 0 {
      held = self.steps.asSlice()[self.steps.length() - 1].seq
    }
    while list.length() != 0 {
      let step = list.remove(0)
      if step.seq > held {
        held = step.seq
        cx.alloc(self.steps.append(move step))
      }
    }
    while self.steps.length() > MAX_LOG {
      drop self.steps.remove(0)
    }
    self.sinceStep = if next > 0 {
      next - 1
    } else {
      0
    }
  }

  fn isCollapsed(self: &Self, id: u32) -> bool {
    let list = self.collapsed.asSlice()
    let mut i: usize = 0
    while i < list.length {
      if list[i] == id {
        return true
      }
      i = i + 1
    }
    return false
  }

  /// Marks the rows under folded nodes hidden; with a filter, the rows that do not match it.
  fn updateVisibility(self: &mut Self) -> () {
    let mut hideBelow: u32 = 4294967295
    let n = self.rows.length()
    let mut i: usize = 0
    if self.search.ownedByteLength() != 0 {
      while i < n {
        let shown = matches(String.view(&self.rows.asSlice()[i].label), String.view(&self.search))
        let rows = self.rows.asMutSlice()
        rows[i].visible = shown
        i = i + 1
      }
      return ()
    }
    while i < n {
      let depth = self.rows.asSlice()[i].depth
      let id = self.rows.asSlice()[i].id
      let children = self.rows.asSlice()[i].children
      let visible = hideBelow == 4294967295 || depth <= hideBelow
      if visible {
        hideBelow = 4294967295
        if children > 0 && self.isCollapsed(id) {
          hideBelow = depth
        }
      }
      let rows = self.rows.asMutSlice()
      rows[i].visible = visible
      i = i + 1
    }
  }

  /// The row label of node `id`, or "".
  pub fn labelOf(self: &Self, id: u32) -> string {
    let rows = self.rows.asSlice()
    let mut i: usize = 0
    while i < rows.length {
      if rows[i].id == id {
        return String.view(&rows[i].label)
      }
      i = i + 1
    }
    return ""
  }

  /// The index of the selected row among the visible ones, or the row count.
  fn selectedIndex(self: &Self) -> usize {
    let rows = self.rows.asSlice()
    let mut i: usize = 0
    while i < rows.length {
      if rows[i].id == self.selected && rows[i].visible {
        return i
      }
      i = i + 1
    }
    return rows.length
  }

  /// The id of the visible row after (or before) the selected one.
  fn step(self: &Self, forward: bool) -> u32 {
    let rows = self.rows.asSlice()
    if rows.length == 0 {
      return NO_PARENT
    }
    let at = self.selectedIndex()
    if forward {
      let mut i = if at == rows.length {
        0
      } else {
        at + 1
      }
      while i < rows.length {
        if rows[i].visible {
          return rows[i].id
        }
        i = i + 1
      }
    } else {
      let mut i = if at == rows.length {
        rows.length
      } else {
        at
      }
      while i > 0 {
        i = i - 1
        if rows[i].visible {
          return rows[i].id
        }
      }
    }
    return self.selected
  }

  /// What to subscribe to: while live, the tree, its roots, the event log and the picker, and
  /// frames for the panels that show what each frame changes; the picker alone otherwise.
  pub fn wanted(self: &Self) -> u32 {
    if !self.live {
      return TOPIC_PICK
    }
    let mut topics = TOPIC_TREE | TOPIC_ROOTS | TOPIC_EVENTS | TOPIC_PICK
    if self.panel == Panel.Stats || self.panel == Panel.Frames {
      topics = topics | TOPIC_FRAME
    }
    return topics
  }

  /// Subscribes to what is wanted and reads everything.
  fn sync(self: &mut Self, cx: &mut Context<Command>) -> () {
    self.topics = self.wanted()
    self.names = cx.alloc(self.wantedNames())
    let names = cx.alloc(copyNames(&self.names))
    cx.command(
      Command.Sync {
        since: self.since,
        selected: self.selected,
        panel: self.panel,
        topics: self.topics,
        names: move names,
      },
    )
  }

  /// Subscribes to what is wanted, when that changed.
  fn resubscribe(self: &mut Self, cx: &mut Context<Command>) -> () {
    let names = cx.alloc(self.wantedNames())
    if self.wanted() != self.topics || !sameNames(&names, &self.names) {
      self.topics = self.wanted()
      self.names = move names
      let copy = cx.alloc(copyNames(&self.names))
      cx.command(Command.Subscribe { topics: self.topics, names: move copy })
    }
  }

  /// Unfolds what hides node `id` and drops a filter that does.
  fn expose(self: &mut Self, id: u32) -> () {
    let mut at = id
    while at != NO_PARENT {
      let rows = self.rows.asSlice()
      let mut parent = NO_PARENT
      let mut i: usize = 0
      while i < rows.length {
        if rows[i].id == at {
          parent = rows[i].parent
        }
        i = i + 1
      }
      let mut j: usize = 0
      while j < self.collapsed.length() {
        if self.collapsed.asSlice()[j] == parent {
          drop self.collapsed.remove(j)
        } else {
          j = j + 1
        }
      }
      at = parent
    }
    if self.search.ownedByteLength() != 0 && !matches(self.labelOf(id), String.view(&self.search)) {
      self.search.clear()
    }
    self.updateVisibility()
  }

  fn select(self: &mut Self, id: u32, cx: &mut Context<Command>) -> () {
    if id == NO_PARENT {
      return ()
    }
    self.selected = id
    cx.command(Command.Inspect { node: id })
  }
}

// Commands.

effect fn copyNames(names: &List<String>) -> List<String>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut copy = List<String>.make()
  let list = names.asSlice()
  let mut i: usize = 0
  while i < list.length {
    run copy.append(run String.copy(String.view(&list[i])))
    i = i + 1
  }
  return move copy
}

fn sameNames(a: &List<String>, b: &List<String>) -> bool {
  if a.length() != b.length() {
    return false
  }
  let x = a.asSlice()
  let y = b.asSlice()
  let mut i: usize = 0
  while i < x.length {
    if String.view(&x[i]) != String.view(&y[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

fn ok(reply: &Value) -> bool {
  return match Json.field(reply, "ok") {
    Option<&Value>.Some { value } => match &value.* {
      Value.Bool { value: b } => b
      _ => false
    }
    Option<&Value>.None => false
  }
}

/// Sends `line` and returns the reply, or None with the reason in `error`.
effect fn ask(line: string, error: &mut String) -> Option<Value>
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  let mut reply = String.make()
  if !run Link.request(line, &mut reply) {
    error.clear()
    run error.append("cannot reach the app: ")
    run error.append(String.view(&reply))
    return Option<Value>.None
  }
  let parsed = run Effect.result(Json.parse(reply.ownedUtf8Bytes()))
  return match move parsed {
    Result<Value, JsonError | OutOfMemoryError>.Success { value } => {
      if ok(&value) {
        return Option<Value>.Some { value: move value }
      }
      error.clear()
      run error.append("the app answered: ")
      run error.append(textField(&value, "error"))
      Option<Value>.None
    }
    Result<Value, JsonError | OutOfMemoryError>.Failure { error: e } => {
      drop e
      error.clear()
      run error.append("the app's reply is not JSON")
      Option<Value>.None
    }
  }
}

/// `{"cmd":"<cmd>","<key>":<value>}`.
effect fn requestLine(cmd: string, key: string, value: u64) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut line = run String.copy("{\"cmd\":\"")
  run line.append(cmd)
  run line.append("\",\"")
  run line.append(key)
  run line.append("\":")
  run writeInt(&mut line, value)
  run line.append("}")
  return move line
}

effect fn inspectNode(node: u32) -> Option<Detail>
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  let line = run requestLine("inspect", "node", u32.toU64(node))
  let mut error = String.make()
  return match run ask(String.view(&line), &mut error) {
    Option<Value>.Some { value } => Option<Detail>.Some { value: run parseDetail(&value) }
    Option<Value>.None => Option<Detail>.None
  }
}

/// `{"cmd":"subscribe","topics":[...]}` for `topics` (`TOPIC_*` bits) and extension topics
/// `names`.
effect fn subscribeLine(topics: u32, names: &List<String>) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut line = run String.copy("{\"cmd\":\"subscribe\",\"topics\":[")
  let mut first = true
  let mut i: usize = 0
  while i < TOPIC_COUNT {
    if u32.bitAnd(topics, u32.shiftLeft(1, usize.toU32(i))) != 0 {
      if !first {
        run line.append(",")
      }
      first = false
      run writeString(&mut line, TOPIC_NAMES[i])
    }
    i = i + 1
  }
  let list = names.asSlice()
  let mut k: usize = 0
  while k < list.length {
    if !first {
      run line.append(",")
    }
    first = false
    run writeString(&mut line, String.view(&list[k]))
    k = k + 1
  }
  run line.append("]}")
  return move line
}

/// Subscribes to exactly `topics`, with two notifications. The app handles lines in order, so
/// the requests sent after them see the subscription.
effect fn subscribe(topics: u32, names: &List<String>) -> bool
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  if !run Link.notify("{\"cmd\":\"unsubscribe\"}") {
    return false
  }
  let line = run subscribeLine(topics, names)
  return run Link.notify(String.view(&line))
}

/// A snapshot with nothing read yet.
fn emptySnapshot(since: u64) -> Snapshot {
  return Snapshot {
    parts: 0,
    status: String.make(),
    rows: List<Row>.make(),
    stats: List<Stat>.make(),
    events: List<LogRow>.make(),
    next: since + 1,
    detail: Option<Detail>.None,
    extensions: Option<List<String>>.None,
    panels: List<PanelInfo>.make(),
    news: List<String>.make(),
    replies: List<String>.make(),
    frames: Option<FrameView>.None,
    picking: false,
    picked: NO_PARENT,
  }
}

effect fn syncAll(
  since: u64,
  selected: u32,
  panel: Panel,
  topics: u32,
  names: &List<String>,
) -> Message
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  let mut error = String.make()
  let mut snapshot = emptySnapshot(since)
  snapshot.parts = PART_ALL
  match run ask("{\"cmd\":\"hello\"}", &mut error) {
    Option<Value>.Some { value } => {
      run parseStatus(&value, &mut snapshot.status)
      let mut ids = List<String>.make()
      run parseExtensions(&value, &mut ids, &mut snapshot.panels)
      snapshot.extensions = Option<List<String>>.some(move ids)
    }
    Option<Value>.None => {
      return Message.Failed { error: move error }
    }
  }

  // Before the reads, so no change after them goes unheard.
  if !run subscribe(topics, names) {
    run error.append("cannot reach the app")
    return Message.Failed { error: move error }
  }
  match run ask("{\"cmd\":\"tree\"}", &mut error) {
    Option<Value>.Some { value } => {
      run parseTree(&value, &mut snapshot.rows)
    }
    Option<Value>.None => {
      return Message.Failed { error: move error }
    }
  }
  match run ask("{\"cmd\":\"stats\"}", &mut error) {
    Option<Value>.Some { value } => {
      run parseStats(&value, &mut snapshot.stats)
    }
    Option<Value>.None => {
      return Message.Failed { error: move error }
    }
  }
  let events = run requestLine("events", "since", since)
  match run ask(String.view(&events), &mut error) {
    Option<Value>.Some { value } => {
      snapshot.next = run parseEvents(&value, &mut snapshot.events)
    }
    Option<Value>.None => {
      return Message.Failed { error: move error }
    }
  }
  if selected != NO_PARENT {
    snapshot.detail = run inspectNode(selected)
  }

  // What came with protocol 2: an older app answers "unknown cmd" and the panels stay empty.
  let mut quiet = String.make()
  if panel == Panel.Frames {
    let frames = run requestLine("frames", "limit", MAX_FRAMES)
    match run ask(String.view(&frames), &mut quiet) {
      Option<Value>.Some { value } => {
        snapshot.frames = Option<FrameView>.Some { value: run parseFrames(&value) }
      }
      Option<Value>.None => {}
    }
  }
  match run ask("{\"cmd\":\"pickMode\"}", &mut quiet) {
    Option<Value>.Some { value } => {
      snapshot.picking = flagField(&value, "on", false)
      snapshot.picked = pickedOf(&value)
    }
    Option<Value>.None => {}
  }
  return Message.Synced { snapshot: move snapshot }
}

fn pickedOf(reply: &Value) -> u32 {
  return match Json.field(reply, "picked") {
    Option<&Value>.Some { value: node } => match idField(node, "id") {
      Option<u32>.Some { value: id } => id
      Option<u32>.None => NO_PARENT
    }
    Option<&Value>.None => NO_PARENT
  }
}

/// Takes the app's notifications and reads again what they say changed: the element tree and
/// the selected node after `tree` or `roots`, the event log after `events`, what `panel` shows
/// after `frame` (or `tree`, for the program), the picker after `pick`. The status line comes
/// with `tree` and `frame` notifications themselves.
effect fn pull(since: u64, selected: u32, panel: Panel) -> Message
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  let mut notes = List<String>.make()
  let open = run Link.take(&mut notes)
  let mut snapshot = emptySnapshot(since)
  let mut changed: u32 = 0
  let list = notes.asSlice()
  let mut i: usize = 0
  while i < list.length {
    let parsed = run Effect.result(Json.parse(list[i].ownedUtf8Bytes()))
    match move parsed {
      Result<Value, JsonError | OutOfMemoryError>.Success { value } => {
        let event = textField(&value, "event")
        if event == "" {
          // The reply to a request sent with `ask`.
          run snapshot.replies.append(run String.copy(String.view(&list[i])))
        } else if topicNamed(event) == 0 {
          run snapshot.news.append(run String.copy(event))
        }
        let topic = topicNamed(event)
        changed = changed | topic
        if topic == TOPIC_TREE || topic == TOPIC_FRAME {
          run parseStatus(&value, &mut snapshot.status)
          snapshot.parts = snapshot.parts | PART_STATUS
        }
      }
      Result<Value, JsonError | OutOfMemoryError>.Failure { error } => {
        drop error
      }
    }
    i = i + 1
  }
  let mut error = String.make()
  if !open && changed == 0 && snapshot.news.length() == 0 && snapshot.replies.length() == 0 {
    run error.append("cannot reach the app: it closed the session")
    return Message.Failed { error: move error }
  }
  if u32.bitAnd(changed, TOPIC_TREE | TOPIC_ROOTS) != 0 {
    match run ask("{\"cmd\":\"tree\"}", &mut error) {
      Option<Value>.Some { value } => {
        run parseTree(&value, &mut snapshot.rows)
        snapshot.parts = snapshot.parts | PART_ROWS
      }
      Option<Value>.None => {
        return Message.Failed { error: move error }
      }
    }
    if selected != NO_PARENT {
      snapshot.detail = run inspectNode(selected)
      snapshot.parts = snapshot.parts | PART_DETAIL
    }
  }
  if u32.bitAnd(changed, TOPIC_EVENTS) != 0 {
    let events = run requestLine("events", "since", since)
    match run ask(String.view(&events), &mut error) {
      Option<Value>.Some { value } => {
        snapshot.next = run parseEvents(&value, &mut snapshot.events)
        snapshot.parts = snapshot.parts | PART_EVENTS
      }
      Option<Value>.None => {
        return Message.Failed { error: move error }
      }
    }
  }
  let mut quiet = String.make()
  if u32.bitAnd(changed, TOPIC_FRAME | TOPIC_TREE) != 0 {
    if panel == Panel.Stats {
      match run ask("{\"cmd\":\"stats\"}", &mut error) {
        Option<Value>.Some { value } => {
          run parseStats(&value, &mut snapshot.stats)
          snapshot.parts = snapshot.parts | PART_STATS
        }
        Option<Value>.None => {
          return Message.Failed { error: move error }
        }
      }
    }
    if panel == Panel.Frames {
      let frames = run requestLine("frames", "limit", MAX_FRAMES)
      match run ask(String.view(&frames), &mut quiet) {
        Option<Value>.Some { value } => {
          snapshot.frames = Option<FrameView>.Some { value: run parseFrames(&value) }
        }
        Option<Value>.None => {}
      }
    }
  }
  if u32.bitAnd(changed, TOPIC_PICK) != 0 {
    match run ask("{\"cmd\":\"pickMode\"}", &mut quiet) {
      Option<Value>.Some { value } => {
        snapshot.picking = flagField(&value, "on", false)
        snapshot.picked = pickedOf(&value)
        snapshot.parts = snapshot.parts | PART_PICK
      }
      Option<Value>.None => {}
    }
  }
  return Message.Synced { snapshot: move snapshot }
}

/// highlight, as a notification: hovering rows sends many, and none waits for an answer.
effect fn highlightNode(node: u32) -> Message
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  let mut line = run String.copy("{\"cmd\":\"highlight\"")
  if node != NO_PARENT {
    run line.append(",\"nodes\":[")
    run writeInt(&mut line, u32.toU64(node))
    run line.append("]")
  }
  run line.append("}")
  if !run Link.notify(String.view(&line)) {
    return Message.Failed { error: run String.copy("cannot reach the app") }
  }
  return Message.Sent
}

effect fn subscribed(topics: u32, names: &List<String>) -> Message
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  if !run subscribe(topics, names) {
    return Message.Failed { error: run String.copy("cannot reach the app") }
  }
  return Message.Sent
}

effect fn pick(on: bool) -> Message
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  let mut error = String.make()
  let line = if on {
    "{\"cmd\":\"pickMode\",\"on\":true}"
  } else {
    "{\"cmd\":\"pickMode\",\"on\":false}"
  }
  return match run ask(line, &mut error) {
    Option<Value>.Some { value } => Message.Picking { on: flagField(&value, "on", false) }
    Option<Value>.None => Message.Failed { error: move error }
  }
}

/// What the styles panel shows after an edit: the node again, or why the app refused.
effect fn afterEdit(line: string, node: u32) -> Message
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  let mut error = String.make()
  match run ask(line, &mut error) {
    Option<Value>.Some { value: _ } => {}
    Option<Value>.None => {
      return Message.StyleRefused { error: move error }
    }
  }
  if node == NO_PARENT {
    return Message.Styled { detail: Detail.none() }
  }
  return match run inspectNode(node) {
    Option<Detail>.Some { value } => Message.Styled { detail: move value }
    Option<Detail>.None => Message.Styled { detail: Detail.none() }
  }
}

effect fn setStyle(node: u32, declarations: string) -> Message
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  let mut line = run String.copy("{\"cmd\":\"setStyle\",\"node\":")
  run writeInt(&mut line, u32.toU64(node))
  run line.append(",\"style\":")
  run writeString(&mut line, declarations)
  run line.append("}")
  return run afterEdit(String.view(&line), node)
}

/// Sends `line` without waiting for its reply.
effect fn askLater(line: string, purpose: u32, index: usize) -> Message
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  let id = run Link.ask(line)
  if id == 0 {
    return Message.Failed { error: run String.copy("cannot reach the app") }
  }
  return Message.Asked { asked: Asked { id: id, purpose: purpose, index: index } }
}

effect fn runAudit() -> Message
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  let mut error = String.make()
  return match run ask("{\"cmd\":\"audit\"}", &mut error) {
    Option<Value>.Some { value } => {
      let mut issues = List<Issue>.make()
      let mut line = String.make()
      run parseIssues(&value, &mut issues, &mut line)
      Message.Audited { issues: move issues, line: move line }
    }
    Option<Value>.None => Message.Failed { error: move error }
  }
}

effect fn highlightAndInspect(node: u32) -> Message
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  let mut error = String.make()
  let mut line = run String.copy("{\"cmd\":\"highlight\",\"nodes\":[")
  run writeInt(&mut line, u32.toU64(node))
  run line.append("]}")
  match run ask(String.view(&line), &mut error) {
    Option<Value>.Some { value: _ } => {}
    Option<Value>.None => {
      return Message.Failed { error: move error }
    }
  }
  return match run inspectNode(node) {
    Option<Detail>.Some { value } => Message.Inspected { detail: move value }
    Option<Detail>.None => Message.Inspected { detail: Detail.none() }
  }
}

effect fn unhighlight() -> Message
  ! OutOfMemoryError
  ? &mut Link | &mut Allocator {
  let mut error = String.make()
  return match run ask("{\"cmd\":\"highlight\"}", &mut error) {
    Option<Value>.Some { value: _ } => Message.Inspected { detail: Detail.none() }
    Option<Value>.None => Message.Failed { error: move error }
  }
}

impl Perform<Message, OutOfMemoryError ? &mut Link | &mut Allocator> for Command {
  effect fn perform(self: Self) -> Message
    ! OutOfMemoryError
    ? &mut Link | &mut Allocator {
    return match &self {
      Command.Sync { since, selected, panel, topics, names } => run syncAll(
        since,
        selected,
        panel,
        topics,
        &names,
      )
      Command.Pull { since, selected, panel } => run pull(since, selected, panel)
      Command.Subscribe { topics, names } => run subscribed(topics, &names)
      Command.Ask { line, purpose, index } => run askLater(String.view(&line), purpose, index)
      Command.Highlight { node } => run highlightNode(node)
      Command.Inspect { node } => run highlightAndInspect(node)
      Command.Unhighlight => run unhighlight()
      Command.Pick { on } => run pick(on)
      Command.SetStyle { node, css: declarations } => run setStyle(node, String.view(&declarations))
      Command.ResetStyles { selected } => run afterEdit("{\"cmd\":\"resetStyles\"}", selected)
      Command.Audit => run runAudit()
    }
  }
}

// The look: Chrome's devtools, light.

fn rgb(hex: u32) -> Rgba<f32> {
  let r = u32.toF32(u32.bitAnd(u32.shiftRight(hex, 16), 255)) / 255.0
  let g = u32.toF32(u32.bitAnd(u32.shiftRight(hex, 8), 255)) / 255.0
  let b = u32.toF32(u32.bitAnd(hex, 255)) / 255.0
  return Rgba<f32> { r: r, g: g, b: b, a: 1.0 }
}

const TEXT: u32 = 0x1F2937

const MUTED: u32 = 0x6B7280

const LINE: u32 = 0xD1D5DB

const BAR: u32 = 0xF3F4F6

const HOVER: u32 = 0xEEF2FF

const SELECTED: u32 = 0xDBEAFE

const ACCENT: u32 = 0x2563EB

const TAG: u32 = 0x881280

const ATTRIBUTE: u32 = 0xC80000

const ERROR: u32 = 0xB91C1C

const MARGIN: u32 = 0xF9CC9D

const BORDER: u32 = 0xFDDD9B

const PADDING: u32 = 0xC3D08B

const CONTENT: u32 = 0x8CB6C0

const ADDED_LINE: u32 = 0xDCFCE7

const REMOVED_LINE: u32 = 0xFEE2E2

const LAYOUT_BAR: u32 = 0xF59E0B

const WARNING: u32 = 0xB45309

/// A one-line text field in the look of the toolbar.
fn field(
  ui: &mut Ui<Message>,
  testId: string,
  label: string,
  hint: string,
  value: string,
  onChange: fn(String) -> Message,
) -> () {
  ui.input(
    value,
    |ui| {
      ui.testId(testId)
      ui.label(label)
      ui.placeholder(hint)
      ui.style(
        &[
          css.flexGrow(1.0),
          css.flexShrink(1.0),
          css.flexBasis(px(0.0)),
          css.minWidth(px(0.0)),
          css.height(px(22.0)),
          css.paddingLeft(px(6.0)),
          css.paddingRight(px(6.0)),
          css.borderTopWidth(px(1.0)),
          css.borderRightWidth(px(1.0)),
          css.borderBottomWidth(px(1.0)),
          css.borderLeftWidth(px(1.0)),
          css.borderStyle(BorderStyle.Solid),
          css.borderColor(rgb(LINE)),
          css.backgroundColor(rgb(0xFFFFFF)),
        ],
      )
      ui.focused(&[css.borderColor(rgb(ACCENT))])
      ui.onInput(onChange)
    },
  )
}

/// A swatch and what it stands for, in the timeline's legend.
fn legend(ui: &mut Ui<Message>, hex: u32, text: string) -> () {
  ui.row(
    |ui| {
      ui.style(&[css.alignItems(Align.Center)])
      ui.gap(4.0)
      ui.box(
        |ui| {
          ui.background(rgb(hex))
          ui.style(&[css.width(px(8.0)), css.height(px(8.0))])
        },
      )
      muted(&mut ui, text)
    },
  )
}

fn ruleColor(rule: string) -> u32 {
  if rule == "contrast" || rule == "small-target" {
    return WARNING
  }
  return ERROR
}

fn border(ui: &mut Ui<Message>, side: Property, hex: u32) -> () {
  ui.style(
    &[css.declare(side, px(1.0)), css.borderStyle(BorderStyle.Solid), css.borderColor(rgb(hex))],
  )
}

fn paddings(ui: &mut Ui<Message>, vertical: f32, horizontal: f32) -> () {
  ui.style(
    &[
      css.paddingTop(px(vertical)),
      css.paddingBottom(px(vertical)),
      css.paddingLeft(px(horizontal)),
      css.paddingRight(px(horizontal)),
    ],
  )
}

/// A flat toolbar or tab button; `selected` underlines it in the accent color.
fn barButton(ui: &mut Ui<Message>, label: string, selected: bool, onPress: fn() -> Message) -> () {
  ui.pressable(
    onPress,
    |ui| {
      paddings(&mut ui, 4.0, 10.0)
      ui.style(
        &[
          css.borderBottomWidth(px(2.0)),
          css.borderStyle(BorderStyle.Solid),
          css.borderColor(
            if selected {
              rgb(ACCENT)
            } else {
              Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }
            },
          ),
        ],
      )
      if selected {
        ui.color(rgb(ACCENT))
      }
      ui.hover(&[css.backgroundColor(rgb(0xE5E7EB))])
      ui.focusVisible(&[css.backgroundColor(rgb(SELECTED))])
      ui.text(label)
    },
  )
}

/// A scrolling region that fills what is left of its flex parent.
fn scrolling(ui: &mut Ui<Message>) -> () {
  ui.style(
    &[
      css.flexGrow(1.0),
      css.flexShrink(1.0),
      css.flexBasis(px(0.0)),
      css.minHeight(px(0.0)),
      css.minWidth(px(0.0)),
      css.overflowY(Overflow.Scroll),
      css.overflowX(Overflow.Hidden),
    ],
  )
}

fn muted(ui: &mut Ui<Message>, text: string) -> () {
  ui.box(
    |ui| {
      ui.color(rgb(MUTED))
      ui.text(text)
    },
  )
}

/// "element-<id>", the test id of a row.
effect fn rowTestId(id: u32) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = run String.copy("element-")
  run writeInt(&mut text, u32.toU64(id))
  return move text
}

effect fn sizeText(value: f32) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = String.make()
  if value == 0.0 {
    run text.append("-")
  } else {
    run writeSize(&mut text, value)
  }
  return move text
}

effect fn contentText(box: &BoxNumbers) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = String.make()
  run writeSize(&mut text, box.width)
  run text.append(" × ")
  run writeSize(&mut text, box.height)
  return move text
}

effect fn positionText(box: &BoxNumbers) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = run String.copy("position ")
  run writeSize(&mut text, box.x)
  run text.append(", ")
  run writeSize(&mut text, box.y)
  if box.fragments > 1 {
    run text.append("  ·  first of ")
    run writeInt(&mut text, u32.toU64(box.fragments))
    run text.append(" fragments")
  }
  return move text
}

effect fn seqText(seq: u64) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = String.make()
  run writeInt(&mut text, seq)
  return move text
}

fn centered(ui: &mut Ui<Message>, text: string) -> () {
  ui.box(
    |ui| {
      ui.style(&[css.textAlign(TextAlign.Center)])
      ui.text(text)
    },
  )
}

/// One layer of the box model diagram: `name` in the corner, the side widths around `inner`.
fn layer(
  ui: &mut Ui<Message>,
  name: string,
  hex: u32,
  sides: Sides,
  dashed: bool,
  inner: fn(&mut Ui<Message>) -> (),
) -> () {
  ui.column(
    |ui| {
      ui.testId(name)
      ui.background(rgb(hex))
      ui.style(
        &[
          css.borderTopWidth(px(1.0)),
          css.borderRightWidth(px(1.0)),
          css.borderBottomWidth(px(1.0)),
          css.borderLeftWidth(px(1.0)),
          css.borderStyle(
            if dashed {
              BorderStyle.Dashed
            } else {
              BorderStyle.Solid
            },
          ),
          css.borderColor(rgb(0x808080)),
          css.alignItems(Align.Stretch),
        ],
      )
      paddings(&mut ui, 2.0, 6.0)
      ui.row(
        |ui| {
          ui.box(
            |ui| {
              ui.style(&[css.flexBasis(px(0.0))])
              ui.grow(1.0)
              ui.color(rgb(0x404040))
              ui.text(name)
            },
          )
          ui.box(
            |ui| {
              let text = ui.alloc(sizeText(sides.top))
              ui.text(String.view(&text))
            },
          )
          ui.box(
            |ui| {
              ui.style(&[css.flexBasis(px(0.0))])
              ui.grow(1.0)
            },
          )
        },
      )
      ui.row(
        |ui| {
          ui.style(&[css.alignItems(Align.Center)])
          ui.gap(6.0)
          ui.box(
            |ui| {
              let text = ui.alloc(sizeText(sides.left))
              ui.text(String.view(&text))
            },
          )
          ui.column(
            |ui| {
              ui.grow(1.0)
              inner(&mut ui)
            },
          )
          ui.box(
            |ui| {
              let text = ui.alloc(sizeText(sides.right))
              ui.text(String.view(&text))
            },
          )
        },
      )
      ui.row(
        |ui| {
          ui.style(&[css.justifyContent(Align.Center)])
          ui.box(
            |ui| {
              let text = ui.alloc(sizeText(sides.bottom))
              ui.text(String.view(&text))
            },
          )
        },
      )
    },
  )
}

/// The height of a bar for `value` when `scale` fills the timeline, at least `least` pixels.
fn barHeight(value: f32, scale: f32, least: f32) -> f32 {
  let mut height: f32 = 0.0
  if scale > 0.0 {
    height = value / scale * BAR_HEIGHT
  }
  if height < least {
    return least
  }
  if height > BAR_HEIGHT {
    return BAR_HEIGHT
  }
  return height
}

impl Devtools {
  fn toolbar(self: &Self, ui: &mut Ui<Message>) -> () {
    ui.row(
      |ui| {
        ui.accessRole(Role.Toolbar)
        ui.testId("toolbar")
        ui.background(rgb(BAR))
        border(&mut ui, Property.BorderBottomWidth, LINE)
        ui.style(&[css.alignItems(Align.Center)])
        paddings(&mut ui, 2.0, 8.0)
        ui.gap(8.0)
        ui.box(
          |ui| {
            ui.style(&[css.fontWeight(700.0)])
            ui.text("Silk devtools")
          },
        )
        ui.box(
          |ui| {
            ui.testId("status")
            ui.grow(1.0)
            ui.style(&[css.whiteSpace(WhiteSpace.NoWrap)])
            if self.error.ownedByteLength() != 0 {
              ui.color(rgb(ERROR))
              ui.text(String.view(&self.error))
            } else {
              ui.color(rgb(MUTED))
              ui.text(String.view(&self.target))
              ui.text("  ·  ")
              ui.text(String.view(&self.status))
            }
          },
        )
        barButton(&mut ui, "Pick", self.picking, || Message.TogglePick)
        barButton(&mut ui, "Refresh", false, || Message.Refresh)
        barButton(&mut ui, "Live", self.live, || Message.ToggleLive)
      },
    )
  }

  fn elements(self: &Self, ui: &mut Ui<Message>) -> () {
    ui.column(
      |ui| {
        ui.style(
          &[
            css.flexBasis(percent(45.0)),
            css.flexShrink(0.0),
            css.minHeight(px(0.0)),
            css.minWidth(px(0.0)),
          ],
        )
        border(&mut ui, Property.BorderRightWidth, LINE)
        ui.row(
          |ui| {
            paddings(&mut ui, 4.0, 6.0)
            border(&mut ui, Property.BorderBottomWidth, BAR)
            field(
              &mut ui,
              "search",
              "Filter elements",
              "Filter by role, name or test id",
              String.view(&self.search),
              |value| Message.Search { value: move value },
            )
          },
        )
        ui.column(
          |ui| {
            ui.testId("elements")
            ui.accessRole(Role.List)
            ui.label("Elements")
            scrolling(&mut ui)
            ui.style(&[css.whiteSpace(WhiteSpace.NoWrap)])
            paddings(&mut ui, 4.0, 0.0)
            if self.rows.length() == 0 {
              ui.box(
                |ui| {
                  paddings(&mut ui, 4.0, 8.0)
                  muted(&mut ui, "No elements yet.")
                },
              )
            }
            ui.each(
              self.rows.asSlice(),
              |row| u32.toU64(row.id),
              |ui, row| {
                if row.visible {
                  self.elementRow(&mut ui, row)
                }
              },
            )
          },
        )
      },
    )
  }

  fn elementRow(self: &Self, ui: &mut Ui<Message>, row: &Row) -> () {
    let selected = row.id == self.selected
    let folded = self.isCollapsed(row.id)
    ui.row(
      |ui| {
        ui.accessRole(Role.ListItem)
        ui.label(String.view(&row.label))
        let testId = ui.alloc(rowTestId(row.id))
        ui.testId(String.view(&testId))
        ui.cursor(Cursor.Pointer)
        ui.onClick(|| Message.Select { id: row.id })

        // The app highlights the node under the pointer, as Chrome's devtools do.
        ui.on(
          EventKind.PointerEnter,
          |event| Reply<Message>.Emit { message: Message.Hover { id: row.id } },
        )
        ui.on(
          EventKind.PointerLeave,
          |event| Reply<Message>.Emit { message: Message.Unhover { id: row.id } },
        )
        ui.style(
          &[
            css.alignItems(Align.Center),
            css.columnGap(px(6.0)),
            css.paddingTop(px(1.0)),
            css.paddingBottom(px(1.0)),
            css.paddingLeft(px(4.0 + u32.toF32(row.depth) * 12.0)),
            css.paddingRight(px(8.0)),
          ],
        )
        if selected {
          ui.background(rgb(SELECTED))
          ui.reveal()
        } else {
          ui.hover(&[css.backgroundColor(rgb(HOVER))])
        }
        ui.box(
          |ui| {
            ui.style(&[css.width(px(10.0)), css.flexShrink(0.0)])
            ui.color(rgb(MUTED))
            if row.children > 0 {
              ui.on(
                EventKind.Click,
                |event| Reply<Message>.EmitAndStop { message: Message.Collapse { id: row.id } },
              )
              ui.text(
                if folded {
                  "+"
                } else {
                  "-"
                },
              )
            }
          },
        )
        ui.box(
          |ui| {
            ui.color(rgb(TAG))
            ui.text(String.view(&row.label))
          },
        )
        ui.box(
          |ui| {
            ui.color(rgb(MUTED))
            ui.text(String.view(&row.detail))
          },
        )
      },
    )
  }

  fn side(self: &Self, ui: &mut Ui<Message>) -> () {
    ui.column(
      |ui| {
        ui.grow(1.0)
        ui.style(&[css.flexBasis(px(0.0)), css.minWidth(px(0.0)), css.minHeight(px(0.0))])
        ui.row(
          |ui| {
            ui.accessRole(Role.TabList)
            ui.background(rgb(BAR))
            border(&mut ui, Property.BorderBottomWidth, LINE)
            barButton(
              &mut ui,
              "Styles",
              self.panel == Panel.Styles,
              || Message.Show { panel: Panel.Styles },
            )
            barButton(
              &mut ui,
              "Box model",
              self.panel == Panel.BoxModel,
              || Message.Show { panel: Panel.BoxModel },
            )
            if self.hasProgram() {
              barButton(
                &mut ui,
                "Program",
                self.panel == Panel.Program,
                || Message.Show { panel: Panel.Program },
              )
            }
            barButton(
              &mut ui,
              "Events",
              self.panel == Panel.Events,
              || Message.Show { panel: Panel.Events },
            )
            barButton(
              &mut ui,
              "Frames",
              self.panel == Panel.Frames,
              || Message.Show { panel: Panel.Frames },
            )
            barButton(
              &mut ui,
              "Audit",
              self.panel == Panel.Audit,
              || Message.Show { panel: Panel.Audit },
            )
            barButton(
              &mut ui,
              "Stats",
              self.panel == Panel.Stats,
              || Message.Show { panel: Panel.Stats },
            )

            // The tabs of the app's extensions, as `hello` lists them.
            ui.enumerate(
              self.panels.asSlice(),
              |panel| 0,
              |ui, index, panel| {
                ui.key(usize.toU64(index) + 1)
                barButton(
                  &mut ui,
                  String.view(&panel.title),
                  self.panel == Panel.Extension && self.shown == index,
                  || Message.ShowPanel { index: index },
                )
              },
            )
          },
        )
        ui.column(
          |ui| {
            ui.accessRole(Role.TabPanel)
            ui.testId("panel")
            scrolling(&mut ui)
            paddings(&mut ui, 6.0, 10.0)
            match self.panel {
              Panel.Styles => self.styles(&mut ui)
              Panel.BoxModel => self.boxModel(&mut ui)
              Panel.Program => self.programPanel(&mut ui)
              Panel.Events => self.eventLog(&mut ui)
              Panel.Frames => self.framesPanel(&mut ui)
              Panel.Audit => self.auditPanel(&mut ui)
              Panel.Stats => self.statsPanel(&mut ui)
              Panel.Extension => self.extensionPanel(&mut ui)
            }
          },
        )
      },
    )
  }

  fn nothingSelected(self: &Self, ui: &mut Ui<Message>) -> bool {
    if self.detail.id == NO_PARENT {
      muted(&mut ui, "Select an element on the left, or press the down arrow.")
      return true
    }
    return false
  }

  fn styles(self: &Self, ui: &mut Ui<Message>) -> () {
    if self.nothingSelected(&mut ui) {
      return ()
    }
    ui.box(
      |ui| {
        ui.testId("detail-title")
        ui.style(&[css.fontWeight(700.0)])
        ui.color(rgb(TAG))
        ui.text(String.view(&self.detail.title))
      },
    )
    ui.row(
      |ui| {
        ui.style(&[css.alignItems(Align.Center), css.marginTop(px(4.0)), css.marginBottom(px(4.0))])
        ui.gap(4.0)
        ui.onEnter(|| Message.ApplyStyle)
        field(
          &mut ui,
          "style-draft",
          "Declarations to set",
          "Try a style: width: 200px; color: red",
          String.view(&self.draft),
          |value| Message.StyleDraft { value: move value },
        )
        barButton(&mut ui, "Apply", false, || Message.ApplyStyle)
        barButton(&mut ui, "Reset", false, || Message.ResetStyles)
      },
    )
    if self.styleError.ownedByteLength() != 0 {
      ui.box(
        |ui| {
          ui.testId("style-error")
          ui.color(rgb(ERROR))
          ui.text(String.view(&self.styleError))
        },
      )
    }
    ui.enumerate(
      self.detail.lines.asSlice(),
      |line| 0,
      |ui, index, line| {
        let text = String.view(&line)
        ui.key(usize.toU64(index))
        ui.row(
          |ui| {
            ui.style(&[css.whiteSpace(WhiteSpace.Pre)])
            if String.startsWith(text, "style ") {
              ui.style(&[css.fontWeight(700.0), css.marginTop(px(6.0))])
              ui.text(text)
            } else if String.startsWith(text, "  ") {
              match String.find(text, ": ") {
                Option<usize>.Some { value: colon } => {
                  ui.box(
                    |ui| {
                      ui.color(rgb(ATTRIBUTE))
                      ui.text(String.slice(text, 0, colon))
                    },
                  )
                  ui.text(String.slice(text, colon, String.byteLength(text) - colon))
                }
                Option<usize>.None => {
                  ui.text(text)
                }
              }
            } else if text == "}" {
              ui.color(rgb(MUTED))
              ui.text(text)
            } else {
              ui.color(rgb(MUTED))
              ui.text(text)
            }
          },
        )
      },
    )
  }

  fn boxModel(self: &Self, ui: &mut Ui<Message>) -> () {
    if self.nothingSelected(&mut ui) {
      return ()
    }
    if !self.detail.hasBox {
      muted(&mut ui, "This node has no box (display: none, or not laid out).")
      return ()
    }
    let b = self.detail.box
    ui.column(
      |ui| {
        ui.testId("box-model")
        ui.gap(8.0)
        ui.style(&[css.maxWidth(px(420.0))])
        layer(
          &mut ui,
          "margin",
          MARGIN,
          b.margin,
          true,
          |ui| {
            layer(
              &mut ui,
              "border",
              BORDER,
              b.border,
              false,
              |ui| {
                layer(
                  &mut ui,
                  "padding",
                  PADDING,
                  b.padding,
                  true,
                  |ui| {
                    ui.box(
                      |ui| {
                        ui.testId("content")
                        ui.background(rgb(CONTENT))
                        ui.style(
                          &[
                            css.borderTopWidth(px(1.0)),
                            css.borderRightWidth(px(1.0)),
                            css.borderBottomWidth(px(1.0)),
                            css.borderLeftWidth(px(1.0)),
                            css.borderStyle(BorderStyle.Solid),
                            css.borderColor(rgb(0x808080)),
                            css.textAlign(TextAlign.Center),
                          ],
                        )
                        paddings(&mut ui, 6.0, 6.0)
                        let size = ui.alloc(contentText(&b))
                        ui.text(String.view(&size))
                      },
                    )
                  },
                )
              },
            )
          },
        )
        let position = ui.alloc(positionText(&b))
        muted(&mut ui, String.view(&position))
      },
    )
  }

  fn eventLog(self: &Self, ui: &mut Ui<Message>) -> () {
    ui.row(
      |ui| {
        ui.style(&[css.alignItems(Align.Center)])
        ui.box(
          |ui| {
            ui.grow(1.0)
            ui.color(rgb(MUTED))
            ui.text("Records the app took from the tree, newest first")
          },
        )
        barButton(&mut ui, "Clear", false, || Message.ClearEvents)
      },
    )
    if self.events.length() == 0 {
      muted(&mut ui, "No events yet. Use the app, then look here.")
      return ()
    }
    ui.column(
      |ui| {
        ui.testId("event-log")
        ui.accessRole(Role.List)
        let rows = self.events.asSlice()
        let mut i = rows.length
        while i > 0 {
          i = i - 1
          let e = &rows[i]
          ui.key(e.seq)
          ui.row(
            |ui| {
              ui.accessRole(Role.ListItem)
              ui.gap(8.0)
              ui.style(&[css.whiteSpace(WhiteSpace.NoWrap)])
              border(&mut ui, Property.BorderBottomWidth, BAR)
              paddings(&mut ui, 1.0, 0.0)
              ui.box(
                |ui| {
                  ui.style(&[css.width(px(36.0))])
                  ui.color(rgb(MUTED))
                  let seq = ui.alloc(seqText(e.seq))
                  ui.text(String.view(&seq))
                },
              )
              ui.box(
                |ui| {
                  ui.style(&[css.width(px(84.0))])
                  ui.color(rgb(ACCENT))
                  ui.text(String.view(&e.kind))
                },
              )
              ui.box(
                |ui| {
                  ui.color(rgb(TAG))
                  ui.text(self.labelOf(e.target))
                },
              )
              ui.box(
                |ui| {
                  ui.color(rgb(MUTED))
                  ui.text(String.view(&e.text))
                },
              )
            },
          )
        }
      },
    )
  }

  fn programPanel(self: &Self, ui: &mut Ui<Message>) -> () {
    if !self.program.attached && self.steps.length() == 0 {
      muted(
        &mut ui,
        "This app reports no program. A silk-ui program in a window does: every message it handles shows here with what caused it, the commands it returned and the model after it.",
      )
      return ()
    }
    ui.box(
      |ui| {
        ui.testId("program-line")
        ui.color(rgb(MUTED))
        ui.text(String.view(&self.program.line))
      },
    )
    ui.row(
      |ui| {
        ui.testId("subscriptions")
        ui.style(&[css.alignItems(Align.Center), css.marginTop(px(2.0)), css.marginBottom(px(4.0))])
        ui.gap(6.0)
        ui.box(
          |ui| {
            ui.grow(1.0)
            ui.color(rgb(MUTED))
            if self.program.subscriptions.length() == 0 {
              ui.text("No subscriptions")
            } else {
              ui.text("Subscribed to ")
              ui.enumerate(
                self.program.subscriptions.asSlice(),
                |line| 0,
                |ui, index, line| {
                  if index > 0 {
                    ui.text(", ")
                  }
                  ui.text(String.view(&line))
                },
              )
            }
          },
        )
        barButton(&mut ui, "Clear", false, || Message.ClearSteps)
      },
    )
    if self.steps.length() == 0 {
      muted(&mut ui, "No messages yet. Use the app, then look here.")
      return ()
    }
    ui.column(
      |ui| {
        ui.testId("messages")
        ui.accessRole(Role.List)
        let rows = self.steps.asSlice()
        let mut i = rows.length
        while i > 0 {
          i = i - 1
          let step = &rows[i]
          let open = self.opened.seq == step.seq
          ui.key(step.seq)
          ui.column(
            |ui| {
              ui.accessRole(Role.ListItem)
              border(&mut ui, Property.BorderBottomWidth, BAR)
              ui.row(
                |ui| {
                  ui.accessRole(Role.Button)
                  ui.tabIndex(0)
                  ui.cursor(Cursor.Pointer)
                  ui.onClick(|| Message.OpenStep { seq: step.seq })
                  ui.onEnter(|| Message.OpenStep { seq: step.seq })
                  ui.gap(8.0)
                  paddings(&mut ui, 2.0, 0.0)
                  if open {
                    ui.background(rgb(SELECTED))
                  } else {
                    ui.hover(&[css.backgroundColor(rgb(HOVER))])
                  }
                  ui.focusVisible(&[css.backgroundColor(rgb(SELECTED))])
                  ui.box(
                    |ui| {
                      ui.style(&[css.width(px(36.0)), css.flexShrink(0.0)])
                      ui.color(rgb(MUTED))
                      let seq = ui.alloc(seqText(step.seq))
                      ui.text(String.view(&seq))
                    },
                  )
                  ui.box(
                    |ui| {
                      ui.label(
                        if step.changed {
                          "changed the model"
                        } else {
                          ""
                        },
                      )
                      ui.style(
                        &[
                          css.width(px(6.0)),
                          css.height(px(6.0)),
                          css.marginTop(px(5.0)),
                          css.flexShrink(0.0),
                        ],
                      )
                      if step.changed {
                        ui.background(rgb(ACCENT))
                      }
                    },
                  )
                  ui.column(
                    |ui| {
                      ui.grow(1.0)
                      ui.style(&[css.flexBasis(px(0.0)), css.minWidth(px(0.0))])
                      ui.box(
                        |ui| {
                          ui.color(rgb(TAG))
                          ui.text(String.view(&step.message))
                        },
                      )
                      ui.box(
                        |ui| {
                          ui.color(rgb(MUTED))
                          ui.text("from ")
                          ui.text(String.view(&step.cause))
                        },
                      )
                      if step.commands.ownedByteLength() != 0 {
                        ui.box(
                          |ui| {
                            ui.color(rgb(ACCENT))
                            ui.text("returned ")
                            ui.text(String.view(&step.commands))
                          },
                        )
                      }
                    },
                  )
                },
              )
              if open {
                self.modelDiff(&mut ui)
              }
            },
          )
        }
      },
    )
  }

  /// The open step's model, the lines the step changed marked.
  fn modelDiff(self: &Self, ui: &mut Ui<Message>) -> () {
    ui.column(
      |ui| {
        ui.testId("model")
        ui.background(rgb(0xF9FAFB))
        ui.style(
          &[
            css.whiteSpace(WhiteSpace.Pre),
            css.marginBottom(px(4.0)),
            css.overflowX(Overflow.Hidden),
          ],
        )
        paddings(&mut ui, 4.0, 0.0)
        if self.opened.changed == 0 {
          ui.box(
            |ui| {
              paddings(&mut ui, 0.0, 8.0)
              muted(&mut ui, "The model did not change.")
            },
          )
        }
        ui.enumerate(
          self.opened.lines.asSlice(),
          |line| 0,
          |ui, index, line| {
            ui.key(usize.toU64(index))
            ui.row(
              |ui| {
                paddings(&mut ui, 0.0, 8.0)
                if line.op == ADDED {
                  ui.background(rgb(ADDED_LINE))
                  ui.text("+ ")
                } else if line.op == REMOVED {
                  ui.background(rgb(REMOVED_LINE))
                  ui.text("- ")
                } else {
                  ui.color(rgb(MUTED))
                  ui.text("  ")
                }
                ui.text(String.view(&line.text))
              },
            )
          },
        )
      },
    )
  }

  fn framesPanel(self: &Self, ui: &mut Ui<Message>) -> () {
    if self.frames.bars.length() == 0 {
      muted(&mut ui, "No frames yet.")
      return ()
    }
    let timed = self.frames.timed
    let scale = self.frames.scale
    ui.row(
      |ui| {
        ui.testId("frame-bars")
        ui.label("Frames, oldest first")
        ui.background(rgb(0xF9FAFB))
        border(&mut ui, Property.BorderBottomWidth, LINE)
        ui.style(
          &[
            css.height(px(BAR_HEIGHT)),
            css.flexShrink(0.0),
            css.alignItems(Align.FlexEnd),
            css.columnGap(px(1.0)),
            css.overflowX(Overflow.Hidden),
            css.overflowY(Overflow.Hidden),
          ],
        )
        ui.each(
          self.frames.bars.asSlice(),
          |bar| bar.frame,
          |ui, bar| {
            ui.column(
              |ui| {
                ui.style(&[css.width(px(3.0)), css.flexShrink(0.0)])
                if timed {
                  let over = bar.layout + bar.paint > FRAME_BUDGET
                  ui.box(
                    |ui| {
                      ui.background(
                        rgb(
                          if over {
                            ERROR
                          } else {
                            LAYOUT_BAR
                          },
                        ),
                      )
                      ui.style(&[css.height(px(barHeight(bar.layout, scale, 0.0)))])
                    },
                  )
                  ui.box(
                    |ui| {
                      ui.background(
                        rgb(
                          if over {
                            ERROR
                          } else {
                            ACCENT
                          },
                        ),
                      )
                      ui.style(&[css.height(px(barHeight(bar.paint, scale, 1.0)))])
                    },
                  )
                } else {
                  ui.box(
                    |ui| {
                      ui.background(
                        rgb(
                          if bar.skipped {
                            CONTENT
                          } else {
                            ACCENT
                          },
                        ),
                      )
                      ui.style(&[css.height(px(barHeight(bar.fragments, scale, 1.0)))])
                    },
                  )
                }
              },
            )
          },
        )
      },
    )
    ui.row(
      |ui| {
        ui.style(&[css.marginTop(px(6.0))])
        ui.gap(12.0)
        if timed {
          legend(&mut ui, LAYOUT_BAR, "layout")
          legend(&mut ui, ACCENT, "paint")
          legend(&mut ui, ERROR, "over 16.7 ms")
        } else {
          legend(&mut ui, ACCENT, "laid out and painted")
          legend(&mut ui, CONTENT, "layout skipped")
        }
      },
    )
    ui.box(
      |ui| {
        ui.testId("frame-line")
        ui.style(&[css.marginTop(px(4.0))])
        ui.color(rgb(MUTED))
        ui.text(String.view(&self.frames.line))
      },
    )
  }

  fn auditPanel(self: &Self, ui: &mut Ui<Message>) -> () {
    ui.row(
      |ui| {
        ui.style(&[css.alignItems(Align.Center)])
        ui.box(
          |ui| {
            ui.testId("audit-line")
            ui.grow(1.0)
            ui.color(rgb(MUTED))
            if self.auditLine.ownedByteLength() == 0 {
              ui.text("Checks names, roles, keyboard reach, target sizes and text contrast.")
            } else {
              ui.text(String.view(&self.auditLine))
            }
          },
        )
        barButton(&mut ui, "Run audit", false, || Message.RunAudit)
      },
    )
    ui.column(
      |ui| {
        ui.testId("issues")
        ui.accessRole(Role.List)
        ui.enumerate(
          self.issues.asSlice(),
          |issue| 0,
          |ui, index, issue| {
            ui.key(usize.toU64(index))
            ui.row(
              |ui| {
                ui.accessRole(Role.Button)
                ui.tabIndex(0)
                ui.cursor(Cursor.Pointer)
                ui.onClick(|| Message.Select { id: issue.node })
                ui.onEnter(|| Message.Select { id: issue.node })
                ui.gap(8.0)
                border(&mut ui, Property.BorderBottomWidth, BAR)
                paddings(&mut ui, 2.0, 0.0)
                if issue.node == self.selected {
                  ui.background(rgb(SELECTED))
                } else {
                  ui.hover(&[css.backgroundColor(rgb(HOVER))])
                }
                ui.focusVisible(&[css.backgroundColor(rgb(SELECTED))])
                ui.box(
                  |ui| {
                    ui.style(&[css.width(px(88.0)), css.flexShrink(0.0)])
                    ui.color(rgb(ruleColor(String.view(&issue.rule))))
                    ui.text(String.view(&issue.rule))
                  },
                )
                ui.column(
                  |ui| {
                    ui.grow(1.0)
                    ui.style(&[css.flexBasis(px(0.0)), css.minWidth(px(0.0))])
                    ui.box(
                      |ui| {
                        ui.color(rgb(TAG))
                        ui.text(String.view(&issue.label))
                      },
                    )
                    ui.box(
                      |ui| {
                        ui.color(rgb(MUTED))
                        ui.text(String.view(&issue.message))
                      },
                    )
                  },
                )
              },
            )
          },
        )
      },
    )
  }

  /// An extension's panel: its data, members and elements in rows, nested ones indented.
  fn extensionPanel(self: &Self, ui: &mut Ui<Message>) -> () {
    if self.data.length() == 0 {
      muted(&mut ui, "No data yet.")
      return ()
    }
    ui.column(
      |ui| {
        ui.testId("panel-data")
        ui.accessRole(Role.List)
        ui.enumerate(
          self.data.asSlice(),
          |row| 0,
          |ui, index, row| {
            ui.key(usize.toU64(index))
            ui.row(
              |ui| {
                ui.accessRole(Role.ListItem)
                ui.style(
                  &[
                    css.whiteSpace(WhiteSpace.NoWrap),
                    css.paddingLeft(px(u32.toF32(row.depth) * 12.0)),
                    css.columnGap(px(6.0)),
                  ],
                )
                border(&mut ui, Property.BorderBottomWidth, BAR)
                ui.box(
                  |ui| {
                    ui.color(rgb(ATTRIBUTE))
                    ui.text(String.view(&row.key))
                  },
                )
                ui.box(
                  |ui| {
                    ui.color(rgb(TEXT))
                    ui.text(String.view(&row.value))
                  },
                )
              },
            )
          },
        )
      },
    )
  }

  fn statsPanel(self: &Self, ui: &mut Ui<Message>) -> () {
    if self.stats.length() == 0 {
      muted(&mut ui, "No frame stats yet.")
      return ()
    }
    ui.column(
      |ui| {
        ui.testId("stats")
        ui.enumerate(
          self.stats.asSlice(),
          |stat| 0,
          |ui, index, stat| {
            ui.key(usize.toU64(index))
            ui.row(
              |ui| {
                border(&mut ui, Property.BorderBottomWidth, BAR)
                paddings(&mut ui, 1.0, 0.0)
                ui.box(
                  |ui| {
                    ui.style(&[css.width(px(170.0))])
                    ui.color(rgb(MUTED))
                    ui.text(String.view(&stat.name))
                  },
                )
                ui.text(String.view(&stat.value))
              },
            )
          },
        )
      },
    )
  }
}

impl App<Message, Command> for Devtools {
  fn view(self: &Self, ui: &mut Ui<Message>) -> () {
    ui.style(
      &[
        css.fontFamily(self.font),
        css.fontSize(px(12.0)),
        css.color(rgb(TEXT)),
        css.backgroundColor(rgb(0xFFFFFF)),
      ],
    )
    self.toolbar(&mut ui)
    ui.row(
      |ui| {
        scrolling(&mut ui)
        ui.style(&[css.overflowY(Overflow.Hidden)])
        self.elements(&mut ui)
        self.side(&mut ui)
      },
    )
  }

  fn update(self: &mut Self, message: Message, cx: &mut Context<Command>) -> () {
    match move message {
      Message.Refresh => {
        self.sync(&mut cx)
      }
      Message.Tick { time: _ } => {
        if self.error.ownedByteLength() != 0 {
          self.sync(&mut cx)
        }
      }
      Message.Pull => {
        cx.command(Command.Pull { since: self.since, selected: self.selected, panel: self.panel })
      }
      Message.Hover { id } => {
        self.hovered = id
        cx.command(Command.Highlight { node: id })
      }
      Message.Unhover { id } => {
        // The selection keeps its highlight; the pointer may already be on another row.
        if self.hovered == id {
          self.hovered = NO_PARENT
          cx.command(Command.Highlight { node: self.selected })
        }
      }
      Message.Sent => {}
      Message.ToggleLive => {
        self.live = !self.live
        if self.live {
          self.sync(&mut cx)
        } else {
          self.resubscribe(&mut cx)
        }
      }
      Message.Select { id } => {
        self.select(id, &mut cx)
      }
      Message.Collapse { id } => {
        let mut i: usize = 0
        let mut found = false
        while i < self.collapsed.length() {
          if self.collapsed.asSlice()[i] == id {
            drop self.collapsed.remove(i)
            found = true
          } else {
            i = i + 1
          }
        }
        if !found {
          cx.alloc(self.collapsed.append(id))
        }
        self.updateVisibility()
      }
      Message.Show { panel } => {
        self.panel = panel
        self.sync(&mut cx)
      }
      Message.ShowPanel { index } => {
        self.panel = Panel.Extension
        self.shown = index
        self.data.clear()
        self.sync(&mut cx)
      }
      Message.Search { value } => {
        self.search = move value
        self.updateVisibility()
      }
      Message.TogglePick => {
        self.picking = !self.picking
        cx.command(Command.Pick { on: self.picking })
      }
      Message.Picking { on } => {
        self.picking = on
      }
      Message.StyleDraft { value } => {
        self.draft = move value
      }
      Message.ApplyStyle => {
        if self.selected != NO_PARENT && self.draft.ownedByteLength() != 0 {
          let declarations = cx.alloc(String.copy(String.view(&self.draft)))
          cx.command(Command.SetStyle { node: self.selected, css: move declarations })
        }
      }
      Message.ResetStyles => {
        cx.command(Command.ResetStyles { selected: self.selected })
      }
      Message.Styled { detail } => {
        self.styleError.clear()
        self.draft.clear()
        if detail.id != NO_PARENT {
          self.detail = move detail
        }
      }
      Message.StyleRefused { error } => {
        self.styleError = move error
      }
      Message.OpenStep { seq } => {
        if self.opened.seq == seq {
          self.opened = ModelView.none()
        } else {
          let line = cx.alloc(requestLine("silk-ui.model", "seq", seq))
          self.ask(&mut cx, String.view(&line), ASK_MODEL, 0)
        }
      }
      Message.Asked { asked } => {
        cx.alloc(self.asked.append(asked))
      }
      Message.ClearSteps => {
        self.steps.clear()
        self.opened = ModelView.none()
      }
      Message.RunAudit => {
        cx.command(Command.Audit)
      }
      Message.Audited { issues, line } => {
        self.issues = move issues
        self.auditLine = move line
      }
      Message.SelectNext => {
        let id = self.step(true)
        self.select(id, &mut cx)
      }
      Message.SelectPrevious => {
        let id = self.step(false)
        self.select(id, &mut cx)
      }
      Message.ClearSelection => {
        self.selected = NO_PARENT
        self.detail = Detail.none()
        cx.command(Command.Unhighlight)
      }
      Message.ClearEvents => {
        self.events.clear()
      }
      Message.Synced { snapshot } => {
        let mut s = move snapshot
        while s.replies.length() != 0 {
          let line = s.replies.remove(0)
          self.answered(&line, &mut cx)
        }
        let full = s.parts == PART_ALL
        if let Option<List<String>>.Some { value } = Intrinsic.replace(
          s.extensions,
          Option<List<String>>.None,
        ) {
          self.extensions = move value
          self.panels = Intrinsic.replace(s.panels, List<PanelInfo>.make())
          if (self.panel == Panel.Program && !self.hasProgram())
            || (self.panel == Panel.Extension && self.shown >= self.panels.length()) {
            self.panel = Panel.Styles
          }
          self.resubscribe(&mut cx)
        }
        let mut news = false
        let names = s.news.asSlice()
        let mut n: usize = 0
        while n < names.length {
          if String.view(&names[n]) == "silk-ui.message" {
            news = true
          }
          n = n + 1
        }
        if full || news {
          self.readProgram(&mut cx)
        }
        if full || self.panelNews(&s.news) {
          self.readPanel(&mut cx)
        }
        if s.parts == 0 && s.frames.isNone() {
          return ()
        }
        self.syncs = self.syncs + 1
        self.error.clear()
        if u32.bitAnd(s.parts, PART_STATUS) != 0 {
          self.status = Intrinsic.replace(s.status, String.make())
        }
        if u32.bitAnd(s.parts, PART_ROWS) != 0 {
          self.rows = Intrinsic.replace(s.rows, List<Row>.make())
          self.updateVisibility()
        }
        if u32.bitAnd(s.parts, PART_STATS) != 0 {
          self.stats = Intrinsic.replace(s.stats, List<Stat>.make())
        }

        if u32.bitAnd(s.parts, PART_EVENTS) != 0 {
          // Two reads may be out at once and answer with the same records.
          while s.events.length() != 0 {
            let e = s.events.remove(0)
            if e.seq > self.since {
              cx.alloc(self.events.append(move e))
            }
          }
          while self.events.length() > MAX_LOG {
            drop self.events.remove(0)
          }

          // `next` is the seq the next record gets; ask for the ones after the last.
          self.since = if s.next > 0 {
            s.next - 1
          } else {
            0
          }
        }

        match Intrinsic.replace(s.frames, Option<FrameView>.None) {
          Option<FrameView>.Some { value } => {
            self.frames = move value
          }
          Option<FrameView>.None => {}
        }

        // The press in the app's window ends the pick: select what it chose.
        if u32.bitAnd(s.parts, PART_PICK) != 0 && self.picking && !s.picking {
          self.picking = false
          if s.picked != NO_PARENT {
            self.expose(s.picked)
            self.select(s.picked, &mut cx)
            return ()
          }
        }
        if u32.bitAnd(s.parts, PART_DETAIL) != 0 && self.selected != NO_PARENT {
          match Intrinsic.replace(s.detail, Option<Detail>.None) {
            Option<Detail>.Some { value } => {
              self.detail = move value
            }
            Option<Detail>.None => {
              // The node is gone.
              self.selected = NO_PARENT
              self.detail = Detail.none()
            }
          }
        }
      }
      Message.Inspected { detail } => {
        self.detail = move detail
        if self.detail.id == NO_PARENT {
          self.selected = NO_PARENT
        }
      }
      Message.Failed { error } => {
        self.error = move error
      }
    }
  }

  fn subscriptions(self: &Self, subs: &mut Subscriptions<Message>) -> () {
    if self.error.ownedByteLength() != 0 {
      subs.every(1, RETRY_INTERVAL, |time| Message.Tick { time: time })
    }
    subs.keyBinding(2, "ArrowDown", 0, || Message.SelectNext)
    subs.keyBinding(3, "ArrowUp", 0, || Message.SelectPrevious)
    subs.keyBinding(4, "Escape", 0, || Message.ClearSelection)
    subs.keyBinding(5, "F5", 0, || Message.Refresh)
  }
}
