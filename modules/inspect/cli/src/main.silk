//! `ui-inspect-cli`: talks to a running Silk UI's inspector (see modules/inspect/server).
//!
//!   ui-inspect-cli [--connect ADDRESS] COMMAND [OPTIONS]
//!
//! ADDRESS is in the syntax of `SILK_UI_INSPECT` (`1`, `tcp:<port>` or a socket path); without
//! `--connect` the CLI reads `SILK_UI_INSPECT`, and without that it uses `1`.
//!
//! Commands: hello, extensions, snapshot [--styles], query, inspect, pick X Y, highlight [ID ...],
//! screenshot FILE, click, hover, scroll [--dx N] [--dy N], press KEY [--code CODE],
//! type TEXT, wait [--gone] [--timeout MS], stats, raw JSON.
//!
//! Devtools: program, messages [--since SEQ] [--limit N], model [--seq SEQ],
//! frames [--since FRAME] [--limit N], styles, set-style CSS [--state STATE] [--replace],
//! reset-styles, pick-mode [on|off], audit. These print for people; `--json` prints the reply
//! line instead.
//!
//! Extensions: `extensions` lists what the app's extensions add (`hello`'s `extensions`, for
//! people); any of their commands runs by its name, `<id>.<command>`, with the options above as
//! its request members, and prints the reply line.
//!
//! Targets: --node ID, --role ROLE, --name TEXT, --label TEXT, --text TEXT, --test-id ID,
//! --within ID, --exact, --hidden. Input commands also take --modifiers shift,control,alt,meta
//! and click takes --count N; query takes --limit N.
//!
//! Text replies (snapshot, inspect) print their text; screenshot writes the PNG; the others
//! print the reply line. Exit code 0 on `"ok": true`, 1 on a failed command, 2 when the app
//! cannot be reached or the arguments are wrong.
import ui_inspect_server.server { Address, parseAddress, describeAddress, resolved }
import ui_inspect_server.reply { writeString }
import ui_inspect_server.mcp { Bridge, Action, writeValue }
import ui_inspect_server.client as client
import silk.num.i64
import ui_inspect_server.client { connect, exchange }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.encoding.base64 { Base64, Base64Error }
import silk.io.byte_duplex { ByteIoError }
import silk.io.writer { Writer }
import silk.io.writer_native { StderrWriter, StdoutWriter }
import silk.json.scanner { JsonError }
import silk.json.value { Json, Value }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.net.socket_native { NativeSocketError }
import silk.collections.slice { Slice }
import silk.num.u64
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.system.host_input { HostInput, HostInputError }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }

static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.platform.windows.path { WindowsPath }
}

import silk.system.system_clock { SystemClock }
import silk.text.format { Format, ParseError }
import silk.text.string { String, InvalidUtf8 }

effect fn out(text: string) -> () {
  let mut writer = StdoutWriter.make()
  drop run Effect.result(Writer.writeString(text) |> Effect.provideMut<Writer>(&mut writer))
  drop run Effect.result(Writer.flush() |> Effect.provideMut<Writer>(&mut writer))
}

effect fn err(text: string) -> () {
  let mut writer = StderrWriter.make()
  drop run Effect.result(Writer.writeString(text) |> Effect.provideMut<Writer>(&mut writer))
}

fn textOf(bytes: &Bytes) -> string {
  return match HostInput.text(bytes.asSlice()) {
    Result<string, InvalidUtf8>.Success { value } => value
    Result<string, InvalidUtf8>.Failure { error: _ } => ""
  }
}

/// The parsed command line.
struct Command {
  connect: String,
  cmd: String,
  /// Positional arguments after the command.
  positional: List<String>,
  /// The request members built from the options, each starting with a comma.
  members: String,
  /// For `screenshot`.
  file: String,
  timeout: u64,
  /// For `raw`: the request as given.
  raw: String,
  /// Print the reply line where a command would print for people.
  json: bool,
}

/// Options that take a text value, and the request member they become.
fn textOption(flag: string) -> string<'static> {
  if flag == "--phase" {
    return "phase"
  }
  if flag == "--key" {
    return "key"
  }
  if flag == "--role" {
    return "role"
  }
  if flag == "--name" {
    return "name"
  }
  if flag == "--label" {
    return "label"
  }
  if flag == "--text" {
    return "text"
  }
  if flag == "--test-id" {
    return "testId"
  }
  if flag == "--code" {
    return "code"
  }
  if flag == "--state" {
    return "state"
  }
  return ""
}

/// Options that take a number, and their request member.
fn numberOption(flag: string) -> string<'static> {
  if flag == "--interval" {
    return "intervalMs"
  }
  if flag == "--columns" {
    return "columns"
  }
  if flag == "--tile-width" {
    return "tileWidth"
  }
  if flag == "--button" {
    return "button"
  }
  if flag == "--node" {
    return "node"
  }
  if flag == "--within" {
    return "within"
  }
  if flag == "--dx" {
    return "dx"
  }
  if flag == "--dy" {
    return "dy"
  }
  if flag == "--count" {
    return "count"
  }
  if flag == "--limit" {
    return "limit"
  }
  if flag == "--x" {
    return "x"
  }
  if flag == "--y" {
    return "y"
  }
  if flag == "--since" {
    return "since"
  }
  if flag == "--seq" {
    return "seq"
  }
  return ""
}

effect fn appendInt(out: &mut String, value: u64) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut digits: [u8; 20] = [0; 20]
  let mut n = value
  let mut at: usize = 20
  while true {
    at = at - 1
    digits[at] = u64.toU8(n % 10) + 48
    n = n / 10
    if n == 0 {
      break
    }
  }
  run out.append(unsafe String.fromUtf8Unchecked(Slice.view(&digits, at, 20 - at)))
}

fn isNumber(value: string) -> bool {
  let bytes = String.utf8Bytes(value)
  if bytes.length == 0 {
    return false
  }
  let mut i: usize = 0
  while i < bytes.length {
    let b = bytes[i]
    if !(b >= 48 && b <= 57 || b == 46 || b == 45 && i == 0) {
      return false
    }
    i = i + 1
  }
  return true
}

/// Parses the arguments; None (after printing why) when they are wrong.
effect fn parse(args: &List<Bytes>) -> Option<Command>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut c = Command {
    connect: String.make(),
    cmd: String.make(),
    positional: List<String>.make(),
    members: String.make(),
    file: String.make(),
    timeout: 5000,
    raw: String.make(),
    json: false,
  }
  let list = args.asSlice()
  let mut modifiers = String.make()
  let mut i: usize = 1
  while i < list.length {
    let a = textOf(&list[i])
    let next = if i + 1 < list.length {
      textOf(&list[i + 1])
    } else {
      ""
    }
    let hasNext = i + 1 < list.length
    if a == "--connect" && hasNext {
      c.connect = run String.copy(next)
      i = i + 2
    } else if textOption(a) != "" && hasNext {
      run c.members.append(",\"")
      run c.members.append(textOption(a))
      run c.members.append("\":")
      run writeString(&mut c.members, next)
      i = i + 2
    } else if numberOption(a) != "" && hasNext {
      if !isNumber(next) {
        run err("ui-inspect-cli: ")
        run err(a)
        run err(" needs a number\n")
        return Option<Command>.None
      }
      run c.members.append(",\"")
      run c.members.append(numberOption(a))
      run c.members.append("\":")
      run c.members.append(next)
      i = i + 2
    } else if a == "--timeout" && hasNext {
      c.timeout = match move Format.u64Value(next) {
        Result<u64, ParseError>.Success { value } => value
        Result<u64, ParseError>.Failure { error: _ } => 5000
      }
      i = i + 2
    } else if a == "--modifiers" && hasNext {
      modifiers = run String.copy(next)
      i = i + 2
    } else if a == "--json" {
      c.json = true
      i = i + 1
    } else if a == "--exact" || a == "--hidden" || a == "--gone" || a == "--styles"
      || a == "--replace" {
      run c.members.append(",\"")
      run c.members.append(String.slice(a, 2, String.byteLength(a) - 2))
      run c.members.append("\":true")
      i = i + 1
    } else if String.startsWith(a, "--") {
      run err("ui-inspect-cli: unknown option ")
      run err(a)
      run err("\n")
      return Option<Command>.None
    } else if c.cmd.ownedByteLength() == 0 {
      c.cmd = run String.copy(a)
      i = i + 1
    } else {
      run c.positional.append(run String.copy(a))
      i = i + 1
    }
  }
  if modifiers.ownedByteLength() != 0 {
    run c.members.append(",\"modifiers\":[")
    let mut parts = String.split(String.view(&modifiers), ",")
    let mut first = true
    while true {
      match parts.next() {
        Option<string>.Some { value } => {
          if !first {
            run c.members.append(",")
          }
          run writeString(&mut c.members, value)
          first = false
        }
        Option<string>.None => {
          break
        }
      }
    }
    run c.members.append("]")
  }
  if c.cmd.ownedByteLength() == 0 {
    run err("usage: ui-inspect-cli [--connect ADDRESS] COMMAND [OPTIONS] (see the README)\n")
    return Option<Command>.None
  }
  return Option<Command>.Some { value: move c }
}

/// The protocol's name of a command the CLI spells with dashes.
fn wireName(cmd: string) -> string {
  if cmd == "set-style" {
    return "setStyle"
  }
  if cmd == "reset-styles" {
    return "resetStyles"
  }
  if cmd == "pick-mode" {
    return "pickMode"
  }
  if cmd == "extensions" {
    return "hello"
  }
  return cmd
}

fn items<'a>(document: &'a Value, key: string) -> &'a [Value] {
  return match Json.field(document, key) {
    Option<&Value>.Some { value } => match &value.* {
      Value.Array { values } => values.asSlice()
      _ => &[]
    }
    Option<&Value>.None => &[]
  }
}

fn flag(value: &Value, key: string) -> bool {
  return match Json.field(value, key) {
    Option<&Value>.Some { value: found } => match &found.* {
      Value.Bool { value: b } => b
      _ => false
    }
    Option<&Value>.None => false
  }
}

fn word<'a>(value: &'a Value, key: string) -> string<'a> {
  return Json.asString(Json.field(value, key)).unwrapOr("")
}

effect fn number(text: &mut String, value: &Value, key: string) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match Json.field(value, key) {
    Option<&Value>.Some { value: found } => {
      run writeValue(&mut text, found)
    }
    Option<&Value>.None => {
      run text.append("-")
    }
  }
}

/// Appends `label` and the names in `list`, each as `<id>.<name>`, on one line.
effect fn names(text: &mut String, label: string, id: string, list: &[Value]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if list.length == 0 {
    return ()
  }
  run text.append(label)
  let mut i: usize = 0
  while i < list.length {
    run text.append(" ")
    run text.append(id)
    run text.append(".")
    run text.append(Json.asString(Option<&Value>.Some { value: &list[i] }).unwrapOr(""))
    i = i + 1
  }
  run text.append("\n")
}

/// Prints the reply of a devtools command for a person. False when `cmd` has no such form.
effect fn pretty(cmd: string, document: &Value) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = String.make()
  if cmd == "extensions" {
    let list = items(document, "extensions")
    let mut i: usize = 0
    while i < list.length {
      let e = &list[i]
      let id = word(e, "id")
      run text.append(id)
      run text.append(" ")
      run text.append(word(e, "version"))
      run text.append("\n")
      run names(&mut text, "  commands:", id, items(e, "commands"))
      run names(&mut text, "  topics:", id, items(e, "topics"))
      let panels = items(e, "panels")
      let mut p: usize = 0
      while p < panels.length {
        let panel = &panels[p]
        run text.append("  panel ")
        run text.append(word(panel, "id"))
        run text.append(" \"")
        run text.append(word(panel, "title"))
        run text.append("\"")
        if word(panel, "data") != "" {
          run text.append(", data from ")
          run text.append(id)
          run text.append(".")
          run text.append(word(panel, "data"))
        }
        if word(panel, "view") != "" {
          run text.append(", view on ")
          run text.append(id)
          run text.append(".")
          run text.append(word(panel, "view"))
        }
        run text.append("\n")
        p = p + 1
      }
      i = i + 1
    }
    if list.length == 0 {
      run text.append("(no extensions)\n")
    }
  } else if cmd == "messages" {
    let list = items(document, "messages")
    let mut i: usize = 0
    while i < list.length {
      let m = &list[i]
      run text.append("#")
      run number(&mut text, m, "seq")
      run text.append(
        if flag(m, "changed") {
          " * "
        } else {
          "   "
        },
      )
      run text.append(word(m, "message"))
      run text.append("    <- ")
      run text.append(word(m, "cause"))
      run text.append("\n")
      let commands = items(m, "commands")
      let mut k: usize = 0
      while k < commands.length {
        run text.append("       -> ")
        run text.append(Json.asString(Option<&Value>.Some { value: &commands[k] }).unwrapOr(""))
        run text.append("\n")
        k = k + 1
      }
      i = i + 1
    }
    if list.length == 0 {
      run text.append("(no messages)\n")
    }
  } else if cmd == "model" {
    run text.append("#")
    run number(&mut text, document, "seq")
    run text.append(" ")
    run text.append(word(document, "message"))
    run text.append("    <- ")
    run text.append(word(document, "cause"))
    run text.append("\n")
    let lines = items(document, "diff")
    let mut i: usize = 0
    while i < lines.length {
      run text.append(word(&lines[i], "op"))
      run text.append(" ")
      run text.append(word(&lines[i], "line"))
      run text.append("\n")
      i = i + 1
    }
  } else if cmd == "program" {
    if !(flag(document, "attached")) {
      run text.append("no program is attached (the host does not report one)\n")
    } else {
      run text.append("steps: ")
      run number(&mut text, document, "steps")
      run text.append("\nsubscriptions:\n")
      let subs = items(document, "subscriptions")
      let mut i: usize = 0
      while i < subs.length {
        run text.append("  ")
        run text.append(Json.asString(Option<&Value>.Some { value: &subs[i] }).unwrapOr(""))
        run text.append("\n")
        i = i + 1
      }
      match Json.field(document, "stats") {
        Option<&Value>.Some { value } => {
          run text.append("stats: ")
          run writeValue(&mut text, value)
          run text.append("\n")
        }
        Option<&Value>.None => {}
      }
      run text.append("model:\n")
      run text.append(word(document, "model"))
      run text.append("\n")
    }
  } else if cmd == "frames" {
    let list = items(document, "frames")
    run text.append("frame  layout ms  paint ms  repainted  replayed  primitives  glyphs\n")
    let mut i: usize = 0
    while i < list.length {
      let f = &list[i]
      run number(&mut text, f, "frame")
      run text.append("  ")
      run number(&mut text, f, "layoutMs")
      run text.append(
        if flag(f, "layoutSkipped") {
          " (skipped)  "
        } else {
          "  "
        },
      )
      run number(&mut text, f, "paintMs")
      run text.append("  ")
      run number(&mut text, f, "repainted")
      run text.append("  ")
      run number(&mut text, f, "replayed")
      run text.append("  ")
      run number(&mut text, f, "primitives")
      run text.append("  ")
      run number(&mut text, f, "glyphs")
      run text.append("\n")
      i = i + 1
    }
    run text.append("slowest ")
    run number(&mut text, document, "slowestMs")
    run text.append(" ms, average ")
    run number(&mut text, document, "averageMs")
    run text.append(" ms over ")
    run number(&mut text, document, "count")
    run text.append(" frames\n")
  } else if cmd == "audit" {
    let list = items(document, "issues")
    let mut i: usize = 0
    while i < list.length {
      let issue = &list[i]
      let node = Json.field(issue, "node").unwrapOr(issue)
      run text.append(word(issue, "rule"))
      run text.append("  #")
      run number(&mut text, node, "id")
      run text.append(" ")
      run text.append(word(node, "kind"))
      if word(node, "role") != "" {
        run text.append(" ")
        run text.append(word(node, "role"))
      }
      if word(node, "name") != "" {
        run text.append(" \"")
        run text.append(word(node, "name"))
        run text.append("\"")
      }
      run text.append(": ")
      run text.append(word(issue, "message"))
      run text.append("\n")
      i = i + 1
    }
    run number(&mut text, document, "count")
    run text.append(" issues in ")
    run number(&mut text, document, "checked")
    run text.append(" nodes\n")
  } else {
    return false
  }
  run out(String.view(&text))
  return true
}

/// The request line for `c` (without the newline), or false after printing why.
effect fn request(c: &mut Command, line: &mut String) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let cmd = String.view(&c.cmd)
  let pos = c.positional.asSlice()
  if cmd == "raw" {
    if pos.length != 1 {
      run err("ui-inspect-cli: raw takes one JSON request\n")
      return false
    }
    run line.append(String.view(&pos[0]))
    return true
  }
  run line.append("{\"id\":1,\"cmd\":")
  run writeString(&mut line, wireName(cmd))
  if cmd == "set-style" {
    if pos.length != 1 {
      run err(
        "ui-inspect-cli: set-style takes the declarations, as in \"width: 10px; color: red\"\n",
      )
      return false
    }
    run line.append(",\"style\":")
    run writeString(&mut line, String.view(&pos[0]))
  } else if cmd == "pick-mode" {
    if pos.length > 1
      || (pos.length == 1 && String.view(&pos[0]) != "on" && String.view(&pos[0]) != "off") {
      run err("ui-inspect-cli: pick-mode takes on or off, or nothing to ask\n")
      return false
    }
    if pos.length == 1 {
      run line.append(
        if String.view(&pos[0]) == "on" {
          ",\"on\":true"
        } else {
          ",\"on\":false"
        },
      )
    }
  } else if cmd == "pick" {
    if pos.length != 2 || !isNumber(String.view(&pos[0])) || !isNumber(String.view(&pos[1])) {
      run err("ui-inspect-cli: pick takes X Y\n")
      return false
    }
    run line.append(",\"x\":")
    run line.append(String.view(&pos[0]))
    run line.append(",\"y\":")
    run line.append(String.view(&pos[1]))
  } else if cmd == "highlight" {
    run line.append(",\"nodes\":[")
    let mut k: usize = 0
    while k < pos.length {
      if !isNumber(String.view(&pos[k])) {
        run err("ui-inspect-cli: highlight takes node ids\n")
        return false
      }
      if k > 0 {
        run line.append(",")
      }
      run line.append(String.view(&pos[k]))
      k = k + 1
    }
    run line.append("]")
    if pos.length == 0 && c.members.ownedByteLength() != 0 {
      // A query instead of ids.
      line.clear()
      run line.append("{\"id\":1,\"cmd\":\"highlight\"")
    }
  } else if cmd == "screenshot" || cmd == "capture" {
    if pos.length != 1 {
      run err("ui-inspect-cli: screenshot takes the PNG file to write\n")
      return false
    }
    c.file = run String.copy(String.view(&pos[0]))
  } else if cmd == "press" || cmd == "key" {
    if pos.length != 1 {
      run err("ui-inspect-cli: press takes a key (UI Events key value, such as Enter or a)\n")
      return false
    }
    run line.append(",\"key\":")
    run writeString(&mut line, String.view(&pos[0]))
  } else if cmd == "type" {
    if pos.length != 1 {
      run err("ui-inspect-cli: type takes the text to type\n")
      return false
    }
    run line.append(",\"text\":")
    run writeString(&mut line, String.view(&pos[0]))
  } else if pos.length != 0 {
    run err("ui-inspect-cli: unexpected argument ")
    run err(String.view(&pos[0]))
    run err("\n")
    return false
  }
  if cmd == "wait" {
    run line.append(",\"timeout\":")
    run appendInt(&mut line, c.timeout)
  }
  run line.append(String.view(&c.members))
  run line.append("}")
  return true
}

/// Writes the screenshot in `reply` to `file`. False when the reply has no PNG.
effect fn saveScreenshot(document: &Value, file: string) -> bool
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator | &mut HostInput {
  let text = match Json.asString(Json.field(document, "png")) {
    Option<string>.Some { value } => value
    Option<string>.None => {
      return false
    }
  }
  let encoded = String.utf8Bytes(text)
  let length = match Base64.decodedLength(encoded) {
    Result<usize, Base64Error>.Success { value } => value
    Result<usize, Base64Error>.Failure { error: _ } => {
      return false
    }
  }
  let mut png = run Bytes.zeroed(length)
  match Base64.decodeInto(png.asMutSlice(), encoded) {
    Result<usize, Base64Error>.Success { value: _ } => {}
    Result<usize, Base64Error>.Failure { error: _ } => {
      return false
    }
  }
  let path = if String.startsWith(file, "/") {
    run Path.fromBytes(String.utf8Bytes(file))
  } else {
    let cwd = run HostInput.workingDirectory()
    let base = run hostDirectory(cwd.asSlice())
    run Path.resolveBytes(&base, String.utf8Bytes(file))
  }
  let mut files = run MachineFileSystem.make()
  run FileSystem.writeFile(&path, png.asSlice()) |> Effect.provideMut<FileSystem>(&mut files)
  return true
}

/// Runs one request and prints its result. Returns the exit code, or 3 for a `wait` that is
/// not satisfied yet.
effect fn serveOnce(address: &Address, c: &Command, line: &String) -> i32
  ! NativeSocketError | ByteIoError | FileError | HostInputError | OutOfMemoryError
  ? &mut MonotonicClock | &mut Allocator | &mut HostInput {
  if String.view(&c.cmd) == "capture" {
    return run captureSequence(address, c, line)
  }
  let mut connection = run connect(address)
  let mut reply = Bytes.make()
  run exchange(&mut connection, String.view(line), &mut reply)
  drop run Effect.result(connection.close())
  let parsed = run Effect.result(Json.parse(reply.asSlice()))
  let document = match move parsed {
    Result<Value, JsonError | OutOfMemoryError>.Success { value } => move value
    Result<Value, JsonError | OutOfMemoryError>.Failure { error } => {
      drop error
      run err("ui-inspect-cli: the app's reply is not JSON\n")
      return 2
    }
  }
  let ok = match Json.field(&document, "ok") {
    Option<&Value>.Some { value } => match &value.* {
      Value.Bool { value: b } => b
      _ => false
    }
    Option<&Value>.None => false
  }
  if !ok {
    let pending = match Json.field(&document, "pending") {
      Option<&Value>.Some { value } => match &value.* {
        Value.Bool { value: b } => b
        _ => false
      }
      Option<&Value>.None => false
    }
    if pending {
      return 3
    }
    run err("ui-inspect-cli: ")
    run err(
      match Json.asString(Json.field(&document, "error")) {
        Option<string>.Some { value } => value
        Option<string>.None => "the command failed"
      },
    )
    run err("\n")
    return 1
  }
  let cmd = String.view(&c.cmd)
  if cmd == "screenshot" || cmd == "capture" {
    if !run saveScreenshot(&document, String.view(&c.file)) {
      run err("ui-inspect-cli: the reply has no PNG\n")
      return 1
    }
    let mut text = run String.copy("wrote ")
    run text.append(String.view(&c.file))
    run text.append("\n")
    run out(String.view(&text))
    return 0
  }
  if cmd == "snapshot" || cmd == "inspect" {
    match Json.asString(Json.field(&document, "text")) {
      Option<string>.Some { value } => {
        run out(value)
        return 0
      }
      Option<string>.None => {}
    }
  }
  if !c.json && run pretty(cmd, &document) {
    return 0
  }
  run out(textOf(&reply))
  run out("\n")
  return 0
}

/// Uses the same capture implementation as the MCP tool, with a PNG file as the output.
effect fn captureSequence(address: &Address, c: &Command, line: &String) -> i32
  ! NativeSocketError | ByteIoError | FileError | HostInputError | OutOfMemoryError
  ? &mut MonotonicClock | &mut Allocator | &mut HostInput {
  let mut description = String.make()
  run describeAddress(address, &mut description)
  let mut bridge = run Bridge.make(String.view(&description))
  let mut call = run String.copy(
    "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"ui_capture\",\"arguments\":",
  )
  run call.append(String.view(line))
  run call.append("}}")
  let mut wire = String.make()
  let mut action = run bridge.handle(call.ownedUtf8Bytes(), &mut wire)
  let start = run MonotonicClock.now()
  let mut reply = Bytes.make()
  while action == Action.Ask || action == Action.Retry {
    if action == Action.Retry {
      let clockNow = run MonotonicClock.now()
      let since = (SystemClock.seconds(&clockNow) - SystemClock.seconds(&start)) * 1000
        + (SystemClock.nanoseconds(&clockNow) - SystemClock.nanoseconds(&start)) / 1000000
      run MonotonicClock.waitFor(bridge.retryDelay(i64.toU64(since)) * 1000000)
    }
    run client.request(address, String.view(&wire), &mut reply)
    let now = run MonotonicClock.now()
    let a = SystemClock.seconds(&start) * 1000 + SystemClock.nanoseconds(&start) / 1000000
    let b = SystemClock.seconds(&now) * 1000 + SystemClock.nanoseconds(&now) / 1000000
    action = run bridge.answer(reply.asSlice(), true, i64.toU64(b - a), &mut wire)
  }
  let parsed = run Effect.result(Json.parse(wire.ownedUtf8Bytes()))
  if let Result<Value, JsonError | OutOfMemoryError>.Success { value } = move parsed {
    let contents = Json.fieldAt(Json.field(&value, "result"), "content")
    if let Option<&Value>.Some { value: array } = contents {
      if let Value.Array { values } = &array.* {
        let children = values.asSlice()
        let mut i: usize = 0
        let mut saved = false
        while i < children.length {
          let item = &children[i]
          let kind = Json.asString(Json.field(item, "type")).unwrapOr("")
          if kind == "image" {
            let mut wrapped = run String.copy("{\"png\":")
            run writeString(&mut wrapped, Json.asString(Json.field(item, "data")).unwrapOr(""))
            run wrapped.append("}")
            let image = run Effect.result(Json.parse(wrapped.ownedUtf8Bytes()))
            if let Result<Value, JsonError | OutOfMemoryError>.Success { value: png } = move image {
              saved = run saveScreenshot(&png, String.view(&c.file))
            }
          } else if kind == "text" {
            run out(Json.asString(Json.field(item, "text")).unwrapOr(""))
            run out("\n")
          }
          i = i + 1
        }
        if saved {
          return 0
        }
      }
    }
  }
  run err("ui-inspect-cli: capture failed\n")
  return 1
}

effect fn process() -> i32
  ! HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let args = run HostInput.arguments()
  let mut c = match run parse(&args) {
    Option<Command>.Some { value } => move value
    Option<Command>.None => {
      return 2
    }
  }
  let mut line = String.make()
  if !run request(&mut c, &mut line) {
    return 2
  }
  let connectTo = if c.connect.ownedByteLength() != 0 {
    run String.copy(String.view(&c.connect))
  } else {
    match run HostInput.variableNamed("SILK_UI_INSPECT") {
      Option<Bytes>.Some { value } => run String.copy(textOf(&value))
      Option<Bytes>.None => run String.copy("1")
    }
  }
  let cwd = run HostInput.workingDirectory()
  let address = match run parseAddress(String.view(&connectTo)) {
    Option<Address>.Some { value } => run resolved(move value, cwd.asSlice())
    Option<Address>.None => {
      run err("ui-inspect-cli: the address is not 1, tcp:<port> or a socket path\n")
      return 2
    }
  }
  let mut clock = OsMonotonicClock.make()
  let start = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
  let waitLimit = MonotonicClock.deadlineAfter(&start, c.timeout * 1000000)
  while true {
    let result = run Effect.result(serveOnce(&address, &c, &line))
      |> Effect.provideMut<MonotonicClock>(&mut clock)
    let code = match move result {
      Result<
        i32,
        NativeSocketError | ByteIoError | FileError | HostInputError | OutOfMemoryError
      >.Success {
        value,
      } => value
      Result<
        i32,
        NativeSocketError | ByteIoError | FileError | HostInputError | OutOfMemoryError
      >.Failure {
        error,
      } => {
        drop error
        let mut text = run String.copy("ui-inspect-cli: could not talk to the app at ")
        run describeAddress(&address, &mut text)
        run text.append(" (is it running with SILK_UI_INSPECT set, in a debug build?)\n")
        run err(String.view(&text))
        return 2
      }
    }
    if code != 3 {
      return code
    }

    // A wait that does not hold yet: ask again until the timeout.
    let now = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
    if SystemClock.seconds(&now) > SystemClock.seconds(&waitLimit)
      || SystemClock.seconds(&now) == SystemClock.seconds(&waitLimit)
        && SystemClock.nanoseconds(&now) >= SystemClock.nanoseconds(&waitLimit) {
      run err("ui-inspect-cli: timed out\n")
      return 1
    }
    run MonotonicClock.waitFor(50000000) |> Effect.provideMut<MonotonicClock>(&mut clock)
  }
  return 2
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  run err("ui-inspect-cli: failed\n")
  return 2
}

pub effect fn main() -> i32
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(process(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}

// The working directory arrives in host spelling: `C:\...`, or an extended `\\?\` name, on Windows,
// which Path.fromBytes does not accept.
effect fn hostDirectory(bytes: &[u8]) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return run WindowsPath.fromNativeBytes(bytes)
  } else {
    return run Path.fromBytes(bytes)
  }
}
