//! What devtools do beyond looking: edit a node's styles while the app runs (through the
//! tree's override layer, `UiTree.setOverride`), and audit the tree for what a person using it
//! would trip over.
import nodes { nodeMembers }
import reply { begin, finish, putKey, putInt, failure, writeString }
import ui_inspect.query { accessibleName, visible }
import ui_inspect.view { writeDeclaration }
import ui_tree.css { Declaration, cloneDeclaration, set }
import ui_tree.engine { UiTree, StyleOverride }
import ui_tree.inspect { info, NodeInfo, writeNumber }
import ui_tree.mutation { NodeKind, Role, StyleState, LISTEN_CLICK, NOT_FOCUSABLE }
import ui_tree.node { NONE, Node }
import ui_tree.style { Fill }
import css_style.tokens { CssError }
import css_style.written as written
import silk.collections.list { List }
import silk.color.rgba { Rgba }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.json.value { Value }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.text.string { String }

/// The smallest side of something to click, as WCAG 2.2 asks (2.5.8).
pub const TARGET_SIZE: f32 = 24.0

/// The least contrast of text against what is behind it (WCAG 1.4.3), and of large text.
pub const CONTRAST: f32 = 4.5

pub const CONTRAST_LARGE: f32 = 3.0

/// Text from this size on is large.
pub const LARGE_TEXT: f32 = 24.0

/// The most issues an audit reports.
pub const ISSUE_LIMIT: usize = 200

pub fn stateNamed(name: string) -> Option<StyleState> {
  if name == "" || name == "base" {
    return Option<StyleState>.Some { value: StyleState.Base }
  }
  if name == "hover" {
    return Option<StyleState>.Some { value: StyleState.Hover }
  }
  if name == "active" {
    return Option<StyleState>.Some { value: StyleState.Active }
  }
  if name == "focus" {
    return Option<StyleState>.Some { value: StyleState.Focus }
  }
  if name == "focus-visible" {
    return Option<StyleState>.Some { value: StyleState.FocusVisible }
  }
  return Option<StyleState>.None
}

pub fn stateName(state: StyleState) -> string<'static> {
  return match state {
    StyleState.Base => "base"
    StyleState.Hover => "hover"
    StyleState.Active => "active"
    StyleState.Focus => "focus"
    StyleState.FocusVisible => "focus-visible"
  }
}

/// The declarations the client set on `node` for `state`.
pub fn patchOf(node: &Node, state: StyleState) -> &List<Declaration> {
  return match state {
    StyleState.Base => &node.base
    StyleState.Hover => &node.hover
    StyleState.Active => &node.active
    StyleState.Focus => &node.focus
    StyleState.FocusVisible => &node.focusVisible
  }
}

/// Every state, in the order replies list them.
pub const STATES: [StyleState; 5] = [
  StyleState.Base,
  StyleState.Hover,
  StyleState.Active,
  StyleState.Focus,
  StyleState.FocusVisible,
]

effect fn copied(list: &List<Declaration>) -> List<Declaration>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = List<Declaration>.make()
  let items = list.asSlice()
  let mut i: usize = 0
  while i < items.length {
    run out.append(run cloneDeclaration(&items[i]))
    i = i + 1
  }
  return move out
}

/// The declarations node `id` shows in `state`: what its client set, with the inspector's
/// override laid over them as the tree lays it.
pub effect fn shown(tree: &UiTree<'_>, id: u32, state: StyleState) -> List<Declaration>
  ! OutOfMemoryError
  ? &mut Allocator {
  let client = patchOf(tree.node(tree.slotOf(id)), state)
  return match tree.overrideOf(id, state) {
    Option<&StyleOverride>.Some { value } => {
      let mut merged = if value.replace {
        List<Declaration>.make()
      } else {
        run copied(client)
      }
      let items = value.declarations.asSlice()
      let mut i: usize = 0
      while i < items.length {
        run set(&mut merged, &items[i])
        i = i + 1
      }
      move merged
    }
    Option<&StyleOverride>.None => run copied(client)
  }
}

/// The declarations of `css` (`"width: 10px; color: red"`), or None with the failure written
/// to `out`: text that does not parse, or names nothing the tree knows (empty text is none,
/// which `replace` may set).
pub effect fn parseStyle(css: string, replace: bool, request: &Value, out: &mut String) -> Option<
  List<Declaration>
>
  ! OutOfMemoryError
  ? &mut Allocator {
  let parsed = run Effect.result(written.declarations(String.utf8Bytes(css)))
  let declarations = match move parsed {
    Result<List<Declaration>, CssError | OutOfMemoryError>.Success { value } => move value
    Result<List<Declaration>, CssError | OutOfMemoryError>.Failure { error } => {
      drop error
      run failure(&mut out, request, "the style does not parse")
      return Option<List<Declaration>>.None
    }
  }
  if declarations.length() == 0 && !replace {
    run failure(
      &mut out,
      request,
      if String.byteLength(css) == 0 {
        "the style is empty"
      } else {
        "the style has no declaration the tree knows"
      },
    )
    return Option<List<Declaration>>.None
  }
  return Option<List<Declaration>>.some(move declarations)
}

/// Lays `declarations` over node `id` in `state` through the tree's override layer: each set
/// into the node's override there as `css.set` would, or the override made of them alone and
/// replacing the client's declarations, with `replace`. The client's own declarations stay as
/// it set them underneath. Returns false when there is no such node.
pub effect fn layOver(
  tree: &mut UiTree<'_>,
  id: u32,
  state: StyleState,
  declarations: &List<Declaration>,
  replace: bool,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut list = List<Declaration>.make()
  let mut replacing = replace
  if !replace {
    if let Option<&StyleOverride>.Some { value } = tree.overrideOf(id, state) {
      list = run copied(&value.declarations)
      replacing = value.replace
    }
  }
  let items = declarations.asSlice()
  let mut i: usize = 0
  while i < items.length {
    run set(&mut list, &items[i])
    i = i + 1
  }
  return run tree.setOverride(id, state, move list, replacing)
}

/// Takes the declaration of `property` (a property name, as `parts` writes it) out of node
/// `id`'s override in `state`, so the client's own shows again there. Returns whether the
/// override had it.
pub effect fn dropProperty(
  tree: &mut UiTree<'_>,
  id: u32,
  state: StyleState,
  property: string,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut kept = List<Declaration>.make()
  let mut replacing = false
  let mut found = false
  match tree.overrideOf(id, state) {
    Option<&StyleOverride>.Some { value } => {
      replacing = value.replace
      let items = value.declarations.asSlice()
      let mut name = String.make()
      let mut text = String.make()
      let mut i: usize = 0
      while i < items.length {
        run parts(&items[i], &mut name, &mut text)
        if String.view(&name) == property {
          found = true
        } else {
          run kept.append(run cloneDeclaration(&items[i]))
        }
        i = i + 1
      }
    }
    Option<&StyleOverride>.None => {
      return false
    }
  }
  if found {
    drop run tree.setOverride(id, state, move kept, replacing)
  }
  return found
}

/// Takes the overrides of node `id` away, in `state` alone when one is given. Returns how many
/// (node, state) pairs show the client's declarations again.
pub fn resetNode(tree: &mut UiTree<'_>, id: u32, state: Option<StyleState>) -> usize {
  let mut restored: usize = 0
  let mut k: usize = 0
  while k < STATES.length {
    let wanted = match state {
      Option<StyleState>.Some { value } => value == STATES[k]
      Option<StyleState>.None => true
    }
    if wanted && tree.clearOverride(id, STATES[k]) {
      restored = restored + 1
    }
    k = k + 1
  }
  return restored
}

/// Takes every override away. Returns how many (node, state) pairs show the client's
/// declarations again.
pub effect fn resetAll(tree: &mut UiTree<'_>) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut pairs = List<u64>.make()
  let list = tree.styleOverrides()
  let mut i: usize = 0
  while i < list.length {
    run pairs.append(u64.bitOr(u32.toU64(list[i].id), u64.shiftLeft(stateIndex(list[i].state), 32)))
    i = i + 1
  }
  let mut restored: usize = 0
  let mut j: usize = 0
  while j < pairs.length() {
    let pair = pairs.get(j)
    let id = u64.toU32(u64.bitAnd(pair, 0xFFFFFFFF))
    let state = STATES[u64.toUsize(u64.shiftRight(pair, 32))]
    if tree.clearOverride(id, state) {
      restored = restored + 1
    }
    j = j + 1
  }
  return restored
}

fn stateIndex(state: StyleState) -> u64 {
  let mut k: usize = 0
  while k < STATES.length {
    if STATES[k] == state {
      return usize.toU64(k)
    }
    k = k + 1
  }
  return 0
}

/// The property name and the value text of `declaration`, as CSS writes them (`padding-top`,
/// `6px`).
pub effect fn parts(declaration: &Declaration, name: &mut String, value: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = String.make()
  run writeDeclaration(&mut text, declaration)
  name.clear()
  value.clear()
  let whole = String.view(&text)
  match String.find(whole, ": ") {
    Option<usize>.Some { value: colon } => {
      run name.append(String.slice(whole, 0, colon))
      run value.append(String.slice(whole, colon + 2, String.byteLength(whole) - colon - 2))
    }
    Option<usize>.None => {
      run name.append(whole)
    }
  }
}

/// Appends `list` as a JSON array of CSS texts.
pub effect fn declarationTexts(list: &List<Declaration>, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run out.append("[")
  let items = list.asSlice()
  let mut text = String.make()
  let mut i: usize = 0
  while i < items.length {
    if i > 0 {
      run out.append(",")
    }
    text.clear()
    run writeDeclaration(&mut text, &items[i])
    run writeString(&mut out, String.view(&text))
    i = i + 1
  }
  run out.append("]")
}

/// styles: the declarations node `id` shows in each state, as text, for an editor to show:
/// what its client set with the inspector's overrides over them. For the states the inspector
/// overrides, `overrides` has the override's declarations (and `replacing` the states whose
/// override leaves the client's out) and `client` the client's own underneath.
pub effect fn styles(tree: &UiTree<'_>, request: &Value, id: u32, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run begin(&mut out, request)
  run putInt(&mut out, "node", u32.toU64(id))
  let mut k: usize = 0
  while k < STATES.length {
    run putKey(&mut out, stateName(STATES[k]))
    run declarationTexts(&run shown(tree, id, STATES[k]), &mut out)
    k = k + 1
  }
  let node = tree.node(tree.slotOf(id))
  let mut first = true
  let mut replacing = List<string>.make()
  k = 0
  while k < STATES.length {
    if let Option<&StyleOverride>.Some { value } = tree.overrideOf(id, STATES[k]) {
      run out.append(
        if first {
          ",\"overrides\":{"
        } else {
          ","
        },
      )
      first = false
      run writeString(&mut out, stateName(STATES[k]))
      run out.append(":")
      run declarationTexts(&value.declarations, &mut out)
      if value.replace {
        run replacing.append(stateName(STATES[k]))
      }
    }
    k = k + 1
  }
  if !first {
    run out.append("},\"client\":{")
    first = true
    k = 0
    while k < STATES.length {
      if tree.overridden(id, STATES[k]) {
        if !first {
          run out.append(",")
        }
        first = false
        run writeString(&mut out, stateName(STATES[k]))
        run out.append(":")
        run declarationTexts(patchOf(node, STATES[k]), &mut out)
      }
      k = k + 1
    }
    run out.append("}")
    if replacing.length() != 0 {
      run putKey(&mut out, "replacing")
      run out.append("[")
      let names = replacing.asSlice()
      let mut n: usize = 0
      while n < names.length {
        if n > 0 {
          run out.append(",")
        }
        run writeString(&mut out, names[n])
        n = n + 1
      }
      run out.append("]")
    }
  }
  run finish(&mut out)
}

// The audit.

fn interactive(value: Role) -> bool {
  return value == Role.Button || value == Role.Link || value == Role.Checkbox || value == Role.Radio
    || value == Role.TextBox
    || value == Role.Tab
    || value == Role.MenuItem
    || value == Role.Slider
    || value == Role.Switch
    || value == Role.Option
}

fn channel(value: f32) -> f32 {
  if value <= 0.04045 {
    return value / 12.92
  }
  return f32.pow((value + 0.055) / 1.055, 2.4)
}

fn luminance(color: Rgba<f32>) -> f32 {
  return 0.2126 * channel(color.r) + 0.7152 * channel(color.g) + 0.0722 * channel(color.b)
}

/// The WCAG contrast ratio of two opaque colors, from 1 to 21.
pub fn contrast(a: Rgba<f32>, b: Rgba<f32>) -> f32 {
  let la = luminance(a)
  let lb = luminance(b)
  if la > lb {
    return (la + 0.05) / (lb + 0.05)
  }
  return (lb + 0.05) / (la + 0.05)
}

/// The opaque color behind node `slot`: the nearest solid background at or above it. None
/// when a gradient, a translucent color or nothing is there, where no ratio can be told.
fn backdrop(tree: &UiTree<'_>, slot: u32) -> Option<Rgba<f32>> {
  let mut at = slot
  while at != NONE {
    let node = tree.node(at)
    match node.computed.paint.background {
      Fill.Solid { color } => {
        if color.a >= 0.999 {
          return Option<Rgba<f32>>.Some { value: color }
        }
        if color.a > 0.0 {
          return Option<Rgba<f32>>.None
        }
      }
      Fill.Gradient { .. } => {
        return Option<Rgba<f32>>.None
      }
      Fill.None => {}
    }
    if node.computed.paint.opacity < 0.999 {
      return Option<Rgba<f32>>.None
    }
    at = node.parent
  }
  return Option<Rgba<f32>>.None
}

struct Report<'a> {
  out: &'a mut String,
  name: String,
  count: usize,
}

impl<'a> Report<'a> {
  effect fn issue(self: &mut Self, tree: &UiTree<'_>, id: u32, rule: string, message: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.count = self.count + 1
    if self.count > ISSUE_LIMIT {
      return ()
    }
    if self.count > 1 {
      run self.out.append(",")
    }
    run self.out.append("{\"rule\":")
    run writeString(&mut self.out, rule)
    run self.out.append(",\"message\":")
    run writeString(&mut self.out, message)
    run self.out.append(",\"node\":")
    run nodeMembers(tree, id, &mut self.name, &mut self.out)
    run self.out.append("}}")
  }
}

/// audit: walks the tree under `top` for what trips people up. Each issue names its rule,
/// says what is wrong in words and carries the node:
///
/// - `unnamed`: a control or image without an accessible name.
/// - `no-role`: a node that listens for clicks and has no role.
/// - `not-focusable`: a node that listens for clicks and the keyboard cannot reach.
/// - `small-target`: something to click smaller than 24 by 24.
/// - `contrast`: text whose contrast against its background is under 4.5 (3 for large text).
pub effect fn audit(tree: &UiTree<'_>, request: &Value, top: u32, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run begin(&mut out, request)
  run putKey(&mut out, "issues")
  run out.append("[")
  let mut report = Report { out: &mut out, name: String.make(), count: 0 }
  let mut stack = List<u32>.make()
  let mut kids = List<u32>.make()
  let mut message = String.make()
  let mut name = String.make()
  let mut checked: usize = 0
  if top != NONE && tree.contains(top) {
    run stack.append(tree.slotOf(top))
  }
  while true {
    let slot = match stack.pop() {
      Option<u32>.Some { value } => value
      Option<u32>.None => {
        break
      }
    }
    let node = tree.node(slot)
    run tree.childSlots(slot, &mut kids)
    let mut k = kids.length()
    while k > 0 {
      k = k - 1
      run stack.append(kids.get(k))
    }
    if !run visible(tree, slot) {
      continue
    }
    checked = checked + 1
    let id = node.id
    let clicks = u32.bitAnd(node.listeners, LISTEN_CLICK) != 0
    let control = interactive(node.accessRole)
    if control || node.accessRole == Role.Image || node.kind == NodeKind.Image {
      run accessibleName(tree, id, &mut name)
      if name.ownedByteLength() == 0 {
        run report.issue(tree, id, "unnamed", "has no accessible name: give it a label or text")
      }
    }
    if clicks && (node.accessRole == Role.None || node.accessRole == Role.Generic) {
      run report.issue(
        tree,
        id,
        "no-role",
        "listens for clicks without a role: assistive technology cannot tell it is a control",
      )
    }
    if clicks && !node.disabled && node.tabIndex == NOT_FOCUSABLE {
      run report.issue(
        tree,
        id,
        "not-focusable",
        "listens for clicks and cannot be focused: the keyboard cannot reach it",
      )
    }
    if (clicks || control) && !node.disabled {
      match run info(tree, id) {
        Option<NodeInfo>.Some { value } => {
          let w = value.bounds.xMax - value.bounds.xMin
          let h = value.bounds.yMax - value.bounds.yMin
          if value.laidOut && (w < TARGET_SIZE || h < TARGET_SIZE) {
            message.clear()
            run message.append("is ")
            run writeNumber(&mut message, w)
            run message.append(" by ")
            run writeNumber(&mut message, h)
            run message.append(": a target should be at least 24 by 24")
            run report.issue(tree, id, "small-target", String.view(&message))
          }
        }
        Option<NodeInfo>.None => {}
      }
    }
    if node.kind == NodeKind.Text && node.text.ownedByteLength() != 0
      && node.computed.text.color.a >= 0.999 {
      match backdrop(tree, slot) {
        Option<Rgba<f32>>.Some { value } => {
          let ratio = contrast(node.computed.text.color, value)
          let needed = if node.computed.text.size >= LARGE_TEXT {
            CONTRAST_LARGE
          } else {
            CONTRAST
          }
          if ratio < needed {
            message.clear()
            run message.append("contrast is ")
            run writeNumber(&mut message, f32.round(ratio * 100.0) / 100.0)
            run message.append(", under ")
            run writeNumber(&mut message, needed)
            run report.issue(tree, id, "contrast", String.view(&message))
          }
        }
        Option<Rgba<f32>>.None => {}
      }
    }
  }
  let count = report.count
  drop report
  run out.append("]")
  run putInt(&mut out, "count", usize.toU64(count))
  run putInt(&mut out, "checked", usize.toU64(checked))
  run finish(&mut out)
}
