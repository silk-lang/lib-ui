//! The inspector protocol without the socket: one JSON request in, one JSON reply out, run
//! against a tree. The server feeds it lines; tests call it directly.
//!
//! Requests are objects with a `cmd` and an optional `id` that the reply echoes. Replies carry
//! `"ok": true` and the command's members, or `"ok": false` and an `error` message. Commands
//! that pick a node take a target: `node` (a client id) or the query members `role`, `name`,
//! `label`, `text`, `testId`, `within`, `exact` and `hidden`, alone or inside a `query` object.
//! See the README for each command.
import ui_inspect.query { Query, queryAll, queryFirst, hitPath, pick }
import ui_inspect.overlay { BoxModel, Highlight, boxModels, compose, paintHighlight }
import ui_inspect.view { InspectOptions, inspectNode }
import ui_inspect.synth { pointOf, click, press }
import ui_tree.engine { UiTree }
import ui_tree.node { NONE, Event, EventKind }
import ui_tree.mutation { Role, StyleState }
import ui_tree.css { Declaration }
import ui_tree.input { Input, MOD_SHIFT, MOD_CONTROL, MOD_ALT, MOD_META, BUTTON_PRIMARY }
import ui_tree.inspect {
  CpuSnapshot,
  DescribeOptions,
  NodeInfo,
  childrenOf,
  describe,
  describeNodeById,
  encodePng,
  info,
  writeInt,
  writeNumber
}
import reply {
  begin,
  finish,
  putKey,
  putText,
  putInt,
  putNumber,
  putFlag,
  putIds,
  failure,
  textField,
  has,
  flagField,
  numberField,
  idField,
  idsField,
  stringsField,
  writeString,
  writeBase64
}
import ui_scene.scene { Scene }
import capture { reduced }
import nodes { nodeObject, nodeMembers }
import timeline { Timeline }
import names { eventName, roleNamed }
import extension { Extension, Extensions, ExtensionHandler, Routed }
import remote { MUTATION_FORMAT }
import topics {
  Changes,
  contains,
  shownRevision,
  TOPIC_TREE,
  TOPIC_FRAME,
  TOPIC_EVENTS,
  TOPIC_ROOTS,
  TOPIC_HIGHLIGHT,
  TOPIC_PICK,
  TOPIC_EDITS,
  TOPIC_COUNT,
  TOPIC_NAMES
}
import tools {
  audit,
  stateNamed,
  stateName,
  styles,
  shown,
  parseStyle,
  layOver,
  dropProperty,
  resetAll,
  resetNode,
  declarationTexts,
  patchOf,
  parts
}
import edits { EditLog, EntryKind, Status, Recorded, writeEntry, writeTarget }
import vector.geometry_error { GeometryError }
import vector.pixmap { Pixmap }
import codec.image { ImageError }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.geometry.rect { Rect }
import silk.geometry.vector { Vector2 }
import silk.json.value { Json, Value }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.text.string { String }

/// The protocol version `hello` reports.
pub const VERSION: u32 = 3

/// The commands `hello` lists. `subscribe` and `unsubscribe` are a session's (see `session.silk`).
const COMMANDS: string = "[\"hello\",\"subscribe\",\"unsubscribe\",\"tree\",\"events\",\"snapshot\",\"query\",\"inspect\",\"pick\",\"highlight\",\"screenshot\",\"click\",\"hover\",\"scroll\",\"press\",\"pointer\",\"key\",\"type\",\"wait\",\"stats\",\"frames\",\"styles\",\"setStyle\",\"resetStyles\",\"pickMode\",\"audit\",\"edits\",\"comment\",\"resolve\",\"viewEvents\"]"

/// How long `wait` waits when the request names no `timeout`, in milliseconds.
pub const DEFAULT_TIMEOUT: u64 = 5000

/// How many event records the event log keeps; older ones are dropped.
pub const LOG_LIMIT: usize = 500

/// One event record the app took from the tree, as the event log keeps it.
pub struct LoggedEvent {
  /// The record's number in the log, from 1.
  pub seq: u64,
  /// The tree's frame number when the app took it.
  pub frame: u64,
  pub kind: EventKind,
  pub target: u32,
  pub path: List<u32>,
  pub x: f32,
  pub y: f32,
  pub bounds: Rect<f32>,
  pub modifiers: u32,
  /// The key of key records, and the value of input records.
  pub key: String,
  pub value: String,
}

/// What handling a request did.
pub enum Outcome {
  /// The reply is written.
  Done,
  /// A `wait` whose condition does not hold yet: nothing is written; hand the same request in
  /// again after the next frame.
  Pending,
  /// A command of an extension: nothing is written yet. The reply comes when the extension is
  /// served (`Extensions.serve`), for the session that asked.
  Deferred,
}

/// The inspector state a connection shares with the app: the highlight, and a CPU copy of the
/// atlas for screenshots.
pub struct Protocol {
  pub highlight: Highlight,
  snapshot: CpuSnapshot,
  overlay: Scene,
  surface: Scene,
  hasSurface: bool,
  inputs: List<Input>,
  /// The first queued input went through `beginNext` and waits for `finishNext`.
  began: bool,
  heldModifiers: u32,
  /// Set when a command dispatched input to the tree: the app must take the tree's event
  /// records and draw a frame before the next command runs.
  pub dispatched: bool,
  /// Set when the highlight changed: the app must draw a frame.
  pub repaint: bool,
  /// The last [`LOG_LIMIT`] event records the app took (see [`Protocol.observe`]).
  pub log: List<LoggedEvent>,
  /// The number the next logged record gets.
  pub nextSeq: u64,
  /// The frames the tree drew.
  pub timeline: Timeline,
  /// The style edits and comments (see `edits.silk`). They outlive every session.
  pub edits: EditLog,
  /// The window's pointer picks a node instead of reaching the app (the `pickMode` command).
  pub picking: bool,
  /// The node the last pick chose, or NONE.
  pub picked: u32,
  /// The release of the press that picked is not the app's either.
  swallowUp: bool,
  /// What sessions were last told (see `topics.silk`).
  pub changes: Changes,
  /// The roots the inspector leaves out, as if they were not open: those of devtools drawn in
  /// the app's own tree (see [`Protocol.hide`]).
  pub hidden: List<u32>,
  /// The extensions frameworks registered (see `extension.silk`).
  pub extensions: Extensions,
}

impl Protocol {
  pub fn make() -> Protocol {
    return Protocol {
      highlight: Highlight.make(),
      snapshot: CpuSnapshot.make(),
      overlay: Scene.make(),
      surface: Scene.make(),
      hasSurface: false,
      inputs: List<Input>.make(),
      began: false,
      heldModifiers: 0,
      dispatched: false,
      repaint: false,
      log: List<LoggedEvent>.make(),
      nextSeq: 1,
      timeline: Timeline.make(),
      edits: EditLog.make(),
      picking: false,
      picked: NONE,
      swallowUp: false,
      changes: Changes.make(),
      hidden: List<u32>.make(),
      extensions: Extensions.make(),
    }
  }

  /// Registers extension `info` (see `extension.silk`): `hello` lists it, its commands are
  /// served as `<id>.<command>` and its topics can be subscribed to.
  pub effect fn extend(self: &mut Self, info: Extension) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.extensions.extend(move info)
  }

  /// Serves extension `id` with `handler`: its waiting requests, topics and views. The replies
  /// and notifications wait in `extensions` for the sessions.
  pub effect fn serveExtension<X: ExtensionHandler>(
    self: &mut Self,
    id: string,
    handler: &mut X,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.extensions.serve(id, &mut handler)
  }

  /// Leaves root `root` out of everything the inspector serves, or shows it again: its nodes
  /// are in no reply, no query, highlight or target finds them, its records are not logged and
  /// its changes and frames are no news. For a second client that draws in the inspected tree,
  /// such as devtools in the app's process, which must not inspect itself. Requests are served
  /// with a root that is not hidden current (the window host keeps the first one current).
  pub effect fn hide(self: &mut Self, root: u32, on: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut i: usize = 0
    while i < self.hidden.length() {
      if self.hidden.get(i) == root {
        drop self.hidden.remove(i)
      } else {
        i = i + 1
      }
    }
    if on {
      run self.hidden.append(root)
    }
  }

  /// Whether node `id` is in a hidden root (see [`Protocol.hide`]).
  pub fn hides(self: &Self, tree: &UiTree<'_>, id: u32) -> bool {
    if self.hidden.length() == 0 {
      return false
    }
    let slot = tree.slotOf(id)
    if slot == NONE {
      return false
    }
    return contains(self.hidden.asSlice(), tree.rootHolding(slot))
  }

  /// Whether a compound interaction still has input for the host to process.
  pub fn hasInput(self: &Self) -> bool {
    return self.inputs.length() != 0
  }

  /// Dispatches one queued input through the same UiTree dispatcher used by the window
  /// adapter. The host must service clipboard/IME requests and pump application messages
  /// before calling again; a down handler can change capture, focus or the view for up.
  pub effect fn dispatchNext(self: &mut Self, tree: &mut UiTree<'_>) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.inputs.length() == 0 {
      return false
    }
    if self.began {
      run self.finishNext(&mut tree, false)
      return true
    }
    let input = self.inputs.remove(0)
    run tree.dispatch(move input)
    return true
  }

  /// The first half of dispatching one queued input, for a host whose application can
  /// prevent default actions: targeting and the event records (`UiTree.begin`). Let the
  /// application answer the records, then call `finishNext` with its verdict. Returns
  /// false when no input waits.
  pub effect fn beginNext(self: &mut Self, tree: &mut UiTree<'_>) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.began || self.inputs.length() == 0 {
      return false
    }
    run tree.begin(&self.inputs.asSlice()[0])
    self.began = true
    return true
  }

  /// The second half: the default action of the input `beginNext` started, unless
  /// `prevented`.
  pub effect fn finishNext(self: &mut Self, tree: &mut UiTree<'_>, prevented: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.began {
      return ()
    }
    self.began = false
    let input = self.inputs.remove(0)
    run tree.finish(move input, prevented)
  }

  /// Copies the complete composed application scene, including custom canvases, for
  /// screenshots. Call after composition and before atlas uploads are cleared.
  pub effect fn afterFrameScene(self: &mut Self, tree: &UiTree<'_>, scene: &Scene) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.surface.clear()
    run self.surface.replay(scene, 0, scene.operationCount())
    run self.surface.finish()
    self.hasSurface = true
    run self.afterFrame(tree)
  }

  effect fn composeOverlay(self: &mut Self, tree: &UiTree<'_>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.hasSurface {
      self.overlay.clear()
      run self.overlay.replay(&self.surface, 0, self.surface.operationCount())
      run paintHighlight(tree, &self.highlight, &mut self.overlay)
      run self.overlay.finish()
    } else {
      run compose(tree, &self.highlight, &mut self.overlay)
    }
  }

  /// Adds the event records waiting in the tree's queue to the event log. Call it right before
  /// the app takes them (`UiTree.takeEvents`, or ui-app's `pump`), so each is logged once.
  pub effect fn observe(self: &mut Self, tree: &UiTree<'_>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let events = tree.events.asSlice()
    let mut i: usize = 0
    while i < events.length {
      if !self.hiddenRecord(tree, &events[i]) {
        run self.logEvent(&events[i], tree.stats.frame)
      }
      i = i + 1
    }
  }

  /// Whether a record's path starts at the node of a hidden root.
  fn hiddenRecord(self: &Self, tree: &UiTree<'_>, event: &Event) -> bool {
    if self.hidden.length() == 0 || event.path.length() == 0 {
      return false
    }
    let first = event.path.get(0)
    let list = self.hidden.asSlice()
    let mut i: usize = 0
    while i < list.length {
      if tree.rootNode(list[i]) == first {
        return true
      }
      i = i + 1
    }
    return false
  }

  /// Adds one record to the event log.
  pub effect fn logEvent(self: &mut Self, event: &Event, frame: u64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut path = List<u32>.make()
    run path.appendSlice(event.path.asSlice())
    let value = if event.kind == EventKind.Input {
      run String.copy(String.view(&event.value))
    } else {
      String.make()
    }
    run self.log.append(
      LoggedEvent {
        seq: self.nextSeq,
        frame: frame,
        kind: event.kind,
        target: event.target,
        path: move path,
        bounds: event.bounds,
        x: event.x,
        y: event.y,
        modifiers: event.modifiers,
        key: run String.copy(String.view(&event.key)),
        value: move value,
      },
    )
    self.nextSeq = self.nextSeq + 1
    if self.log.length() > LOG_LIMIT {
      drop self.log.remove(0)
    }
  }

  /// Takes the atlas tiles the last frame uploaded (without clearing the tree's queue) and
  /// rebuilds the overlay. Call after every `UiTree.frame`, before the uploads are cleared.
  pub effect fn afterFrame(self: &mut Self, tree: &UiTree<'_>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.snapshot.copyUploads(tree)
    self.extensions.frame = tree.stats.frame
    run self.timeline.record(tree.stats)
    if self.edits.hasApplied() {
      // A node destroyed took its overrides along: its edits are no longer applied.
      self.edits.sweep(tree)
    }
    if self.highlight.nodes.length() != 0 {
      run self.composeOverlay(tree)
    }
  }

  /// Whether the app should draw [`Protocol.overlayScene`] instead of `tree.scene()`.
  pub fn highlighting(self: &Self) -> bool {
    return self.highlight.nodes.length() != 0
  }

  /// The tree's last frame with the highlight on top (valid after [`Protocol.afterFrame`]
  /// while [`Protocol.highlighting`]).
  pub fn overlayScene(self: &Self) -> &Scene {
    return &self.overlay
  }

  /// Runs `request` against `tree` and writes the reply line (without the newline) to `out`.
  /// `waited` is how long, in milliseconds, the request has been waiting (for `wait`).
  pub effect fn handle(
    self: &mut Self,
    tree: &mut UiTree<'_>,
    request: &Value,
    waited: u64,
    out: &mut String,
  ) -> Outcome
    ! OutOfMemoryError
    ? &mut Allocator {
    let result = run Effect.result(
      Protocol.execute(&mut self.*, &mut tree, request, waited, &mut out),
    )
    return match move result {
      Result<Outcome, GeometryError | ImageError | OutOfMemoryError>.Success { value } => value
      Result<Outcome, GeometryError | ImageError | OutOfMemoryError>.Failure { error } => {
        drop error
        run failure(&mut out, request, "drawing the screenshot failed")
        Outcome.Done
      }
    }
  }

  effect fn execute(
    self: &mut Self,
    tree: &mut UiTree<'_>,
    request: &Value,
    waited: u64,
    out: &mut String,
  ) -> Outcome
    ! GeometryError | ImageError | OutOfMemoryError
    ? &mut Allocator {
    match &request.* {
      Value.Object { entries: _ } => {}
      _ => {
        run failure(&mut out, request, "a request is a JSON object")
        return Outcome.Done
      }
    }
    let cmd = textField(request, "cmd")
    if cmd == "hello" {
      run self.hello(&tree.*, request, &mut out)
    } else if cmd == "tree" {
      run elementTree(&tree.*, self.hidden.asSlice(), request, &mut out)
    } else if cmd == "events" {
      run self.events(request, &mut out)
    } else if cmd == "snapshot" {
      run snapshot(&tree.*, self.hidden.asSlice(), request, &mut out)
    } else if cmd == "query" {
      run self.query(&tree.*, request, &mut out)
    } else if cmd == "inspect" {
      run inspect(&tree.*, self.hidden.asSlice(), request, &mut out)
    } else if cmd == "pick" {
      run pickAt(&tree.*, request, &mut out)
    } else if cmd == "highlight" {
      run self.setHighlight(&tree.*, request, &mut out)
    } else if cmd == "screenshot" {
      run self.screenshot(&mut tree, request, &mut out)
    } else if cmd == "click" || cmd == "hover" || cmd == "scroll" || cmd == "pointer" {
      run self.pointer(&mut tree, cmd, request, &mut out)
    } else if cmd == "press" || cmd == "key" {
      run self.key(&mut tree, request, &mut out)
    } else if cmd == "type" {
      run self.typeText(&mut tree, request, &mut out)
    } else if cmd == "wait" {
      return run waitFor(&tree.*, self.hidden.asSlice(), request, waited, &mut out)
    } else if cmd == "stats" {
      let hidden = tree.nodeCount() - run self.nodeCount(&tree.*)
      run stats(&tree.*, hidden, request, &mut out)
    } else if cmd == "frames" {
      run self.timeline.describe(request, &mut out)
    } else if cmd == "styles" {
      let id = run targetOf(&tree.*, self.hidden.asSlice(), request, &mut out)
      if id != NONE {
        run styles(&tree.*, request, id, &mut out)
      }
    } else if cmd == "setStyle" {
      run self.setStyle(&mut tree, request, &mut out)
    } else if cmd == "resetStyles" {
      run self.resetStyles(&mut tree, request, &mut out)
    } else if cmd == "edits" {
      run self.listEdits(&tree.*, request, &mut out)
    } else if cmd == "comment" {
      run self.comment(&tree.*, request, &mut out)
    } else if cmd == "resolve" {
      run self.resolve(&mut tree, request, &mut out)
    } else if cmd == "pickMode" {
      run self.pickMode(&tree.*, request, &mut out)
    } else if cmd == "audit" {
      let mut top = tree.rootId()
      if run hasTarget(request) {
        top = run targetOf(&tree.*, self.hidden.asSlice(), request, &mut out)
      }
      if top != NONE || !run hasTarget(request) {
        run audit(&tree.*, request, top, &mut out)
      }
    } else if cmd == "viewEvents" {
      let queued = run self.extensions.queueEvents(
        textField(request, "topic"),
        Json.field(request, "events"),
      )
      run begin(&mut out, request)
      run putInt(&mut out, "queued", usize.toU64(queued))
      run finish(&mut out)
    } else if cmd == "" {
      run failure(&mut out, request, "the request has no cmd")
    } else {
      match run self.extensions.route(cmd, request, &mut out) {
        Routed.NotOurs => {
          run failure(&mut out, request, "unknown cmd")
        }
        Routed.Deferred => {
          return Outcome.Deferred
        }
        Routed.Answered => {}
      }
    }
    return Outcome.Done
  }

  effect fn hello(self: &Self, tree: &UiTree<'_>, request: &Value, out: &mut String) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run begin(&mut out, request)
    run putInt(&mut out, "protocol", u32.toU64(VERSION))
    let mut commands = String.make()
    run commands.append(String.slice(COMMANDS, 0, String.byteLength(COMMANDS) - 1))
    run self.extensions.writeNames(&mut commands, false)
    run commands.append("]")
    run putKey(&mut out, "commands")
    run out.append(String.view(&commands))
    run putKey(&mut out, "capabilities")
    run out.append("{\"commands\":")
    run out.append(String.view(&commands))
    run out.append(",\"topics\":[")
    let mut i: usize = 0
    while i < TOPIC_COUNT {
      if i != 0 {
        run out.append(",")
      }
      run writeString(&mut out, TOPIC_NAMES[i])
      i = i + 1
    }
    run self.extensions.writeNames(&mut out, true)
    run out.append("],\"sessions\":true}")
    run putInt(&mut out, "mutationFormat", u32.toU64(MUTATION_FORMAT))
    run putKey(&mut out, "extensions")
    run self.extensions.describe(&mut out)
    run frameMembers(tree, &mut out)
    run putInt(&mut out, "root", u32.toU64(tree.rootId()))
    run rootMembers(tree, self.hidden.asSlice(), &mut out)
    run putIds(&mut out, "hidden", &self.hidden)
    run putInt(&mut out, "nodes", usize.toU64(run self.nodeCount(tree)))
    run putIds(&mut out, "highlight", &self.highlight.nodes)
    run finish(&mut out)
  }

  /// The topics among `wanted` (`TOPIC_*` bits) that changed since sessions were last told
  /// and were not told in this frame yet, marked told now.
  pub effect fn takeChanges(self: &mut Self, tree: &UiTree<'_>, wanted: u32) -> u32
    ! OutOfMemoryError
    ? &mut Allocator {
    self.extensions.frame = tree.stats.frame
    return run self.changes.take(tree, self.hidden.asSlice(), self.nextSeq, self.edits.seq, wanted)
  }

  /// The tree's node count without the nodes of hidden roots.
  effect fn nodeCount(self: &Self, tree: &UiTree<'_>) -> usize
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut count = tree.nodeCount()
    let list = self.hidden.asSlice()
    let mut stack = List<u32>.make()
    let mut children = List<u32>.make()
    let mut i: usize = 0
    while i < list.length {
      let node = tree.rootNode(list[i])
      if node != NONE {
        run stack.append(tree.slotOf(node))
      }
      i = i + 1
    }
    while stack.length() != 0 {
      let last = stack.length() - 1
      let slot = stack.get(last)
      stack.truncate(last)
      count = count - 1
      run tree.childSlots(slot, &mut children)
      run stack.appendSlice(children.asSlice())
    }
    return count
  }

  /// `queryAll` without the nodes of hidden roots.
  effect fn shownQuery(self: &Self, tree: &UiTree<'_>, q: &Query, out: &mut List<u32>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run queryAll(tree, q, &mut out)
    if self.hidden.length() == 0 {
      return ()
    }
    let mut i: usize = 0
    while i < out.length() {
      if self.hides(tree, out.get(i)) {
        drop out.remove(i)
      } else {
        i = i + 1
      }
    }
  }

  /// Writes the notification line for `topic` (one `TOPIC_*` bit): `{"event": <name>, "frame",
  /// ...}` with what a client needs to decide what to read again. `tree` and `frame` carry the
  /// viewport and the node count; `events` the next `seq`; `roots` the open roots; `highlight`
  /// the highlighted nodes; `pick` whether the picker is on and what it picked.
  pub effect fn notification(self: &Self, tree: &UiTree<'_>, topic: u32, out: &mut String) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    out.clear()
    run out.append("{\"event\":")
    let mut i: usize = 0
    while i < TOPIC_COUNT && u32.shiftLeft(1, usize.toU32(i)) != topic {
      i = i + 1
    }
    run writeString(
      &mut out,
      if i < TOPIC_COUNT {
        TOPIC_NAMES[i]
      } else {
        ""
      },
    )
    if topic == TOPIC_TREE || topic == TOPIC_FRAME {
      run frameMembers(tree, &mut out)
      run putInt(&mut out, "nodes", usize.toU64(run self.nodeCount(tree)))
      if topic == TOPIC_TREE {
        run putInt(&mut out, "revision", run shownRevision(tree, self.hidden.asSlice()))
      }
    } else {
      run putInt(&mut out, "frame", tree.stats.frame)
    }
    if topic == TOPIC_EVENTS {
      run putInt(&mut out, "next", self.nextSeq)
    } else if topic == TOPIC_ROOTS {
      run rootMembers(tree, self.hidden.asSlice(), &mut out)
    } else if topic == TOPIC_HIGHLIGHT {
      run putIds(&mut out, "nodes", &self.highlight.nodes)
    } else if topic == TOPIC_EDITS {
      run putInt(&mut out, "seq", self.edits.seq)
      run putInt(&mut out, "open", usize.toU64(self.edits.openCount()))
    } else if topic == TOPIC_PICK {
      run putFlag(&mut out, "on", self.picking)
      if self.picked != NONE {
        run putInt(&mut out, "picked", u32.toU64(self.picked))
      }
    }
    run finish(&mut out)
  }

  /// setStyle: lays the declarations of `style` (CSS text) over the target for `state` (`base`
  /// without one), through the tree's override layer: over what the client set or, with
  /// `replace`, instead of it. The edit outlasts the client restyling the node, until
  /// `resetStyles` takes it back.
  effect fn setStyle(
    self: &mut Self,
    tree: &mut UiTree<'_>,
    request: &Value,
    out: &mut String,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let id = run targetOf(&tree.*, self.hidden.asSlice(), request, &mut out)
    if id == NONE {
      return ()
    }
    let state = match stateNamed(textField(request, "state")) {
      Option<StyleState>.Some { value } => value
      Option<StyleState>.None => {
        run failure(&mut out, request, "unknown state")
        return ()
      }
    }
    let replace = flagField(request, "replace", false)
    let declarations = match run parseStyle(
      textField(request, "style"),
      replace,
      request,
      &mut out,
    ) {
      Option<List<Declaration>>.Some { value } => move value
      Option<List<Declaration>>.None => {
        return ()
      }
    }

    // What the edit log records: each declared property, and with `replace` the client's (and
    // earlier edits') properties it leaves out, each with the client's value now.
    let mut changes = List<Change>.make()
    run changed(&tree.*, id, state, &declarations, replace, &self.edits, &mut changes)
    if !run layOver(&mut tree, id, state, &declarations, replace) {
      run failure(&mut out, request, "the tree refused the style")
      return ()
    }
    let slot = tree.slotOf(id)
    let root = tree.rootHolding(slot)
    let mut target = String.make()
    run writeTarget(&tree.*, root, id, &mut target)
    let list = changes.asSlice()
    let mut i: usize = 0
    while i < list.length {
      let c = &list[i]
      let recorded = run self.edits.record(
        root,
        id,
        state,
        String.view(&c.property),
        String.view(&c.before),
        c.hasBefore,
        String.view(&c.after),
        c.hasAfter,
        &target,
      )
      if (recorded == Recorded.Reverted || recorded == Recorded.Unchanged) && c.hasAfter {
        // Back to the client's value: the client has the property again.
        drop run dropProperty(&mut tree, id, state, String.view(&c.property))
      }
      i = i + 1
    }
    self.repaint = true
    run begin(&mut out, request)
    run putInt(&mut out, "node", u32.toU64(id))
    run putText(&mut out, "state", stateName(state))
    run putKey(&mut out, "style")
    run declarationTexts(&run shown(&tree.*, id, state), &mut out)
    run putInt(&mut out, "edited", usize.toU64(tree.styleOverrides().length))
    run putKey(&mut out, "edits")
    run out.append("[")
    let entries = self.edits.entries.asSlice()
    let mut first = true
    let mut k: usize = 0
    while k < entries.length {
      let e = &entries[k]
      if e.kind == EntryKind.Edit && e.status == Status.Open && e.applied && e.node == id
        && e.state == state {
        if !first {
          run out.append(",")
        }
        first = false
        run writeInt(&mut out, e.id)
      }
      k = k + 1
    }
    run out.append("]")
    run putInt(&mut out, "seq", self.edits.seq)
    run finish(&mut out)
  }

  /// resetStyles: takes style edits back. With a target, the target's alone: in `state` alone
  /// when the request names one, and the declaration of `property` alone when it names one
  /// (`state` is then `base` without one); otherwise every edit. The open edits taken back
  /// leave the edit log (resolved ones and comments stay). Answers `restored`, the (node,
  /// state) pairs or properties that show the client's declarations again, and `removed`, the
  /// edits that left the log.
  effect fn resetStyles(
    self: &mut Self,
    tree: &mut UiTree<'_>,
    request: &Value,
    out: &mut String,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut restored: usize = 0
    let mut removed: usize = 0
    if run hasTarget(request) {
      let id = run targetOf(&tree.*, self.hidden.asSlice(), request, &mut out)
      if id == NONE {
        return ()
      }
      let state = if has(request, "state") {
        match stateNamed(textField(request, "state")) {
          Option<StyleState>.Some { value } => Option<StyleState>.some(value)
          Option<StyleState>.None => {
            run failure(&mut out, request, "unknown state")
            return ()
          }
        }
      } else {
        Option<StyleState>.None
      }
      let property = textField(request, "property")
      if property != "" {
        let one = state.unwrapOr(StyleState.Base)
        if run dropProperty(&mut tree, id, one, property) {
          restored = 1
        }
        removed = self.edits.removeOpen(id, Option<StyleState>.some(one), property)
      } else {
        restored = resetNode(&mut tree, id, state)
        removed = self.edits.removeOpen(id, state, "")
      }
    } else {
      restored = run resetAll(&mut tree)
      removed = self.edits.removeOpen(NONE, Option<StyleState>.None, "")
    }
    self.repaint = true
    run begin(&mut out, request)
    run putInt(&mut out, "restored", usize.toU64(restored))
    run putInt(&mut out, "removed", usize.toU64(removed))
    run putInt(&mut out, "seq", self.edits.seq)
    run finish(&mut out)
  }

  /// edits: the edit log's entries, oldest first: `edits` and `comments`, filtered by `status`
  /// (`open` or `resolved`; both without it), `kind` (`edit` or `comment`) and `since` (the
  /// entries that changed after that `seq`). `seq` is the log's now, `open` how many entries
  /// are open.
  effect fn listEdits(self: &mut Self, tree: &UiTree<'_>, request: &Value, out: &mut String) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.edits.sweep(tree)
    let status = textField(request, "status")
    if status != "" && status != "open" && status != "resolved" && status != "all" {
      run failure(&mut out, request, "status is open, resolved or all")
      return ()
    }
    let kind = textField(request, "kind")
    if kind != "" && kind != "edit" && kind != "comment" {
      run failure(&mut out, request, "kind is edit or comment")
      return ()
    }
    let since = match Json.asU64(Json.field(request, "since")) {
      Option<u64>.Some { value } => value
      Option<u64>.None => 0
    }
    run begin(&mut out, request)
    run putInt(&mut out, "seq", self.edits.seq)
    run putInt(&mut out, "open", usize.toU64(self.edits.openCount()))
    let mut pass: usize = 0
    while pass < 2 {
      let edits = pass == 0
      run putKey(
        &mut out,
        if edits {
          "edits"
        } else {
          "comments"
        },
      )
      run out.append("[")
      let wanted = kind == "" || (kind == "edit") == edits
      let entries = self.edits.entries.asSlice()
      let mut first = true
      let mut i: usize = 0
      while i < entries.length && wanted {
        let e = &entries[i]
        let shown = (e.kind == EntryKind.Edit) == edits && e.seq > since
          && (status == "" || status == "all" || (status == "open") == (e.status == Status.Open))
        if shown {
          if !first {
            run out.append(",")
          }
          first = false
          run writeEntry(e, &mut out)
        }
        i = i + 1
      }
      run out.append("]")
      pass = pass + 1
    }
    run finish(&mut out)
  }

  /// comment: adds a comment with `text` (and `author`) on the target, or on the app as a
  /// whole without one; or, with `reply` (a comment's id), adds `text` to its thread. Answers
  /// `entry`, the comment now.
  effect fn comment(self: &mut Self, tree: &UiTree<'_>, request: &Value, out: &mut String) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let text = textField(request, "text")
    if text == "" {
      run failure(&mut out, request, "a comment needs text")
      return ()
    }
    let author = textField(request, "author")
    let mut at: usize = usize.MAX
    if has(request, "reply") {
      at = match Json.asU64(Json.field(request, "reply")) {
        Option<u64>.Some { value } => self.edits.find(value)
        Option<u64>.None => usize.MAX
      }
      if at == usize.MAX {
        run failure(&mut out, request, "no entry has that id")
        return ()
      }
      if self.edits.entries.asSlice()[at].kind != EntryKind.Comment {
        run failure(&mut out, request, "replies go to comments; that entry is an edit")
        return ()
      }
      run self.edits.reply(at, text, author)
    } else {
      let mut node = NONE
      let mut root = tree.current
      if run hasTarget(request) {
        node = run targetOf(tree, self.hidden.asSlice(), request, &mut out)
        if node == NONE {
          return ()
        }
        root = tree.rootHolding(tree.slotOf(node))
      }
      let mut target = String.make()
      run writeTarget(tree, root, node, &mut target)
      let id = run self.edits.comment(root, node, move target, text, author)
      at = self.edits.find(id)
    }
    run begin(&mut out, request)
    run putInt(&mut out, "seq", self.edits.seq)
    run putKey(&mut out, "entry")
    run writeEntry(&self.edits.entries.asSlice()[at], &mut out)
    run finish(&mut out)
  }

  /// resolve: marks the entries `entry` (an id) or `entries` (ids) resolved, or open again with
  /// `reopen`. Resolving an edit says the code now does what it tried: its declaration leaves
  /// the node's override, so the node shows what the client sets (the new code's value, once
  /// the app runs it). Reopening an edit lays its `after` over its node again, when the node is
  /// there and no newer edit of the property is open. Nothing changes when an id is unknown.
  /// Answers `entries`, each entry now.
  effect fn resolve(self: &mut Self, tree: &mut UiTree<'_>, request: &Value, out: &mut String) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut ids = List<u32>.make()
    run idsField(request, "entries", &mut ids)
    if has(request, "entry") {
      let mut one = List<u32>.make()
      run idsField(request, "entry", &mut one)
      run ids.appendSlice(one.asSlice())
    }
    if ids.length() == 0 {
      run failure(&mut out, request, "name the entry (or entries) to resolve")
      return ()
    }
    let reopen = flagField(request, "reopen", false)
    let list = ids.asSlice()
    let mut i: usize = 0
    while i < list.length {
      let at = self.edits.find(u32.toU64(list[i]))
      if at == usize.MAX {
        run failure(&mut out, request, "no entry has that id")
        return ()
      }
      let e = &self.edits.entries.asSlice()[at]
      if reopen && e.kind == EntryKind.Edit && e.status == Status.Resolved
        && self.edits.openEdit(e.node, e.state, String.view(&e.property)) != usize.MAX {
        run failure(&mut out, request, "a newer edit of that property is open: reset it first")
        return ()
      }
      i = i + 1
    }
    let mut j: usize = 0
    while j < list.length {
      let at = self.edits.find(u32.toU64(list[j]))
      let e = &self.edits.entries.asSlice()[at]
      let wanted = if reopen {
        Status.Open
      } else {
        Status.Resolved
      }
      if e.status != wanted {
        let mut applied = false
        if e.kind == EntryKind.Edit {
          let node = e.node
          let state = e.state
          let property = run String.copy(String.view(&e.property))
          if !reopen && e.applied {
            drop run dropProperty(&mut tree, node, state, String.view(&property))
          }
          if reopen && e.hasAfter && tree.contains(node) {
            let mut css = run String.copy(String.view(&property))
            run css.append(": ")
            run css.append(String.view(&e.after))
            let mut quiet = String.make()
            if let Option<List<Declaration>>.Some { value } = run parseStyle(
              String.view(&css),
              false,
              request,
              &mut quiet,
            ) {
              applied = run layOver(&mut tree, node, state, &value, false)
            }
          }
          self.repaint = true
        }
        self.edits.mark(at, wanted, applied)
      }
      j = j + 1
    }
    run begin(&mut out, request)
    run putInt(&mut out, "seq", self.edits.seq)
    run putKey(&mut out, "entries")
    run out.append("[")
    let mut k: usize = 0
    while k < list.length {
      if k > 0 {
        run out.append(",")
      }
      run writeEntry(&self.edits.entries.asSlice()[self.edits.find(u32.toU64(list[k]))], &mut out)
      k = k + 1
    }
    run out.append("]")
    run finish(&mut out)
  }

  /// pickMode: with `on`, turns picking on or off; either way says whether it is on and the
  /// node the last pick chose. While it is on the window's pointer highlights what it is
  /// over, and a press picks that node instead of reaching the app.
  effect fn pickMode(self: &mut Self, tree: &UiTree<'_>, request: &Value, out: &mut String) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if has(request, "on") {
      let on = flagField(request, "on", false)
      if on && !self.picking {
        self.picked = NONE
      }
      if !on && self.picking {
        run self.point(tree, NONE)
      }
      if on != self.picking {
        self.changes.pick = true
      }
      self.picking = on
    }
    run begin(&mut out, request)
    run putFlag(&mut out, "on", self.picking)
    if self.picked != NONE && tree.contains(self.picked) {
      let mut name = String.make()
      run putKey(&mut out, "picked")
      run nodeObject(tree, self.picked, &mut name, &mut out)
    }
    run finish(&mut out)
  }

  /// Highlights `id` alone, or nothing for NONE.
  effect fn point(self: &mut Self, tree: &UiTree<'_>, id: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let now = self.highlight.nodes.asSlice()
    if (id == NONE && now.length == 0) || (now.length == 1 && now[0] == id) {
      return ()
    }
    self.highlight.nodes.clear()
    if id != NONE {
      run self.highlight.nodes.append(id)
      run self.composeOverlay(tree)
    }
    self.repaint = true
    self.changes.highlight = true
  }

  /// Whether window input goes through [`Protocol.pickInput`] first.
  pub fn intercepts(self: &Self) -> bool {
    return self.picking || self.swallowUp
  }

  /// Takes window input while picking. True when the input was the picker's and must not
  /// reach the app: a move highlights the node under the pointer, a press picks it and ends
  /// picking, Escape ends picking without a pick.
  pub effect fn pickInput(self: &mut Self, tree: &UiTree<'_>, input: &Input) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.picking {
      match &input.* {
        Input.PointerUp { .. } => {
          let was = self.swallowUp
          self.swallowUp = false
          return was
        }
        _ => {
          return false
        }
      }
    }
    match &input.* {
      Input.PointerMove { x, y, .. } => {
        run self.point(tree, pick(tree, x, y))
        return true
      }
      Input.PointerDown { x, y, .. } => {
        let chosen = pick(tree, x, y)
        self.picked = chosen
        run self.point(tree, chosen)
        self.picking = false
        self.swallowUp = true
        self.changes.pick = true
        return true
      }
      Input.PointerLeave => {
        run self.point(tree, NONE)
        return true
      }
      Input.KeyDown { key, .. } => {
        if String.view(&key) == "Escape" {
          run self.point(tree, NONE)
          self.picking = false
          self.changes.pick = true
          return true
        }
        return false
      }
      _ => {
        return false
      }
    }
  }

  effect fn query(self: &Self, tree: &UiTree<'_>, request: &Value, out: &mut String) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let q = match run queryOf(request) {
      Option<Query>.Some { value } => move value
      Option<Query>.None => {
        run failure(&mut out, request, "unknown role")
        return ()
      }
    }
    let mut found = List<u32>.make()
    run self.shownQuery(tree, &q, &mut found)
    let limit = match Json.asU64(Json.field(request, "limit")) {
      Option<u64>.Some { value } => u64.toUsize(value)
      Option<u64>.None => found.length()
    }
    run begin(&mut out, request)
    run putInt(&mut out, "count", usize.toU64(found.length()))
    run putKey(&mut out, "nodes")
    run out.append("[")
    let ids = found.asSlice()
    let mut name = String.make()
    let mut i: usize = 0
    while i < ids.length && i < limit {
      if i > 0 {
        run out.append(",")
      }
      run nodeObject(tree, ids[i], &mut name, &mut out)
      i = i + 1
    }
    run out.append("]")
    run finish(&mut out)
  }

  /// events: the logged records after `since` (a `seq`, 0 for all), oldest first, at most
  /// `limit` of the newest.
  effect fn events(self: &Self, request: &Value, out: &mut String) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let since = match Json.asU64(Json.field(request, "since")) {
      Option<u64>.Some { value } => value
      Option<u64>.None => 0
    }
    let log = self.log.asSlice()
    let mut first: usize = 0
    while first < log.length && log[first].seq <= since {
      first = first + 1
    }
    match Json.asU64(Json.field(request, "limit")) {
      Option<u64>.Some { value } => {
        let limit = u64.toUsize(value)
        if log.length - first > limit {
          first = log.length - limit
        }
      }
      Option<u64>.None => {}
    }
    run begin(&mut out, request)
    run putInt(&mut out, "next", self.nextSeq)
    run putKey(&mut out, "events")
    run out.append("[")
    let mut i = first
    while i < log.length {
      if i > first {
        run out.append(",")
      }
      let e = &log[i]
      run out.append("{\"seq\":")
      run writeIntTo(&mut out, e.seq)
      run out.append(",\"frame\":")
      run writeIntTo(&mut out, e.frame)
      run out.append(",\"kind\":")
      run writeString(&mut out, eventName(e.kind))
      run out.append(",\"target\":")
      run writeIntTo(&mut out, u32.toU64(e.target))
      run out.append(",\"path\":[")
      let path = e.path.asSlice()
      let mut j: usize = 0
      while j < path.length {
        if j > 0 {
          run out.append(",")
        }
        run writeIntTo(&mut out, u32.toU64(path[j]))
        j = j + 1
      }
      run out.append("]")
      if e.kind == EventKind.PointerDown || e.kind == EventKind.PointerUp
        || e.kind == EventKind.Click
        || e.kind == EventKind.PointerMove
        || e.kind == EventKind.Wheel
        || e.kind == EventKind.Scroll {
        run out.append(",\"x\":")
        run writeNumber(&mut out, e.x)
        run out.append(",\"y\":")
        run writeNumber(&mut out, e.y)
      }
      if e.kind == EventKind.Layout {
        run out.append(",\"bounds\":{\"x\":")
        run writeNumber(&mut out, e.bounds.xMin)
        run out.append(",\"y\":")
        run writeNumber(&mut out, e.bounds.yMin)
        run out.append(",\"width\":")
        run writeNumber(&mut out, e.bounds.width())
        run out.append(",\"height\":")
        run writeNumber(&mut out, e.bounds.height())
        run out.append("}")
      }
      if e.modifiers != 0 {
        run out.append(",\"modifiers\":")
        run writeIntTo(&mut out, u32.toU64(e.modifiers))
      }
      if e.key.ownedByteLength() != 0 {
        run out.append(",\"key\":")
        run writeString(&mut out, String.view(&e.key))
      }
      if e.kind == EventKind.Input {
        run out.append(",\"value\":")
        run writeString(&mut out, String.view(&e.value))
      }
      run out.append("}")
      i = i + 1
    }
    run out.append("]")
    run finish(&mut out)
  }

  effect fn setHighlight(
    self: &mut Self,
    tree: &UiTree<'_>,
    request: &Value,
    out: &mut String,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut ids = List<u32>.make()
    if has(request, "nodes") {
      run idsField(request, "nodes", &mut ids)
    } else if run hasTarget(request) {
      match run queryOf(request) {
        Option<Query>.Some { value } => {
          run self.shownQuery(tree, &value, &mut ids)
        }
        Option<Query>.None => {
          run failure(&mut out, request, "unknown role")
          return ()
        }
      }
    }
    self.highlight.nodes.clear()
    let list = ids.asSlice()
    let mut i: usize = 0
    while i < list.length {
      if tree.contains(list[i]) && !self.hides(tree, list[i]) {
        run self.highlight.nodes.append(list[i])
      }
      i = i + 1
    }
    self.repaint = true
    self.changes.highlight = true
    if self.highlight.nodes.length() != 0 {
      run self.composeOverlay(tree)
    }
    run begin(&mut out, request)
    run putIds(&mut out, "nodes", &self.highlight.nodes)
    run finish(&mut out)
  }

  effect fn screenshot(
    self: &mut Self,
    tree: &mut UiTree<'_>,
    request: &Value,
    out: &mut String,
  ) -> ()
    ! GeometryError | ImageError | OutOfMemoryError
    ? &mut Allocator {
    let maxWidth = idField(request, "maxWidth").unwrapOr(0)
    if has(request, "maxWidth") && (maxWidth < 1 || maxWidth > 4096) {
      run failure(&mut out, request, "maxWidth must be in 1..4096")
      return ()
    }
    let mut pixels = run Pixmap.make(1, 1)
    let mut target = NONE
    if run hasTarget(request) {
      target = run targetOf(&tree.*, self.hidden.asSlice(), request, &mut out)
      if target == NONE {
        return ()
      }
      if self.hasSurface {
        pixels = run self.snapshot.renderScene(&tree.*, &self.surface)
        if let Option<NodeInfo>.Some { value } = run info(&tree.*, target) {
          pixels = run cropPixels(&pixels, value.bounds, tree.input.scale)
        }
      } else {
        pixels = run self.snapshot.renderNode(&mut tree, target)
      }
    } else if self.highlighting() && flagField(request, "highlight", true) {
      run self.composeOverlay(&tree.*)
      pixels = run self.snapshot.renderScene(&tree.*, &self.overlay)
    } else if self.hasSurface {
      pixels = run self.snapshot.renderScene(&tree.*, &self.surface)
    } else {
      pixels = run self.snapshot.render(&tree.*)
    }
    let sourceWidth = pixels.width()
    if maxWidth > 0 && pixels.width() > maxWidth {
      pixels = run reduced(&pixels, maxWidth)
    }
    let png = run encodePng(&pixels)
    run begin(&mut out, request)
    if target != NONE {
      run putInt(&mut out, "node", u32.toU64(target))
    }
    run putInt(&mut out, "width", u32.toU64(pixels.width()))
    run putInt(&mut out, "height", u32.toU64(pixels.height()))
    run putNumber(
      &mut out,
      "scale",
      tree.input.scale * u32.toF32(pixels.width()) / u32.toF32(sourceWidth),
    )
    run putInt(&mut out, "frame", tree.stats.frame)
    run putKey(&mut out, "png")
    run out.append("\"")
    run writeBase64(&mut out, png.asSlice())
    run out.append("\"")
    run finish(&mut out)
  }

  /// click, hover and scroll: aimed at a target node, or at the point `x`, `y`.
  effect fn pointer(
    self: &mut Self,
    tree: &mut UiTree<'_>,
    cmd: string,
    request: &Value,
    out: &mut String,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut point = Vector2<f32> { x: 0.0, y: 0.0 }
    let mut target = NONE
    if run hasTarget(request) {
      target = run targetOf(&tree.*, self.hidden.asSlice(), request, &mut out)
      if target == NONE {
        return ()
      }
      match run pointOf(&tree.*, target) {
        Option<Vector2<f32>>.Some { value } => {
          point = value
        }
        Option<Vector2<f32>>.None => {
          run failure(
            &mut out,
            request,
            "the node cannot be reached by the pointer (hidden, scrolled out of view or covered)",
          )
          return ()
        }
      }
    } else if has(request, "x") && has(request, "y") {
      point = Vector2<f32> { x: numberField(request, "x", 0.0), y: numberField(request, "y", 0.0) }
    } else {
      run failure(&mut out, request, "name a target node or give x and y")
      return ()
    }
    let modifiers = if has(request, "modifiers") {
      run modifiersOf(request)
    } else {
      self.heldModifiers
    }
    let mut inputs = List<Input>.make()
    if cmd != "pointer" {
      run inputs.append(Input.PointerMove { x: point.x, y: point.y, modifiers: modifiers })
    }
    if cmd == "pointer" {
      let phase = textField(request, "phase")
      let button = idField(request, "button").unwrapOr(BUTTON_PRIMARY)
      if button > 5 {
        run failure(&mut out, request, "button must be in 0..5")
        return ()
      }
      if phase == "move" {
        run inputs.append(Input.PointerMove { x: point.x, y: point.y, modifiers: modifiers })
      } else if phase == "down" {
        run inputs.append(
          Input.PointerDown {
            x: point.x,
            y: point.y,
            modifiers: modifiers,
            button: button,
            clickCount: idField(request, "count").unwrapOr(1),
          },
        )
      } else if phase == "up" {
        run inputs.append(
          Input.PointerUp { x: point.x, y: point.y, modifiers: modifiers, button: button },
        )
      } else {
        run failure(&mut out, request, "pointer phase must be down, move or up")
        return ()
      }
    }
    if cmd == "click" {
      let count = match Json.asU64(Json.field(request, "count")) {
        Option<u64>.Some { value } => u64.toU32(value)
        Option<u64>.None => 1
      }
      if count == 0 || count > 1024 {
        run failure(&mut out, request, "count must be in 1..1024")
        return ()
      }
      let mut n: u32 = 1
      while n <= count {
        run inputs.append(
          Input.PointerDown {
            x: point.x,
            y: point.y,
            button: BUTTON_PRIMARY,
            modifiers: modifiers,
            clickCount: n,
          },
        )
        run inputs.append(
          Input.PointerUp { x: point.x, y: point.y, button: BUTTON_PRIMARY, modifiers: modifiers },
        )
        n = n + 1
      }
    } else if cmd == "scroll" {
      run inputs.append(
        Input.Wheel {
          x: point.x,
          y: point.y,
          deltaX: numberField(request, "dx", 0.0),
          deltaY: numberField(request, "dy", 0.0),
          modifiers: modifiers,
        },
      )
    }
    self.inputs = move inputs
    self.dispatched = true
    run begin(&mut out, request)
    if target != NONE {
      run putInt(&mut out, "node", u32.toU64(target))
    }
    run putNumber(&mut out, "x", point.x)
    run putNumber(&mut out, "y", point.y)
    run finish(&mut out)
  }

  /// press: one key, by UI Events `key` (and `code`, which defaults to the key).
  effect fn key(self: &mut Self, tree: &mut UiTree<'_>, request: &Value, out: &mut String) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let name = textField(request, "key")
    if name == "" {
      run failure(&mut out, request, "press needs a key")
      return ()
    }
    let code = if has(request, "code") {
      textField(request, "code")
    } else {
      name
    }
    let mut modifiers = if has(request, "modifiers") {
      run modifiersOf(request)
    } else {
      self.heldModifiers
    }
    let mut inputs = List<Input>.make()
    let times = match Json.asU64(Json.field(request, "times")) {
      Option<u64>.Some { value } => value
      Option<u64>.None => 1
    }
    if times == 0 || times > 1024 {
      run failure(&mut out, request, "times must be in 1..1024")
      return ()
    }
    if textField(request, "cmd") == "key" {
      let phase = textField(request, "phase")
      let bit: u32 = if name == "Shift" {
        MOD_SHIFT
      } else if name == "Control" {
        MOD_CONTROL
      } else if name == "Alt" {
        MOD_ALT
      } else if name == "Meta" {
        MOD_META
      } else {
        0
      }
      if phase == "down" {
        modifiers = modifiers | bit
        self.heldModifiers = self.heldModifiers | bit
        run inputs.append(
          Input.KeyDown {
            key: run String.copy(name),
            code: run String.copy(code),
            modifiers: modifiers,
            repeat: flagField(request, "repeat", false),
          },
        )
      } else if phase == "up" {
        modifiers = modifiers & u32.bitXor(15, bit)
        self.heldModifiers = self.heldModifiers & u32.bitXor(15, bit)
        run inputs.append(
          Input.KeyUp {
            key: run String.copy(name),
            code: run String.copy(code),
            modifiers: modifiers,
          },
        )
      } else {
        run failure(&mut out, request, "key phase must be down or up")
        return ()
      }
    }
    let mut n: u64 = if textField(request, "cmd") == "key" {
      times
    } else {
      0
    }
    while n < times {
      run press(name, code, modifiers, &mut inputs)
      n = n + 1
    }
    self.inputs = move inputs
    self.dispatched = true
    run begin(&mut out, request)
    run putText(&mut out, "key", name)
    run finish(&mut out)
  }

  /// type: `text` as text input records for the focused input (Enter and Tab for newlines
  /// and tabs). With a target, the node is clicked first so it takes focus.
  effect fn typeText(
    self: &mut Self,
    tree: &mut UiTree<'_>,
    request: &Value,
    out: &mut String,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut inputs = List<Input>.make()
    if run hasTarget(request) {
      let target = run targetOf(&tree.*, self.hidden.asSlice(), request, &mut out)
      if target == NONE {
        return ()
      }
      if !run click(&tree.*, target, &mut inputs) {
        run failure(&mut out, request, "the node cannot be reached by the pointer")
        return ()
      }
    }
    let text = textField(request, "text")
    let bytes = String.utf8Bytes(text)
    let mut start: usize = 0
    let mut i: usize = 0
    let mut count: u64 = 0
    while i <= bytes.length {
      let special = i < bytes.length && (bytes[i] == 10 || bytes[i] == 9)
      if i == bytes.length || special {
        if i > start {
          run inputs.append(
            Input.TextInput { text: run String.copy(String.slice(text, start, i - start)) },
          )
        }
        if special {
          if bytes[i] == 10 {
            run press("Enter", "Enter", 0, &mut inputs)
          } else {
            run press("Tab", "Tab", 0, &mut inputs)
          }
        }
        start = i + 1
      }
      if i < bytes.length && (bytes[i] < 128 || bytes[i] >= 192) {
        count = count + 1
      }
      i = i + 1
    }
    self.inputs = move inputs
    self.dispatched = true
    run begin(&mut out, request)
    run putInt(&mut out, "typed", count)
    run finish(&mut out)
  }
}

// Commands that only read the tree.

effect fn frameMembers(tree: &UiTree<'_>, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run putNumber(&mut out, "width", tree.input.width)
  run putNumber(&mut out, "height", tree.input.height)
  run putNumber(&mut out, "scale", tree.input.scale)
  run putInt(&mut out, "frame", tree.stats.frame)
}

effect fn snapshot(tree: &UiTree<'_>, hidden: &[u32], request: &Value, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let options = if flagField(request, "styles", false) {
    DescribeOptions.withStyles()
  } else {
    DescribeOptions.plain()
  }
  let mut text = String.make()
  if run hasTarget(request) {
    let target = run targetOf(tree, hidden, request, &mut out)
    if target == NONE {
      return ()
    }
    run describeNodeById(tree, target, options, &mut text)
  } else {
    run describe(tree, options, &mut text)
  }
  run begin(&mut out, request)
  run putInt(&mut out, "frame", tree.stats.frame)
  run putText(&mut out, "text", String.view(&text))
  run finish(&mut out)
}

effect fn inspect(tree: &UiTree<'_>, hidden: &[u32], request: &Value, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if !run hasTarget(request) {
    run failure(&mut out, request, "inspect needs a target node")
    return ()
  }
  let target = run targetOf(tree, hidden, request, &mut out)
  if target == NONE {
    return ()
  }
  let options = InspectOptions {
    patches: flagField(request, "patches", true),
    computed: flagField(request, "computed", true),
  }
  let mut text = String.make()
  run inspectNode(tree, target, move options, &mut text)
  let mut name = String.make()
  run begin(&mut out, request)
  run putKey(&mut out, "node")
  run nodeObject(tree, target, &mut name, &mut out)
  let mut boxes = List<BoxModel>.make()
  run boxModels(tree, target, &mut boxes)
  if boxes.length() != 0 {
    let b = boxes.get(0)
    run putKey(&mut out, "box")
    run out.append("{\"margin\":")
    run rectObject(b.margin, &mut out)
    run out.append(",\"border\":")
    run rectObject(b.border, &mut out)
    run out.append(",\"padding\":")
    run rectObject(b.padding, &mut out)
    run out.append(",\"content\":")
    run rectObject(b.content, &mut out)
    run out.append(",\"fragments\":")
    run writeIntTo(&mut out, usize.toU64(boxes.length()))
    run out.append("}")
  }
  run putText(&mut out, "text", String.view(&text))
  run finish(&mut out)
}

/// `{"x":…,"y":…,"width":…,"height":…}`.
effect fn rectObject(r: Rect<f32>, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run out.append("{\"x\":")
  run writeNumber(&mut out, r.xMin)
  run out.append(",\"y\":")
  run writeNumber(&mut out, r.yMin)
  run out.append(",\"width\":")
  run writeNumber(&mut out, r.xMax - r.xMin)
  run out.append(",\"height\":")
  run writeNumber(&mut out, r.yMax - r.yMin)
  run out.append("}")
}

/// tree: every node (or the target's subtree) in tree order, each a node object with its
/// `parent`, `depth` and `children` count, so a client can draw the element tree.
/// `"roots"`: the open roots but the `hidden` ones, the current one first, each with its root
/// node when it has one.
effect fn rootMembers(tree: &UiTree<'_>, hidden: &[u32], out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut all = List<u32>.make()
  run tree.openRoots(&mut all)
  let mut roots = List<u32>.make()
  let mut k: usize = 0
  while k < all.length() {
    if !contains(hidden, all.get(k)) {
      run roots.append(all.get(k))
    }
    k = k + 1
  }
  run putKey(&mut out, "roots")
  run out.append("[")
  let mut i: usize = 0
  while i < roots.length() {
    if i != 0 {
      run out.append(",")
    }
    run out.append("{\"root\":")
    run writeIntTo(&mut out, u32.toU64(roots.get(i)))
    let node = tree.rootNode(roots.get(i))
    if node != NONE {
      run out.append(",\"node\":")
      run writeIntTo(&mut out, u32.toU64(node))
    }
    run out.append("}")
    i = i + 1
  }
  run out.append("]")
}

effect fn elementTree(tree: &UiTree<'_>, hidden: &[u32], request: &Value, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut top = tree.rootId()
  if run hasTarget(request) {
    top = run targetOf(tree, hidden, request, &mut out)
    if top == NONE {
      return ()
    }
  }
  run begin(&mut out, request)
  run frameMembers(tree, &mut out)
  run rootMembers(tree, hidden, &mut out)
  run putKey(&mut out, "nodes")
  run out.append("[")
  if top != NONE && tree.contains(top) {
    // Depth first, in tree order: a stack of (id, depth) pairs, children pushed in reverse.
    let mut stack = List<u64>.make()
    run stack.append(u32.toU64(top))
    let mut children = List<u32>.make()
    let mut name = String.make()
    let mut first = true
    while true {
      let entry = match stack.pop() {
        Option<u64>.Some { value } => value
        Option<u64>.None => {
          break
        }
      }
      let id = u64.toU32(u64.bitAnd(entry, 0xFFFFFFFF))
      let depth = u64.shiftRight(entry, 32)
      run childrenOf(tree, id, &mut children)
      if !first {
        run out.append(",")
      }
      first = false
      run nodeMembers(tree, id, &mut name, &mut out)
      let parent = tree.node(tree.slotOf(id)).parent
      if parent != NONE && id != top {
        run out.append(",\"parent\":")
        run writeIntTo(&mut out, u32.toU64(tree.node(parent).id))
      }
      run out.append(",\"depth\":")
      run writeIntTo(&mut out, depth)
      run out.append(",\"children\":")
      run writeIntTo(&mut out, usize.toU64(children.length()))
      run out.append("}")
      let list = children.asSlice()
      let mut i = list.length
      while i > 0 {
        i = i - 1
        run stack.append(u64.bitOr(u32.toU64(list[i]), u64.shiftLeft(depth + 1, 32)))
      }
    }
  }
  run out.append("]")
  run finish(&mut out)
}

effect fn pickAt(tree: &UiTree<'_>, request: &Value, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if !has(request, "x") || !has(request, "y") {
    run failure(&mut out, request, "pick needs x and y")
    return ()
  }
  let x = numberField(request, "x", 0.0)
  let y = numberField(request, "y", 0.0)
  let picked = pick(tree, x, y)
  let mut path = List<u32>.make()
  run hitPath(tree, x, y, &mut path)
  let mut name = String.make()
  run begin(&mut out, request)
  run putKey(&mut out, "node")
  if picked == NONE {
    run out.append("null")
  } else {
    run nodeObject(tree, picked, &mut name, &mut out)
  }
  run putIds(&mut out, "path", &path)
  run finish(&mut out)
}

effect fn waitFor(
  tree: &UiTree<'_>,
  hidden: &[u32],
  request: &Value,
  waited: u64,
  out: &mut String,
) -> Outcome
  ! OutOfMemoryError
  ? &mut Allocator {
  if !run hasTarget(request) {
    run failure(&mut out, request, "wait needs a target")
    return Outcome.Done
  }
  let q = match run queryOf(request) {
    Option<Query>.Some { value } => move value
    Option<Query>.None => {
      run failure(&mut out, request, "unknown role")
      return Outcome.Done
    }
  }
  let found = run firstShown(tree, hidden, &q)
  let gone = flagField(request, "gone", false)
  if (found == NONE) == gone {
    let mut name = String.make()
    run begin(&mut out, request)
    run putKey(&mut out, "node")
    if found == NONE {
      run out.append("null")
    } else {
      run nodeObject(tree, found, &mut name, &mut out)
    }
    run putInt(&mut out, "waited", waited)
    run putInt(&mut out, "frame", tree.stats.frame)
    run finish(&mut out)
    return Outcome.Done
  }
  let timeout = match Json.asU64(Json.field(request, "timeout")) {
    Option<u64>.Some { value } => value
    Option<u64>.None => DEFAULT_TIMEOUT
  }
  if waited >= timeout {
    run failure(&mut out, request, "timed out")
    return Outcome.Done
  }
  return Outcome.Pending
}

/// stats: the last frame's `FrameStats`, without the `hidden` nodes of hidden roots in `nodes`.
effect fn stats(tree: &UiTree<'_>, hidden: usize, request: &Value, out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let s = tree.stats
  run begin(&mut out, request)
  run frameMembers(tree, &mut out)
  let nodes = if s.nodes > hidden {
    s.nodes - hidden
  } else {
    0
  }
  run putInt(&mut out, "nodes", usize.toU64(nodes))
  run putInt(&mut out, "fragments", usize.toU64(s.fragments))
  run putFlag(&mut out, "layoutSkipped", s.layoutSkipped)
  run putKey(&mut out, "layout")
  run out.append("{\"passes\":")
  run writeIntTo(&mut out, usize.toU64(s.layout.passes))
  run out.append(",\"fullLayouts\":")
  run writeIntTo(&mut out, usize.toU64(s.layout.fullLayouts))
  run out.append(",\"sizeProbes\":")
  run writeIntTo(&mut out, usize.toU64(s.layout.sizeProbes))
  run out.append(",\"cacheHits\":")
  run writeIntTo(&mut out, usize.toU64(s.layout.cacheHits))
  run out.append(",\"reusedLayouts\":")
  run writeIntTo(&mut out, usize.toU64(s.layout.reusedLayouts))
  run out.append("}")
  run putInt(&mut out, "replayedSubtrees", usize.toU64(s.replayedSubtrees))
  run putInt(&mut out, "repaintedSubtrees", usize.toU64(s.repaintedSubtrees))
  run putInt(&mut out, "replayedOperations", usize.toU64(s.replayedOperations))
  run putInt(&mut out, "paintedFragments", usize.toU64(s.paintedFragments))
  run putInt(&mut out, "glyphs", usize.toU64(s.glyphs))
  run putInt(&mut out, "primitives", usize.toU64(s.primitives))
  run finish(&mut out)
}

// Targets.

effect fn writeIntTo(out: &mut String, value: u64) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run writeInt(&mut out, value)
}

/// Whether the request keeps its query members in a `query` object.
fn nested(request: &Value) -> bool {
  return match Json.field(request, "query") {
    Option<&Value>.Some { value } => match &value.* {
      Value.Object { entries: _ } => true
      _ => false
    }
    Option<&Value>.None => false
  }
}

/// The object holding the query members: `query` when the request has one, else the request.
fn targetObject(request: &Value) -> &Value {
  return match Json.field(request, "query") {
    Option<&Value>.Some { value } => match &value.* {
      Value.Object { entries: _ } => value
      _ => request
    }
    Option<&Value>.None => request
  }
}

/// Whether `text` is a query member: `type` and `comment` use a top-level `text` for what
/// they type or say.
fn textQueries(request: &Value) -> bool {
  let cmd = textField(request, "cmd")
  return nested(request) || cmd != "type" && cmd != "comment"
}

/// Whether the request names a target node.
effect fn hasTarget(request: &Value) -> bool {
  let t = targetObject(request)
  return has(t, "node") || has(t, "role") || has(t, "name") || has(t, "label") || has(t, "testId")
    || has(t, "text") && textQueries(request)
}

/// The request's query, or None when its role is unknown.
effect fn queryOf(request: &Value) -> Option<Query>
  ! OutOfMemoryError
  ? &mut Allocator {
  let t = targetObject(request)
  let mut q = Query.any()
  match idField(t, "node") {
    Option<u32>.Some { value } => {
      q = Query.byId(value)
    }
    Option<u32>.None => {}
  }
  if has(t, "role") {
    match roleNamed(textField(t, "role")) {
      Option<Role>.Some { value } => {
        q.roleIs = Option<Role>.Some { value: value }
      }
      Option<Role>.None => {
        return Option<Query>.None
      }
    }
  }
  q.name = run String.copy(textField(t, "name"))
  q.label = run String.copy(textField(t, "label"))
  if textQueries(request) {
    q.text = run String.copy(textField(t, "text"))
  }
  q.testId = run String.copy(textField(t, "testId"))
  q.exact = flagField(t, "exact", has(t, "testId"))
  match idField(t, "within") {
    Option<u32>.Some { value } => {
      q.within = value
    }
    Option<u32>.None => {}
  }
  q.includeHidden = flagField(t, "hidden", q.includeHidden)
  return Option<Query>.Some { value: move q }
}

/// The first node the request's target matches, or NONE with a failure written to `out`. Nodes
/// in `hidden` roots match nothing.
effect fn targetOf(tree: &UiTree<'_>, hidden: &[u32], request: &Value, out: &mut String) -> u32
  ! OutOfMemoryError
  ? &mut Allocator {
  let q = match run queryOf(request) {
    Option<Query>.Some { value } => move value
    Option<Query>.None => {
      run failure(&mut out, request, "unknown role")
      return NONE
    }
  }
  let found = run firstShown(tree, hidden, &q)
  if found == NONE {
    run failure(&mut out, request, "no node matches")
  }
  return found
}

/// The first node `q` matches in tree order that is in none of the `hidden` roots, or NONE.
effect fn firstShown(tree: &UiTree<'_>, hidden: &[u32], q: &Query) -> u32
  ! OutOfMemoryError
  ? &mut Allocator {
  if hidden.length == 0 {
    return run queryFirst(tree, q)
  }
  let mut found = List<u32>.make()
  run queryAll(tree, q, &mut found)
  let list = found.asSlice()
  let mut i: usize = 0
  while i < list.length {
    if !contains(hidden, tree.rootHolding(tree.slotOf(list[i]))) {
      return list[i]
    }
    i = i + 1
  }
  return NONE
}

/// The `modifiers` member: names out of shift, control (or ctrl), alt and meta.
effect fn modifiersOf(request: &Value) -> u32
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut names = List<string>.make()
  run stringsField(request, "modifiers", &mut names)
  let list = names.asSlice()
  let mut bits: u32 = 0
  let mut i: usize = 0
  while i < list.length {
    let n = list[i]
    if n == "shift" {
      bits = bits | MOD_SHIFT
    } else if n == "control" || n == "ctrl" {
      bits = bits | MOD_CONTROL
    } else if n == "alt" {
      bits = bits | MOD_ALT
    } else if n == "meta" {
      bits = bits | MOD_META
    }
    i = i + 1
  }
  return bits
}

/// Crops a composed capture to a node's logical bounds, clamped to the viewport.
effect fn cropPixels(full: &Pixmap, bounds: Rect<f32>, scale: f32) -> Pixmap
  ! OutOfMemoryError
  ? &mut Allocator {
  let x0 = f32.toU32(f32.max(0.0, f32.min(u32.toF32(full.width()), f32.floor(bounds.xMin * scale))))
  let y0 = f32.toU32(
    f32.max(0.0, f32.min(u32.toF32(full.height()), f32.floor(bounds.yMin * scale))),
  )
  let x1 = f32.toU32(
    f32.max(u32.toF32(x0), f32.min(u32.toF32(full.width()), f32.ceil(bounds.xMax * scale))),
  )
  let y1 = f32.toU32(
    f32.max(u32.toF32(y0), f32.min(u32.toF32(full.height()), f32.ceil(bounds.yMax * scale))),
  )
  let mut crop = run Pixmap.make(x1 - x0, y1 - y0)
  let source = full.data()
  let target = crop.dataMut()
  let mut y: u32 = 0
  while y < y1 - y0 {
    let mut x: u32 = 0
    while x < x1 - x0 {
      let from = (u32.toUsize(y0 + y) * u32.toUsize(full.width()) + u32.toUsize(x0 + x)) * 4
      let to = (u32.toUsize(y) * u32.toUsize(x1 - x0) + u32.toUsize(x)) * 4
      let mut c: usize = 0
      while c < 4 {
        target[to + c] = source[from + c]
        c = c + 1
      }
      x = x + 1
    }
    y = y + 1
  }
  return move crop
}

// The edit log.

/// One property a `setStyle` changes, with the client's value now.
struct Change {
  property: String,
  before: String,
  hasBefore: bool,
  after: String,
  hasAfter: bool,
}

/// Whether `list` has a change of `property`.
fn hasChange(list: &List<Change>, property: string) -> bool {
  let items = list.asSlice()
  let mut i: usize = 0
  while i < items.length {
    if String.view(&items[i].property) == property {
      return true
    }
    i = i + 1
  }
  return false
}

/// The client's value of `property` on node `id` in `state`, in `value`; false when it sets
/// none (a shorthand covering the property does not count).
effect fn clientValue(
  tree: &UiTree<'_>,
  id: u32,
  state: StyleState,
  property: string,
  value: &mut String,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let client = patchOf(tree.node(tree.slotOf(id)), state).asSlice()
  let mut name = String.make()
  let mut i: usize = 0
  while i < client.length {
    run parts(&client[i], &mut name, &mut value)
    if String.view(&name) == property {
      return true
    }
    i = i + 1
  }
  value.clear()
  return false
}

/// The changes `declarations` make to node `id` in `state`: each declared property; with
/// `replace` also the client's properties and those of the node's open edits there that it
/// leaves out (shown as none).
effect fn changed(
  tree: &UiTree<'_>,
  id: u32,
  state: StyleState,
  declarations: &List<Declaration>,
  replace: bool,
  log: &EditLog,
  out: &mut List<Change>,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let items = declarations.asSlice()
  let mut name = String.make()
  let mut value = String.make()
  let mut i: usize = 0
  while i < items.length {
    run parts(&items[i], &mut name, &mut value)
    let mut before = String.make()
    let had = run clientValue(tree, id, state, String.view(&name), &mut before)

    // A later declaration of the same property wins, as in the override.
    let mut j: usize = 0
    while j < out.length() {
      if String.view(&out.asSlice()[j].property) == String.view(&name) {
        drop out.remove(j)
      } else {
        j = j + 1
      }
    }
    run out.append(
      Change {
        property: run String.copy(String.view(&name)),
        before: move before,
        hasBefore: had,
        after: run String.copy(String.view(&value)),
        hasAfter: true,
      },
    )
    i = i + 1
  }
  if !replace {
    return ()
  }
  let mut left = List<String>.make()
  let client = patchOf(tree.node(tree.slotOf(id)), state).asSlice()
  let mut k: usize = 0
  while k < client.length {
    run parts(&client[k], &mut name, &mut value)
    run left.append(run String.copy(String.view(&name)))
    k = k + 1
  }
  let entries = log.entries.asSlice()
  let mut e: usize = 0
  while e < entries.length {
    let entry = &entries[e]
    if entry.kind == EntryKind.Edit && entry.status == Status.Open && entry.applied
      && entry.node == id
      && entry.state == state {
      run left.append(run String.copy(String.view(&entry.property)))
    }
    e = e + 1
  }
  let names = left.asSlice()
  let mut n: usize = 0
  while n < names.length {
    let property = String.view(&names[n])
    if !hasChange(&out, property) {
      let mut before = String.make()
      let had = run clientValue(tree, id, state, property, &mut before)
      run out.append(
        Change {
          property: run String.copy(property),
          before: move before,
          hasBefore: had,
          after: String.make(),
          hasAfter: false,
        },
      )
    }
    n = n + 1
  }
}
