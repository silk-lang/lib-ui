//! The names the protocol gives the tree's enums on the wire, both ways: roles as `describe`
//! writes them, event kinds as the DOM names its events, node kinds and cursors as CSS does.
import ui_inspect.view { cursorName }
import ui_tree.inspect { roleName, kindName }
import ui_tree.mutation { Role, NodeKind, Cursor }
import ui_tree.node { EventKind }
import silk.core.option { Option }

const ROLES: [Role; 28] = [
  Role.None,
  Role.Generic,
  Role.Button,
  Role.Link,
  Role.Checkbox,
  Role.Radio,
  Role.TextBox,
  Role.Heading,
  Role.Paragraph,
  Role.List,
  Role.ListItem,
  Role.Image,
  Role.Dialog,
  Role.Menu,
  Role.MenuItem,
  Role.Tab,
  Role.TabList,
  Role.TabPanel,
  Role.Toolbar,
  Role.Navigation,
  Role.Main,
  Role.Form,
  Role.Group,
  Role.Slider,
  Role.Switch,
  Role.ListBox,
  Role.Option,
  Role.Tooltip,
]

const EVENT_KINDS: [EventKind; 17] = [
  EventKind.PointerDown,
  EventKind.PointerUp,
  EventKind.Click,
  EventKind.PointerMove,
  EventKind.PointerEnter,
  EventKind.PointerLeave,
  EventKind.Wheel,
  EventKind.KeyDown,
  EventKind.KeyUp,
  EventKind.Focus,
  EventKind.Blur,
  EventKind.Input,
  EventKind.Layout,
  EventKind.PointerCancel,
  EventKind.GotPointerCapture,
  EventKind.LostPointerCapture,
  EventKind.Scroll,
]

const NODE_KINDS: [NodeKind; 6] = [
  NodeKind.Box,
  NodeKind.Text,
  NodeKind.Image,
  NodeKind.Icon,
  NodeKind.Input,
  NodeKind.Canvas,
]

const CURSORS: [Cursor; 12] = [
  Cursor.Default,
  Cursor.Pointer,
  Cursor.Text,
  Cursor.Move,
  Cursor.Grab,
  Cursor.Grabbing,
  Cursor.NotAllowed,
  Cursor.ResizeHorizontal,
  Cursor.ResizeVertical,
  Cursor.ResizeNorthWestSouthEast,
  Cursor.ResizeNorthEastSouthWest,
  Cursor.Crosshair,
]

/// The name of an event kind, as the `events` command writes it (the DOM event's name).
pub fn eventName(kind: EventKind) -> string<'static> {
  return match kind {
    EventKind.PointerDown => "pointerdown"
    EventKind.PointerUp => "pointerup"
    EventKind.Click => "click"
    EventKind.PointerMove => "pointermove"
    EventKind.PointerEnter => "pointerenter"
    EventKind.PointerLeave => "pointerleave"
    EventKind.Wheel => "wheel"
    EventKind.KeyDown => "keydown"
    EventKind.KeyUp => "keyup"
    EventKind.Focus => "focus"
    EventKind.Blur => "blur"
    EventKind.Input => "input"
    EventKind.Layout => "layout"
    EventKind.PointerCancel => "pointercancel"
    EventKind.GotPointerCapture => "gotpointercapture"
    EventKind.LostPointerCapture => "lostpointercapture"
    EventKind.Scroll => "scroll"
  }
}

/// The event kind [`eventName`] calls `name`.
pub fn eventKindNamed(name: string) -> Option<EventKind> {
  let mut i: usize = 0
  while i < EVENT_KINDS.length {
    if eventName(EVENT_KINDS[i]) == name {
      return Option<EventKind>.Some { value: EVENT_KINDS[i] }
    }
    i = i + 1
  }
  return Option<EventKind>.None
}

/// The role whose ARIA name (as `describe` writes it) is `name`.
pub fn roleNamed(name: string) -> Option<Role> {
  let mut i: usize = 0
  while i < ROLES.length {
    if roleName(ROLES[i]) == name {
      return Option<Role>.Some { value: ROLES[i] }
    }
    i = i + 1
  }
  return Option<Role>.None
}

/// The node kind `describe` calls `name`.
pub fn kindNamed(name: string) -> Option<NodeKind> {
  let mut i: usize = 0
  while i < NODE_KINDS.length {
    if kindName(NODE_KINDS[i]) == name {
      return Option<NodeKind>.Some { value: NODE_KINDS[i] }
    }
    i = i + 1
  }
  return Option<NodeKind>.None
}

/// The cursor CSS calls `name`.
pub fn cursorNamed(name: string) -> Option<Cursor> {
  let mut i: usize = 0
  while i < CURSORS.length {
    if cursorName(CURSORS[i]) == name {
      return Option<Cursor>.Some { value: CURSORS[i] }
    }
    i = i + 1
  }
  return Option<Cursor>.None
}
