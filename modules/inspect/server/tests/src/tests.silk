  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run addressBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Over a socket.

const SOCKET: string = "/tmp/ui-inspect-server-test.sock"

const SESSION_SOCKET: string = "/tmp/ui-inspect-server-session.sock"

effect fn connectTo(path: string) -> Connection
  ! NativeSocketError
  ? &mut MonotonicClock {
  let start = run MonotonicClock.now()
  return run connectUnixOwned(
    String.utf8Bytes(path),
    ConnectOptions.defaults(),
    Option<Instant>.some(MonotonicClock.deadlineAfter(&start, 2000000000)),
  )
}

effect fn write(c: &mut Connection, line: string) -> ()
  ! ByteIoError
  ? &mut MonotonicClock {
  let start = run MonotonicClock.now()
  drop run ByteDuplex.writeSome(
    String.utf8Bytes(line),
    Option<Instant>.some(MonotonicClock.deadlineAfter(&start, 2000000000)),
  )
    |> Effect.provideMut<ByteDuplex>(&mut c.*)
}

effect fn send(line: string) -> Connection
  ! NativeSocketError | ByteIoError
  ? &mut MonotonicClock {
  let mut c = run connectTo(SOCKET)
  run write(&mut c, line)
  return move c
}

/// Reads to the end of the stream: the server closes a one-shot connection after its reply.
effect fn receive(c: &mut Connection) -> Value
  ! ByteIoError | JsonError | OutOfMemoryError
  ? &mut MonotonicClock | &mut Allocator {
  let start = run MonotonicClock.now()
  let mut all = Bytes.make()
  let mut chunk: [u8; 4096] = [0; 4096]
  while true {
    match run ByteDuplex.readSome(
      &mut chunk,
      Option<Instant>.some(MonotonicClock.deadlineAfter(&start, 2000000000)),
    )
      |> Effect.provideMut<ByteDuplex>(&mut c.*) {
      ReadTransfer.Data { count } => {
        run all.append(Slice.view(&chunk, 0, count))
      }
      ReadTransfer.End => {
        break
      }
    }
  }
  let reply = run Json.parse(all.asSlice())
  return move reply
}

/// Lines from a connection that stays open.
struct Lines {
  buffer: Bytes,
}

/// The next line from `c`, parsed.
effect fn nextLine(lines: &mut Lines, c: &mut Connection) -> Value
  ! ByteIoError | JsonError | OutOfMemoryError
  ? &mut MonotonicClock | &mut Allocator {
  let start = run MonotonicClock.now()
  let mut chunk: [u8; 4096] = [0; 4096]
  while true {
    let held = lines.buffer.asSlice()
    let mut i: usize = 0
    while i < held.length {
      if held[i] == 10 {
        let line = run Json.parse(Slice.view(held, 0, i))
        let mut rest = Bytes.make()
        run rest.append(Slice.view(held, i + 1, held.length - i - 1))
        lines.buffer = move rest
        return move line
      }
      i = i + 1
    }
    match run ByteDuplex.readSome(
      &mut chunk,
      Option<Instant>.some(MonotonicClock.deadlineAfter(&start, 2000000000)),
    )
      |> Effect.provideMut<ByteDuplex>(&mut c.*) {
      ReadTransfer.Data { count } => {
        run lines.buffer.append(Slice.view(&chunk, 0, count))
      }
      ReadTransfer.End => {
        break
      }
    }
  }
  let end = run Json.parse(b"{\"end\":true}")
  return move end
}

/// The next reply from `c`, past the notifications before it.
effect fn nextReply(lines: &mut Lines, c: &mut Connection) -> Value
  ! ByteIoError | JsonError | OutOfMemoryError
  ? &mut MonotonicClock | &mut Allocator {
  while true {
    let line = run nextLine(&mut lines, &mut c)
    if !has(&line, "event") {
      return move line
    }
  }
  return run Json.parse(b"{}")
}

/// The next notification for `topic` from `c`, past other lines.
effect fn nextEvent(lines: &mut Lines, c: &mut Connection, topic: string) -> Value
  ! ByteIoError | JsonError | OutOfMemoryError
  ? &mut MonotonicClock | &mut Allocator {
  while true {
    let line = run nextLine(&mut lines, &mut c)
    if text(&line, "event") == topic || has(&line, "end") {
      return move line
    }
  }
  return run Json.parse(b"{}")
}

fn has(value: &Value, key: string) -> bool {
  return match Json.field(value, key) {
    Option<&Value>.Some { value: _ } => true
    Option<&Value>.None => false
  }
}

/// Polls until the inspector served `count` requests in all (lines come in on other threads),
/// for at most two seconds. Returns whether a poll said the app has work.
effect fn pollUntil(inspector: &mut Inspector, tree: &mut UiTree<'_>, count: u64) -> bool
  ! OutOfMemoryError
  ? &mut Allocator | &mut MonotonicClock {
  let mut work = false
  let mut tries: u64 = 0
  while inspector.served < count && tries < 1000 {
    if run inspector.poll(&mut tree) {
      work = true
    }
    if inspector.served < count {
      run MonotonicClock.waitFor(2000000)
    }
    tries = tries + 1
  }
  return work
}

/// Polls for a fifth of a second.
effect fn pollAWhile(inspector: &mut Inspector, tree: &mut UiTree<'_>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator | &mut MonotonicClock {
  let mut work = false
  let mut tries: u64 = 0
  while tries < 100 {
    if run inspector.poll(&mut tree) {
      work = true
    }
    run MonotonicClock.waitFor(2000000)
    tries = tries + 1
  }
  return work
}

effect fn socketBody() -> ()
  ! AssertionError<'static>
    | TreeError
    | JsonError
    | NativeSocketError
    | ByteIoError
    | FileError
    | OutOfMemoryError
  ? &mut Allocator | &mut MonotonicClock {
  let collection = run fixtures.fonts()
  let mut tree = run inbox(&collection)
  let mut inspector = run Inspector.listenAt(Address.Unix { path: run String.copy(SOCKET) }, false)
  run Testing.expect(inspector.enabled(), "listening")
  run Testing.expect(!run inspector.poll(&mut tree), "nothing to serve yet")

  // A protocol 2 client: one request, one reply, then the server closes the connection.
  let mut a = run send("{\"id\":1,\"cmd\":\"hello\"}\n")
  run Testing.expect(!run pollUntil(&mut inspector, &mut tree, 1), "hello changes nothing")
  let hello = run receive(&mut a)
  run Testing.expect(ok(&hello) && int(&hello, "protocol") == 3, "hello over the socket")

  // A click, then a query sent before the app drew a frame: the query waits for the frame.
  let mut b = run send("{\"id\":2,\"cmd\":\"click\",\"node\":10}\n")
  run Testing.expect(run pollUntil(&mut inspector, &mut tree, 2), "a click is work for the app")
  while run inspector.dispatchNext(&mut tree) {}
  let mut c = run send("{\"id\":3,\"cmd\":\"query\",\"role\":\"button\"}\n")
  drop run pollAWhile(&mut inspector, &mut tree)
  run Testing.expect(inspector.served == 2, "the next waits for a frame")
  let click = run receive(&mut b)
  run Testing.expect(ok(&click) && int(&click, "id") == 2, "the click reply")
  run tree.frame(FrameInput { width: 360.0, height: 440.0, scale: 2.0, time: 0.1 })
  run inspector.afterFrame(&tree)
  drop run pollUntil(&mut inspector, &mut tree, 3)
  let query = run receive(&mut c)
  run Testing.expect(int(&query, "id") == 3 && int(&query, "count") == 3, "served after it")

  // A wait that does not hold yet answers pending; bad JSON is an error.
  let mut d = run send("{\"cmd\":\"wait\",\"name\":\"never\"}\n")
  drop run pollUntil(&mut inspector, &mut tree, 4)
  let wait = run receive(&mut d)
  run Testing.expect(pending(&wait), "pending over the socket")
  let mut e = run send("{oops\n")
  drop run pollUntil(&mut inspector, &mut tree, 5)
  let bad = run receive(&mut e)
  run Testing.expect(!ok(&bad), "bad JSON")

  run inspector.close()
  let mut files = run MachineFileSystem.make()
  let path = run Path.make(SOCKET)

  // exists() fails with WrongType on a socket file, so a clean answer means it is gone.
  let left = run Effect.result(
    FileSystem.exists(&path) |> Effect.provideMut<FileSystem>(&mut files),
  )
  let gone = match move left {
    Result<bool, FileError>.Success { value } => !value
    Result<bool, FileError>.Failure { error: _ } => false
  }
  run Testing.expect(gone, "close removes the socket file")
}

test effect fn requestsOverAUnixSocket() -> ()
  ! AssertionError<'static>
    | TreeError
    | JsonError
    | NativeSocketError
    | ByteIoError
    | FileError
    | HostInputError
    | OutOfMemoryError {
  // std has no Unix sockets on Windows; the protocol itself is covered above.
  static if Intrinsic.targetOperatingSystem() != "windows" {
    let mut allocator = Allocator.systemAllocatorProvider()
    let mut clock = OsMonotonicClock.make()
    run socketBody()
      |> Effect.provideMut<Allocator>(&mut allocator)
      |> Effect.provideMut<MonotonicClock>(&mut clock)
  }
}

effect fn sessionSocketBody() -> ()
  ! AssertionError<'static>
    | TreeError
    | JsonError
    | NativeSocketError
    | ByteIoError
    | OutOfMemoryError
  ? &mut Allocator | &mut MonotonicClock {
  let collection = run fixtures.fonts()
  let mut tree = run inbox(&collection)
  let mut inspector = run Inspector.listenAt(
    Address.Unix { path: run String.copy(SESSION_SOCKET) },
    false,
  )
  run Testing.expect(inspector.enabled(), "listening")

  // A protocol 3 client keeps its connection: several requests, replies matched by id.
  let mut c = run connectTo(SESSION_SOCKET)
  let mut lines = Lines { buffer: Bytes.make() }
  run write(&mut c, "{\"id\":1,\"cmd\":\"hello\",\"protocol\":3,\"client\":\"test\"}\n")
  drop run pollUntil(&mut inspector, &mut tree, 1)
  let hello = run nextReply(&mut lines, &mut c)
  run Testing.expect(int(&hello, "id") == 1 && int(&hello, "protocol") == 3, "a session opens")
  run Testing.expect(
    Json.field(Json.field(&hello, "capabilities").unwrapOr(&hello), "topics").isSome(),
    "hello lists the topics",
  )
  run write(
    &mut c,
    "{\"id\":2,\"cmd\":\"query\",\"role\":\"button\"}\n{\"id\":3,\"cmd\":\"stats\"}\n",
  )
  drop run pollUntil(&mut inspector, &mut tree, 3)
  let query = run nextReply(&mut lines, &mut c)
  run Testing.expect(int(&query, "id") == 2 && int(&query, "count") == 3, "the first reply")
  let stats = run nextReply(&mut lines, &mut c)
  run Testing.expect(int(&stats, "id") == 3 && ok(&stats), "then the second, same connection")

  // A notification is not answered; a subscribed topic is pushed.
  run write(&mut c, "{\"id\":4,\"cmd\":\"subscribe\",\"topics\":[\"highlight\"]}\n")
  run write(&mut c, "{\"cmd\":\"highlight\",\"nodes\":[10]}\n{\"id\":5,\"cmd\":\"stats\"}\n")
  drop run pollUntil(&mut inspector, &mut tree, 6)
  let subscribed = run nextReply(&mut lines, &mut c)
  run Testing.expect(int(&subscribed, "id") == 4, "subscribe answers")
  let pushed = run nextLine(&mut lines, &mut c)
  run Testing.expect(text(&pushed, "event") == "highlight", "the highlight is pushed")
  run Testing.expect(inspector.state().highlight.nodes.length() == 1, "it highlighted")
  let next = run nextLine(&mut lines, &mut c)
  run Testing.expect(int(&next, "id") == 5, "the highlight sent no reply")
  let nodes = match Json.field(&pushed, "nodes") {
    Option<&Value>.Some { value } => match &value.* {
      Value.Array { values } => values.length()
      _ => 0
    }
    Option<&Value>.None => 0
  }
  run Testing.expect(nodes == 1, "the highlight is pushed")

  // Highlights that came faster than the app polls are served together: the app draws the
  // last one, and none is left to play back a frame at a time.
  run write(
    &mut c,
    "{\"cmd\":\"highlight\",\"nodes\":[10]}\n{\"cmd\":\"highlight\",\"nodes\":[11]}\n{\"cmd\":\"highlight\",\"nodes\":[10,11]}\n",
  )

  // The reader thread has the three lines well within this.
  run MonotonicClock.waitFor(100000000)
  drop run inspector.poll(&mut tree)
  run Testing.expect(inspector.served == 9, "one poll serves the burst")
  run Testing.expect(inspector.state().highlight.nodes.length() == 2, "the last one stands")

  // A protocol 2 client is still answered while the session is open.
  let mut d = run connectTo(SESSION_SOCKET)
  run write(&mut d, "{\"cmd\":\"stats\"}\n")
  drop run pollUntil(&mut inspector, &mut tree, 10)
  let single = run receive(&mut d)
  run Testing.expect(ok(&single), "a one-shot request beside a session")

  // When the client leaves, its session ends.
  drop run Effect.result(c.close())
  let mut tries: u64 = 0
  while inspector.sessionCount() != 0 && tries < 1000 {
    drop run inspector.poll(&mut tree)
    run MonotonicClock.waitFor(2000000)
    tries = tries + 1
  }
  run Testing.expect(inspector.sessionCount() == 0, "the session ends with the connection")
  run inspector.close()
}

test effect fn sessionsOverAUnixSocket() -> ()
  ! AssertionError<'static>
    | TreeError
    | JsonError
    | NativeSocketError
    | ByteIoError
    | HostInputError
    | OutOfMemoryError {
  static if Intrinsic.targetOperatingSystem() != "windows" {
    let mut allocator = Allocator.systemAllocatorProvider()
    let mut clock = OsMonotonicClock.make()
    run sessionSocketBody()
      |> Effect.provideMut<Allocator>(&mut allocator)
      |> Effect.provideMut<MonotonicClock>(&mut clock)
  }
}

// Sessions over a memory channel: the same code as over a socket, without one.

/// Serves every line waiting at `end`, with the app's part between, as the window loop does.
effect fn serveAll(
  session: &mut Session,
  protocol: &mut Protocol,
  tree: &mut UiTree<'_>,
  end: &mut MemoryChannel,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  while run session.serveNext(&mut protocol, &mut tree) |> Effect.provideMut<Channel>(&mut end) {
    while run protocol.dispatchNext(&mut tree) {}
    run protocol.observe(&tree)
    let mut taken = List<Event>.make()
    run tree.takeEvents(&mut taken)
  }
}

/// Tells the session what changed, as the inspector does after each poll and frame.
effect fn publishTo(
  session: &mut Session,
  protocol: &mut Protocol,
  tree: &UiTree<'_>,
  end: &mut MemoryChannel,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let topics = run protocol.takeChanges(tree, session.topics)
  run session.publish(&protocol.*, tree, topics) |> Effect.provideMut<Channel>(&mut end)
}

/// The next line at the client's end, parsed, or `{"none":true}`.
effect fn take(client: &mut MemoryChannel) -> Value
  ! JsonError | OutOfMemoryError
  ? &mut Allocator {
  let mut line = String.make()
  if !run Channel.receive(&mut line) |> Effect.provideMut<Channel>(&mut client) {
    return run Json.parse(b"{\"none\":true}")
  }
  let value = run Json.parse(line.ownedUtf8Bytes())
  return move value
}

effect fn put(client: &mut MemoryChannel, line: string) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  drop run Channel.send(line) |> Effect.provideMut<Channel>(&mut client)
}

effect fn memoryBody() -> ()
  ! AssertionError<'static> | TreeError | JsonError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run inbox(&collection)
  let mut protocol = Protocol.make()
  let pair = run MemoryChannel.pair()
  let MemoryPair { first, second } = move pair
  let mut app = move first
  let mut client = move second
  let mut session = Session.open()

  // Request and reply by id; `wants` subscribes at hello.
  run put(&mut client, "{\"id\":1,\"cmd\":\"hello\",\"protocol\":3,\"wants\":[\"highlight\"]}")
  run put(&mut client, "{\"id\":\"two\",\"cmd\":\"stats\"}")
  run serveAll(&mut session, &mut protocol, &mut tree, &mut app)
  let hello = run take(&mut client)
  run Testing.expect(int(&hello, "id") == 1 && int(&hello, "protocol") == 3, "hello by id")
  let stats = run take(&mut client)
  run Testing.expect(text(&stats, "id") == "two" && ok(&stats), "a string id is echoed")
  run Testing.expect(session.topics == TOPIC_HIGHLIGHT, "subscribed to what it wanted")

  // A line without an id is a notification: no reply. The change it made is pushed.
  run put(&mut client, "{\"cmd\":\"highlight\",\"nodes\":[10]}")
  run serveAll(&mut session, &mut protocol, &mut tree, &mut app)
  run Testing.expect(protocol.highlight.nodes.length() == 1, "the highlight is set")
  run publishTo(&mut session, &mut protocol, &tree, &mut app)
  let pushed = run take(&mut client)
  run Testing.expect(text(&pushed, "event") == "highlight", "the highlight is pushed")
  let none1 = run take(&mut client)
  run Testing.expect(has(&none1, "none"), "once, and no reply")

  // Coalescing: a second change in the same frame waits for the next frame.
  run put(&mut client, "{\"cmd\":\"highlight\",\"nodes\":[11]}")
  run put(&mut client, "{\"cmd\":\"highlight\",\"nodes\":[12]}")
  run serveAll(&mut session, &mut protocol, &mut tree, &mut app)
  run publishTo(&mut session, &mut protocol, &tree, &mut app)
  let none2 = run take(&mut client)
  run Testing.expect(has(&none2, "none"), "not twice in one frame")
  run Testing.expect(protocol.changes.held == TOPIC_HIGHLIGHT, "held for the next frame")
  run tree.frame(FrameInput { width: 360.0, height: 440.0, scale: 2.0, time: 0.1 })
  run protocol.afterFrame(&tree)
  run publishTo(&mut session, &mut protocol, &tree, &mut app)
  let later = run take(&mut client)
  run Testing.expect(text(&later, "event") == "highlight", "pushed with the next frame")
  run Testing.expect(int(&later, "frame") == int(&pushed, "frame") + 1, "a frame later")
  let none3 = run take(&mut client)
  run Testing.expect(has(&none3, "none"), "once for both changes")

  // subscribe: events. A click logs records, and the log's next seq is pushed.
  run put(&mut client, "{\"id\":2,\"cmd\":\"subscribe\",\"topics\":[\"events\",\"nonsense\"]}")
  run serveAll(&mut session, &mut protocol, &mut tree, &mut app)
  let subscribed = run take(&mut client)
  run Testing.expect(int(&subscribed, "id") == 2, "subscribe answers")
  run Testing.expect(
    session.topics == TOPIC_HIGHLIGHT | TOPIC_EVENTS,
    "an unknown topic is ignored",
  )
  run put(&mut client, "{\"cmd\":\"click\",\"node\":10}")
  run serveAll(&mut session, &mut protocol, &mut tree, &mut app)
  run tree.frame(FrameInput { width: 360.0, height: 440.0, scale: 2.0, time: 0.2 })
  run protocol.afterFrame(&tree)
  run publishTo(&mut session, &mut protocol, &tree, &mut app)
  let events = run take(&mut client)
  run Testing.expect(text(&events, "event") == "events" && int(&events, "next") > 1, "events")

  // unsubscribe: nothing more is pushed.
  run put(&mut client, "{\"id\":3,\"cmd\":\"unsubscribe\"}")
  run put(&mut client, "{\"cmd\":\"highlight\",\"nodes\":[10]}")
  run serveAll(&mut session, &mut protocol, &mut tree, &mut app)
  let unsubscribed = run take(&mut client)
  run Testing.expect(int(&unsubscribed, "id") == 3 && session.topics == 0, "unsubscribed")
  run tree.frame(FrameInput { width: 360.0, height: 440.0, scale: 2.0, time: 0.3 })
  run protocol.afterFrame(&tree)
  run publishTo(&mut session, &mut protocol, &tree, &mut app)
  let none4 = run take(&mut client)
  run Testing.expect(has(&none4, "none"), "nothing is pushed")

  // A session whose first line is not a protocol 3 hello is one request, answered even
  // without an id, then over.
  let mut single = Session.make()
  run put(&mut client, "{\"cmd\":\"stats\"}")
  run serveAll(&mut single, &mut protocol, &mut tree, &mut app)
  let answered = run take(&mut client)
  run Testing.expect(ok(&answered), "a one-shot request is answered")
  run Testing.expect(single.ended, "and the session is over")

  // Closing one end closes the channel for the other, after what was sent.
  run put(&mut client, "{\"id\":4,\"cmd\":\"stats\"}")
  client.close()
  run Testing.expect(app.open(), "a line still waits")
  run serveAll(&mut session, &mut protocol, &mut tree, &mut app)
  run Testing.expect(!app.open(), "then the channel is closed")
}

test effect fn sessionsOverAMemoryChannel() -> ()
  ! AssertionError<'static> | TreeError | JsonError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run memoryBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A hidden root: a client in this process (devtools) draws in the inspected tree.

/// The root the tools draw in, its box and its button.
const TOOLS_ROOT: u32 = 7

const TOOLS_BOX: u32 = 900

const TOOLS_BUTTON: u32 = 901

fn toolsViewport() -> FrameInput {
  return FrameInput { width: 300.0, height: 200.0, scale: 2.0, time: 0.0 }
}

fn appViewport(time: f64) -> FrameInput {
  return FrameInput { width: 360.0, height: 440.0, scale: 2.0, time: time }
}

/// Draws the tools' root, then the app's, which stays current, as the window host does.
effect fn frameBoth(tree: &mut UiTree<'_>, inspector: &mut Inspector, time: f64) -> ()
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  run tree.frameRoot(TOOLS_ROOT, toolsViewport())
  run tree.frameRoot(FIRST_ROOT, appViewport(time))
  run inspector.afterFrame(&tree.*)
}

/// Every line the local client got, as text.
effect fn lines(client: &mut MemoryChannel) -> List<String>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = List<String>.make()
  let mut line = String.make()
  while run Channel.receive(&mut line) |> Effect.provideMut<Channel>(&mut client) {
    run out.append(run String.copy(String.view(&line)))
  }
  return move out
}

/// Sends `line` from the local client, serves it at once and parses the reply.
effect fn local(
  inspector: &mut Inspector,
  tree: &mut UiTree<'_>,
  client: &mut MemoryChannel,
  line: string,
) -> Value
  ! JsonError | OutOfMemoryError
  ? &mut Allocator {
  run put(&mut client, line)
  drop run inspector.serveLocal(&mut tree)
  return run take(&mut client)
}

effect fn hiddenBody() -> ()
  ! AssertionError<'static> | TreeError | JsonError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run inbox(&collection)
  let mut batch = Batch.make()
  run batch.create(TOOLS_BOX, NodeKind.Box)
  run fixtures.button(&mut batch, TOOLS_BOX, TOOLS_BUTTON, "Tools", false)
  run batch.listen(TOOLS_BUTTON, LISTEN_ALL)
  run batch.openRoot(TOOLS_ROOT, TOOLS_BOX, RootOptions.default())
  run tree.apply(run batch.take())
  run tree.setAside(TOOLS_ROOT, true)

  // An inspector that is off serves a client in this process, with no socket.
  let mut inspector = Inspector.off()
  run Testing.expect(!inspector.enabled(), "the inspector starts off")
  let mut client = run inspector.openLocal()
  run Testing.expect(inspector.enabled(), "a local session turns it on")
  run Testing.expect(inspector.pollInterval().isNone(), "and needs no polling")
  run inspector.hide(TOOLS_ROOT, true)
  run frameBoth(&mut tree, &mut inspector, 0.0)

  let hello = run local(&mut inspector, &mut tree, &mut client, "{\"id\":1,\"cmd\":\"hello\"}")
  let roots = run array(&hello, "roots")
  let hidden = run array(&hello, "hidden")
  run Testing.expect(
    roots.length == 1 && hidden.length == 1 && int(&hello, "id") == 1,
    "hello lists the app's root, and the hidden one apart",
  )
  let listed = run local(&mut inspector, &mut tree, &mut client, "{\"id\":2,\"cmd\":\"tree\"}")
  let nodes = run array(&listed, "nodes")
  let mut i: usize = 0
  let mut seen = false
  while i < nodes.length {
    let id = int(&nodes[i], "id")
    if id == u32.toI64(TOOLS_BOX) || id == u32.toI64(TOOLS_BUTTON) {
      seen = true
    }
    i = i + 1
  }
  run Testing.expect(nodes.length > 10 && !seen, "the tree leaves the hidden root's nodes out")
  let found = run local(
    &mut inspector,
    &mut tree,
    &mut client,
    "{\"id\":3,\"cmd\":\"query\",\"name\":\"Tools\",\"within\":900}",
  )
  run Testing.expect(int(&found, "count") == 0, "no query finds them, even within their root")
  let inspected = run local(
    &mut inspector,
    &mut tree,
    &mut client,
    "{\"id\":4,\"cmd\":\"inspect\",\"node\":901}",
  )
  run Testing.expect(!ok(&inspected), "no target names them")
  let lit = run local(
    &mut inspector,
    &mut tree,
    &mut client,
    "{\"id\":5,\"cmd\":\"highlight\",\"nodes\":[901,10]}",
  )
  let highlighted = run array(&lit, "nodes")
  run Testing.expect(highlighted.length == 1, "nor highlights them")

  // Their records are not logged; the app's are.
  drop run tree.useRoot(TOOLS_ROOT)
  run tree.dispatchTo(
    TOOLS_ROOT,
    Input.PointerDown { x: 20.0, y: 10.0, button: 0, modifiers: 0, clickCount: 1 },
  )
  drop run tree.useRoot(FIRST_ROOT)
  run inspector.observe(&tree)
  let logged = inspector.state().log.asSlice()
  let mut toolsLogged = false
  let mut e: usize = 0
  while e < logged.length {
    if logged[e].target == TOOLS_BUTTON || logged[e].target == TOOLS_BOX {
      toolsLogged = true
    }
    e = e + 1
  }
  run Testing.expect(!toolsLogged, "the hidden root's records are not logged")
  let mut tools = List<Event>.make()
  run tree.takeEventsOf(TOOLS_ROOT, &mut tools)
  run Testing.expect(tools.length() != 0, "they wait for the tools")

  // Subscribed to everything, the client hears nothing of the hidden root's changes and frames.
  let subscribed = run local(
    &mut inspector,
    &mut tree,
    &mut client,
    "{\"id\":6,\"cmd\":\"subscribe\"}",
  )
  run Testing.expect(int(&subscribed, "id") == 6, "subscribed")
  run frameBoth(&mut tree, &mut inspector, 0.1)
  drop run inspector.poll(&mut tree)
  drop run lines(&mut client)
  let mut frame: u64 = 0
  while frame < 5 {
    // The tools apply their batches with their root current, so their new nodes are theirs.
    drop run tree.useRoot(TOOLS_ROOT)
    let mut change = Batch.make()
    run change.text(TOOLS_BOX, 950 + u64.toU32(frame), "more")
    run tree.apply(run change.take())
    run tree.frameRoot(TOOLS_ROOT, toolsViewport())
    drop run tree.useRoot(FIRST_ROOT)
    drop run inspector.poll(&mut tree)
    frame = frame + 1
  }
  let quiet = run lines(&mut client)
  run Testing.expect(quiet.length() == 0, "the tools' own changes and frames push nothing")
  run Testing.expect(!tree.needsFrameOf(FIRST_ROOT), "nor ask the app for a frame")

  // A change in the app is news.
  let mut app = Batch.make()
  run app.style(fixtures.NEW_BUTTON, &[css.width(px(90.0))])
  run tree.apply(run app.take())
  run frameBoth(&mut tree, &mut inspector, 0.2)
  let news = run lines(&mut client)
  let mut tree0 = false
  let mut k: usize = 0
  while k < news.length() {
    if String.contains(String.view(&news.asSlice()[k]), "\"event\":\"tree\"") {
      tree0 = true
    }
    k = k + 1
  }
  run Testing.expect(tree0, "a change in the app's root is")

  // A style edit of the app's node changes the app's root alone; the tools' cannot be edited.
  let toolsRevision = tree.revisionOf(TOOLS_ROOT)
  let edited = run local(
    &mut inspector,
    &mut tree,
    &mut client,
    "{\"id\":7,\"cmd\":\"setStyle\",\"node\":10,\"style\":\"width: 99px\"}",
  )
  run Testing.expect(
    ok(&edited) && tree.revisionOf(TOOLS_ROOT) == toolsRevision && !tree.needsFrameOf(TOOLS_ROOT)
      && tree.needsFrameOf(FIRST_ROOT),
    "an edit of the app's node leaves the tools' root alone",
  )
  let refused = run local(
    &mut inspector,
    &mut tree,
    &mut client,
    "{\"id\":8,\"cmd\":\"setStyle\",\"node\":901,\"style\":\"width: 99px\"}",
  )
  run Testing.expect(!ok(&refused) && !tree.overridden(901, StyleState.Base), "nor can edit them")
  drop run lines(&mut client)

  // The local client leaves: the inspector is off again.
  client.close()
  drop run inspector.serveLocal(&mut tree)
  run Testing.expect(!inspector.enabled(), "it turns off when the client closes its end")
}

effect fn array<'a>(reply: &'a Value, key: string) -> &'a [Value]
  ! OutOfMemoryError
  ? &mut Allocator {
  return match Json.field(reply, key) {
    Option<&Value>.Some { value } => match &value.* {
      Value.Array { values } => values.asSlice()
      _ => &[]
    }
    Option<&Value>.None => &[]
  }
}

test effect fn hiddenRootsAreLeftOut() -> ()
  ! AssertionError<'static> | TreeError | JsonError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run hiddenBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

// The MCP bridge: tool calls become protocol requests, run here with `Protocol.handle`.

/// Runs one JSON-RPC message through `bridge`, answering its requests with `protocol` (a
/// pending `wait` is retried with 50 ms more each time). Returns the response, or `null` when
/// there is none.
effect fn mcp(
  bridge: &mut Bridge,
  protocol: &mut Protocol,
  tree: &mut UiTree<'_>,
  line: string,
) -> Value
  ! JsonError | OutOfMemoryError
  ? &mut Allocator {
  let mut out = String.make()
  let mut reply = String.make()
  let mut action = run bridge.handle(String.utf8Bytes(line), &mut out)
  let mut waited: u64 = 0
  while action == Action.Ask || action == Action.Retry {
    if action == Action.Retry {
      waited = waited + bridge.retryDelay(waited)
    }
    let request = run Json.parse(out.ownedUtf8Bytes())
    let outcome = run protocol.handle(&mut tree, &request, 0, &mut reply)
    while run protocol.dispatchNext(&mut tree) {}
    if outcome == Outcome.Pending {
      reply.clear()
      run reply.append("{\"ok\":false,\"pending\":true,\"error\":\"not yet\"}")
    }
    action = run bridge.answer(reply.ownedUtf8Bytes(), true, waited, &mut out)
  }
  if action == Action.Nothing {
    return run Json.parse(b"null")
  }
  let response = run Json.parse(out.ownedUtf8Bytes())
  return move response
}

/// The first content item's member `key` of a tool result.
fn content<'a>(response: &'a Value, key: string) -> string<'a> {
  let items = Json.fieldAt(Json.field(response, "result"), "content")
  let first = match items {
    Option<&'a Value>.Some { value } => match &value.* {
      Value.Array { values } => {
        let list = values.asSlice()
        if list.length == 0 {
          return ""
        }
        Option<&'a Value>.Some { value: &list[0] }
      }
      _ => Option<&'a Value>.None
    }
    Option<&'a Value>.None => Option<&'a Value>.None
  }
  return match Json.asString(Json.fieldAt(first, key)) {
    Option<string>.Some { value } => value
    Option<string>.None => ""
  }
}

fn isError(response: &Value) -> bool {
  return match Json.fieldAt(Json.field(response, "result"), "isError") {
    Option<&Value>.Some { value } => match &value.* {
      Value.Bool { value: b } => b
      _ => false
    }
    Option<&Value>.None => false
  }
}

fn errorCode(response: &Value) -> i64 {
  return match Json.asI64(Json.fieldAt(Json.field(response, "error"), "code")) {
    Option<i64>.Some { value } => value
    Option<i64>.None => 0
  }
}

/// The number of tools `tools/list` returns, -1 when the shape is wrong.
fn toolCount(response: &Value) -> i64 {
  return match Json.fieldAt(Json.field(response, "result"), "tools") {
    Option<&Value>.Some { value } => match &value.* {
      Value.Array { values } => {
        return usize.toI64(values.length())
      }
      _ => -1
    }
    Option<&Value>.None => -1
  }
}

effect fn mcpBody() -> ()
  ! AssertionError<'static> | TreeError | JsonError | ImageError | PngError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run inbox(&collection)
  let mut protocol = Protocol.make()
  run protocol.afterFrame(&tree)
  let mut bridge = run Bridge.make("unix:/tmp/test.sock")

  let init = run mcp(
    &mut bridge,
    &mut protocol,
    &mut tree,
    "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-03-26\",\"capabilities\":{},\"clientInfo\":{\"name\":\"test\",\"version\":\"1\"}}}",
  )
  let result = Json.field(&init, "result")
  run Testing.expect(
    same(
      Json.asString(Json.fieldAt(result, "protocolVersion")) |> Option<string>.unwrapOr(""),
      "2025-03-26",
    ),
    "initialize answers the client's protocol version",
  )
  run Testing.expect(
    same(
      Json.asString(Json.fieldAt(Json.fieldAt(result, "serverInfo"), "name"))
        |> Option<string>.unwrapOr(""),
      "silk-ui-inspect",
    ),
    "and names the server",
  )
  let other = run mcp(
    &mut bridge,
    &mut protocol,
    &mut tree,
    "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"1999-01-01\"}}",
  )
  run Testing.expect(
    same(
      Json.asString(Json.fieldAt(Json.field(&other, "result"), "protocolVersion"))
        |> Option<string>.unwrapOr(""),
      "2025-06-18",
    ),
    "an unknown version gets the server's own",
  )
  let note = run mcp(
    &mut bridge,
    &mut protocol,
    &mut tree,
    "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}",
  )
  run Testing.expect(
    match &note {
      Value.Null => true
      _ => false
    },
    "notifications get no response",
  )
  let tools = run mcp(
    &mut bridge,
    &mut protocol,
    &mut tree,
    "{\"jsonrpc\":\"2.0\",\"id\":\"t\",\"method\":\"tools/list\"}",
  )
  run Testing.expect(toolCount(&tools) == 27, "twenty-seven tools")
  run Testing.expect(same(text(&tools, "id"), "t"), "string ids are echoed")

  // Snapshot is describe; inspect is the node view.
  let snap = run mcp(
    &mut bridge,
    &mut protocol,
    &mut tree,
    "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":{\"name\":\"ui_snapshot\",\"arguments\":{}}}",
  )
  let mut expected = String.make()
  run describe(&tree, DescribeOptions.plain(), &mut expected)
  run Testing.expect(
    same(content(&snap, "text"), String.view(&expected)) && !isError(&snap),
    "ui_snapshot is describe",
  )
  let view = run mcp(
    &mut bridge,
    &mut protocol,
    &mut tree,
    "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"tools/call\",\"params\":{\"name\":\"ui_inspect\",\"arguments\":{\"role\":\"button\",\"name\":\"New\"}}}",
  )
  let mut panel = String.make()
  run inspectNode(&tree, fixtures.NEW_BUTTON, InspectOptions.all(), &mut panel)
  run Testing.expect(
    same(content(&view, "text"), String.view(&panel)),
    "ui_inspect is the node view",
  )

  // Find the button by its label and click it: the app sees the click.
  let found = run mcp(
    &mut bridge,
    &mut protocol,
    &mut tree,
    "{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"tools/call\",\"params\":{\"name\":\"ui_query\",\"arguments\":{\"label\":\"New\",\"exact\":true}}}",
  )
  let foundReply = run Json.parse(String.utf8Bytes(content(&found, "text")))
  run Testing.expect(int(&foundReply, "count") == 1, "ui_query finds the button by its label")
  let clicked = run mcp(
    &mut bridge,
    &mut protocol,
    &mut tree,
    "{\"jsonrpc\":\"2.0\",\"id\":6,\"method\":\"tools/call\",\"params\":{\"name\":\"ui_click\",\"arguments\":{\"label\":\"New\",\"modifiers\":[\"shift\"]}}}",
  )
  let clickReply = run Json.parse(String.utf8Bytes(content(&clicked, "text")))
  run Testing.expect(
    !isError(&clicked) && int(&clickReply, "node") == 10,
    "ui_click clicks it, arguments passed through",
  )
  let mut records = List<Event>.make()
  run tree.takeEvents(&mut records)
  let mut sawClick = false
  let values = records.asSlice()
  let mut i: usize = 0
  while i < values.length {
    if values[i].kind == EventKind.Click && values[i].target == fixtures.NEW_BUTTON {
      sawClick = true
    }
    i = i + 1
  }
  run Testing.expect(sawClick, "the app sees a click record on New")
  run tree.frame(FrameInput { width: 360.0, height: 440.0, scale: 2.0, time: 0.1 })
  run protocol.afterFrame(&tree)

  // Screenshots come back as image content.
  let shot = run mcp(
    &mut bridge,
    &mut protocol,
    &mut tree,
    "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/call\",\"params\":{\"name\":\"ui_screenshot\",\"arguments\":{\"node\":20}}}",
  )
  run Testing.expect(
    same(content(&shot, "type"), "image") && same(content(&shot, "mimeType"), "image/png"),
    "ui_screenshot returns image content",
  )
  let encoded = String.utf8Bytes(content(&shot, "data"))
  let length = match Base64.decodedLength(encoded) {
    Result<usize, Base64Error>.Success { value } => value
    Result<usize, Base64Error>.Failure { error: _ } => 0
  }
  let mut bytes = run Bytes.zeroed(length)
  drop Base64.decodeInto(bytes.asMutSlice(), encoded)
  let image = run png.decode(bytes.asSlice())
  run Testing.expect(image.width() > 0 && image.width() < 720, "a PNG of the node")

  // wait: holds, then times out after retries; errors are tool errors.
  let there = run mcp(
    &mut bridge,
    &mut protocol,
    &mut tree,
    "{\"jsonrpc\":\"2.0\",\"id\":8,\"method\":\"tools/call\",\"params\":{\"name\":\"ui_wait\",\"arguments\":{\"role\":\"button\",\"name\":\"Archive\"}}}",
  )
  run Testing.expect(!isError(&there), "ui_wait for a node that is there")
  let late = run mcp(
    &mut bridge,
    &mut protocol,
    &mut tree,
    "{\"jsonrpc\":\"2.0\",\"id\":9,\"method\":\"tools/call\",\"params\":{\"name\":\"ui_wait\",\"arguments\":{\"name\":\"nothing like it\",\"timeout\":200}}}",
  )
  run Testing.expect(
    isError(&late) && String.startsWith(content(&late, "text"), "Timed out after 200 ms"),
    "ui_wait retries until its timeout",
  )
  let missing = run mcp(
    &mut bridge,
    &mut protocol,
    &mut tree,
    "{\"jsonrpc\":\"2.0\",\"id\":10,\"method\":\"tools/call\",\"params\":{\"name\":\"ui_click\",\"arguments\":{\"name\":\"no such button\"}}}",
  )
  run Testing.expect(
    isError(&missing) && same(content(&missing, "text"), "no node matches"),
    "a missing node is a tool error",
  )

  // Protocol errors.
  let unknown = run mcp(
    &mut bridge,
    &mut protocol,
    &mut tree,
    "{\"jsonrpc\":\"2.0\",\"id\":11,\"method\":\"tools/call\",\"params\":{\"name\":\"fly\"}}",
  )
  run Testing.expect(errorCode(&unknown) == -32602, "an unknown tool")
  let method = run mcp(
    &mut bridge,
    &mut protocol,
    &mut tree,
    "{\"jsonrpc\":\"2.0\",\"id\":12,\"method\":\"fly\"}",
  )
  run Testing.expect(errorCode(&method) == -32601, "an unknown method")
  let junk = run mcp(&mut bridge, &mut protocol, &mut tree, "not json")
  run Testing.expect(errorCode(&junk) == -32700, "a parse error")

  // An app that cannot be reached.
  let mut out = String.make()
  let asked = run bridge.handle(
    b"{\"jsonrpc\":\"2.0\",\"id\":13,\"method\":\"tools/call\",\"params\":{\"name\":\"ui_status\"}}",
    &mut out,
  )
  run Testing.expect(
    asked == Action.Ask && same(String.view(&out), "{\"cmd\":\"hello\"}"),
    "ui_status asks hello",
  )
  let gone = run bridge.answer(b"", false, 0, &mut out)
  let unreachable = run Json.parse(out.ownedUtf8Bytes())
  run Testing.expect(
    gone == Action.Respond && isError(&unreachable)
      && String.startsWith(
        content(&unreachable, "text"),
        "Could not reach the Silk UI at unix:/tmp/test.sock",
      ),
    "an unreachable app is a tool error naming the address",
  )

  // writeValue round-trips JSON. Numbers come back in their shortest form, so this one has no
  // exponent.
  let source = "{\"a\":[1,-2500.5,true,false,null],\"b\":\"q\\\"\\n\",\"c\":{}}"
  let value = run Json.parse(String.utf8Bytes(source))
  let mut written = String.make()
  run writeValue(&mut written, &value)
  run Testing.expect(same(String.view(&written), source), "writeValue writes JSON back")
}

test effect fn mcpToolsDriveTheTree() -> ()
  ! AssertionError<'static>
    | TreeError
    | JsonError
    | ImageError
    | PngError
    | FileError
    | HostInputError
    | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run mcpBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

// This exercises the actual bridge state machine, composed-scene capture, PNG decoder,
// contact sheet composition and timing; a static UI frame must remain visible as a repeat.
effect fn captureBody() -> ()
  ! AssertionError<'static> | TreeError | JsonError | ImageError | PngError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run inbox(&collection)
  let mut protocol = Protocol.make()
  let mut bridge = run Bridge.make("test")
  let mut wire = String.make()
  let mut reply = String.make()
  let mut scene = Scene.make()
  let full = Rect<f32>.new(0.0, 0.0, 720.0, 880.0)
  drop run scene.quad(Quad.fill(full, ContentMask.new(full), Background.solid(color.rgb(0xff0000))))
  run scene.finish()
  run protocol.afterFrameScene(&tree, &scene)
  let started = run bridge.handle(
    b"{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"ui_capture\",\"arguments\":{\"count\":2,\"intervalMs\":100,\"columns\":2,\"tileWidth\":160}}}",
    &mut wire,
  )
  run Testing.expect(started == Action.Ask, "capture asks for the first screenshot immediately")
  let request = run Json.parse(wire.ownedUtf8Bytes())
  drop run protocol.handle(&mut tree, &request, 0, &mut reply)
  let next = run bridge.answer(reply.ownedUtf8Bytes(), true, 12, &mut wire)
  run Testing.expect(
    next == Action.Retry && bridge.retryDelay(12) == 88 && bridge.retryDelay(99) == 1,
    "capture interval accounts for screenshot latency",
  )
  scene.clear()
  drop run scene.quad(Quad.fill(full, ContentMask.new(full), Background.solid(color.rgb(0x0000ff))))
  run scene.finish()
  run tree.frame(FrameInput { width: 360.0, height: 440.0, scale: 2.0, time: 0.1 })
  run protocol.afterFrameScene(&tree, &scene)
  let second = run Json.parse(wire.ownedUtf8Bytes())
  drop run protocol.handle(&mut tree, &second, 0, &mut reply)
  let done = run bridge.answer(reply.ownedUtf8Bytes(), true, 112, &mut wire)
  run Testing.expect(done == Action.Respond, "capture returns a mosaic after exactly two samples")
  run Testing.expect(
    String.contains(String.view(&wire), "elapsedMs\\\":112"),
    "actual sample timestamps are preserved",
  )
  let result = run Json.parse(wire.ownedUtf8Bytes())
  run Testing.expect(
    !isError(&result) && content(&result, "type") == "image",
    "MCP returns an image, not a filename",
  )
  let encoded = String.utf8Bytes(content(&result, "data"))
  let length = Base64.decodedLength(encoded).unwrapOr(0)
  let mut bytes = run Bytes.zeroed(length)
  drop Base64.decodeInto(bytes.asMutSlice(), encoded)
  let image = run png.decode(bytes.asSlice())
  run Testing.expect(image.width() == 344, "two requested columns plus gutters")
  let pixels = image.data()
  let firstAt: usize = (100 * 344 + 88) * 4
  let secondAt: usize = (100 * 344 + 256) * 4
  run Testing.expect(
    pixels[firstAt] == 255 && pixels[firstAt + 2] == 0,
    "first cell contains the composed red canvas",
  )
  run Testing.expect(
    pixels[secondAt] == 0 && pixels[secondAt + 2] == 255,
    "second cell contains the newer blue canvas",
  )

  let invalid = run mcp(
    &mut bridge,
    &mut protocol,
    &mut tree,
    "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"ui_capture\",\"arguments\":{\"count\":100000}}}",
  )
  run Testing.expect(
    errorCode(&invalid) == -32602,
    "capture limits reject excessive allocation before requesting frames",
  )
}

test effect fn timedCapturesReturnComposedMosaics() -> ()
  ! AssertionError<'static> | TreeError | JsonError | ImageError | PngError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run captureBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A click must give the host a chance to react to down before up is dispatched.
effect fn orderedBody() -> ()
  ! AssertionError<'static> | TreeError | JsonError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run inbox(&collection)
  let mut protocol = Protocol.make()
  tree.events.clear()
  let request = run Json.parse(b"{\"cmd\":\"click\",\"node\":10}")
  let mut reply = String.make()
  drop run protocol.handle(&mut tree, &request, 0, &mut reply)
  run Testing.expect(
    tree.events.length() == 0,
    "preparing input cannot bypass the host's event pump",
  )
  run Testing.expect(run protocol.dispatchNext(&mut tree), "move")
  run Testing.expect(run protocol.dispatchNext(&mut tree), "down")

  // Simulate the application's down handler disabling the button before the release.
  let mut batch = Batch.make()
  run batch.attribute(10, Attribute.Disabled { value: true })
  run tree.apply(run batch.take())
  tree.events.clear()
  run Testing.expect(run protocol.dispatchNext(&mut tree), "up")
  let events = tree.events.asSlice()
  let mut i: usize = 0
  while i < events.length {
    run Testing.expect(
      events[i].kind != EventKind.Click,
      "up observes the view changed by the down handler",
    )
    i = i + 1
  }
  run Testing.expect(!run protocol.dispatchNext(&mut tree), "no extra input")
}

// A host whose application can prevent defaults drains input in two steps per input.
effect fn twoStepBody() -> ()
  ! AssertionError<'static> | TreeError | JsonError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run inbox(&collection)
  let mut protocol = Protocol.make()
  tree.events.clear()
  let request = run Json.parse(b"{\"cmd\":\"click\",\"node\":10}")
  let mut reply = String.make()
  drop run protocol.handle(&mut tree, &request, 0, &mut reply)
  run Testing.expect(run protocol.beginNext(&mut tree), "move begins")
  run Testing.expect(!run protocol.beginNext(&mut tree), "one input at a time")
  run Testing.expect(protocol.hasInput(), "a begun input still waits for its default")
  run protocol.finishNext(&mut tree, false)
  run Testing.expect(run protocol.beginNext(&mut tree), "down begins")
  run protocol.finishNext(&mut tree, true)
  run Testing.expect(run protocol.beginNext(&mut tree), "up begins")
  run protocol.finishNext(&mut tree, false)
  let events = tree.events.asSlice()
  let mut clicked = false
  let mut i: usize = 0
  while i < events.length {
    if events[i].kind == EventKind.Click {
      clicked = true
    }
    i = i + 1
  }
  run Testing.expect(clicked, "a prevented press still clicks, as in the DOM")
  run Testing.expect(!run protocol.beginNext(&mut tree), "no extra input")
  run Testing.expect(!protocol.hasInput(), "the queue is drained")
}

test effect fn hostCanDecideBetweenRecordsAndDefaults() -> ()
  ! AssertionError<'static> | TreeError | JsonError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run twoStepBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn compoundInputAllowsHostReactionsBetweenEvents() -> ()
  ! AssertionError<'static> | TreeError | JsonError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run orderedBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn equivalentInputBody() -> ()
  ! AssertionError<'static> | TreeError | JsonError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut nativeTree = run inbox(&collection)
  let mut inspectTree = run inbox(&collection)
  let mut nativeBatch = Batch.make()
  let mut inspectBatch = Batch.make()
  run nativeBatch.listen(1, LISTEN_ALL)
  run inspectBatch.listen(1, LISTEN_ALL)
  run nativeTree.apply(run nativeBatch.take())
  run inspectTree.apply(run inspectBatch.take())
  nativeTree.events.clear()
  inspectTree.events.clear()
  let mut nativeLog = Protocol.make()
  let mut inspectLog = Protocol.make()
  let owner = WindowId { value: 1 }
  let modifiers = Modifiers.none()
  let mut events = List<WindowEvent>.make()
  run events.append(
    WindowEvent.MouseMoved {
      window: owner,
      position: Point2<f64> { x: 40.0, y: 27.0 },
      modifiers: modifiers,
    },
  )
  run events.append(
    WindowEvent.MouseDown {
      window: owner,
      button: MouseButton.Left,
      position: Point2<f64> { x: 40.0, y: 27.0 },
      modifiers: modifiers,
      clickCount: 1,
    },
  )
  run events.append(
    WindowEvent.MouseMoved {
      window: owner,
      position: Point2<f64> { x: 320.0, y: 420.0 },
      modifiers: modifiers,
    },
  )
  run events.append(
    WindowEvent.MouseUp {
      window: owner,
      button: MouseButton.Left,
      position: Point2<f64> { x: 320.0, y: 420.0 },
      modifiers: modifiers,
    },
  )
  run events.append(
    WindowEvent.KeyDown {
      window: owner,
      key: Key.Character { text: run String.copy(" ") },
      code: KeyCode.Space,
      modifiers: modifiers,
      repeat: false,
      imeHandled: false,
    },
  )
  run events.append(
    WindowEvent.KeyUp {
      window: owner,
      key: Key.Character { text: run String.copy(" ") },
      code: KeyCode.Space,
      modifiers: modifiers,
    },
  )
  let commands: [string; 6] = [
    r"""{"cmd":"pointer","phase":"move","x":40,"y":27}""",
    r"""{"cmd":"pointer","phase":"down","x":40,"y":27}""",
    r"""{"cmd":"pointer","phase":"move","x":320,"y":420}""",
    r"""{"cmd":"pointer","phase":"up","x":320,"y":420}""",
    r"""{"cmd":"key","phase":"down","key":" ","code":"Space"}""",
    r"""{"cmd":"key","phase":"up","key":" ","code":"Space"}""",
  ]
  let mut out = String.make()
  let mut i: usize = 0
  while i < commands.length {
    drop run feed(&mut nativeTree, &events.asSlice()[i])
    let request = run Json.parse(String.utf8Bytes(commands[i]))
    drop run inspectLog.handle(&mut inspectTree, &request, 0, &mut out)
    run Testing.expect(
      run inspectLog.dispatchNext(&mut inspectTree),
      "one inspector input per phase",
    )
    run Testing.expect(
      !run inspectLog.dispatchNext(&mut inspectTree),
      "no hidden extra pointer moves",
    )
    run nativeLog.observe(&nativeTree)
    run inspectLog.observe(&inspectTree)
    nativeTree.events.clear()
    inspectTree.events.clear()
    i = i + 1
  }
  run Testing.expect(
    nativeLog.log.length() == inspectLog.log.length() && nativeLog.log.length() > 0,
    "native and inspector paths emit the same event count",
  )
  let left = nativeLog.log.asSlice()
  let right = inspectLog.log.asSlice()
  i = 0
  while i < left.length {
    run Testing.expect(
      left[i].kind == right[i].kind && left[i].target == right[i].target && left[i].x == right[i].x
        && left[i].y == right[i].y
        && left[i].modifiers == right[i].modifiers
        && String.view(&left[i].key) == String.view(&right[i].key),
      "native mouse/key adapter and inspector produce indistinguishable routed records",
    )
    i = i + 1
  }
}

test effect fn inspectorInputMatchesNativeWindowAdapter() -> ()
  ! AssertionError<'static> | TreeError | JsonError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run equivalentInputBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn devtoolsBody() -> ()
  ! AssertionError<'static> | TreeError | JsonError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run inbox(&collection)
  let mut protocol = Protocol.make()
  let viewport = FrameInput { width: 360.0, height: 440.0, scale: 2.0, time: 0.0 }

  // A program's messages and model are its framework's to serve (an extension), not the
  // inspector's.
  let bare = run ask(&mut protocol, &mut tree, "{\"cmd\":\"messages\"}")
  run Testing.expect(same(text(&bare, "error"), "unknown cmd"), "the inspector has no program")

  // Frames are recorded as they are drawn.
  run protocol.afterFrame(&tree)
  let untimed = run raw(&mut protocol, &mut tree, "{\"cmd\":\"frames\"}")
  run Testing.expect(
    String.contains(String.view(&untimed), "\"timed\":false"),
    "untimed until the host times one",
  )
  protocol.timeline.timed(1.5, 0.25)
  run tree.frame(FrameInput { width: 360.0, height: 440.0, scale: 2.0, time: 1.0 })
  run protocol.afterFrame(&tree)
  run protocol.afterFrame(&tree)
  let frames = run raw(&mut protocol, &mut tree, "{\"cmd\":\"frames\"}")
  run Testing.expect(String.contains(String.view(&frames), "\"count\":2"), "one record per frame")
  run Testing.expect(
    String.contains(String.view(&frames), "\"layoutMs\":1.5,\"paintMs\":0.25"),
    "with the host's timing",
  )

  // A host that times its frames still does when they take no time to speak of.
  let mut quick: usize = 0
  while quick < 3 {
    protocol.timeline.timed(0.001, 0.001)
    run tree.frame(FrameInput { width: 360.0, height: 440.0, scale: 2.0, time: 2.0 })
    run protocol.afterFrame(&tree)
    quick = quick + 1
  }
  let recent = run raw(&mut protocol, &mut tree, "{\"cmd\":\"frames\",\"limit\":2}")
  run Testing.expect(
    String.contains(String.view(&recent), "\"timed\":true,\"slowestMs\":0,"),
    "timed, though the last frames round to nothing",
  )

  // Styles are edited while the app runs, and put back.
  let before = run raw(&mut protocol, &mut tree, "{\"cmd\":\"inspect\",\"node\":20}")
  run Testing.expect(String.contains(String.view(&before), "\"width\":76.64"), "Archive as built")
  let set = run ask(
    &mut protocol,
    &mut tree,
    "{\"cmd\":\"setStyle\",\"node\":20,\"style\":\"width: 200px; color: #ffffff; background-color: #fefefe\"}",
  )
  run Testing.expect(ok(&set) && int(&set, "edited") == 1, "a style is set")
  run Testing.expect(protocol.repaint, "and a frame asked for")
  run tree.frame(viewport)
  let wide = run raw(&mut protocol, &mut tree, "{\"cmd\":\"inspect\",\"node\":20}")
  run Testing.expect(!String.contains(String.view(&wide), "\"width\":76.64"), "layout follows")
  let listing = run raw(&mut protocol, &mut tree, "{\"cmd\":\"styles\",\"node\":20}")
  run Testing.expect(
    String.contains(String.view(&listing), "\"width: 200px\""),
    "styles lists the declarations as text",
  )
  let audited = run raw(&mut protocol, &mut tree, "{\"cmd\":\"audit\"}")
  run Testing.expect(
    String.contains(String.view(&audited), "\"rule\":\"contrast\""),
    "the audit finds white text on white",
  )
  let bad = run ask(
    &mut protocol,
    &mut tree,
    "{\"cmd\":\"setStyle\",\"node\":20,\"state\":\"wobbling\",\"style\":\"width: 1px\"}",
  )
  run Testing.expect(same(text(&bad, "error"), "unknown state"), "states are named")
  let reset = run ask(&mut protocol, &mut tree, "{\"cmd\":\"resetStyles\"}")
  run Testing.expect(int(&reset, "restored") == 1, "the edit is taken back")
  run tree.frame(viewport)
  let after = run raw(&mut protocol, &mut tree, "{\"cmd\":\"inspect\",\"node\":20}")
  run Testing.expect(String.contains(String.view(&after), "\"width\":76.64"), "as it was")

  // The picker takes the window's pointer.
  let on = run ask(&mut protocol, &mut tree, "{\"cmd\":\"pickMode\",\"on\":true}")
  run Testing.expect(ok(&on) && protocol.intercepts(), "picking is on")
  let moved = Input.PointerMove { x: 100.0, y: 28.0, modifiers: 0 }
  run Testing.expect(run protocol.pickInput(&tree, &moved), "a move is the picker's")
  run Testing.expect(protocol.highlight.nodes.length() == 1, "and highlights what it is over")
  let down = Input.PointerDown { x: 100.0, y: 28.0, button: 0, modifiers: 0, clickCount: 1 }
  run Testing.expect(run protocol.pickInput(&tree, &down), "a press picks")
  let up = Input.PointerUp { x: 100.0, y: 28.0, button: 0, modifiers: 0 }
  run Testing.expect(run protocol.pickInput(&tree, &up), "its release is not the app's either")
  run Testing.expect(!run protocol.pickInput(&tree, &moved), "and then input is the app's again")
  let picked = run raw(&mut protocol, &mut tree, "{\"cmd\":\"pickMode\"}")
  run Testing.expect(
    String.contains(String.view(&picked), "\"on\":false,\"picked\":{\"id\":"),
    "the pick is kept for whoever asked",
  )
}

test effect fn devtoolsCommands() -> ()
  ! AssertionError<'static>
    | TreeError
    | JsonError
    | FileError
    | HostInputError
    | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run devtoolsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
