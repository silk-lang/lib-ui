//! Tests of the node schema, ported from AccessKit's `accesskit/src/lib.rs` tests.
import lib {
  Node,
  NodeId,
  Role,
  Action,
  Live,
  Toggled,
  CustomAction,
  TextSelection,
  TextPosition,
  Rect,
  Affine,
  Point
}
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

effect fn orderDoesNotMatter() -> ()
  ! OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let mut node = Node.make(Role.Button)
  run node.setLabel("a label")
  run node.setChildren(&[NodeId.of(1)])
  run node.setDescription("a description")
  let mut reordered = Node.make(Role.Button)
  run reordered.setDescription("a description")
  run reordered.setChildren(&[NodeId.of(1)])
  run reordered.setLabel("a label")
  run Testing.expect(
    node.equals(&reordered),
    "nodes are equal whatever order properties were set in",
  )
}

test effect fn nodesAreEqualRegardlessOfPropertyOrder() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run orderDoesNotMatter() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn clearedEqualsUnset() -> ()
  ! OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let mut node = Node.make(Role.Button)
  run node.setLabel("a label")
  node.clearLabel()
  run Testing.expect(
    node.equals(&Node.make(Role.Button)),
    "a cleared property equals one never set",
  )
  run Testing.expect(node.label().isNone(), "and reads as unset")
}

test effect fn clearedPropertyEqualsOneNeverSet() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run clearedEqualsUnset() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn copies() -> ()
  ! OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let mut source = Node.make(Role.Button)
  source.addAction(Action.Click)
  source.addChildAction(Action.Focus)
  source.setHidden()
  run source.setLabel("source")
  run source.setChildren(&[NodeId.of(1)])
  run source.pushCustomAction(run CustomAction.make(1, "first"))
  run source.setCharacterLengths(&[1, 2, 3])
  run source.setCharacterPositions(&[0.0, 1.0, 3.0])
  let copy = run source.copy()
  run Testing.expect(copy.equals(&source), "a copy equals its source")
  run Testing.expect(
    copy.supportsAction(Action.Click) && !copy.supportsAction(Action.Focus),
    "actions copy",
  )
  run Testing.expect(copy.childSupportsAction(Action.Focus), "child actions copy")
  run Testing.expect(copy.isHidden() && !copy.isModal(), "flags copy")
  run Testing.expect(
    copy.customActions().length == 1 && copy.customActions()[0].id == 1,
    "custom actions copy",
  )
  let mut other = Node.make(Role.CheckBox)
  run other.setLabel("source")
  run Testing.expect(!other.equals(&source), "a different role is a different node")
}

test effect fn copyEqualsTheSource() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run copies() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn accessors() -> ()
  ! OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let mut node = Node.make(Role.Unknown)
  run Testing.expect(node.children().length == 0, "children start empty")
  run node.pushChild(NodeId.of(0))
  run node.pushChild(NodeId.of(1))
  run Testing.expect(
    node.children().length == 2 && node.children()[1].value == 1,
    "the pusher appends",
  )
  node.clearChildren()
  run node.pushChild(NodeId.of(7))
  run Testing.expect(
    node.children().length == 1 && node.children()[0].value == 7,
    "the pusher starts a new list after the clearer",
  )
  run Testing.expect(node.live().isNone(), "enums start unset")
  run node.setLive(Live.Assertive)
  run Testing.expect(node.live().unwrapOr(Live.Off) == Live.Assertive, "an enum setter updates")
  run node.setToggled(Toggled.Mixed)
  run Testing.expect(node.toggled().unwrapOr(Toggled.False) == Toggled.Mixed, "toggled holds mixed")
  run node.setNumericValue(0.5)
  run Testing.expect(node.numericValue().unwrapOr(0.0) == 0.5, "f64 properties")
  run node.setLevel(2)
  run Testing.expect(node.level().unwrapOr(0) == 2, "usize properties")
  run node.setExpanded(false)
  run Testing.expect(
    node.isExpanded().isSome() && !node.isExpanded().unwrapOr(true),
    "bool properties keep false",
  )
  run node.setBounds(Rect.make(0.0, 1.0, 2.0, 3.0))
  run Testing.expect(
    node.bounds().unwrapOr(Rect.zero()).equals(Rect.make(0.0, 1.0, 2.0, 3.0)),
    "bounds",
  )
  run node.setTransform(Affine.identity())
  run Testing.expect(node.transform().isSome(), "transforms")
  let caret = TextPosition { node: NodeId.of(0), characterIndex: 2 }
  run node.setTextSelection(TextSelection { anchor: caret, focus: caret })
  run Testing.expect(
    node.textSelection().unwrapOr(
      TextSelection { anchor: caret, focus: caret },
    ).focus.characterIndex
      == 2,
    "text selections",
  )
  run node.setValue("hello")
  run Testing.expect(
    match node.value() {
      Option.Some { value } => value == "hello"
      Option.None => false
    },
    "strings",
  )
}

test effect fn propertyAccessors() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run accessors() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn actionOrdinalsRoundTrip() -> ()
  ! AssertionError<'static> {
  run Testing.expect(Action.n(0).unwrapOr(Action.Blur) == Action.Click, "0 is click")
  run Testing.expect(
    Action.n(21).unwrapOr(Action.Blur) == Action.ShowContextMenu,
    "21 is show context menu",
  )
  run Testing.expect(Action.n(22).isNone(), "22 is out of range")
  run Testing.expect(Role.n(0).unwrapOr(Role.Button) == Role.Unknown, "role 0 is unknown")
  run Testing.expect(Role.Terminal.name() == "Terminal", "names")
}

test effect fn geometry() -> ()
  ! AssertionError<'static> {
  let r = Rect.fromPoints(Point.make(4.0, 5.0), Point.make(1.0, 2.0))
  run Testing.expect(r.x0 == 1.0 && r.y1 == 5.0, "fromPoints orders the corners")
  let moved = Affine.translate(Point.make(10.0, 0.0).toVec2()).transformRectBbox(r)
  run Testing.expect(moved.x0 == 11.0, "translate moves the box")
  let back = Affine.scale(2.0).inverse().apply(Point.make(4.0, 4.0))
  run Testing.expect(back.x == 2.0 && back.y == 2.0, "inverse")
}
