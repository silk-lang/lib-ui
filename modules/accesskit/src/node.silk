  }

  /// The ordered list of this node's direct children in the tree. The order
  /// should match the intended reading and navigation order.
  pub fn children(self: &Self) -> &[NodeId] {
    let index = self.slot(PropertyId.Children)
    if index == UNSET {
      return &[]
    }
    return match &self.values.asSlice()[u8.toUsize(index)] {
      PropertyValue.NodeIdVec { value } => value.asSlice()
      _ => &[]
    }
  }

  pub effect fn setChildren(self: &mut Self, value: &[NodeId]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.put(
      PropertyId.Children,
      PropertyValue.NodeIdVec { value: run copyList<NodeId>(value) },
    )
  }

  pub effect fn pushChild(self: &mut Self, item: NodeId) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let index = self.slot(PropertyId.Children)
    if index != UNSET {
      let entry = &mut self.values.asMutSlice()[u8.toUsize(index)]
      match &mut entry.* {
        PropertyValue.NodeIdVec { value } => {
          run value.append(move item)
          return ()
        }
        _ => {}
      }
    }
    let mut list = List<NodeId>.make()
    run list.append(move item)
    run self.put(PropertyId.Children, PropertyValue.NodeIdVec { value: move list })
  }

  pub fn clearChildren(self: &mut Self) -> () {
    self.clearProperty(PropertyId.Children)
  }

  /// The nodes whose contents or presence are controlled by this node. ARIA
  /// equivalent: [`aria-controls`].
