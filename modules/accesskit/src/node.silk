import silk.num.usize
import silk.text.string { String }

/// The id of a node, unique within its tree. The application chooses it.
pub struct NodeId {
  pub value: u64,
}

impl Copy for NodeId {}

impl NodeId {
  pub fn of(value: u64) -> NodeId {
    return NodeId { value: value }
  }

  pub fn equals(self: Self, other: NodeId) -> bool {
    return self.value == other.value
  }
}

/// The id of a tree: [`TreeId.root`] for the main tree, a UUID for a subtree grafted into it.
pub struct TreeId {
  pub bytes: [u8; 16],
}

impl Copy for TreeId {}

impl TreeId {
  /// The main tree: the nil UUID.
  pub fn root() -> TreeId {
    return TreeId { bytes: [0; 16] }
  }

  pub fn equals(self: Self, other: TreeId) -> bool {
    let mut i: usize = 0
    while i < 16 {
      if self.bytes[i] != other.bytes[i] {
        return false
      }
      i = i + 1
    }
    return true
  }
}

/// An action the application defines, shown to the user by `description`.
pub struct CustomAction {
  pub id: i32,
  pub description: String,
}

impl CustomAction {
  pub effect fn make(id: i32, description: string) -> CustomAction
    ! OutOfMemoryError
    ? &mut Allocator {
    return CustomAction { id: id, description: run String.copy(description) }
  }

  pub effect fn copy(self: &Self) -> CustomAction
    ! OutOfMemoryError
    ? &mut Allocator {
    return CustomAction { id: self.id, description: run String.copy(self.description.view()) }
  }

  pub fn equals(self: &Self, other: &CustomAction) -> bool {
    return self.id == other.id && self.description.view() == other.description.view()
  }
}

/// A position in the text of a text run node: `characterIndex` counts characters as the
/// node's `characterLengths` splits them.
pub struct TextPosition {
  /// The text run node.
  pub node: NodeId,
  pub characterIndex: usize,
}

impl Copy for TextPosition {}

impl TextPosition {
  pub fn equals(self: Self, other: TextPosition) -> bool {
    return self.node.value == other.node.value && self.characterIndex == other.characterIndex
  }
}

/// A text selection: equal anchor and focus for a caret.
pub struct TextSelection {
  /// Where the selection started, which stays put while it is extended.
  pub anchor: TextPosition,
  /// Where the caret is.
  pub focus: TextPosition,
}

impl Copy for TextSelection {}

impl TextSelection {
  pub fn equals(self: Self, other: TextSelection) -> bool {
    return self.anchor.equals(other.anchor) && self.focus.equals(other.focus)
  }
}

/// An 8-bit sRGB color with alpha.
pub struct Color {
  pub red: u8,
  pub green: u8,
  pub blue: u8,
  pub alpha: u8,
}

impl Copy for Color {}

impl Color {
  pub fn equals(self: Self, other: Color) -> bool {
    return self.red == other.red && self.green == other.green && self.blue == other.blue
      && self.alpha == other.alpha
  }
}

/// The style and color of an underline, overline or strikethrough.
pub struct TextDecoration {
  pub style: TextDecorationStyle,
  pub color: Color,
}

impl Copy for TextDecoration {}

impl TextDecoration {
  pub fn equals(self: Self, other: TextDecoration) -> bool {
    return self.style == other.style && self.color.equals(other.color)
  }
}

/// The type of an accessibility node.
///
/// Roles follow Chromium's internal roles, which map onto the platform APIs and ARIA.
pub enum Role {
  Unknown,
  TextRun,
  Cell,
  Label,
  Image,
  Link,
  Row,
  ListItem,
  /// Contains the bullet, number, or other marker for a list item.
  ListMarker,
  TreeItem,
  ListBoxOption,
  MenuItem,
  MenuListOption,
  Paragraph,
  /// A generic container that should be ignored by assistive technologies
  /// and filtered out of platform accessibility trees. Equivalent to the ARIA
  /// `none` or `presentation` role, or to an HTML `div` with no role.
  GenericContainer,
  CheckBox,
  RadioButton,
  TextInput,
  Button,
  DefaultButton,
  Pane,
  RowHeader,
  ColumnHeader,
  RowGroup,
  List,
  Table,
