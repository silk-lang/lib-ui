  /// [`aria-details`]: https://www.w3.org/TR/wai-aria-1.2/#aria-details
  pub fn details(self: &Self) -> &[NodeId] {
    let index = self.slot(PropertyId.Details)
    if index == UNSET {
      return &[]
    }
    return match &self.values.asSlice()[u8.toUsize(index)] {
      PropertyValue.NodeIdVec { value } => value.asSlice()
      _ => &[]
    }
  }

  pub effect fn setDetails(self: &mut Self, value: &[NodeId]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.put(PropertyId.Details, PropertyValue.NodeIdVec { value: run copyList<NodeId>(value) })
  }

  pub effect fn pushDetail(self: &mut Self, item: NodeId) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let index = self.slot(PropertyId.Details)
