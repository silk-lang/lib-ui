//! The data model of an accessibility tree: [`Node`], its [`Role`], the [`Action`]s it
//! supports, and the property value types. Generated from AccessKit's `accesskit/src/lib.rs`.
//!
//! Ported from AccessKit 0.25 (https://github.com/AccessKit/accesskit), Copyright 2023 The
//! AccessKit Authors, under the MIT or Apache-2.0 license (see LICENSE-MIT and
//! LICENSE-APACHE). Role and property descriptions are derived from Chromium's
//! accessibility abstraction, Copyright 2018 The Chromium Authors, under the BSD license in
//! LICENSE.chromium.
import geometry { Affine, Rect }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
