  TabPanel,
  Term,
  Time,
  Timer,
  TitleBar,
  Toolbar,
  Tooltip,
  Tree,
  TreeGrid,
  Video,
  WebView,
  Window,
  PdfActionableHighlight,
  PdfRoot,
  GraphicsDocument,
  GraphicsObject,
  GraphicsSymbol,
  DocAbstract,
  DocAcknowledgements,
  DocAfterword,
  DocAppendix,
  DocBackLink,
  DocBiblioEntry,
  DocBibliography,
  DocBiblioRef,
  DocChapter,
  DocColophon,
  DocConclusion,
  DocCover,
  DocCredit,
  DocCredits,
  DocDedication,
  DocEndnote,
  DocEndnotes,
  DocEpigraph,
  DocEpilogue,
  DocErrata,
  DocExample,
  DocFootnote,
  DocForeword,
  DocGlossary,
  DocGlossRef,
  DocIndex,
  DocIntroduction,
  DocNoteRef,
  DocNotice,
  DocPageBreak,
  DocPageFooter,
  DocPageHeader,
  DocPageList,
  DocPart,
  DocPreface,
  DocPrologue,
  DocPullquote,
  DocQna,
  DocSubtitle,
  DocTip,
  DocToc,
  /// Behaves similar to an ARIA grid but is primarily used by Chromium's
  /// `TableView` and its subclasses, so they can be exposed correctly
  /// on certain platforms.
  ListGrid,
  /// This is just like a multi-line document, but signals that assistive
  /// technologies should implement behavior specific to a VT-100-style
  /// terminal.
  Terminal,
}

impl Role {
  /// The variant whose ordinal is `value`.
