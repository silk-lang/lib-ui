    run self.put(
      PropertyId.CustomActions,
      PropertyValue.CustomActionVec { value: run copyCustomActions(value) },
    )
  }

  pub effect fn pushCustomAction(self: &mut Self, item: CustomAction) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let index = self.slot(PropertyId.CustomActions)
    if index != UNSET {
      let entry = &mut self.values.asMutSlice()[u8.toUsize(index)]
      match &mut entry.* {
        PropertyValue.CustomActionVec { value } => {
          run value.append(move item)
          return ()
        }
        _ => {}
      }
    }
    let mut list = List<CustomAction>.make()
    run list.append(move item)
    run self.put(PropertyId.CustomActions, PropertyValue.CustomActionVec { value: move list })
  }

  pub fn clearCustomActions(self: &mut Self) -> () {
    self.clearProperty(PropertyId.CustomActions)
  }
}

fn isNone(value: &PropertyValue) -> bool {
  return match &value.* {
    PropertyValue.None => true
    _ => false
  }
}
