const PROPERTY_COUNT: usize = 87

const UNSET: u8 = 255

union PropertyValue {
  None,
  NodeIdVec { pub value: List<NodeId> },
  NodeId { pub value: NodeId },
  String { pub value: String },
  F64 { pub value: f64 },
  F32 { pub value: f32 },
  Usize { pub value: usize },
  Color { pub value: Color },
  TextDecoration { pub value: TextDecoration },
  LengthVec { pub value: List<u8> },
  CoordVec { pub value: List<f32> },
  Bool { pub value: bool },
  Invalid { pub value: Invalid },
  Toggled { pub value: Toggled },
  Live { pub value: Live },
  TextDirection { pub value: TextDirection },
  Orientation { pub value: Orientation },
  SortDirection { pub value: SortDirection },
  AriaCurrent { pub value: AriaCurrent },
  AutoComplete { pub value: AutoComplete },
  HasPopup { pub value: HasPopup },
  ListStyle { pub value: ListStyle },
  TextAlign { pub value: TextAlign },
  VerticalOffset { pub value: VerticalOffset },
  Affine { pub value: Affine },
  Rect { pub value: Rect },
  TextSelection { pub value: TextSelection },
  CustomActionVec { pub value: List<CustomAction> },
  TreeId { pub value: TreeId },
}

fn valueEquals(a: &PropertyValue, b: &PropertyValue) -> bool {
  return match &a.* {
    PropertyValue.None => match &b.* {
      PropertyValue.None => true
      _ => false
    }
    PropertyValue.NodeIdVec { value: x } => match &b.* {
      PropertyValue.NodeIdVec { value: y } => slicesEqualNodeId(x.asSlice(), y.asSlice())
      _ => false
    }
    PropertyValue.NodeId { value: x } => match &b.* {
      PropertyValue.NodeId { value: y } => x.equals(y)
      _ => false
    }
    PropertyValue.String { value: x } => match &b.* {
      PropertyValue.String { value: y } => x.view() == y.view()
      _ => false
    }
    PropertyValue.F64 { value: x } => match &b.* {
      PropertyValue.F64 { value: y } => x == y
      _ => false
    }
    PropertyValue.F32 { value: x } => match &b.* {
      PropertyValue.F32 { value: y } => x == y
      _ => false
    }
    PropertyValue.Usize { value: x } => match &b.* {
      PropertyValue.Usize { value: y } => x == y
      _ => false
    }
    PropertyValue.Color { value: x } => match &b.* {
      PropertyValue.Color { value: y } => x.equals(y)
      _ => false
    }
    PropertyValue.TextDecoration { value: x } => match &b.* {
      PropertyValue.TextDecoration { value: y } => x.equals(y)
      _ => false
    }
    PropertyValue.LengthVec { value: x } => match &b.* {
      PropertyValue.LengthVec { value: y } => slicesEqualU8(x.asSlice(), y.asSlice())
      _ => false
    }
    PropertyValue.CoordVec { value: x } => match &b.* {
      PropertyValue.CoordVec { value: y } => slicesEqualF32(x.asSlice(), y.asSlice())
      _ => false
    }
    PropertyValue.Bool { value: x } => match &b.* {
      PropertyValue.Bool { value: y } => x == y
      _ => false
    }
    PropertyValue.Invalid { value: x } => match &b.* {
      PropertyValue.Invalid { value: y } => x == y
      _ => false
    }
    PropertyValue.Toggled { value: x } => match &b.* {
      PropertyValue.Toggled { value: y } => x == y
      _ => false
    }
    PropertyValue.Live { value: x } => match &b.* {
      PropertyValue.Live { value: y } => x == y
      _ => false
    }
    PropertyValue.TextDirection { value: x } => match &b.* {
      PropertyValue.TextDirection { value: y } => x == y
      _ => false
    }
    PropertyValue.Orientation { value: x } => match &b.* {
      PropertyValue.Orientation { value: y } => x == y
      _ => false
    }
    PropertyValue.SortDirection { value: x } => match &b.* {
      PropertyValue.SortDirection { value: y } => x == y
      _ => false
    }
    PropertyValue.AriaCurrent { value: x } => match &b.* {
      PropertyValue.AriaCurrent { value: y } => x == y
      _ => false
    }
    PropertyValue.AutoComplete { value: x } => match &b.* {
      PropertyValue.AutoComplete { value: y } => x == y
      _ => false
    }
    PropertyValue.HasPopup { value: x } => match &b.* {
      PropertyValue.HasPopup { value: y } => x == y
      _ => false
    }
    PropertyValue.ListStyle { value: x } => match &b.* {
      PropertyValue.ListStyle { value: y } => x == y
      _ => false
    }
    PropertyValue.TextAlign { value: x } => match &b.* {
      PropertyValue.TextAlign { value: y } => x == y
      _ => false
    }
    PropertyValue.VerticalOffset { value: x } => match &b.* {
      PropertyValue.VerticalOffset { value: y } => x == y
      _ => false
    }
    PropertyValue.Affine { value: x } => match &b.* {
      PropertyValue.Affine { value: y } => x.equals(y)
      _ => false
    }
    PropertyValue.Rect { value: x } => match &b.* {
      PropertyValue.Rect { value: y } => x.equals(y)
      _ => false
    }
    PropertyValue.TextSelection { value: x } => match &b.* {
      PropertyValue.TextSelection { value: y } => x.equals(y)
      _ => false
    }
    PropertyValue.CustomActionVec { value: x } => match &b.* {
      PropertyValue.CustomActionVec { value: y } => customActionsEqual(x.asSlice(), y.asSlice())
      _ => false
    }
    PropertyValue.TreeId { value: x } => match &b.* {
      PropertyValue.TreeId { value: y } => x.equals(y)
      _ => false
    }
  }
}

fn slicesEqualNodeId(a: &[NodeId], b: &[NodeId]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut i: usize = 0
  while i < a.length {
    if a[i].value != b[i].value {
      return false
    }
    i = i + 1
  }
  return true
}

fn slicesEqualU8(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut i: usize = 0
  while i < a.length {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn slicesEqualF32(a: &[f32], b: &[f32]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut i: usize = 0
  while i < a.length {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn customActionsEqual(a: &[CustomAction], b: &[CustomAction]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut i: usize = 0
  while i < a.length {
    if !a[i].equals(&b[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

effect fn copyValue(value: &PropertyValue) -> PropertyValue
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &value.* {
    PropertyValue.None => PropertyValue.None
    PropertyValue.NodeIdVec { value: x } => PropertyValue.NodeIdVec {
      value: run copyList<NodeId>(x.asSlice()),
    }
    PropertyValue.NodeId { value: x } => PropertyValue.NodeId { value: x }
    PropertyValue.String { value: x } => PropertyValue.String { value: run String.copy(x.view()) }
    PropertyValue.F64 { value: x } => PropertyValue.F64 { value: x }
    PropertyValue.F32 { value: x } => PropertyValue.F32 { value: x }
    PropertyValue.Usize { value: x } => PropertyValue.Usize { value: x }
    PropertyValue.Color { value: x } => PropertyValue.Color { value: x }
    PropertyValue.TextDecoration { value: x } => PropertyValue.TextDecoration { value: x }
    PropertyValue.LengthVec { value: x } => PropertyValue.LengthVec {
      value: run copyList<u8>(x.asSlice()),
    }
    PropertyValue.CoordVec { value: x } => PropertyValue.CoordVec {
      value: run copyList<f32>(x.asSlice()),
    }
    PropertyValue.Bool { value: x } => PropertyValue.Bool { value: x }
    PropertyValue.Invalid { value: x } => PropertyValue.Invalid { value: x }
    PropertyValue.Toggled { value: x } => PropertyValue.Toggled { value: x }
    PropertyValue.Live { value: x } => PropertyValue.Live { value: x }
    PropertyValue.TextDirection { value: x } => PropertyValue.TextDirection { value: x }
    PropertyValue.Orientation { value: x } => PropertyValue.Orientation { value: x }
    PropertyValue.SortDirection { value: x } => PropertyValue.SortDirection { value: x }
    PropertyValue.AriaCurrent { value: x } => PropertyValue.AriaCurrent { value: x }
    PropertyValue.AutoComplete { value: x } => PropertyValue.AutoComplete { value: x }
    PropertyValue.HasPopup { value: x } => PropertyValue.HasPopup { value: x }
    PropertyValue.ListStyle { value: x } => PropertyValue.ListStyle { value: x }
    PropertyValue.TextAlign { value: x } => PropertyValue.TextAlign { value: x }
    PropertyValue.VerticalOffset { value: x } => PropertyValue.VerticalOffset { value: x }
    PropertyValue.Affine { value: x } => PropertyValue.Affine { value: x }
    PropertyValue.Rect { value: x } => PropertyValue.Rect { value: x }
    PropertyValue.TextSelection { value: x } => PropertyValue.TextSelection { value: x }
    PropertyValue.CustomActionVec { value: x } => PropertyValue.CustomActionVec {
      value: run copyCustomActions(x.asSlice()),
    }
    PropertyValue.TreeId { value: x } => PropertyValue.TreeId { value: x }
  }
}

effect fn copyList<T: Copy>(values: &[T]) -> List<T>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = run List<T>.makeWithCapacity(values.length)
  run out.appendSlice(values)
  return move out
}

effect fn copyCustomActions(values: &[CustomAction]) -> List<CustomAction>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = run List<CustomAction>.makeWithCapacity(values.length)
  let mut i: usize = 0
  while i < values.length {
    run out.append(run values[i].copy())
    i = i + 1
  }
  return move out
}

/// A node of an accessibility tree: a role, the actions it supports, flags, and a sparse set of
/// properties. Only the properties that were set take room.
pub struct Node {
  kind: Role,
  actions: u32,
  childActions: u32,
  flags: u32,
  indices: [u8; 87],
  values: List<PropertyValue>,
}

impl Node {
  /// A node of `role` with no properties.
  pub fn make(accessRole: Role) -> Node {
    return Node {
      kind: accessRole,
      actions: 0,
      childActions: 0,
      flags: 0,
      indices: [UNSET; 87],
      values: List<PropertyValue>.make(),
    }
  }

  /// A deep copy.
  pub effect fn copy(self: &Self) -> Node
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut values = run List<PropertyValue>.makeWithCapacity(self.values.length())
    let mut i: usize = 0
    while i < self.values.length() {
      run values.append(run copyValue(&self.values.asSlice()[i]))
      i = i + 1
    }
    return Node {
      kind: self.kind,
      actions: self.actions,
      childActions: self.childActions,
      flags: self.flags,
      indices: self.indices,
      values: move values,
    }
  }

  /// Whether both nodes have the same role, actions, flags and property values, whatever order
  /// the properties were set in. A cleared property equals one never set.
  pub fn equals(self: &Self, other: &Node) -> bool {
    if self.kind != other.kind || self.actions != other.actions
      || self.childActions != other.childActions
      || self.flags != other.flags {
      return false
    }
    let mut id: usize = 0
    while id < PROPERTY_COUNT {
      let a = self.indices[id]
      let b = other.indices[id]
      if a == UNSET {
        if b != UNSET && !isNone(&other.values.asSlice()[u8.toUsize(b)]) {
          return false
        }
      } else if b == UNSET {
        if !isNone(&self.values.asSlice()[u8.toUsize(a)]) {
          return false
        }
      } else if !valueEquals(
        &self.values.asSlice()[u8.toUsize(a)],
        &other.values.asSlice()[u8.toUsize(b)],
      ) {
        return false
      }
      id = id + 1
    }
    return true
  }

  fn slot(self: &Self, id: PropertyId) -> u8 {
    return self.indices[u8.toUsize(PropertyId.value(id))]
  }

  effect fn put(self: &mut Self, id: PropertyId, value: PropertyValue) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let index = self.slot(id)
    if index == UNSET {
      self.indices[u8.toUsize(PropertyId.value(id))] = usize.toU8(self.values.length())
      run self.values.append(move value)
    } else {
      self.values.set(u8.toUsize(index), move value)
    }
  }

  fn clearProperty(self: &mut Self, id: PropertyId) -> () {
    let index = self.slot(id)
    if index != UNSET {
      self.values.set(u8.toUsize(index), PropertyValue.None)
    }
  }

  pub fn accessRole(self: &Self) -> Role {
    return self.kind
  }

  pub fn setAccessRole(self: &mut Self, value: Role) -> () {
    self.kind = value
  }

  /// The mask of every supported action.
  pub fn actionMask(self: &Self) -> u32 {
    return self.actions
  }

  pub fn supportsAction(self: &Self, action: Action) -> bool {
    return (self.actions & action.mask()) != 0
  }

  pub fn addAction(self: &mut Self, action: Action) -> () {
    self.actions = self.actions | action.mask()
  }

  pub fn removeAction(self: &mut Self, action: Action) -> () {
    self.actions = self.actions & ~action.mask()
  }

  pub fn clearActions(self: &mut Self) -> () {
    self.actions = 0
  }

  /// Whether the children of this node support `action`, which saves setting it on each.
  pub fn childSupportsAction(self: &Self, action: Action) -> bool {
    return (self.childActions & action.mask()) != 0
  }

  pub fn addChildAction(self: &mut Self, action: Action) -> () {
    self.childActions = self.childActions | action.mask()
  }

  pub fn removeChildAction(self: &mut Self, action: Action) -> () {
    self.childActions = self.childActions & ~action.mask()
  }

  pub fn clearChildActions(self: &mut Self) -> () {
    self.childActions = 0
  }

  /// Whether this node and its descendants are excluded from the tree
  /// presented to assistive technologies and from hit testing. ARIA
  /// equivalent: [`aria-hidden`].
  ///
  /// **Difference with ARIA:** `aria-hidden` controls exposure to assistive
  /// technologies, while this property also excludes the node from hit
  /// testing.
  ///
  /// [`aria-hidden`]: https://www.w3.org/TR/wai-aria-1.2/#aria-hidden
  pub fn isHidden(self: &Self) -> bool {
    return (self.flags & flagMask(Flag.Hidden)) != 0
  }

  pub fn setHidden(self: &mut Self) -> () {
    self.flags = self.flags | flagMask(Flag.Hidden)
  }

  pub fn clearHidden(self: &mut Self) -> () {
    self.flags = self.flags & ~flagMask(Flag.Hidden)
  }

  /// Whether users may select more than one selectable descendant. ARIA
  /// equivalent: [`aria-multiselectable`].
  ///
  /// [`aria-multiselectable`]: https://www.w3.org/TR/wai-aria-1.2/#aria-multiselectable
  pub fn isMultiselectable(self: &Self) -> bool {
    return (self.flags & flagMask(Flag.Multiselectable)) != 0
  }

  pub fn setMultiselectable(self: &mut Self) -> () {
    self.flags = self.flags | flagMask(Flag.Multiselectable)
  }

  pub fn clearMultiselectable(self: &mut Self) -> () {
    self.flags = self.flags & ~flagMask(Flag.Multiselectable)
  }

  /// Whether user input or selection is required on this node. ARIA
  /// equivalent: [`aria-required`].
  ///
  /// [`aria-required`]: https://www.w3.org/TR/wai-aria-1.2/#aria-required
  pub fn isRequired(self: &Self) -> bool {
    return (self.flags & flagMask(Flag.Required)) != 0
  }

  pub fn setRequired(self: &mut Self) -> () {
    self.flags = self.flags | flagMask(Flag.Required)
  }

  pub fn clearRequired(self: &mut Self) -> () {
    self.flags = self.flags & ~flagMask(Flag.Required)
  }

  /// Whether this node represents a link that has been visited.
  pub fn isVisited(self: &Self) -> bool {
    return (self.flags & flagMask(Flag.Visited)) != 0
  }

  pub fn setVisited(self: &mut Self) -> () {
