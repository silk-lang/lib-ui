    }
    return match &self.values.asSlice()[u8.toUsize(index)] {
      PropertyValue.NodeIdVec { value } => value.asSlice()
      _ => &[]
    }
  }

  pub effect fn setControls(self: &mut Self, value: &[NodeId]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.put(
      PropertyId.Controls,
      PropertyValue.NodeIdVec { value: run copyList<NodeId>(value) },
    )
  }

  pub effect fn pushControlled(self: &mut Self, item: NodeId) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
