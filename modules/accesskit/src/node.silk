  }

  /// Whether updates to this live region should be presented as a whole. ARIA
  /// equivalent: [`aria-atomic`].
  ///
  /// [`aria-atomic`]: https://www.w3.org/TR/wai-aria-1.2/#aria-atomic
  pub fn isLiveAtomic(self: &Self) -> bool {
    return (self.flags & flagMask(Flag.LiveAtomic)) != 0
  }

  pub fn setLiveAtomic(self: &mut Self) -> () {
    self.flags = self.flags | flagMask(Flag.LiveAtomic)
