//! The byte records the Silk side sends to the UI Automation side, one per element.
//!
//! A record is a run of fields, each a one-byte tag followed by its payload, little-endian and
//! unaligned. `native/uia.c` reads the same layout; keep the two in step.
//!
//! | tag | field | payload |
//! |-----|-------|---------|
//! | 1 | property | u32 UIA property id, then a value |
//! | 2 | patterns | u32, the `PATTERN_` bits |
//! | 3 | bounds | 4 f64: x0, y0, x1, y1 in tree coordinates |
//! | 4 | parent | u64 |
//! | 5 | children | ids |
//! | 6 | selection container | u64 |
//! | 7 | selected items | ids |
//! | 8 | controlled elements | ids |
//! | 9 | flags | u32, the `FLAG_` bits |
//! | 10 | text | the text block below |
//!
//! A value is a kind byte and its payload: 0 empty, 1 boolean (u8), 2 i32, 3 f64, 4 text (u32
//! byte length and UTF-8). Ids are a u32 count and that many u64 ids.
//!
//! The text block: the text; its UTF-16 length (u32); whether there is a selection (u8) and its
//! anchor and focus (2 u32); the characters (u32 count, then a UTF-16 start and end and 4 f64
//! bounds each); the word starts, the line starts and the paragraph starts (each a u32 count and
//! that many UTF-16 offsets); the format runs (u32 count, then a UTF-16 start and end per run and
//! its text attributes: a u32 count, then a u32 UIA text attribute id and a value each).
import accesskit.lib { Rect }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64
import silk.num.i32
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize
import silk.text.string { String }

pub fn TAG_PROPERTY() -> u8 { return 1 }
pub fn TAG_PATTERNS() -> u8 { return 2 }
pub fn TAG_BOUNDS() -> u8 { return 3 }
pub fn TAG_PARENT() -> u8 { return 4 }
pub fn TAG_CHILDREN() -> u8 { return 5 }
pub fn TAG_SELECTION_CONTAINER() -> u8 { return 6 }
pub fn TAG_SELECTED() -> u8 { return 7 }
pub fn TAG_CONTROLS() -> u8 { return 8 }
pub fn TAG_FLAGS() -> u8 { return 9 }
pub fn TAG_TEXT() -> u8 { return 10 }

pub fn PATTERN_TOGGLE() -> u32 { return 1 }
pub fn PATTERN_INVOKE() -> u32 { return 2 }
pub fn PATTERN_VALUE() -> u32 { return 4 }
pub fn PATTERN_RANGE_VALUE() -> u32 { return 8 }
pub fn PATTERN_SCROLL_ITEM() -> u32 { return 16 }
pub fn PATTERN_SELECTION_ITEM() -> u32 { return 32 }
pub fn PATTERN_SELECTION() -> u32 { return 64 }
pub fn PATTERN_TEXT() -> u32 { return 128 }
pub fn PATTERN_EXPAND_COLLAPSE() -> u32 { return 256 }
pub fn PATTERN_WINDOW() -> u32 { return 512 }

/// The tree's root.
pub fn FLAG_ROOT() -> u32 { return 1 }
/// The record has a parent field.
pub fn FLAG_HAS_PARENT() -> u32 { return 2 }
/// The record has bounds.
pub fn FLAG_HAS_BOUNDS() -> u32 { return 4 }
/// The node is disabled: actions fail with `UIA_E_ELEMENTNOTENABLED`.
pub fn FLAG_DISABLED() -> u32 { return 8 }
/// The node can take keyboard focus.
pub fn FLAG_FOCUSABLE() -> u32 { return 16 }
/// The node is expanded; with `FLAG_COLLAPSED` clear too, it neither expands nor collapses.
pub fn FLAG_EXPANDED() -> u32 { return 32 }
/// The node is collapsed.
pub fn FLAG_COLLAPSED() -> u32 { return 64 }
/// The node is selected, as `SelectionItem.IsSelected` reports.
pub fn FLAG_SELECTED() -> u32 { return 128 }
/// The node's text is read-only.
pub fn FLAG_READ_ONLY() -> u32 { return 256 }

/// A UI Automation value, as a record carries it.
pub union Value {
  Empty,
  Bool { pub value: bool },
  Int { pub value: i32 },
  Number { pub value: f64 },
  Text { pub value: String },
}

impl Value {
  pub fn equals(self: &Self, other: &Value) -> bool {
    return match &self.* {
      Value.Empty => match &other.* {
        Value.Empty => true
        _ => false
      }
      Value.Bool { value } => match &other.* {
        Value.Bool { value: theirs } => value == theirs
        _ => false
      }
      Value.Int { value } => match &other.* {
        Value.Int { value: theirs } => value == theirs
        _ => false
      }
      Value.Number { value } => match &other.* {
        Value.Number { value: theirs } => value == theirs
        _ => false
      }
      Value.Text { value } => match &other.* {
        Value.Text { value: theirs } => value.view() == theirs.view()
        _ => false
      }
    }
  }

  pub effect fn copy(self: &Self) -> Value
    ! OutOfMemoryError
    ? &mut Allocator {
    return match &self.* {
      Value.Empty => Value.Empty
      Value.Bool { value } => Value.Bool { value: value }
      Value.Int { value } => Value.Int { value: value }
      Value.Number { value } => Value.Number { value: value }
      Value.Text { value } => Value.Text { value: run String.copy(value.view()) }
    }
  }

  pub fn isEmpty(self: &Self) -> bool {
    return match &self.* {
      Value.Empty => true
      _ => false
    }
  }
}


/// A record being written.
pub struct Record {
  bytes: List<u8>,
}

impl Record {
  pub fn make() -> Record {
    return Record { bytes: List<u8>.make() }
  }

  pub fn asSlice(self: &Self) -> &[u8] {
    return self.bytes.asSlice()
  }

  pub fn length(self: &Self) -> usize {
    return self.bytes.length()
  }

  pub fn clear(self: &mut Self) -> () {
    self.bytes.clear()
  }

  pub effect fn byte(self: &mut Self, value: u8) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.bytes.append(value)
  }

  effect fn little(self: &mut Self, value: u64, count: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut rest = value
    let mut i: usize = 0
    while i < count {
      run self.bytes.append(u64.wrappingToU8(rest & 255))
      rest = u64.shiftRight(rest, 8)
      i = i + 1
    }
  }

  pub effect fn uint32(self: &mut Self, value: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.little(u32.toU64(value), 4)
  }

  pub effect fn uint64(self: &mut Self, value: u64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.little(value, 8)
  }

  pub effect fn double(self: &mut Self, value: f64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.little(f64.toBits(value), 8)
  }

  pub effect fn raw(self: &mut Self, values: &[u8]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.bytes.appendBytes(values)
  }

  pub effect fn index(self: &mut Self, value: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.uint32(usize.wrappingToU32(value))
  }

  pub effect fn text(self: &mut Self, value: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let bytes = String.utf8Bytes(value)
    run self.index(bytes.length)
    run self.bytes.appendBytes(bytes)
  }

  pub effect fn rect(self: &mut Self, value: Rect) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.double(value.x0)
    run self.double(value.y0)
    run self.double(value.x1)
    run self.double(value.y1)
  }

  pub effect fn ids(self: &mut Self, values: &List<u64>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.index(values.length())
    let mut i: usize = 0
    while i < values.length() {
      run self.uint64(values.get(i))
      i = i + 1
    }
  }

  pub effect fn textField(self: &mut Self, tag: u8, value: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.byte(tag)
    run self.text(value)
  }

  pub effect fn numberField(self: &mut Self, tag: u8, value: f64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.byte(tag)
    run self.double(value)
  }

  pub effect fn idsField(self: &mut Self, tag: u8, values: &List<u64>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.byte(tag)
    run self.ids(values)
  }
}

/// A 64-bit FNV-1a hash of `bytes`, which tells whether a record changed.
pub fn fingerprint(bytes: &[u8]) -> u64 {
  let mut hash: u64 = 14695981039346656037
  let mut i: usize = 0
  while i < bytes.length {
    hash = u64.wrappingMultiply(hash ^ u8.toU64(bytes[i]), 1099511628211)
    i = i + 1
  }
  return hash
}

fn clamp(value: usize, limit: usize) -> usize {
  if value > limit {
    return limit
  }
  return value
}

/// Reads a record, for tests and tools.
pub struct Reader<'a> {
  data: &'a [u8],
  at: usize,
}

impl<'a> Reader<'a> {
  pub fn make(data: &'a [u8]) -> Reader<'a> {
    return Reader { data: data, at: 0 }
  }

  pub fn atEnd(self: &Self) -> bool {
    return self.at >= self.data.length
  }

  pub fn byte(self: &mut Self) -> u8 {
    if self.at >= self.data.length {
      return 0
    }
    let value = self.data[self.at]
    self.at = self.at + 1
    return value
  }

  fn little(self: &mut Self, count: usize) -> u64 {
    let mut value: u64 = 0
    let mut i: usize = 0
    while i < count {
      value = value | u64.shiftLeft(u8.toU64(self.byte()), usize.toU64(i * 8))
      i = i + 1
    }
    return value
  }

  pub fn uint32(self: &mut Self) -> u32 {
    return u64.wrappingToU32(self.little(4))
  }

  pub fn uint64(self: &mut Self) -> u64 {
    return self.little(8)
  }

  pub fn double(self: &mut Self) -> f64 {
    return f64.fromBits(self.little(8))
  }

  pub fn text(self: &mut Self) -> string<'a> {
    let length = u32.toUsize(self.uint32())
    let start = self.at
    let end = clamp(start + length, self.data.length)
    self.at = end
    return String.fromUtf8(Slice.view<u8>(self.data, start, end - start)).unwrapOr("")
  }

  pub fn skip(self: &mut Self, count: usize) -> () {
    self.at = clamp(self.at + count, self.data.length)
  }

  /// Skips a value.
  pub fn skipValue(self: &mut Self) -> () {
    let kind = self.byte()
    if kind == 1 {
      self.skip(1)
    } else if kind == 2 {
      self.skip(4)
    } else if kind == 3 {
      self.skip(8)
    } else if kind == 4 {
      drop self.text()
    }
  }

  /// Skips the payload of a field with `tag`.
  pub fn skipField(self: &mut Self, tag: u8) -> () {
    if tag == TAG_PROPERTY() {
      self.skip(4)
      self.skipValue()
    } else if tag == TAG_PATTERNS() || tag == TAG_FLAGS() {
      self.skip(4)
    } else if tag == TAG_BOUNDS() {
      self.skip(32)
    } else if tag == TAG_PARENT() || tag == TAG_SELECTION_CONTAINER() {
      self.skip(8)
    } else if tag == TAG_CHILDREN() || tag == TAG_SELECTED() || tag == TAG_CONTROLS() {
      let count = u32.toUsize(self.uint32())
      self.skip(count * 8)
    } else {
      self.at = self.data.length
    }
  }
}

impl Record {
  /// Writes `value`: its kind and payload.
  pub effect fn value(self: &mut Self, value: &Value) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    match &value.* {
      Value.Empty => run self.byte(0)
      Value.Bool { value: flag } => {
        run self.byte(1)
        run self.byte(
          if flag {
            1
          } else {
            0
          },
        )
      }
      Value.Int { value: number } => {
        run self.byte(2)
        run self.uint32(i32.wrappingToU32(number))
      }
      Value.Number { value: number } => {
        run self.byte(3)
        run self.double(number)
      }
      Value.Text { value: text } => {
        run self.byte(4)
        run self.text(text.view())
      }
    }
  }

  /// Writes property `id` with `value`.
  pub effect fn property(self: &mut Self, id: i32, value: &Value) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.byte(TAG_PROPERTY())
    run self.uint32(i32.wrappingToU32(id))
    run self.value(value)
  }
}

/// The value of property `id` in `record`, if it carries one.
pub effect fn findProperty(record: &[u8], id: i32) -> Option<Value>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut reader = Reader.make(record)
  while !reader.atEnd() {
    let tag = reader.byte()
    if tag == TAG_PROPERTY() && u32.wrappingToI32(reader.uint32()) == id {
      let kind = reader.byte()
      return Option.Some {
        value: if kind == 1 {
          Value.Bool { value: reader.byte() != 0 }
        } else if kind == 2 {
          Value.Int { value: u32.wrappingToI32(reader.uint32()) }
        } else if kind == 3 {
          Value.Number { value: reader.double() }
        } else if kind == 4 {
          Value.Text { value: run String.copy(reader.text()) }
        } else {
          Value.Empty
        },
      }
    }
    if tag == TAG_PROPERTY() {
      reader.skipValue()
    } else {
      reader.skipField(tag)
    }
  }
  return Option.None
}

/// The u32 field `tag` (patterns or flags) of `record`.
pub fn findBits(record: &[u8], tag: u8) -> u32 {
  let mut reader = Reader.make(record)
  while !reader.atEnd() {
    let at = reader.byte()
    if at == tag {
      return reader.uint32()
    }
    reader.skipField(at)
  }
  return 0
}

/// The ids field `tag` of `record`, appended to `out`; false when absent.
pub effect fn findIds(record: &[u8], tag: u8, out: &mut List<u64>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut reader = Reader.make(record)
  while !reader.atEnd() {
    let at = reader.byte()
    if at == tag {
      let count = u32.toUsize(reader.uint32())
      let mut i: usize = 0
      while i < count {
        run out.append(reader.uint64())
        i = i + 1
      }
      return true
    }
    reader.skipField(at)
  }
  return false
}
