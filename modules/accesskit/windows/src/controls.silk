    Role.MenuBar => 50010
    Role.MenuItemCheckBox => 50002
    Role.MenuItemRadio => 50013
    Role.MenuListPopup => 50008
    Role.Meter => 50012
    Role.Navigation => 50026
    Role.Note => 50026
