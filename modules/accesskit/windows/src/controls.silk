/// The ARIA role UI Automation reports for `kind`, if any.
pub fn ariaRoleOf(kind: Role) -> Option<string<'static>> {
  return match kind {
    Role.Alert => Option.Some { value: "alert" }
    Role.AlertDialog => Option.Some { value: "alertdialog" }
    Role.Application => Option.Some { value: "application" }
    Role.Article => Option.Some { value: "article" }
    Role.Banner => Option.Some { value: "banner" }
    Role.Header => Option.Some { value: "banner" }
    Role.Button => Option.Some { value: "button" }
    Role.DefaultButton => Option.Some { value: "button" }
    Role.Blockquote => Option.Some { value: "blockquote" }
    Role.Caption => Option.Some { value: "caption" }
    Role.FigureCaption => Option.Some { value: "caption" }
    Role.Cell => Option.Some { value: "cell" }
    Role.CheckBox => Option.Some { value: "checkbox" }
    Role.Code => Option.Some { value: "code" }
    Role.ColumnHeader => Option.Some { value: "columnheader" }
    Role.ComboBox => Option.Some { value: "combobox" }
    Role.EditableComboBox => Option.Some { value: "combobox" }
    Role.Comment => Option.Some { value: "comment" }
    Role.Complementary => Option.Some { value: "complementary" }
    Role.ContentInfo => Option.Some { value: "contentinfo" }
    Role.Footer => Option.Some { value: "contentinfo" }
    Role.Definition => Option.Some { value: "definition" }
    Role.ContentDeletion => Option.Some { value: "deletion" }
    Role.Dialog => Option.Some { value: "dialog" }
