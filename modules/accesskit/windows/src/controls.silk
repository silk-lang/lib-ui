import accesskit.lib { Role }
import silk.core.option { Option }

/// The UI Automation control type of `kind` (a `UIA_...ControlTypeId`).
pub fn controlTypeOf(kind: Role) -> i32 {
  return match kind {
    Role.AlertDialog => 50032
    Role.Dialog => 50032
    Role.RubyAnnotation => 50020
    Role.Window => 50032
    Role.Unknown => 50025
    Role.TextRun => 50025
    Role.Cell => 50029
    Role.GridCell => 50029
