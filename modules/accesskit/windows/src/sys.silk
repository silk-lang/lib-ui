//! The C functions of `native/uia.c`, on Windows only.
static if Intrinsic.targetOperatingSystem() == "windows" {
  pub unsafe extern "C" fn silk_ak_win_attach(hwnd: u64) -> u64
  pub unsafe extern "C" fn silk_ak_win_attach_test() -> u64
  pub unsafe extern "C" fn silk_ak_win_detach(handle: u64) -> ()
  pub unsafe extern "C" fn silk_ak_win_set_node(
    handle: u64,
    id: u64,
    record: ?[*]const u8,
    length: usize,
  ) -> ()
  pub unsafe extern "C" fn silk_ak_win_remove_node(handle: u64, id: u64) -> ()
  pub unsafe extern "C" fn silk_ak_win_set_root(handle: u64, id: u64) -> ()
  pub unsafe extern "C" fn silk_ak_win_set_focus(handle: u64, has: u32, id: u64) -> ()
  pub unsafe extern "C" fn silk_ak_win_raise_event(handle: u64, id: u64, event: i32) -> ()
  pub unsafe extern "C" fn silk_ak_win_raise_property(
    handle: u64,
    id: u64,
    property: i32,
    old: ?[*]const u8,
    oldLength: usize,
    new: ?[*]const u8,
    newLength: usize,
  ) -> ()
  pub unsafe extern "C" fn silk_ak_win_poll(
    handle: u64,
    id: *mut u64,
    number: *mut f64,
    start: *mut u32,
    end: *mut u32,
  ) -> u32
  pub unsafe extern "C" fn silk_ak_win_action_text(
    handle: u64,
    output: ?[*]mut u8,
    capacity: usize,
  ) -> usize
  pub unsafe extern "C" fn silk_ak_win_describe(
    handle: u64,
    id: u64,
    output: ?[*]mut u8,
    capacity: usize,
  ) -> usize
  pub unsafe extern "C" fn silk_ak_win_perform(handle: u64, id: u64, kind: u32) -> u32
}

/// Whether this build talks to UI Automation.
pub fn supported() -> bool {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return true
  } else {
    return false
  }
}
