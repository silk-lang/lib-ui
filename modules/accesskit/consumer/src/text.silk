  pub effect fn isItalic(self: &Self) -> RangeValue<bool>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut nodes = List<NodeRef<'a>>.make()
    run self.runs(&mut nodes)
    let first = nodes.get(0).isItalic()
    let mut i: usize = 1
    while i < nodes.length() {
      if nodes.get(i).isItalic() != first {
        return RangeValue.Mixed
      }
      i = i + 1
    }
    return RangeValue.Single { value: first }
  }

  pub fn equals(self: &Self, other: &Range<'_>) -> bool {
    return self.node.id.equals(other.node.id) && self.start.equals(&other.start)
      && self.end.equals(&other.end)
  }
}

struct WalkBounds<'a> {
  first: NodeRef<'a>,
  last: NodeRef<'a>,
}

impl<'a> Copy for WalkBounds<'a> {}

/// A range that names its node and endpoints by id, so it outlives a tree state.
pub struct WeakRange {
  pub nodeId: FullNodeId,
  pub start: WeakPosition,
  pub end: WeakPosition,
  startPath: List<usize>,
  startIndex: usize,
  endPath: List<usize>,
  endIndex: usize,
}

impl WeakRange {
  /// The text node, if it still supports text ranges.
  pub fn upgradeNode<'a>(self: &Self, treeState: &'a TreeState) -> Option<NodeRef<'a>> {
    return match treeState.nodeById(self.nodeId) {
      Option.Some { value } => if value.supportsTextRanges() {
        Option.Some { value: value }
      } else {
        Option.None
      }
      Option.None => Option.None
    }
  }

  /// The range in `treeState`, if its node and endpoints still exist.
  pub fn upgrade<'a>(self: &Self, treeState: &'a TreeState) -> Option<Range<'a>> {
    let node = match self.upgradeNode(treeState) {
      Option.Some { value } => value
      Option.None => {
        return Option.None
      }
    }
    let start = match InnerPosition.upgrade(treeState, self.start, self.nodeId) {
      Option.Some { value } => value
      Option.None => {
        return Option.None
      }
    }
    let end = match InnerPosition.upgrade(treeState, self.end, self.nodeId) {
      Option.Some { value } => value
      Option.None => {
        return Option.None
      }
    }
    return Option.Some { value: Range { node: node, start: start, end: end } }
  }

  /// The order of this range's start and `other`'s start (`startOfOther`) or end.
  pub fn compareEndpoints(self: &Self, ownStart: bool, other: &WeakRange, otherStart: bool) -> i32 {
    let a = if ownStart {
      self.startPath.asSlice()
    } else {
      self.endPath.asSlice()
    }
    let ai = if ownStart {
      self.startIndex
    } else {
      self.endIndex
    }
    let b = if otherStart {
      other.startPath.asSlice()
    } else {
      other.endPath.asSlice()
    }
    let bi = if otherStart {
      other.startIndex
    } else {
      other.endIndex
    }
    let mut i: usize = 0
    while i < a.length && i < b.length {
      if a[i] != b[i] {
        return compareUsize(a[i], b[i])
      }
      i = i + 1
    }
    if a.length != b.length {
      return compareUsize(a.length, b.length)
    }
    return compareUsize(ai, bi)
  }

  pub effect fn copy(self: &Self) -> WeakRange
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut startPath = List<usize>.make()
    run startPath.appendSlice(self.startPath.asSlice())
    let mut endPath = List<usize>.make()
    run endPath.appendSlice(self.endPath.asSlice())
    return WeakRange {
      nodeId: self.nodeId,
      start: self.start,
      end: self.end,
      startPath: move startPath,
      startIndex: self.startIndex,
      endPath: move endPath,
      endIndex: self.endIndex,
    }
  }
}

struct CharacterMetrics<'a> {
  positions: &'a [f32],
  widths: &'a [f32],
  isPassword: bool,
}

impl<'a> Copy for CharacterMetrics<'a> {}

impl<'a> CharacterMetrics<'a> {
  fn make(node: &NodeRef<'a>, root: &NodeRef<'_>) -> Option<CharacterMetrics<'a>> {
    let positions = match node.data().characterPositions() {
      Option.Some { value } => value
      Option.None => {
        return Option.None
      }
    }
    let widths = match node.data().characterWidths() {
      Option.Some { value } => value
      Option.None => {
        return Option.None
      }
    }
    return Option.Some {
      value: CharacterMetrics {
        positions: positions,
        widths: widths,
        isPassword: root.isPasswordInput(),
      },
    }
  }

  fn length(self: &Self) -> usize {
    if self.positions.length < self.widths.length {
      return self.positions.length
    }
    return self.widths.length
  }

  fn position(self: &Self, index: usize) -> f32 {
    if self.isPassword {
      let step = if self.positions.length >= 2 {
        self.positions[1] - self.positions[0]
      } else {
        self.widths[0]
      }
      return self.positions[0] + usize.toF32(index) * step
    }
    return self.positions[index]
  }

  fn width(self: &Self, index: usize) -> f32 {
    if self.isPassword {
      return self.widths[0]
    }
    return self.widths[index]
  }
}

/// The character of text run `node` at `point` (in its coordinates), or its length past the end.
pub fn characterIndexAtPoint(node: &NodeRef<'_>, root: &NodeRef<'_>, point: Point) -> usize {
  let rect = node.data().bounds().unwrapOr(Rect.zero())
  let length = node.data().characterLengths().length
  let metrics = match CharacterMetrics.make(node, root) {
    Option.Some { value } => value
    Option.None => {
      return 0
    }
  }
  let direction = match node.textDirection() {
    Option.Some { value } => value
    Option.None => {
      return 0
    }
  }
  let mut i = metrics.length()
  while i > 0 {
    i = i - 1
    let position = f32.toF64(metrics.position(i))
    let width = f32.toF64(metrics.width(i))
    let relative = match direction {
      TextDirection.LeftToRight => point.x - rect.x0
      TextDirection.RightToLeft => rect.x1 - point.x
      TextDirection.TopToBottom => point.y - rect.y0
      TextDirection.BottomToTop => rect.y1 - point.y
    }
    if relative >= position && relative < position + width {
      return i
    }
  }
  return length
}

/// Where a binary search ended: `index` of the value, or where it would go.
pub struct SearchResult {
  pub found: bool,
  pub index: usize,
}

impl Copy for SearchResult {}

/// Searches sorted `values` for `target`.
pub fn binarySearch(values: &[u8], target: usize) -> SearchResult {
  let mut low: usize = 0
  let mut high = values.length
  while low < high {
    let mid = low + (high - low) / 2
    let v = u8.toUsize(values[mid])
    if v == target {
      return SearchResult { found: true, index: mid }
    }
    if v < target {
      low = mid + 1
    } else {
      high = mid
    }
  }
  return SearchResult { found: false, index: low }
}

/// The UTF-8 offset of character `index` of a run with these character lengths.
pub fn byteOffsetOfCharacter(lengths: &[u8], index: usize) -> usize {
  let mut total: usize = 0
  let mut i: usize = 0
  while i < index && i < lengths.length {
    total = total + u8.toUsize(lengths[i])
    i = i + 1
  }
  return total
}

/// The length of `text` in UTF-16 code units, or in Unicode scalar values.
pub fn unitCount(text: string, utf16: bool) -> usize {
  let mut count: usize = 0
  let mut cursor = String.scalarCursor()
  while let Option.Some { value: step } = String.nextScalar(text, move cursor) {
    let c = String.scalarValue(&step)
    if utf16 && u32.toUsize(char.toU32(c)) >= 65536 {
      count = count + 2
    } else {
      count = count + 1
    }
    cursor = String.nextCursor(move step)
  }
  return count
}

/// The text run filter as a cursor over the runs of `root`.
pub fn textRunsOf<'a>(root: &NodeRef<'a>) -> FilteredCursor<'a> {
  return root.filteredChildren(&TextRunFilter { root: root.id })
}
