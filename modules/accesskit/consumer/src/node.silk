  pub fn textAttributesDiffer(self: &Self, other: &NodeRef<'_>) -> bool {
    if !sameOption(
      match self.fontFamily() {
        Option.Some { value: x } => match other.fontFamily() {
          Option.Some { value: y } => x == y
          Option.None => false
        }
        Option.None => other.fontFamily().isNone()
      },
    ) {
      return true
    }
    if !sameOption(
      match self.language() {
        Option.Some { value: x } => match other.language() {
          Option.Some { value: y } => x == y
          Option.None => false
        }
        Option.None => other.language().isNone()
      },
    ) {
      return true
    }
    if !sameOption(
      match self.fontSize() {
        Option.Some { value: x } => match other.fontSize() {
          Option.Some { value: y } => x == y
          Option.None => false
        }
        Option.None => other.fontSize().isNone()
      },
    ) {
      return true
    }
    if !sameOption(
      match self.fontWeight() {
        Option.Some { value: x } => match other.fontWeight() {
          Option.Some { value: y } => x == y
          Option.None => false
        }
        Option.None => other.fontWeight().isNone()
      },
    ) {
      return true
    }
    if !sameOption(
      match self.backgroundColor() {
        Option.Some { value: x } => match other.backgroundColor() {
          Option.Some { value: y } => x.equals(y)
          Option.None => false
        }
        Option.None => other.backgroundColor().isNone()
      },
    ) {
      return true
    }
    if !sameOption(
      match self.foregroundColor() {
        Option.Some { value: x } => match other.foregroundColor() {
          Option.Some { value: y } => x.equals(y)
          Option.None => false
        }
        Option.None => other.foregroundColor().isNone()
      },
    ) {
      return true
    }
    if !sameOption(
      match self.overline() {
        Option.Some { value: x } => match other.overline() {
          Option.Some { value: y } => x.equals(y)
          Option.None => false
        }
        Option.None => other.overline().isNone()
      },
    ) {
      return true
    }
    if !sameOption(
      match self.strikethrough() {
        Option.Some { value: x } => match other.strikethrough() {
          Option.Some { value: y } => x.equals(y)
          Option.None => false
        }
        Option.None => other.strikethrough().isNone()
      },
    ) {
      return true
    }
    if !sameOption(
      match self.underline() {
        Option.Some { value: x } => match other.underline() {
          Option.Some { value: y } => x.equals(y)
          Option.None => false
        }
        Option.None => other.underline().isNone()
      },
    ) {
      return true
    }
    if !sameOption(
      match self.textAlign() {
        Option.Some { value: x } => match other.textAlign() {
          Option.Some { value: y } => x == y
          Option.None => false
        }
        Option.None => other.textAlign().isNone()
      },
    ) {
      return true
    }
    if !sameOption(
      match self.verticalOffset() {
        Option.Some { value: x } => match other.verticalOffset() {
          Option.Some { value: y } => x == y
          Option.None => false
        }
        Option.None => other.verticalOffset().isNone()
      },
    ) {
      return true
    }
    return false
  }

  /// A walk over this text node's text runs.
  pub fn textRuns(self: &Self) -> FilteredCursor<'a> {
    return self.filteredChildren(&TextRunFilter { root: self.id })
  }

  /// Whether a password input's text must be masked: its runs hold real characters, not
  /// bullets already.
  pub fn textRunsNeedMasking(self: &Self) -> bool {
    if !self.isPasswordInput() {
      return false
    }
    let filter = TextRunFilter { root: self.id }
    let mut runs = self.textRuns()
    let mut first: Option<char> = Option.None
    while let Option.Some { value: node } = runs.next(&filter) {
      let value = node.data().value().unwrapOr("")
      let mut cursor = String.scalarCursor()
      while let Option.Some { value: step } = String.nextScalar(value, move cursor) {
        let c = String.scalarValue(&step)
        match first {
          Option.Some { value: f } => {
            if f != c {
              return true
            }
          }
          Option.None => {
            first = Option.Some { value: c }
          }
        }
        cursor = String.nextCursor(move step)
      }
    }
    return false
  }

  /// Whether this node's text can be navigated by position: a text input, label, document or
  /// terminal with at least one text run.
  pub fn supportsTextRanges(self: &Self) -> bool {
    let kind = self.isTextInput() || self.accessRole() == Role.Label
      || self.accessRole() == Role.Document
      || self.accessRole() == Role.Terminal
    if !kind {
      return false
    }
    let filter = TextRunFilter { root: self.id }
    let mut runs = self.textRuns()
    return runs.next(&filter).isSome()
  }

  fn documentStartInner(self: &Self) -> InnerPosition<'a> {
    let filter = TextRunFilter { root: self.id }
    let mut runs = self.textRuns()
    return match runs.next(&filter) {
      Option.Some { value: node } => InnerPosition { node: node, characterIndex: 0 }
      Option.None => Intrinsic.trap("accesskit: the node has no text runs")
    }
  }

  fn documentEndInner(self: &Self) -> InnerPosition<'a> {
    let filter = TextRunFilter { root: self.id }
    let mut runs = self.textRuns()
    return match runs.nextBack(&filter) {
      Option.Some { value: node } => InnerPosition {
        node: node,
        characterIndex: node.data().characterLengths().length,
      }
      Option.None => Intrinsic.trap("accesskit: the node has no text runs")
    }
  }

  pub fn documentStart(self: &Self) -> Position<'a> {
    return Position { root: self.*, inner: self.documentStartInner() }
  }

  pub fn documentEnd(self: &Self) -> Position<'a> {
    return Position { root: self.*, inner: self.documentEndInner() }
  }

  pub fn documentRange(self: &Self) -> Range<'a> {
    return Range.make(self.*, self.documentStartInner(), self.documentEndInner())
  }

  pub fn hasTextSelection(self: &Self) -> bool {
    return self.data().textSelection().isSome()
  }

  pub fn textSelection(self: &Self) -> Option<Range<'a>> {
    return match self.data().textSelection() {
      Option.Some { value: selection } => {
        let anchor = InnerPosition.clampedUpgradePublic(self.treeState, selection.anchor, self.id)
        let focus = InnerPosition.clampedUpgradePublic(self.treeState, selection.focus, self.id)
        Option.Some { value: Range.make(self.*, anchor, focus) }
      }
      Option.None => Option.None
    }
  }

  pub fn textSelectionAnchor(self: &Self) -> Option<Position<'a>> {
    return match self.data().textSelection() {
      Option.Some { value: selection } => Option.Some {
        value: Position {
          root: self.*,
          inner: InnerPosition.clampedUpgradePublic(self.treeState, selection.anchor, self.id),
        },
      }
      Option.None => Option.None
    }
  }

  pub fn textSelectionFocus(self: &Self) -> Option<Position<'a>> {
    return match self.data().textSelection() {
      Option.Some { value: selection } => Option.Some {
        value: Position {
          root: self.*,
          inner: InnerPosition.clampedUpgradePublic(self.treeState, selection.focus, self.id),
        },
      }
      Option.None => Option.None
    }
  }

  /// The text position at `point`, in this node's coordinates.
  pub fn textPositionAtPoint(self: &Self, point: Point) -> Position<'a> {
    let filter = TextRunFilter { root: self.id }
    match self.hitTest(point, &filter) {
      Option.Some { value: hit } => {
        if hit.node.accessRole() == Role.TextRun {
          return Position {
            root: self.*,
            inner: InnerPosition {
              node: hit.node,
              characterIndex: characterIndexAtPoint(&hit.node, self, hit.point),
            },
          }
        }
      }
      Option.None => {}
    }
    let mut runs = self.textRuns()
    match runs.next(&filter) {
      Option.Some { value: node } => match node.boundingBoxInCoordinateSpace(self) {
        Option.Some { value: rect } => {
          if point.x < rect.x0 || point.y < rect.y0 {
            return self.documentStart()
          }
        }
        Option.None => {}
      }
      Option.None => {}
    }
    let mut back = self.textRuns()
    while let Option.Some { value: node } = back.nextBack(&filter) {
      match node.boundingBoxInCoordinateSpace(self) {
        Option.Some { value: rect } => match node.textDirection() {
          Option.Some { value: direction } => {
            let pastEnd = match direction {
              TextDirection.LeftToRight => point.y >= rect.y0 && point.y < rect.y1
                && point.x >= rect.x1
              TextDirection.RightToLeft => point.y >= rect.y0 && point.y < rect.y1
                && point.x < rect.x0
              TextDirection.TopToBottom => point.x >= rect.x0 && point.x < rect.x1
                && point.y >= rect.y1
              TextDirection.BottomToTop => point.x >= rect.x0 && point.x < rect.x1
                && point.y < rect.y0
            }
            if pastEnd {
              return Position {
                root: self.*,
                inner: InnerPosition {
                  node: node,
                  characterIndex: node.data().characterLengths().length,
                },
              }
            }
          }
          Option.None => {}
        }
        Option.None => {}
      }
    }
    return self.documentEnd()
  }

  /// The range of line `lineIndex`, counting from 0.
  pub fn lineRangeFromIndex(self: &Self, lineIndex: usize) -> Option<Range<'a>> {
    let mut pos = self.documentStart()
    if lineIndex > 0 {
      if pos.isDocumentEnd() || pos.forwardToLineEnd().isDocumentEnd() {
        return Option.None
      }
      let mut i: usize = 0
      while i < lineIndex {
        if pos.isDocumentEnd() {
          return Option.None
        }
        pos = pos.forwardToLineStart()
        i = i + 1
      }
    }
    let end = if pos.isDocumentEnd() {
      pos
    } else {
      pos.forwardToLineEnd()
    }
    return Option.Some { value: Range.make(self.*, pos.inner, end.inner) }
  }

  /// The position at offset `index` in Unicode scalar values.
  pub fn textPositionFromGlobalUsvIndex(self: &Self, index: usize) -> Option<Position<'a>> {
    return self.positionFromGlobalIndex(index, false)
  }

  /// The position at offset `index` in UTF-16 code units.
  pub fn textPositionFromGlobalUtf16Index(self: &Self, index: usize) -> Option<Position<'a>> {
    return self.positionFromGlobalIndex(index, true)
  }

  fn positionFromGlobalIndex(self: &Self, index: usize, utf16: bool) -> Option<Position<'a>> {
    let masked = self.textRunsNeedMasking()
    let filter = TextRunFilter { root: self.id }
    let mut total: usize = 0
    let mut runs = self.textRuns()
    while let Option.Some { value: node } = runs.next(&filter) {
      let lengths = node.data().characterLengths()
      if masked {
        let next = total + lengths.length
        if index >= total && index < next {
          return Option.Some {
            value: Position {
              root: self.*,
              inner: InnerPosition { node: node, characterIndex: index - total },
            },
          }
        }
        total = next
        continue
      }
      let text = node.data().value().unwrapOr("")
      let next = total + unitCount(text, utf16)
      if index >= total && index < next {
        let local = index - total
        let mut bytes: usize = 0
        let mut units: usize = 0
        let mut c: usize = 0
        while c < lengths.length {
          let charBytes = u8.toUsize(lengths[c])
          let charUnits = unitCount(String.slice(text, bytes, charBytes), utf16)
          if local >= units && local < units + charUnits {
            return Option.Some {
              value: Position {
                root: self.*,
                inner: InnerPosition { node: node, characterIndex: c },
              },
            }
          }
          bytes = bytes + charBytes
          units = units + charUnits
          c = c + 1
        }
        return Intrinsic.trap("accesskit: index out of range")
      }
      total = next
    }
    if index == total {
      return Option.Some { value: self.documentEnd() }
    }
    return Option.None
  }

  /// The nearest filtered ancestor that holds selectable children.
  pub fn selectionContainer<F: NodeFilter>(self: &Self, filter: &F) -> Option<NodeRef<'a>> {
    let mut current = self.parent()
    while let Option.Some { value: parent } = current {
      let result = filter.filter(&parent)
      if result == FilterResult.Include && parent.isContainerWithSelectableChildren() {
        return Option.Some { value: parent }
      }
      current = parent.parent()
    }
    return Option.None
  }

  /// Appends the item-like children (options, tabs, list items and so on) to `out`, looking
  /// through other included children.
  pub effect fn items<F: NodeFilter>(self: &Self, filter: &F, out: &mut List<NodeRef<'a>>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let itemFilter = ItemFilter<F> { inner: filter }
    run self.collectFilteredChildren(&itemFilter, &mut out)
  }
}

/// The node a hit test found, and the point in its coordinates.
pub struct HitTest<'a> {
  pub node: NodeRef<'a>,
  pub point: Point,
}

impl<'a> Copy for HitTest<'a> {}

struct DescendantLabelFilter {}

impl NodeFilter for DescendantLabelFilter {
  fn filter(self: &Self, node: &NodeRef<'_>) -> FilterResult {
    return match node.accessRole() {
      Role.Label => FilterResult.Include
      Role.Image => FilterResult.Include
      Role.GenericContainer => FilterResult.ExcludeNode
      _ => FilterResult.ExcludeSubtree
    }
  }
}

struct ItemFilter<'f, F> {
  inner: &'f F,
}

impl<'f, F: NodeFilter> NodeFilter for ItemFilter<'f, F> {
  fn filter(self: &Self, child: &NodeRef<'_>) -> FilterResult {
    let result = self.inner.filter(child)
    if result == FilterResult.Include {
      if child.isItemLike() {
        return FilterResult.Include
      }
      return FilterResult.ExcludeNode
    }
    return result
  }
}

/// The number of Unicode scalar values in `value`.
pub fn characterCount(value: string) -> usize {
  let mut count: usize = 0
  let mut cursor = String.scalarCursor()
  while let Option.Some { value: step } = String.nextScalar(value, move cursor) {
    count = count + 1
    cursor = String.nextCursor(move step)
  }
  return count
}

/// Whether `value` has at least two different characters.
pub fn hasDistinctCharacters(value: string) -> bool {
  let mut cursor = String.scalarCursor()
  let first = match String.nextScalar(value, move cursor) {
    Option.Some { value: step } => {
      let c = String.scalarValue(&step)
      cursor = String.nextCursor(move step)
      c
    }
    Option.None => {
      return false
    }
  }
  while let Option.Some { value: step } = String.nextScalar(value, move cursor) {
    if String.scalarValue(&step) != first {
      return true
    }
    cursor = String.nextCursor(move step)
  }
  return false
}

fn sameOption(value: bool) -> bool {
  return value
}
