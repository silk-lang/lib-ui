  pub fn isContainerWithSelectableChildren(self: &Self) -> bool {
    return match self.accessRole() {
      Role.ComboBox => true
      Role.EditableComboBox => true
      Role.Grid => true
      Role.ListBox => true
      Role.ListGrid => true
      Role.Menu => true
      Role.MenuBar => true
      Role.MenuListPopup => true
      Role.RadioGroup => true
      Role.TabList => true
      Role.Toolbar => true
      Role.Tree => true
      Role.TreeGrid => true
      _ => false
    }
