  /// The child indices from the root to this node.
  pub effect fn indexPath(self: &Self, out: &mut List<usize>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.relativeIndexPath(self.treeState.rootId(), &mut out)
  }

  /// The child indices from `ancestor` to this node.
  pub effect fn relativeIndexPath(self: &Self, ancestor: FullNodeId, out: &mut List<usize>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let start = out.length()
    let mut current: NodeRef<'a> = self.*
    while !current.id.equals(ancestor) {
      match current.state.parent {
        Option.Some { value: pi } => {
          run out.append(pi.index)
          current = match current.parent() {
            Option.Some { value } => value
            Option.None => Intrinsic.trap("accesskit: a parent is missing")
          }
        }
        Option.None => Intrinsic.trap("accesskit: the ancestor is not an ancestor")
      }
    }
    let mut a = start
    let mut b = out.length()
    while b > a + 1 {
      b = b - 1
      let x = out.get(a)
      let y = out.get(b)
      out.set(a, y)
      out.set(b, x)
      a = a + 1
    }
  }

  /// `textDirection` of this node or the nearest ancestor that sets it.
  pub fn textDirection(self: &Self) -> Option<TextDirection> {
    let mut current: Option<NodeRef<'a>> = Option.Some { value: self.* }
    while let Option.Some { value: node } = current {
      match node.data().textDirection() {
        Option.Some { value } => {
          return Option.Some { value: value }
        }
        Option.None => {}
      }
      current = node.parent()
    }
    return Option.None
  }

