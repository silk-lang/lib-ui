//! [`NodeRef`]: a node of a [`TreeState`] with its place in the tree, and what adapters ask of
//! it (names, values, states, navigation, hit testing).
//!
//! Ported from AccessKit (`accesskit_consumer/src/node.rs` and `iterators.rs`), Copyright 2021
//! The AccessKit Authors, under the MIT or Apache-2.0 license (see LICENSE-MIT and
//! LICENSE-APACHE).
import accesskit.lib {
  Action,
  Affine,
  AriaCurrent,
  HasPopup,
  Live,
  Node,
  NodeId,
  Orientation,
  Point,
  Rect,
  Role,
  SortDirection,
  TextSelection,
  Toggled,
  Color,
  TextAlign,
  TextDecoration,
  TextDirection,
  VerticalOffset,
}
import filters { FilterResult, NodeFilter, TextRunFilter }
import tree { TreeState, NodeState, FullNodeId, LocatedNode }
import text { InnerPosition, Position, Range, characterIndexAtPoint, unitCount }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.num.u8

/// U+2022 BULLET, which password inputs show for each character.
pub const PASSWORD_MASKING_CHARACTER: string<'static> = "\u{2022}"

/// A node of a tree state, valid while the state is borrowed.
pub struct NodeRef<'a> {
  pub treeState: &'a TreeState,
  pub id: FullNodeId,
  pub state: &'a NodeState,
}

impl<'a> Copy for NodeRef<'a> {}

/// A filtered walk over children or siblings, from both ends, as AccessKit's filtered
/// iterators. Call `next` or `nextBack` with the same filter until they return `None`.
pub struct FilteredCursor<'a> {
  front: Option<NodeRef<'a>>,
  back: Option<NodeRef<'a>>,
  done: bool,
  forward: bool,
}

impl<'a> Copy for FilteredCursor<'a> {}

impl<'a> FilteredCursor<'a> {
  fn make(front: Option<NodeRef<'a>>, back: Option<NodeRef<'a>>, forward: bool) -> FilteredCursor<
    'a
  > {
    return FilteredCursor {
      front: front,
      back: back,
      done: front.isNone() || back.isNone(),
      forward: forward,
    }
  }

  fn meet(self: &Self) -> bool {
    return match self.front {
      Option.Some { value: f } => match self.back {
        Option.Some { value: b } => f.id.equals(b.id)
        Option.None => true
      }
      Option.None => true
    }
  }

  /// The next node from the front.
  pub fn next<F: NodeFilter>(self: &mut Self, filter: &F) -> Option<NodeRef<'a>> {
    if self.done {
      return Option.None
    }
    self.done = self.meet()
    let current = self.front
    self.front = match current {
      Option.Some { value } => if self.forward {
        value.nextFilteredSibling(filter)
      } else {
        value.previousFilteredSibling(filter)
      }
      Option.None => Option.None
    }
    return current
  }

  /// The next node from the back.
  pub fn nextBack<F: NodeFilter>(self: &mut Self, filter: &F) -> Option<NodeRef<'a>> {
    if self.done {
      return Option.None
    }
    self.done = self.meet()
    let current = self.back
    self.back = match current {
      Option.Some { value } => if self.forward {
        value.previousFilteredSibling(filter)
      } else {
        value.nextFilteredSibling(filter)
      }
      Option.None => Option.None
    }
    return current
  }
}

impl<'a> NodeRef<'a> {
  /// The node's data, as the application last sent it.
  pub fn data(self: &Self) -> &'a Node {
    return &self.state.data
  }

  pub fn locate(self: &Self) -> LocatedNode {
    return match self.treeState.locateNode(self.id) {
      Option.Some { value } => value
      Option.None => Intrinsic.trap("accesskit: a node of the tree cannot be located")
    }
  }

  /// Whether this node has focus: the focused node without an active descendant, or the active
  /// descendant of the focused node. False while the host window does not have focus.
  pub fn isFocused(self: &Self) -> bool {
    return match self.treeState.focusId() {
      Option.Some { value: focusId } => {
        if focusId.equals(self.id) {
          match self.treeState.nodeById(focusId) {
            Option.Some { value: node } => node.activeDescendant().isNone()
            Option.None => true
          }
        } else {
          match self.treeState.nodeById(focusId) {
            Option.Some { value: focused } => match focused.activeDescendant() {
              Option.Some { value: active } => active.id.equals(self.id)
              Option.None => false
            }
            Option.None => false
          }
        }
      }
      Option.None => false
    }
  }

  /// Whether this is the node that has focus within the tree, whether or not the host does.
  pub fn isFocusedInTree(self: &Self) -> bool {
    return self.treeState.focusIdInTree().equals(self.id)
  }

  pub fn isFocusable<F: NodeFilter>(self: &Self, parentFilter: &F) -> bool {
    return self.supportsAction(Action.Focus, parentFilter) || self.isFocusedInTree()
  }

  pub fn isRoot(self: &Self) -> bool {
    return self.id.equals(self.treeState.rootId())
  }

  /// Whether this node hosts a subtree.
  pub fn isGraft(self: &Self) -> bool {
    return self.state.data.treeId().isSome()
  }

  pub fn parentId(self: &Self) -> Option<FullNodeId> {
    return match self.state.parent {
      Option.Some { value } => Option.Some { value: value.parent }
      Option.None => Option.None
    }
  }

  pub fn parent(self: &Self) -> Option<NodeRef<'a>> {
    return match self.state.parent {
      Option.Some { value } => self.treeState.nodeById(value.parent)
      Option.None => Option.None
    }
  }

  /// The index of this node among its parent's children.
  pub fn indexInParent(self: &Self) -> Option<usize> {
    return match self.state.parent {
      Option.Some { value } => Option.Some { value: value.index }
      Option.None => Option.None
    }
  }

  /// The nearest ancestor that `filter` includes.
  pub fn filteredParent<F: NodeFilter>(self: &Self, filter: &F) -> Option<NodeRef<'a>> {
    let mut current = self.parent()
    while let Option.Some { value: node } = current {
      if filter.filter(&node) == FilterResult.Include {
        return Option.Some { value: node }
      }
      current = node.parent()
    }
    return Option.None
  }

  fn graftChildId(self: &Self) -> Option<FullNodeId> {
    return match self.state.data.treeId() {
      Option.Some { value } => self.treeState.subtreeRoot(value)
      Option.None => Option.None
    }
  }

  /// The number of children: the subtree's root for a graft node.
  pub fn childCount(self: &Self) -> usize {
    if self.isGraft() {
      return if self.graftChildId().isSome() {
        1
      } else {
        0
      }
    }
    return self.state.data.children().length
  }

  /// The id of child `index`.
  pub fn childIdAt(self: &Self, index: usize) -> Option<FullNodeId> {
    if self.isGraft() {
      if index == 0 {
        return self.graftChildId()
      }
      return Option.None
    }
    let children = self.state.data.children()
    if index >= children.length {
      return Option.None
    }
    return Option.Some { value: self.id.withSameTree(children[index]) }
  }

  /// Child `index`.
  pub fn childAt(self: &Self, index: usize) -> Option<NodeRef<'a>> {
    return match self.childIdAt(index) {
      Option.Some { value } => self.treeState.nodeById(value)
      Option.None => Option.None
    }
  }

  pub fn firstChild(self: &Self) -> Option<NodeRef<'a>> {
    return self.childAt(0)
  }

  pub fn lastChild(self: &Self) -> Option<NodeRef<'a>> {
    let count = self.childCount()
    if count == 0 {
      return Option.None
    }
    return self.childAt(count - 1)
  }

  /// Appends the children to `out`.
  pub effect fn children(self: &Self, out: &mut List<NodeRef<'a>>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let count = self.childCount()
    let mut i: usize = 0
    while i < count {
      match self.childAt(i) {
        Option.Some { value } => run out.append(value)
        Option.None => {}
      }
      i = i + 1
    }
  }

  /// The next sibling, unfiltered. Subtree roots have none.
  pub fn followingSibling(self: &Self) -> Option<NodeRef<'a>> {
    return match self.state.parent {
      Option.Some { value: pi } => match self.treeState.nodeById(pi.parent) {
        Option.Some { value: parent } => if !parent.isGraft() {
          parent.childAt(pi.index + 1)
        } else {
          Option.None
        }
        Option.None => Option.None
      }
      Option.None => Option.None
    }
  }

  /// The previous sibling, unfiltered.
  pub fn precedingSibling(self: &Self) -> Option<NodeRef<'a>> {
    return match self.state.parent {
      Option.Some { value: pi } => match self.treeState.nodeById(pi.parent) {
        Option.Some { value: parent } => if !parent.isGraft() && pi.index > 0 {
          parent.childAt(pi.index - 1)
        } else {
          Option.None
        }
        Option.None => Option.None
      }
      Option.None => Option.None
    }
  }

  /// The next node after this one in a filtered walk of the same parent: it goes into excluded
  /// nodes and back out of excluded parents.
  pub fn nextFilteredSibling<F: NodeFilter>(self: &Self, filter: &F) -> Option<NodeRef<'a>> {
    let mut current: NodeRef<'a> = self.*
    let mut considerChildren = false
    while true {
      let child: Option<NodeRef<'a>> = if considerChildren {
        current.firstChild()
      } else {
        Option.None
      }
      match child {
        Option.Some { value: c } => {
          let result = filter.filter(&c)
          current = c
          if result == FilterResult.Include {
            return Option.Some { value: c }
          }
          considerChildren = result == FilterResult.ExcludeNode
        }
        Option.None => match current.followingSibling() {
          Option.Some { value: sibling } => {
            let result = filter.filter(&sibling)
            current = sibling
            if result == FilterResult.Include {
              return Option.Some { value: sibling }
            }
            considerChildren = result == FilterResult.ExcludeNode
          }
          Option.None => {
            let parent = match current.parent() {
              Option.Some { value } => value
              Option.None => {
                return Option.None
              }
            }
            if filter.filter(&parent) != FilterResult.ExcludeNode {
              return Option.None
            }
            current = parent
            considerChildren = false
          }
        }
      }
    }
    return Option.None
  }

  /// The node before this one in a filtered walk of the same parent.
  pub fn previousFilteredSibling<F: NodeFilter>(self: &Self, filter: &F) -> Option<NodeRef<'a>> {
    let mut current: NodeRef<'a> = self.*
    let mut considerChildren = false
    while true {
      let child: Option<NodeRef<'a>> = if considerChildren {
        current.lastChild()
      } else {
        Option.None
      }
      match child {
        Option.Some { value: c } => {
          let result = filter.filter(&c)
          current = c
          if result == FilterResult.Include {
            return Option.Some { value: c }
          }
          considerChildren = result == FilterResult.ExcludeNode
        }
        Option.None => match current.precedingSibling() {
          Option.Some { value: sibling } => {
            let result = filter.filter(&sibling)
            current = sibling
            if result == FilterResult.Include {
              return Option.Some { value: sibling }
            }
            considerChildren = result == FilterResult.ExcludeNode
          }
          Option.None => {
            let parent = match current.parent() {
              Option.Some { value } => value
              Option.None => {
                return Option.None
              }
            }
            if filter.filter(&parent) != FilterResult.ExcludeNode {
              return Option.None
            }
            current = parent
            considerChildren = false
          }
        }
      }
    }
    return Option.None
  }

  /// The first descendant `filter` includes, looking into excluded nodes.
  pub fn firstFilteredChild<F: NodeFilter>(self: &Self, filter: &F) -> Option<NodeRef<'a>> {
    let count = self.childCount()
    let mut i: usize = 0
    while i < count {
      match self.childAt(i) {
        Option.Some { value: child } => {
          let result = filter.filter(&child)
          if result == FilterResult.Include {
            return Option.Some { value: child }
          }
          if result == FilterResult.ExcludeNode {
            match child.firstFilteredChild(filter) {
              Option.Some { value } => {
                return Option.Some { value: value }
              }
              Option.None => {}
            }
          }
        }
        Option.None => {}
      }
      i = i + 1
    }
    return Option.None
  }

  /// The last descendant `filter` includes, looking into excluded nodes.
  pub fn lastFilteredChild<F: NodeFilter>(self: &Self, filter: &F) -> Option<NodeRef<'a>> {
    let mut i = self.childCount()
    while i > 0 {
      i = i - 1
      match self.childAt(i) {
        Option.Some { value: child } => {
          let result = filter.filter(&child)
          if result == FilterResult.Include {
            return Option.Some { value: child }
          }
          if result == FilterResult.ExcludeNode {
            match child.lastFilteredChild(filter) {
              Option.Some { value } => {
                return Option.Some { value: value }
              }
              Option.None => {}
            }
          }
        }
        Option.None => {}
      }
    }
    return Option.None
  }

  /// A walk over the children `filter` includes.
  pub fn filteredChildren<F: NodeFilter>(self: &Self, filter: &F) -> FilteredCursor<'a> {
    return FilteredCursor.make(
      self.firstFilteredChild(filter),
      self.lastFilteredChild(filter),
      true,
    )
  }

  /// Appends the children `filter` includes to `out`.
  pub effect fn collectFilteredChildren<F: NodeFilter>(
    self: &Self,
    filter: &F,
    out: &mut List<NodeRef<'a>>,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut cursor = self.filteredChildren(filter)
    while let Option.Some { value } = cursor.next(filter) {
      run out.append(value)
    }
  }

  /// A walk over the following siblings `filter` includes, nearest first.
  pub fn followingFilteredSiblings<F: NodeFilter>(self: &Self, filter: &F) -> FilteredCursor<'a> {
    let front = self.nextFilteredSibling(filter)
    let back: Option<NodeRef<'a>> = match self.filteredParent(filter) {
      Option.Some { value: parent } => parent.lastFilteredChild(filter)
      Option.None => Option.None
    }
    return FilteredCursor.make(front, back, true)
  }

  /// A walk over the preceding siblings `filter` includes, nearest first.
  pub fn precedingFilteredSiblings<F: NodeFilter>(self: &Self, filter: &F) -> FilteredCursor<'a> {
    let front = self.previousFilteredSibling(filter)
    let back: Option<NodeRef<'a>> = match self.filteredParent(filter) {
      Option.Some { value: parent } => parent.firstFilteredChild(filter)
      Option.None => Option.None
    }
    return FilteredCursor.make(front, back, false)
  }

  pub fn deepestFirstChild(self: &Self) -> Option<NodeRef<'a>> {
    let mut deepest = match self.firstChild() {
      Option.Some { value } => value
      Option.None => {
        return Option.None
      }
    }
    while let Option.Some { value: child } = deepest.firstChild() {
      deepest = child
    }
    return Option.Some { value: deepest }
  }

  pub fn deepestFirstFilteredChild<F: NodeFilter>(self: &Self, filter: &F) -> Option<NodeRef<'a>> {
    let mut deepest = match self.firstFilteredChild(filter) {
      Option.Some { value } => value
      Option.None => {
        return Option.None
      }
    }
    while let Option.Some { value: child } = deepest.firstFilteredChild(filter) {
      deepest = child
    }
    return Option.Some { value: deepest }
  }

  pub fn deepestLastChild(self: &Self) -> Option<NodeRef<'a>> {
    let mut deepest = match self.lastChild() {
      Option.Some { value } => value
      Option.None => {
        return Option.None
      }
    }
    while let Option.Some { value: child } = deepest.lastChild() {
      deepest = child
    }
    return Option.Some { value: deepest }
  }

  pub fn deepestLastFilteredChild<F: NodeFilter>(self: &Self, filter: &F) -> Option<NodeRef<'a>> {
    let mut deepest = match self.lastFilteredChild(filter) {
      Option.Some { value } => value
      Option.None => {
        return Option.None
      }
    }
    while let Option.Some { value: child } = deepest.lastFilteredChild(filter) {
      deepest = child
    }
    return Option.Some { value: deepest }
  }

  pub fn isDescendantOf(self: &Self, ancestor: &NodeRef<'_>) -> bool {
    let mut current: Option<NodeRef<'a>> = Option.Some { value: self.* }
    while let Option.Some { value: node } = current {
      if node.id.equals(ancestor.id) {
        return true
      }
      current = node.parent()
    }
    return false
  }

  /// The node's own transform, or the identity.
  pub fn directTransform(self: &Self) -> Affine {
    return self.data().transform().unwrapOr(Affine.identity())
  }

  /// The transform from this node's coordinates to the tree's.
  pub fn transform(self: &Self) -> Affine {
    let mut acc = self.directTransform()
    let mut current = self.parent()
    while let Option.Some { value: parent } = current {
      acc = parent.directTransform().multiply(acc)
      current = parent.parent()
    }
    return acc
  }

  /// The transform from this node's coordinates to `stopAt`'s.
  pub fn relativeTransform(self: &Self, stopAt: &NodeRef<'_>) -> Affine {
    let mut acc = self.directTransform()
    let mut current = self.parent()
    while let Option.Some { value: parent } = current {
      if parent.id.equals(stopAt.id) {
        break
      }
      acc = parent.directTransform().multiply(acc)
      current = parent.parent()
    }
    return acc
  }

  pub fn rawBounds(self: &Self) -> Option<Rect> {
    return self.data().bounds()
  }

  pub fn hasBounds(self: &Self) -> bool {
    return self.rawBounds().isSome()
  }

  /// The bounds in the tree's coordinates.
  pub fn boundingBox(self: &Self) -> Option<Rect> {
    return match self.rawBounds() {
      Option.Some { value } => Option.Some { value: self.transform().transformRectBbox(value) }
      Option.None => Option.None
    }
  }

  /// The bounds in `other`'s coordinates, for an ancestor `other`.
  pub fn boundingBoxInCoordinateSpace(self: &Self, other: &NodeRef<'_>) -> Option<Rect> {
    return match self.rawBounds() {
      Option.Some { value } => Option.Some {
        value: self.relativeTransform(other).transformRectBbox(value),
      }
      Option.None => Option.None
    }
  }

  /// The deepest, last-drawn node `filter` includes whose bounds hold `point` (in this node's
  /// coordinates), with the point in that node's coordinates.
  pub fn hitTest<F: NodeFilter>(self: &Self, point: Point, filter: &F) -> Option<HitTest<'a>> {
    let result = filter.filter(self)
    if result == FilterResult.ExcludeSubtree {
      return Option.None
    }
    let mut i = self.childCount()
    while i > 0 {
      i = i - 1
      match self.childAt(i) {
        Option.Some { value: child } => {
          let childPoint = child.directTransform().inverse().apply(point)
          match child.hitTest(childPoint, filter) {
            Option.Some { value } => {
              return Option.Some { value: value }
            }
            Option.None => {}
          }
        }
        Option.None => {}
      }
    }
    if result == FilterResult.Include {
      match self.rawBounds() {
        Option.Some { value: rect } => {
          if rect.contains(point) {
            return Option.Some { value: HitTest { node: self.*, point: point } }
          }
        }
        Option.None => {}
      }
    }
    return Option.None
  }

  pub fn nodeAtPoint<F: NodeFilter>(self: &Self, point: Point, filter: &F) -> Option<NodeRef<'a>> {
    return match self.hitTest(point, filter) {
      Option.Some { value } => Option.Some { value: value.node }
      Option.None => Option.None
    }
  }

  pub fn accessRole(self: &Self) -> Role {
    return self.data().accessRole()
  }

  pub fn roleDescription(self: &Self) -> Option<string> {
    return self.data().roleDescription()
  }

  pub fn hasRoleDescription(self: &Self) -> bool {
    return self.data().roleDescription().isSome()
  }

  pub fn isLiveAtomic(self: &Self) -> bool {
    return self.data().isLiveAtomic()
  }

  pub fn isBusy(self: &Self) -> bool {
    return self.data().isBusy()
  }

  pub fn columnIndexText(self: &Self) -> Option<string> {
    return self.data().columnIndexText()
  }

  pub fn rowIndexText(self: &Self) -> Option<string> {
    return self.data().rowIndexText()
  }

  pub fn brailleLabel(self: &Self) -> Option<string> {
    return self.data().brailleLabel()
  }

  pub fn hasBrailleLabel(self: &Self) -> bool {
    return self.data().brailleLabel().isSome()
  }

  pub fn brailleRoleDescription(self: &Self) -> Option<string> {
    return self.data().brailleRoleDescription()
  }

  pub fn hasBrailleRoleDescription(self: &Self) -> bool {
    return self.data().brailleRoleDescription().isSome()
  }

  pub fn ariaCurrent(self: &Self) -> Option<AriaCurrent> {
    return self.data().ariaCurrent()
  }

  pub fn hasPopup(self: &Self) -> Option<HasPopup> {
    return self.data().hasPopup()
  }

  /// Whether this node or an ancestor is hidden.
  pub fn isHidden(self: &Self) -> bool {
    let mut current: Option<NodeRef<'a>> = Option.Some { value: self.* }
    while let Option.Some { value: node } = current {
      if node.data().isHidden() {
        return true
      }
      current = node.parent()
    }
    return false
  }

  pub fn level(self: &Self) -> Option<usize> {
    return self.data().level()
  }

  pub fn isDisabled(self: &Self) -> bool {
    return self.data().isDisabled()
  }

  pub fn isReadOnly(self: &Self) -> bool {
    if self.data().isReadOnly() {
      return true
    }
    return self.shouldHaveReadOnlyStateByDefault() || !self.isReadOnlySupported()
  }

  pub fn isReadOnlyOrDisabled(self: &Self) -> bool {
    return self.isReadOnly() || self.isDisabled()
  }

  pub fn toggled(self: &Self) -> Option<Toggled> {
    return self.data().toggled()
  }

  pub fn numericValue(self: &Self) -> Option<f64> {
    return self.data().numericValue()
  }

  pub fn minNumericValue(self: &Self) -> Option<f64> {
    return self.data().minNumericValue()
  }

  pub fn maxNumericValue(self: &Self) -> Option<f64> {
    return self.data().maxNumericValue()
  }

  pub fn numericValueStep(self: &Self) -> Option<f64> {
    return self.data().numericValueStep()
  }

  pub fn numericValueJump(self: &Self) -> Option<f64> {
    return self.data().numericValueJump()
  }

  pub fn clipsChildren(self: &Self) -> bool {
    return self.data().clipsChildren()
  }

  pub fn scrollX(self: &Self) -> Option<f64> {
    return self.data().scrollX()
  }

  pub fn scrollXMin(self: &Self) -> Option<f64> {
    return self.data().scrollXMin()
  }

  pub fn scrollXMax(self: &Self) -> Option<f64> {
    return self.data().scrollXMax()
  }

  pub fn scrollY(self: &Self) -> Option<f64> {
    return self.data().scrollY()
  }

  pub fn scrollYMin(self: &Self) -> Option<f64> {
    return self.data().scrollYMin()
  }

  pub fn scrollYMax(self: &Self) -> Option<f64> {
    return self.data().scrollYMax()
  }

  pub fn isTextInput(self: &Self) -> bool {
    return match self.accessRole() {
      Role.TextInput => true
      Role.MultilineTextInput => true
      Role.SearchInput => true
      Role.DateInput => true
      Role.DateTimeInput => true
      Role.WeekInput => true
      Role.MonthInput => true
      Role.TimeInput => true
      Role.EmailInput => true
      Role.NumberInput => true
      Role.PasswordInput => true
      Role.PhoneNumberInput => true
      Role.UrlInput => true
      Role.EditableComboBox => true
      Role.SpinButton => true
      _ => false
    }
  }

  pub fn isMultiline(self: &Self) -> bool {
    return self.accessRole() == Role.MultilineTextInput
  }

  pub fn isPasswordInput(self: &Self) -> bool {
    return self.accessRole() == Role.PasswordInput
  }

  /// The orientation, defaulting to vertical for list boxes and horizontal for tab lists.
  pub fn orientation(self: &Self) -> Option<Orientation> {
    match self.data().orientation() {
      Option.Some { value } => {
        return Option.Some { value: value }
      }
      Option.None => {}
    }
    if self.accessRole() == Role.ListBox {
      return Option.Some { value: Orientation.Vertical }
    }
    if self.accessRole() == Role.TabList {
      return Option.Some { value: Orientation.Horizontal }
    }
    return Option.None
  }

  pub fn isDialog(self: &Self) -> bool {
    return self.accessRole() == Role.AlertDialog || self.accessRole() == Role.Dialog
  }

  pub fn isModal(self: &Self) -> bool {
    return self.data().isModal()
  }

  pub fn isClickable<F: NodeFilter>(self: &Self, parentFilter: &F) -> bool {
    return self.supportsAction(Action.Click, parentFilter)
  }

  pub fn isSelectable(self: &Self) -> bool {
    return self.isSelected().isSome() && !self.isDisabled()
  }

  pub fn isMultiselectable(self: &Self) -> bool {
    return self.data().isMultiselectable()
  }

  /// The set size from the nearest filtered ancestor that has one.
  pub fn sizeOfSetFromContainer<F: NodeFilter>(self: &Self, filter: &F) -> Option<usize> {
    let mut parent = self.filteredParent(filter)
    while let Option.Some { value: node } = parent {
      match node.sizeOfSet() {
        Option.Some { value } => {
          return Option.Some { value: value }
        }
        Option.None => {}
      }
      parent = node.filteredParent(filter)
    }
    return Option.None
  }

  pub fn sizeOfSet(self: &Self) -> Option<usize> {
    return self.data().sizeOfSet()
  }

  pub fn positionInSet(self: &Self) -> Option<usize> {
    return self.data().positionInSet()
  }

  pub fn sortDirection(self: &Self) -> Option<SortDirection> {
    return self.data().sortDirection()
  }

  pub fn supportsToggle(self: &Self) -> bool {
    return self.toggled().isSome()
  }

  pub fn supportsExpandCollapse(self: &Self) -> bool {
    if self.hasPopup().isSome() || self.data().isExpanded().isSome() {
      return true
    }
    return match self.accessRole() {
      Role.ComboBox => true
      Role.EditableComboBox => true
      Role.DisclosureTriangle => true
      Role.TreeItem => true
      _ => false
    }
  }

  /// Whether a plain invoke (a button press) fits this node.
  pub fn isInvocable<F: NodeFilter>(self: &Self, parentFilter: &F) -> bool {
    return self.isClickable(parentFilter) && !self.isTextInput()
      && self.accessRole() != Role.Document
      && self.accessRole() != Role.Terminal
      && !self.supportsToggle()
      && !self.supportsExpandCollapse()
      && self.isSelected().isNone()
  }

  /// Whether this node supports `action`, itself or through its filtered parent's child actions.
  pub fn supportsAction<F: NodeFilter>(self: &Self, action: Action, parentFilter: &F) -> bool {
    if self.data().supportsAction(action) {
      return true
    }
    return match self.filteredParent(parentFilter) {
      Option.Some { value: parent } => parent.data().childSupportsAction(action)
      Option.None => false
    }
  }

  pub fn supportsIncrement<F: NodeFilter>(self: &Self, parentFilter: &F) -> bool {
    return self.supportsAction(Action.Increment, parentFilter)
  }

  pub fn supportsDecrement<F: NodeFilter>(self: &Self, parentFilter: &F) -> bool {
    return self.supportsAction(Action.Decrement, parentFilter)
  }

  fn takesLabelFromDescendants(self: &Self) -> bool {
    if self.state.data.labelledBy().length != 0 {
      return false
    }
    return match self.accessRole() {
      Role.Button => true
      Role.CheckBox => true
      Role.DefaultButton => true
      Role.Link => true
      Role.MenuItem => true
      Role.MenuItemCheckBox => true
      Role.MenuItemRadio => true
      Role.RadioButton => true
      _ => false
    }
  }

  /// The nodes that label this one: `labelledBy`, or for buttons, links and similar roles
  /// without it, their label and image descendants.
  pub effect fn labelledBy(self: &Self, out: &mut List<NodeRef<'a>>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.takesLabelFromDescendants() {
      run self.collectFilteredChildren(&DescendantLabelFilter {}, &mut out)
      return ()
    }
    let ids = self.state.data.labelledBy()
    let mut i: usize = 0
    while i < ids.length {
      match self.treeState.nodeById(self.id.withSameTree(ids[i])) {
        Option.Some { value } => run out.append(value)
        Option.None => {}
      }
      i = i + 1
    }
  }

  pub fn labelComesFromValue(self: &Self) -> bool {
    return self.accessRole() == Role.Label
  }

  /// The accessible name: the label, or the text of the labelling nodes joined by spaces.
  pub effect fn label(self: &Self) -> Option<String>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut result = String.make()
    if run self.writeLabel(&mut result) {
      return Option.Some { value: move result }
    }
    return Option.None
  }

  pub effect fn hasLabel(self: &Self) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.data().label().isSome() {
      return true
    }
    let mut labels = List<NodeRef<'a>>.make()
    run self.labelledBy(&mut labels)
    let mut i: usize = 0
    while i < labels.length() {
      let node = labels.get(i)
      if node.labelComesFromValue() {
        if node.hasValue() {
          return true
        }
      } else if node.data().label().isSome() {
        return true
      }
      i = i + 1
    }
    return false
  }

  effect fn writeLabelDirect(self: &Self, out: &mut String) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    return match self.data().label() {
      Option.Some { value } => {
        run out.append(value)
        true
      }
      Option.None => false
    }
  }

  /// Appends the accessible name to `out`; false when there is none.
  pub effect fn writeLabel(self: &Self, out: &mut String) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    if run self.writeLabelDirect(&mut out) {
      return true
    }
    let mut labels = List<NodeRef<'a>>.make()
    run self.labelledBy(&mut labels)
    let mut wroteOne = false
    let mut i: usize = 0
    while i < labels.length() {
      let node = labels.get(i)
      let mut part = String.make()
      let wrote = if node.labelComesFromValue() {
        run node.writeValue(&mut part)
      } else {
        run node.writeLabelDirect(&mut part)
      }
      if wrote {
        if wroteOne && String.byteLength(part.view()) != 0 {
          run out.append(" ")
        }
        run out.append(part.view())
        wroteOne = true
      }
      i = i + 1
    }
    return wroteOne
  }

  pub effect fn description(self: &Self) -> Option<String>
    ! OutOfMemoryError
    ? &mut Allocator {
    return match self.data().description() {
      Option.Some { value } => Option.Some { value: run String.copy(value) }
      Option.None => Option.None
    }
  }

  pub fn hasDescription(self: &Self) -> bool {
    return self.data().description().isSome()
  }

  pub fn url(self: &Self) -> Option<string> {
    return self.data().url()
  }

  pub fn supportsUrl(self: &Self) -> bool {
    let linkLike = match self.accessRole() {
      Role.Link => true
      Role.DocBackLink => true
      Role.DocBiblioRef => true
      Role.DocGlossRef => true
      Role.DocNoteRef => true
      _ => false
    }
    return linkLike && self.url().isSome()
  }

  fn isEmptyTextInput(self: &Self) -> bool {
    let mut runs = self.textRuns()
    let filter = TextRunFilter { root: self.id }
    return match runs.next(&filter) {
      Option.Some { value: first } => {
        let empty = match first.data().value() {
          Option.Some { value } => String.byteLength(value) == 0
          Option.None => true
        }
        empty && runs.next(&filter).isNone()
      }
      Option.None => true
    }
  }

  /// The placeholder, while the text input is empty.
  pub fn placeholder(self: &Self) -> Option<string> {
    return match self.data().placeholder() {
      Option.Some { value } => if self.isTextInput() && self.isEmptyTextInput() {
        Option.Some { value: value }
      } else {
        Option.None
      }
      Option.None => Option.None
    }
  }

  /// The value, masked for password inputs, or the text of a one-line text input.
  pub effect fn value(self: &Self) -> Option<String>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut result = String.make()
    if run self.writeValue(&mut result) {
      return Option.Some { value: move result }
    }
    return Option.None
  }

  /// Appends the value to `out`; false when there is none.
  pub effect fn writeValue(self: &Self, out: &mut String) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    match self.data().value() {
      Option.Some { value } => {
        if self.isPasswordInput() {
          run self.writePasswordValue(value, &mut out)
        } else {
          run out.append(value)
        }
        return true
      }
      Option.None => {}
    }
    if self.supportsTextRanges() && !self.isMultiline() {
      run self.documentRange().writeText(&mut out)
      return true
    }
    return false
  }

  effect fn writePasswordValue(self: &Self, value: string, out: &mut String) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut count: usize = 0
    if self.supportsTextRanges() {
      if !self.textRunsNeedMasking() {
        run out.append(value)
        return ()
      }
      let filter = TextRunFilter { root: self.id }
      let mut runs = self.textRuns()
      while let Option.Some { value: node } = runs.next(&filter) {
        count = count + node.data().characterLengths().length
      }
    } else {
      if !hasDistinctCharacters(value) {
        run out.append(value)
        return ()
      }
      count = characterCount(value)
    }
    let mut i: usize = 0
    while i < count {
      run out.append(PASSWORD_MASKING_CHARACTER)
      i = i + 1
    }
  }

  pub fn hasValue(self: &Self) -> bool {
    return self.data().value().isSome() || (self.supportsTextRanges() && !self.isMultiline())
  }

  pub fn isReadOnlySupported(self: &Self) -> bool {
    if self.isTextInput() {
      return true
    }
    return match self.accessRole() {
      Role.CheckBox => true
      Role.ColorWell => true
      Role.ComboBox => true
      Role.Grid => true
      Role.ListBox => true
      Role.MenuItemCheckBox => true
      Role.MenuItemRadio => true
      Role.MenuListPopup => true
      Role.RadioButton => true
      Role.RadioGroup => true
      Role.Slider => true
      Role.Switch => true
      Role.TreeGrid => true
      _ => false
    }
  }

  pub fn shouldHaveReadOnlyStateByDefault(self: &Self) -> bool {
    return match self.accessRole() {
      Role.Article => true
      Role.Definition => true
      Role.DescriptionList => true
      Role.Document => true
      Role.GraphicsDocument => true
      Role.Image => true
      Role.List => true
      Role.ListItem => true
      Role.PdfRoot => true
      Role.ProgressIndicator => true
      Role.RootWebArea => true
      Role.Term => true
      Role.Timer => true
      Role.Toolbar => true
      Role.Tooltip => true
      _ => false
    }
  }

  pub fn isRequired(self: &Self) -> bool {
    return self.data().isRequired()
  }

  /// The live setting, inherited from the nearest ancestor that has one.
  pub fn live(self: &Self) -> Live {
    let mut current: Option<NodeRef<'a>> = Option.Some { value: self.* }
    while let Option.Some { value: node } = current {
      match node.data().live() {
        Option.Some { value } => {
          return value
        }
        Option.None => {}
      }
      current = node.parent()
    }
    return Live.Off
  }

