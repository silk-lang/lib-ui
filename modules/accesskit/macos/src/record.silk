//! The byte records the Silk side sends to the AppKit side, one per accessibility element.
//!
//! A record is a run of fields, each a one-byte tag followed by its payload, little-endian and
//! unaligned. `native/adapter.m` reads the same layout; keep the two in step.
//!
//! | tag | field | payload |
//! |-----|-------|---------|
//! | 1 | role | text |
//! | 2 | subrole | text |
//! | 3 | role description | text |
//! | 4 | identifier | text |
//! | 5 | title | text |
//! | 6 | help | text |
//! | 7 | placeholder | text |
//! | 8 | boolean value | u8 |
//! | 9 | number value | f64 |
//! | 10 | text value | text |
//! | 11 | minimum value | f64 |
//! | 12 | maximum value | f64 |
//! | 13 | URL | text |
//! | 14 | orientation | u8: 0 unknown, 1 vertical, 2 horizontal |
//! | 15 | flags | u32, the `FLAG_` bits |
//! | 16 | frame | 4 f64: x0, y0, x1, y1 in tree coordinates |
//! | 17 | parent | u64 |
//! | 18 | children | ids |
//! | 19 | selected children (and selected rows) | ids |
//! | 20 | linked elements | ids |
//! | 21 | tabs | ids |
//! | 22 | braille label | text |
//! | 23 | braille role description | text |
//! | 24 | DOM identifier | text |
//! | 25 | rows | ids |
//! | 26 | text | the text block below |
//!
//! Text is a u32 byte length and UTF-8 bytes. Ids are a u32 count and that many u64 ids.
//!
//! The text block: the text; the UTF-16 length (u32); whether there is a selection (u8), its
//! UTF-16 start and end (2 u32) and the insertion point's line (u32); the lines (u32 count, then
//! a UTF-16 start and end per line); the characters (u32 count, then a UTF-16 start and end and
//! 4 f64 bounds per character); the format runs (u32 count, then a UTF-16 start and end per run
//! and its attributes, each a tag and payload, ending with tag 0: 1 font family (text), 2 font
//! size (f64), 3 bold, 4 italic, 5 underline color, 6 strikethrough color, 7 background color,
//! 8 foreground color (colors as 4 u8: red, green, blue, alpha), 9 language (text), 10 alignment
//! (u8: 0 left, 1 center, 2 right, 3 justified)).
import accesskit.lib { Color, Rect }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize
import silk.text.string { String }

pub fn TAG_ROLE() -> u8 {
  return 1
}

pub fn TAG_SUBROLE() -> u8 {
  return 2
}

pub fn TAG_ROLE_DESCRIPTION() -> u8 {
  return 3
}

pub fn TAG_IDENTIFIER() -> u8 {
  return 4
}

pub fn TAG_TITLE() -> u8 {
  return 5
}

pub fn TAG_HELP() -> u8 {
  return 6
}

pub fn TAG_PLACEHOLDER() -> u8 {
  return 7
}

pub fn TAG_VALUE_BOOL() -> u8 {
  return 8
}

pub fn TAG_VALUE_NUMBER() -> u8 {
  return 9
}

pub fn TAG_VALUE_TEXT() -> u8 {
  return 10
}

pub fn TAG_MIN_VALUE() -> u8 {
  return 11
}

pub fn TAG_MAX_VALUE() -> u8 {
  return 12
}

pub fn TAG_URL() -> u8 {
  return 13
}

pub fn TAG_ORIENTATION() -> u8 {
  return 14
}

pub fn TAG_FLAGS() -> u8 {
  return 15
}

pub fn TAG_FRAME() -> u8 {
  return 16
}

pub fn TAG_PARENT() -> u8 {
  return 17
}

pub fn TAG_CHILDREN() -> u8 {
  return 18
}

pub fn TAG_SELECTED_CHILDREN() -> u8 {
  return 19
}

pub fn TAG_LINKED() -> u8 {
  return 20
}

pub fn TAG_TABS() -> u8 {
  return 21
}

pub fn TAG_BRAILLE_LABEL() -> u8 {
  return 22
}

pub fn TAG_BRAILLE_ROLE_DESCRIPTION() -> u8 {
  return 23
}

pub fn TAG_DOM_IDENTIFIER() -> u8 {
  return 24
}

pub fn TAG_ROWS() -> u8 {
  return 25
}

pub fn TAG_TEXT() -> u8 {
  return 26
}

/// `isAccessibilityFocused`.
pub fn FLAG_FOCUSED() -> u32 {
  return 1
}

/// `isAccessibilityEnabled`.
pub fn FLAG_ENABLED() -> u32 {
  return 2
}

/// `isAccessibilityRequired`.
pub fn FLAG_REQUIRED() -> u32 {
  return 4
}

/// `isAccessibilitySelected`.
pub fn FLAG_SELECTED() -> u32 {
  return 8
}

/// `isAccessibilityModal`.
pub fn FLAG_MODAL() -> u32 {
  return 16
}

/// `setAccessibilityFocused:` may focus the node.
pub fn FLAG_FOCUSABLE() -> u32 {
  return 32
}

/// `accessibilityPerformPress`.
pub fn FLAG_CLICKABLE() -> u32 {
  return 64
}

/// `accessibilityPerformIncrement`.
pub fn FLAG_INCREMENT() -> u32 {
  return 128
}

/// `accessibilityPerformDecrement`.
pub fn FLAG_DECREMENT() -> u32 {
  return 256
}

/// The text range methods.
pub fn FLAG_TEXT() -> u32 {
  return 512
}

/// An item that can be selected: `isAccessibilitySelected` is allowed.
pub fn FLAG_ITEM_LIKE() -> u32 {
  return 1024
}

/// `setAccessibilitySelected:` and `accessibilityPerformPick`.
pub fn FLAG_PICKABLE() -> u32 {
  return 2048
}

/// `accessibilityRows` and `accessibilitySelectedRows`.
pub fn FLAG_SELECTABLE_CONTAINER() -> u32 {
  return 4096
}

/// `accessibilityTabs`.
pub fn FLAG_TAB_LIST() -> u32 {
  return 8192
}

/// `isAccessibilityModal` is allowed.
pub fn FLAG_DIALOG() -> u32 {
  return 16384
}

/// The `AXScrollToVisible` action.
pub fn FLAG_SCROLL() -> u32 {
  return 32768
}

/// `accessibilityURL` is allowed.
pub fn FLAG_URL() -> u32 {
  return 65536
}

/// `setAccessibilityValue:`.
pub fn FLAG_SET_VALUE() -> u32 {
  return 131072
}

/// The record has a frame; a root without one uses the view's frame.
pub fn FLAG_HAS_FRAME() -> u32 {
  return 262144
}

/// The node is selected (`Node.isSelected` is true).
pub fn FLAG_IS_SELECTED() -> u32 {
  return 524288
}

/// The node is not selected (`Node.isSelected` is false).
pub fn FLAG_IS_UNSELECTED() -> u32 {
  return 1048576
}

/// `accessibilityAttributeValue:` answers braille or DOM identifier attributes.
pub fn FLAG_ATTRIBUTES() -> u32 {
  return 2097152
}

/// The tree's root.
pub fn FLAG_ROOT() -> u32 {
  return 4194304
}

/// The record has a parent field.
pub fn FLAG_HAS_PARENT() -> u32 {
  return 8388608
}

/// A record being written.
pub struct Record {
  bytes: List<u8>,
}

impl Record {
  pub fn make() -> Record {
    return Record { bytes: List<u8>.make() }
  }

  pub fn asSlice(self: &Self) -> &[u8] {
    return self.bytes.asSlice()
  }

  pub fn length(self: &Self) -> usize {
    return self.bytes.length()
  }

  pub fn clear(self: &mut Self) -> () {
    self.bytes.clear()
  }

  pub effect fn byte(self: &mut Self, value: u8) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.bytes.append(value)
  }

  effect fn little(self: &mut Self, value: u64, count: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut rest = value
    let mut i: usize = 0
    while i < count {
      run self.bytes.append(u64.wrappingToU8(rest & 255))
      rest = u64.shiftRight(rest, 8)
      i = i + 1
    }
  }

  pub effect fn uint32(self: &mut Self, value: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.little(u32.toU64(value), 4)
  }

  pub effect fn uint64(self: &mut Self, value: u64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.little(value, 8)
  }

  pub effect fn double(self: &mut Self, value: f64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.little(f64.toBits(value), 8)
  }

  pub effect fn raw(self: &mut Self, values: &[u8]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.bytes.appendBytes(values)
  }

  pub effect fn index(self: &mut Self, value: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.uint32(usize.wrappingToU32(value))
  }

  pub effect fn text(self: &mut Self, value: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let bytes = String.utf8Bytes(value)
    run self.index(bytes.length)
    run self.bytes.appendBytes(bytes)
  }

  pub effect fn rect(self: &mut Self, value: Rect) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.double(value.x0)
    run self.double(value.y0)
    run self.double(value.x1)
    run self.double(value.y1)
  }

  pub effect fn color(self: &mut Self, value: Color) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.byte(value.red)
    run self.byte(value.green)
    run self.byte(value.blue)
    run self.byte(value.alpha)
  }

  pub effect fn ids(self: &mut Self, values: &List<u64>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.index(values.length())
    let mut i: usize = 0
    while i < values.length() {
      run self.uint64(values.get(i))
      i = i + 1
    }
  }

  pub effect fn textField(self: &mut Self, tag: u8, value: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.byte(tag)
    run self.text(value)
  }

  pub effect fn numberField(self: &mut Self, tag: u8, value: f64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.byte(tag)
    run self.double(value)
  }

  pub effect fn idsField(self: &mut Self, tag: u8, values: &List<u64>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.byte(tag)
    run self.ids(values)
  }
}

/// A 64-bit FNV-1a hash of `bytes`, which tells whether a record changed.
pub fn fingerprint(bytes: &[u8]) -> u64 {
  let mut hash: u64 = 14695981039346656037
  let mut i: usize = 0
  while i < bytes.length {
    hash = u64.wrappingMultiply(hash ^ u8.toU64(bytes[i]), 1099511628211)
    i = i + 1
  }
  return hash
}

fn clamp(value: usize, limit: usize) -> usize {
  if value > limit {
    return limit
  }
  return value
}

/// Reads a record, for tests and tools.
pub struct Reader<'a> {
  data: &'a [u8],
  at: usize,
}

impl<'a> Reader<'a> {
  pub fn make(data: &'a [u8]) -> Reader<'a> {
    return Reader { data: data, at: 0 }
  }

  pub fn atEnd(self: &Self) -> bool {
    return self.at >= self.data.length
  }

  pub fn byte(self: &mut Self) -> u8 {
    if self.at >= self.data.length {
      return 0
    }
    let value = self.data[self.at]
    self.at = self.at + 1
    return value
  }

  fn little(self: &mut Self, count: usize) -> u64 {
    let mut value: u64 = 0
    let mut i: usize = 0
    while i < count {
      value = value | u64.shiftLeft(u8.toU64(self.byte()), usize.toU64(i * 8))
      i = i + 1
    }
    return value
  }

  pub fn uint32(self: &mut Self) -> u32 {
    return u64.wrappingToU32(self.little(4))
  }

  pub fn uint64(self: &mut Self) -> u64 {
    return self.little(8)
  }

  pub fn double(self: &mut Self) -> f64 {
    return f64.fromBits(self.little(8))
  }

  pub fn text(self: &mut Self) -> string<'a> {
    let length = u32.toUsize(self.uint32())
    let start = self.at
    let end = clamp(start + length, self.data.length)
    self.at = end
    return String.fromUtf8(Slice.view<u8>(self.data, start, end - start)).unwrapOr("")
  }

  pub fn skip(self: &mut Self, count: usize) -> () {
    self.at = clamp(self.at + count, self.data.length)
  }

  /// Skips the payload of a field with `tag`.
  pub fn skipField(self: &mut Self, tag: u8) -> () {
    if tag == TAG_VALUE_BOOL() || tag == TAG_ORIENTATION() {
      self.skip(1)
    } else if tag == TAG_VALUE_NUMBER() || tag == TAG_MIN_VALUE() || tag == TAG_MAX_VALUE()
      || tag == TAG_PARENT() {
      self.skip(8)
    } else if tag == TAG_FLAGS() {
      self.skip(4)
    } else if tag == TAG_FRAME() {
      self.skip(32)
    } else if tag == TAG_CHILDREN() || tag == TAG_SELECTED_CHILDREN() || tag == TAG_LINKED()
      || tag == TAG_TABS()
      || tag == TAG_ROWS() {
      let count = u32.toUsize(self.uint32())
      self.skip(count * 8)
    } else if tag == TAG_TEXT() {
      self.at = self.data.length
    } else {
      drop self.text()
    }
  }
}

/// The text field `tag` of `record`, if present.
pub fn findText<'a>(record: &'a [u8], tag: u8) -> Option<string<'a>> {
  let mut reader = Reader.make(record)
  while !reader.atEnd() {
    let at = reader.byte()
    if at == tag {
      return Option.Some { value: reader.text() }
    }
    reader.skipField(at)
  }
  return Option.None
}

/// The flags of `record`.
pub fn findFlags(record: &[u8]) -> u32 {
  let mut reader = Reader.make(record)
  while !reader.atEnd() {
    let at = reader.byte()
    if at == TAG_FLAGS() {
      return reader.uint32()
    }
    reader.skipField(at)
  }
  return 0
}

/// The ids field `tag` of `record`, appended to `out`; false when absent.
pub effect fn findIds(record: &[u8], tag: u8, out: &mut List<u64>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut reader = Reader.make(record)
  while !reader.atEnd() {
    let at = reader.byte()
    if at == tag {
      let count = u32.toUsize(reader.uint32())
      let mut i: usize = 0
      while i < count {
        run out.append(reader.uint64())
        i = i + 1
      }
      return true
    }
    reader.skipField(at)
  }
  return false
}

/// The number field `tag` of `record`, if present.
pub fn findNumber(record: &[u8], tag: u8) -> Option<f64> {
  let mut reader = Reader.make(record)
  while !reader.atEnd() {
    let at = reader.byte()
    if at == tag {
      return Option.Some { value: reader.double() }
    }
    reader.skipField(at)
  }
  return Option.None
}
