//! AccessKit's macOS adapter: keeps the NSAccessibility elements of one view in step with an
//! AccessKit tree, raises the notifications its updates cause, and turns what VoiceOver asks
//! for into [`ActionRequest`]s.
//!
//! Ported from AccessKit (`accesskit_macos/src/adapter.rs`, `context.rs` and `event.rs`),
//! Copyright 2022 The AccessKit Authors, under the MIT or Apache-2.0 license.
//!
//! The adapter sends its elements to a [`Sink`]: [`NativeSink`] hands them to the AppKit side
//! in `native/adapter.m`, and [`RecordingSink`] keeps them for tests on any platform.
import accesskit.lib { Action, ActionData, ActionRequest, NodeId, TreeUpdate }
import accesskit_consumer.lib { Tree, TreeState, FullNodeId, TreeIndex, NodeRef, CommonFilter }
import events { EventGenerator, MacEvent }
import node { elementId, included, canBeFocused, rootIds, writeRecord }
import record { Record, fingerprint }
import sys
import silk.collections.hash { Hash }
import silk.collections.hash_map { HashMap }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.collections.bytes { Bytes }
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.text.string { String }

/// `accessibilityPerformPress`, `setAccessibilitySelected:` or `accessibilityPerformPick`.
pub fn ACTION_CLICK() -> u32 {
  return 1
}

/// `setAccessibilityFocused:` with true.
pub fn ACTION_FOCUS() -> u32 {
  return 2
}

/// `setAccessibilityFocused:` with false: focus moves to the root.
pub fn ACTION_BLUR() -> u32 {
  return 3
}

/// `accessibilityPerformIncrement`.
pub fn ACTION_INCREMENT() -> u32 {
  return 4
}

/// `accessibilityPerformDecrement`.
pub fn ACTION_DECREMENT() -> u32 {
  return 5
}

/// `setAccessibilityValue:` with a string.
pub fn ACTION_SET_TEXT() -> u32 {
  return 6
}

/// `setAccessibilityValue:` with a number.
pub fn ACTION_SET_NUMBER() -> u32 {
  return 7
}

/// `setAccessibilitySelectedTextRange:`, from `start` to `end` in UTF-16 code units.
pub fn ACTION_SET_SELECTION() -> u32 {
  return 8
}

/// The `AXScrollToVisible` action.
pub fn ACTION_SCROLL_INTO_VIEW() -> u32 {
  return 9
}

/// What the AppKit side queued for the application.
pub struct NativeAction {
  pub kind: u32,
  pub id: u64,
  pub number: f64,
  pub start: u32,
  pub end: u32,
  pub text: String,
}

/// Where the adapter sends its elements and notifications.
pub interface Sink {
  /// Element `id` is now described by `record`.
  effect fn setNode(self: &mut Self, id: u64, record: &[u8]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator

  /// Element `id` is gone.
  effect fn removeNode(self: &mut Self, id: u64) -> () ! OutOfMemoryError ? &mut Allocator

  /// The view's children are `ids`.
  effect fn setRoots(self: &mut Self, ids: &List<u64>) -> () ! OutOfMemoryError ? &mut Allocator

  /// The focused element, if one can be.
  effect fn setFocus(self: &mut Self, id: Option<u64>) -> () ! OutOfMemoryError ? &mut Allocator

  /// Posts notification `code` (see `Notification.code`) on element `id`.
  effect fn notify(self: &mut Self, id: u64, code: u32) -> () ! OutOfMemoryError ? &mut Allocator

  /// Announces `text` for a live region.
  effect fn announce(self: &mut Self, text: string, assertive: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator

  /// The next queued action, if any.
  effect fn poll(self: &mut Self) -> Option<NativeAction> ! OutOfMemoryError ? &mut Allocator
}

/// The AppKit side, for the view behind `handle`. Elsewhere it drops everything.
pub struct NativeSink {
  pub handle: u64,
}

impl NativeSink {
  /// The content view of window `window` of the platform window host, or none when the window
  /// is unknown or this is not macOS.
  pub fn forWindow(window: u32) -> Option<NativeSink> {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      let handle = unsafe sys.silk_ak_macos_attach_window(window)
      if handle == 0 {
        return Option.None
      }
      return Option.Some { value: NativeSink { handle: handle } }
    } else {
      drop window
      return Option.None
    }
  }

  /// Whether assistive technology has asked the view for its elements. Until it does, a
  /// host need not build accessibility updates at all.
  pub fn requested(self: &Self) -> bool {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      return unsafe sys.silk_ak_macos_requested(self.handle) != 0
    } else {
      drop self
      return false
    }
  }

  /// A view of its own, in no window, for tests of the AppKit side.
  pub fn detached() -> Option<NativeSink> {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      let handle = unsafe sys.silk_ak_macos_attach_view(
        unsafe Intrinsic.pointerRequalify<?*mut u8, ?[*]mut u8>(Pointer.null<u8>()),
      )
      if handle == 0 {
        return Option.None
      }
      return Option.Some { value: NativeSink { handle: handle } }
    } else {
      return Option.None
    }
  }

  /// Gives the view its own accessibility back.
  pub fn detach(self: Self) -> () {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      unsafe sys.silk_ak_macos_detach(self.handle)
    } else {
      drop self
    }
  }

  /// What AppKit reports for element `id`, one `name: value` per line, for tests.
  pub effect fn describe(self: &Self, id: u64) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      let mut bytes = Bytes.make()
      let length = unsafe sys.silk_ak_macos_describe(
        self.handle,
        id,
        Pointer.fromMutSlice(bytes.asMutSlice()),
        0,
      )
      bytes = run Bytes.zeroed(length)
      drop unsafe sys.silk_ak_macos_describe(
        self.handle,
        id,
        Pointer.fromMutSlice(bytes.asMutSlice()),
        length,
      )
      return run String.copy(String.fromUtf8(bytes.asSlice()).unwrapOr(""))
    } else {
      drop id
      return String.make()
    }
  }

  /// Calls AppKit method `kind` (an `ACTION_` number) on element `id`, as VoiceOver would, and
  /// returns what it returned.
  pub fn perform(self: &Self, id: u64, kind: u32) -> bool {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      return unsafe sys.silk_ak_macos_perform(self.handle, id, kind) != 0
    } else {
      drop id
      drop kind
      return false
    }
  }
}

impl Sink for NativeSink {
  effect fn setNode(self: &mut Self, id: u64, record: &[u8]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      unsafe sys.silk_ak_macos_set_node(self.handle, id, Pointer.fromSlice(record), record.length)
    } else {
      drop id
      drop record
    }
  }

  effect fn removeNode(self: &mut Self, id: u64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      unsafe sys.silk_ak_macos_remove_node(self.handle, id)
    } else {
      drop id
    }
  }

  effect fn setRoots(self: &mut Self, ids: &List<u64>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      unsafe sys.silk_ak_macos_set_roots(
        self.handle,
        Pointer.fromSlice(ids.asSlice()),
        ids.length(),
      )
    } else {
      drop ids
    }
  }

  effect fn setFocus(self: &mut Self, id: Option<u64>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      match id {
        Option.Some { value } => unsafe sys.silk_ak_macos_set_focus(self.handle, 1, value)
        Option.None => unsafe sys.silk_ak_macos_set_focus(self.handle, 0, 0)
      }
    } else {
      drop id
    }
  }

  effect fn notify(self: &mut Self, id: u64, code: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      unsafe sys.silk_ak_macos_notify(self.handle, id, code)
    } else {
      drop id
      drop code
    }
  }

  effect fn announce(self: &mut Self, text: string, assertive: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      let bytes = String.utf8Bytes(text)
      unsafe sys.silk_ak_macos_announce(
        self.handle,
        Pointer.fromSlice(bytes),
        bytes.length,
        if assertive {
          1
        } else {
          0
        },
      )
    } else {
      drop text
      drop assertive
    }
  }

  effect fn poll(self: &mut Self) -> Option<NativeAction>
    ! OutOfMemoryError
    ? &mut Allocator {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      let mut id: u64 = 0
      let mut number: f64 = 0.0
      let mut start: u32 = 0
      let mut end: u32 = 0
      let kind = unsafe sys.silk_ak_macos_poll(
        self.handle,
        Pointer.fromMutRef(&mut id),
        Pointer.fromMutRef(&mut number),
        Pointer.fromMutRef(&mut start),
        Pointer.fromMutRef(&mut end),
      )
      if kind == 0 {
        return Option.None
      }
      let mut bytes = Bytes.make()
      let length = unsafe sys.silk_ak_macos_action_text(
        self.handle,
        Pointer.fromMutSlice(bytes.asMutSlice()),
        0,
      )
      bytes = run Bytes.zeroed(length)
      drop unsafe sys.silk_ak_macos_action_text(
        self.handle,
        Pointer.fromMutSlice(bytes.asMutSlice()),
        length,
      )
      let text = run String.copy(String.fromUtf8(bytes.asSlice()).unwrapOr(""))
      return Option.Some {
        value: NativeAction {
          kind: kind,
          id: id,
          number: number,
          start: start,
          end: end,
          text: move text,
        },
      }
    } else {
      return Option.None
    }
  }
}

/// One thing the adapter sent to a [`RecordingSink`].
pub union SinkCall {
  SetNode { pub id: u64, pub record: List<u8> },
  RemoveNode { pub id: u64 },
  SetRoots { pub ids: List<u64> },
  SetFocus { pub id: Option<u64> },
  Notify { pub id: u64, pub code: u32 },
  Announce { pub text: String, pub assertive: bool },
}

/// Keeps what the adapter sends, and hands it the actions a test queues.
pub struct RecordingSink {
  pub calls: List<SinkCall>,
  pub actions: List<NativeAction>,
}

impl RecordingSink {
  pub fn make() -> RecordingSink {
    return RecordingSink { calls: List<SinkCall>.make(), actions: List<NativeAction>.make() }
  }
}

impl Sink for RecordingSink {
  effect fn setNode(self: &mut Self, id: u64, record: &[u8]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut copy = List<u8>.make()
    run copy.appendBytes(record)
    run self.calls.append(SinkCall.SetNode { id: id, record: move copy })
  }

  effect fn removeNode(self: &mut Self, id: u64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.calls.append(SinkCall.RemoveNode { id: id })
  }

  effect fn setRoots(self: &mut Self, ids: &List<u64>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut copy = List<u64>.make()
    run copy.appendSlice(ids.asSlice())
    run self.calls.append(SinkCall.SetRoots { ids: move copy })
  }

  effect fn setFocus(self: &mut Self, id: Option<u64>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.calls.append(SinkCall.SetFocus { id: id })
  }

  effect fn notify(self: &mut Self, id: u64, code: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.calls.append(SinkCall.Notify { id: id, code: code })
  }

  effect fn announce(self: &mut Self, text: string, assertive: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let copy = run String.copy(text)
    run self.calls.append(SinkCall.Announce { text: move copy, assertive: assertive })
  }

  effect fn poll(self: &mut Self) -> Option<NativeAction>
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.actions.length() == 0 {
      return Option.None
    }
    return Option.Some { value: self.actions.remove(0) }
  }
}

/// The node id the AppKit side knows as `value`.
pub fn nodeIdOf(value: u64) -> FullNodeId {
  return FullNodeId.make(
    NodeId.of(u64.bitAnd(value, 281474976710655)),
    TreeIndex { value: u64.wrappingToU32(u64.shiftRight(value, 48)) },
  )
}

/// The adapter of one view.
pub struct Adapter<S> {
  pub sink: S,
  tree: Tree,
  /// The fingerprint of each element's record as last sent.
  sent: HashMap<u64, u64>,
  requests: List<ActionRequest>,
}

/// Sends the elements of `tree` that changed since `sent`, and drops the ones it lost.
effect fn sync<S: Sink>(tree: &Tree, sink: &mut S, sent: &mut HashMap<u64, u64>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let state = tree.state()
  let mut now = HashMap<u64, u64>.make(Hash.seed(9001))
  let mut pending = List<NodeRef<'_>>.make()
  let root = state.rootNode()
  let mut roots = List<u64>.make()
  run rootIds(&root, &mut roots)
  if included(&root) {
    run pending.append(root)
  } else {
    let filter = CommonFilter {}
    let mut cursor = root.filteredChildren(&filter)
    while let Option.Some { value: child } = cursor.next(&filter) {
      run pending.append(child)
    }
  }
  let mut record = Record.make()
  while let Option.Some { value: node } = pending.pop() {
    let id = elementId(&node)
    record.clear()
    run writeRecord(&node, &mut record)
    let print = fingerprint(record.asSlice())
    let changed = match sent.get(id) {
      Option.Some { value } => value != print
      Option.None => true
    }
    if changed {
      run sink.setNode(id, record.asSlice())
    }
    drop run now.insert(id, print)
    let filter = CommonFilter {}
    let mut cursor = node.filteredChildren(&filter)
    while let Option.Some { value: child } = cursor.next(&filter) {
      run pending.append(child)
    }
  }
  let mut i: usize = 0
  while i < sent.bucketCount() {
    if sent.occupiedAt(i) {
      let id = sent.keyAt(i)
      if !now.contains(id) {
        run sink.removeNode(id)
      }
    }
    i = i + 1
  }
  run sink.setRoots(&roots)
  let focus: Option<u64> = match state.focusNode() {
    Option.Some { value } => if canBeFocused(&value) {
      Option.Some { value: elementId(&value) }
    } else {
      Option.None
    }
    Option.None => Option.None
  }
  run sink.setFocus(focus)
  sent.* = move now
}

effect fn raise<S: Sink>(sink: &mut S, events: List<MacEvent>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut rest = move events
  let mut ordered = List<MacEvent>.make()
  while let Option.Some { value } = rest.pop() {
    run ordered.append(move value)
  }
  while let Option.Some { value } = ordered.pop() {
    match move value {
      MacEvent.Generic { id, notification } => run sink.notify(id, notification.code())
      MacEvent.Announcement { text, assertive } => run sink.announce(text.view(), assertive)
    }
  }
}

impl<S: Sink> Adapter<S> {
  /// An adapter that shows `initial` through `sink`. `focused` tells whether the view's window
  /// has keyboard focus.
  pub effect fn make(sink: S, initial: TreeUpdate, focused: bool) -> Adapter<S>
    ! OutOfMemoryError
    ? &mut Allocator {
    let tree = run Tree.make(move initial, focused)
    let mut adapter = Adapter {
      sink: move sink,
      tree: move tree,
      sent: HashMap<u64, u64>.make(Hash.seed(9001)),
      requests: List<ActionRequest>.make(),
    }
    run sync(&adapter.tree, &mut adapter.sink, &mut adapter.sent)
    let focus: Option<u64> = match adapter.tree.state().focusNode() {
      Option.Some { value } => if included(&value) {
        Option.Some { value: elementId(&value) }
      } else {
        Option.None
      }
      Option.None => Option.None
    }
    match focus {
      Option.Some { value } => {
        let mut events = List<MacEvent>.make()
        run events.append(MacEvent.focus(value))
        run raise(&mut adapter.sink, move events)
      }
      Option.None => {}
    }
    return move adapter
  }

  /// The tree as the adapter holds it.
  pub fn state(self: &Self) -> &TreeState {
    return self.tree.state()
  }

  /// Applies `update` and raises the notifications it causes.
  pub effect fn update(self: &mut Self, update: TreeUpdate) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut generator = EventGenerator.make()
    run self.tree.update(move update, &mut generator)
    run sync(&self.tree, &mut self.sink, &mut self.sent)
    let events = run generator.finish()
    run raise(&mut self.sink, move events)
  }

  /// Tells the adapter whether the view's window has keyboard focus.
  pub effect fn updateViewFocus(self: &mut Self, focused: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut generator = EventGenerator.make()
    run self.tree.updateHostFocusState(focused, &mut generator)
    run sync(&self.tree, &mut self.sink, &mut self.sent)
    let events = run generator.finish()
    run raise(&mut self.sink, move events)
  }

  /// Turns the actions the AppKit side queued into requests for [`takeRequests`].
  pub effect fn pump(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    while let Option.Some { value } = run self.sink.poll() {
      match run requestFor(self.tree.state(), move value) {
        Option.Some { value: request } => run self.requests.append(move request)
        Option.None => {}
      }
    }
  }

  /// The requests assistive technology made since the last call.
  pub effect fn takeRequests(self: &mut Self) -> List<ActionRequest>
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.requests.splitOff(0)
  }

  /// The sink, given back.
  pub fn finish(self: Self) -> S {
    let adapter = move self
    return move adapter.sink
  }
}

fn request(node: &NodeRef<'_>, action: Action, data: Option<ActionData>) -> Option<ActionRequest> {
  return match node.treeState.locateNode(node.id) {
    Option.Some { value } => Option.Some {
      value: ActionRequest {
        action: action,
        targetTree: value.tree,
        targetNode: value.local,
        data: move data,
      },
    }
    Option.None => Option.None
  }
}

fn noData() -> Option<ActionData> {
  return Option.None
}

/// The request for `action`, as AccessKit's elements make it, or none when the node cannot
/// take it.
pub effect fn requestFor(state: &TreeState, action: NativeAction) -> Option<ActionRequest>
  ! OutOfMemoryError
  ? &mut Allocator {
  let filter = CommonFilter {}
  let node = match state.nodeById(nodeIdOf(action.id)) {
    Option.Some { value } => value
    Option.None => {
      return Option.None
    }
  }
  let kind = action.kind
  if kind == ACTION_CLICK() {
    if !node.isClickable(&filter) {
      return Option.None
    }
    return request(&node, Action.Click, noData())
  }
  if kind == ACTION_FOCUS() {
    if !node.isFocusable(&filter) {
      return Option.None
    }
    return request(&node, Action.Focus, noData())
  }
  if kind == ACTION_BLUR() {
    let root = state.rootNode()
    if !root.isFocusable(&filter) {
      return Option.None
    }
    return request(&root, Action.Focus, noData())
  }
  if kind == ACTION_INCREMENT() {
    if !node.supportsIncrement(&filter) {
      return Option.None
    }
    return request(&node, Action.Increment, noData())
  }
  if kind == ACTION_DECREMENT() {
    if !node.supportsDecrement(&filter) {
      return Option.None
    }
    return request(&node, Action.Decrement, noData())
  }
  if kind == ACTION_SET_TEXT() {
    let text = move action.text
    return request(
      &node,
      Action.SetValue,
      Option.Some { value: ActionData.Value { value: move text } },
    )
  }
  if kind == ACTION_SET_NUMBER() {
    return request(
      &node,
      Action.SetValue,
      Option.Some { value: ActionData.NumericValue { value: action.number } },
    )
  }
  if kind == ACTION_SET_SELECTION() {
    if !node.supportsTextRanges() {
      return Option.None
    }
    let start = match node.textPositionFromGlobalUtf16Index(u32.toUsize(action.start)) {
      Option.Some { value } => value
      Option.None => {
        return Option.None
      }
    }
    let mut range = start.toDegenerateRange()
    if action.end > action.start {
      match node.textPositionFromGlobalUtf16Index(u32.toUsize(action.end)) {
        Option.Some { value } => range.setEnd(value)
        Option.None => {
          return Option.None
        }
      }
    }
    return request(
      &node,
      Action.SetTextSelection,
      Option.Some { value: ActionData.SetTextSelection { value: range.toTextSelection() } },
    )
  }
  if kind == ACTION_SCROLL_INTO_VIEW() {
    return request(&node, Action.ScrollIntoView, noData())
  }
  return Option.None
}
