//! The NSAccessibility roles and subroles of AccessKit roles.
//!
//! Ported from AccessKit (`accesskit_macos/src/node.rs`), Copyright 2022 The AccessKit Authors,
//! under the MIT or Apache-2.0 license. The `NSAccessibility...Role` constants are written as the
//! strings AppKit defines them to be.
import accesskit.lib { Role }
import accesskit_consumer.lib { NodeRef }
import silk.core.option { Option }

/// The NSAccessibility role of `node`.
pub fn nsRole(node: &NodeRef<'_>) -> string<'static> {
  let kind = node.accessRole()
  if kind == Role.Button && node.toggled().isSome() {
    return "AXCheckBox"
  }
  return nsRoleOf(kind)
}

/// The NSAccessibility subrole of `node`, if it has one.
pub fn nsSubrole(node: &NodeRef<'_>) -> Option<string<'static>> {
  let kind = node.accessRole()
  if kind == Role.Button {
    if node.toggled().isSome() {
      return Option.Some { value: "AXToggle" }
    }
    return Option.None
  }
  return plainSubrole(kind)
}

/// Whether macOS shows the label of a `role` node as its value rather than its title.
pub fn labelIsExposedInValue(kind: Role) -> bool {
  return match kind {
    Role.Label => true
    Role.ListBoxOption => true
    Role.ListMarker => true
    Role.MenuListOption => true
    Role.TitleBar => true
    _ => false
  }
}

/// The NSAccessibility role of `role`, before the special cases of [`nsRole`].
pub fn nsRoleOf(kind: Role) -> string<'static> {
  return match kind {
    Role.Unknown => "AXUnknown"
    Role.TextRun => "AXUnknown"
    Role.Cell => "AXCell"
    Role.GridCell => "AXCell"
    Role.Label => "AXStaticText"
    Role.Image => "AXImage"
    Role.Link => "AXLink"
    Role.Row => "AXRow"
    Role.ListItem => "AXGroup"
    Role.ListMarker => "AXListMarker"
    Role.TreeItem => "AXRow"
    Role.ListBoxOption => "AXStaticText"
    Role.MenuItem => "AXMenuItem"
    Role.MenuListOption => "AXMenuItem"
    Role.Paragraph => "AXGroup"
    Role.GenericContainer => "AXUnknown"
    Role.CheckBox => "AXCheckBox"
    Role.RadioButton => "AXRadioButton"
    Role.TextInput => "AXTextField"
    Role.SearchInput => "AXTextField"
    Role.EmailInput => "AXTextField"
    Role.NumberInput => "AXTextField"
    Role.PasswordInput => "AXTextField"
    Role.PhoneNumberInput => "AXTextField"
    Role.UrlInput => "AXTextField"
    Role.Button => "AXButton"
    Role.DefaultButton => "AXButton"
    Role.Pane => "AXUnknown"
    Role.RowHeader => "AXCell"
    Role.ColumnHeader => "AXCell"
    Role.RowGroup => "AXGroup"
    Role.List => "AXList"
    Role.Table => "AXTable"
    Role.LayoutTableCell => "AXGroup"
    Role.LayoutTableRow => "AXGroup"
    Role.LayoutTable => "AXGroup"
    Role.Switch => "AXCheckBox"
