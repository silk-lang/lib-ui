fn plainSubrole(kind: Role) -> Option<string<'static>> {
  return match kind {
    Role.Alert => Option.Some { value: "AXApplicationAlert" }
    Role.AlertDialog => Option.Some { value: "AXDialog" }
    Role.Application => Option.Some { value: "AXWebApplication" }
    Role.Article => Option.Some { value: "AXDocumentArticle" }
    Role.Banner => Option.Some { value: "AXLandmarkBanner" }
    Role.Code => Option.Some { value: "AXCodeStyleGroup" }
    Role.Complementary => Option.Some { value: "AXLandmarkComplementary" }
    Role.ContentDeletion => Option.Some { value: "AXDeleteStyleGroup" }
    Role.ContentInsertion => Option.Some { value: "AXInsertStyleGroup" }
    Role.ContentInfo => Option.Some { value: "AXLandmarkContentInfo" }
    Role.Definition => Option.Some { value: "AXDefinition" }
    Role.Dialog => Option.Some { value: "AXDialog" }
    Role.Document => Option.Some { value: "AXDocument" }
    Role.Emphasis => Option.Some { value: "AXEmphasisStyleGroup" }
    Role.Feed => Option.Some { value: "AXApplicationGroup" }
    Role.Footer => Option.Some { value: "AXLandmarkContentInfo" }
    Role.Form => Option.Some { value: "AXLandmarkForm" }
    Role.GraphicsDocument => Option.Some { value: "AXDocument" }
    Role.Group => Option.Some { value: "AXApplicationGroup" }
    Role.Header => Option.Some { value: "AXLandmarkBanner" }
    Role.Log => Option.Some { value: "AXApplicationLog" }
    Role.Main => Option.Some { value: "AXLandmarkMain" }
    Role.Marquee => Option.Some { value: "AXApplicationMarquee" }
    Role.Math => Option.Some { value: "AXDocumentMath" }
    Role.Meter => Option.Some { value: "AXMeter" }
    Role.Navigation => Option.Some { value: "AXLandmarkNavigation" }
    Role.Note => Option.Some { value: "AXDocumentNote" }
    Role.PasswordInput => Option.Some { value: "AXSecureTextField" }
    Role.Region => Option.Some { value: "AXLandmarkRegion" }
    Role.Search => Option.Some { value: "AXLandmarkSearch" }
    Role.SearchInput => Option.Some { value: "AXSearchField" }
    Role.SectionFooter => Option.Some { value: "AXSectionFooter" }
    Role.SectionHeader => Option.Some { value: "AXSectionHeader" }
    Role.Status => Option.Some { value: "AXApplicationStatus" }
    Role.Strong => Option.Some { value: "AXStrongStyleGroup" }
    Role.Switch => Option.Some { value: "AXSwitch" }
    Role.Tab => Option.Some { value: "AXTabButton" }
    Role.TabPanel => Option.Some { value: "AXTabPanel" }
    Role.Term => Option.Some { value: "AXTerm" }
    Role.Time => Option.Some { value: "AXTimeGroup" }
    Role.Timer => Option.Some { value: "AXApplicationTimer" }
    Role.TreeItem => Option.Some { value: "AXOutlineRow" }
    Role.Tooltip => Option.Some { value: "AXUserInterfaceTooltip" }
    _ => Option.None
  }
}
