//! The C functions of `native/adapter.m`, on macOS only.
static if Intrinsic.targetOperatingSystem() == "darwin" {
  pub unsafe extern "C" fn silk_ak_macos_attach_window(window: u32) -> u64
  pub unsafe extern "C" fn silk_ak_macos_attach_view(view: ?[*]mut u8) -> u64
  pub unsafe extern "C" fn silk_ak_macos_detach(handle: u64) -> ()
  pub unsafe extern "C" fn silk_ak_macos_set_node(
    handle: u64,
    id: u64,
    record: ?[*]const u8,
    length: usize,
  ) -> ()
  pub unsafe extern "C" fn silk_ak_macos_remove_node(handle: u64, id: u64) -> ()
  pub unsafe extern "C" fn silk_ak_macos_set_roots(
    handle: u64,
    ids: ?[*]const u64,
    count: usize,
  ) -> ()
  pub unsafe extern "C" fn silk_ak_macos_set_focus(handle: u64, has: u32, id: u64) -> ()
  pub unsafe extern "C" fn silk_ak_macos_notify(handle: u64, id: u64, code: u32) -> ()
  pub unsafe extern "C" fn silk_ak_macos_announce(
    handle: u64,
    text: ?[*]const u8,
    length: usize,
    assertive: u32,
  ) -> ()
  pub unsafe extern "C" fn silk_ak_macos_poll(
    handle: u64,
    id: *mut u64,
    number: *mut f64,
    start: *mut u32,
    end: *mut u32,
  ) -> u32
  pub unsafe extern "C" fn silk_ak_macos_action_text(
    handle: u64,
    output: ?[*]mut u8,
    capacity: usize,
  ) -> usize
  pub unsafe extern "C" fn silk_ak_macos_describe(
    handle: u64,
    id: u64,
    output: ?[*]mut u8,
    capacity: usize,
  ) -> usize
  pub unsafe extern "C" fn silk_ak_macos_perform(handle: u64, id: u64, kind: u32) -> u32
}

/// Whether this build talks to AppKit.
pub fn supported() -> bool {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    return true
  } else {
    return false
  }
}
