impl AtspiRole {
  /// The number AT-SPI sends for the role.
  pub fn number(self: Self) -> u32 {
    return u8.toU32(AtspiRole.value(self))
  }

  /// The English role name, as `GetRoleName` answers it.
  pub fn roleName(self: Self) -> string<'static> {
