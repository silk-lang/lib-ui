      AtspiState.Focusable => "focusable"
      AtspiState.Focused => "focused"
      AtspiState.HasTooltip => "has-tooltip"
      AtspiState.Horizontal => "horizontal"
      AtspiState.Iconified => "iconified"
      AtspiState.Modal => "modal"
      AtspiState.MultiLine => "multi-line"
      AtspiState.Multiselectable => "multiselectable"
      AtspiState.Opaque => "opaque"
      AtspiState.Pressed => "pressed"
      AtspiState.Resizable => "resizable"
      AtspiState.Selectable => "selectable"
      AtspiState.Selected => "selected"
      AtspiState.Sensitive => "sensitive"
      AtspiState.Showing => "showing"
      AtspiState.SingleLine => "single-line"
      AtspiState.Stale => "stale"
      AtspiState.Transient => "transient"
      AtspiState.Vertical => "vertical"
      AtspiState.Visible => "visible"
      AtspiState.ManagesDescendants => "manages-descendants"
      AtspiState.Indeterminate => "indeterminate"
      AtspiState.Required => "required"
      AtspiState.Truncated => "truncated"
      AtspiState.Animated => "animated"
      AtspiState.InvalidEntry => "invalid-entry"
      AtspiState.SupportsAutocompletion => "supports-autocompletion"
      AtspiState.SelectableText => "selectable-text"
      AtspiState.IsDefault => "is-default"
      AtspiState.Visited => "visited"
      AtspiState.Checkable => "checkable"
      AtspiState.HasPopup => "has-popup"
      AtspiState.ReadOnly => "read-only"
    }
  }

  /// The state with ordinal `bit`.
  pub fn ofBit(bit: u32) -> AtspiState {
    return match bit {
      0 => AtspiState.Invalid
      1 => AtspiState.Active
      2 => AtspiState.Armed
      3 => AtspiState.Busy
      4 => AtspiState.Checked
      5 => AtspiState.Collapsed
      6 => AtspiState.Defunct
      7 => AtspiState.Editable
      8 => AtspiState.Enabled
      9 => AtspiState.Expandable
      10 => AtspiState.Expanded
      11 => AtspiState.Focusable
      12 => AtspiState.Focused
      13 => AtspiState.HasTooltip
      14 => AtspiState.Horizontal
      15 => AtspiState.Iconified
      16 => AtspiState.Modal
      17 => AtspiState.MultiLine
      18 => AtspiState.Multiselectable
      19 => AtspiState.Opaque
      20 => AtspiState.Pressed
      21 => AtspiState.Resizable
      22 => AtspiState.Selectable
      23 => AtspiState.Selected
      24 => AtspiState.Sensitive
      25 => AtspiState.Showing
      26 => AtspiState.SingleLine
      27 => AtspiState.Stale
      28 => AtspiState.Transient
      29 => AtspiState.Vertical
      30 => AtspiState.Visible
      31 => AtspiState.ManagesDescendants
      32 => AtspiState.Indeterminate
      33 => AtspiState.Required
      34 => AtspiState.Truncated
      35 => AtspiState.Animated
      36 => AtspiState.InvalidEntry
      37 => AtspiState.SupportsAutocompletion
      38 => AtspiState.SelectableText
      39 => AtspiState.IsDefault
      40 => AtspiState.Visited
      41 => AtspiState.Checkable
      42 => AtspiState.HasPopup
      43 => AtspiState.ReadOnly
      _ => AtspiState.Invalid
    }
  }
}

/// The number of AT-SPI states.
pub fn STATE_COUNT() -> u32 {
  return 44
}
