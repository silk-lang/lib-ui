//! How AT-SPI sees an AccessKit node: its role, states, interfaces, name, attributes,
//! actions and extents.
//!
//! Ported from AccessKit (`accesskit_atspi_common/src/node.rs`), Copyright 2022 The AccessKit
//! Authors, under the MIT or Apache-2.0 license.
import accesskit.lib { Role, Toggled, Orientation, Live, Rect, Point }
import accesskit_consumer.lib { NodeRef, FilterResult, CommonFilter, commonFilter }
import atspi { AtspiRole, AtspiState }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize
import silk.text.string { String }

/// A set of AT-SPI states, one bit per state.
pub struct StateSet {
  pub bits: u64,
}

impl Copy for StateSet {}

impl StateSet {
  pub fn empty() -> StateSet {
    return StateSet { bits: 0 }
  }

  pub fn insert(self: &mut Self, state: AtspiState) -> () {
    self.bits = self.bits | u64.shiftLeft(1, u32.toU64(u8ToU32(AtspiState.value(state))))
  }

  pub fn contains(self: &Self, state: AtspiState) -> bool {
    return (self.bits & u64.shiftLeft(1, u32.toU64(u8ToU32(AtspiState.value(state))))) != 0
  }

  /// The low and high words, as AT-SPI sends a state set (`au`).
  pub fn low(self: &Self) -> u32 {
    return u64.wrappingToU32(self.bits)
  }

  pub fn high(self: &Self) -> u32 {
    return u64.wrappingToU32(u64.shiftRight(self.bits, 32))
  }
}

fn u8ToU32(value: u8) -> u32 {
  return u8.toU32(value)
}

/// The window's frame (`outer`) and content (`inner`) on the screen. AccessKit coordinates
/// start at the content's origin.
pub struct WindowBounds {
  pub outer: Rect,
  pub inner: Rect,
}

impl Copy for WindowBounds {}

impl WindowBounds {
  pub fn zero() -> WindowBounds {
    return WindowBounds { outer: Rect.zero(), inner: Rect.zero() }
  }

  fn origin(self: &Self, parent: Option<NodeRef<'_>>, coordType: CoordType) -> Point {
    return match coordType {
      CoordType.Screen => Point.make(self.inner.x0, self.inner.y0)
      CoordType.Window => Point.make(0.0, 0.0)
      CoordType.Parent => match parent {
        Option.Some { value } => match value.boundingBox() {
          Option.Some { value: b } => Point.make(0.0 - b.x0, 0.0 - b.y0)
          Option.None => Point.make(0.0, 0.0)
        }
        Option.None => Point.make(self.inner.x0, self.inner.y0)
      }
    }
  }

  /// `point` in AccessKit coordinates, in the AT-SPI coordinates of `coordType`.
  pub fn toAtspi(
    self: &Self,
    point: Point,
    parent: Option<NodeRef<'_>>,
    coordType: CoordType,
  ) -> Point {
    let origin = self.origin(parent, coordType)
    return Point.make(origin.x + point.x, origin.y + point.y)
  }

  /// `point` in the AT-SPI coordinates of `coordType`, in AccessKit coordinates.
  pub fn toAccessKit(
    self: &Self,
    point: Point,
    parent: Option<NodeRef<'_>>,
    coordType: CoordType,
  ) -> Point {
    let origin = self.origin(parent, coordType)
    return Point.make(point.x - origin.x, point.y - origin.y)
  }
}

/// What AT-SPI coordinates are relative to.
pub enum CoordType {
  Screen,
  Window,
  Parent,
}

impl CoordType {
  pub fn of(value: u32) -> CoordType {
    if value == 1 {
      return CoordType.Window
    }
    if value == 2 {
      return CoordType.Parent
    }
    return CoordType.Screen
  }
}

/// AT-SPI interfaces, as bits.
pub fn ACCESSIBLE() -> u32 {
  return 1
}

pub fn ACTION() -> u32 {
  return 2
}

pub fn COMPONENT() -> u32 {
  return 4
}

pub fn DOCUMENT() -> u32 {
  return 8
}

pub fn EDITABLE_TEXT() -> u32 {
  return 16
}

pub fn HYPERLINK() -> u32 {
  return 32
}

pub fn IMAGE() -> u32 {
  return 64
}

pub fn SELECTION() -> u32 {
  return 128
}

pub fn TEXT() -> u32 {
  return 256
}

pub fn VALUE() -> u32 {
  return 512
}

pub fn APPLICATION() -> u32 {
  return 1024
}

/// The D-Bus names of the interfaces in `set`, in a fixed order.
pub fn interfaceNameAt(index: u32) -> string<'static> {
  return match index {
    0 => "org.a11y.atspi.Accessible"
    1 => "org.a11y.atspi.Action"
    2 => "org.a11y.atspi.Component"
    3 => "org.a11y.atspi.Document"
    4 => "org.a11y.atspi.EditableText"
    5 => "org.a11y.atspi.Hyperlink"
    6 => "org.a11y.atspi.Image"
    7 => "org.a11y.atspi.Selection"
    8 => "org.a11y.atspi.Text"
    9 => "org.a11y.atspi.Value"
    _ => "org.a11y.atspi.Application"
  }
}

/// The interface bit for a D-Bus interface name, or 0.
pub fn interfaceBit(name: string) -> u32 {
  let mut i: u32 = 0
  while i <= 10 {
    if interfaceNameAt(i) == name {
      return u32.shiftLeft(1, i)
    }
    i = i + 1
  }
  return 0
}

/// The AT-SPI role of `node`.
pub fn atspiRole(node: &NodeRef<'_>) -> AtspiRole {
  if node.hasRoleDescription() {
    return AtspiRole.Extended
  }
  return match node.accessRole() {
    Role.Alert => AtspiRole.Notification
    Role.AlertDialog => AtspiRole.Alert
    Role.Comment => AtspiRole.Section
    Role.Suggestion => AtspiRole.Section
    Role.Application => AtspiRole.Embedded
    Role.Article => AtspiRole.Article
    Role.Audio => AtspiRole.Audio
    Role.Banner => AtspiRole.Landmark
    Role.Header => AtspiRole.Landmark
    Role.Blockquote => AtspiRole.BlockQuote
    Role.Caret => AtspiRole.Unknown
    Role.Button => if node.toggled().isSome() {
      AtspiRole.ToggleButton
    } else {
      AtspiRole.Button
    }
    Role.DefaultButton => AtspiRole.Button
    Role.Canvas => AtspiRole.Canvas
    Role.Caption => AtspiRole.Caption
    Role.Cell => AtspiRole.TableCell
    Role.GridCell => AtspiRole.TableCell
    Role.CheckBox => AtspiRole.CheckBox
    Role.Switch => AtspiRole.ToggleButton
    Role.ColorWell => AtspiRole.Button
    Role.ColumnHeader => AtspiRole.ColumnHeader
    Role.ComboBox => AtspiRole.ComboBox
    Role.EditableComboBox => AtspiRole.ComboBox
    Role.Complementary => AtspiRole.Landmark
    Role.ContentDeletion => AtspiRole.ContentDeletion
    Role.ContentInsertion => AtspiRole.ContentInsertion
    Role.ContentInfo => AtspiRole.Landmark
    Role.Footer => AtspiRole.Landmark
    Role.Definition => AtspiRole.DescriptionValue
    Role.DescriptionList => AtspiRole.DescriptionList
    Role.Details => AtspiRole.Panel
    Role.Dialog => AtspiRole.Dialog
    Role.DisclosureTriangle => AtspiRole.ToggleButton
    Role.DocCover => AtspiRole.Image
    Role.DocBackLink => AtspiRole.Link
    Role.DocBiblioRef => AtspiRole.Link
    Role.DocGlossRef => AtspiRole.Link
    Role.DocNoteRef => AtspiRole.Link
    Role.DocBiblioEntry => AtspiRole.ListItem
    Role.DocEndnote => AtspiRole.ListItem
    Role.DocNotice => AtspiRole.Comment
    Role.DocTip => AtspiRole.Comment
    Role.DocFootnote => AtspiRole.Footnote
    Role.DocPageBreak => AtspiRole.Separator
    Role.DocPageFooter => AtspiRole.Footer
    Role.DocPageHeader => AtspiRole.Header
    Role.DocAcknowledgements => AtspiRole.Landmark
    Role.DocAfterword => AtspiRole.Landmark
    Role.DocAppendix => AtspiRole.Landmark
    Role.DocBibliography => AtspiRole.Landmark
    Role.DocChapter => AtspiRole.Landmark
