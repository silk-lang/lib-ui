    Role.TabList => AtspiRole.PageTabList
    Role.TabPanel => AtspiRole.ScrollPane
    Role.Term => AtspiRole.DescriptionTerm
    Role.TitleBar => AtspiRole.TitleBar
    Role.TextInput => AtspiRole.Entry
    Role.MultilineTextInput => AtspiRole.Entry
    Role.SearchInput => AtspiRole.Entry
    Role.EmailInput => AtspiRole.Entry
    Role.NumberInput => AtspiRole.Entry
    Role.PhoneNumberInput => AtspiRole.Entry
    Role.UrlInput => AtspiRole.Entry
    Role.DateInput => AtspiRole.DateEditor
