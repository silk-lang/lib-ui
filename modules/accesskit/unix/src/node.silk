    Role.DocPageList => AtspiRole.Landmark
    Role.DocPart => AtspiRole.Landmark
    Role.DocPreface => AtspiRole.Landmark
    Role.DocPrologue => AtspiRole.Landmark
    Role.DocToc => AtspiRole.Landmark
    Role.DocAbstract => AtspiRole.Section
    Role.DocColophon => AtspiRole.Section
    Role.DocCredit => AtspiRole.Section
    Role.DocDedication => AtspiRole.Section
