}

/// The accessible name: the value for nodes named by their value, the label otherwise.
pub effect fn name(node: &NodeRef<'_>) -> Option<String>
  ! OutOfMemoryError
  ? &mut Allocator {
  if node.labelComesFromValue() {
    return run node.value()
  }
  return run node.label()
}

/// The AT-SPI states of `node`, given whether its window has focus.
pub fn states(node: &NodeRef<'_>, windowFocused: bool) -> StateSet {
  let filter = CommonFilter {}
  let kind = atspiRole(node)
  let mut set = StateSet.empty()
  let isRootWindow = node.parentId().isNone() && node.accessRole() == Role.Window
  let isActiveDialog = node.isDialog()
    && match node.treeState.activeDialog() {
      Option.Some { value } => value.id.equals(node.id)
      Option.None => false
    }
  if windowFocused && (isRootWindow || isActiveDialog) {
    set.insert(AtspiState.Active)
  }
  if node.isTextInput() && !node.isReadOnly() {
    set.insert(AtspiState.Editable)
  }
  if node.isFocusable(&filter) {
    set.insert(AtspiState.Focusable)
  }
  if commonFilter(node) == FilterResult.Include {
    set.insert(AtspiState.Visible)
    set.insert(AtspiState.Showing)
  }
  if node.isRequired() {
    set.insert(AtspiState.Required)
  }
  if node.isMultiselectable() {
    set.insert(AtspiState.Multiselectable)
  }
  match node.orientation() {
    Option.Some { value } => {
      set.insert(
        if value == Orientation.Horizontal {
          AtspiState.Horizontal
        } else {
          AtspiState.Vertical
        },
      )
    }
    Option.None => {}
  }
  let toggled = node.toggled()
  if kind != AtspiRole.ToggleButton && toggled.isSome() {
    set.insert(AtspiState.Checkable)
  }
  if node.isBusy() {
    set.insert(AtspiState.Busy)
  }
  if node.isModal() {
    set.insert(AtspiState.Modal)
  }
  match node.isSelected() {
    Option.Some { value } => {
      if !node.isDisabled() {
        set.insert(AtspiState.Selectable)
      }
      if value {
        set.insert(AtspiState.Selected)
      }
    }
    Option.None => {}
  }
  if node.isTextInput() {
    set.insert(AtspiState.SelectableText)
    set.insert(
      if node.isMultiline() {
        AtspiState.MultiLine
      } else {
        AtspiState.SingleLine
      },
    )
  }
  if node.accessRole() == Role.ProgressIndicator && node.numericValue().isNone() {
    set.insert(AtspiState.Indeterminate)
  }
  match toggled {
    Option.Some { value } => {
      if value == Toggled.Mixed {
        set.insert(AtspiState.Indeterminate)
      } else if value == Toggled.True {
        set.insert(
          if kind == AtspiRole.ToggleButton {
            AtspiState.Pressed
          } else {
            AtspiState.Checked
          },
        )
      }
    }
    Option.None => {}
  }
  match node.data().isExpanded() {
    Option.Some { value } => {
      set.insert(AtspiState.Expandable)
      set.insert(
        if value {
          AtspiState.Expanded
        } else {
          AtspiState.Collapsed
        },
      )
    }
    Option.None => {}
  }
  if !node.isDisabled() {
    if node.isReadOnlySupported() && node.isReadOnly() {
      set.insert(AtspiState.ReadOnly)
    } else {
      set.insert(AtspiState.Enabled)
      set.insert(AtspiState.Sensitive)
    }
  }
  if node.isFocused() {
    set.insert(AtspiState.Focused)
  }
  return set
}

pub fn supportsAction(node: &NodeRef<'_>) -> bool {
  return node.isClickable(&CommonFilter {})
}

pub fn supportsComponent(node: &NodeRef<'_>) -> bool {
  return node.rawBounds().isSome() || node.isRoot()
}

pub fn supportsDocument(node: &NodeRef<'_>) -> bool {
  let kind = node.accessRole()
  return kind == Role.RootWebArea || kind == Role.PdfRoot
}

pub fn supportsEditableText(node: &NodeRef<'_>) -> bool {
  return node.isTextInput() && node.supportsTextRanges()
}

pub fn supportsImage(node: &NodeRef<'_>) -> bool {
  let kind = node.accessRole()
  return kind == Role.Canvas || kind == Role.DocCover || kind == Role.GraphicsSymbol
    || kind == Role.Image
    || kind == Role.SvgRoot
}

pub fn supportsValue(node: &NodeRef<'_>) -> bool {
  return node.numericValue().isSome()
}

/// The interfaces `node` implements, as bits.
pub fn interfaces(node: &NodeRef<'_>) -> u32 {
  let mut set = ACCESSIBLE()
  if supportsAction(node) {
    set = set | ACTION()
  }
  if supportsComponent(node) {
    set = set | COMPONENT()
  }
  if supportsDocument(node) {
    set = set | DOCUMENT()
  }
  if supportsEditableText(node) {
    set = set | EDITABLE_TEXT()
  }
  if node.supportsUrl() {
    set = set | HYPERLINK()
  }
  if supportsImage(node) {
    set = set | IMAGE()
  }
  if node.isContainerWithSelectableChildren() {
    set = set | SELECTION()
  }
  if node.supportsTextRanges() {
    set = set | TEXT()
  }
  if supportsValue(node) {
    set = set | VALUE()
  }
  return set
}

/// AT-SPI politeness: 0 none, 1 polite, 2 assertive.
pub fn politeness(node: &NodeRef<'_>) -> i32 {
  return match node.live() {
    Live.Off => 0
    Live.Polite => 1
    Live.Assertive => 2
  }
}

pub fn actionCount(node: &NodeRef<'_>) -> i32 {
  return if supportsAction(node) {
    1
  } else {
    0
  }
}

pub fn actionName(node: &NodeRef<'_>, index: i32) -> string<'static> {
  if index == 0 && supportsAction(node) {
    return "click"
  }
  return ""
}

/// One `a{ss}` attribute.
pub struct Attribute {
  pub key: string<'static>,
  pub value: String,
}

pub effect fn decimal(value: usize) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut digits = List<u8>.make()
  let mut rest = value
  if rest == 0 {
    run digits.append(48)
  }
  while rest > 0 {
    run digits.append(usize.toU8(rest % 10) + 48)
    rest = rest / 10
  }
  let mut out = String.make()
  let mut i = digits.length()
  while i > 0 {
    i = i - 1
    let one: [u8; 1] = [digits.get(i)]
    run out.append(String.fromUtf8(&one).unwrapOr(""))
  }
  return move out
}

/// The object attributes of `node` (`GetAttributes`).
pub effect fn attributes(node: &NodeRef<'_>, out: &mut List<Attribute>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match node.placeholder() {
    Option.Some { value } => {
      run out.append(Attribute { key: "placeholder-text", value: run String.copy(value) })
    }
    Option.None => {}
  }
  match node.positionInSet() {
    Option.Some { value } => {
      run out.append(Attribute { key: "posinset", value: run decimal(value + 1) })
    }
    Option.None => {}
  }
  match node.sizeOfSetFromContainer(&CommonFilter {}) {
    Option.Some { value } => {
      run out.append(Attribute { key: "setsize", value: run decimal(value) })
    }
    Option.None => {}
  }
  match node.htmlId() {
    Option.Some { value } => {
      run out.append(Attribute { key: "id", value: run String.copy(value) })
    }
    Option.None => {}
  }
  match node.brailleLabel() {
    Option.Some { value } => {
      run out.append(Attribute { key: "braillelabel", value: run String.copy(value) })
    }
    Option.None => {}
  }
  match node.brailleRoleDescription() {
    Option.Some { value } => {
      run out.append(Attribute { key: "brailleroledescription", value: run String.copy(value) })
    }
    Option.None => {}
  }
}

/// The extents of `node` in `coordType` coordinates, clipped to the window for the root.
pub fn extents(node: &NodeRef<'_>, bounds: &WindowBounds, coordType: CoordType) -> Option<Rect> {
  let mut box = node.boundingBox()
  if node.isRoot() {
    let window = Rect.make(0.0, 0.0, bounds.inner.width(), bounds.inner.height())
    if !window.isEmpty() {
      box = match box {
        Option.Some { value } => Option.Some {
          value: Rect.make(
            f64.min(value.x0, window.x1),
            f64.min(value.y0, window.y1),
            f64.min(value.x1, window.x1),
            f64.min(value.y1, window.y1),
          ),
        }
        Option.None => Option.Some { value: window }
      }
    }
  }
  return match box {
    Option.Some { value } => {
      let origin = bounds.toAtspi(
        Point.make(value.x0, value.y0),
        node.filteredParent(&CommonFilter {}),
        coordType,
      )
      Option.Some {
        value: Rect.make(origin.x, origin.y, origin.x + value.width(), origin.y + value.height()),
      }
    }
    Option.None => Option.None
  }
}
