//! `Tree`: the retained UI tree, like a small DOM. You make nodes, put them in each other,
//! style them, feed input in and read events out, and ask for a frame to draw.
//!
//! ```silk
//! let mut tree = run Tree.make(&fonts)
//! let root = run tree.box(&[Property.Padding { side: Side.Top, value: Length.px(16.0) }])
//! let hello = run tree.text("Hello")
//! run tree.append(root, hello)
//! run tree.setRoot(root)
//! let frame = run tree.frame(Viewport { width: 800.0, height: 600.0, scale: 2.0 }, 0.0)
//! ```
//!
//! A remote or JavaScript host drives the same tree with plain-data mutations through
//! [`Tree.apply`], naming nodes with ids of its own.
import engine { UiTree, TreeError as RawError }
import error { TreeError, ProtocolError }
import id {
  NodeId,
  Node,
  Parent,
  Textual,
  Sourced,
  BoxNode,
  TextNode,
  ImageNode,
  IconNode,
  InputNode,
  CanvasNode,
  FontFamily,
  Resource
}
import event { Input, EventRecord, Selection, HostRequest, listenFlags }
import mutation {
  Mutation,
  NodeKind,
  StyleState,
  Property,
  Display,
  Attribute,
  Role,
  Cursor,
  CanvasCommand
}
import node { NONE, FrameInput, FrameStats, Event as RawEvent, EventKind, Pending }
import edit { HostRequest as RawHostRequest, Keymap, ImeArea }
import grid { Grid }
import style { Computed }
import virtual_list { VirtualOptions, VirtualItem }
import anchoring { AnchorOptions }
import inspect
import inspect { FragmentInfo, DescribeOptions }
import layout.lib { Fragmentainers }
import codec.image { Image }
import atlas.atlas { AtlasTile }
import font_collection.lib { FontCollection }
import ui_scene.scene { Scene }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.geometry.rect { Rect }
import silk.geometry.vector { Vector2 }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.usize
import silk.text.string { String }

/// What a frame is drawn at: the size in CSS pixels and the device pixels per CSS pixel.
pub struct Viewport {
  pub width: f32,
  pub height: f32,
  pub scale: f32,
}

impl Copy for Viewport {}

/// What `Tree.frame` made, for the host to draw and act on.
pub struct Frame<'t> {
  /// The finished scene.
  pub scene: &'t Scene,
  /// The atlas tiles this frame allocated, with their pixels, for the renderer to copy into
  /// its textures. Call `Tree.clearUploads` once they are copied.
  pub uploads: &'t Pending,
  /// The cursor for what the pointer is over.
  pub cursor: Cursor,
  /// Whether a text field has focus, and where its caret is, for the input method.
  pub ime: ImeArea,
  /// When the tree wants another frame without new input (a caret blink), in the seconds of
  /// the `time` given to `frame`.
  pub wakeAt: Option<f64>,
  /// Whether the tree wants another frame right away (a scroll animation runs, or a virtual
  /// list asked for other items).
  pub again: bool,
  pub stats: FrameStats,
}

/// An item of a virtual list: the box mounted for logical index `index`.
pub struct ListItem {
  pub index: usize,
  pub node: NodeId,
}

impl Copy for ListItem {}

/// The items a virtual list wants mounted.
pub struct VirtualRange {
  /// The logical number of items.
  pub count: usize,
  /// The first wanted index, and one past the last.
  pub first: usize,
  pub end: usize,
  /// The item that holds focus, which stays mounted outside the range.
  pub pinned: Option<ListItem>,
}

impl Copy for VirtualRange {}

/// The interaction state of a node.
pub struct NodeState {
  pub hovered: bool,
  pub pressed: bool,
  pub focused: bool,
  /// Focused, and the focus came from the keyboard (CSS `:focus-visible`).
  pub focusVisible: bool,
  pub scrollX: f32,
  pub scrollY: f32,
}

impl Copy for NodeState {}

/// A snapshot of one node, for inspectors and tests: what it is, what the client set on it
/// and what the tree made of that.
pub struct NodeView {
  pub id: NodeId,
  pub kind: NodeKind,
  pub parent: Option<NodeId>,
  pub accessRole: Role,
  /// The accessible name set with `Attribute.Label`.
  pub label: String,
  pub testId: String,
  /// The value of a text or input node.
  pub text: String,
  pub tabIndex: i32,
  pub cursor: Cursor,
  pub disabled: bool,
  pub checked: bool,
  pub selected: bool,
  pub expanded: bool,
  pub state: NodeState,
  /// The union of the border boxes of the node's fragments, when layout gave it any.
  pub bounds: Option<Rect<f32>>,
  /// The style the client set for each state.
  pub base: List<Property>,
  pub hover: List<Property>,
  pub active: List<Property>,
  pub focus: List<Property>,
  pub focusVisible: List<Property>,
  /// The resolved style.
  pub computed: Computed,
  listeners: u32,
}

impl NodeView {
  /// Whether the node listens for events of `kind`.
  pub fn listens(self: &Self, kind: EventKind) -> bool {
    return (self.listeners & listenFlags(&[kind])) != 0
  }
}

/// The retained UI tree.
pub struct Tree<'a> {
  core: UiTree<'a>,
  nextId: u32,
  nextFamily: u32,
  nextResource: u32,
}

effect fn failed(error: RawError) -> never
  ! TreeError {
  fail TreeError.lift(error)
}

effect fn batchFailed(error: RawError) -> never
  ! ProtocolError {
  fail ProtocolError.lift(error)
}

effect fn copyProperties(values: &[Property]) -> List<Property>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = List<Property>.make()
  let mut i: usize = 0
  while i < values.length {
    run out.append(values[i])
    i = i + 1
  }
  return move out
}

effect fn copyBytes(data: &[u8]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut bytes = Bytes.make()
  run Bytes.append(&mut bytes, data)
  return move bytes
}

effect fn liftIds(values: &List<u32>) -> List<NodeId>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = List<NodeId>.make()
  let mut i: usize = 0
  while i < values.length() {
    run out.append(NodeId.of(values.get(i)))
    i = i + 1
  }
  return move out
}

impl<'a> Tree<'a> {
  /// An empty tree that shapes text with the fonts of `fonts`.
  pub effect fn make(fonts: &'a FontCollection) -> Tree<'a>
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let core = run Effect.catch<RawError>(UiTree.make(fonts), failed)
    return Tree { core: move core, nextId: 1, nextFamily: 1, nextResource: 1 }
  }

  effect fn one(self: &mut Self, mutation: Mutation) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run Effect.catch<RawError>(self.core.applyOne(0, move mutation), failed)
  }

  fn freshId(self: &mut Self) -> u32 {
    while self.nextId == NONE || self.core.contains(self.nextId) {
      self.nextId = if self.nextId == NONE {
        1
      } else {
        self.nextId + 1
      }
    }
    let id = self.nextId
    self.nextId = id + 1
    return id
  }

  effect fn create(self: &mut Self, kind: NodeKind) -> NodeId
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let id = self.freshId()
    run self.one(Mutation.Create { id: id, kind: kind })
    return NodeId.of(id)
  }

  // Making nodes. A new node is detached until it is appended or made the root.

  /// A box with base style `style`.
  pub effect fn box(self: &mut Self, style: &[Property]) -> BoxNode
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let id = run self.create(NodeKind.Box)
    run self.setStyle(id, style)
    return BoxNode.of(id)
  }

  /// An inline box, for styling a run of text inside a sentence (`display: inline`, then
  /// `style`).
  pub effect fn span(self: &mut Self, style: &[Property]) -> BoxNode
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let id = run self.create(NodeKind.Box)
    run self.setStyle(id, &[Property.Display { value: Display.Inline }])
    run self.setStyle(id, style)
    return BoxNode.of(id)
  }

  /// A text leaf holding `value`. Text takes its look from its parent.
  pub effect fn text(self: &mut Self, value: string) -> TextNode
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let id = run self.create(NodeKind.Text)
    run self.one(Mutation.SetText { id: id.raw(), value: run String.copy(value) })
    return TextNode.of(id)
  }

  /// An editable text field with base style `style`.
  pub effect fn input(self: &mut Self, style: &[Property]) -> InputNode
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let id = run self.create(NodeKind.Input)
    run self.setStyle(id, style)
    return InputNode.of(id)
  }

  /// An image showing `source`, with base style `style`.
  pub effect fn image(self: &mut Self, source: Resource, style: &[Property]) -> ImageNode
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let id = run self.create(NodeKind.Image)
    run self.setStyle(id, style)
    run self.one(Mutation.SetSource { id: id.raw(), resource: source.raw() })
    return ImageNode.of(id)
  }

  /// An icon showing `source`, with base style `style`.
  pub effect fn icon(self: &mut Self, source: Resource, style: &[Property]) -> IconNode
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let id = run self.create(NodeKind.Icon)
    run self.setStyle(id, style)
    run self.one(Mutation.SetSource { id: id.raw(), resource: source.raw() })
    return IconNode.of(id)
  }

  /// A canvas with base style `style`. Draw on it with [`Tree.setCanvas`].
  pub effect fn canvas(self: &mut Self, style: &[Property]) -> CanvasNode
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let id = run self.create(NodeKind.Canvas)
    run self.setStyle(id, style)
    return CanvasNode.of(id)
  }

  // Structure.

  /// Makes `node` the root, filling the viewport. The previous root is detached.
  pub effect fn setRoot<N: Node>(self: &mut Self, node: N) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.one(Mutation.SetRoot { id: node.id().raw() })
  }

  /// Puts `child` last in `parent`. A child already in the tree moves, as in the DOM.
  pub effect fn append<P: Node + Parent, C: Node>(self: &mut Self, parent: P, child: C) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.one(
      Mutation.InsertBefore {
        parent: parent.id().raw(),
        child: child.id().raw(),
        before: Option<u32>.None,
      },
    )
  }

  /// Puts `child` in `parent` before `before`.
  pub effect fn insertBefore<P: Node + Parent, C: Node, B: Node>(
    self: &mut Self,
    parent: P,
    child: C,
    before: B,
  ) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.one(
      Mutation.InsertBefore {
        parent: parent.id().raw(),
        child: child.id().raw(),
        before: Option<u32>.Some { value: before.id().raw() },
      },
    )
  }

  /// Detaches `node` and its subtree from its parent. It can be appended again.
  pub effect fn remove<N: Node>(self: &mut Self, node: N) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.one(Mutation.Remove { id: node.id().raw() })
  }

  /// Detaches and frees `node` and its whole subtree. Their handles are stale afterwards.
  pub effect fn destroy<N: Node>(self: &mut Self, node: N) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.one(Mutation.Destroy { id: node.id().raw() })
  }

  // Style.

  /// Sets `style` in the base look of `node`, each property replacing its earlier value.
  pub effect fn setStyle<N: Node>(self: &mut Self, node: N, style: &[Property]) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.setStyleFor(node.id(), StyleState.Base, style)
  }

  /// Sets `style` in the look `node` has while in `state` (hover, active, focus,
  /// focus-visible).
  pub effect fn setStyleFor<N: Node>(
    self: &mut Self,
    node: N,
    state: StyleState,
    style: &[Property],
  ) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if style.length == 0 {
      return ()
    }
    run self.one(
      Mutation.SetStyle {
        id: node.id().raw(),
        state: state,
        properties: run copyProperties(style),
      },
    )
  }

  /// Forgets every property set in the `state` look of `node`.
  pub effect fn clearStyle<N: Node>(self: &mut Self, node: N, state: StyleState) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.one(Mutation.ClearStyle { id: node.id().raw(), state: state })
  }

  /// Replaces the grid template and item placement of `node`.
  pub effect fn setGrid<N: Node + Parent>(self: &mut Self, node: N, grid: &Grid) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.one(Mutation.SetGrid { id: node.id().raw(), value: run grid.copy() })
  }

  // Content.

  /// Sets the value of a text or input node. An input whose value changes puts its caret at
  /// the end; setting the value it already has changes nothing, so a client can echo every
  /// `Event.Input` back (a controlled input).
  pub effect fn setText<N: Node + Textual>(self: &mut Self, node: N, value: string) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.one(Mutation.SetText { id: node.id().raw(), value: run String.copy(value) })
  }

  /// Points an image or icon at `source`.
  pub effect fn setSource<N: Node + Sourced>(self: &mut Self, node: N, source: Resource) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.one(Mutation.SetSource { id: node.id().raw(), resource: source.raw() })
  }

  /// Replaces the drawing of `canvas`.
  pub effect fn setCanvas(self: &mut Self, canvas: CanvasNode, commands: &[CanvasCommand]) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut list = List<CanvasCommand>.make()
    let mut i: usize = 0
    while i < commands.length {
      run list.append(commands[i])
      i = i + 1
    }
    run self.one(Mutation.SetCanvas { id: canvas.id().raw(), commands: move list })
  }

  // Attributes and listeners.

  pub effect fn setAttribute<N: Node>(self: &mut Self, node: N, attribute: Attribute) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.one(Mutation.SetAttribute { id: node.id().raw(), attribute: move attribute })
  }

  /// Sets the accessible name of `node`.
  pub effect fn setLabel<N: Node>(self: &mut Self, node: N, value: string) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.setAttribute(node.id(), Attribute.Label { value: run String.copy(value) })
  }

  /// Sets the stable name tests and inspectors find `node` by.
  pub effect fn setTestId<N: Node>(self: &mut Self, node: N, value: string) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.setAttribute(node.id(), Attribute.TestId { value: run String.copy(value) })
  }

  pub effect fn setRole<N: Node>(self: &mut Self, node: N, value: Role) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.setAttribute(node.id(), Attribute.Role { value: value })
  }

  /// Says which events `node` wants records for, replacing what it listened for before. An
  /// empty list stops listening.
  pub effect fn listen<N: Node>(self: &mut Self, node: N, kinds: &[EventKind]) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.one(Mutation.SetListeners { id: node.id().raw(), flags: listenFlags(kinds) })
  }

  // Focus, selection and scrolling.

  pub effect fn focus<N: Node>(self: &mut Self, node: N) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.one(Mutation.Focus { id: node.id().raw() })
  }

  pub effect fn blur(self: &mut Self) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.one(Mutation.Blur)
  }

  /// The focused node.
  pub fn focused(self: &Self) -> Option<NodeId> {
    if self.core.focused == NONE {
      return Option<NodeId>.None
    }
    return Option<NodeId>.Some { value: NodeId.of(self.core.node(self.core.focused).id) }
  }

  /// Selects `selection` in the value of `input`. Offsets are clamped to the value and moved
  /// back to a character boundary.
  pub effect fn select(self: &mut Self, input: InputNode, selection: Selection) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.one(
      Mutation.SetSelection {
        id: input.id().raw(),
        anchor: selection.anchor,
        focus: selection.focus,
      },
    )
  }

  /// The selection of `input`, when it exists and is an input.
  pub fn selection<N: Node>(self: &Self, input: N) -> Option<Selection> {
    let slot = self.core.slotOf(input.id().raw())
    if slot == NONE || self.core.node(slot).kind != NodeKind.Input {
      return Option<Selection>.None
    }
    let range = self.core.selection(input.id().raw())
    return Option<Selection>.Some { value: Selection.range(range.x, range.y) }
  }

  /// The caret rectangle of `input` in CSS pixels of the viewport, from the last layout.
  pub effect fn caretRect<N: Node>(self: &Self, input: N) -> Option<Rect<f32>>
    ! OutOfMemoryError
    ? &mut Allocator {
    let slot = self.core.slotOf(input.id().raw())
    if slot == NONE || self.core.node(slot).kind != NodeKind.Input {
      return Option<Rect<f32>>.None
    }
    return Option<Rect<f32>>.Some { value: run self.core.caretRect(input.id().raw()) }
  }

  /// Scrolls the scroll container `node` to (`x`, `y`) in CSS pixels, clamped to its scroll
  /// range at the next frame.
  pub effect fn scrollTo<N: Node>(self: &mut Self, node: N, x: f32, y: f32) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.one(Mutation.ScrollTo { id: node.id().raw(), x: x, y: y })
  }

  /// At the next frame, scrolls the containers around `node` the least that brings it into
  /// view, as `scrollIntoView({ block: "nearest" })`.
  pub effect fn scrollIntoView<N: Node>(self: &mut Self, node: N) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.one(Mutation.ScrollIntoView { id: node.id().raw() })
  }

  /// The scroll offset of `node`, when it exists.
  pub fn scrollOffset<N: Node>(self: &Self, node: N) -> Option<Vector2<f32>> {
    if !self.core.contains(node.id().raw()) {
      return Option<Vector2<f32>>.None
    }
    return Option<Vector2<f32>>.Some { value: self.core.scrollOffset(node.id().raw()) }
  }

  /// Tells the tree that `node` was scrolled to (`x`, `y`) outside it, as a compositor
  /// scrolls the last frame: the tree takes the offset and tells scroll listeners.
  pub effect fn scrolledElsewhere<N: Node>(self: &mut Self, node: N, x: f32, y: f32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.core.scrolledElsewhere(node.id().raw(), x, y)
  }

  // Virtual lists and anchored popups.

  /// Makes the bounded column `list` a virtual list of `count` items. The tree owns the
  /// spacers, measurement, scroll anchoring and focus retention; mount the items
  /// [`Tree.virtualRange`] asks for and bind them with [`Tree.setVirtualItems`].
  pub effect fn setVirtualList(
    self: &mut Self,
    list: BoxNode,
    count: usize,
    options: VirtualOptions,
  ) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.one(Mutation.SetVirtualList { id: list.id().raw(), count: count, options: options })
  }

  /// Binds every direct child box of `list` to its logical index, in increasing order.
  pub effect fn setVirtualItems(self: &mut Self, list: BoxNode, items: &[ListItem]) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut bound = List<VirtualItem>.make()
    let mut i: usize = 0
    while i < items.length {
      run bound.append(VirtualItem { index: items[i].index, id: items[i].node.raw() })
      i = i + 1
    }
    run self.one(Mutation.SetVirtualItems { id: list.id().raw(), items: move bound })
  }

  /// Removes the virtual list from `list`, leaving its child nodes.
  pub effect fn clearVirtualList(self: &mut Self, list: BoxNode) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.one(Mutation.ClearVirtualList { id: list.id().raw() })
  }

  /// The items the virtual list on `list` wants mounted after the latest configuration or
  /// frame. Mount them, bind them, and ask for a frame again.
  pub fn virtualRange(self: &Self, list: BoxNode) -> Option<VirtualRange> {
    return match self.core.virtualRange(list.id().raw()) {
      Option.Some { value } => Option<VirtualRange>.Some {
        value: VirtualRange {
          count: value.count,
          first: value.first,
          end: value.end,
          pinned: if value.pinned == usize.MAX || value.pinnedId == NONE {
            Option<ListItem>.None
          } else {
            Option<ListItem>.Some {
              value: ListItem { index: value.pinned, node: NodeId.of(value.pinnedId) },
            }
          },
        },
      }
      Option.None => Option<VirtualRange>.None
    }
  }

  /// Places `popup` relative to `target` after each layout, flipping and shifting to stay in
  /// the viewport.
  pub effect fn anchor<N: Node>(
    self: &mut Self,
    popup: BoxNode,
    target: N,
    options: AnchorOptions,
  ) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.one(
      Mutation.SetAnchor { id: popup.id().raw(), target: target.id().raw(), options: options },
    )
  }

  /// Stops placing `popup` and restores its own styles.
  pub effect fn clearAnchor(self: &mut Self, popup: BoxNode) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.one(Mutation.ClearAnchor { id: popup.id().raw() })
  }

  // Resources.

  /// Defines a font family list from CSS `font-family` text, such as
  /// `"Inter, Noto Sans, sans-serif"`, for `Property.FontFamily`.
  pub effect fn fontFamily(self: &mut Self, names: string) -> FontFamily
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let family = self.nextFamily
    self.nextFamily = family + 1
    run self.one(Mutation.DefineFontFamily { family: family, names: run String.copy(names) })
    return FontFamily.of(family)
  }

  fn freshResource(self: &mut Self) -> u32 {
    let mut resource = self.nextResource
    while resource == NONE || self.core.resources.get(resource).isSome() {
      resource = if resource == NONE {
        1
      } else {
        resource + 1
      }
    }
    self.nextResource = resource + 1
    return resource
  }

  /// Decodes the PNG or JPEG file `data` as an image resource.
  pub effect fn defineImage(self: &mut Self, data: &[u8]) -> Resource
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let resource = self.freshResource()
    run self.one(Mutation.DefineImage { resource: resource, data: run copyBytes(data) })
    return Resource.of(resource)
  }

  /// Installs decoded, premultiplied sRGB pixels as an image resource.
  pub effect fn defineDecodedImage(self: &mut Self, image: Image) -> Resource
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let resource = self.freshResource()
    run self.one(Mutation.DefineDecodedImage { resource: resource, image: move image })
    return Resource.of(resource)
  }

  /// Parses the SVG file `data` as an icon resource.
  pub effect fn defineIcon(self: &mut Self, data: &[u8]) -> Resource
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let resource = self.freshResource()
    run self.one(Mutation.DefineIcon { resource: resource, data: run copyBytes(data) })
    return Resource.of(resource)
  }

  /// Releases `resource`. Nodes that show it become empty.
  pub effect fn release(self: &mut Self, resource: Resource) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.one(Mutation.ReleaseResource { resource: resource.raw() })
  }

  /// The atlas tile of an image resource, for custom scene composition.
  pub effect fn imageTile(self: &mut Self, resource: Resource) -> Option<AtlasTile>
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.core.imageTile(resource.raw())
  }

  // The mutation protocol.

  /// Applies `batch` in order, as a remote or JavaScript host sends it. Node, font family
  /// and resource ids in it are the client's own numbers. On a bad mutation it stops and
  /// fails with its index; the mutations before it stay applied.
  pub effect fn apply(self: &mut Self, batch: List<Mutation>) -> ()
    ! ProtocolError | OutOfMemoryError
    ? &mut Allocator {
    run Effect.catch<RawError>(self.core.apply(move batch), batchFailed)
  }

  // Input and events.

  /// Feeds one input to the tree: hit testing against the last frame, hover and active
  /// states, pointer capture, focus, tab order, keyboard clicks, scrolling and editing, and
  /// the event records for listeners. State changes show at the next frame.
  pub effect fn dispatch(self: &mut Self, input: Input) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.core.dispatch(input.lower())
  }

  /// Takes the queued event records, oldest first.
  pub effect fn events(self: &mut Self) -> List<EventRecord>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut raw = List<RawEvent>.make()
    run self.core.takeEvents(&mut raw)
    let mut out = List<EventRecord>.make()
    let records = raw.asSlice()
    let mut i: usize = 0
    while i < records.length {
      run out.append(run EventRecord.lift(&records[i]))
      i = i + 1
    }
    return move out
  }

  /// Takes the queued requests for the host (clipboard reads and writes), oldest first.
  pub effect fn requests(self: &mut Self) -> List<HostRequest>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut raw = List<RawHostRequest>.make()
    run self.core.takeRequests(&mut raw)
    let mut reversed = List<HostRequest>.make()
    while true {
      match raw.pop() {
        Option<RawHostRequest>.Some { value } => {
          run reversed.append(HostRequest.lift(move value))
        }
        Option<RawHostRequest>.None => {
          break
        }
      }
    }
    let mut out = List<HostRequest>.make()
    while true {
      match reversed.pop() {
        Option<HostRequest>.Some { value } => {
          run out.append(move value)
        }
        Option<HostRequest>.None => {
          break
        }
      }
    }
    return move out
  }

  /// Which modifier keys editing shortcuts use. The default is the platform's.
  pub fn setKeymap(self: &mut Self, keymap: Keymap) -> () {
    self.core.keymap = keymap
  }

  // Frames.

  /// Whether a frame would draw something new. Hosts that draw only on demand ask after
  /// changing the tree and dispatching input.
  pub fn needsFrame(self: &Self) -> bool {
    return self.core.needsFrame()
  }

  /// Applies styles, lays out what changed and paints. `time` is in seconds, on any clock
  /// that only moves forward.
  pub effect fn frame<'t>(self: &'t mut Self, viewport: Viewport, time: f64) -> Frame<'t>
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run Effect.catch<RawError>(
      self.core.frame(
        FrameInput {
          width: viewport.width,
          height: viewport.height,
          scale: viewport.scale,
          time: time,
        },
      ),
      failed,
    )
    return run self.lastFrame()
  }

  /// Lays out and paints the pages or columns in `frames`. Geometry queries describe this
  /// output until the next frame; `frame` resumes continuous layout. A tree with virtual
  /// lists fails with `TreeError.Layout`.
  pub effect fn frameFragmented<'t>(
    self: &'t mut Self,
    viewport: Viewport,
    time: f64,
    frames: Fragmentainers<'_>,
  ) -> Frame<'t>
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run Effect.catch<RawError>(
      self.core.frameFragmented(
        FrameInput {
          width: viewport.width,
          height: viewport.height,
          scale: viewport.scale,
          time: time,
        },
        move frames,
      ),
      failed,
    )
    return run self.lastFrame()
  }

  /// The last frame again, without painting.
  pub effect fn lastFrame<'t>(self: &'t Self) -> Frame<'t>
    ! OutOfMemoryError
    ? &mut Allocator {
    let blink = self.core.nextBlink()
    return Frame {
      scene: self.core.scene(),
      uploads: self.core.pendingUploads(),
      cursor: self.core.cursor(),
      ime: run self.core.imeArea(),
      wakeAt: if blink < 0.0 {
        Option<f64>.None
      } else {
        Option<f64>.Some { value: blink }
      },
      again: self.core.needsFrame(),
      stats: self.core.stats,
    }
  }

  /// Forgets the uploads of the last frames, once the renderer copied them.
  pub fn clearUploads(self: &mut Self) -> () {
    self.core.clearUploads()
  }

  /// Forces the next frame to paint everything again.
  pub fn invalidatePaint(self: &mut Self) -> () {
    self.core.invalidatePaint()
  }

  /// Whether styles or layout inputs changed since the last layout.
  pub fn layoutPending(self: &Self) -> bool {
    return self.core.layoutPending()
  }

  /// Resolves styles and lays out now, at the last frame's size, so geometry queries between
  /// frames see the current tree. The next frame paints as usual.
  pub effect fn layoutNow(self: &mut Self) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run Effect.catch<RawError>(self.core.layoutNow(), failed)
  }

  // Queries. They answer from the last layout.

  pub fn contains<N: Node>(self: &Self, node: N) -> bool {
    return self.core.contains(node.id().raw())
  }

  /// The number of live nodes.
  pub fn nodeCount(self: &Self) -> usize {
    return self.core.nodeCount()
  }

  pub fn root(self: &Self) -> Option<NodeId> {
    let id = self.core.rootId()
    if id == NONE {
      return Option<NodeId>.None
    }
    return Option<NodeId>.Some { value: NodeId.of(id) }
  }

  /// The kind of `node`, when it exists.
  pub fn kind<N: Node>(self: &Self, node: N) -> Option<NodeKind> {
    let slot = self.core.slotOf(node.id().raw())
    if slot == NONE {
      return Option<NodeKind>.None
    }
    return Option<NodeKind>.Some { value: self.core.node(slot).kind }
  }

  pub fn parent<N: Node>(self: &Self, node: N) -> Option<NodeId> {
    let slot = self.core.slotOf(node.id().raw())
    if slot == NONE || self.core.node(slot).parent == NONE {
      return Option<NodeId>.None
    }
    return Option<NodeId>.Some { value: NodeId.of(self.core.node(self.core.node(slot).parent).id), }
  }

  /// The children of `node`, in order. Empty when it has none or does not exist.
  pub effect fn children<N: Node>(self: &Self, node: N) -> List<NodeId>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut raw = List<u32>.make()
    run inspect.childrenOf(&self.core, node.id().raw(), &mut raw)
    return run liftIds(&raw)
  }

  /// The node a pointer at (`x`, `y`) would target.
  pub fn hitTest(self: &Self, x: f32, y: f32) -> Option<NodeId> {
    let id = self.core.hitTest(x, y)
    if id == NONE {
      return Option<NodeId>.None
    }
    return Option<NodeId>.Some { value: NodeId.of(id) }
  }

  /// The union of the border boxes of `node`'s fragments in CSS pixels of the viewport, when
  /// layout gave it any.
  pub effect fn bounds<N: Node>(self: &Self, node: N) -> Option<Rect<f32>>
    ! OutOfMemoryError
    ? &mut Allocator {
    return match run inspect.info(&self.core, node.id().raw()) {
      Option.Some { value } => if value.laidOut {
        Option<Rect<f32>>.Some { value: value.bounds }
      } else {
        Option<Rect<f32>>.None
      }
      Option.None => Option<Rect<f32>>.None
    }
  }

  /// The layout fragments of `node`, in order: one per line for inline boxes and text.
  pub effect fn fragments<N: Node>(self: &Self, node: N) -> List<FragmentInfo>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut out = List<FragmentInfo>.make()
    let slot = self.core.slotOf(node.id().raw())
    if slot != NONE {
      run inspect.fragmentsOf(&self.core, slot, &mut out)
    }
    return move out
  }

  /// The nodes whose test id, label or text equals `value`, in tree order.
  pub effect fn find(self: &Self, value: string) -> List<NodeId>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut raw = List<u32>.make()
    run inspect.findAll(&self.core, value, &mut raw)
    return run liftIds(&raw)
  }

  /// A snapshot of `node` for inspectors and tests, when it exists.
  pub effect fn view<N: Node>(self: &Self, node: N) -> Option<NodeView>
    ! OutOfMemoryError
    ? &mut Allocator {
    let id = node.id()
    let slot = self.core.slotOf(id.raw())
    if slot == NONE {
      return Option<NodeView>.None
    }
    let n = self.core.node(slot)
    let focused = self.core.focused == slot
    return Option<NodeView>.Some {
      value: NodeView {
        id: id,
        kind: n.kind,
        parent: self.parent(id),
        accessRole: n.accessRole,
        label: run String.copy(String.view(&n.label)),
        testId: run String.copy(String.view(&n.testId)),
        text: run String.copy(String.view(&n.text)),
        tabIndex: n.tabIndex,
        cursor: n.cursor,
        disabled: n.disabled,
        checked: n.checked,
        selected: n.selected,
        expanded: n.expanded,
        state: NodeState {
          hovered: n.hovered,
          pressed: n.pressed,
          focused: focused,
          focusVisible: focused && self.core.focusVisible,
          scrollX: n.scrollX,
          scrollY: n.scrollY,
        },
        bounds: run self.bounds(id),
        base: run copyProperties(n.base.asSlice()),
        hover: run copyProperties(n.hover.asSlice()),
        active: run copyProperties(n.active.asSlice()),
        focus: run copyProperties(n.focus.asSlice()),
        focusVisible: run copyProperties(n.focusVisible.asSlice()),
        computed: n.computed,
        listeners: n.listeners,
      },
    }
  }

  /// A text snapshot of the tree from the root down: one line per node, indented by depth,
  /// with its kind, id, role, label, test id, text, focus and border box. It depends only on
  /// the tree and its last layout, so tests compare it as a golden.
  pub effect fn describe(self: &Self, options: DescribeOptions) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut out = String.make()
    run inspect.describe(&self.core, options, &mut out)
    return move out
  }

  /// [`Tree.describe`] of the subtree of `node`.
  pub effect fn describeNode<N: Node>(self: &Self, node: N, options: DescribeOptions) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut out = String.make()
    run inspect.describeNodeById(&self.core, node.id().raw(), options, &mut out)
    return move out
  }

  /// What the last frame did, for tests, benchmarks and inspectors.
  pub fn stats(self: &Self) -> FrameStats {
    return self.core.stats
  }

  // The engine underneath.

  /// The engine this tree wraps, for the packages of this repository that are not ported to
  /// `Tree` yet (the window host, the inspector, the CPU snapshot). It will go away; new code
  /// should not use it.
  pub fn engine(self: &Self) -> &UiTree<'a> {
    return &self.core
  }

  pub fn engineMut(self: &mut Self) -> &mut UiTree<'a> {
    return &mut self.core
  }
}
