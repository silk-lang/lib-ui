//! Node ids and the typed handles `Tree` returns for each kind of node.
//!
//! A `NodeId` is one number. A tree driven through the mutation protocol uses the ids its
//! client chose; a tree driven directly hands out ids of its own. Handles such as `BoxNode`
//! wrap an id and say what kind the node is, so `tree.append(text, child)` or
//! `tree.setText(box, "x")` is a compile error and not a runtime one.
import silk.core.ownership { Copy }

/// The id of a node. The number is what `describe` prints (`box #1`) and what the inspector
/// protocol sends.
pub struct NodeId {
  value: u32,
}

impl Copy for NodeId {}

impl NodeId {
  /// The id with number `raw`, for a node a protocol client created or an id read off the wire.
  pub fn of(raw: u32) -> NodeId {
    return NodeId { value: raw }
  }

  pub fn raw(self: Self) -> u32 {
    return self.value
  }

  /// Whether `other` names this node.
  pub fn is<N: Node>(self: Self, other: N) -> bool {
    return self.value == other.id().value
  }
}

/// Anything that names a node: every handle, and a bare `NodeId`.
pub interface Node {
  fn id(self: &Self) -> NodeId
}

/// A node that takes children.
pub interface Parent {}

/// A node that holds a text value.
pub interface Textual {}

/// A node that shows a resource.
pub interface Sourced {}

/// A box: the `div` of the tree. An inline span is a box too.
pub struct BoxNode {
  node: NodeId,
}

/// A text leaf.
pub struct TextNode {
  node: NodeId,
}

/// A decoded image.
pub struct ImageNode {
  node: NodeId,
}

/// An SVG icon tinted with the text color.
pub struct IconNode {
  node: NodeId,
}

/// An editable text field.
pub struct InputNode {
  node: NodeId,
}

/// A surface the client draws with canvas commands.
pub struct CanvasNode {
  node: NodeId,
}

impl Copy for BoxNode {}

impl Copy for TextNode {}

impl Copy for ImageNode {}

impl Copy for IconNode {}

impl Copy for InputNode {}

impl Copy for CanvasNode {}

impl BoxNode {
  /// The handle for a box known only by id, such as an event target. The tree checks the
  /// kind when the handle is used.
  pub fn of(id: NodeId) -> BoxNode {
    return BoxNode { node: id }
  }

  pub fn id(self: Self) -> NodeId {
    return self.node
  }
}

impl TextNode {
  pub fn of(id: NodeId) -> TextNode {
    return TextNode { node: id }
  }

  pub fn id(self: Self) -> NodeId {
    return self.node
  }
}

impl ImageNode {
  pub fn of(id: NodeId) -> ImageNode {
    return ImageNode { node: id }
  }

  pub fn id(self: Self) -> NodeId {
    return self.node
  }
}

impl IconNode {
  pub fn of(id: NodeId) -> IconNode {
    return IconNode { node: id }
  }

  pub fn id(self: Self) -> NodeId {
    return self.node
  }
}

impl InputNode {
  pub fn of(id: NodeId) -> InputNode {
    return InputNode { node: id }
  }

  pub fn id(self: Self) -> NodeId {
    return self.node
  }
}

impl CanvasNode {
  pub fn of(id: NodeId) -> CanvasNode {
    return CanvasNode { node: id }
  }

  pub fn id(self: Self) -> NodeId {
    return self.node
  }
}

impl Node for NodeId {
  fn id(self: &Self) -> NodeId {
    return self.*
  }
}

impl Node for BoxNode {
  fn id(self: &Self) -> NodeId {
    return self.node
  }
}

impl Node for TextNode {
  fn id(self: &Self) -> NodeId {
    return self.node
  }
}

impl Node for ImageNode {
  fn id(self: &Self) -> NodeId {
    return self.node
  }
}

impl Node for IconNode {
  fn id(self: &Self) -> NodeId {
    return self.node
  }
}

impl Node for InputNode {
  fn id(self: &Self) -> NodeId {
    return self.node
  }
}

impl Node for CanvasNode {
  fn id(self: &Self) -> NodeId {
    return self.node
  }
}

impl Parent for BoxNode {}

impl Textual for TextNode {}

impl Textual for InputNode {}

impl Sourced for ImageNode {}

impl Sourced for IconNode {}

/// A font family list defined with `Tree.fontFamily`.
pub struct FontFamily {
  value: u32,
}

impl Copy for FontFamily {}

impl FontFamily {
  pub fn of(raw: u32) -> FontFamily {
    return FontFamily { value: raw }
  }

  /// The number `Property.FontFamily` takes.
  pub fn raw(self: Self) -> u32 {
    return self.value
  }
}

/// An image or icon resource defined with `Tree.defineImage` or `Tree.defineIcon`.
pub struct Resource {
  value: u32,
}

impl Copy for Resource {}

impl Resource {
  pub fn of(raw: u32) -> Resource {
    return Resource { value: raw }
  }

  pub fn raw(self: Self) -> u32 {
    return self.value
  }
}
