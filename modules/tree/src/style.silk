      CssProperty.TextOrientation => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.textOrientationOf(word) {
              Option.Some { value: found } => {
                self.text.textOrientation = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.TextAlignLast => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.textAlignOf(word) {
              Option.Some { value: found } => {
                self.text.textAlignLast = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.TextWrapMode => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.textWrapOf(word) {
              Option.Some { value: found } => {
                self.text.textWrap = found
              }
              Option.None => {}
