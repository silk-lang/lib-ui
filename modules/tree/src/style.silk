              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.Float => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.floatOf(word) {
              Option.Some { value: found } => {
                self.layout.float = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.Clear => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.clearOf(word) {
              Option.Some { value: found } => {
                self.layout.clear = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.WritingMode => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.writingModeOf(word) {
              Option.Some { value: found } => {
                self.text.writingMode = found
