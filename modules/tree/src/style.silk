//! Computed styles: the base look of a node with its active variants applied over it, and text
//! properties inherited from the parent. The layout part is a css-layout `Style`, written as
//! each declaration is applied; paint and text are css-properties' computed structs.
import mutation { Declaration, Value, Keyword, CssProperty, Cursor }
import layout.lib {
  Style as CssStyle,
  Edges,
  Dimension,
  DimensionKind,
  Overflow,
  TextWrap,
  WhiteSpaceCollapse,
  Visibility,
}
pub import properties.computed { Text as TextStyle, Paint, Fill, DisplayOutside, DisplayInside }
import properties.computed { BorderStyle, DecorationLine, WhiteSpace, ObjectFit, WritingMode, Direction }
import properties.convert { Context }
import timing { TransitionLists, AnimationLists }
import transform { Transform }
import timing
import properties.values { Unit }
import properties.convert
import properties.keyword_enums
import properties.keywords
import silk.collections.hash { Hash, HashSeed }
import silk.color.rgba { Rgba }
import silk.core.option { Option }
import silk.collections.bytes { Bytes }
import silk.core.ownership { Copy }
import silk.core.equal { Equal }
import silk.geometry.insets { Insets }
import silk.geometry.rect { Rect }
import silk.num.f32
import silk.num.u8
import silk.num.u32
import silk.num.u64

/// A node's computed style.
pub struct Computed {
  /// What css-layout reads. The inherited text properties and the border widths reach it in
  /// [`Computed.finish`].
  pub layout: CssStyle,
  /// What only the tree paints. `paint.border` holds the widths as set; `border-style: none`
  /// lays out as zero.
  pub paint: Paint,
  pub text: TextStyle,
  /// The viewport that `vw`, `vh` and the other viewport units resolve against.
  pub viewportWidth: f32,
  pub viewportHeight: f32,
  /// A declaration used a viewport unit, so the style changes when the viewport does.
  pub usesViewport: bool,
  /// The `transition-*` lists.
  pub transition: TransitionLists,
  /// The `animation-*` lists.
  pub animation: AnimationLists,
  /// `transform`, `translate`, `rotate`, `scale`, their origin, `perspective` and its origin.
  pub transform: Transform,
  pub outline: Outline,
  pub scroll: ScrollStyle,
  /// The CSS `cursor`, when the node sets one other than `auto`. Hovering finds it on the
  /// node or the nearest ancestor that sets one, as inheritance would.
  pub cursor: Option<Cursor>,
}

impl Copy for Computed {}

fn viewportUnit(unit: Unit) -> bool {
  return unit == Unit.Vw || unit == Unit.Vh || unit == Unit.Vi || unit == Unit.Vb
    || unit == Unit.Vmin || unit == Unit.Vmax
    || unit == Unit.Svw || unit == Unit.Svh || unit == Unit.Svi || unit == Unit.Svb
    || unit == Unit.Svmin || unit == Unit.Svmax
    || unit == Unit.Lvw || unit == Unit.Lvh || unit == Unit.Lvi || unit == Unit.Lvb
    || unit == Unit.Lvmin || unit == Unit.Lvmax
    || unit == Unit.Dvw || unit == Unit.Dvh || unit == Unit.Dvi || unit == Unit.Dvb
    || unit == Unit.Dvmin || unit == Unit.Dvmax
}

/// Whether `value` has a viewport unit anywhere in it.
fn hasViewportUnit(value: &Value) -> bool {
  match &value.* {
    Value.Unit { value: _, unit } => {
      return viewportUnit(unit)
    }
    Value.Math { operator: _, values } => {
      return anyViewportUnit(values.asSlice())
    }
    Value.Function { name: _, values } => {
      return anyViewportUnit(values.asSlice())
    }
    Value.Sequence { separator: _, values } => {
      return anyViewportUnit(values.asSlice())
    }
    Value.Text { css } => {
      // A number followed by `v`, `sv`, `lv` or `dv` starts a viewport unit.
      let bytes = css.asSlice()
      let mut i: usize = 1
      while i < bytes.length {
        if (bytes[i] | 32) == 118 {
          let before = bytes[i - 1] | 32
          if isDigit(bytes[i - 1]) {
            return true
          }
          if i >= 2 && (before == 115 || before == 108 || before == 100) && isDigit(bytes[i - 2]) {
            return true
          }
        }
        i = i + 1
      }
      return false
    }
    _ => {
      return false
    }
  }
}

fn isDigit(byte: u8) -> bool {
  return byte >= 48 && byte <= 57
}

fn anyViewportUnit(items: &[Value]) -> bool {
  let mut i: usize = 0
  while i < items.length {
    if hasViewportUnit(&items[i]) {
      return true
    }
    i = i + 1
  }
  return false
}

/// `outline`: a ring `offset` outside the border box, drawn over the content.
pub struct Outline {
  pub width: f32,
  pub style: BorderStyle,
  /// `outline-style: auto`, the platform focus ring.
  pub auto: bool,
  pub color: Rgba<f32>,
  /// `outline-color: auto`: the focus ring color for an `auto` ring, the text color otherwise.
  pub colorAuto: bool,
  pub offset: f32,
}

impl Copy for Outline {}

impl Outline {
  pub fn initial() -> Outline {
    return Outline {
      width: 3.0,
      style: BorderStyle.None,
      auto: false,
      color: Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 1.0 },
      colorAuto: true,
      offset: 0.0,
    }
  }

  /// Whether the ring draws: it has a style and a width.
  pub fn drawn(self: &Self) -> bool {
    return (self.auto || self.style != BorderStyle.None) && self.width > 0.0
  }
}

/// `overscroll-behavior` per axis.
pub enum Overscroll {
  Auto,
  Contain,
  None,
}

impl Equal for Overscroll {
  fn equals(left: &Overscroll, right: &Overscroll) -> bool {
    return left.* == right.*
  }
}

/// What a scroll container does with scrolls: chaining, smooth programmatic scrolls, and the
/// scroll margin and padding `scrollIntoView` keeps clear.
pub struct ScrollStyle {
  pub overscrollX: Overscroll,
  pub overscrollY: Overscroll,
  /// `scroll-behavior: smooth`.
  pub smooth: bool,
  /// `scroll-margin` of the box, in pixels.
  pub margin: Insets<f32>,
  /// `scroll-padding` of the scroll container; `auto` is zero.
  pub padding: Edges,
}

impl Copy for ScrollStyle {}

impl ScrollStyle {
  pub fn initial() -> ScrollStyle {
    return ScrollStyle {
      overscrollX: Overscroll.Auto,
      overscrollY: Overscroll.Auto,
      smooth: false,
      margin: Insets<f32>.zero(),
      padding: Edges.all(Dimension.px(0.0)),
    }
  }
}

impl ScrollStyle {
  /// The part of scrollport `rect` that `scroll-padding` leaves for revealed boxes.
  pub fn port(self: &Self, rect: Rect<f32>) -> Rect<f32> {
    let w = rect.width()
    let h = rect.height()
    let p = self.padding
    let x0 = rect.xMin + p.left.value + p.left.percent * w
    let x1 = rect.xMax - p.right.value - p.right.percent * w
    let y0 = rect.yMin + p.top.value + p.top.percent * h
    let y1 = rect.yMax - p.bottom.value - p.bottom.percent * h
    return Rect<f32>.new(x0, y0, f32.max(x0, x1), f32.max(y0, y1))
  }

  /// Border box `rect` grown by `scroll-margin`: what revealing the box brings into view.
  pub fn target(self: &Self, rect: Rect<f32>) -> Rect<f32> {
    let m = self.margin
    return Rect<f32>.new(rect.xMin - m.left, rect.yMin - m.top, rect.xMax + m.right, rect.yMax + m.bottom)
  }
}

fn overscrollOf(value: &Value) -> Option<Overscroll> {
  return match convert.keywordOf(value) {
    Option.Some { value: word } => {
      if word == Keyword.Auto {
        Option<Overscroll>.some(Overscroll.Auto)
      } else if word == Keyword.Contain {
        Option<Overscroll>.some(Overscroll.Contain)
      } else if word == Keyword.None {
        Option<Overscroll>.some(Overscroll.None)
      } else {
        Option<Overscroll>.None
      }
    }
    Option.None => Option<Overscroll>.None
  }
}

fn setOverscroll(target: &mut Overscroll, value: &Value) -> () {
  match overscrollOf(value) {
    Option.Some { value: found } => {
      target.* = found
    }
    Option.None => {}
  }
}

/// The physical side (0 top, 1 right, 2 bottom, 3 left) of a logical one, as css-logical maps
/// it for the box's writing mode and direction.
fn physicalSide(mode: WritingMode, direction: Direction, block: bool, end: bool) -> usize {
  let rtl = direction == Direction.Rtl
  if mode == WritingMode.HorizontalTb {
    if block {
      return if end { 2 } else { 0 }
    }
    return if end != rtl { 1 } else { 3 }
  }
  if block {
    let rightFirst = mode == WritingMode.VerticalRl || mode == WritingMode.SidewaysRl
    return if end == rightFirst { 3 } else { 1 }
  }
  let bottomFirst = mode == WritingMode.SidewaysLr
  return if (end != rtl) != bottomFirst { 2 } else { 0 }
}

fn pickSide(side: usize, top: CssProperty, right: CssProperty, bottom: CssProperty, left: CssProperty) -> CssProperty {
  return if side == 0 { top } else if side == 1 { right } else if side == 2 { bottom } else { left }
}

/// The outline style keyword: the border styles, with the line styles the tree does not draw
/// painted as the nearest one it does.
fn outlineStyleOf(word: Keyword) -> Option<BorderStyle> {
  if word == Keyword.Dotted {
    return Option<BorderStyle>.some(BorderStyle.Dashed)
  }
  if word == Keyword.Double || word == Keyword.Groove || word == Keyword.Ridge
    || word == Keyword.Inset
    || word == Keyword.Outset {
    return Option<BorderStyle>.some(BorderStyle.Solid)
  }
  return keyword_enums.borderStyleOf(word)
}

fn setDimension(target: &mut Dimension, value: &Value, context: &Context) -> () {
  match convert.dimension(value, context) {
    Option.Some { value: found } => {
      target.* = found
    }
    Option.None => {}
  }
}

fn setGap(target: &mut Dimension, value: &Value, context: &Context) -> () {
  match convert.dimension(value, context) {
    Option.Some { value: found } => {
      target.* = if found.kind == DimensionKind.Auto || found.kind == DimensionKind.None {
        Dimension.keyword(DimensionKind.Normal)
      } else {
        found
      }
    }
    Option.None => {}
  }
}

/// A `scroll-padding` side: `auto` is zero, a length or a percentage of the scrollport.
fn setScrollPadding(target: &mut Dimension, value: &Value, context: &Context) -> () {
  match convert.dimension(value, context) {
    Option.Some { value: found } => {
      target.* = if found.kind == DimensionKind.Auto { Dimension.px(0.0) } else { found }
    }
    Option.None => {}
  }
}

fn setPixels(target: &mut f32, value: &Value, context: &Context) -> () {
  match convert.length(value, context) {
    Option.Some { value: found } => {
      target.* = found
    }
    Option.None => {}
  }
}

/// A border width: a length, or `thin`, `medium`, `thick`.
fn setBorderWidth(target: &mut f32, value: &Value, context: &Context) -> () {
  match convert.keywordOf(value) {
    Option.Some { value: word } => {
      if word == Keyword.Thin {
        target.* = 1.0
      } else if word == Keyword.Medium {
        target.* = 3.0
      } else if word == Keyword.Thick {
        target.* = 5.0
      }
    }
    Option.None => {
      setPixels(&mut target, value, context)
    }
  }
}

fn setColor(target: &mut Rgba<f32>, value: &Value) -> bool {
  match convert.color(value) {
    Option.Some { value: found } => {
      target.* = found
      return true
    }
    Option.None => {
      return false
    }
  }
}

/// Whether `declaration` uses a viewport unit.
pub fn viewportDependent(declaration: &Declaration) -> bool {
  return hasViewportUnit(&declaration.value)
}

impl Computed {
  /// The initial style of an element whose parent's text style is `text`.
  pub fn inheriting(text: TextStyle) -> Computed {
    return Computed.inViewport(text, 0.0, 0.0)
  }

  /// `inheriting`, with viewport units resolving against a `width` by `height` viewport.
  pub fn inViewport(text: TextStyle, width: f32, height: f32) -> Computed {
    return Computed {
      layout: CssStyle.make(),
      paint: Paint.initial(),
      text: text,
      viewportWidth: width,
      viewportHeight: height,
      usesViewport: false,
      transition: TransitionLists.initial(timing.ALL),
      animation: AnimationLists.initial(),
      transform: Transform.initial(),
      outline: Outline.initial(),
      scroll: ScrollStyle.initial(),
      cursor: Option<Cursor>.None,
    }
  }

  /// Applies one declaration. A value that does not fit its property is ignored, as an
  /// invalid declaration is in CSS.
  pub fn apply(self: &mut Self, declaration: &Declaration) -> () {
    if !self.usesViewport && hasViewportUnit(&declaration.value) {
      self.usesViewport = true
    }
    self.set(declaration.property, &declaration.value)
  }

  /// Applies a shorthand of four sides or corners: one value for all, or two to four in the
  /// CSS order with the usual defaults.
  fn four(self: &mut Self, value: &Value, a: CssProperty, b: CssProperty, c: CssProperty, d: CssProperty) -> () {
    match &value.* {
      Value.Sequence { separator: _, values } => {
        let items = values.asSlice()
        let count = items.length
        if count == 0 || count > 4 {
          return ()
        }
        self.set(a, &items[0])
        self.set(b, &items[if count > 1 { 1 } else { 0 }])
        self.set(c, &items[if count > 2 { 2 } else { 0 }])
        self.set(d, &items[if count > 3 { 3 } else if count > 1 { 1 } else { 0 }])
      }
      _ => {
        self.set(a, value)
        self.set(b, value)
        self.set(c, value)
        self.set(d, value)
      }
    }
  }

  /// Applies a shorthand of two longhands: one value for both, or one each.
  fn two(self: &mut Self, value: &Value, a: CssProperty, b: CssProperty) -> () {
    match &value.* {
      Value.Sequence { separator: _, values } => {
        let items = values.asSlice()
        if items.length == 2 {
          self.set(a, &items[0])
          self.set(b, &items[1])
        }
      }
      _ => {
        self.set(a, value)
        self.set(b, value)
      }
    }
  }

  /// Applies a logical longhand as the physical one it maps to now: the box's own writing mode
  /// and direction, inherited or declared before it.
  fn logical(self: &mut Self, value: &Value, block: bool, end: bool, top: CssProperty, right: CssProperty, bottom: CssProperty, left: CssProperty) -> () {
    let side = physicalSide(self.text.writingMode, self.text.direction, block, end)
    self.set(pickSide(side, top, right, bottom, left), value)
  }

  /// A logical corner radius: the corner between a block side and an inline side.
  fn logicalCorner(self: &mut Self, value: &Value, blockEnd: bool, inlineEnd: bool) -> () {
    let block = physicalSide(self.text.writingMode, self.text.direction, true, blockEnd)
    let inline = physicalSide(self.text.writingMode, self.text.direction, false, inlineEnd)
    let top = block == 0 || inline == 0
    let left = block == 3 || inline == 3
    self.set(
      if top && left {
        CssProperty.BorderTopLeftRadius
      } else if top {
        CssProperty.BorderTopRightRadius
      } else if left {
        CssProperty.BorderBottomLeftRadius
      } else {
        CssProperty.BorderBottomRightRadius
      },
      value,
    )
  }

  /// A logical size: `inline` sizes are widths in horizontal writing and heights in vertical.
  fn logicalSize(self: &mut Self, value: &Value, inline: bool, width: CssProperty, height: CssProperty) -> () {
    let horizontal = self.text.writingMode == WritingMode.HorizontalTb
    self.set(if inline == horizontal { width } else { height }, value)
  }

  fn set(self: &mut Self, property: CssProperty, value: &Value) -> () {
    let context = Context {
      fontSize: self.text.size,
      rootFontSize: 16.0,
      viewportWidth: self.viewportWidth,
      viewportHeight: self.viewportHeight,
    }
    match property {
      // Shorthands.
      CssProperty.Margin => {
        self.four(value, CssProperty.MarginTop, CssProperty.MarginRight, CssProperty.MarginBottom, CssProperty.MarginLeft)
      }
      CssProperty.Padding => {
        self.four(value, CssProperty.PaddingTop, CssProperty.PaddingRight, CssProperty.PaddingBottom, CssProperty.PaddingLeft)
      }
      CssProperty.Inset => {
        self.four(value, CssProperty.Top, CssProperty.Right, CssProperty.Bottom, CssProperty.Left)
      }
      CssProperty.BorderWidth => {
        self.four(value, CssProperty.BorderTopWidth, CssProperty.BorderRightWidth, CssProperty.BorderBottomWidth, CssProperty.BorderLeftWidth)
      }
      CssProperty.BorderRadius => {
        self.four(value, CssProperty.BorderTopLeftRadius, CssProperty.BorderTopRightRadius, CssProperty.BorderBottomRightRadius, CssProperty.BorderBottomLeftRadius)
      }
      // The tree paints one border color and style, so every side sets the same one.
      CssProperty.BorderColor => {
        self.set(CssProperty.BorderTopColor, value)
      }
      CssProperty.BorderStyle => {
        self.set(CssProperty.BorderTopStyle, value)
      }
      CssProperty.Gap => {
        self.two(value, CssProperty.RowGap, CssProperty.ColumnGap)
      }
      CssProperty.Overflow => {
        self.two(value, CssProperty.OverflowX, CssProperty.OverflowY)
      }
      CssProperty.WhiteSpace => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.whiteSpaceOf(word) {
              Option.Some { value: found } => {
                self.text.whiteSpace = found
                self.text.textWrap = if found == WhiteSpace.NoWrap || found == WhiteSpace.Pre {
                  TextWrap.NoWrap
                } else {
                  TextWrap.Wrap
                }
                self.text.whiteSpaceCollapse = if found == WhiteSpace.Pre || found == WhiteSpace.PreWrap {
                  WhiteSpaceCollapse.Preserve
                } else if found == WhiteSpace.PreLine {
                  WhiteSpaceCollapse.PreserveBreaks
                } else {
                  WhiteSpaceCollapse.Collapse
                }
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      // Sizes and edges.
      CssProperty.Cursor => {
        match &value.* {
          Value.Keyword { value: word } => {
            self.cursor = cursorOf(keywords.name(word))
          }
          Value.Text { css } => {
            self.cursor = cursorOf(Bytes.asSlice(&css))
          }
          _ => {}
        }
      }
      CssProperty.Display => {
        match convert.display(value) {
          Option.Some { value: found } => {
            self.layout.display = found
          }
          Option.None => {}
        }
      }

      // Logical properties, mapped to the physical ones.
      CssProperty.MarginBlockStart => {
        self.logical(value, true, false, CssProperty.MarginTop, CssProperty.MarginRight, CssProperty.MarginBottom, CssProperty.MarginLeft)
      }
      CssProperty.MarginBlockEnd => {
        self.logical(value, true, true, CssProperty.MarginTop, CssProperty.MarginRight, CssProperty.MarginBottom, CssProperty.MarginLeft)
      }
      CssProperty.MarginInlineStart => {
        self.logical(value, false, false, CssProperty.MarginTop, CssProperty.MarginRight, CssProperty.MarginBottom, CssProperty.MarginLeft)
      }
      CssProperty.MarginInlineEnd => {
        self.logical(value, false, true, CssProperty.MarginTop, CssProperty.MarginRight, CssProperty.MarginBottom, CssProperty.MarginLeft)
      }
      CssProperty.PaddingBlockStart => {
        self.logical(value, true, false, CssProperty.PaddingTop, CssProperty.PaddingRight, CssProperty.PaddingBottom, CssProperty.PaddingLeft)
      }
      CssProperty.PaddingBlockEnd => {
        self.logical(value, true, true, CssProperty.PaddingTop, CssProperty.PaddingRight, CssProperty.PaddingBottom, CssProperty.PaddingLeft)
      }
      CssProperty.PaddingInlineStart => {
        self.logical(value, false, false, CssProperty.PaddingTop, CssProperty.PaddingRight, CssProperty.PaddingBottom, CssProperty.PaddingLeft)
      }
      CssProperty.PaddingInlineEnd => {
        self.logical(value, false, true, CssProperty.PaddingTop, CssProperty.PaddingRight, CssProperty.PaddingBottom, CssProperty.PaddingLeft)
      }
      CssProperty.InsetBlockStart => {
        self.logical(value, true, false, CssProperty.Top, CssProperty.Right, CssProperty.Bottom, CssProperty.Left)
      }
      CssProperty.InsetBlockEnd => {
        self.logical(value, true, true, CssProperty.Top, CssProperty.Right, CssProperty.Bottom, CssProperty.Left)
      }
      CssProperty.InsetInlineStart => {
        self.logical(value, false, false, CssProperty.Top, CssProperty.Right, CssProperty.Bottom, CssProperty.Left)
      }
      CssProperty.InsetInlineEnd => {
        self.logical(value, false, true, CssProperty.Top, CssProperty.Right, CssProperty.Bottom, CssProperty.Left)
      }
      CssProperty.BorderBlockStartWidth => {
        self.logical(value, true, false, CssProperty.BorderTopWidth, CssProperty.BorderRightWidth, CssProperty.BorderBottomWidth, CssProperty.BorderLeftWidth)
      }
      CssProperty.BorderBlockEndWidth => {
        self.logical(value, true, true, CssProperty.BorderTopWidth, CssProperty.BorderRightWidth, CssProperty.BorderBottomWidth, CssProperty.BorderLeftWidth)
      }
      CssProperty.BorderInlineStartWidth => {
        self.logical(value, false, false, CssProperty.BorderTopWidth, CssProperty.BorderRightWidth, CssProperty.BorderBottomWidth, CssProperty.BorderLeftWidth)
      }
      CssProperty.BorderInlineEndWidth => {
        self.logical(value, false, true, CssProperty.BorderTopWidth, CssProperty.BorderRightWidth, CssProperty.BorderBottomWidth, CssProperty.BorderLeftWidth)
      }
      // The tree paints one border style and color, so every side sets them.
      CssProperty.BorderBlockStartStyle => {
        self.setBorderStyle(value)
      }
      CssProperty.BorderBlockEndStyle => {
        self.setBorderStyle(value)
      }
      CssProperty.BorderInlineStartStyle => {
        self.setBorderStyle(value)
      }
      CssProperty.BorderInlineEndStyle => {
        self.setBorderStyle(value)
      }
      CssProperty.BorderBlockStartColor => {
        drop setColor(&mut self.paint.borderColor, value)
      }
      CssProperty.BorderBlockEndColor => {
        drop setColor(&mut self.paint.borderColor, value)
      }
      CssProperty.BorderInlineStartColor => {
        drop setColor(&mut self.paint.borderColor, value)
      }
      CssProperty.BorderInlineEndColor => {
        drop setColor(&mut self.paint.borderColor, value)
      }
      CssProperty.BorderStartStartRadius => {
        self.logicalCorner(value, false, false)
      }
      CssProperty.BorderStartEndRadius => {
        self.logicalCorner(value, false, true)
      }
      CssProperty.BorderEndStartRadius => {
        self.logicalCorner(value, true, false)
      }
      CssProperty.BorderEndEndRadius => {
        self.logicalCorner(value, true, true)
      }
      CssProperty.InlineSize => {
        self.logicalSize(value, true, CssProperty.Width, CssProperty.Height)
      }
      CssProperty.BlockSize => {
        self.logicalSize(value, false, CssProperty.Width, CssProperty.Height)
      }
      CssProperty.MinInlineSize => {
        self.logicalSize(value, true, CssProperty.MinWidth, CssProperty.MinHeight)
      }
      CssProperty.MinBlockSize => {
        self.logicalSize(value, false, CssProperty.MinWidth, CssProperty.MinHeight)
      }
      CssProperty.MaxInlineSize => {
        self.logicalSize(value, true, CssProperty.MaxWidth, CssProperty.MaxHeight)
      }
      CssProperty.MaxBlockSize => {
        self.logicalSize(value, false, CssProperty.MaxWidth, CssProperty.MaxHeight)
      }
      CssProperty.OverflowInline => {
        self.logicalSize(value, true, CssProperty.OverflowX, CssProperty.OverflowY)
      }
      CssProperty.OverflowBlock => {
        self.logicalSize(value, false, CssProperty.OverflowX, CssProperty.OverflowY)
      }
      CssProperty.OverscrollBehaviorInline => {
        self.logicalSize(value, true, CssProperty.OverscrollBehaviorX, CssProperty.OverscrollBehaviorY)
      }
      CssProperty.OverscrollBehaviorBlock => {
        self.logicalSize(value, false, CssProperty.OverscrollBehaviorX, CssProperty.OverscrollBehaviorY)
      }
      CssProperty.ScrollMarginBlockStart => {
        self.logical(value, true, false, CssProperty.ScrollMarginTop, CssProperty.ScrollMarginRight, CssProperty.ScrollMarginBottom, CssProperty.ScrollMarginLeft)
      }
      CssProperty.ScrollMarginBlockEnd => {
        self.logical(value, true, true, CssProperty.ScrollMarginTop, CssProperty.ScrollMarginRight, CssProperty.ScrollMarginBottom, CssProperty.ScrollMarginLeft)
      }
      CssProperty.ScrollMarginInlineStart => {
