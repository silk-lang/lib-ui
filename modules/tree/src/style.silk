      CssProperty.ScrollbarWidth => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.scrollbarWidthOf(word) {
              Option.Some { value: found } => {
                self.layout.scrollbarWidth = found
