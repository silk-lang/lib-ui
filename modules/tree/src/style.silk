//! Computed styles: the base look of a node with its active variants applied over it, and text
//! properties inherited from the parent. The layout part is a css-layout `Style`, written as
//! each declaration is applied; paint and text are css-properties' computed structs.
import mutation { Declaration, Value, Keyword, CssProperty, Cursor }
import layout.lib {
  Style as CssStyle,
  Edges,
  Dimension,
  DimensionKind,
  Overflow,
  TextWrap,
  WhiteSpaceCollapse,
  Visibility,
}
pub import properties.computed { Text as TextStyle, Paint, Fill, DisplayOutside, DisplayInside }
import properties.computed { BorderStyle, DecorationLine, WhiteSpace, ObjectFit }
import properties.convert { Context }
import timing { TransitionLists, AnimationLists }
import transform { Transform }
import timing
import properties.values { Unit }
import properties.convert
import properties.keyword_enums
import properties.keywords
import silk.collections.hash { Hash, HashSeed }
import silk.color.rgba { Rgba }
import silk.core.option { Option }
import silk.collections.bytes { Bytes }
import silk.core.ownership { Copy }
import silk.geometry.insets { Insets }
import silk.num.f32
import silk.num.u8
import silk.num.u32
import silk.num.u64

/// A node's computed style.
pub struct Computed {
  /// What css-layout reads. The inherited text properties and the border widths reach it in
  /// [`Computed.finish`].
  pub layout: CssStyle,
  /// What only the tree paints. `paint.border` holds the widths as set; `border-style: none`
  /// lays out as zero.
  pub paint: Paint,
  pub text: TextStyle,
  /// The viewport that `vw`, `vh` and the other viewport units resolve against.
  pub viewportWidth: f32,
  pub viewportHeight: f32,
  /// A declaration used a viewport unit, so the style changes when the viewport does.
  pub usesViewport: bool,
  /// The `transition-*` lists.
  pub transition: TransitionLists,
  /// The `animation-*` lists.
  pub animation: AnimationLists,
  /// `transform`, `translate`, `rotate`, `scale`, their origin, `perspective` and its origin.
  pub transform: Transform,
  /// The CSS `cursor`, when the node sets one other than `auto`. Hovering finds it on the
  /// node or the nearest ancestor that sets one, as inheritance would.
  pub cursor: Option<Cursor>,
}

impl Copy for Computed {}

fn viewportUnit(unit: Unit) -> bool {
  return unit == Unit.Vw || unit == Unit.Vh || unit == Unit.Vi || unit == Unit.Vb
    || unit == Unit.Vmin || unit == Unit.Vmax
    || unit == Unit.Svw || unit == Unit.Svh || unit == Unit.Svi || unit == Unit.Svb
    || unit == Unit.Svmin || unit == Unit.Svmax
    || unit == Unit.Lvw || unit == Unit.Lvh || unit == Unit.Lvi || unit == Unit.Lvb
    || unit == Unit.Lvmin || unit == Unit.Lvmax
    || unit == Unit.Dvw || unit == Unit.Dvh || unit == Unit.Dvi || unit == Unit.Dvb
    || unit == Unit.Dvmin || unit == Unit.Dvmax
}

/// Whether `value` has a viewport unit anywhere in it.
fn hasViewportUnit(value: &Value) -> bool {
  match &value.* {
    Value.Unit { value: _, unit } => {
      return viewportUnit(unit)
    }
    Value.Math { operator: _, values } => {
      return anyViewportUnit(values.asSlice())
    }
    Value.Function { name: _, values } => {
      return anyViewportUnit(values.asSlice())
    }
    Value.Sequence { separator: _, values } => {
      return anyViewportUnit(values.asSlice())
    }
    Value.Text { css } => {
      // A number followed by `v`, `sv`, `lv` or `dv` starts a viewport unit.
      let bytes = css.asSlice()
      let mut i: usize = 1
      while i < bytes.length {
        if (bytes[i] | 32) == 118 {
          let before = bytes[i - 1] | 32
          if isDigit(bytes[i - 1]) {
            return true
          }
          if i >= 2 && (before == 115 || before == 108 || before == 100) && isDigit(bytes[i - 2]) {
            return true
          }
        }
        i = i + 1
      }
      return false
    }
    _ => {
      return false
    }
  }
}

fn isDigit(byte: u8) -> bool {
  return byte >= 48 && byte <= 57
}

fn anyViewportUnit(items: &[Value]) -> bool {
  let mut i: usize = 0
  while i < items.length {
    if hasViewportUnit(&items[i]) {
      return true
    }
    i = i + 1
  }
  return false
}

fn setDimension(target: &mut Dimension, value: &Value, context: &Context) -> () {
  match convert.dimension(value, context) {
    Option.Some { value: found } => {
      target.* = found
    }
    Option.None => {}
  }
}

fn setGap(target: &mut Dimension, value: &Value, context: &Context) -> () {
  match convert.dimension(value, context) {
    Option.Some { value: found } => {
      target.* = if found.kind == DimensionKind.Auto || found.kind == DimensionKind.None {
        Dimension.keyword(DimensionKind.Normal)
      } else {
        found
      }
    }
    Option.None => {}
  }
}

fn setPixels(target: &mut f32, value: &Value, context: &Context) -> () {
  match convert.length(value, context) {
    Option.Some { value: found } => {
      target.* = found
    }
    Option.None => {}
  }
}

/// A border width: a length, or `thin`, `medium`, `thick`.
fn setBorderWidth(target: &mut f32, value: &Value, context: &Context) -> () {
  match convert.keywordOf(value) {
    Option.Some { value: word } => {
      if word == Keyword.Thin {
        target.* = 1.0
      } else if word == Keyword.Medium {
        target.* = 3.0
      } else if word == Keyword.Thick {
        target.* = 5.0
      }
    }
    Option.None => {
      setPixels(&mut target, value, context)
    }
  }
}

fn setColor(target: &mut Rgba<f32>, value: &Value) -> bool {
  match convert.color(value) {
    Option.Some { value: found } => {
      target.* = found
      return true
    }
    Option.None => {
      return false
    }
  }
}

/// Whether `declaration` uses a viewport unit.
pub fn viewportDependent(declaration: &Declaration) -> bool {
  return hasViewportUnit(&declaration.value)
}

impl Computed {
  /// The initial style of an element whose parent's text style is `text`.
  pub fn inheriting(text: TextStyle) -> Computed {
    return Computed.inViewport(text, 0.0, 0.0)
  }

  /// `inheriting`, with viewport units resolving against a `width` by `height` viewport.
  pub fn inViewport(text: TextStyle, width: f32, height: f32) -> Computed {
    return Computed {
      layout: CssStyle.make(),
      paint: Paint.initial(),
      text: text,
      viewportWidth: width,
      viewportHeight: height,
      usesViewport: false,
      transition: TransitionLists.initial(timing.ALL),
      animation: AnimationLists.initial(),
      transform: Transform.initial(),
      cursor: Option<Cursor>.None,
    }
  }

  /// Applies one declaration. A value that does not fit its property is ignored, as an
  /// invalid declaration is in CSS.
  pub fn apply(self: &mut Self, declaration: &Declaration) -> () {
    if !self.usesViewport && hasViewportUnit(&declaration.value) {
      self.usesViewport = true
    }
    self.set(declaration.property, &declaration.value)
  }

  /// Applies a shorthand of four sides or corners: one value for all, or two to four in the
  /// CSS order with the usual defaults.
  fn four(self: &mut Self, value: &Value, a: CssProperty, b: CssProperty, c: CssProperty, d: CssProperty) -> () {
    match &value.* {
      Value.Sequence { separator: _, values } => {
        let items = values.asSlice()
        let count = items.length
        if count == 0 || count > 4 {
          return ()
        }
        self.set(a, &items[0])
        self.set(b, &items[if count > 1 { 1 } else { 0 }])
        self.set(c, &items[if count > 2 { 2 } else { 0 }])
        self.set(d, &items[if count > 3 { 3 } else if count > 1 { 1 } else { 0 }])
      }
      _ => {
        self.set(a, value)
        self.set(b, value)
        self.set(c, value)
        self.set(d, value)
      }
    }
  }

  /// Applies a shorthand of two longhands: one value for both, or one each.
  fn two(self: &mut Self, value: &Value, a: CssProperty, b: CssProperty) -> () {
    match &value.* {
      Value.Sequence { separator: _, values } => {
        let items = values.asSlice()
        if items.length == 2 {
          self.set(a, &items[0])
          self.set(b, &items[1])
        }
      }
      _ => {
        self.set(a, value)
        self.set(b, value)
      }
    }
  }

  fn set(self: &mut Self, property: CssProperty, value: &Value) -> () {
    let context = Context {
      fontSize: self.text.size,
      rootFontSize: 16.0,
      viewportWidth: self.viewportWidth,
      viewportHeight: self.viewportHeight,
    }
    match property {
      // Shorthands.
      CssProperty.Margin => {
        self.four(value, CssProperty.MarginTop, CssProperty.MarginRight, CssProperty.MarginBottom, CssProperty.MarginLeft)
      }
      CssProperty.Padding => {
        self.four(value, CssProperty.PaddingTop, CssProperty.PaddingRight, CssProperty.PaddingBottom, CssProperty.PaddingLeft)
      }
      CssProperty.Inset => {
        self.four(value, CssProperty.Top, CssProperty.Right, CssProperty.Bottom, CssProperty.Left)
      }
      CssProperty.BorderWidth => {
        self.four(value, CssProperty.BorderTopWidth, CssProperty.BorderRightWidth, CssProperty.BorderBottomWidth, CssProperty.BorderLeftWidth)
      }
      CssProperty.BorderRadius => {
        self.four(value, CssProperty.BorderTopLeftRadius, CssProperty.BorderTopRightRadius, CssProperty.BorderBottomRightRadius, CssProperty.BorderBottomLeftRadius)
      }
      // The tree paints one border color and style, so every side sets the same one.
      CssProperty.BorderColor => {
        self.set(CssProperty.BorderTopColor, value)
      }
      CssProperty.BorderStyle => {
        self.set(CssProperty.BorderTopStyle, value)
      }
      CssProperty.Gap => {
        self.two(value, CssProperty.RowGap, CssProperty.ColumnGap)
      }
      CssProperty.Overflow => {
        self.two(value, CssProperty.OverflowX, CssProperty.OverflowY)
      }
      CssProperty.WhiteSpace => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.whiteSpaceOf(word) {
              Option.Some { value: found } => {
                self.text.whiteSpace = found
                self.text.textWrap = if found == WhiteSpace.NoWrap || found == WhiteSpace.Pre {
                  TextWrap.NoWrap
                } else {
                  TextWrap.Wrap
                }
                self.text.whiteSpaceCollapse = if found == WhiteSpace.Pre || found == WhiteSpace.PreWrap {
                  WhiteSpaceCollapse.Preserve
                } else if found == WhiteSpace.PreLine {
                  WhiteSpaceCollapse.PreserveBreaks
                } else {
                  WhiteSpaceCollapse.Collapse
                }
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      // Sizes and edges.
      CssProperty.Cursor => {
        match &value.* {
          Value.Keyword { value: word } => {
            self.cursor = cursorOf(keywords.name(word))
          }
          Value.Text { css } => {
            self.cursor = cursorOf(Bytes.asSlice(&css))
          }
          _ => {}
        }
      }
      CssProperty.Display => {
        match convert.display(value) {
          Option.Some { value: found } => {
            self.layout.display = found
          }
          Option.None => {}
        }
      }

      CssProperty.Width => {
        setDimension(&mut self.layout.width, value, &context)
      }
      CssProperty.Height => {
        setDimension(&mut self.layout.height, value, &context)
      }
      CssProperty.MinWidth => {
        setDimension(&mut self.layout.minWidth, value, &context)
      }
      CssProperty.MinHeight => {
        setDimension(&mut self.layout.minHeight, value, &context)
      }
      CssProperty.MaxWidth => {
        setDimension(&mut self.layout.maxWidth, value, &context)
      }
      CssProperty.MaxHeight => {
        setDimension(&mut self.layout.maxHeight, value, &context)
      }
      CssProperty.FlexBasis => {
        setDimension(&mut self.layout.flexBasis, value, &context)
      }
      CssProperty.RowGap => {
        setGap(&mut self.layout.rowGap, value, &context)
      }
      CssProperty.ColumnGap => {
        setGap(&mut self.layout.columnGap, value, &context)
      }
      CssProperty.MarginTop => {
        setDimension(&mut self.layout.margin.top, value, &context)
      }
      CssProperty.PaddingTop => {
        setDimension(&mut self.layout.padding.top, value, &context)
      }
      CssProperty.Top => {
        setDimension(&mut self.layout.inset.top, value, &context)
      }
      CssProperty.BorderTopWidth => {
        setBorderWidth(&mut self.paint.border.top, value, &context)
      }
      CssProperty.MarginRight => {
        setDimension(&mut self.layout.margin.right, value, &context)
      }
      CssProperty.PaddingRight => {
        setDimension(&mut self.layout.padding.right, value, &context)
      }
      CssProperty.Right => {
        setDimension(&mut self.layout.inset.right, value, &context)
      }
      CssProperty.BorderRightWidth => {
        setBorderWidth(&mut self.paint.border.right, value, &context)
      }
      CssProperty.MarginBottom => {
        setDimension(&mut self.layout.margin.bottom, value, &context)
      }
      CssProperty.PaddingBottom => {
        setDimension(&mut self.layout.padding.bottom, value, &context)
      }
      CssProperty.Bottom => {
        setDimension(&mut self.layout.inset.bottom, value, &context)
      }
      CssProperty.BorderBottomWidth => {
        setBorderWidth(&mut self.paint.border.bottom, value, &context)
      }
      CssProperty.MarginLeft => {
        setDimension(&mut self.layout.margin.left, value, &context)
      }
      CssProperty.PaddingLeft => {
        setDimension(&mut self.layout.padding.left, value, &context)
      }
      CssProperty.Left => {
        setDimension(&mut self.layout.inset.left, value, &context)
      }
      CssProperty.BorderLeftWidth => {
        setBorderWidth(&mut self.paint.border.left, value, &context)
      }
      CssProperty.BorderTopLeftRadius => {
        setPixels(&mut self.paint.radii.topLeft, value, &context)
      }
      CssProperty.BorderTopRightRadius => {
        setPixels(&mut self.paint.radii.topRight, value, &context)
      }
      CssProperty.BorderBottomRightRadius => {
        setPixels(&mut self.paint.radii.bottomRight, value, &context)
      }
      CssProperty.BorderBottomLeftRadius => {
        setPixels(&mut self.paint.radii.bottomLeft, value, &context)
      }
      // Keywords.
      CssProperty.Position => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.positionOf(word) {
              Option.Some { value: found } => {
                self.layout.position = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.BoxSizing => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.boxSizingOf(word) {
              Option.Some { value: found } => {
                self.layout.boxSizing = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.FlexDirection => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.flexDirectionOf(word) {
              Option.Some { value: found } => {
                self.layout.flexDirection = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.FlexWrap => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.flexWrapOf(word) {
              Option.Some { value: found } => {
                self.layout.flexWrap = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.OverflowX => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.overflowOf(word) {
              Option.Some { value: found } => {
                self.layout.overflowX = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.OverflowY => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.overflowOf(word) {
              Option.Some { value: found } => {
                self.layout.overflowY = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.UnicodeBidi => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.unicodeBidiOf(word) {
              Option.Some { value: found } => {
                self.layout.unicodeBidi = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.BaselineSource => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.baselineSourceOf(word) {
              Option.Some { value: found } => {
                self.layout.baselineSource = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.BoxDecorationBreak => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.boxDecorationBreakOf(word) {
              Option.Some { value: found } => {
                self.layout.boxDecorationBreak = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.MarginBreak => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.marginBreakOf(word) {
              Option.Some { value: found } => {
                self.layout.marginBreak = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.BreakBefore => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.breakBetweenOf(word) {
              Option.Some { value: found } => {
                self.layout.breakBefore = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.BreakAfter => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.breakBetweenOf(word) {
              Option.Some { value: found } => {
                self.layout.breakAfter = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.BreakInside => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.breakInsideOf(word) {
              Option.Some { value: found } => {
                self.layout.breakInside = found
