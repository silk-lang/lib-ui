      }
      CssProperty.WhiteSpaceCollapse => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.whiteSpaceCollapseOf(word) {
              Option.Some { value: found } => {
                self.text.whiteSpaceCollapse = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.TextJustify => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.textJustifyOf(word) {
              Option.Some { value: found } => {
                self.text.textJustify = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.TextAlign => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.textAlignOf(word) {
              Option.Some { value: found } => {
                self.text.align = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.Direction => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.directionOf(word) {
              Option.Some { value: found } => {
                self.text.direction = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.FontStyle => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.fontStyleOf(word) {
              Option.Some { value: found } => {
                self.text.style = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.ObjectFit => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.objectFitOf(word) {
              Option.Some { value: found } => {
                self.paint.objectFit = found
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.JustifyContent => {
        match convert.alignment(value) {
          Option.Some { value: found } => {
            self.layout.justifyContent = found.align
            self.layout.justifyContentSafety = found.safety
          }
          Option.None => {}
        }
      }
      CssProperty.AlignItems => {
        match convert.alignment(value) {
          Option.Some { value: found } => {
            self.layout.alignItems = found.align
            self.layout.alignItemsSafety = found.safety
          }
          Option.None => {}
        }
      }
      CssProperty.AlignSelf => {
        match convert.alignment(value) {
          Option.Some { value: found } => {
            self.layout.alignSelf = found.align
            self.layout.alignSelfSafety = found.safety
          }
          Option.None => {}
        }
      }
      CssProperty.AlignContent => {
        match convert.alignment(value) {
          Option.Some { value: found } => {
            self.layout.alignContent = found.align
            self.layout.alignContentSafety = found.safety
          }
          Option.None => {}
        }
      }
      CssProperty.JustifySelf => {
        match convert.alignment(value) {
          Option.Some { value: found } => {
            self.layout.justifySelf = found.align
            self.layout.justifySelfSafety = found.safety
          }
          Option.None => {}
        }
      }
      CssProperty.JustifyItems => {
        match convert.alignment(value) {
          Option.Some { value: found } => {
            self.layout.justifyItems = found.align
            self.layout.justifyItemsSafety = found.safety
          }
          Option.None => {}
        }
      }
      CssProperty.ScrollbarGutter => {
        match convert.scrollbarGutter(value) {
          Option.Some { value: found } => {
            self.layout.scrollbarGutter = found
          }
          Option.None => {}
        }
      }
      CssProperty.VerticalAlign => {
        match convert.verticalAlign(value, &context) {
          Option.Some { value: found } => {
            self.layout.verticalAlign = found
          }
          Option.None => {}
        }
      }
      CssProperty.TextIndent => {
        match convert.textIndent(value, &context) {
          Option.Some { value: found } => {
            self.text.textIndent = found
          }
          Option.None => {}
        }
      }
      CssProperty.TabSize => {
        match convert.tabSize(value, &context) {
          Option.Some { value: found } => {
            self.text.tabSize = found
          }
          Option.None => {}
        }
      }
      CssProperty.LineHeight => {
        match convert.lineHeight(value, &context) {
          Option.Some { value: found } => {
            self.text.lineHeight = found
          }
          Option.None => {}
        }
      }
      CssProperty.TextDecorationLine => {
        match convert.decorationLine(value) {
          Option.Some { value: found } => {
            self.text.decoration = found
          }
          Option.None => {}
        }
      }
      CssProperty.FlexGrow => {
        match convert.number(value) {
          Option.Some { value: found } => {
            self.layout.flexGrow = found
          }
          Option.None => {}
        }
      }
      CssProperty.FlexShrink => {
        match convert.number(value) {
          Option.Some { value: found } => {
            self.layout.flexShrink = found
          }
          Option.None => {}
        }
      }
      CssProperty.Visibility => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            match keyword_enums.visibilityOf(word) {
              Option.Some { value: found } => {
                self.text.visibility = found
                self.text.visible = found == Visibility.Visible
              }
              Option.None => {}
            }
          }
          Option.None => {}
        }
      }
      // Numbers.
      CssProperty.Order => {
        match convert.number(value) {
          Option.Some { value: found } => {
            self.layout.order = f32.toI32(f32.round(found))
          }
          Option.None => {}
        }
      }
      CssProperty.Orphans => {
        match convert.number(value) {
          Option.Some { value: found } => {
            if found >= 1.0 {
              self.text.orphans = f32.toUsize(found)
            }
          }
          Option.None => {}
        }
      }
      CssProperty.Widows => {
        match convert.number(value) {
          Option.Some { value: found } => {
            if found >= 1.0 {
              self.text.widows = f32.toUsize(found)
            }
          }
          Option.None => {}
        }
      }
      CssProperty.AspectRatio => {
        // `auto`, `<ratio>`, or `auto <ratio>`.
        match &value.* {
          Value.Sequence { separator: _, values } => {
            let items = values.asSlice()
            if items.length == 2 && convert.isKeyword(&items[0], Keyword.Auto) {
              match convert.number(&items[1]) {
                Option.Some { value: found } => {
                  self.layout.aspectRatio = f32.max(0.0, found)
                  self.layout.aspectRatioAuto = true
                }
                Option.None => {}
              }
            }
          }
          _ => {
            if convert.isKeyword(value, Keyword.Auto) {
              self.layout.aspectRatioAuto = true
            } else {
              match convert.number(value) {
                Option.Some { value: found } => {
                  self.layout.aspectRatio = f32.max(0.0, found)
                }
                Option.None => {}
              }
            }
          }
        }
      }
      CssProperty.Opacity => {
        match convert.number(value) {
          Option.Some { value: found } => {
            self.paint.opacity = found
          }
          Option.None => {}
        }
      }
      // Paint.
      CssProperty.ObjectPosition => {
        match convert.pair(value, &context) {
          Option.Some { value: found } => {
            self.paint.objectX = found.first
            self.paint.objectY = found.second
          }
          Option.None => {}
        }
      }
      CssProperty.BackgroundColor => {
        match convert.color(value) {
          Option.Some { value: found } => {
            self.paint.background = Fill.Solid { color: found }
          }
          Option.None => {}
        }
      }
      CssProperty.BackgroundImage => {
        match convert.fill(value) {
          Option.Some { value: found } => {
            match found {
              Fill.Gradient { .. } => {
                self.paint.background = found
              }
              Fill.None => {
                // `none` removes a gradient and leaves a background color alone.
                match self.paint.background {
                  Fill.Gradient { .. } => {
                    self.paint.background = Fill.None
                  }
                  _ => {}
                }
              }
              _ => {}
            }
          }
          Option.None => {}
        }
      }
      CssProperty.BorderTopColor => {
        drop setColor(&mut self.paint.borderColor, value)
      }
      CssProperty.BorderRightColor => {
        drop setColor(&mut self.paint.borderColor, value)
      }
      CssProperty.BorderBottomColor => {
        drop setColor(&mut self.paint.borderColor, value)
      }
      CssProperty.BorderLeftColor => {
        drop setColor(&mut self.paint.borderColor, value)
      }
      CssProperty.BorderTopStyle => {
        self.setBorderStyle(value)
      }
      CssProperty.BorderRightStyle => {
        self.setBorderStyle(value)
      }
      CssProperty.BorderBottomStyle => {
        self.setBorderStyle(value)
      }
      CssProperty.BorderLeftStyle => {
        self.setBorderStyle(value)
      }
      CssProperty.BoxShadow => {
        if convert.isKeyword(value, Keyword.None) {
          self.paint.hasShadow = false
        } else {
          match convert.boxShadow(value, &context) {
            Option.Some { value: found } => {
              self.paint.shadow = found
              self.paint.hasShadow = true
            }
            Option.None => {}
          }
        }
      }
      CssProperty.BackdropFilter => {
        match convert.blur(value, &context) {
          Option.Some { value: found } => {
            self.paint.backdropBlur = f32.max(0.0, found)
          }
          Option.None => {}
        }
      }
      CssProperty.PointerEvents => {
        if convert.isKeyword(value, Keyword.None) {
          self.paint.pointerEvents = false
        } else if convert.isKeyword(value, Keyword.Auto) {
          self.paint.pointerEvents = true
        }
      }
      // Text.
      CssProperty.FontFamily => {
        match convert.number(value) {
          Option.Some { value: found } => {
            if found >= 0.0 {
              self.text.family = f32.toU32(found)
            }
          }
          Option.None => {}
        }
      }
      CssProperty.FontSize => {
        // `em` and percentages refer to the inherited size, which is the size so far.
        match &value.* {
          Value.Unit { value: amount, unit } => {
            if unit == Unit.Percent {
              self.text.size = self.text.size * amount / 100.0
              return ()
            }
          }
          _ => {}
        }
        setPixels(&mut self.text.size, value, &context)
      }
      CssProperty.FontWeight => {
        if convert.isKeyword(value, Keyword.Normal) {
          self.text.weight = 400.0
        } else if convert.isKeyword(value, Keyword.Bold) {
          self.text.weight = 700.0
        } else {
          match convert.number(value) {
            Option.Some { value: found } => {
              self.text.weight = found
            }
            Option.None => {}
          }
        }
      }
      CssProperty.Color => {
        drop setColor(&mut self.text.color, value)
      }
      CssProperty.TextDecorationColor => {
        if convert.isKeyword(value, Keyword.Currentcolor) {
          self.text.hasDecorationColor = false
        } else if setColor(&mut self.text.decorationColor, value) {
          self.text.hasDecorationColor = true
        }
      }
      CssProperty.TextDecorationStyle => {
        match convert.keywordOf(value) {
          Option.Some { value: word } => {
            self.text.wavy = word == Keyword.Wavy
          }
          Option.None => {}
        }
      }
      CssProperty.CaretColor => {
        if convert.isKeyword(value, Keyword.Auto) {
          self.text.hasCaretColor = false
        } else if setColor(&mut self.text.caretColor, value) {
          self.text.hasCaretColor = true
        }
      }
      CssProperty.SilkSelectionColor => {
        drop setColor(&mut self.text.selectionColor, value)
      }
      CssProperty.SilkPlaceholderColor => {
        if convert.isKeyword(value, Keyword.Auto) {
          self.text.hasPlaceholderColor = false
        } else if setColor(&mut self.text.placeholderColor, value) {
          self.text.hasPlaceholderColor = true
        }
      }
      // Properties the tree does not support are ignored.
      _ => {}
    }
  }

  fn setBorderStyle(self: &mut Self, value: &Value) -> () {
    match convert.keywordOf(value) {
      Option.Some { value: word } => {
        match keyword_enums.borderStyleOf(word) {
          Option.Some { value: found } => {
            self.paint.borderStyle = found
          }
          Option.None => {}
        }
      }
      Option.None => {}
    }
  }

  /// Whether the node clips its children to its padding box.
  pub fn clips(self: &Self) -> bool {
    return self.layout.overflowX != Overflow.Visible || self.layout.overflowY != Overflow.Visible
  }

  /// Whether the node draws anything of its own box: a background, border or shadow.
  pub fn decorated(self: &Self) -> bool {
    let fills = match self.paint.background {
      Fill.None => false
      Fill.Solid { color } => color.a > 0.0
      Fill.Gradient { .. } => true
    }
    let border = self.paint.borderStyle != BorderStyle.None && self.paint.borderColor.a > 0.0
      && (self.paint.border.top > 0.0 || self.paint.border.right > 0.0 || self.paint.border.bottom > 0.0
        || self.paint.border.left > 0.0)
    return fills || border || self.paint.hasShadow
  }

  /// A hash of everything that changes how the node paints but not its layout.
  pub fn paintHash(self: &Self, seed: &HashSeed) -> u64 {
    let mut h = Hash.mix(seed, 7)
    h = Hash.combine(h, u8.toU64(ObjectFit.value(self.paint.objectFit)))
    h = dimensionHash(dimensionHash(h, self.paint.objectX), self.paint.objectY)
    match self.paint.background {
      Fill.None => {
        h = Hash.combine(h, 0)
      }
      Fill.Solid { color } => {
        h = colorHash(Hash.combine(h, 1), color)
      }
      Fill.Gradient { angle, from, to } => {
        h = colorHash(colorHash(floatHash(Hash.combine(h, 2), angle), from), to)
      }
    }
    h = colorHash(h, self.paint.borderColor)
    h = Hash.combine(h, borderStyleIndex(self.paint.borderStyle))
    h = floatHash(h, self.paint.radii.topLeft)
    h = floatHash(h, self.paint.radii.topRight)
    h = floatHash(h, self.paint.radii.bottomRight)
    h = floatHash(h, self.paint.radii.bottomLeft)
    if self.paint.hasShadow {
      h = floatHash(h, self.paint.shadow.offsetX)
      h = floatHash(h, self.paint.shadow.offsetY)
      h = floatHash(h, self.paint.shadow.blur)
      h = floatHash(h, self.paint.shadow.spread)
      h = colorHash(h, self.paint.shadow.color)
      h = Hash.combine(
        h,
        if self.paint.shadow.inset {
          3
        } else {
          2
        },
      )
    }
    h = floatHash(h, self.paint.opacity)
    h = floatHash(h, self.paint.backdropBlur)
    h = colorHash(h, self.text.color)
    h = Hash.combine(h, decorationIndex(self.text.decoration))
    h = colorHash(h, self.text.lineColor())
    h = Hash.combine(
      h,
      if self.text.wavy {
        1
      } else {
        0
      },
    )
    h = colorHash(h, self.text.caret())
    h = colorHash(h, self.text.selectionColor)
    h = colorHash(h, self.text.placeholder())
    h = Hash.combine(
      h,
      if self.paint.pointerEvents {
        1
      } else {
        0
      },
    )
    return h
  }

  /// Completes the layout style once every property is applied: the font key the text style
  /// resolved to, the inherited text properties, and the border widths.
  pub fn finish(self: &mut Self, fontKey: usize) -> () {
    let text = self.text
    self.layout.fontKey = fontKey
    self.layout.border = if self.paint.borderStyle == BorderStyle.None {
      Edges.all(Dimension.px(0.0))
    } else {
      borderEdges(self.paint.border)
    }
    self.layout.lineHeight = text.lineHeight
    self.layout.textAlign = text.align
    self.layout.direction = text.direction
    self.layout.visibility = text.visibility
    self.layout.writingMode = text.writingMode
    self.layout.textOrientation = text.textOrientation
    self.layout.textAlignLast = text.textAlignLast
    self.layout.textWrap = text.textWrap
    self.layout.whiteSpaceCollapse = text.whiteSpaceCollapse
    self.layout.textJustify = text.textJustify
    self.layout.textIndent = text.textIndent
    self.layout.tabSize = text.tabSize
    self.layout.orphans = text.orphans
    self.layout.widows = text.widows
  }
}

fn named(name: &[u8], word: &[u8]) -> bool {
  if name.length != word.length { return false }
  let mut i: usize = 0
  while i < name.length {
    let byte = if name[i] >= 65 && name[i] <= 90 { name[i] + 32 } else { name[i] }
    if byte != word[i] { return false }
    i = i + 1
  }
  return true
}

/// The tree's cursor for a CSS `cursor` keyword; None for `auto`. Keywords without a cursor
/// of their own take the nearest one.
pub fn cursorOf(name: &[u8]) -> Option<Cursor> {
  if named(name, b"auto") { return Option<Cursor>.None }
  if named(name, b"pointer") { return Option<Cursor>.Some { value: Cursor.Pointer } }
  if named(name, b"text") || named(name, b"vertical-text") { return Option<Cursor>.Some { value: Cursor.Text } }
  if named(name, b"move") || named(name, b"all-scroll") { return Option<Cursor>.Some { value: Cursor.Move } }
  if named(name, b"grab") { return Option<Cursor>.Some { value: Cursor.Grab } }
  if named(name, b"grabbing") { return Option<Cursor>.Some { value: Cursor.Grabbing } }
  if named(name, b"not-allowed") || named(name, b"no-drop") { return Option<Cursor>.Some { value: Cursor.NotAllowed } }
  if named(name, b"ew-resize") || named(name, b"col-resize") || named(name, b"e-resize") || named(name, b"w-resize") {
    return Option<Cursor>.Some { value: Cursor.ResizeHorizontal }
  }
  if named(name, b"ns-resize") || named(name, b"row-resize") || named(name, b"n-resize") || named(name, b"s-resize") {
    return Option<Cursor>.Some { value: Cursor.ResizeVertical }
  }
  if named(name, b"nwse-resize") || named(name, b"nw-resize") || named(name, b"se-resize") {
    return Option<Cursor>.Some { value: Cursor.ResizeNorthWestSouthEast }
  }
  if named(name, b"nesw-resize") || named(name, b"ne-resize") || named(name, b"sw-resize") {
    return Option<Cursor>.Some { value: Cursor.ResizeNorthEastSouthWest }
  }
  if named(name, b"crosshair") || named(name, b"cell") { return Option<Cursor>.Some { value: Cursor.Crosshair } }
  return Option<Cursor>.Some { value: Cursor.Default }
}

fn borderEdges(border: Insets<f32>) -> Edges {
  return Edges {
    top: Dimension.px(border.top),
    right: Dimension.px(border.right),
    bottom: Dimension.px(border.bottom),
    left: Dimension.px(border.left),
  }
}

fn floatHash(h: u64, value: f32) -> u64 {
  return Hash.combine(h, u32.toU64(f32.toBits(value)))
}

fn colorHash(h: u64, color: Rgba<f32>) -> u64 {
  return floatHash(floatHash(floatHash(floatHash(h, color.r), color.g), color.b), color.a)
}

fn dimensionHash(h: u64, value: Dimension) -> u64 {
  return floatHash(floatHash(Hash.combine(h, u8.toU64(DimensionKind.value(value.kind))), value.value), value.percent)
}

fn borderStyleIndex(value: BorderStyle) -> u64 {
  return match value {
    BorderStyle.None => 0
    BorderStyle.Solid => 1
    BorderStyle.Dashed => 2
  }
}

fn decorationIndex(value: DecorationLine) -> u64 {
  let mut bits: u64 = 0
  if value.underline {
    bits = bits + 1
  }
  if value.overline {
    bits = bits + 2
  }
  if value.lineThrough {
    bits = bits + 4
  }
  return bits
}
