//! The tree's node records and the per-frame data shared by the tree and its painter.
import mutation { NodeKind, Declaration, Role, Cursor, CanvasCommand }
import style { Computed }
import edit { EditState }
import font_raster.face { FontFace }
import atlas.atlas { AtlasTile }
import layout.lib { LayoutStats }
pub import ui_protocol.record { Event, EventKind }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.mem.box { Box }
import silk.core.ownership { Copy }
import silk.geometry.rect { Rect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.usize
import silk.text.string { String }

/// No node, in slots and css-layout indices.
pub const NONE: u32 = 4294967295

pub const NO_INDEX: usize = usize.MAX

/// What a frame is drawn at: the viewport in CSS pixels, device pixels per CSS pixel, and the
/// time in seconds (for animated icons).
pub struct FrameInput {
  pub width: f32,
  pub height: f32,
  pub scale: f32,
  pub time: f64,
}

impl Copy for FrameInput {}

/// What the last frame did, for tests, benchmarks and inspectors.
pub struct FrameStats {
  pub frame: u64,
  /// css-layout's counters for the frame's layout (zero when layout was skipped).
  pub layout: LayoutStats,
  pub layoutSkipped: bool,
  /// Subtrees copied from the previous scene, and subtrees painted again.
  pub replayedSubtrees: usize,
  pub repaintedSubtrees: usize,
  /// Paint operations copied by replay.
  pub replayedOperations: usize,
  /// Box, inline and text fragments visited by paint (replayed ones excluded).
  pub paintedFragments: usize,
  /// Subtrees paint skipped because their ink lies outside the clip.
  pub culledSubtrees: usize,
  pub glyphs: usize,
  pub primitives: usize,
  pub nodes: usize,
  pub fragments: usize,
}

impl Copy for FrameStats {}

impl FrameStats {
  pub fn zero() -> FrameStats {
    return FrameStats {
      frame: 0,
      layout: LayoutStats.zero(),
      layoutSkipped: true,
      replayedSubtrees: 0,
      repaintedSubtrees: 0,
      replayedOperations: 0,
      paintedFragments: 0,
      culledSubtrees: 0,
      glyphs: 0,
      primitives: 0,
      nodes: 0,
      fragments: 0,
    }
  }
}

/// The paint cache of a node: the operations its subtree added to the scene of frame `frame`.
pub struct PaintCache {
  pub hash: u64,
  pub start: usize,
  pub end: usize,
  pub frame: u64,
  pub mask: Rect<f32>,
  pub scale: f32,
  /// The paint cull the subtree was painted under (see `Painter.cull`).
  pub cull: Rect<f32>,
}

impl Copy for PaintCache {}

impl PaintCache {
  pub fn empty() -> PaintCache {
    return PaintCache {
      hash: 0,
      start: 0,
      end: 0,
      frame: 0,
      mask: Rect<f32>.new(0.0, 0.0, 0.0, 0.0),
      scale: 0.0,
      cull: Rect<f32>.new(0.0, 0.0, 0.0, 0.0),
    }
  }
}

pub struct Node {
  pub id: u32,
  pub kind: NodeKind,
  pub live: bool,
  /// The css-layout node.
  pub css: usize,
  /// An input's text node in css-layout.
  pub inner: usize,
  /// The parent slot, or NONE.
  pub parent: u32,
  pub base: List<Declaration>,
  pub hover: List<Declaration>,
  pub active: List<Declaration>,
  pub focus: List<Declaration>,
  pub focusVisible: List<Declaration>,
  /// The `@starting-style` look (see `StyleState.Starting`).
  pub starting: List<Declaration>,
  pub computed: Computed,
  pub fontKey: usize,
  pub paintHash: u64,
  pub text: String,
  pub accessRole: Role,
  pub hasValueRange: bool,
  pub valueMin: f32,
  pub valueMax: f32,
  pub valueNow: f32,
  pub label: String,
  pub testId: String,
  pub tabIndex: i32,
  pub cursor: Cursor,
  pub disabled: bool,
  pub focusTrap: bool,
  /// `Attribute.Prevent`: the `PREVENT_*` flags.
  pub prevents: u32,
  /// `Attribute.Checked`, `Selected` and `Expanded`.
  pub checked: bool,
  pub selected: bool,
  pub expanded: bool,
  pub listeners: u32,
  pub layoutReported: bool,
  pub reportedBounds: Rect<f32>,
  pub hovered: bool,
  pub pressed: bool,
  /// The node's own style inputs changed since it was last resolved.
  pub styleDirty: bool,
  /// A node under this one has `styleDirty`.
  pub subtreeDirty: bool,
  /// The node and its ancestors were displayed at its last style resolve: it has a
  /// before-change style for transitions.
  pub rendered: bool,
  /// `Attribute.Transition`: CSS `transition` text applied under the base declarations.
  pub transition: String,
  /// The scroll offset of a scroll container, clamped to its range at the last frame.
  pub scrollX: f32,
  pub scrollY: f32,
  pub resource: u32,
  pub canvas: List<CanvasCommand>,
  /// Bumped when the text, source or canvas changes, and for inputs when the caret, the
  /// selection or the composition does.
  pub content: u64,
  /// An input's editing state, on the heap: inputs get one when they are made, other nodes
  /// only when given an editing attribute (`Multiline`, `ReadOnly`, `Placeholder`).
  pub editing: Option<Box<EditState>>,
  pub cache: PaintCache,
}

impl Node {
  /// Whether the node has editing state: every input does.
  pub fn hasEdit(self: &Self) -> bool {
    return match &self.editing {
      Option<Box<EditState>>.Some { .. } => true
      Option<Box<EditState>>.None => false
    }
  }

  /// The editing state; the node must have one (`hasEdit`), as inputs do.
  pub fn edit(self: &Self) -> &EditState {
    match &self.editing {
      Option<Box<EditState>>.Some { value } => {
        return &value.get()[0]
      }
      Option<Box<EditState>>.None => {
        return Intrinsic.trap("ui-tree: the node has no editing state")
      }
    }
  }

  /// The editing state to change; the node must have one (`hasEdit`), as inputs do.
  pub fn editMut(self: &mut Self) -> &mut EditState {
    match &mut self.editing {
      Option<Box<EditState>>.Some { value } => {
        return &mut value.getMut()[0]
      }
      Option<Box<EditState>>.None => {
        return Intrinsic.trap("ui-tree: the node has no editing state")
      }
    }
  }

  /// Gives the node editing state when it has none.
  pub effect fn ensureEdit(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    if !self.hasEdit() {
      self.editing = Option<Box<EditState>>.Some { value: run Box<EditState>.make(EditState.make()) }
    }
  }
}

/// A raster face per font key, loaded on first use.
pub struct FaceSlot<'a> {
  pub loaded: bool,
  pub face: Option<FontFace<'a>>,
}

/// A tile's pixels: `length` bytes at `offset` in [`Pending.bytes`], rows tightly packed.
pub struct Upload {
  pub tile: AtlasTile,
  pub offset: usize,
  pub length: usize,
}

impl Copy for Upload {}

/// The tiles a frame allocated in the atlas, gathered from the glyph cache, the icon cache and
/// the image store so a renderer copies them in one loop.
pub struct Pending {
  list: List<Upload>,
  data: List<u8>,
}

impl Pending {
  pub fn make() -> Pending {
    return Pending { list: List<Upload>.make(), data: List<u8>.make() }
  }

  /// Queues `tile` with `bytesPerRow`-byte rows starting at `offset` in `source`.
  pub effect fn push(
    self: &mut Self,
    tile: AtlasTile,
    source: &[u8],
    offset: usize,
    bytesPerRow: u32,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let rows = tile.bounds.yMax - tile.bounds.yMin
    let length = u32.toUsize(bytesPerRow) * u32.toUsize(rows)
    let at = self.data.length()
    run self.data.appendSlice(Slice.view(source, offset, length))
    run self.list.append(Upload { tile: tile, offset: at, length: length })
  }

  pub fn entries(self: &Self) -> &[Upload] {
    return self.list.asSlice()
  }

  /// Queues every upload of `other` after this one's, in order, for a renderer that takes a
  /// copy of a frame's uploads to another thread.
  pub effect fn appendAll(self: &mut Self, other: &Pending) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let base = self.data.length()
    run self.data.appendSlice(other.data.asSlice())
    let list = other.list.asSlice()
    let mut i: usize = 0
    while i < list.length {
      run self.list.append(
        Upload { tile: list[i].tile, offset: base + list[i].offset, length: list[i].length },
      )
      i = i + 1
    }
  }

  /// The pixels of `upload`.
  pub fn pixels(self: &Self, upload: Upload) -> &[u8] {
    return Slice.view(self.data.asSlice(), upload.offset, upload.length)
  }

  pub fn clear(self: &mut Self) -> () {
    self.list.clear()
    self.data.clear()
  }
}
