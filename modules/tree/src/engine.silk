/// Why a mutation or a frame failed.
pub union TreeError {
  /// Mutation `index` of the batch names a node id that does not exist.
  UnknownNode { pub index: usize, pub id: u32 },
  /// Mutation `index` creates a node id already in use.
  IdInUse { pub index: usize, pub id: u32 },
  /// Mutation `index` does not apply to the node's kind (children of a leaf, text of a box).
  WrongKind { pub index: usize, pub id: u32 },
  /// Mutation `index` would put a node inside itself, or move the root.
  BadMove { pub index: usize, pub id: u32 },
  /// Mutation `index` names a resource that is not defined.
  UnknownResource { pub index: usize, pub resource: u32 },
  /// Mutation `index` defines a resource whose data did not decode.
  BadResource { pub index: usize, pub resource: u32 },
  /// Layout or text shaping failed.
  Layout,
  /// Virtual list configuration or bindings are invalid.
  BadVirtualList { pub index: usize, pub id: u32 },
  /// A CSSOM View scroll scheduler operation failed.
  View { pub error: CssomError },
}

impl Copy for TreeError {}

/// An open root other than the current one: its share of the tree's state, kept while the
/// current root is laid out, painted and given input. [`UiTree.useRoot`] swaps it in. The
/// fields mean what the `UiTree` fields of the same names mean for the current root.
pub struct RootState {
  pub id: u32,
  pub options: RootOptions,
  /// The slot of the root node, or NONE.
  pub root: u32,
  /// The focused slot, or NONE.
  pub focused: u32,
  pub focusVisible: bool,
  /// The input of the root's last frame: its viewport.
  pub input: FrameInput,
  /// What the root's last frame did.
  pub stats: FrameStats,
  /// Changes to the root's published semantics or geometry (see `UiTree.revisionOf`).
  pub revision: u64,
  /// What the root's last layout and paint left behind, and what changed since, so a root
  /// nothing reached while it waited is neither laid out nor painted again when it is current.
  laidOut: FrameInput,
  laidOutRevision: usize,
  laidOutScrolls: usize,
  replayable: bool,
  stylesDirty: bool,
  applied: bool,
  paintDirty: bool,
  paintCachesStale: bool,
  layoutObserversDirty: bool,
  facesDirty: bool,
  paintedAt: u64,
  /// Whether a change reached the root's nodes while it waited without making it current (a
  /// node moved out of it, a resource or font family they use was defined again): its next
  /// frame styles, lays out and hashes again.
  pub touched: bool,
  output: LayoutTree,
  sceneA: Scene,
  sceneB: Scene,
  flipped: bool,
  paintOrder: List<u32>,
  fragmentHashes: List<u64>,
  fragmentInk: List<Rect<f32>>,
  fragmentScrollers: List<bool>,
  fragmentOf: List<usize>,
  nextSourceFragment: List<usize>,
  paintIndexOf: List<u32>,
  scrolled: bool,
  hoverChain: List<u64>,
  pressChain: List<u64>,
  capture: u32,
  captureId: u32,
  captureMode: u32,
  captureTo: u32,
  captureToId: u32,
  suppressText: bool,
  pendingTarget: u32,
  pendingTargetId: u32,
  pressCount: u32,
  thumbSlot: u32,
  thumbVertical: bool,
  thumbStart: f32,
  thumbOffset: f32,
  pointerX: f32,
  pointerY: f32,
  pointerInside: bool,
  reveal: List<u64>,
}

impl RootState {
  /// A root that was never framed, with root node `slot`.
  fn fresh(id: u32, options: RootOptions, slot: u32) -> RootState {
    return RootState {
      id: id,
      options: move options,
      root: slot,
      focused: NONE,
      focusVisible: false,
      input: FrameInput { width: 0.0, height: 0.0, scale: 1.0, time: 0.0 },
      stats: FrameStats.zero(),
      revision: 0,
      laidOut: FrameInput { width: -1.0, height: -1.0, scale: 0.0, time: 0.0 },
      laidOutRevision: usize.MAX,
      laidOutScrolls: usize.MAX,
      replayable: false,
      stylesDirty: true,
      applied: true,
      paintDirty: false,
      paintCachesStale: true,
      layoutObserversDirty: true,
      facesDirty: true,
      paintedAt: 0,
      touched: false,
      output: LayoutTree.make(),
      sceneA: Scene.make(),
      sceneB: Scene.make(),
      flipped: false,
      paintOrder: List<u32>.make(),
      fragmentHashes: List<u64>.make(),
      fragmentInk: List<Rect<f32>>.make(),
      fragmentScrollers: List<bool>.make(),
      fragmentOf: List<usize>.make(),
      nextSourceFragment: List<usize>.make(),
      paintIndexOf: List<u32>.make(),
      scrolled: false,
      hoverChain: List<u64>.make(),
      pressChain: List<u64>.make(),
      capture: NONE,
      captureId: NONE,
      captureMode: 0,
      captureTo: NONE,
      captureToId: NONE,
      suppressText: false,
      pendingTarget: NONE,
      pendingTargetId: NONE,
      pressCount: 0,
      thumbSlot: NONE,
      thumbVertical: true,
      thumbStart: 0.0,
      thumbOffset: 0.0,
      pointerX: 0.0,
      pointerY: 0.0,
      pointerInside: false,
      reveal: List<u64>.make(),
    }
  }
}

/// Whether `input` goes to the root that has the keyboard rather than the one under the
/// pointer.
fn keyboardInput(input: &Input) -> bool {
  return match &input.* {
    Input.KeyDown { .. } => true
    Input.KeyUp { .. } => true
    Input.TextInput { .. } => true
    Input.ImePreedit { .. } => true
    Input.Paste { .. } => true
    _ => false
  }
}

/// The node a mutation is about, in whose root it applies, or NONE: a new node, a resource,
/// a root, or the root that has the keyboard or the press.
fn nodeOf(mutation: &Mutation) -> u32 {
  return match &mutation.* {
    Mutation.SetAnchor { id, .. } => id
    Mutation.ClearAnchor { id } => id
    Mutation.SetVirtualList { id, .. } => id
    Mutation.SetVirtualItems { id, .. } => id
    Mutation.ClearVirtualList { id } => id
    Mutation.InsertBefore { parent, .. } => parent
    Mutation.Remove { id } => id
    Mutation.Destroy { id } => id
    Mutation.SetStyle { id, .. } => id
    Mutation.ClearStyle { id, .. } => id
    Mutation.SetText { id, .. } => id
    Mutation.SetSelection { id, .. } => id
    Mutation.SetAttribute { id, .. } => id
    Mutation.SetListeners { id, .. } => id
    Mutation.Focus { id } => id
    Mutation.SetPointerCapture { id } => id
    Mutation.ScrollTo { id, .. } => id
    Mutation.ScrollIntoView { id } => id
    Mutation.SetGrid { id, .. } => id
    Mutation.SetSource { id, .. } => id
    Mutation.SetCanvas { id, .. } => id
    _ => NONE
  }
}

/// Whether a mutation that names no node changes every root: a resource, a font family. A new
/// node is nobody's yet, and a root mutation changes its own root.
fn reachesEveryRoot(mutation: &Mutation) -> bool {
  return match &mutation.* {
    Mutation.Create { .. } => false
    Mutation.OpenRoot { .. } => false
    Mutation.UpdateRoot { .. } => false
    Mutation.CloseRoot { .. } => false
    _ => true
  }
}

/// A font face a client declared, by the client's id.
struct FontFaceEntry {
  id: u32,
  /// Its index in the text system's font set.
  declared: usize,
}

impl Copy for FontFaceEntry {}

struct FontKeyEntry {
  family: u32,
  size: f32,
  weight: f32,
  italic: bool,
  key: usize,
}

impl Copy for FontKeyEntry {}

effect fn layoutFailed<E>(error: E) -> never
  ! TreeError {
  drop error
  fail TreeError.Layout
}

effect fn viewFailed(error: CssomError) -> never
  ! TreeError {
  fail TreeError.View { error: error }
}

fn defaultDisplay(kind: NodeKind) -> CssDisplay {
  return match kind {
    NodeKind.Box => CssDisplay.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flow }
    NodeKind.Text => CssDisplay.Box { outside: DisplayOutside.Inline, inside: DisplayInside.Flow }
    NodeKind.Image => CssDisplay.Box { outside: DisplayOutside.Inline, inside: DisplayInside.Flow }
    NodeKind.Icon => CssDisplay.Box { outside: DisplayOutside.Inline, inside: DisplayInside.Flow }
    NodeKind.Input => CssDisplay.Box {
      outside: DisplayOutside.Inline,
      inside: DisplayInside.FlowRoot,
    }
    NodeKind.Canvas => CssDisplay.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flow }
  }
}

fn applyAll(computed: &mut Computed, list: &List<Declaration>) -> () {
  let items = list.asSlice()

  // Font size first: `em` lengths in the same patch refer to it.
  let mut i: usize = 0
  while i < items.length {
    if items[i].property == CssProperty.FontSize {
      computed.apply(&items[i])
    }
    i = i + 1
  }
  i = 0
  while i < items.length {
    if items[i].property != CssProperty.FontSize {
      computed.apply(&items[i])
    }
    i = i + 1
  }
}

/// Declarations a second party that shares the tree lays over what its client set for one
/// node in one state: the inspector's style edits. The tree applies them when it resolves the
/// node's style, over the client's declarations as `css.set` would (or instead of them, with
/// `replace`), so a client that restyles the node changes only what lies underneath: its own
/// declarations stay as it set them, the client is never told of the override, and taking the
/// override away shows exactly what the client last set. See [`UiTree.setOverride`].
pub struct StyleOverride {
  pub id: u32,
  pub state: StyleState,
  pub declarations: List<Declaration>,
  /// The client's declarations in this state are left out.
  pub replace: bool,
}

const SOURCE_PENDING: u8 = 0
const SOURCE_LOADED: u8 = 1
const SOURCE_FAILED: u8 = 2

/// The retained tree.
///
/// It borrows the fonts it draws with. Each frame: [`UiTree.apply`] the client's batches, call
/// [`UiTree.frame`], hand [`UiTree.scene`] and [`UiTree.uploads`] to a renderer, and drain
/// [`UiTree.takeEvents`].
///
/// It holds several roots (`Mutation.OpenRoot`), each laid out in its own viewport, in one id
/// space and with one glyph atlas. One root at a time is current: `frame`, `scene`, hit testing,
/// the geometry queries and pointer input are about it, and the per-root fields below (`root`,
/// `focused`, `input`, `stats`, `revision`, `output`, the scenes, hover, press and capture) are
/// its state. The other open roots wait in `parked`. [`UiTree.useRoot`] and
/// [`UiTree.frameRoot`] change the current root; key and text input go to `keyRoot`. A root
/// keeps what its last layout and paint left with its state, so changing roots costs no layout
/// or paint of its own: a root is laid out and painted again only for what changed in it.
/// `apply` leaves the current root as it was.
///
/// A root can be set aside for a second client that shares the tree, such as devtools running
/// in the app's process (`setAside`): its records and root events wait for that client.
pub struct UiTree<'a> {
  /// Tree-owned virtualization controllers. Use mutations and `virtualRange` to access them.
  pub virtualLists: List<VirtualList>,
  /// Retained popup placement relationships. Configure them through SetAnchor.
  pub anchors: List<Anchored>,
  pub layout: Tree,
  pub output: LayoutTree,
  pub provider: Provider<'a>,
  pub nodes: List<Node>,
  free: List<u32>,
  ids: HashMap<Word, u32>,
  /// The slot of each css-layout node, or NONE.
  pub slotOfCss: List<u32>,
  /// The root slot, or NONE.
  pub root: u32,
  /// The focused slot, or NONE.
  pub focused: u32,
  families: Families,
  pub resources: Resources,
  /// `LoadImage` and `LoadIcon` mutations waiting for the host's loaders (`takeLoads`). The
  /// tree does no I/O: a host reads, fetches or looks up the URL, then defines the resource.
  pub loads: List<Mutation>,
  /// What became of each loaded resource, by id: `SOURCE_*`.
  sourceStates: List<u8>,
  /// Nodes that were given a source that already settled, told after the batch.
  sourceTells: List<u32>,
  fontKeys: List<FontKeyEntry>,
  fontFaces: List<FontFaceEntry>,
  pub faces: List<FaceSlot<'a>>,
  pub atlas: Atlas,
  pub glyphs: GlyphCache,
  pub paths: PathCache,
  pub sceneA: Scene,
  pub sceneB: Scene,
  /// Whether `sceneB` holds the current frame.
  pub flipped: bool,
  /// Whether the previous scene can be replayed from (false after a resize of the atlas
  /// or before the first frame).
  pub replayable: bool,
  pub seed: HashSeed,
  pub stylesDirty: bool,
  /// Some nodes have `styleDirty`: the next resolve visits only their subtrees' paths.
  pub stylesPending: bool,
  pub frameNumber: u64,
  /// Changes to published semantics or allocated geometry.
  pub semanticRevision: u64,
  /// The changes of `semanticRevision` that reached the current root (see `revisionOf`).
  pub revision: u64,
  pub input: FrameInput,
  laidOut: FrameInput,
  laidOutRevision: usize,
  laidOutScrolls: usize,
  /// The viewport size css-layout's root has: the last root laid out sets it.
  styledViewport: FrameInput,
  /// The frame the current root last painted at: its subtrees cached then can be replayed.
  paintedAt: u64,
  pub stats: FrameStats,
  pub events: List<Event>,
  /// The node ids in the order the last frame painted them (replayed subtrees included).
  pub paintOrder: List<u32>,
  /// Per fragment of the last layout: the hash of its subtree's paint inputs.
  pub fragmentHashes: List<u64>,
  /// Per fragment of the last layout: the bounds of its subtree's ink in CSS pixels.
  pub fragmentInk: List<Rect<f32>>,
  /// Per fragment of the last layout: whether its subtree holds a scroll container.
  pub fragmentScrollers: List<bool>,
  /// Whether the fragment hashes and ink are out of date: layout, styles or mutations changed
  /// since they were computed. Scrolling leaves them as they are.
  paintCachesStale: bool,
  /// Whether a scroll offset changed since the last frame.
  pub scrolled: bool,
  /// Whether some node may hold a scroll offset other than zero: set by every write of one,
  /// cleared by `settleScrolls` when it finds none, so a tree that never scrolled skips its
  /// walk over the nodes.
  pub offsets: bool,
  /// Whether no scroll offset changed between the previous frame and this one.
  scrollsStill: bool,
  pub textInk: List<TextInk>,
  facesDirty: bool,
  pub uploads: Pending,
  /// The first fragment of each css-layout node in the last layout, or NO_INDEX.
  pub fragmentOf: List<usize>,
  /// Next fragment with the same CSS source, in arena order.
  pub nextSourceFragment: List<usize>,
  /// First paint-order index per node slot, or NONE.
  pub paintIndexOf: List<u32>,
  /// Whether focus should show as focus-visible: the last focus change came from the keyboard.
  pub focusVisible: bool,
  /// The hovered nodes as (slot, id) pairs, the target first, then its ancestors.
  pub hoverChain: List<u64>,
  /// The nodes in the active state as (slot, id) pairs, and the node holding the pointer
  /// capture (NONE when no button is down).
  pub pressChain: List<u64>,
  pub capture: u32,
  pub captureId: u32,
  /// Where the press sends its pointer records: `CAPTURE_IMPLICIT` (the pressed node),
  /// `CAPTURE_EXPLICIT` (the node below, set with `SetPointerCapture`) or `CAPTURE_RELEASED`
  /// (the node under the pointer).
  pub captureMode: u32,
  pub captureTo: u32,
  pub captureToId: u32,
  /// The last key down had its default prevented, so the text it types is dropped.
  pub suppressText: bool,
  /// The target `begin` found for the input under way, as a (slot, id) pair, so `finish`
  /// applies the default action to that node even when handlers changed the tree between.
  pub pendingTarget: u32,
  pub pendingTargetId: u32,
  /// The click count of the press, for its click record.
  pub pressCount: u32,
  /// A scrollbar thumb being dragged: the container slot (NONE when none), the axis, and the
  /// pointer and scroll offset where the drag started.
  pub thumbSlot: u32,
  pub thumbVertical: bool,
  pub thumbStart: f32,
  pub thumbOffset: f32,
  /// Where the pointer is, and whether it is in the window.
  pub pointerX: f32,
  pub pointerY: f32,
  pub pointerInside: bool,
  /// Nodes to scroll into view at the next frame, as (slot, id) pairs.
  pub reveal: List<u64>,
  /// CSSOM scroll completion/events and the animations driven by the real frame clock.
  pub viewScrollState: ScrollState,
  pub viewScrollAnimations: List<ScrollAnimation>,
  /// Whether a mutation was applied since the last frame.
  applied: bool,
  pub layoutObserversDirty: bool,
  /// Whether something only paint shows changed since the last frame (a caret moved).
  pub paintDirty: bool,
  /// Requests for the host (clipboard), oldest first.
  pub requests: List<HostRequest>,
  /// The modifier keys editing shortcuts use; the compilation target's by default.
  pub keymap: Keymap,
  /// The id of the current root, and whether it is open. Before any root opens, the current
  /// root is the first one, closed.
  pub current: u32,
  pub currentOpen: bool,
  pub currentOptions: RootOptions,
  /// The open roots other than the current one.
  pub parked: List<RootState>,
  /// The root key and text input go to: the last one a host reported `Focused`, the first
  /// root until then.
  pub keyRoot: u32,
  /// The root of the input `begin` started, for `finish`.
  pendingRoot: u32,
  /// What roots this tree shows: any number of headless surfaces unless a host says less.
  pub rootSupport: RootSupport,
  /// Root events for the client, oldest first.
  pub rootEvents: List<RootEvent>,
  /// The roots set aside for a second client in the same tree (see `setAside`).
  pub aside: List<u32>,
  /// What `sceneOf` gives for a root that is not open.
  empty: Scene,
  /// The style overrides (see `setOverride`), a few at most; styles resolve as before while
  /// there are none.
  overrides: List<StyleOverride>,
}

impl<'a> UiTree<'a> {
  /// An empty tree drawing with the fonts of `collection`.
  pub effect fn make(collection: &'a FontCollection) -> UiTree<'a>
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut viewport = CssStyle.make()
    viewport.width = Dimension.px(0.0)
    viewport.height = Dimension.px(0.0)
    let mut layout = run Tree.make(move viewport)

    // Scroll and sticky offsets are applied when painting, so scrolling needs no layout.
    layout.stickyDeferred = true
    let resources = run Effect.catch<ResourceError>(Resources.make(), layoutFailed)
    let seed = Hash.seed(0x7569747265)
    return UiTree<'a> {
      virtualLists: List<VirtualList>.make(),
      anchors: List<Anchored>.make(),
      layout: move layout,
      output: LayoutTree.make(),
      provider: Provider<'a> {
        text: TextSystem.make(collection),
        naturals: List<NaturalDimensions>.make(),
      },
      nodes: List<Node>.make(),
      free: List<u32>.make(),
      ids: HashMap<Word, u32>.make(seed),
      slotOfCss: List<u32>.make(),
      root: NONE,
      focused: NONE,
      families: Families.make(),
      resources: move resources,
      loads: List<Mutation>.make(),
      sourceStates: List<u8>.make(),
      sourceTells: List<u32>.make(),
      fontKeys: List<FontKeyEntry>.make(),
      fontFaces: List<FontFaceEntry>.make(),
      faces: List<FaceSlot<'a>>.make(),
      atlas: Atlas.make(AtlasOptions.default()),
      glyphs: GlyphCache.make(),
      paths: PathCache.make(),
      sceneA: Scene.make(),
      sceneB: Scene.make(),
      flipped: false,
      replayable: false,
      seed: seed,
      stylesDirty: true,
      stylesPending: false,
      frameNumber: 0,
      semanticRevision: 0,
      revision: 0,
      input: FrameInput { width: 0.0, height: 0.0, scale: 1.0, time: 0.0 },
      laidOut: FrameInput { width: -1.0, height: -1.0, scale: 0.0, time: 0.0 },
      laidOutRevision: usize.MAX,
      laidOutScrolls: usize.MAX,
      styledViewport: FrameInput { width: -1.0, height: -1.0, scale: 0.0, time: 0.0 },
      paintedAt: 0,
      stats: FrameStats.zero(),
      events: List<Event>.make(),
      paintOrder: List<u32>.make(),
      fragmentHashes: List<u64>.make(),
      fragmentInk: List<Rect<f32>>.make(),
      fragmentScrollers: List<bool>.make(),
      paintCachesStale: true,
      scrolled: false,
      offsets: false,
      scrollsStill: false,
      textInk: List<TextInk>.make(),
      facesDirty: true,
      uploads: Pending.make(),
      fragmentOf: List<usize>.make(),
      nextSourceFragment: List<usize>.make(),
      paintIndexOf: List<u32>.make(),
      focusVisible: false,
      hoverChain: List<u64>.make(),
      pressChain: List<u64>.make(),
      capture: NONE,
      captureId: NONE,
      captureMode: 0,
      captureTo: NONE,
      captureToId: NONE,
      suppressText: false,
      pendingTarget: NONE,
      pendingTargetId: NONE,
      pressCount: 0,
      thumbSlot: NONE,
      thumbVertical: true,
      thumbStart: 0.0,
      thumbOffset: 0.0,
      pointerX: 0.0,
      pointerY: 0.0,
      pointerInside: false,
      reveal: List<u64>.make(),
      viewScrollState: ScrollState.make(),
      viewScrollAnimations: List<ScrollAnimation>.make(),
      applied: false,
      layoutObserversDirty: false,
      paintDirty: false,
      requests: List<HostRequest>.make(),
      keymap: NATIVE_KEYMAP,
      current: FIRST_ROOT,
      currentOpen: false,
      currentOptions: RootOptions.default(),
      parked: List<RootState>.make(),
      keyRoot: FIRST_ROOT,
      pendingRoot: FIRST_ROOT,
      rootSupport: RootSupport { count: u32.MAX, extra: ExtraRoot.Surface },
      rootEvents: List<RootEvent>.make(),
      aside: List<u32>.make(),
      empty: Scene.make(),
      overrides: List<StyleOverride>.make(),
    }
  }

  // Nodes.

  /// Says that resource `resource` (from a `LoadImage` or `LoadIcon`) loaded or failed: each
  /// image or icon showing it that listens gets a `Load` or `Error` record, and so does any
  /// node that shows it later.
  pub effect fn settleSource(self: &mut Self, resource: u32, ok: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let at = u32.toUsize(resource)
    let have = self.sourceStates.length()
    if at >= have {
      run self.sourceStates.appendRepeated(SOURCE_PENDING, at + 1 - have)
    }
    let states = self.sourceStates.asMutSlice()
    states[at] = if ok { SOURCE_LOADED } else { SOURCE_FAILED }
    drop states
    let mut i: usize = 0
    while i < self.nodes.length() {
      let node = &self.nodes.asSlice()[i]
      if node.live && node.resource == resource
        && (node.kind == NodeKind.Image || node.kind == NodeKind.Icon) {
        run self.tellSource(usize.toU32(i), ok)
      }
      i = i + 1
    }
  }

  fn sourceState(self: &Self, resource: u32) -> u8 {
    let at = u32.toUsize(resource)
    if at >= self.sourceStates.length() {
      return SOURCE_PENDING
    }
    return self.sourceStates.asSlice()[at]
  }

  /// Queues the `Load` or `Error` record of node `slot`, if it listens.
  effect fn tellSource(self: &mut Self, slot: u32, ok: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let node = self.node(slot)
    let flag = if ok { LISTEN_LOAD } else { LISTEN_ERROR }
    if u32.bitAnd(node.listeners, flag) == 0 {
      return ()
    }
    let id = node.id
    let mut path = List<u32>.make()
    run self.pathTo(slot, &mut path)
    let kind = if ok { EventKind.Load } else { EventKind.Error }
    run self.queueEvent(Event.make(kind, id, move path))
  }

  /// The `LoadImage` and `LoadIcon` requests applied since the last call, for the host to
  /// serve: it loads each URL and answers with `DefineImage` or `DefineIcon`.
  pub fn takeLoads(self: &mut Self) -> List<Mutation> {
    return Intrinsic.replace(self.loads, List<Mutation>.make())
  }

  /// The slot of node `id`, or NONE.
  pub fn slotOf(self: &Self, id: u32) -> u32 {
    return match self.ids.get(Word { value: u32.toU64(id) }) {
      Option<u32>.Some { value } => value
      Option<u32>.None => NONE
    }
  }

  /// Whether node `id` exists.
  pub fn contains(self: &Self, id: u32) -> bool {
    return self.slotOf(id) != NONE
  }

  pub fn node(self: &Self, slot: u32) -> &Node {
    return &self.nodes.asSlice()[u32.toUsize(slot)]
  }

  /// Says that the style inputs of the node at `slot` changed (its declarations, its
  /// parent, its hover, press or focus state): the next resolve restyles it, and its
  /// descendants as far as what they inherit changed. Its ancestors are marked so the resolve
  /// finds it from the root.
  pub fn restyle(self: &mut Self, slot: u32) -> () {
    self.stylesPending = true
    let nodes = self.nodes.asMutSlice()
    nodes[u32.toUsize(slot)].styleDirty = true
    let mut up = nodes[u32.toUsize(slot)].parent
    while up != NONE {
      let at = u32.toUsize(up)
      if nodes[at].subtreeDirty {
        return ()
      }
      nodes[at].subtreeDirty = true
      up = nodes[at].parent
    }
  }

  fn nodeMut(self: &mut Self, slot: u32) -> &mut Node {
    return &mut self.nodes.asMutSlice()[u32.toUsize(slot)]
  }

  /// The slot of css-layout node `index`, or NONE.
  pub fn slotOfCssNode(self: &Self, index: usize) -> u32 {
    if index < self.slotOfCss.length() {
      return self.slotOfCss.get(index)
    }
    return NONE
  }

  effect fn mapCss(self: &mut Self, index: usize, slot: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    while self.slotOfCss.length() <= index {
      run self.slotOfCss.append(NONE)
    }
    self.slotOfCss.set(index, slot)
  }

  /// Returns the items a virtual container needs mounted after the latest configuration or frame.
  /// Clients reconcile this range with ordinary node mutations, then call `frame` again.
  pub fn virtualRange(self: &Self, id: u32) -> Option<VirtualRange> {
    return virtual.request(&self, id)
  }

  /// The number of live nodes.
  pub fn nodeCount(self: &Self) -> usize {
    return self.ids.length()
  }

  /// The id of the root node, or NONE.
  pub fn rootId(self: &Self) -> u32 {
    if self.root == NONE {
      return NONE
    }
    return self.node(self.root).id
  }

  /// The children of `slot`, in order.
  pub effect fn childSlots(self: &Self, slot: u32, out: &mut List<u32>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    out.clear()
    let css = self.node(slot).css
    let nodes = self.layout.nodes.asSlice()
    let mut child = nodes[css].firstChild
    while child != NO_INDEX {
      let found = self.slotOfCssNode(child)
      if found != NONE {
        run out.append(found)
      }
      child = nodes[child].nextSibling
    }
  }

  // Mutations.

  /// Applies `batch` in order. On a bad mutation it stops and fails with its index; the
  /// mutations before it stay applied. A mutation about a node of another open root applies
  /// in that root (see `applyOne`); the root that was current is current again afterwards,
  /// unless the batch closed it.
  pub effect fn apply(self: &mut Self, batch: List<Mutation>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let before = self.current
    run self.applyAll(move batch)
    if self.current != before && self.rootOpen(before) {
      drop run self.useRoot(before)
    }
    if self.sourceTells.length() > 0 {
      let tells = Intrinsic.replace(self.sourceTells, List<u32>.make())
      let ids = tells.asSlice()
      let mut i: usize = 0
      while i < ids.length {
        let slot = self.slotOf(ids[i])
        if slot != NONE {
          let state = self.sourceState(self.node(slot).resource)
          if state != SOURCE_PENDING {
            run self.tellSource(slot, state == SOURCE_LOADED)
          }
        }
        i = i + 1
      }
    }
  }

  effect fn applyAll(self: &mut Self, batch: List<Mutation>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut mutations = move batch
    let mut reversed = List<Mutation>.make()
    while true {
      match mutations.pop() {
        Option<Mutation>.Some { value } => {
          run reversed.append(move value)
        }
        Option<Mutation>.None => {
          break
        }
      }
    }
    let mut index: usize = 0
    while true {
      match reversed.pop() {
        Option<Mutation>.Some { value } => {
          run self.applyOne(index, move value)
        }
        Option<Mutation>.None => {
          break
        }
      }
      index = index + 1
    }
  }

  /// Applies one mutation; `index` is reported in errors. A mutation about a node of another
  /// open root makes that root current first, so what it changes is that root's to lay out and
  /// paint, and the current root's last frame still stands.
  pub effect fn applyOne(self: &mut Self, index: usize, mutation: Mutation) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    self.semanticRevision = self.semanticRevision + 1
    let about = nodeOf(&mutation)
    if self.parked.length() == 0 {
      self.revision = self.revision + 1
    } else if about != NONE {
      // The change is the root's that holds the node; one to a detached node is nobody's yet.
      let slot = self.slotOf(about)
      if slot != NONE {
        let holder = self.rootOfTop(self.topOf(slot))
        if holder != NONE {
          drop run self.useRoot(holder)
          self.revision = self.revision + 1
        }
      }
    } else if reachesEveryRoot(&mutation) {
      self.changedEveryRoot()
    }
    self.applied = true
    match move mutation {
      Mutation.SetAnchor { id, target, options } => {
        run anchoring.configure(&mut self, index, id, target, options)
      }
      Mutation.ClearAnchor { id } => {
        anchoring.clear(&mut self, id)
      }
      Mutation.SetVirtualList { id, count, options } => {
        run virtual.configure(&mut self, index, id, count, options)
      }
      Mutation.SetVirtualItems { id, items } => {
        run virtual.bind(&mut self, index, id, move items)
      }
      Mutation.ClearVirtualList { id } => {
        run virtual.clear(&mut self, id)
      }
      Mutation.Create { id, kind } => {
        run self.create(index, id, kind)
      }
      Mutation.InsertBefore { parent, child, before } => {
        run self.insertBefore(index, parent, child, before)
      }
      Mutation.Remove { id } => {
        let slot = run self.require(index, id)
        run self.detach(index, slot)
      }
      Mutation.Destroy { id } => {
        let slot = run self.require(index, id)
        run self.destroy(index, slot)
      }
      Mutation.SetStyle { id, state, declarations } => {
        let slot = run self.require(index, id)
        let values = declarations.asSlice()
        let node = self.nodeMut(slot)
        let mut i: usize = 0
        while i < values.length {
          match state {
            StyleState.Base => {
              run css.set(&mut node.base, &values[i])
            }
            StyleState.Hover => {
              run css.set(&mut node.hover, &values[i])
            }
            StyleState.Active => {
              run css.set(&mut node.active, &values[i])
            }
            StyleState.Focus => {
              run css.set(&mut node.focus, &values[i])
            }
            StyleState.FocusVisible => {
              run css.set(&mut node.focusVisible, &values[i])
            }
          }
          i = i + 1
        }
        self.restyle(slot)
      }
      Mutation.ClearStyle { id, state } => {
        let slot = run self.require(index, id)
        let node = self.nodeMut(slot)
        match state {
          StyleState.Base => {
            node.base.clear()
          }
          StyleState.Hover => {
            node.hover.clear()
          }
          StyleState.Active => {
            node.active.clear()
          }
          StyleState.Focus => {
            node.focus.clear()
          }
          StyleState.FocusVisible => {
            node.focusVisible.clear()
          }
        }
        self.restyle(slot)
      }
      Mutation.SetText { id, value } => {
        let slot = run self.require(index, id)
        run self.setText(index, slot, move value)
      }
      Mutation.SetAttribute { id, attribute } => {
        let slot = run self.require(index, id)
        let node = self.nodeMut(slot)
        match move attribute {
          Attribute.ValueRange { min, max, value } => {
            node.hasValueRange = true
            node.valueMin = min
            node.valueMax = max
            node.valueNow = value
          }
          Attribute.ClearValueRange => {
            node.hasValueRange = false
          }

          Attribute.Role { value } => {
            node.accessRole = value
          }
          Attribute.Label { value } => {
            node.label = move value
          }
          Attribute.TestId { value } => {
            node.testId = move value
          }
          Attribute.TabIndex { value } => {
            node.tabIndex = value
          }
          Attribute.Cursor { value } => {
            node.cursor = value
          }
          Attribute.Disabled { value } => {
            node.disabled = value
          }
          Attribute.Prevent { actions } => {
            node.prevents = actions
          }
          Attribute.FocusTrap { value } => {
            node.focusTrap = value
          }
          Attribute.Checked { value } => {
            node.checked = value
          }
          Attribute.Selected { value } => {
            node.selected = value
          }
          Attribute.Expanded { value } => {
            node.expanded = value
          }
          Attribute.Multiline { value } => {
            run node.ensureEdit()
            let edited = node.editMut()
            edited.multiline = value
            let isInput = node.kind == NodeKind.Input
            self.restyle(slot)
            if isInput {
              run edit.syncDisplay(&mut self, slot)
            }
          }
          Attribute.ReadOnly { value } => {
            run node.ensureEdit()
            let edited = node.editMut()
            edited.readOnly = value
            node.content = node.content + 1
            self.paintDirty = true
          }
          Attribute.Placeholder { value } => {
            run node.ensureEdit()
            let edited = node.editMut()
            edited.placeholder = move value
            let isInput = node.kind == NodeKind.Input
            if isInput {
              run edit.syncDisplay(&mut self, slot)
            }
          }
          Attribute.Href { value } => {
            // The client follows its links; the tree draws nothing for them.
            drop value
          }
          Attribute.Transition { value } => {
            drop value
          }
          Attribute.Element { name } => {
            // Document backends only.
            drop name
          }
          Attribute.ClassName { value } => {
            drop value
          }
          Attribute.ElementId { value } => {
            drop value
          }
        }
      }
      Mutation.SetSelection { id, anchor, focus } => {
        let slot = run self.require(index, id)
        if self.node(slot).kind != NodeKind.Input {
          fail TreeError.WrongKind { index: index, id: id }
        }
        run edit.setSelection(&mut self, slot, anchor, focus)
      }
      Mutation.SetListeners { id, flags } => {
        let slot = run self.require(index, id)
        let node = self.nodeMut(slot)
        if u32.bitAnd(node.listeners, LISTEN_LAYOUT) == 0 {
          node.layoutReported = false
        }
        node.listeners = flags
        self.layoutObserversDirty = true
      }
      Mutation.OpenRoot { root, node, options } => {
        let slot = run self.require(index, node)
        let owner = self.rootHolding(slot)
        run self.openRoot(index, root, slot, move options)
        self.changedRoot(root)
        if owner != NONE && owner != root {
          self.touchRoot(owner)
        }
      }
      Mutation.UpdateRoot { root, options } => {
        self.changedRoot(root)
        if root == self.current {
          if self.currentOpen {
            self.currentOptions = move options
          }
        } else {
          let at = self.parkedIndex(root)
          if at != usize.MAX {
            let parked = self.parked.asMutSlice()
            parked[at].options = move options
          }
        }
      }
      Mutation.CloseRoot { root } => {
        run self.closeRoot(index, root)
      }
      Mutation.Focus { id } => {
        let slot = run self.require(index, id)
        run self.focusSlot(slot)
      }
      Mutation.Blur => {
        let keyed = self.keyTarget()
        drop run self.useRoot(keyed)
        run self.focusSlot(NONE)
      }
      Mutation.SetPointerCapture { id } => {
        let slot = run self.require(index, id)
        drop run interact.setCapture(&mut self, slot)
      }
      Mutation.ReleasePointerCapture => {
        run interact.releaseCapture(&mut self)
      }
      Mutation.ScrollTo { id, x, y } => {
        let slot = run self.require(index, id)
        self.viewScrollState.interruptTarget(
          ViewTarget { kind: ViewTargetKind.Element, id: u32.toUsize(id) },
        )
        run interact.scrollTo(&mut self, slot, x, y)
      }
      Mutation.ScrollIntoView { id } => {
        let slot = run self.require(index, id)
        self.viewScrollState.interruptAll()
        self.viewScrollAnimations.clear()
        run self.reveal.append(interact.pair(slot, id))
      }
      Mutation.SetGrid { id, value } => {
        let slot = run self.require(index, id)
        let css = self.node(slot).css
        let grid = Box<Grid>.into(move value)
        run Effect.catchAll(grid.install(&mut self.layout, NodeId { index: css }), layoutFailed)
        self.paintDirty = true
      }
      Mutation.SetSource { id, resource } => {
        let slot = run self.require(index, id)
        let kind = self.node(slot).kind
        if kind != NodeKind.Image && kind != NodeKind.Icon {
          fail TreeError.WrongKind { index: index, id: id }
        }
        match self.resources.get(resource) {
          Option<Resource>.Some { value } => {
            let matches = match value {
              Resource.Image { .. } => kind == NodeKind.Image
              Resource.Icon { .. } => kind == NodeKind.Icon
            }
            if !matches {
              fail TreeError.WrongKind { index: index, id: id }
            }
          }
          // Not loaded yet: the node shows nothing until it is (see `Mutation.LoadImage`).
          Option<Resource>.None => {}
        }
        let node = self.nodeMut(slot)
        node.resource = resource
        node.content = node.content + 1
        run self.updateNatural(slot)
        // A source that already settled still tells a new node, as an image from the cache
        // does on the web.
        // Told once the batch is applied, when the node is in place.
        if self.sourceState(resource) != SOURCE_PENDING {
          run self.sourceTells.append(id)
        }
      }
      Mutation.SetCanvas { id, commands } => {
        let slot = run self.require(index, id)
        if self.node(slot).kind != NodeKind.Canvas {
          fail TreeError.WrongKind { index: index, id: id }
        }
        let node = self.nodeMut(slot)
        node.canvas = move commands
        node.content = node.content + 1
      }
      Mutation.DefineFontFamily { family, names } => {
        run self.families.define(family, String.view(&names))

        // Keys made from the old list keep their faces; restyle so new keys are made.
        let entries = self.fontKeys.asMutSlice()
        let mut i: usize = 0
        while i < entries.length {
          if entries[i].family == family {
            entries[i].family = NONE
          }
          i = i + 1
        }
        self.stylesDirty = true
        let parked = self.parked.asMutSlice()
        let mut p: usize = 0
        while p < parked.length {
          parked[p].touched = true
          p = p + 1
        }
      }
      Mutation.DefineImage { resource, data } => {
        let ok = run Effect.catch<ResourceError>(
          defineImage(&mut self.resources, &mut self.atlas, resource, Bytes.asSlice(&data)),
          resourceFailed,
        )
        if !ok {
          fail TreeError.BadResource { index: index, resource: resource }
        }
        run self.refreshSources(resource)
      }
      Mutation.DefineDecodedImage { resource, image } => {
        run self.resources.defineDecoded(&mut self.atlas, resource, move image)
        run self.refreshSources(resource)
      }
      Mutation.ReleaseResource { resource } => {
        run self.resources.release(&mut self.atlas, resource)
        run self.refreshSources(resource)
      }
      Mutation.DefineIcon { resource, data } => {
        let ok = run Effect.catch<ResourceError>(
          defineIcon(&mut self.resources, &mut self.atlas, resource, Bytes.asSlice(&data)),
          resourceFailed,
        )
        if !ok {
          fail TreeError.BadResource { index: index, resource: resource }
        }
        run self.refreshSources(resource)
      }
      Mutation.LoadImage { resource, url } => {
        run self.loads.append(Mutation.LoadImage { resource: resource, url: move url })
      }
      Mutation.LoadIcon { resource, url } => {
        run self.loads.append(Mutation.LoadIcon { resource: resource, url: move url })
      }
    }
  }

  effect fn require(self: &Self, index: usize, id: u32) -> u32
    ! TreeError {
    let slot = self.slotOf(id)
    if slot == NONE {
      fail TreeError.UnknownNode { index: index, id: id }
    }
    return slot
  }

  effect fn create(self: &mut Self, index: usize, id: u32, kind: NodeKind) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if self.contains(id) {
      fail TreeError.IdInUse { index: index, id: id }
    }
    let mut css: usize = 0
    let mut inner: usize = NO_INDEX
    if kind == NodeKind.Text {
      let made = run self.layout.createText(String.make())
      css = made.index
    } else {
      let made = run self.layout.create(CssStyle.make())
      css = made.index
      if kind == NodeKind.Input {
        let text = run self.layout.createText(String.make())
        inner = text.index
        run Effect.catchAll(
          self.layout.insertBefore(
            NodeId { index: css },
            NodeId { index: inner },
            Option<NodeId>.None,
          ),
          layoutFailed,
        )
      }
    }
    let mut computed = Computed.inheriting(TextStyle.initial())
    computed.layout.display = defaultDisplay(kind)
    let mut editing = Option<Box<EditState>>.None
    if kind == NodeKind.Input {
      editing = Option<Box<EditState>>.Some { value: run Box<EditState>.make(EditState.make()) }
    }
    let node = Node {
      id: id,
      kind: kind,
      live: true,
      css: css,
      inner: inner,
      parent: NONE,
      base: List<Declaration>.make(),
      hover: List<Declaration>.make(),
      active: List<Declaration>.make(),
      focus: List<Declaration>.make(),
      focusVisible: List<Declaration>.make(),
      computed: computed,
      fontKey: 0,
      paintHash: 0,
      text: String.make(),
      accessRole: Role.None,
      hasValueRange: false,
      valueMin: 0.0,
      valueMax: 0.0,
      valueNow: 0.0,
      label: String.make(),
      testId: String.make(),
      tabIndex: if kind == NodeKind.Input {
        0
      } else {
        NOT_FOCUSABLE
      },
      cursor: Cursor.Default,
      disabled: false,
      focusTrap: false,
      prevents: 0,
      checked: false,
      selected: false,
      expanded: false,
      listeners: 0,
      layoutReported: false,
      reportedBounds: Rect<f32>.new(0.0, 0.0, 0.0, 0.0),
      hovered: false,
      pressed: false,
      styleDirty: true,
      subtreeDirty: false,
      scrollX: 0.0,
      scrollY: 0.0,
      resource: NONE,
      canvas: List<CanvasCommand>.make(),
      content: 1,
      editing: move editing,
      effects: Option<Box<Effects>>.None,
      cache: PaintCache.empty(),
    }
    let mut slot: u32 = 0
    if self.free.length() != 0 {
      let last = self.free.length() - 1
      slot = self.free.get(last)
      self.free.truncate(last)
      let nodes = self.nodes.asMutSlice()
      nodes[u32.toUsize(slot)] = move node
    } else {
      slot = usize.toU32(self.nodes.length())
      run self.nodes.append(move node)
    }
    drop run self.ids.insert(Word { value: u32.toU64(id) }, slot)
    run self.mapCss(css, slot)
    if inner != NO_INDEX {
      // The input's text node maps to no slot, but the table reaches it so `destroy` can clear it.
      run self.mapCss(inner, NONE)
    }
    if kind == NodeKind.Image || kind == NodeKind.Icon {
      run Effect.catchAll(
        self.layout.setNaturalMeasurement(NodeId { index: css }, u32.toUsize(slot)),
        layoutFailed,
      )
    }
    if kind == NodeKind.Input {
      run edit.syncDisplay(&mut self, slot)
    }
    // A new node is detached: it is resolved when it is attached (`restyle`).
  }

  fn canHaveChildren(kind: NodeKind) -> bool {
    return kind == NodeKind.Box
  }

  /// Whether `slot` is `ancestor` or inside it.
  fn within(self: &Self, slot: u32, ancestor: u32) -> bool {
    let mut at = slot
    while at != NONE {
      if at == ancestor {
        return true
      }
      at = self.node(at).parent
    }
    return false
  }

  effect fn insertBefore(
    self: &mut Self,
    index: usize,
    parent: u32,
    child: u32,
    before: Option<u32>,
  ) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let parentSlot = run self.require(index, parent)
    let childSlot = run self.require(index, child)
    if !UiTree.canHaveChildren(self.node(parentSlot).kind) {
      fail TreeError.WrongKind { index: index, id: parent }
    }
    if self.isRootNode(childSlot) || self.within(parentSlot, childSlot) {
      fail TreeError.BadMove { index: index, id: child }
    }
    let mut beforeCss = Option<NodeId>.None
    if let Option<u32>.Some { value } = before {
      let beforeSlot = run self.require(index, value)
      if self.node(beforeSlot).parent != parentSlot {
        fail TreeError.BadMove { index: index, id: value }
      }
      if beforeSlot == childSlot {
        return ()
      }
      beforeCss = Option<NodeId>.Some { value: NodeId { index: self.node(beforeSlot).css } }
    }
    let parentCss = self.node(parentSlot).css
    let childCss = self.node(childSlot).css
    let from = self.rootHolding(childSlot)
    run Effect.catchAll(
      self.layout.insertBefore(NodeId { index: parentCss }, NodeId { index: childCss }, beforeCss),
      layoutFailed,
    )
    let moved = self.nodeMut(childSlot)
    moved.parent = parentSlot
    self.restyle(childSlot)

    // The child left another root, which is not current: that root changed all the same.
    if from != NONE && from != self.current {
      self.touchRoot(from)
    }
  }

  effect fn detach(self: &mut Self, index: usize, slot: u32) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let parent = self.node(slot).parent
    let css = self.node(slot).css
    if parent == NONE && slot != self.root {
      return ()
    }
    run Effect.catchAll(self.layout.remove(NodeId { index: css }), layoutFailed)
    if slot == self.root {
      self.root = NONE
    }
    let detached = self.nodeMut(slot)
    detached.parent = NONE
    if self.focused != NONE && self.within(self.focused, slot) {
      run self.focusSlot(NONE)
    }
    // No style depends on a sibling or a child, so the nodes left behind keep theirs. The
    // detached subtree is resolved when it is attached again.
    self.applied = true
  }

  effect fn destroy(self: &mut Self, index: usize, slot: u32) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.detach(index, slot)
    let mut doomed = List<u32>.make()
    run doomed.append(slot)
    let mut children = List<u32>.make()
    let mut at: usize = 0
    while at < doomed.length() {
      run self.childSlots(doomed.get(at), &mut children)
      run doomed.appendSlice(children.asSlice())
      at = at + 1
    }
    let mut v: usize = 0
    while v < doomed.length() {
      let id = self.node(doomed.get(v)).id
      run virtual.clear(&mut self, id)
      anchoring.clear(&mut self, id)
      v = v + 1
    }
    let css = self.node(slot).css
    run Effect.catchAll(self.layout.destroy(NodeId { index: css }), layoutFailed)

    // A node moved here from another root can still be that root's focus.
    let parked = self.parked.asMutSlice()
    let mut p: usize = 0
    while p < parked.length {
      if parked[p].focused != NONE && contains(&doomed, parked[p].focused) {
        parked[p].focused = NONE
        parked[p].touched = true
      }
      p = p + 1
    }
    let mut i: usize = 0
    while i < doomed.length() {
      let gone = doomed.get(i)
      let node = self.nodeMut(gone)
      node.live = false
      node.base.clear()
      node.hover.clear()
      node.active.clear()
      node.focus.clear()
      node.focusVisible.clear()
      node.canvas.clear()
      node.text.clear()
      node.label.clear()
      node.testId.clear()
      let id = node.id
      let nodeCss = node.css
      let inner = node.inner
      drop self.ids.remove(Word { value: u32.toU64(id) })
      if self.overrides.length() != 0 {
        // The id may name another node later: its overrides go with this one.
        self.dropOverrides(id)
      }
      self.slotOfCss.set(nodeCss, NONE)
      if inner != NO_INDEX {
        self.slotOfCss.set(inner, NONE)
      }
      run self.free.append(gone)
      i = i + 1
    }
  }

  // Roots.

  /// The index of open root `root` in `parked`, or `usize.MAX`.
  fn parkedIndex(self: &Self, root: u32) -> usize {
    let parked = self.parked.asSlice()
    let mut i: usize = 0
    while i < parked.length {
      if parked[i].id == root {
        return i
      }
      i = i + 1
    }
    return usize.MAX
  }

  /// Whether root `root` is open.
  pub fn rootOpen(self: &Self, root: u32) -> bool {
    if root == self.current {
      return self.currentOpen
    }
    return self.parkedIndex(root) != usize.MAX
  }

  /// The ids of the open roots: the current one first, then the others in the order they
  /// were parked.
  pub effect fn openRoots(self: &Self, out: &mut List<u32>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    out.clear()
    if self.currentOpen {
      run out.append(self.current)
    }
    let parked = self.parked.asSlice()
    let mut i: usize = 0
    while i < parked.length {
      run out.append(parked[i].id)
      i = i + 1
    }
  }

  /// The id of the root node of root `root`, or NONE when it is not open or has none.
  pub fn rootNode(self: &Self, root: u32) -> u32 {
    let mut slot = NONE
    if root == self.current {
      slot = self.root
    } else {
      let at = self.parkedIndex(root)
      if at != usize.MAX {
        slot = self.parked.asSlice()[at].root
      }
    }
    if slot == NONE {
      return NONE
    }
    return self.node(slot).id
  }

  /// The viewport of root `root`'s last frame, in CSS pixels; empty for a root that is not
  /// open.
  pub fn rootViewport(self: &Self, root: u32) -> Rect<f32> {
    if root == self.current {
      return Rect<f32>.new(0.0, 0.0, self.input.width, self.input.height)
    }
    let at = self.parkedIndex(root)
    if at == usize.MAX {
      return Rect<f32>.new(0.0, 0.0, 0.0, 0.0)
    }
    let input = self.parked.asSlice()[at].input
    return Rect<f32>.new(0.0, 0.0, input.width, input.height)
  }

  /// The options root `root` was opened or last updated with, or None when it is not open.
  pub fn rootOptions(self: &Self, root: u32) -> Option<&RootOptions> {
    if root == self.current {
      if self.currentOpen {
        return Option<&RootOptions>.some(&self.currentOptions)
      }
      return Option<&RootOptions>.None
    }
    let at = self.parkedIndex(root)
    if at == usize.MAX {
      return Option<&RootOptions>.None
    }
    return Option<&RootOptions>.some(&self.parked.asSlice()[at].options)
  }

  /// The id of the open root `slot` is in, or NONE for a node in none.
  pub fn rootHolding(self: &Self, slot: u32) -> u32 {
    return self.rootOfTop(self.topOf(slot))
  }

  /// The id of the open root whose node is `top`, or NONE.
  fn rootOfTop(self: &Self, top: u32) -> u32 {
    if top == self.root && self.currentOpen {
      return self.current
    }
    let parked = self.parked.asSlice()
    let mut i: usize = 0
    while i < parked.length {
      if parked[i].root == top {
        return parked[i].id
      }
      i = i + 1
    }
    return NONE
  }

  /// How often what root `root` publishes changed: its nodes, their text, styles, focus or
  /// geometry. A change to one root leaves the others' revisions alone, so a client that
  /// watches some roots is not woken by the rest. 0 for a root that is not open.
  pub fn revisionOf(self: &Self, root: u32) -> u64 {
    if root == self.current {
      return self.revision
    }
    let at = self.parkedIndex(root)
    if at == usize.MAX {
      return 0
    }
    return self.parked.asSlice()[at].revision
  }

  /// Counts a change to root `root` in its revision.
  fn changedRoot(self: &mut Self, root: u32) -> () {
    if root == self.current {
      self.revision = self.revision + 1
      return ()
    }
    let at = self.parkedIndex(root)
    if at != usize.MAX {
      let parked = self.parked.asMutSlice()
      parked[at].revision = parked[at].revision + 1
    }
  }

  /// Counts a change to every root in their revisions.
  fn changedEveryRoot(self: &mut Self) -> () {
    self.revision = self.revision + 1
    let parked = self.parked.asMutSlice()
    let mut i: usize = 0
    while i < parked.length {
      parked[i].revision = parked[i].revision + 1
      i = i + 1
    }
  }

  /// Says that something reached open root `root`'s nodes from outside it, so its next frame
  /// styles and lays out again (see `RootState.touched`).
  fn touchRoot(self: &mut Self, root: u32) -> () {
    self.changedRoot(root)
    if root == self.current {
      self.stylesDirty = true
      self.applied = true
      return ()
    }
    let at = self.parkedIndex(root)
    if at != usize.MAX {
      let parked = self.parked.asMutSlice()
      parked[at].touched = true
    }
  }

  /// `needsFrame` for root `root`, current or not: whether its next frame would draw something
  /// new. A host with a window per root frames only the roots that answer yes. False for a
  /// root that is not open.
  pub fn needsFrameOf(self: &Self, root: u32) -> bool {
    if root == self.current {
      return self.currentOpen && self.needsFrame()
    }
    let at = self.parkedIndex(root)
    if at == usize.MAX {
      return false
    }
    let s = &self.parked.asSlice()[at]
    return s.touched || s.applied || s.stylesDirty || s.paintDirty || s.scrolled
      || s.reveal.length() != 0
      || !s.replayable
      || s.laidOutRevision == usize.MAX
      || s.laidOutScrolls == usize.MAX
  }

  /// The slot at the top of `slot`'s ancestors: a root node, or the top of a detached subtree.
  fn topOf(self: &Self, slot: u32) -> u32 {
    let mut at = slot
    while self.node(at).parent != NONE {
      at = self.node(at).parent
    }
    return at
  }

  /// Whether `slot` is the root node of an open root.
  pub fn isRootNode(self: &Self, slot: u32) -> bool {
    if slot == self.root {
      return true
    }
    let parked = self.parked.asSlice()
    let mut i: usize = 0
    while i < parked.length {
      if parked[i].root == slot {
        return true
      }
      i = i + 1
    }
    return false
  }

  /// Whether `slot` is in a root other than the current one. The current root's layout says
  /// nothing about such a node, so per-frame work leaves it alone.
  pub fn inParkedRoot(self: &Self, slot: u32) -> bool {
    if self.parked.length() == 0 {
      return false
    }
    let top = self.topOf(slot)
    let parked = self.parked.asSlice()
    let mut i: usize = 0
    while i < parked.length {
      if parked[i].root == top {
        return true
      }
      i = i + 1
    }
    return false
  }

  /// The root key input goes to: `keyRoot` while it is open, else the current root.
  pub fn keyTarget(self: &Self) -> u32 {
    if self.rootOpen(self.keyRoot) {
      return self.keyRoot
    }
    return self.current
  }

  /// Moves the per-root state out of the tree, leaving that of a root never framed.
  fn park(self: &mut Self) -> RootState {
    return RootState {
      id: self.current,
      options: Intrinsic.replace(self.currentOptions, RootOptions.default()),
      root: Intrinsic.replace(self.root, NONE),
      focused: Intrinsic.replace(self.focused, NONE),
      focusVisible: Intrinsic.replace(self.focusVisible, false),
      input: Intrinsic.replace(
        self.input,
        FrameInput { width: 0.0, height: 0.0, scale: 1.0, time: 0.0 },
      ),
      stats: Intrinsic.replace(self.stats, FrameStats.zero()),
      revision: Intrinsic.replace(self.revision, 0),
      laidOut: Intrinsic.replace(
        self.laidOut,
        FrameInput { width: -1.0, height: -1.0, scale: 0.0, time: 0.0 },
      ),
      laidOutRevision: Intrinsic.replace(self.laidOutRevision, usize.MAX),
      laidOutScrolls: Intrinsic.replace(self.laidOutScrolls, usize.MAX),
      replayable: Intrinsic.replace(self.replayable, false),
      stylesDirty: Intrinsic.replace(self.stylesDirty, true) || Intrinsic.replace(self.stylesPending, false),
      applied: Intrinsic.replace(self.applied, true),
      paintDirty: Intrinsic.replace(self.paintDirty, false),
      paintCachesStale: Intrinsic.replace(self.paintCachesStale, true),
      layoutObserversDirty: Intrinsic.replace(self.layoutObserversDirty, true),
      facesDirty: Intrinsic.replace(self.facesDirty, true),
      paintedAt: Intrinsic.replace(self.paintedAt, 0),
      touched: false,
      output: Intrinsic.replace(self.output, LayoutTree.make()),
      sceneA: Intrinsic.replace(self.sceneA, Scene.make()),
      sceneB: Intrinsic.replace(self.sceneB, Scene.make()),
      flipped: Intrinsic.replace(self.flipped, false),
      paintOrder: Intrinsic.replace(self.paintOrder, List<u32>.make()),
      fragmentHashes: Intrinsic.replace(self.fragmentHashes, List<u64>.make()),
      fragmentInk: Intrinsic.replace(self.fragmentInk, List<Rect<f32>>.make()),
      fragmentScrollers: Intrinsic.replace(self.fragmentScrollers, List<bool>.make()),
      fragmentOf: Intrinsic.replace(self.fragmentOf, List<usize>.make()),
      nextSourceFragment: Intrinsic.replace(self.nextSourceFragment, List<usize>.make()),
      paintIndexOf: Intrinsic.replace(self.paintIndexOf, List<u32>.make()),
      scrolled: Intrinsic.replace(self.scrolled, false),
      hoverChain: Intrinsic.replace(self.hoverChain, List<u64>.make()),
      pressChain: Intrinsic.replace(self.pressChain, List<u64>.make()),
      capture: Intrinsic.replace(self.capture, NONE),
      captureId: Intrinsic.replace(self.captureId, NONE),
      captureMode: Intrinsic.replace(self.captureMode, 0),
      captureTo: Intrinsic.replace(self.captureTo, NONE),
      captureToId: Intrinsic.replace(self.captureToId, NONE),
      suppressText: Intrinsic.replace(self.suppressText, false),
      pendingTarget: Intrinsic.replace(self.pendingTarget, NONE),
      pendingTargetId: Intrinsic.replace(self.pendingTargetId, NONE),
      pressCount: Intrinsic.replace(self.pressCount, 0),
      thumbSlot: Intrinsic.replace(self.thumbSlot, NONE),
      thumbVertical: Intrinsic.replace(self.thumbVertical, true),
      thumbStart: Intrinsic.replace(self.thumbStart, 0.0),
      thumbOffset: Intrinsic.replace(self.thumbOffset, 0.0),
      pointerX: Intrinsic.replace(self.pointerX, 0.0),
      pointerY: Intrinsic.replace(self.pointerY, 0.0),
      pointerInside: Intrinsic.replace(self.pointerInside, false),
      reveal: Intrinsic.replace(self.reveal, List<u64>.make()),
    }
  }

  /// Makes `state` the current root's, with what its last layout and paint left behind.
  fn unpark(self: &mut Self, state: RootState) -> () {
    let mut s = move state
    self.current = s.id
    self.currentOpen = true
    self.currentOptions = Intrinsic.replace(s.options, RootOptions.default())
    self.root = s.root
    self.focused = s.focused
    self.focusVisible = s.focusVisible
    self.input = s.input
    self.stats = s.stats
    self.revision = s.revision
    self.laidOut = s.laidOut
    self.laidOutRevision = s.laidOutRevision
    self.laidOutScrolls = s.laidOutScrolls
    self.replayable = s.replayable
    self.stylesDirty = s.stylesDirty
    self.applied = s.applied
    self.paintDirty = s.paintDirty
    self.paintCachesStale = s.paintCachesStale
    self.layoutObserversDirty = s.layoutObserversDirty
    self.facesDirty = s.facesDirty
    self.paintedAt = s.paintedAt
    self.output = Intrinsic.replace(s.output, LayoutTree.make())
    self.sceneA = Intrinsic.replace(s.sceneA, Scene.make())
    self.sceneB = Intrinsic.replace(s.sceneB, Scene.make())
    self.flipped = s.flipped
    self.paintOrder = Intrinsic.replace(s.paintOrder, List<u32>.make())
    self.fragmentHashes = Intrinsic.replace(s.fragmentHashes, List<u64>.make())
    self.fragmentInk = Intrinsic.replace(s.fragmentInk, List<Rect<f32>>.make())
    self.fragmentScrollers = Intrinsic.replace(s.fragmentScrollers, List<bool>.make())
    self.fragmentOf = Intrinsic.replace(s.fragmentOf, List<usize>.make())
    self.nextSourceFragment = Intrinsic.replace(s.nextSourceFragment, List<usize>.make())
    self.paintIndexOf = Intrinsic.replace(s.paintIndexOf, List<u32>.make())
    self.scrolled = s.scrolled
    self.hoverChain = Intrinsic.replace(s.hoverChain, List<u64>.make())
    self.pressChain = Intrinsic.replace(s.pressChain, List<u64>.make())
    self.capture = s.capture
    self.captureId = s.captureId
    self.captureMode = s.captureMode
    self.captureTo = s.captureTo
    self.captureToId = s.captureToId
    self.suppressText = s.suppressText
    self.pendingTarget = s.pendingTarget
    self.pendingTargetId = s.pendingTargetId
    self.pressCount = s.pressCount
    self.thumbSlot = s.thumbSlot
    self.thumbVertical = s.thumbVertical
    self.thumbStart = s.thumbStart
    self.thumbOffset = s.thumbOffset
    self.pointerX = s.pointerX
    self.pointerY = s.pointerY
    self.pointerInside = s.pointerInside
    self.reveal = Intrinsic.replace(s.reveal, List<u64>.make())
    if s.touched {
      self.stylesDirty = true
      self.applied = true
      self.layoutObserversDirty = true
      self.laidOutRevision = usize.MAX
    }
    drop s
  }

  /// Forgets what the last layout and paint left behind, for state that belongs to another
  /// root now.
  fn restart(self: &mut Self) -> () {
    self.laidOut = FrameInput { width: -1.0, height: -1.0, scale: 0.0, time: 0.0 }
    self.laidOutRevision = usize.MAX
    self.laidOutScrolls = usize.MAX
    self.replayable = false
    self.paintCachesStale = true
    self.stylesDirty = true
    self.layoutObserversDirty = true
  }

  /// Puts the current root's node in css-layout's viewport, or takes it out.
  effect fn mountCurrent(self: &mut Self, mounted: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.root == NONE {
      return ()
    }
    let css = NodeId { index: self.node(self.root).css }
    if mounted {
      let viewport = self.layout.root()
      run Effect.catchAll(
        self.layout.insertBefore(viewport, css, Option<NodeId>.None),
        ignoreInvalid,
      )
    } else {
      run Effect.catchAll(self.layout.remove(css), ignoreInvalid)
    }
  }

  /// Makes open root `root` the current one: the one `frame`, `scene`, hit testing, the
  /// geometry queries and pointer input are about. Returns whether `root` is open.
  pub effect fn useRoot(self: &mut Self, root: u32) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    if root == self.current {
      return self.currentOpen
    }
    let at = self.parkedIndex(root)
    if at == usize.MAX {
      return false
    }

    // A change to the leaving root that its layout has not seen yet must not be caught up
    // with below when it comes back.
    if self.layout.revision() != self.laidOutRevision {
      self.laidOutRevision = usize.MAX
    }
    if self.layout.scrollRevision() != self.laidOutScrolls {
      self.laidOutScrolls = usize.MAX
    }
    run self.mountCurrent(false)
    let next = self.parked.remove(at)
    let untouched = !next.touched
    let previous = self.park()
    if self.currentOpen {
      run self.parked.append(move previous)
    } else {
      drop previous
    }
    self.unpark(move next)
    run self.mountCurrent(true)

    // Moving root nodes in and out of css-layout's viewport, and the other roots' changes,
    // moved css-layout's revisions but not this root's nodes: its last layout stands.
    if untouched && self.laidOutRevision != usize.MAX && self.laidOutScrolls != usize.MAX {
      self.laidOutRevision = self.layout.revision()
      self.laidOutScrolls = self.layout.scrollRevision()
    }
    return true
  }

  /// Makes the root that holds `slot` current, when that is another open root.
  effect fn useRootOf(self: &mut Self, slot: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.parked.length() == 0 {
      return ()
    }
    let holder = self.rootOfTop(self.topOf(slot))
    if holder != NONE {
      drop run self.useRoot(holder)
    }
  }

  effect fn openRoot(
    self: &mut Self,
    index: usize,
    root: u32,
    slot: u32,
    options: RootOptions,
  ) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if root != self.current && self.parkedIndex(root) != usize.MAX {
      drop run self.useRoot(root)
    }
    if root == self.current {
      run self.setRootNode(index, slot)
      self.currentOpen = true
      self.currentOptions = move options
      return ()
    }
    let mut open = usize.toU32(self.parked.length())
    if self.currentOpen {
      open = open + 1
    }
    if root != FIRST_ROOT && !self.rootSupport.admits(open) {
      run self.reportRoot(root, RootEventKind.Failed)
      return ()
    }
    if !self.currentOpen {
      // No open root owns the current state: the new root starts from a fresh one.
      drop self.park()
      self.restart()
      self.current = root
      run self.setRootNode(index, slot)
      self.currentOpen = true
      self.currentOptions = move options
      return ()
    }

    // Another root is current: the new one waits for its first frame.
    if self.isRootNode(slot) {
      fail TreeError.BadMove { index: index, id: self.node(slot).id }
    }
    if self.node(slot).kind == NodeKind.Text {
      fail TreeError.WrongKind { index: index, id: self.node(slot).id }
    }
    if self.node(slot).parent != NONE {
      run self.detach(index, slot)
    }
    run self.parked.append(RootState.fresh(root, move options, slot))
  }

  effect fn closeRoot(self: &mut Self, index: usize, root: u32) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if !(run self.useRoot(root)) {
      return ()
    }
    let node = self.root
    if node != NONE {
      run self.detach(index, node)
    }
    self.currentOpen = false
    self.currentOptions = RootOptions.default()
    if self.parked.length() != 0 {
      let next = if self.parkedIndex(self.keyRoot) != usize.MAX {
        self.keyRoot
      } else {
        self.parked.asSlice()[0].id
      }
      drop run self.useRoot(next)
    }
    if self.keyRoot == root {
      self.keyRoot = self.current
    }
  }

  /// Frames root `root` (see `frame`), making it current. Nothing happens for a root that is
  /// not open, unless it is current already.
  pub effect fn frameRoot(self: &mut Self, root: u32, input: FrameInput) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if !(run self.useRoot(root)) && root != self.current {
      return ()
    }
    run self.frame(input)
  }

  /// `dispatch` with pointer input aimed at root `root`. Key and text input go to `keyRoot`
  /// either way.
  pub effect fn dispatchTo(self: &mut Self, root: u32, input: Input) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !keyboardInput(&input) {
      drop run self.useRoot(root)
    }
    run self.dispatch(move input)
  }

  /// `begin` with pointer input aimed at root `root`.
  pub effect fn beginAt(self: &mut Self, root: u32, input: &Input) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !keyboardInput(input) {
      drop run self.useRoot(root)
    }
    run self.begin(input)
  }

  /// A host tells the tree what the system did with root `root`, and the client hears it as
  /// a root event. `Focused` also makes the root `keyRoot`. A root event that waits is
  /// replaced by a later one of the same kind for the same root (see `RootEvent.replacedBy`),
  /// so the queue stays short when nobody drains it.
  pub effect fn reportRoot(self: &mut Self, root: u32, kind: RootEventKind) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    match kind {
      RootEventKind.Focused => {
        self.keyRoot = root
      }
      _ => {}
    }
    let event = RootEvent { root: root, kind: kind }
    let mut i: usize = 0
    while i < self.rootEvents.length() {
      let waiting = self.rootEvents.get(i)
      if waiting.replacedBy(&event) {
        drop self.rootEvents.remove(i)
      } else {
        i = i + 1
      }
    }
    run self.rootEvents.append(event)
  }

  /// Moves the queued root events to `out`, oldest first, but those of roots set aside.
  pub effect fn takeRootEvents(self: &mut Self, out: &mut List<RootEvent>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.aside.length() == 0 {
      run out.appendSlice(self.rootEvents.asSlice())
      self.rootEvents.clear()
      return ()
    }
    let mut i: usize = 0
    while i < self.rootEvents.length() {
      if self.isAside(self.rootEvents.get(i).root) {
        i = i + 1
      } else {
        run out.append(self.rootEvents.remove(i))
      }
    }
  }

  /// Moves the queued root events of root `root` to `out`, oldest first.
  pub effect fn takeRootEventsOf(self: &mut Self, root: u32, out: &mut List<RootEvent>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut i: usize = 0
    while i < self.rootEvents.length() {
      if self.rootEvents.get(i).root == root {
        run out.append(self.rootEvents.remove(i))
      } else {
        i = i + 1
      }
    }
  }

  /// Sets root `root` aside for a second client that shares the tree, or gives it back: the
  /// records whose path starts at its node and its root events wait for `takeEventsOf` and
  /// `takeRootEventsOf`, and `takeEvents` and `takeRootEvents` leave them. The client that
  /// owns the rest of the tree then never hears of it. The root need not be open yet.
  pub effect fn setAside(self: &mut Self, root: u32, aside: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut i: usize = 0
    while i < self.aside.length() {
      if self.aside.get(i) == root {
        drop self.aside.remove(i)
      } else {
        i = i + 1
      }
    }
    if aside {
      run self.aside.append(root)
    }
  }

  /// Whether root `root` is set aside (see `setAside`).
  pub fn isAside(self: &Self, root: u32) -> bool {
    let list = self.aside.asSlice()
    let mut i: usize = 0
    while i < list.length {
      if list[i] == root {
        return true
      }
      i = i + 1
    }
    return false
  }

  /// Whether a record whose path starts at node `first` belongs to a root set aside.
  fn asideRecord(self: &Self, first: u32) -> bool {
    let list = self.aside.asSlice()
    let mut i: usize = 0
    while i < list.length {
      let node = self.rootNode(list[i])
      if node != NONE && node == first {
        return true
      }
      i = i + 1
    }
    return false
  }

  /// The scene of root `root`'s last frame, current or not, finished and ready to draw. A host
  /// that draws several roots on one surface composes them from these. Empty for a root that
  /// is not open.
  pub fn sceneOf(self: &Self, root: u32) -> &Scene {
    if root == self.current {
      return self.scene()
    }
    let at = self.parkedIndex(root)
    if at == usize.MAX {
      return &self.empty
    }
    let state = &self.parked.asSlice()[at]
    if state.flipped {
      return &state.sceneB
    }
    return &state.sceneA
  }

  /// Makes `slot` the current root's node. The previous one is detached.
  effect fn setRootNode(self: &mut Self, index: usize, slot: u32) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if slot == self.root {
      return ()
    }
    if self.parked.length() != 0 && self.isRootNode(slot) {
      fail TreeError.BadMove { index: index, id: self.node(slot).id }
    }
    let previous = self.root
    if previous != NONE {
      run self.detach(index, previous)
    }
    if self.node(slot).parent != NONE {
      run self.detach(index, slot)
    }
    if self.node(slot).kind == NodeKind.Text {
      fail TreeError.WrongKind { index: index, id: self.node(slot).id }
    }
    let css = self.node(slot).css
    let viewport = self.layout.root()
    run Effect.catchAll(
      self.layout.insertBefore(viewport, NodeId { index: css }, Option<NodeId>.None),
      layoutFailed,
    )
    self.root = slot
    self.stylesDirty = true
  }

  effect fn setText(self: &mut Self, index: usize, slot: u32, value: String) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let kind = self.node(slot).kind
    let mut target: usize = 0
    if kind == NodeKind.Text {
      target = self.node(slot).css
    } else if kind == NodeKind.Input {
      run edit.setValue(&mut self, slot, move value)
      return ()
    } else {
      fail TreeError.WrongKind { index: index, id: self.node(slot).id }
    }
    let copy = run String.copy(String.view(&value))
    run Effect.catchAll(self.layout.setText(NodeId { index: target }, move copy), layoutFailed)
    let node = self.nodeMut(slot)
    node.text = move value
    node.content = node.content + 1
  }

  /// Moves focus to `slot` (NONE blurs), queueing focus and blur records for listeners.
  pub effect fn focusSlot(self: &mut Self, slot: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if slot == self.focused {
      return ()
    }
    self.semanticRevision = self.semanticRevision + 1
    self.revision = self.revision + 1
    let previous = self.focused
    self.focused = slot
    run edit.focusChanged(&mut self, previous, slot)
    if previous != NONE && self.node(previous).live
      && u32.bitAnd(self.node(previous).listeners, LISTEN_BLUR) != 0 {
      run self.queue(EventKind.Blur, previous)
    }
    if slot != NONE && u32.bitAnd(self.node(slot).listeners, LISTEN_FOCUS) != 0 {
      run self.queue(EventKind.Focus, slot)
    }
    // Focus variants apply to the focused node alone.
    if previous != NONE && self.node(previous).live {
      self.restyle(previous)
    }
    if slot != NONE {
      self.restyle(slot)
    }
  }

  /// The node ids from the root down to `slot`.
  pub effect fn pathTo(self: &Self, slot: u32, out: &mut List<u32>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    out.clear()
    let mut at = slot
    while at != NONE {
      run out.append(self.node(at).id)
      at = self.node(at).parent
    }
    let values = out.asMutSlice()
    let mut i: usize = 0
    let mut j = values.length
    while i + 1 < j {
      j = j - 1
      let swap = values[i]
      values[i] = values[j]
      values[j] = swap
      i = i + 1
    }
  }

  effect fn queue(self: &mut Self, kind: EventKind, slot: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut path = List<u32>.make()
    run self.pathTo(slot, &mut path)
    let target = self.node(slot).id
    run self.events.append(Event.make(kind, target, move path))
  }

  /// Queues `event` for the client.
  pub effect fn queueEvent(self: &mut Self, event: Event) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.events.append(move event)
  }

  /// Feeds one input record to the tree: hit testing against the last frame, hover and active
  /// states, pointer capture, focus, tab order, keyboard clicks and scrolling, and the event
  /// records for listeners. State changes show at the next frame. Pointer input goes to the
  /// current root, key and text input to `keyRoot` (see `dispatchTo`).
  pub effect fn dispatch(self: &mut Self, input: Input) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if keyboardInput(&input) {
      let keyed = self.keyTarget()
      drop run self.useRoot(keyed)
    }
    let interruptsScroll = match &input {
      Input.Wheel { .. } => true
      Input.PointerDown { .. } => true
      Input.KeyDown { .. } => true
      _ => false
    }
    if interruptsScroll {
      self.viewScrollState.interruptAll()
      self.viewScrollAnimations.clear()
    }
    run interact.begin(&mut self, &input)
    run interact.finish(&mut self, move input, false)
  }

  /// The first half of `dispatch`: hit testing, hover, and the record of the input itself
  /// (pointer down, wheel, key down and so on), with no default action taken yet. Follow it
  /// with `finish` for the same input.
  pub effect fn begin(self: &mut Self, input: &Input) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if keyboardInput(input) {
      let keyed = self.keyTarget()
      drop run self.useRoot(keyed)
    }
    self.pendingRoot = self.current
    let interruptsScroll = match &input.* {
      Input.Wheel { .. } => true
      Input.PointerDown { .. } => true
      Input.KeyDown { .. } => true
      _ => false
    }
    if interruptsScroll {
      self.viewScrollState.interruptAll()
      self.viewScrollAnimations.clear()
    }
    run interact.begin(&mut self, input)
  }

  /// The second half of `dispatch`: the default action of `input` (focus, scrolling, Tab,
  /// keyboard clicks, editing) unless `prevented`, and the records that follow from it.
  pub effect fn finish(self: &mut Self, input: Input, prevented: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let started = self.pendingRoot
    drop run self.useRoot(started)
    run interact.finish(&mut self, move input, prevented)
  }

  /// The id of the node a pointer at (`x`, `y`) would target in the last frame, or NONE.
  pub fn hitTest(self: &Self, x: f32, y: f32) -> u32 {
    let slot = interact.hitSlot(self, x, y)
    if slot == NONE {
      return NONE
    }
    return self.node(slot).id
  }

  /// The cursor for the hovered node: the nearest cursor attribute other than `Default` on
  /// its path.
  pub fn cursor(self: &Self) -> Cursor {
    return interact.cursorOf(self)
  }

  /// The scroll offset of node `id`, (0, 0) when it does not scroll or does not exist.
  /// Node `id` was scrolled to (`x`, `y`) outside the tree, as a compositor scrolls the last
  /// frame without the tree: the tree takes the offset and tells scroll listeners, as a wheel
  /// scroll does. The node's root becomes current.
  pub effect fn scrolledElsewhere(self: &mut Self, id: u32, x: f32, y: f32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let slot = self.slotOf(id)
    if slot == NONE {
      return ()
    }
    run self.useRootOf(slot)
    self.viewScrollState.interruptTarget(
      ViewTarget { kind: ViewTargetKind.Element, id: u32.toUsize(id) },
    )
    run interact.scrolledElsewhere(&mut self, slot, x, y)
  }

  pub fn scrollOffset(self: &Self, id: u32) -> Vector2<f32> {
    let slot = self.slotOf(id)
    if slot == NONE {
      return Vector2<f32> { x: 0.0, y: 0.0 }
    }
    return Vector2<f32> { x: self.node(slot).scrollX, y: self.node(slot).scrollY }
  }

  /// Moves the queued host requests (clipboard reads and writes, font faces to load) to `out`,
  /// oldest first.
  pub effect fn takeRequests(self: &mut Self, out: &mut List<HostRequest>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.requestFontFaces()
    let mut reversed = List<HostRequest>.make()
    while true {
      match self.requests.pop() {
        Option<HostRequest>.Some { value } => {
          run reversed.append(move value)
        }
        Option<HostRequest>.None => {
          break
        }
      }
    }
    while true {
      match reversed.pop() {
        Option<HostRequest>.Some { value } => {
          run out.append(move value)
        }
        Option<HostRequest>.None => {
          break
        }
      }
    }
  }

  /// What the platform input method needs after the last frame: whether a text field has
  /// focus, and the caret rectangle in CSS pixels to place the candidate window by.
  pub effect fn imeArea(self: &Self) -> ImeArea
    ! OutOfMemoryError
    ? &mut Allocator {
    return run edit.imeArea(self)
  }

  /// The time the focused caret blinks next, or -1 when no caret shows. Hosts that draw only
  /// on demand ask for a frame at that time.
  pub fn nextBlink(self: &Self) -> f64 {
    return edit.nextBlink(self)
  }

  /// The selection of input `id` as (anchor, focus) UTF-8 byte offsets into its value, or
  /// (0, 0) when it is not an input.
  pub fn selection(self: &Self, id: u32) -> Vector2<usize> {
    let slot = self.slotOf(id)
    if slot == NONE {
      return Vector2<usize> { x: 0, y: 0 }
    }
    if !self.node(slot).hasEdit() {
      return Vector2<usize> { x: 0, y: 0 }
    }
    let e = self.node(slot).edit()
    return Vector2<usize> { x: e.anchor, y: e.focus }
  }

  /// The caret rectangle of input `id` in CSS pixels of the viewport, from the last layout.
  pub effect fn caretRect(self: &Self, id: u32) -> Rect<f32>
    ! OutOfMemoryError
    ? &mut Allocator {
    let slot = self.slotOf(id)
    if slot == NONE || self.node(slot).kind != NodeKind.Input {
      return Rect<f32>.new(0.0, 0.0, 0.0, 0.0)
    }
    return run edit.caretRectOf(self, slot)
  }

  /// Moves the queued event records to `out`, oldest first, but those of roots set aside.
  pub effect fn takeEvents(self: &mut Self, out: &mut List<Event>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.aside.length() != 0 {
      run self.takeWhere(NONE, &mut out)
      return ()
    }
    let mut reversed = List<Event>.make()
    while true {
      match self.events.pop() {
        Option<Event>.Some { value } => {
          run reversed.append(move value)
        }
        Option<Event>.None => {
          break
        }
      }
    }
    while true {
      match reversed.pop() {
        Option<Event>.Some { value } => {
          run out.append(move value)
        }
        Option<Event>.None => {
          break
        }
      }
    }
  }

  /// Moves the queued records whose path starts at root `root`'s node to `out`, oldest first:
  /// what a client that owns a root set aside takes (see `setAside`).
  pub effect fn takeEventsOf(self: &mut Self, root: u32, out: &mut List<Event>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.rootNode(root) == NONE {
      return ()
    }
    run self.takeWhere(root, &mut out)
  }

  /// Moves the records of root `root` to `out`, or with NONE, every record of no root set aside.
  effect fn takeWhere(self: &mut Self, root: u32, out: &mut List<Event>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let node = if root == NONE {
      NONE
    } else {
      self.rootNode(root)
    }
    let mut kept = List<Event>.make()
    let mut reversed = List<Event>.make()
    while true {
      match self.events.pop() {
        Option<Event>.Some { value } => {
          run reversed.append(move value)
        }
        Option<Event>.None => {
          break
        }
      }
    }
    while true {
      match reversed.pop() {
        Option<Event>.Some { value } => {
          let first = if value.path.length() == 0 {
            NONE
          } else {
            value.path.get(0)
          }
          let taken = if root == NONE {
            first == NONE || !self.asideRecord(first)
          } else {
            first == node
          }
          if taken {
            run out.append(move value)
          } else {
            run kept.append(move value)
          }
        }
        Option<Event>.None => {
          break
        }
      }
    }
    self.events = move kept
  }

  effect fn refreshSources(self: &mut Self, resource: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut slot: u32 = 0
    while u32.toUsize(slot) < self.nodes.length() {
      let matches = self.node(slot).live && self.node(slot).resource == resource
      if matches {
        let node = self.nodeMut(slot)
        node.content = node.content + 1
        self.paintCachesStale = true
        if self.parked.length() != 0 {
          let holder = self.rootHolding(slot)
          if holder != NONE && holder != self.current {
            self.touchRoot(holder)
          }
        }
        run self.updateNatural(slot)
      }
      slot = slot + 1
    }
  }

  /// Gives css-layout the natural size of an image or icon node.
  effect fn updateNatural(self: &mut Self, slot: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let kind = self.node(slot).kind
    let resource = self.node(slot).resource
    let fontSize = self.node(slot).computed.text.size
    let css = self.node(slot).css
    let mut natural = NaturalDimensions.none()
    if kind == NodeKind.Image {
      if let Option<Resource>.Some { value } = self.resources.get(resource) {
        if let Resource.Image { width, height, .. } = value {
          natural.size = OptionalSize.definite(u32.toF32(width), u32.toF32(height))
          if height != 0 {
            natural.aspectRatio = u32.toF32(width) / u32.toF32(height)
          }
        }
      }
    } else if kind == NodeKind.Icon {
      natural.size = OptionalSize.definite(fontSize, fontSize)
      natural.aspectRatio = 1.0
    } else {
      return ()
    }
    let key = u32.toUsize(slot)
    let changed = key >= self.provider.naturals.length()
      || !sameNatural(self.provider.naturals.get(key), natural)
    if changed {
      run self.provider.setNatural(key, natural)
      run Effect.catchAll(
        self.layout.setNaturalMeasurement(NodeId { index: css }, key),
        ignoreInvalid,
      )
    }
  }

  // Styles.

  /// The font key of a text style, registering it with the text system on first use.
  effect fn fontKeyOf(self: &mut Self, text: TextStyle) -> usize
    ! OutOfMemoryError
    ? &mut Allocator {
    let italic = text.style == FontStyle.Italic
    let entries = self.fontKeys.asSlice()
    let mut i: usize = 0
    while i < entries.length {
      let entry = entries[i]
      if entry.family == text.family && entry.size == text.size && entry.weight == text.weight
        && entry.italic == italic {
        return entry.key
      }
      i = i + 1
    }
    let mut families = List<Family>.make()
    run self.families.copyOf(text.family, &mut families)
    let mut request = FontStyleRequest.make(move families, text.size)
    request.request = Request {
      weight: f32.toF64(text.weight),
      width: 100.0,
      style: if italic {
        FaceStyle.Italic
      } else {
        FaceStyle.Normal
      },
    }
    let key = run self.provider.text.addStyle(move request)
    run self.fontKeys.append(
      FontKeyEntry {
        family: text.family,
        size: text.size,
        weight: text.weight,
        italic: italic,
        key: key,
      },
    )
    return key
  }

  // Font faces added at run time.

  /// Text whose font-family list names `family` lays out again: its styles get new font
  /// keys, so css-layout measures it with the faces the font set has now.
  effect fn fontFamilyChanged(self: &mut Self, family: &[u8]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut changed = false
    let mut names = List<Family>.make()
    let mut i: usize = 0
    while i < self.fontKeys.length() {
      let list = self.fontKeys.get(i).family
      if list != NONE {
        names.clear()
        run self.families.copyOf(list, &mut names)
        let mut j: usize = 0
        while j < names.length() {
          if let Family.Named { name } = &names.asSlice()[j] {
            if sameFamilyName(Bytes.asSlice(&name), family) {
              let entries = self.fontKeys.asMutSlice()
              entries[i].family = NONE
              changed = true
              break
            }
          }
          j = j + 1
        }
      }
      i = i + 1
    }
    if !changed {
      return
    }
    self.stylesDirty = true
    let parked = self.parked.asMutSlice()
    let mut p: usize = 0
    while p < parked.length {
      parked[p].touched = true
      p = p + 1
    }
  }

  /// Adds the faces of a font file (TTF, OTF or a collection) under the family names the file
  /// gives, and returns how many it had. Text in those families lays out again with them.
  pub effect fn addFont(self: &mut Self, data: Bytes) -> usize
    ! OutOfMemoryError
    ? &mut Allocator {
    let set = &mut self.provider.text.fonts.set
    let first = set.declaredCount()
    let added = run set.addFont(move data)
    let mut i = first
    while i < first + added {
      let mut family = Bytes.make()
      run Bytes.append(&mut family, self.provider.text.fonts.set.familyOf(i))
      run self.fontFamilyChanged(Bytes.asSlice(&family))
      i = i + 1
    }
    return added
  }

  fn fontFaceIndex(self: &Self, id: u32) -> usize {
    let entries = self.fontFaces.asSlice()
    let mut i: usize = 0
    while i < entries.length {
      if entries[i].id == id {
        return entries[i].declared
      }
      i = i + 1
    }
    return usize.MAX
  }

  /// Declares font face `id` as an `@font-face` rule does, before its file is there. Its
  /// family hides installed faces of the same name at once. When text laid out needs a
  /// character in its `unicode-range`, `takeRequests` gives `HostRequest.LoadFontFace`; the
  /// text draws with the next family that has the character until `loadFontFace`, then lays
  /// out again with the face (`font-display: swap`). Declaring an id again does nothing.
  pub effect fn declareFontFace(self: &mut Self, id: u32, rule: FaceRule) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.fontFaceIndex(id) != usize.MAX {
      return
    }
    let mut family = Bytes.make()
    run Bytes.append(&mut family, Bytes.asSlice(&rule.family))
    let declared = run self.provider.text.fonts.set.declare(move rule)
    run self.fontFaces.append(FontFaceEntry { id: id, declared: declared })
    run self.fontFamilyChanged(Bytes.asSlice(&family))
  }

  /// Gives declared font face `id` its file, face `index` of a TTF, OTF or collection.
  /// Text in its family lays out again. Returns false when the id is unknown or the data is
  /// no usable font; the face then counts as failed and the fallback stays.
  pub effect fn loadFontFace(self: &mut Self, id: u32, data: Bytes, index: u32) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let declared = self.fontFaceIndex(id)
    if declared == usize.MAX {
      return false
    }
    let ok = run self.provider.text.fonts.set.load(declared, move data, index)
    if ok {
      let mut family = Bytes.make()
      run Bytes.append(&mut family, self.provider.text.fonts.set.familyOf(declared))
      run self.fontFamilyChanged(Bytes.asSlice(&family))
    }
    return ok
  }

  /// Records that font face `id` could not load: its text keeps the fallback.
  pub fn failFontFace(self: &mut Self, id: u32) -> () {
    let declared = self.fontFaceIndex(id)
    if declared != usize.MAX {
      self.provider.text.fonts.set.markFailed(declared)
    }
  }

  /// Moves the font faces text needed in the last layouts to the host requests.
  effect fn requestFontFaces(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.provider.text.fonts.set.hasWanted() {
      return
    }
    let mut wanted = List<usize>.make()
    run self.provider.text.fonts.set.takeWanted(&mut wanted)
    let mut i: usize = 0
    while i < wanted.length() {
      let entries = self.fontFaces.asSlice()
      let mut j: usize = 0
      while j < entries.length {
        if entries[j].declared == wanted.get(i) {
          run self.requests.append(HostRequest.LoadFontFace { face: entries[j].id })
        }
        j = j + 1
      }
      i = i + 1
    }
  }

  /// Recomputes every node's style from its patches, variants and parent.
  effect fn resolveStyles(self: &mut Self) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if !self.stylesDirty && !self.stylesPending {
      return ()
    }
    let full = self.stylesDirty
    self.stylesDirty = false
    self.stylesPending = false
    self.paintCachesStale = true
    if self.root == NONE {
      return ()
    }
    // Each entry is a slot and whether its parent's inherited values changed.
    let mut stack = List<u64>.make()
    run stack.append(u32.toU64(self.root))
    while stack.length() != 0 {
      let last = stack.length() - 1
      let entry = stack.get(last)
      stack.truncate(last)
      let slot = u64.toU32(u64.bitAnd(entry, 0xFFFFFFFF))
      let forced = full || u64.shiftRight(entry, 32) != 0
      let node = self.node(slot)
      let own = forced || node.styleDirty
      let below = node.subtreeDirty
      let mut changed = full
      if own {
        let before = node.computed.text
        let events = node.computed.paint.pointerEvents
        let shadow = node.computed.effects
        run self.resolve(slot)
        let after = &self.node(slot).computed
        changed = full || !sameText(&before, &after.text) || events != after.paint.pointerEvents
          || shadow.shadowFrom != after.effects.shadowFrom
          || shadow.shadowHash != after.effects.shadowHash
      }
      let cleared = self.nodeMut(slot)
      cleared.styleDirty = false
      cleared.subtreeDirty = false
      if changed || below {
        let flag: u64 = if changed { 0x100000000 } else { 0 }
        // Children in reverse, so the first is resolved first.
        let css = self.node(slot).css
        let first = stack.length()
        let layoutNodes = self.layout.nodes.asSlice()
        let mut child = layoutNodes[css].firstChild
        while child != NO_INDEX {
          let found = self.slotOfCssNode(child)
          if found != NONE {
            run stack.append(u64.bitOr(u32.toU64(found), flag))
          }
          child = layoutNodes[child].nextSibling
        }
        let items = stack.asMutSlice()
        let mut a = first
        let mut b = items.length
        while b > a + 1 {
          b = b - 1
          let swap = items[a]
          items[a] = items[b]
          items[b] = swap
          a = a + 1
        }
      }
    }
  }

  effect fn resolve(self: &mut Self, slot: u32) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let parent = self.node(slot).parent
    let mut inherited = TextStyle.initial()
    if parent != NONE {
      inherited = self.node(parent).computed.text
    }
    let node = self.node(slot)
    let mut computed = Computed.inheriting(inherited)

    // CSS pointer-events inherits, but an explicit descendant auto remains targetable.
    if parent != NONE {
      computed.paint.pointerEvents = self.node(parent).computed.paint.pointerEvents
    }
    computed.layout.display = defaultDisplay(node.kind)
    if node.kind == NodeKind.Input {
      // Inputs keep their spaces; one line scrolls sideways, several wrap and scroll down.
      if node.edit().multiline {
        computed.apply(&declare.whiteSpace(WhiteSpace.PreWrap))
        computed.layout.overflowX = Overflow.Hidden
        computed.layout.overflowY = Overflow.Auto
      } else {
        computed.apply(&declare.whiteSpace(WhiteSpace.Pre))
        computed.layout.overflowX = Overflow.Hidden
        computed.layout.overflowY = Overflow.Hidden
      }
    }
    if node.kind != NodeKind.Text && self.overrides.length() == 0 {
      applyAll(&mut computed, &node.base)
      if node.hovered {
        applyAll(&mut computed, &node.hover)
      }
      if node.pressed {
        applyAll(&mut computed, &node.active)
      }
      if self.focused == slot {
        applyAll(&mut computed, &node.focus)
        if self.focusVisible || node.kind == NodeKind.Input {
          applyAll(&mut computed, &node.focusVisible)
        }
      }
    } else if node.kind != NodeKind.Text {
      run self.applyOverridden(&mut computed, node.id, StyleState.Base, &node.base)
      if node.hovered {
        run self.applyOverridden(&mut computed, node.id, StyleState.Hover, &node.hover)
      }
      if node.pressed {
        run self.applyOverridden(&mut computed, node.id, StyleState.Active, &node.active)
      }
      if self.focused == slot {
        run self.applyOverridden(&mut computed, node.id, StyleState.Focus, &node.focus)
        if self.focusVisible || node.kind == NodeKind.Input {
          run self.applyOverridden(
            &mut computed,
            node.id,
            StyleState.FocusVisible,
            &node.focusVisible,
          )
        }
      }
    }
    anchoring.apply(&self, node.id, &mut computed)
    let kind = node.kind
    let css = node.css
    let sizeChanged = node.computed.text.size != computed.text.size
    if parent != NONE {
      let above = self.node(parent).computed.effects
      computed.effects.shadowFrom = above.shadowFrom
      computed.effects.shadowHash = above.shadowHash
    }
    run self.resolveEffects(slot, &mut computed)
    let fontKey = run self.fontKeyOf(computed.text)
    computed.finish(fontKey)
    let paintHash = computed.paintHash(&self.seed)
    let target = self.nodeMut(slot)
    target.computed = computed
    target.fontKey = fontKey
    target.paintHash = paintHash
    if kind != NodeKind.Text {
      // css-layout leaves the node clean when the style is the one it already has.
      run Effect.catchAll(
        self.layout.setStyle(NodeId { index: css }, computed.layout),
        layoutFailed,
      )
    }
    if kind == NodeKind.Icon && sizeChanged {
      run self.updateNatural(slot)
    }
  }

  /// Reads the effect properties of node `slot`'s active looks into its `Effects`, after the
  /// rest of its style is in `computed`, so `em` and `currentColor` see its font and color.
  effect fn resolveEffects(self: &mut Self, slot: u32, computed: &mut Computed) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !computed.effects.declared {
      match &self.node(slot).effects {
        Option<Box<Effects>>.Some { .. } => {
          let target = self.nodeMut(slot)
          target.effects = Option<Box<Effects>>.None
        }
        Option<Box<Effects>>.None => {}
      }
      return ()
    }
    let basis = Basis { fontSize: computed.text.size, color: computed.text.color }
    let mut effects = Effects.make()
    let node = self.node(slot)
    run paint_css.applyAll(&mut effects, node.base.asSlice(), basis)
    if node.hovered {
      run paint_css.applyAll(&mut effects, node.hover.asSlice(), basis)
    }
    if node.pressed {
      run paint_css.applyAll(&mut effects, node.active.asSlice(), basis)
    }
    if self.focused == slot {
      run paint_css.applyAll(&mut effects, node.focus.asSlice(), basis)
      if self.focusVisible || node.kind == NodeKind.Input {
        run paint_css.applyAll(&mut effects, node.focusVisible.asSlice(), basis)
      }
    }
    computed.effects.hash = effects.hash
    if effects.hasShadows {
      if effects.shadows.length() == 0 {
        computed.effects.shadowFrom = NO_SHADOW
        computed.effects.shadowHash = 0
      } else {
        computed.effects.shadowFrom = slot
        computed.effects.shadowHash = effects.hash
      }
    }
    let boxed = run Box<Effects>.make(move effects)
    let target = self.nodeMut(slot)
    target.effects = Option<Box<Effects>>.Some { value: move boxed }
  }

  // Style overrides.

  /// The index of node `id`'s override in `state`, or `usize.MAX`.
  fn overrideIndex(self: &Self, id: u32, state: StyleState) -> usize {
    let list = self.overrides.asSlice()
    let mut i: usize = 0
    while i < list.length {
      if list[i].id == id && list[i].state == state {
        return i
      }
      i = i + 1
    }
    return usize.MAX
  }

  /// Applies `client`, node `id`'s own declarations in `state`, with its override laid over
  /// them as one list, so `em` lengths see the font size either of them sets.
  effect fn applyOverridden(
    self: &Self,
    computed: &mut Computed,
    id: u32,
    state: StyleState,
    client: &List<Declaration>,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let at = self.overrideIndex(id, state)
    if at == usize.MAX {
      applyAll(&mut computed, client)
      return ()
    }
    let laid = &self.overrides.asSlice()[at]
    let mut merged = List<Declaration>.make()
    if !laid.replace {
      let own = client.asSlice()
      let mut i: usize = 0
      while i < own.length {
        run merged.append(run css.cloneDeclaration(&own[i]))
        i = i + 1
      }
    }
    let over = laid.declarations.asSlice()
    let mut j: usize = 0
    while j < over.length {
      run css.set(&mut merged, &over[j])
      j = j + 1
    }
    applyAll(&mut computed, &merged)
  }

  /// Whether node `id` has an override in `state`. Costs nothing while there are none.
  pub fn overridden(self: &Self, id: u32, state: StyleState) -> bool {
    if self.overrides.length() == 0 {
      return false
    }
    return self.overrideIndex(id, state) != usize.MAX
  }

  /// Node `id`'s override in `state`, if it has one.
  pub fn overrideOf(self: &Self, id: u32, state: StyleState) -> Option<&StyleOverride> {
    let at = self.overrideIndex(id, state)
    if at == usize.MAX {
      return Option<&StyleOverride>.None
    }
    return Option<&StyleOverride>.some(&self.overrides.asSlice()[at])
  }

  /// Every override, oldest first.
  pub fn styleOverrides(self: &Self) -> &[StyleOverride] {
    return self.overrides.asSlice()
  }

  /// Lays `declarations` over what the client set for node `id` in `state` (instead of it,
  /// with `replace`), in place of the override the node had there: for a second party that
  /// shares the tree, such as the inspector trying a style. The client's own declarations
  /// are kept underneath and stay its to change (`SetStyle`, `ClearStyle`); the override
  /// applies over whatever they are, until `clearOverride`, and goes when the node is
  /// destroyed. No declarations and no `replace` clears the override. The node's root styles
  /// again at its next frame, as after a mutation of it; no other root does, and no event
  /// record tells the client. Returns false when there is no node `id`.
  pub effect fn setOverride(
    self: &mut Self,
    id: u32,
    state: StyleState,
    declarations: List<Declaration>,
    replace: bool,
  ) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let slot = self.slotOf(id)
    if slot == NONE {
      return false
    }
    let at = self.overrideIndex(id, state)
    if declarations.length() == 0 && !replace {
      if at != usize.MAX {
        drop self.overrides.remove(at)
        self.restyled(slot)
      }
      return true
    }
    let laid = StyleOverride {
      id: id,
      state: state,
      declarations: move declarations,
      replace: replace,
    }
    if at == usize.MAX {
      run self.overrides.append(move laid)
    } else {
      self.overrides.set(at, move laid)
    }
    self.restyled(slot)
    return true
  }

  /// Takes node `id`'s override in `state` away: the node shows what its client set again.
  /// Returns whether it had one.
  pub fn clearOverride(self: &mut Self, id: u32, state: StyleState) -> bool {
    let at = self.overrideIndex(id, state)
    if at == usize.MAX {
      return false
    }
    drop self.overrides.remove(at)
    let slot = self.slotOf(id)
    if slot != NONE {
      self.restyled(slot)
    }
    return true
  }

  /// Takes every override of node `id` away, for a node being destroyed.
  fn dropOverrides(self: &mut Self, id: u32) -> () {
    let mut i: usize = 0
    while i < self.overrides.length() {
      if self.overrides.asSlice()[i].id == id {
        drop self.overrides.remove(i)
      } else {
        i = i + 1
      }
    }
  }

  /// An override of the node at `slot` changed: its root styles again at its next frame and
  /// counts the change in its revision, as a mutation of the node would.
  fn restyled(self: &mut Self, slot: u32) -> () {
    self.semanticRevision = self.semanticRevision + 1
    let holder = self.rootHolding(slot)
    if holder != NONE {
      self.touchRoot(holder)
    } else {
      // A detached node styles when it is attached again.
      self.stylesDirty = true
    }
  }

  // Frames.

  /// Whether a frame would draw something new: styles, layout or scroll offsets changed, or a
  /// scroll into view waits. Hosts that draw only on demand ask after applying batches and
  /// dispatching input.
  pub fn needsFrame(self: &Self) -> bool {
    return self.applied || self.stylesDirty || self.stylesPending || self.paintDirty || self.scrolled
      || cssom_view.scrollAnimating(self)
      || self.layout.revision() != self.laidOutRevision
      || self.layout.scrollRevision() != self.laidOutScrolls
      || self.reveal.length() != 0
      || !self.replayable
  }

  /// The scene of the last frame, finished and ready to draw.
  pub fn scene(self: &Self) -> &Scene {
    if self.flipped {
      return &self.sceneB
    }
    return &self.sceneA
  }

  /// Applies styles, lays out what changed and paints the frame.
  pub effect fn frame(self: &mut Self, input: FrameInput) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    self.frameNumber = self.frameNumber + 1
    if self.applied || self.paintDirty {
      self.paintCachesStale = true
    }
    self.applied = false
    self.input = input
    self.stats = FrameStats.zero()
    self.stats.frame = self.frameNumber
    run self.resolveStyles()
    run virtual.prepare(&mut self)
    run self.layoutFrame()
    run Effect.catch<CssomError>(cssom_view.advanceScrolls(&mut self), viewFailed)
    if run interact.settleScrolls(&mut self) {
      run self.layoutFrame()
      drop run interact.settleScrolls(&mut self)
    }
    if run edit.revealCaret(&mut self) {
      run self.layoutFrame()
    }

    // Scrolling and relayout move content under a still pointer: hover follows, and a hover
    // variant that changes layout is laid out in the same frame.
    if !self.stats.layoutSkipped || self.scrolled {
      run interact.refreshHover(&mut self)
      run self.resolveStyles()
      run self.layoutFrame()
    }
    run self.settleVirtual()
    run self.settleAnchors()
    run self.notifyLayout()
    edit.beginPaint(&mut self)
    self.scrollsStill = !self.scrolled
    run self.paintFrame()
    self.scrolled = false
    self.paintDirty = false
    self.stats.nodes = self.nodeCount()
    self.stats.fragments = self.output.fragments.values.length()
  }

  effect fn settleAnchors(self: &mut Self) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut pass: usize = 0
    while pass <= self.anchors.length() {
      if !(run anchoring.settle(&mut self)) {
        break
      }
      run self.resolveStyles()
      run self.layoutFrame()
      if run interact.settleScrolls(&mut self) {
        run self.layoutFrame()
      }
      run interact.refreshHover(&mut self)
      run self.resolveStyles()
      run self.layoutFrame()
      pass = pass + 1
    }
  }

  effect fn settleVirtual(self: &mut Self) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut pass: usize = 0
    while pass < 4 {
      if !(run virtual.settle(&mut self)) {
        break
      }
      run virtual.prepare(&mut self)
      run self.layoutFrame()
      if run interact.settleScrolls(&mut self) {
        run self.layoutFrame()
      }
      run interact.refreshHover(&mut self)
      run self.resolveStyles()
      run self.layoutFrame()
      pass = pass + 1
    }
  }

  /// Lays out and paints pages or columns supplied by the host. Break policies, widows,
  /// orphans and fixed page-positioned elements use the same styles as continuous frames.
  /// Geometry queries describe this output until the next frame; `frame` resumes continuous
  /// layout. Fragmentainer slices are borrowed only for this call.
  /// Virtual scroll containers require continuous layout; clear them first or this returns `TreeError.Layout`.
  pub effect fn frameFragmented(
    self: &mut Self,
    input: FrameInput,
    frames: Fragmentainers<'_>,
  ) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if self.virtualLists.length() != 0 {
      fail TreeError.Layout
    }
    self.frameNumber = self.frameNumber + 1
    self.applied = false
    self.input = input
    self.stats = FrameStats.zero()
    self.stats.frame = self.frameNumber
    run self.resolveStyles()
    let mut viewport = CssStyle.make()
    let root = self.layout.root()
    run Effect.catchAll(self.layout.setStyle(root, move viewport), layoutFailed)
    run Effect.catchAll(
      computeFragmented(
        &self.layout,
        &mut self.output,
        &mut self.provider,
        OptionalSize.none(),
        move frames,
      ),
      layoutFailed,
    )
    self.output.fragments.resolveLocations()
    self.paintCachesStale = true
    self.semanticRevision = self.semanticRevision + 1
    self.revision = self.revision + 1
    self.laidOutRevision = usize.MAX
    self.stats.layout = self.output.stats
    self.stats.layoutSkipped = false
    run self.indexFragments()
    self.layoutObserversDirty = true
    run self.notifyLayout()
    edit.beginPaint(&mut self)
    self.scrollsStill = false
    run self.paintFrame()
    self.paintDirty = false
    self.stats.nodes = self.nodeCount()
    self.stats.fragments = self.output.fragments.values.length()
  }

  /// The atlas tile for a registered image, for custom scene composition. Allocation and
  /// re-upload after eviction are managed by the resource store and collected by `frame`.
  pub effect fn imageTile(self: &mut Self, resource: u32) -> Option<AtlasTile>
    ! OutOfMemoryError
    ? &mut Allocator {
    return match self.resources.get(resource) {
      Option<Resource>.Some { value: Resource.Image { image, .. } } => run self.resources.imageTile(
        &mut self.atlas,
        image,
      )
      _ => Option<AtlasTile>.None
    }
  }

  /// Whether a mutation or an edit changed styles or layout inputs since the last layout.
  pub fn layoutPending(self: &Self) -> bool {
    return self.stylesDirty || self.stylesPending || self.layout.revision() != self.laidOutRevision
  }

  /// Resolves styles and lays out now, at the last frame's size, so geometry queries between
  /// frames see the current text. The next frame paints as usual.
  pub effect fn layoutNow(self: &mut Self) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.resolveStyles()
    run virtual.prepare(&mut self)
    run self.layoutFrame()
    if run interact.settleScrolls(&mut self) {
      run self.layoutFrame()
    }
    run self.settleVirtual()
    run self.settleAnchors()
  }

  effect fn layoutFrame(self: &mut Self) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if self.layout.revision() == self.laidOutRevision
      && self.layout.scrollRevision() == self.laidOutScrolls
      && self.input.width == self.laidOut.width
      && self.input.height == self.laidOut.height {
      return ()
    }

    // css-layout has one viewport, sized by whichever root was laid out last.
    if self.input.width != self.styledViewport.width
      || self.input.height != self.styledViewport.height {
      let mut viewport = CssStyle.make()
      viewport.width = Dimension.px(self.input.width)
      viewport.height = Dimension.px(self.input.height)
      let viewportId = self.layout.root()
      run Effect.catchAll(self.layout.setStyle(viewportId, move viewport), layoutFailed)
      self.styledViewport = self.input
    }
    let viewport = OptionalSize.definite(self.input.width, self.input.height)
    let moved = self.layout.revision() == self.laidOutRevision
      && self.input.width == self.laidOut.width
      && self.input.height == self.laidOut.height
      && (run Engine.repositionScroll(&self.layout, &mut self.output, viewport))
    if !moved {
      run Effect.catchAll(
        Engine.compute(
          &self.layout,
          &mut self.output,
          &mut self.provider,
          OptionalSize.definite(self.input.width, self.input.height),
        ),
        layoutFailed,
      )
    }
    self.output.fragments.resolveLocations()
    self.paintCachesStale = true
    self.semanticRevision = self.semanticRevision + 1
    self.revision = self.revision + 1
    self.laidOut = self.input
    self.laidOutRevision = self.layout.revision()
    self.laidOutScrolls = self.layout.scrollRevision()
    self.stats.layout = self.output.stats
    self.stats.layoutSkipped = false
    if !moved {
      run self.indexFragments()
    }
    self.layoutObserversDirty = true
  }

  /// Reports changed geometry once after layout, including scrolling and first attachment.
  effect fn notifyLayout(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.layoutObserversDirty {
      return ()
    }
    self.layoutObserversDirty = false
    let mut i: usize = 0
    while i < self.nodes.length() {
      let node = &self.nodes.asSlice()[i]
      if node.live && u32.bitAnd(node.listeners, LISTEN_LAYOUT) != 0
        && !self.inParkedRoot(usize.toU32(i)) {
        let id = node.id
        let before = node.reportedBounds
        let reported = node.layoutReported
        if let Option<inspect.NodeInfo>.Some { value } = run inspect.info(&self.*, id) {
          let bounds = value.bounds
          if !reported || before.xMin != bounds.xMin || before.yMin != bounds.yMin
            || before.xMax != bounds.xMax
            || before.yMax != bounds.yMax {
            let slot = usize.toU32(i)
            let target = self.nodeMut(slot)
            target.layoutReported = true
            target.reportedBounds = bounds
            let mut path = List<u32>.make()
            run self.pathTo(slot, &mut path)
            let mut event = Event.make(EventKind.Layout, id, move path)
            event.bounds = bounds
            run self.queueEvent(move event)
          }
        }
      }
      i = i + 1
    }
  }

  /// Fills `fragmentOf` from the last layout.
  effect fn indexFragments(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.facesDirty = true
    self.fragmentOf.clear()
    run self.fragmentOf.appendRepeated(NO_INDEX, self.layout.nodes.length())
    let values = self.output.fragments.values.asSlice()
    self.nextSourceFragment.clear()
    run self.nextSourceFragment.appendRepeated(NO_INDEX, values.length)
    let mut i = values.length
    while i > 0 {
      i = i - 1
      let source = values[i].source
      if source < self.fragmentOf.length() && !values[i].positioningShell {
        self.nextSourceFragment.set(i, self.fragmentOf.get(source))
        self.fragmentOf.set(source, i)
      }
    }
  }

  /// Loads the raster face of every font key the layout's text fragments use.
  effect fn loadFaces(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.facesDirty {
      return ()
    }
    let count = self.output.fragments.texts.length()
    let mut i: usize = 0
    while i < count {
      let key = self.output.fragments.texts.get(i).fontKey
      while self.faces.length() <= key {
        run self.faces.append(FaceSlot<'a> { loaded: false, face: Option<FontFace<'a>>.None })
      }
      if !self.faces.asSlice()[key].loaded {
        let face = run self.provider.text.rasterFace(key)
        let slots = self.faces.asMutSlice()
        slots[key] = FaceSlot<'a> { loaded: true, face: move face }
      }
      i = i + 1
    }
    self.facesDirty = false
  }

  /// Hashes and bounds every fragment again when layout, styles or mutations changed since they
  /// were last computed. A frame that only scrolled keeps them.
  effect fn refreshPaintCaches(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let count = self.output.fragments.values.length()
    if !self.paintCachesStale && self.fragmentHashes.length() == count
      && self.fragmentInk.length() == count {
      return ()
    }
    run hashFragments(
      &self.seed,
      &self.output,
      &self.slotOfCss,
      &self.layout,
      &self.nodes,
      &mut self.fragmentHashes,
    )
    run inkFragments(
      &self.output,
      &self.slotOfCss,
      &self.layout,
      &self.nodes,
      self.input.width,
      self.input.height,
      &mut self.fragmentInk,
      &mut self.fragmentScrollers,
    )
    self.paintCachesStale = false
  }

  /// Whether the fragment ink describes the last layout, so hit testing can skip by it.
  pub fn inkCurrent(self: &Self) -> bool {
    return !self.paintCachesStale
      && self.fragmentInk.length() == self.output.fragments.values.length()
  }

  /// Where fragment `index` of the last layout draws against where the layout put it, in CSS
  /// pixels: the scroll offsets and sticky offsets above it (see `layers`).
  pub fn shiftOf(self: &Self, index: usize) -> Vector2<f32> {
    return layers.shiftOf(
      &self.output,
      &self.slotOfCss,
      &self.layout,
      &self.nodes,
      index,
      self.input.width,
      self.input.height,
    )
  }

  /// Fragment `index` of the last layout, moved to where it draws.
  pub fn visualFragment(self: &Self, index: usize) -> Fragment {
    let values = self.output.fragments.values.asSlice()
    return layers.visual(&values[index], self.shiftOf(index))
  }

  effect fn paintFrame(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.loadFaces()
    if self.paintDirty {
      self.paintCachesStale = true
    }
    run self.refreshPaintCaches()
    run self.paths.beginFrame()
    self.paintOrder.clear()
    let window = ContentMask.new(
      Rect<f32>.new(
        0.0,
        0.0,
        self.input.width * self.input.scale,
        self.input.height * self.input.scale,
      ),
    )
    self.flipped = !self.flipped
    if self.flipped {
      self.sceneB.clear()
      let mut painter = Painter {
        nodes: &mut self.nodes,
        slotOfCss: &self.slotOfCss,
        css: &self.layout,
        output: &self.output,
        text: &self.provider.text,
        faces: &self.faces,
        atlas: &mut self.atlas,
        glyphs: &mut self.glyphs,
        textInk: &mut self.textInk,
        resources: &mut self.resources,
        paths: &mut self.paths,
        scene: &mut self.sceneB,
        previous: &self.sceneA,
        replayable: self.replayable,
        scrollsStill: self.scrollsStill,
        hashes: &self.fragmentHashes,
        ink: &self.fragmentInk,
        scrollers: &self.fragmentScrollers,
        cull: window.bounds,
        lead: self.input.height * self.input.scale,
        width: self.input.width,
        height: self.input.height,
        stats: &mut self.stats,
        order: &mut self.paintOrder,
        frame: self.frameNumber,
        previousFrame: self.paintedAt,
        scale: self.input.scale,
        time: self.input.time,
        seed: self.seed,
        only: NONE,
        inside: false,
      }
      run paintRoots(&mut painter, window)
      drop painter
      run self.sceneB.finish()
      self.stats.primitives = self.sceneB.primitiveCount()
    } else {
      self.sceneA.clear()
      let mut painter = Painter {
        nodes: &mut self.nodes,
        slotOfCss: &self.slotOfCss,
        css: &self.layout,
        output: &self.output,
        text: &self.provider.text,
        faces: &self.faces,
        atlas: &mut self.atlas,
        glyphs: &mut self.glyphs,
        textInk: &mut self.textInk,
        resources: &mut self.resources,
        paths: &mut self.paths,
        scene: &mut self.sceneA,
        previous: &self.sceneB,
        replayable: self.replayable,
        scrollsStill: self.scrollsStill,
        hashes: &self.fragmentHashes,
        ink: &self.fragmentInk,
        scrollers: &self.fragmentScrollers,
        cull: window.bounds,
        lead: self.input.height * self.input.scale,
        width: self.input.width,
        height: self.input.height,
        stats: &mut self.stats,
        order: &mut self.paintOrder,
        frame: self.frameNumber,
        previousFrame: self.paintedAt,
        scale: self.input.scale,
        time: self.input.time,
        seed: self.seed,
        only: NONE,
        inside: false,
      }
      run paintRoots(&mut painter, window)
      drop painter
      run self.sceneA.finish()
      self.stats.primitives = self.sceneA.primitiveCount()
    }
    self.replayable = true
    self.paintedAt = self.frameNumber
    self.paintIndexOf.clear()
    run self.paintIndexOf.appendRepeated(NONE, self.nodes.length())
    let mut orderIndex: usize = 0
    while orderIndex < self.paintOrder.length() {
      let slot = self.slotOf(self.paintOrder.get(orderIndex))
      if slot != NONE && self.paintIndexOf.get(u32.toUsize(slot)) == NONE {
        self.paintIndexOf.set(u32.toUsize(slot), usize.toU32(orderIndex))
      }
      orderIndex = orderIndex + 1
    }
    run self.gatherUploads()
  }

  /// Paints node `slot` and its subtree alone into `scene` (finished), from the last layout,
  /// without touching the paint caches. For snapshots of one node.
  pub effect fn paintSubtree(self: &mut Self, slot: u32, scene: &mut Scene) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let window = ContentMask.new(
      Rect<f32>.new(
        0.0,
        0.0,
        self.input.width * self.input.scale,
        self.input.height * self.input.scale,
      ),
    )
    let mut stats = FrameStats.zero()
    let mut order = List<u32>.make()
    let mut painter = Painter {
      nodes: &mut self.nodes,
      slotOfCss: &self.slotOfCss,
      css: &self.layout,
      output: &self.output,
      text: &self.provider.text,
      faces: &self.faces,
      atlas: &mut self.atlas,
      glyphs: &mut self.glyphs,
      textInk: &mut self.textInk,
      resources: &mut self.resources,
      paths: &mut self.paths,
      scene: &mut scene,
      previous: &self.sceneA,
      replayable: false,
      scrollsStill: false,
      hashes: &self.fragmentHashes,
      ink: &self.fragmentInk,
      scrollers: &self.fragmentScrollers,
      cull: window.bounds,
      lead: 0.0,
      width: self.input.width,
      height: self.input.height,
      stats: &mut stats,
      order: &mut order,
      frame: self.frameNumber,
      previousFrame: self.paintedAt,
      scale: self.input.scale,
      time: self.input.time,
      seed: self.seed,
      only: slot,
      inside: false,
    }
    run paintRoots(&mut painter, window)
    drop painter
    run scene.finish()
    run self.gatherUploads()
  }

  /// Moves the tiles the caches allocated this frame into [`UiTree.uploads`].
  effect fn gatherUploads(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let glyphs = self.glyphs.uploads()
    let mut i: usize = 0
    while i < glyphs.length {
      run self.uploads.push(
        glyphs[i].tile,
        self.glyphs.uploadBytes(),
        glyphs[i].offset,
        glyphs[i].bytesPerRow,
      )
      i = i + 1
    }
    self.glyphs.clearUploads()
    let icons = self.resources.icons.uploads()
    i = 0
    while i < icons.length {
      run self.uploads.push(
        icons[i].tile,
        self.resources.icons.uploadBytes(),
        icons[i].offset,
        icons[i].bytesPerRow,
      )
      i = i + 1
    }
    self.resources.icons.clearUploads()
    let images = self.resources.images.uploads()
    i = 0
    while i < images.length {
      run self.uploads.push(
        images[i].tile,
        self.resources.images.uploadBytes(),
        images[i].offset,
        images[i].bytesPerRow,
      )
      i = i + 1
    }
    self.resources.images.clearUploads()
  }

  /// The atlas tiles allocated since the last [`UiTree.clearUploads`], with their pixels, for
  /// the renderer to copy into its textures.
  pub fn pendingUploads(self: &Self) -> &Pending {
    return &self.uploads
  }

  pub fn clearUploads(self: &mut Self) -> () {
    self.uploads.clear()
  }

  /// Forces the next frame of every root to paint everything again.
  pub fn invalidatePaint(self: &mut Self) -> () {
    self.replayable = false
    let parked = self.parked.asMutSlice()
    let mut i: usize = 0
    while i < parked.length {
      parked[i].replayable = false
      i = i + 1
    }
  }
}

effect fn ignoreInvalid(error: InvalidNode) -> () {
  drop error
}

fn contains(list: &List<u32>, value: u32) -> bool {
  let values = list.asSlice()
  let mut i: usize = 0
  while i < values.length {
    if values[i] == value {
      return true
    }
    i = i + 1
  }
  return false
}

fn sameNatural(a: NaturalDimensions, b: NaturalDimensions) -> bool {
  return a.aspectRatio == b.aspectRatio && a.size.width == b.size.width
    && a.size.height == b.size.height
}

effect fn defineImage(
  resources: &mut Resources,
  atlas: &mut Atlas,
  resource: u32,
  data: &[u8],
) -> bool
  ! ResourceError | OutOfMemoryError
  ? &mut Allocator {
  run resources.defineImage(&mut atlas, resource, data)
  return true
}

effect fn defineIcon(
  resources: &mut Resources,
  atlas: &mut Atlas,
  resource: u32,
  data: &[u8],
) -> bool
  ! ResourceError | OutOfMemoryError
  ? &mut Allocator {
  run resources.defineIcon(&mut atlas, resource, data)
  return true
}

effect fn resourceFailed(error: ResourceError) -> bool {
  drop error
  return false
}

/// Whether two computed text styles are the same, so the children that inherit them need no
/// restyle.
fn sameText(left: &TextStyle, right: &TextStyle) -> bool {
  return left.writingMode == right.writingMode && left.textOrientation == right.textOrientation
    && left.textAlignLast == right.textAlignLast
    && left.textWrap == right.textWrap
    && left.whiteSpaceCollapse == right.whiteSpaceCollapse
    && left.textJustify == right.textJustify
    && &left.textIndent == &right.textIndent
    && &left.tabSize == &right.tabSize
    && left.orphans == right.orphans
    && left.widows == right.widows
    && left.visibility == right.visibility
    && left.family == right.family
    && left.size == right.size
    && left.weight == right.weight
    && left.style == right.style
    && &left.lineHeight == &right.lineHeight
    && &left.color == &right.color
    && left.align == right.align
    && left.whiteSpace == right.whiteSpace
    && left.direction == right.direction
    && left.decoration.underline == right.decoration.underline
    && left.decoration.overline == right.decoration.overline
    && left.decoration.lineThrough == right.decoration.lineThrough
    && &left.decorationColor == &right.decorationColor
    && left.hasDecorationColor == right.hasDecorationColor
    && left.wavy == right.wavy
    && left.visible == right.visible
    && &left.caretColor == &right.caretColor
    && left.hasCaretColor == right.hasCaretColor
    && &left.selectionColor == &right.selectionColor
    && &left.placeholderColor == &right.placeholderColor
    && left.hasPlaceholderColor == right.hasPlaceholderColor
}
