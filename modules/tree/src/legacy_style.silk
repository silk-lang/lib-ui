//! The old `Property` union as declarations. Transitional: clients still build `Property`
//! values, and the tree stores and resolves `Declaration`s. It goes away once the clients build
//! declarations themselves.
import mutation {
  Property,
  Length,
  Side,
  Display,
  LineHeight,
  Declaration,
  Value,
  Keyword,
  CssProperty,
  VerticalAlignKind,
  TabSize,
  Align,
}
import properties.declare
import properties.values
import properties.convert
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// A `Length` as a written value.
pub effect fn written(value: Length) -> Value ! OutOfMemoryError ? &mut Allocator {
  match value {
    Length.Auto => {
      return values.auto()
    }
    Length.Px { value: pixels } => {
      return values.px(pixels)
    }
    Length.Percent { value: percent } => {
      return values.percent(percent)
    }
    Length.None => {
      return values.none()
    }
    Length.Calc { pixels, percent } => {
      let sum = run values.calc(pixels, percent)
      return move sum
    }
    Length.MinContent => {
      return values.keyword(Keyword.MinContent)
    }
    Length.MaxContent => {
      return values.keyword(Keyword.MaxContent)
    }
    Length.FitContent => {
      return values.keyword(Keyword.FitContent)
    }
    Length.Content => {
      return values.keyword(Keyword.Content)
    }
    Length.Normal => {
      return values.normal()
    }
  }
}

/// The keyword of a display value.
pub fn displayKeyword(value: Display) -> Keyword {
  return match value {
    Display.None => Keyword.None
    Display.Block => Keyword.Block
    Display.Inline => Keyword.Inline
    Display.InlineBlock => Keyword.InlineBlock
    Display.Flex => Keyword.Flex
    Display.InlineFlex => Keyword.InlineFlex
    Display.FlowRoot => Keyword.FlowRoot
    Display.Grid => Keyword.Grid
    Display.InlineGrid => Keyword.InlineGrid
    Display.Contents => Keyword.Contents
  }
}

fn sided(side: Side, top: CssProperty, right: CssProperty, bottom: CssProperty, left: CssProperty) -> CssProperty {
  return match side {
    Side.Top => top
    Side.Right => right
    Side.Bottom => bottom
    Side.Left => left
  }
}

/// `property` as a declaration.
pub effect fn declaration(property: Property) -> Declaration ! OutOfMemoryError ? &mut Allocator {
  match property {
    Property.Display { value } => {
      return declare.display(displayKeyword(value))
    }
    Property.Width { value } => {
      let length = run written(value)
      return declare.width(move length)
    }
    Property.Height { value } => {
      let length = run written(value)
      return declare.height(move length)
    }
    Property.MinWidth { value } => {
      let length = run written(value)
      return declare.minWidth(move length)
    }
    Property.MinHeight { value } => {
      let length = run written(value)
      return declare.minHeight(move length)
    }
    Property.MaxWidth { value } => {
      let length = run written(value)
      return declare.maxWidth(move length)
    }
    Property.MaxHeight { value } => {
      let length = run written(value)
      return declare.maxHeight(move length)
    }
    Property.FlexBasis { value } => {
      let length = run written(value)
      return declare.flexBasis(move length)
    }
    Property.RowGap { value } => {
      let length = run written(value)
      return declare.rowGap(move length)
    }
    Property.ColumnGap { value } => {
      let length = run written(value)
      return declare.columnGap(move length)
    }
    Property.Margin { side, value } => {
      let length = run written(value)
      return values.declare(sided(side, CssProperty.MarginTop, CssProperty.MarginRight, CssProperty.MarginBottom, CssProperty.MarginLeft), move length)
    }
    Property.Padding { side, value } => {
      let length = run written(value)
      return values.declare(sided(side, CssProperty.PaddingTop, CssProperty.PaddingRight, CssProperty.PaddingBottom, CssProperty.PaddingLeft), move length)
    }
    Property.Inset { side, value } => {
      let length = run written(value)
      return values.declare(sided(side, CssProperty.Top, CssProperty.Right, CssProperty.Bottom, CssProperty.Left), move length)
    }
    Property.BorderWidth { side, value } => {
      return values.declare(sided(side, CssProperty.BorderTopWidth, CssProperty.BorderRightWidth, CssProperty.BorderBottomWidth, CssProperty.BorderLeftWidth), values.px(value))
    }
    Property.Position { value } => {
      return declare.position(value)
    }
    Property.BoxSizing { value } => {
      return declare.boxSizing(value)
    }
    Property.FlexDirection { value } => {
      return declare.flexDirection(value)
    }
    Property.FlexWrap { value } => {
      return declare.flexWrap(value)
    }
    Property.FlexGrow { value } => {
      return declare.flexGrow(value)
    }
    Property.FlexShrink { value } => {
      return declare.flexShrink(value)
    }
    Property.JustifyContent { value } => {
      return declare.justifyContent(value)
    }
    Property.AlignItems { value } => {
      return declare.alignItems(value)
    }
    Property.AlignSelf { value } => {
      return declare.alignSelf(value)
    }
    Property.AlignContent { value } => {
      return declare.alignContent(value)
    }
    Property.OverflowX { value } => {
      return declare.overflowX(value)
    }
    Property.OverflowY { value } => {
      return declare.overflowY(value)
    }
    Property.AspectRatio { value } => {
      return declare.aspectRatio(value)
    }
    Property.UnicodeBidi { value } => {
      return declare.unicodeBidi(value)
    }
    Property.WritingMode { value } => {
      return declare.writingMode(value)
    }
    Property.TextOrientation { value } => {
      return declare.textOrientation(value)
    }
    Property.BaselineSource { value } => {
      return declare.baselineSource(value)
    }
    Property.WhiteSpaceCollapse { value } => {
      return declare.whiteSpaceCollapse(value)
    }
    Property.TextJustify { value } => {
      return declare.textJustify(value)
    }
    Property.BoxDecorationBreak { value } => {
      return declare.boxDecorationBreak(value)
    }
    Property.MarginBreak { value } => {
      return declare.marginBreak(value)
    }
    Property.BreakBefore { value } => {
      return declare.breakBefore(value)
    }
    Property.BreakAfter { value } => {
      return declare.breakAfter(value)
    }
    Property.BreakInside { value } => {
      return declare.breakInside(value)
    }
    Property.Orphans { value } => {
      return declare.orphans(value)
    }
    Property.Widows { value } => {
      return declare.widows(value)
    }
    Property.Order { value } => {
      return declare.order(value)
    }
    Property.JustifySelf { value } => {
      return declare.justifySelf(value)
    }
    Property.JustifyItems { value } => {
      return declare.justifyItems(value)
    }
    Property.ScrollbarWidth { value } => {
      return declare.scrollbarWidth(value)
    }
    Property.Float { value } => {
      return declare.float(value)
    }
    Property.Clear { value } => {
      return declare.clear(value)
    }
    Property.Visibility { value } => {
      return declare.visibility(value)
    }
    Property.ObjectFit { value } => {
      return declare.objectFit(value)
    }
    Property.BorderStyle { value } => {
      return declare.borderStyle(value)
    }
    Property.Opacity { value } => {
      return declare.opacity(value)
    }
    Property.PointerEvents { value } => {
      return declare.pointerEvents(value)
    }
    Property.Visible { value } => {
      return declare.visible(value)
    }
    Property.FontWeight { value } => {
      return declare.fontWeight(value)
    }
    Property.FontStyle { value } => {
      return declare.fontStyle(value)
    }
    Property.TextAlign { value } => {
      return declare.textAlign(value)
    }
    Property.WhiteSpace { value } => {
      return declare.whiteSpace(value)
    }
    Property.Direction { value } => {
      return declare.direction(value)
    }
    Property.TextDecorationWavy { value } => {
      return declare.textDecorationWavy(value)
    }
    Property.TextAlignLast { value } => {
      return declare.textAlignLast(value)
    }
    Property.TextWrap { value } => {
      return declare.textWrapMode(value)
    }
    Property.FontSize { value } => {
      return declare.fontSize(values.px(value))
    }
    Property.FontFamily { family } => {
      return declare.fontFamily(family)
    }
    Property.VerticalAlign { value } => {
      if value.kind == VerticalAlignKind.Shift {
        let shift = run convert.fromDimension(value.shift)
        return declare.verticalAlign(move shift)
      }
      let word = match value.kind {
        VerticalAlignKind.Baseline => Keyword.Baseline
        VerticalAlignKind.Middle => Keyword.Middle
        VerticalAlignKind.TextTop => Keyword.TextTop
        VerticalAlignKind.TextBottom => Keyword.TextBottom
        VerticalAlignKind.Top => Keyword.Top
        VerticalAlignKind.Bottom => Keyword.Bottom
        VerticalAlignKind.Sub => Keyword.Sub
        VerticalAlignKind.Super => Keyword.Super
        VerticalAlignKind.Shift => Keyword.Baseline
      }
      return declare.verticalAlign(values.keyword(word))
    }
    Property.TextIndent { value } => {
      let amount = run convert.fromDimension(value.value)
      if !value.hanging && !value.eachLine {
        return declare.textIndent(move amount)
      }
      let made = run declare.textIndentWith(move amount, value.hanging, value.eachLine)
      return move made
    }
    Property.TabSize { value } => {
      return match value {
        TabSize.Number { value: count } => declare.tabSize(values.number(count))
        TabSize.Length { value: pixels } => declare.tabSize(values.px(pixels))
      }
    }
    Property.LineHeight { value } => {
      return match value {
        LineHeight.Normal => declare.lineHeight(values.normal())
        LineHeight.Number { value: multiple } => declare.lineHeight(values.number(multiple))
        LineHeight.Px { value: pixels } => declare.lineHeight(values.px(pixels))
      }
    }
    Property.AspectRatioAuto { value } => {
      return values.declare(CssProperty.AspectRatio, if value { values.auto() } else { values.number(0.0) })
    }
    Property.ObjectPosition { x, y } => {
      let first = run written(x)
      let second = run written(y)
      let made = run declare.objectPosition(move first, move second)
      return move made
    }
    Property.BorderRadius { value } => {
      if value.topRight == value.topLeft && value.bottomRight == value.topLeft && value.bottomLeft == value.topLeft {
        return declare.borderRadius(values.px(value.topLeft))
      }
      let made = run declare.borderRadii(value.topLeft, value.topRight, value.bottomRight, value.bottomLeft)
      return move made
    }
    Property.NoBoxShadow => {
      return declare.noBoxShadow()
    }
    Property.TextDecorationLine { value } => {
      let made = run declare.textDecorationLines(value)
      return move made
    }
    Property.JustifyContentSafety { value } => {
      let made = run declare.justifyContentWith(Align.Normal, value)
      return move made
    }
    Property.AlignContentSafety { value } => {
      let made = run declare.alignContentWith(Align.Normal, value)
      return move made
    }
    Property.AlignItemsSafety { value } => {
      let made = run declare.alignItemsWith(Align.Normal, value)
      return move made
    }
    Property.AlignSelfSafety { value } => {
      let made = run declare.alignSelfWith(Align.Normal, value)
      return move made
    }
    Property.JustifySelfSafety { value } => {
      let made = run declare.justifySelfWith(Align.Normal, value)
      return move made
    }
    Property.JustifyItemsSafety { value } => {
      let made = run declare.justifyItemsWith(Align.Normal, value)
      return move made
    }
    Property.ScrollbarGutter { value } => {
      let made = run declare.scrollbarGutter(value)
      return move made
    }
    Property.BoxShadow { value } => {
      let made = run declare.boxShadow(value)
      return move made
    }
    Property.BackdropBlur { value } => {
      let made = run declare.backdropBlur(value)
      return move made
    }
    Property.BackgroundGradient { angle, from, to } => {
      let made = run declare.backgroundGradient(angle, from, to)
      return move made
    }
    Property.BackgroundColor { color } => {
      return declare.backgroundColor(color)
    }
    Property.BorderColor { color } => {
      return declare.borderColor(color)
    }
    Property.Color { color } => {
      return declare.color(color)
    }
    Property.TextDecorationColor { color } => {
      return declare.textDecorationColor(color)
    }
    Property.CaretColor { color } => {
      return declare.caretColor(color)
    }
    Property.SelectionColor { color } => {
      return declare.selectionColor(color)
    }
    Property.PlaceholderColor { color } => {
      return declare.placeholderColor(color)
    }
  }
}

/// `properties` as declarations, in order.
pub effect fn declarations(properties: &[Property]) -> List<Declaration>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = run List<Declaration>.makeWithCapacity(properties.length)
  let mut i: usize = 0
  while i < properties.length {
    let made = run declaration(properties[i])
    run out.append(move made)
    i = i + 1
  }
  return move out
}
