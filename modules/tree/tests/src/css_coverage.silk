import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }

/// A property and the styles that make its value matter: the root's, the leading sibling's,
/// and the target's own before `sample` is set on it.
struct Row {
  root: &'static [u8],
  lead: &'static [u8],
  setup: &'static [u8],
  sample: &'static [u8],
}

impl Copy for Row {}

