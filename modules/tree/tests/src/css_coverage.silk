    Row { root: b"", lead: b"", setup: b"mask-image:linear-gradient(black, transparent);mask-size:20px 20px", sample: b"mask-position:10px 5px" },
    Row { root: b"", lead: b"", setup: b"mask-image:linear-gradient(black, transparent);padding:5px", sample: b"mask-clip:content-box" },
    Row { root: b"", lead: b"", setup: b"mask-image:linear-gradient(black, transparent);padding:5px", sample: b"mask-origin:content-box" },
    Row { root: b"", lead: b"", setup: b"mask-image:linear-gradient(black, transparent)", sample: b"mask-size:20px 20px" },
  ]
}

/// What the tree leaves to others for now, with who owns it.
fn unsupported(property: Property) -> bool {
  return fragmentation(property) || svgOnly(property) || later(property)
}

/// Read by layout only when content is split into pages or columns: the pagination tests
/// cover them.
fn fragmentation(property: Property) -> bool {
  return property == Property.BreakBefore || property == Property.BreakAfter
    || property == Property.BreakInside
    || property == Property.BoxDecorationBreak
    || property == Property.MarginBreak
    || property == Property.Orphans
    || property == Property.Widows
}

/// SVG presentation attributes: lib-svg reads them, a tree node has no SVG content.
fn svgOnly(property: Property) -> bool {
  return property == Property.Fill || property == Property.FillRule || property == Property.FillOpacity
    || property == Property.Stroke || property == Property.StrokeOpacity || property == Property.StrokeWidth
    || property == Property.StrokeLinecap || property == Property.StrokeLinejoin
    || property == Property.StrokeMiterlimit || property == Property.StrokeDasharray
    || property == Property.StrokeDashoffset || property == Property.MarkerStart
    || property == Property.MarkerMid || property == Property.MarkerEnd || property == Property.Marker
    || property == Property.PaintOrder || property == Property.ColorInterpolation
    || property == Property.ColorInterpolationFilters || property == Property.ColorRendering
    || property == Property.ShapeRendering || property == Property.Cx || property == Property.Cy
    || property == Property.R || property == Property.Rx || property == Property.Ry
    || property == Property.X || property == Property.Y || property == Property.D
    || property == Property.VectorEffect || property == Property.FloodColor
    || property == Property.FloodOpacity || property == Property.LightingColor
    || property == Property.StopColor || property == Property.StopOpacity
    || property == Property.EnableBackground || property == Property.ColorProfile
    || property == Property.Kerning || property == Property.GlyphOrientationHorizontal
    || property == Property.GlyphOrientationVertical || property == Property.TextAnchor
    || property == Property.ClipRule || property == Property.MaskType
    || property == Property.BaselineShift || property == Property.AlignmentBaseline
    || property == Property.DominantBaseline || property == Property.ShapeInside
    || property == Property.ShapeSubtract || property == Property.InlineSize
}

/// Not on the tree path yet. Each group names who is adding it; move a property to `rows`
/// when it works.
fn later(property: Property) -> bool {
  // "Paint CSS effects in the tree".
  return property == Property.Clip || property == Property.Isolation
    || property == Property.BackgroundBlendMode || property == Property.BackgroundAttachment || property == Property.MaskMode || property == Property.MaskComposite || property == Property.MaskBorder
    || property == Property.MaskBorderSource || property == Property.MaskBorderMode
    || property == Property.MaskBorderSlice || property == Property.MaskBorderWidth
    || property == Property.MaskBorderOutset || property == Property.MaskBorderRepeat
    || property == Property.ImageRendering || property == Property.ImageOrientation
    // "Add CSS transforms to the tree".
    || property == Property.Transform || property == Property.TransformOrigin
    || property == Property.Perspective || property == Property.PerspectiveOrigin
    || property == Property.TransformBox || property == Property.TransformStyle
    || property == Property.BackfaceVisibility || property == Property.Translate
    || property == Property.Rotate || property == Property.Scale
    // "Add CSS transitions, animations and vh units".
    || property == Property.Animation || property == Property.AnimationName
    || property == Property.AnimationDuration || property == Property.AnimationTimingFunction
    || property == Property.AnimationDelay || property == Property.AnimationIterationCount
    || property == Property.AnimationDirection || property == Property.AnimationFillMode
    || property == Property.AnimationPlayState
    // "Support all CSS properties on every backend": text and stacking.
    || property == Property.All
    || property == Property.FontSizeAdjust || property == Property.FontStretch
    || property == Property.FontWidth || property == Property.FontVariant
    || property == Property.FontVariantLigatures || property == Property.FontVariantCaps
    || property == Property.FontVariantNumeric || property == Property.FontVariantEastAsian
    || property == Property.FontVariantPosition || property == Property.FontVariantAlternates
    || property == Property.FontVariantEmoji || property == Property.FontFeatureSettings
    || property == Property.FontVariationSettings || property == Property.FontKerning
    || property == Property.FontOpticalSizing || property == Property.FontLanguageOverride
    || property == Property.FontSynthesis || property == Property.FontSynthesisWeight
    || property == Property.FontSynthesisStyle || property == Property.FontSynthesisSmallCaps
    || property == Property.FontSynthesisPosition || property == Property.FontPalette
    || property == Property.TextDecorationThickness
    || property == Property.TextDecorationFill || property == Property.TextDecorationStroke
    || property == Property.TextUnderlinePosition
    || property == Property.TextRendering || property == Property.LineBreak
    || property == Property.TextAlignAll || property == Property.TextCombineUpright
    || property == Property.HangingPunctuation || property == Property.TextEmphasis
    || property == Property.TextEmphasisStyle || property == Property.TextEmphasisColor
    || property == Property.TextEmphasisPosition || property == Property.Hyphens
    || property == Property.WhiteSpaceTrim || property == Property.ShapeMargin
    // "Add CSS transitions, animations and vh units", continued.
    || property == Property.Transition || property == Property.TransitionProperty
    || property == Property.TransitionDuration || property == Property.TransitionTimingFunction
    || property == Property.TransitionDelay || property == Property.TransitionBehavior
    // "Add missing CSS properties to lib-css": parsed, with nothing in the tree behind them
    // yet. The tree reads overscroll-behavior, scroll-behavior, scroll-margin and
    // scroll-padding, but only when scrolling (interaction tests), not in layout or paint.
    || property == Property.UserSelect
    || property == Property.AccentColor || property == Property.Appearance
    || property == Property.Resize
    || property == Property.Continue || property == Property.ScrollbarColor
    || property == Property.OverflowAnchor || property == Property.OverflowClipMargin
    || property == Property.TextWrapStyle
    || property == Property.HyphenateCharacter || property == Property.TextSizeAdjust
    || property == Property.TextUnderlineOffset || property == Property.TextDecorationSkipInk
    || property == Property.OverscrollBehavior || property == Property.OverscrollBehaviorX
    || property == Property.OverscrollBehaviorY || property == Property.OverscrollBehaviorInline
    || property == Property.OverscrollBehaviorBlock || property == Property.ScrollBehavior
    || property == Property.ScrollSnapType || property == Property.ScrollSnapAlign
    || property == Property.ScrollSnapStop || property == Property.ScrollMarginTop
    || property == Property.ScrollMarginRight || property == Property.ScrollMarginBottom
    || property == Property.ScrollMarginLeft || property == Property.ScrollMarginBlockStart
    || property == Property.ScrollMarginBlockEnd || property == Property.ScrollMarginInlineStart
    || property == Property.ScrollMarginInlineEnd || property == Property.ScrollMargin
    || property == Property.ScrollMarginBlock || property == Property.ScrollMarginInline
    || property == Property.ScrollPaddingTop || property == Property.ScrollPaddingRight
    || property == Property.ScrollPaddingBottom || property == Property.ScrollPaddingLeft
    || property == Property.ScrollPaddingBlockStart || property == Property.ScrollPaddingBlockEnd
    || property == Property.ScrollPaddingInlineStart || property == Property.ScrollPaddingInlineEnd
    || property == Property.ScrollPadding || property == Property.ScrollPaddingBlock
    || property == Property.ScrollPaddingInline || property == Property.TouchAction
    || property == Property.Contain || property == Property.ContentVisibility
    || property == Property.ContainIntrinsicWidth || property == Property.ContainIntrinsicHeight
    || property == Property.ContainIntrinsicBlockSize
    || property == Property.ContainIntrinsicInlineSize || property == Property.ContainIntrinsicSize
    || property == Property.ContainerType || property == Property.ContainerName
    || property == Property.Container || property == Property.WillChange
    || property == Property.ListStylePosition || property == Property.ListStyleImage
    || property == Property.ListStyleType || property == Property.ListStyle
    || property == Property.CounterReset || property == Property.CounterIncrement
    || property == Property.CounterSet || property == Property.Content
    || property == Property.Quotes || property == Property.BorderCollapse
    || property == Property.BorderSpacing || property == Property.TableLayout
    || property == Property.CaptionSide || property == Property.EmptyCells
    || property == Property.ColumnCount || property == Property.ColumnWidth
    || property == Property.Columns || property == Property.ColumnRuleWidth
    || property == Property.ColumnRuleStyle || property == Property.ColumnRuleColor
    || property == Property.ColumnRule || property == Property.ColumnSpan
    || property == Property.ColumnFill || property == Property.BorderImageSource
    || property == Property.BorderImageSlice || property == Property.BorderImageWidth
    || property == Property.BorderImageOutset || property == Property.BorderImageRepeat
    || property == Property.BorderImage || property == Property.ColorScheme
    || property == Property.PrintColorAdjust || property == Property.ForcedColorAdjust
    || property == Property.ShapeOutside || property == Property.ShapeImageThreshold
    || property == Property.FieldSizing
    // Read, but without effect yet: no oblique synthesis without an italic face, overlay
    // scrollbars take no space, and a block's last baseline is not used for alignment.
    || property == Property.FontStyle || property == Property.ScrollbarGutter
    || property == Property.ScrollbarWidth || property == Property.BaselineSource
}

struct Fixture {
  root: BoxNode,
  lead: BoxNode,
  target: BoxNode,
  text: TextNode,
  inner: BoxNode,
  after: BoxNode,
}

impl Copy for Fixture {}

effect fn restyle(tree: &mut Tree<'_>, node: BoxNode, css: &[u8]) -> ()
  ! TreeError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let declarations = run written.declarations(css)
  run tree.setStyle(node, declarations.asSlice())
}

/// A 400 by 300 root holding a leading box, the target (text, then a 20px box) and a 10px
/// tall box after it.
effect fn fixture(tree: &mut Tree<'_>, row: Row) -> Fixture
  ! TreeError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let root = run tree.box(&[])
  run restyle(&mut tree, root, b"width: 400px; height: 300px")
  run restyle(&mut tree, root, row.root)
  let lead = run tree.box(&[])
  run restyle(&mut tree, lead, row.lead)
  let sans = run tree.fontFamily("Noto Sans, sans-serif")
  let target = run tree.box(&[css.fontFamily(sans.raw())])
  run restyle(&mut tree, target, row.setup)
  let text = run tree.text("Hello\twide  world of text")
  let inner = run tree.box(&[])
  run restyle(&mut tree, inner, b"width: 20px; height: 20px")
  let after = run tree.box(&[])
  run restyle(&mut tree, after, b"height: 10px")
  run tree.append(root, lead)
  run tree.append(root, target)
  run tree.append(target, text)
  run tree.append(target, inner)
  run tree.append(root, after)
  run tree.setRoot(root)
  return Fixture { root: root, lead: lead, target: target, text: text, inner: inner, after: after }
}

effect fn geometry<N: Node>(tree: &Tree<'_>, node: N, out: &mut List<f32>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let fragments = run tree.fragments(move node)
  run out.append(-1.0)
  let mut i: usize = 0
  while i < fragments.length() {
    let box = fragments.get(i).border
    run out.append(box.xMin)
    run out.append(box.yMin)
    run out.append(box.xMax)
    run out.append(box.yMax)
    i = i + 1
  }
}

/// What the fixture shows: every fragment's border box, and how the target and its text
/// paint.
effect fn look(tree: &Tree<'_>, f: Fixture, paint: &mut List<u64>) -> List<f32>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = List<f32>.make()
  run geometry(tree, f.lead, &mut out)
  run geometry(tree, f.target, &mut out)
  run geometry(tree, f.text, &mut out)
  run geometry(tree, f.inner, &mut out)
  run geometry(tree, f.after, &mut out)
  let seed = Hash.seed(1)
  match tree.view(f.target) {
    Option.Some { value } => {
      run paint.append(value.computed().paintHash(&seed))
      run paint.append(if value.computed().cursor.isSome() { 1 } else { 0 })
    }
    Option.None => {}
  }
  match tree.view(f.text) {
    Option.Some { value } => {
      run paint.append(value.computed().paintHash(&seed))
      run paint.append(if value.computed().text.visible { 1 } else { 0 })
    }
    Option.None => {}
  }
  return move out
}

fn sameFloats(a: &List<f32>, b: &List<f32>) -> bool {
  if a.length() != b.length() { return false }
  let mut i: usize = 0
  while i < a.length() {
    if a.get(i) != b.get(i) { return false }
    i = i + 1
  }
  return true
}

fn sameHashes(a: &List<u64>, b: &List<u64>) -> bool {
  if a.length() != b.length() { return false }
  let mut i: usize = 0
  while i < a.length() {
    if a.get(i) != b.get(i) { return false }
    i = i + 1
  }
  return true
}

fn viewport() -> Viewport {
  return Viewport { width: 800.0, height: 600.0, scale: 1.0 }
}

/// Whether setting `row.sample` changes how the fixture lays out or paints.
effect fn changes(row: Row) -> bool
  ! TreeError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run Tree.make(&fonts)
  let f = run fixture(&mut tree, row)
  drop run tree.frame(viewport(), 0.0)
  let mut paintBefore = List<u64>.make()
  let before = run look(&tree, f, &mut paintBefore)
  run restyle(&mut tree, f.target, row.sample)
  drop run tree.frame(viewport(), 0.0)
  let mut paintAfter = List<u64>.make()
  let after = run look(&tree, f, &mut paintAfter)
  return !sameFloats(&before, &after) || !sameHashes(&paintBefore, &paintAfter)
}

effect fn sampled(property: Property) -> bool
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let table = rows()
  let mut i: usize = 0
  while i < table.length {
    let declarations = run written.declarations(table[i].sample)
    if declarations.length() == 1 && declarations.asSlice()[0].property == property {
      return true
    }
    i = i + 1
  }
  return false
}

/// Fails naming the first row whose sample changes nothing.
effect fn everyRowChangesSomething() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let table = rows()
  let mut i: usize = 0
  while i < table.length {
    let declarations = run written.declarations(table[i].sample)
    let changed = declarations.length() == 1 && run changes(table[i])
    run Testing.expect(changed, unsafe String.fromUtf8Unchecked(table[i].sample))
    i = i + 1
  }
}

/// Fails naming the first catalog property with neither a row nor a reason, or with both.
effect fn everyPropertyHasAnAnswer() -> ()
  ! CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let all = catalog.all()
  let mut i: usize = 0
  while i < all.length {
    let property = all[i]
    let row = run sampled(property)
    run Testing.expect(row != unsupported(property), unsafe String.fromUtf8Unchecked(catalog.name(property)))
    i = i + 1
  }
}

effect fn shownCursor(tree: &mut Tree<'_>) -> Cursor
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let frame = run tree.frame(viewport(), 0.0)
  return frame.cursor
}

/// The CSS cursor of the hovered node shows; `auto` takes its ancestor's.
effect fn cursorsFromStyle() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run Tree.make(&fonts)
  let root = run tree.box(&[])
  run restyle(&mut tree, root, b"width: 200px; height: 200px; cursor: pointer")
  let text = run tree.box(&[])
  run restyle(&mut tree, text, b"height: 50px; cursor: text")
  let plain = run tree.box(&[])
  run restyle(&mut tree, plain, b"height: 50px; cursor: auto")
  run tree.append(root, text)
  run tree.append(root, plain)
  run tree.setRoot(root)
  drop run tree.frame(viewport(), 0.0)
  run tree.dispatch(Input.moveTo(10.0, 10.0))
  let shown1 = run shownCursor(&mut tree)
  run Testing.expect(shown1 == Cursor.Text, "the hovered node's cursor shows")
  run tree.dispatch(Input.moveTo(10.0, 60.0))
  let shown2 = run shownCursor(&mut tree)
  run Testing.expect(shown2 == Cursor.Pointer, "auto takes the ancestor's cursor")
  run tree.dispatch(Input.moveTo(10.0, 150.0))
  let shown3 = run shownCursor(&mut tree)
  run Testing.expect(shown3 == Cursor.Pointer, "and so does the ancestor itself")
}

test effect fn cssCoverageCursorsFromStyle() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run cursorsFromStyle() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn cssCoverageEveryRowChangesSomething() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run everyRowChangesSomething() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn cssCoverageEveryPropertyHasAnAnswer() -> ()
  ! CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run everyPropertyHasAnAnswer() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// Whether the fixture looks the same with the target styled `first` as with `second`.
effect fn sameLook(first: &'static [u8], second: &'static [u8]) -> bool
  ! TreeError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut one = run Tree.make(&fonts)
  let f1 = run fixture(&mut one, Row { root: b"", lead: b"", setup: first, sample: b"" })
  drop run one.frame(viewport(), 0.0)
  let mut paint1 = List<u64>.make()
  let look1 = run look(&one, f1, &mut paint1)
  let mut two = run Tree.make(&fonts)
  let f2 = run fixture(&mut two, Row { root: b"", lead: b"", setup: second, sample: b"" })
  drop run two.frame(viewport(), 0.0)
  let mut paint2 = List<u64>.make()
  let look2 = run look(&two, f2, &mut paint2)
  return sameFloats(&look1, &look2) && sameHashes(&paint1, &paint2)
}

/// `font` and `text-decoration` set their longhands, and reset the ones they leave out.
effect fn fontShorthands() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let whole = run sameLook(
    b"font: italic bold 24px/40px Noto Sans, sans-serif",
    b"font-style: italic; font-weight: bold; font-size: 24px; line-height: 40px; font-family: Noto Sans, sans-serif",
  )
  run Testing.expect(whole, "font sets its longhands")
  let reset = run sameLook(
    b"font-weight: bold; line-height: 50px; font: 24px sans-serif",
    b"font-size: 24px; font-family: sans-serif",
  )
  run Testing.expect(reset, "font resets the longhands it leaves out")
  let dropped = run sameLook(b"font: bold", b"")
  run Testing.expect(dropped, "font without a size is dropped")
  let decoration = run sameLook(
    b"text-decoration: red underline wavy",
    b"text-decoration-line: underline; text-decoration-style: wavy; text-decoration-color: red",
  )
  run Testing.expect(decoration, "text-decoration sets its longhands")
}

test effect fn cssCoverageFontShorthands() -> ()
  ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run fontShorthands() |> Effect.provideMut<Allocator>(&mut allocator)
}
