//! Every property of the shared CSS catalog has an answer on the tree path: a row below whose
//! value changes how the node lays out or paints, or a place in a list of what the tree does
//! not do yet. A property the tree stops reading fails its row; a property new to the catalog
//! fails until it is given one.
import ui_tree.lib { Tree, TreeError, Viewport, BoxNode, TextNode, Node }
import ui_tree.css { Property }
import ui_tree.css
import ui_fixtures.fixtures as fixtures
import svg_css.written as written
import svg_css.tokens { CssError }
import properties.catalog
import silk.collections.hash { Hash }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }

/// A property and the styles that make its value matter: the root's, the leading sibling's,
/// and the target's own before `sample` is set on it.
struct Row {
  root: &'static [u8],
  lead: &'static [u8],
  setup: &'static [u8],
  sample: &'static [u8],
}

impl Copy for Row {}

fn rows() -> [Row; 123] {
  return [
    Row { root: b"", lead: b"", setup: b"display:flex;flex-wrap:wrap;height:200px", sample: b"align-content:center" },
    Row { root: b"", lead: b"", setup: b"display:flex;height:100px", sample: b"align-items:center" },
