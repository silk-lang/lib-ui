//! Anchor placement follows tree scrolling without a framework render.
import ui_tree.css
import ui_tree.css { px }
import ui_tree.legacy {
  UiTree,
  TreeError,
  Batch,
  Mutation,
  Overflow,
  FrameInput,
  AnchorOptions,
  NodeKind
}
import ui_tree.inspect { info, NodeInfo }
import ui_fixtures.fixtures as fixtures
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.num.f32

effect fn body() -> ()
  ! TreeError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.box(
    1,
    2,
    &[css.height(px(300.0)), css.overflowY(Overflow.Auto)],
  )
  run batch.box(
    2,
    3,
    &[
      css.marginTop(px(250.0)),
      css.height(px(40.0)),
      css.width(px(120.0)),
    ],
  )
  run batch.box(2, 4, &[css.height(px(500.0))])
  run batch.box(
    1,
    5,
    &[css.height(px(80.0)), css.width(px(100.0))],
  )
  run batch.push(
    Mutation.SetAnchor {
      id: 5,
      target: 3,
      options: AnchorOptions { gap: 6.0, preferredHeight: 80.0, alignEnd: false, matchWidth: true },
    },
  )
  run tree.apply(run batch.take())
  let frame = FrameInput { width: 300.0, height: 300.0, scale: 1.0, time: 0.0 }
  run tree.frame(frame)
  if let Option<NodeInfo>.Some { value: popup } = run info(&tree, 5) {
    run Testing.expect(
      popup.laidOut && f32.abs(popup.bounds.yMax - 244.0) < 0.1,
      "popup opens above an anchor near the bottom on its first frame",
    )
    run Testing.expect(popup.bounds.width() >= 120.0, "popup matches the anchor's width")
  } else {
    run Testing.expect(false, "popup exists")
  }
  run batch.push(Mutation.ClearVirtualList { id: 5 })
  run batch.scrollTo(2, 0.0, 100.0)
  run tree.apply(run batch.take())
  run tree.frame(frame)
  run Testing.expect(tree.anchors.length() == 1, "virtual-list removal preserves popup placement")
  if let Option<NodeInfo>.Some { value: popup } = run info(&tree, 5) {
    run Testing.expect(
      f32.abs(popup.bounds.yMin - 196.0) < 0.1,
      "scrolling flips and moves the popup without another client render",
    )
  }
  run batch.push(Mutation.ClearAnchor { id: 5 })
  run tree.apply(run batch.take())
  run tree.frame(frame)
  if let Option<NodeInfo>.Some { value: popup } = run info(&tree, 5) {
    run Testing.expect(
      f32.abs(popup.bounds.width() - 100.0) < 0.1,
      "clearing placement restores client dimensions",
    )
  }
  run Testing.expect(tree.anchors.length() == 0, "clearing releases the relationship")
}

test effect fn followsScrollWithoutClientLayout() -> ()
  ! TreeError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run body() |> Effect.provideMut<Allocator>(&mut allocator)
}
