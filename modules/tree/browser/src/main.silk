//! The browser comparison: a wasm module with modules/gpu/webgpu's sample ABI (`sample_start`,
//! `sample_poll`, `sample_drop`, `host.sample_output`) that builds tree `index % COUNT` from
//! ui_fixtures, runs one `UiTree.frame`, draws the frame's scene with `UiRenderer` on
//! `navigator.gpu` (RGBA8 for the first `COUNT` indices, BGRA8 for the next) and outputs the GPU
//! pixels (kind 1) and the CPU reference of the same scene (kind 2). `test.mjs` compares them.
static if Intrinsic.targetArchitecture() == "wasm32" {
  // Imported only for the symbols it exports to the wasm32 host.
  import browser as _browser

  // Imported only for the C math symbols it exports to the wasm32 runtime.
  import libm as _libm

  // Imported only for the WebGPU symbols it exports to the wasm32 host.
  import generated_webgpu_exports as _generated_webgpu_exports

  pub fn main() -> i32 {
    return 0
  }
} else {
  pub fn main() -> i32 {
    return 0
  }
}
