//! Reading font stylesheets (`Mutation.LoadFontStylesheet`) into `@font-face` rules. The
//! loader reads or fetches a sheet off the UI thread (`Images.forSheets`, with a desktop
//! browser's `User-Agent`, so Google Fonts answers with WOFF2 faces) and parses it here. A
//! WebAssembly host reads no rules: a page links its font stylesheets itself.
import font_web.stylesheet { FontFaceRule }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }

static if Intrinsic.targetArchitecture() == "wasm32" {
  /// Reads no rules in a WebAssembly host.
  pub effect fn rulesOf(css: &[u8], base: string) -> List<FontFaceRule>
    ! OutOfMemoryError
    ? &mut Allocator {
    return List<FontFaceRule>.make()
  }
} else {
  import font_web.stylesheet { parse }
  import silk.core.option { Option }
  import silk.text.string { String }
  import silk.url.url { Url }

  /// The `@font-face` rules of `css`, with relative URLs resolved against `base` when it is
  /// an absolute URL, and kept as written otherwise.
  pub effect fn rulesOf(css: &[u8], base: string) -> List<FontFaceRule>
    ! OutOfMemoryError
    ? &mut Allocator {
    if String.byteLength(base) == 0 {
      return run parse(css, Option<&'static Url>.None)
    }
    let parsed = run Url.parse(base, Option<&'static Url>.None)
    return match move parsed {
      Option<Url>.Some { value } => run parse(css, Option<&Url>.Some { value: &value })
      Option<Url>.None => run parse(css, Option<&'static Url>.None)
    }
  }
}
