//! The window host's renderer in the browser, where there are no threads. It has the API of
//! [`render_thread.RenderThread`], but draws each frame on the calling thread, inside
//! [`InlineRenderer.submit`]: the browser's own compositor shows the canvas, so presenting never
//! waits for the display.
//!
//! WebGPU in the browser answers adapter, device and buffer-map requests asynchronously. While
//! one is pending, the renderer gives the page's event loop a turn through the
//! `silk_browser#yield` import, which `browser/app-host.js` makes a JSPI suspending import; so
//! the app's entry point must be called through `WebAssembly.promising`, as `app-host.js` does.
import ui_scene.scene { Scene }
import ui_scene.color as color
import ui_tree.legacy { Pending }
import atlas.atlas { Atlas, TextureInfo }
import ui_renderer.atlas_textures { GpuAtlas }
import ui_renderer.compare { Tolerance, compare }
import ui_renderer.readback { copyOut, isBgra, pickFormat, readbackSize, unpack }
import ui_renderer.renderer { UiRenderer }
import ui_renderer.text { TextSettings }
import render_thread { FastScroll, RenderReport, RenderSettings }
import console { StderrWriter }
import clock { Clock }
import window.types { RawSurface, WindowId }
import webgpu.runtime { Device, GpuError, Instance, RequestAdapterOptions }
import webgpu.runtime as runtime
import webgpu.resources { Queue, Texture, getQueue }
import webgpu.surface { Surface, SurfaceConfiguration, SurfaceTarget }
import webgpu.descriptors { DeviceDescriptor, TextureViewDescriptor }
import webgpu_sys.generated_webgpu as flags
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.num.u64
import silk.num.usize

static if Intrinsic.targetArchitecture() == "wasm32" {
  unsafe extern "C" fn hostYield() -> () as "silk_browser#yield"

  /// Lets the page's event loop run, so pending WebGPU promises settle.
  fn pause() -> () {
    unsafe hostYield()
  }
} else {
  fn pause() -> () {}
}

/// The canvas id modules/platform/window's browser backend gives window `handle`'s canvas.
fn canvasId(handle: u32) -> Option<&'static [u8]> {
  return match handle {
    1 => Option<&'static [u8]>.some(b"silk-window-1")
    2 => Option<&'static [u8]>.some(b"silk-window-2")
    3 => Option<&'static [u8]>.some(b"silk-window-3")
    4 => Option<&'static [u8]>.some(b"silk-window-4")
    _ => Option<&'static [u8]>.None
  }
}

/// The canvas of a window past the first, with the size it is configured for.
struct ExtraSurface {
  id: u32,
  surface: Surface<'static>,
  width: u32,
  height: u32,
}

/// The GPU side of the app's windows, on the window host's own thread.
pub struct InlineRenderer {
  instance: Instance,
  device: Device,
  queue: Queue,
  surface: Surface<'static>,
  /// The canvases of the windows past the first. They share the device, the renderer and the
  /// atlas textures with the first.
  others: List<ExtraSurface>,
  nextSurface: u32,
  renderer: UiRenderer,
  textures: GpuAtlas,
  /// The canvas configuration's usage and alpha mode (a configuration borrows the device, so
  /// each resize makes one).
  usage: u64,
  alphaMode: u32,
  infos: List<TextureInfo>,
  textureFormat: u32,
  configuredWidth: u32,
  configuredHeight: u32,
  previousPresented: f64,
  clock: Clock,
  last: RenderReport,
}

impl InlineRenderer {
  /// Makes the GPU device and the surface of the window's canvas `raw`.
  pub effect fn start(raw: RawSurface, window: WindowId, settings: RenderSettings) -> InlineRenderer
    ! GpuError | OutOfMemoryError {
    let handle = match raw {
      RawSurface.Canvas { handle } => handle
      _ => {
        StderrWriter.print("ui-tree: this backend has no canvas surface\n", &())
        fail GpuError.status(0)
      }
    }
    let id = match canvasId(handle) {
      Option<&'static [u8]>.Some { value } => value
      Option<&'static [u8]>.None => {
        StderrWriter.print("ui-tree: window {} has no known canvas id\n", &.(handle))
        fail GpuError.status(0)
      }
    }
    let instance = run Instance.create()
    let target = SurfaceTarget.canvasId(id)
    let surface = run Surface.create(&instance, &target, String.utf8Bytes("ui tree"))
    let mut adapterRequest = run instance.requestAdapterStart(&RequestAdapterOptions.default())
    while !adapterRequest.poll() {
      pause()
    }
    let adapter = run adapterRequest.finish()
    let capabilities = run surface.getCapabilities(&adapter)
    let format = pickFormat(capabilities.formats())
    if format == 0 {
      StderrWriter.print("ui-tree: the canvas offers neither BGRA8 nor RGBA8 unorm\n", &())
      fail GpuError.status(0)
    }
    let mut deviceRequest = run adapter.requestDeviceStart(&DeviceDescriptor.default())
    while !deviceRequest.poll() {
      pause()
    }
    let device = run deviceRequest.finish()
    let queue = run getQueue(&device)
    let mut renderer = run UiRenderer.make(&device, format)
    let mut usage = flags.WGPUTextureUsage_RenderAttachment
    if settings.check {
      usage = flags.WGPUTextureUsage_RenderAttachment | flags.WGPUTextureUsage_CopySrc
      renderer.setTextSettings(TextSettings.none())
    }
    let alphaMode = if capabilities.alphaModes().length != 0 {
      capabilities.alphaModes()[0]
    } else {
      0
    }
    return InlineRenderer {
      instance: move instance,
      device: move device,
      queue: move queue,
      surface: move surface,
      others: List<ExtraSurface>.make(),
      nextSurface: 1,
      renderer: move renderer,
      textures: GpuAtlas.make(),
      usage: usage,
      alphaMode: alphaMode,
      infos: List<TextureInfo>.make(),
      textureFormat: format,
      configuredWidth: 0,
      configuredHeight: 0,
      previousPresented: 0.0,
      clock: Clock.make(),
      last: RenderReport {
        frames: 0,
        painted: 0,
        status: -1,
        upload: 0.0,
        acquire: 0.0,
        draw: 0.0,
        present: 0.0,
        interval: 0.0,
      },
    }
  }

  /// The canvas texture format.
  pub fn format(self: &Self) -> u32 {
    return self.textureFormat
  }

  /// Uploads `uploads`, draws `scene` and presents it before returning. With `compare` set
  /// (check mode) the drawn canvas is read back and compared with the RGBA pixels `expected`;
  /// the result shows in [`InlineRenderer.report`]. `fast` and `fastSeq` are unused: the
  /// browser host scrolls on the UI thread.
  pub effect fn submit(
    self: &mut Self,
    scene: &Scene,
    atlas: &Atlas,
    uploads: &Pending,
    width: u32,
    height: u32,
    compare: bool,
    expected: &[u8],
    fast: FastScroll,
    fastSeq: u64,
  ) -> ()
    ! GpuError | OutOfMemoryError {
    drop fast
    let mut heap = Allocator.systemAllocatorProvider()
    if width == 0 || height == 0 {
      self.last.frames = self.last.frames + 1
      return ()
    }
    if width != self.configuredWidth || height != self.configuredHeight {
      let mut configuration = SurfaceConfiguration.make(
        &self.device,
        self.textureFormat,
        width,
        height,
      )
      configuration.setUsage(self.usage)
      if self.alphaMode != 0 {
        configuration.setAlphaMode(self.alphaMode)
      }
      self.surface.configure(&configuration)
      self.configuredWidth = width
      self.configuredHeight = height
    }
    let start = run self.clock.seconds()
    run self.upload(atlas, uploads) |> Effect.provideMut<Allocator>(&mut heap)
    let uploaded = run self.clock.seconds()
    let texture = run self.surface.getCurrentTexture()
    let view = run texture.texture.createView(&TextureViewDescriptor.default())
    let acquired = run self.clock.seconds()
    run self.renderer.setScrolls(&[]) |> Effect.provideMut<Allocator>(&mut heap)
    run self.renderer.draw(
      &self.device,
      &self.queue,
      scene,
      &self.textures,
      &view,
      width,
      height,
      color.white(),
    )
      |> Effect.provideMut<Allocator>(&mut heap)
    let drawn = run self.clock.seconds()
    let mut status: i32 = -1
    if compare {
      status = run self.checkFrame(&texture.texture, expected, width, height)
        |> Effect.provideMut<Allocator>(&mut heap)
    }
    run self.surface.present()
    run self.device.checkErrors()
    let presented = run self.clock.seconds()
    let previous = self.last
    self.last = RenderReport {
      frames: previous.frames + 1,
      painted: previous.painted + 1,
      status: if status < 0 {
        previous.status
      } else {
        status
      },
      upload: (uploaded - start) * 1000.0,
      acquire: (acquired - uploaded) * 1000.0,
      draw: (drawn - acquired) * 1000.0,
      present: (presented - drawn) * 1000.0,
      interval: if self.previousPresented == 0.0 {
        0.0
      } else {
        (presented - self.previousPresented) * 1000.0
      },
    }
    self.previousPresented = presented
  }

  /// Reads the drawn canvas back and compares it with the CPU reference of the same frame.
  /// Returns 0 within tolerance and 1 outside.
  effect fn checkFrame(
    self: &mut Self,
    surfaceTexture: &Texture,
    expected: &[u8],
    width: u32,
    height: u32,
  ) -> i32
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {
    let buffer = run copyOut(&self.device, &self.queue, surfaceTexture, width, height)
    let mut request = run runtime.mapReadStart(
      &self.device,
      &buffer,
      0,
      readbackSize(width, height),
    )
    while !request.poll() {
      pause()
    }
    let padded = run request.finish()
    let pixels = run unpack(padded.asSlice(), width, height, isBgra(self.textureFormat))
    let result = compare(expected, pixels.asSlice(), width)
    let ok = result.within(Tolerance.frame())
    StderrWriter.print(
      "check: {} x {} canvas, max delta {} at ({}, {}), {} of {} channels over 8, mean {}: {}\n",
      &(
        width,
        height,
        result.max,
        result.worstX,
        result.worstY,
        result.over,
        result.channels,
        result.mean,
        if ok {
          "pass"
        } else {
          "FAIL"
        }
      ),
    )
    return if ok {
      0
    } else {
      1
    }
  }

  /// Brings the atlas textures up to date with `atlas`, and writes the pixels that wait.
  effect fn upload(self: &mut Self, atlas: &Atlas, uploads: &Pending) -> ()
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {
    self.infos.clear()
    let mut t: usize = 0
    while t < atlas.textureCount() {
      run self.infos.append(atlas.texture(t))
      t = t + 1
    }
    run self.textures.syncInfos(&self.device, self.infos.asSlice())
    let list = uploads.entries()
    let mut i: usize = 0
    while i < list.length {
      self.textures.write(&self.queue, list[i].tile, uploads.pixels(list[i]))
      i = i + 1
    }
  }

  /// Makes the surface of another window's canvas `raw`, and returns the number to draw on it
  /// with. `None` when the canvas cannot be a surface: its window then shows nothing.
  pub effect fn openSurface(self: &mut Self, raw: RawSurface, window: WindowId) -> Option<u32>
    ! GpuError | OutOfMemoryError {
    drop window
    let handle = match raw {
      RawSurface.Canvas { handle } => handle
      _ => {
        return Option<u32>.None
      }
    }
    let id = match canvasId(handle) {
      Option<&'static [u8]>.Some { value } => value
      Option<&'static [u8]>.None => {
        StderrWriter.print("ui-tree: window {} has no known canvas id\n", &.(handle))
        return Option<u32>.None
      }
    }
    let target = SurfaceTarget.canvasId(id)
    let created = run Effect.result(
      Surface.create(&self.instance, &target, String.utf8Bytes("ui tree window")),
    )
    let surface = match move created {
      Result.Success { value } => move value
      Result.Failure { error } => {
        drop error
        return Option<u32>.None
      }
    }
    let number = self.nextSurface
    self.nextSurface = self.nextSurface + 1
    let mut heap = Allocator.systemAllocatorProvider()
    run self.others.append(ExtraSurface { id: number, surface: move surface, width: 0, height: 0 })
      |> Effect.provideMut<Allocator>(&mut heap)
    return Option<u32>.some(number)
  }

  /// Draws `scene` on the canvas of another window and presents it before returning.
  pub effect fn submitTo(
    self: &mut Self,
    surface: u32,
    scene: &Scene,
    atlas: &Atlas,
    uploads: &Pending,
    width: u32,
    height: u32,
  ) -> ()
    ! GpuError | OutOfMemoryError {
    let mut heap = Allocator.systemAllocatorProvider()
    let mut at = usize.MAX
    let mut i: usize = 0
    while i < self.others.length() {
      if self.others.asSlice()[i].id == surface {
        at = i
      }
      i = i + 1
    }
    if at == usize.MAX || width == 0 || height == 0 {
      return ()
    }
    run self.upload(atlas, uploads) |> Effect.provideMut<Allocator>(&mut heap)
    let target = &mut self.others.asMutSlice()[at]
    if width != target.width || height != target.height {
      let mut configuration = SurfaceConfiguration.make(
        &self.device,
        self.textureFormat,
        width,
        height,
      )
      configuration.setUsage(self.usage)
      if self.alphaMode != 0 {
        configuration.setAlphaMode(self.alphaMode)
      }
      target.surface.configure(&configuration)
      target.width = width
      target.height = height
    }
    let texture = run target.surface.getCurrentTexture()
    let view = run texture.texture.createView(&TextureViewDescriptor.default())
    run self.renderer.setScrolls(&[]) |> Effect.provideMut<Allocator>(&mut heap)
    run self.renderer.draw(
      &self.device,
      &self.queue,
      scene,
      &self.textures,
      &view,
      width,
      height,
      color.white(),
    )
      |> Effect.provideMut<Allocator>(&mut heap)
    run target.surface.present()
    run self.device.checkErrors()
  }

  /// Lets go of another window's canvas.
  pub fn closeSurface(self: &mut Self, surface: u32) -> () {
    let mut i: usize = 0
    while i < self.others.length() {
      if self.others.asSlice()[i].id == surface {
        let leaving = self.others.remove(i)
        leaving.surface.unconfigure()
        drop leaving
      } else {
        i = i + 1
      }
    }
  }

  /// What the last frame took.
  pub fn report(self: &Self) -> RenderReport {
    return self.last
  }

  /// Every frame is presented inside `submit`, so this returns the report at once.
  pub effect fn waitFrames(self: &mut Self, frames: u64) -> RenderReport
    ! GpuError {
    return self.last
  }

  /// Releases the canvas configuration.
  pub fn stop(self: &mut Self) -> () {
    self.surface.unconfigure()
  }
}
