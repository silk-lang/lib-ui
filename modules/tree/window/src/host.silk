//! Native GPU window lifecycle for any retained-tree client.
//! Implement WindowClient to handle events and supply mutations. The host owns the window,
//! GPU surface, input integration, accessibility publication, inspection, and frame scheduling.
//!
//! The first root is the window `runWindow` opens. Every other root the client opens gets an
//! OS window of its own, drawn by the same render thread on a surface of its own: the host
//! opens it when the root opens, applies the title and size of an `UpdateRoot`, and closes it
//! when the root closes. Its events reach its root (`beginAt`, `reportRoot`); a request to
//! close it is only a `CloseRequested` root event, which the client answers or not. Such a
//! window is framed only when its root needs a frame (`needsFrameOf`), has no compositor
//! scrolling and publishes no accessibility tree.
//!
//! `runWindowWith` also runs a [`Companion`] beside the client, in the same tree, on roots of
//! its own: the host hands it the input, records and frames of those roots, every key first,
//! and the inspector. Its root shows in a window of its own, or docked in the first window, the
//! client's first root then laid out in the rest (see `companion.silk`).
import ui_scene.scene { Scene }
import ui_tree.inspect { findAll }
import ui_tree.legacy { UiTree, TreeError, FrameInput, CpuSnapshot, Mutation }
import lib { toInput, windowCursor, HostState, serve, coalesce }
import adapter { fastScrollOf, reportWindow, reportWindowOf, serveInput }
import ui_tree.lib { RootSupport, RootEventKind, ExtraRoot, RootOptions }
import ui_tree.mutation { FIRST_ROOT }
import render_thread { FastScroll, FastScrolled, RenderSettings }
import companion { Companion, Dock, NoCompanion, dockTarget, pointed }

static if Intrinsic.targetArchitecture() == "wasm32" {
  // No threads in the browser: frames are drawn on this thread (render_inline.silk).
  import render_inline { InlineRenderer as RenderThread }
} else {
  import render_thread { RenderThread }
}

import platform_thread { HostPlatform, Launched }
import vector.pixmap { Pixmap }
import ui_inspect_server.lib { Inspector, InspectorOptions }
import silk.core.result { Result }
import silk.system.host_input { HostInput, HostInputError }
import font_collection.lib { FontCollection }
import atlas.atlas { AtlasError }
import vector.geometry_error { GeometryError }
import ui_scene.color as color
import window.event { Event }
import window.native { NativePlatform }
// Interface methods resolve through this import; silk#2819 reports it as unused.
import window.platform { Platform as _Platform }
import window.types { Wait, WindowError, WindowId, WindowOptions }
import webgpu.runtime { GpuError }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
