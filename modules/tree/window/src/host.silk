/// Client lifecycle hooks for the native tree host. Default hooks draw an ordinary tree.
pub interface WindowClient<S, E, ? R> {
  /// Initializes resources before the first view and configures native window options.
  effect fn setup(self: &mut Self, state: &mut S, tree: &mut UiTree<'_>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {}

  /// Sets platform window options before the window opens.
  fn configure(self: &Self, state: &S, options: &mut WindowOptions<'_>) -> () {}

  /// Receives the new native window before the GPU is initialized.
  effect fn opened(
    self: &mut Self,
    state: &mut S,
    platform: &mut HostPlatform,
    window: WindowId,
  ) -> ()
    ! WindowError | OutOfMemoryError
    ? &mut Allocator {}

  /// Native menus and dialogs; true consumes the event before ordinary input dispatch.
  /// Handles native events before the tree adapter; true consumes the event.
  effect fn event(self: &mut Self, state: &mut S, tree: &mut UiTree<'_>, event: &Event) -> bool
    ! WindowError | TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    return false
  }

  /// Updates native window state after input; true requests a frame.
  effect fn update(
    self: &mut Self,
    state: &mut S,
    tree: &mut UiTree<'_>,
    platform: &mut HostPlatform,
    window: WindowId,
  ) -> bool
    ! WindowError | TreeError | OutOfMemoryError
    ? &mut Allocator {
    return false
  }

  /// Return false to keep the window open, for example when a document save fails.
  effect fn closing(self: &mut Self, state: &mut S) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    return true
  }

  /// Returns whether tree or client changes require another frame.
  fn needsFrame(self: &Self, state: &S, tree: &UiTree<'_>) -> bool {
    return tree.needsFrame()
  }

  /// Applies pending client changes before tree layout.
  effect fn prepare(self: &mut Self, state: &mut S, tree: &mut UiTree<'_>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {}

  /// Returns whether the host prints CPU frame timings.
  fn profile(self: &Self, state: &S) -> bool {
    return false
  }

  /// Collects background work before waiting for events; true requests a frame.
  effect fn poll(self: &mut Self, state: &mut S, tree: &mut UiTree<'_>, time: f64) -> bool
    ! WindowError | TreeError | OutOfMemoryError
    ? &mut Allocator {
    return false
  }

  /// A maximum wait in seconds while work needs polling, or None to wait for ordinary events.
  fn wakeAfter(self: &Self, state: &S) -> Option<f64> {
    return Option<f64>.None
  }

  /// Whether the client asked to close the window: the loop ends without asking `closing`.
  fn quitting(self: &Self, state: &S) -> bool {
    return false
  }

  /// Prepares optional custom scene content after tree layout and before upload.
  effect fn frame(
    self: &mut Self,
    state: &mut S,
    tree: &mut UiTree<'_>,
    input: FrameInput,
    inspector: &Inspector,
  ) -> ()
    ! TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {}

  /// Returns the completed tree scene or a client composition.
  fn scene<'s>(self: &'s Self, state: &'s S, tree: &'s UiTree<'_>) -> &'s Scene {
    return tree.scene()
  }

  /// Tells a served inspector what the tree cannot: the program behind it. The host calls it
  /// before `start` and then on every turn of its loop, only while the inspector is on.
  effect fn report(self: &mut Self, state: &mut S, inspector: &mut Inspector) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {}

  /// Initializes client nodes after the host applies resource definitions.
  effect fn start(self: &mut Self, state: &mut S, tree: &mut UiTree<'_>) -> ()
    ! E | TreeError | OutOfMemoryError
    ? R | &mut Allocator {}

  /// Delivers queued tree events and reconciles client nodes.
  effect fn pump(self: &mut Self, state: &mut S, tree: &mut UiTree<'_>) -> ()
    ! E | TreeError | OutOfMemoryError
    ? R | &mut Allocator {}

  /// Delivers the record of an input before the tree runs its default action (focus,
  /// scrolling, what a key does), and returns whether a handler prevented that default. The
  /// host calls it between `tree.begin` and `tree.finish`. A client with no say pumps and
  /// prevents nothing.
  effect fn decide(self: &mut Self, state: &mut S, tree: &mut UiTree<'_>) -> bool
    ! E | TreeError | OutOfMemoryError
    ? R | &mut Allocator {
    run self.pump(&mut state, &mut tree)
    return false
  }

  /// Advances client timers and optional animation subscriptions.
  effect fn tick(
    self: &mut Self,
    state: &mut S,
    tree: &mut UiTree<'_>,
    time: f64,
    animation: bool,
  ) -> ()
    ! E | TreeError | OutOfMemoryError
    ? R | &mut Allocator {}

  /// Updates the client's logical viewport size.
  effect fn resize(
    self: &mut Self,
    state: &mut S,
    tree: &mut UiTree<'_>,
    width: f32,
    height: f32,
  ) -> ()
    ! E | TreeError | OutOfMemoryError
    ? R | &mut Allocator {}

  /// Lays out and paints the tree. Virtual-list clients reconcile requested ranges here.
  effect fn layout(self: &mut Self, state: &mut S, tree: &mut UiTree<'_>, input: FrameInput) -> ()
    ! E | TreeError | OutOfMemoryError
    ? R | &mut Allocator {
    run tree.frame(input)
  }

  /// Lays out and paints root `root`, a root past the first, for its own window.
  effect fn layoutRoot(
    self: &mut Self,
    state: &mut S,
    tree: &mut UiTree<'_>,
    root: u32,
    input: FrameInput,
  ) -> ()
    ! E | TreeError | OutOfMemoryError
    ? R | &mut Allocator {
    run tree.frameRoot(root, input)
  }

  /// Returns the next timer deadline in host monotonic seconds, or None.
  fn nextDeadline(self: &Self, state: &S) -> Option<f64> {
    return Option<f64>.None
  }

  /// Returns whether the client needs continuous animation frames.
  fn wantsFrames(self: &Self, state: &S) -> bool {
    return false
  }

  /// Runs the input sequence used by the host's rendering check.
  effect fn checkInput(
    self: &mut Self,
    state: &mut S,
    tree: &mut UiTree<'_>,
    input: FrameInput,
    name: string,
  ) -> ()
    ! E | TreeError | OutOfMemoryError
    ? R | &mut Allocator {
    run self.layout(&mut state, &mut tree, input)
    let mut found = List<u32>.make()
    run findAll(&tree, name, &mut found)
    if found.length() > 0 {
      if let Option<NodeInfo>.Some { value } = run info(&tree, found.get(0)) {
        let x = (value.bounds.xMin + value.bounds.xMax) * 0.5
        let y = (value.bounds.yMin + value.bounds.yMax) * 0.5
        run tree.dispatch(Input.PointerMove { x: x, y: y, modifiers: 0 })
        run self.pump(&mut state, &mut tree)
        run self.layout(&mut state, &mut tree, input)
        run tree.dispatch(
          Input.PointerDown { x: x, y: y, button: BUTTON_PRIMARY, modifiers: 0, clickCount: 1 },
        )
        run self.pump(&mut state, &mut tree)
        run self.layout(&mut state, &mut tree, input)
        run tree.dispatch(Input.PointerUp { x: x, y: y, button: BUTTON_PRIMARY, modifiers: 0 })
        run self.pump(&mut state, &mut tree)
      }
    }
    run self.layout(&mut state, &mut tree, input)
    run tree.dispatch(
      Input.KeyDown {
        key: run String.copy("Tab"),
        code: run String.copy("Tab"),
        modifiers: 0,
        repeat: false,
      },
    )
    run self.pump(&mut state, &mut tree)
    run tree.dispatch(
      Input.KeyUp { key: run String.copy("Tab"), code: run String.copy("Tab"), modifiers: 0 },
    )
    run self.pump(&mut state, &mut tree)
  }
}

/// How to open the window.
pub struct RunOptions {
  /// Native window title.
  pub title: string<'static>,
  /// The content size in logical points (CSS pixels).
  pub width: f64,
  /// Initial content height in logical pixels.
  pub height: f64,
  /// Script and check the frame instead of taking input (see the module documentation).
  pub check: bool,
  /// The test id, label or text of the node `check` clicks.
  pub checkClick: string<'static>,
  /// The test id, label or text of a node that must exist after the click.
  pub checkExpect: string<'static>,
  /// Wait on this thread until each frame is presented, for apps that want the lowest latency
  /// between input and pixels (games, drawing) over input that never waits for the display.
  /// Frames are drawn on the render thread either way.
  pub lowestLatency: bool,
  /// The platform thread of an app started with `platform_thread.launch`, or None to run the
  /// platform on this thread.
  pub platform: Option<Launched>,
}

/// The frame `check` reads back: the scripted input goes in after frame 1.
const CHECK_FRAME: u64 = 3

fn deviceSize(logical: f64, scale: f64) -> u32 {
  return f64.toU32(f64.floor(logical * scale + 0.5))
}

/// Seconds on the monotonic clock.
effect fn seconds(clock: &mut Clock) -> f64 {
  return run clock.seconds()
}

/// The window of a root past the first.
struct RootWindow {
  root: u32,
  window: WindowId,
  /// Its surface on the render thread.
  surface: u32,
  width: f64,
  height: f64,
  scale: f64,
  /// The title and size it was opened or last set with, to tell what an `UpdateRoot` changed.
  title: String,
  size: Option<Size2<f32>>,
  host: HostState,
}

/// A window's size when its root asks for none, in logical points.
const OTHER_WIDTH: f64 = 480.0

const OTHER_HEIGHT: f64 = 360.0

/// The window of `windows` with id `window`, or `usize.MAX`.
fn windowAt(windows: &List<RootWindow>, window: u32) -> usize {
  let list = windows.asSlice()
  let mut i: usize = 0
  while i < list.length {
    if list[i].window.value == window {
      return i
    }
    i = i + 1
  }
  return usize.MAX
}

/// The window an event is about, or 0 for one about the app (a menu, a dialog, appearance).
fn windowOf(event: &Event) -> u32 {
  return match &event.* {
    Event.RequestFrame { window, .. } => window.value
    Event.Resized { window, .. } => window.value
    Event.ScaleFactorChanged { window, .. } => window.value
    Event.Moved { window, .. } => window.value
    Event.Focused { window, .. } => window.value
    Event.Occluded { window, .. } => window.value
    Event.CloseRequested { window } => window.value
    Event.FullScreenChanged { window, .. } => window.value
    Event.KeyDown { window, .. } => window.value
    Event.KeyUp { window, .. } => window.value
    Event.ModifiersChanged { window, .. } => window.value
    Event.TextInput { window, .. } => window.value
    Event.ImePreedit { window, .. } => window.value
    Event.MouseMoved { window, .. } => window.value
    Event.MouseDown { window, .. } => window.value
    Event.MouseUp { window, .. } => window.value
    Event.MouseEntered { window, .. } => window.value
    Event.MouseExited { window } => window.value
    Event.Scroll { window, .. } => window.value
    Event.Pinch { window, .. } => window.value
    _ => 0
  }
}

/// Opens a window for each root past the first that opened since, applies the title and size
/// of the ones that changed, and closes the windows of the roots that closed. A root whose
/// window cannot open is closed again and hears `Failed`. Root `docked` (a companion's, or
/// NONE) is drawn in the first window and has none. Returns whether a root event was reported,
/// for the client to hear.
effect fn syncWindows(
  tree: &mut UiTree<'_>,
  platform: &mut HostPlatform,
  renderer: &mut RenderThread,
  windows: &mut List<RootWindow>,
  docked: u32,
) -> bool
  ! GpuError | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut reported = false
  let mut open = List<u32>.make()
  run tree.openRoots(&mut open)

  // Closed roots first: their windows go.
  let mut w: usize = 0
  while w < windows.length() {
    let root = windows.asSlice()[w].root
    if contains(&open, root) && root != docked {
      w = w + 1
    } else {
      let gone = windows.remove(w)
      renderer.closeSurface(gone.surface)
      platform.closeWindow(gone.window)
    }
  }
  let roots = open.asSlice()
  let mut i: usize = 0
  while i < roots.length {
    let root = roots[i]
    i = i + 1
    if root == FIRST_ROOT || root == docked {
      continue
    }
    let mut title = String.make()
    let mut size = Option<Size2<f32>>.None
    let mut resizable = true
    if let Option<&RootOptions>.Some { value } = tree.rootOptions(root) {
      title = run String.copy(String.view(&value.title))
      size = value.size
      resizable = value.resizable
    }
    let mut at: usize = usize.MAX
    let mut k: usize = 0
    while k < windows.length() {
      if windows.asSlice()[k].root == root {
        at = k
      }
      k = k + 1
    }
    if at != usize.MAX {
      let shown = &mut windows.asMutSlice()[at]
      if String.view(&shown.title) != String.view(&title) {
        run platform.setTitle(shown.window, String.view(&title))
        shown.title = move title
      }
      if !sameSize(shown.size, size) {
        if let Option<Size2<f32>>.Some { value } = size {
          platform.setContentSize(
            shown.window,
            Size2<f64>.new(f32.toF64(value.width), f32.toF64(value.height)),
          )
        }
        shown.size = size
      }
      continue
    }
    let mut options = match size {
      Option<Size2<f32>>.Some { value } => WindowOptions.make(
        String.view(&title),
        f32.toF64(value.width),
        f32.toF64(value.height),
      )
      Option<Size2<f32>>.None => WindowOptions.make(String.view(&title), OTHER_WIDTH, OTHER_HEIGHT)
    }
    options.resizable = resizable
    let opened = run Effect.result(platform.openWindow(&options))
    let window = match move opened {
      Result.Success { value } => value
      Result.Failure { error } => match move error {
        WindowError failure => {
          drop failure
          run failRoot(&mut tree, root)
          reported = true
          continue
        }
        OutOfMemoryError failure => {
          fail move failure
        }
      }
    }
    let surface = match run renderer.openSurface(platform.rawSurface(window), window) {
      Option<u32>.Some { value } => value
      Option<u32>.None => {
        platform.closeWindow(window)
        run failRoot(&mut tree, root)
        reported = true
        continue
      }
    }
    let content = platform.contentSize(window)
    run windows.append(
      RootWindow {
        root: root,
        window: window,
        surface: surface,
        width: content.width,
        height: content.height,
        scale: platform.scaleFactor(window),
        title: move title,
        size: size,
        host: HostState.make(),
      },
    )
    run tree.reportRoot(
      root,
      RootEventKind.Resized { width: f64.toF32(content.width), height: f64.toF32(content.height) },
    )
    reported = true
    platform.requestFrame(window)
  }
  return reported
}

/// Closes root `root`, whose window could not open, and tells the client.
effect fn failRoot(tree: &mut UiTree<'_>, root: u32) -> ()
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut batch = List<Mutation>.make()
  run batch.append(Mutation.CloseRoot { root: root })
  run tree.apply(move batch)
  run tree.reportRoot(root, RootEventKind.Failed)
}

fn sameSize(a: Option<Size2<f32>>, b: Option<Size2<f32>>) -> bool {
  return match a {
    Option<Size2<f32>>.Some { value: x } => match b {
      Option<Size2<f32>>.Some { value: y } => x.width == y.width && x.height == y.height
      Option<Size2<f32>>.None => false
    }
    Option<Size2<f32>>.None => b.isNone()
  }
}

fn contains(list: &List<u32>, value: u32) -> bool {
  let values = list.asSlice()
  let mut i: usize = 0
  while i < values.length {
    if values[i] == value {
      return true
    }
    i = i + 1
  }
  return false
}

/// Handles `event` for the window of a root past the first: frames it, reports what happened
/// to it as root events, and feeds its input to its root. A companion's root is the
/// companion's to frame and answer.
effect fn otherEvent<H: WindowClient<S, E, R>, K: Companion, S, E, ? R>(
  state: &mut S,
  tree: &mut UiTree<'_>,
  content: &mut H,
  companion: &mut K,
  inspector: &mut Inspector,
  platform: &mut HostPlatform,
  renderer: &mut RenderThread,
  snapshot: &mut CpuSnapshot,
  shown: &mut RootWindow,
  event: &Event,
  time: f64,
) -> ()
  ! E | GpuError | TreeError | OutOfMemoryError
  ? R | &mut Allocator {
  let root = shown.root
  let theirs = companion.owns(root)
  run reportWindowOf(&mut tree, root, event)
  match &event.* {
    Event.RequestFrame { targetTime, .. } => {
      let width = deviceSize(shown.width, shown.scale)
      let height = deviceSize(shown.height, shown.scale)
      if width == 0 || height == 0 {
        return ()
      }
      let input = FrameInput {
        width: f64.toF32(shown.width),
        height: f64.toF32(shown.height),
        scale: f64.toF32(shown.scale),
        time: targetTime,
      }
      if theirs {
        run companion.layout(&mut tree, &mut inspector, root, input)
      } else {
        run content.layoutRoot(&mut state, &mut tree, root, input)
      }
      drop run tree.useRoot(root)
      run serveInput(&mut platform, shown.window, &mut tree, &mut shown.host)
      run snapshot.copyUploads(&tree)
      run renderer.submitTo(
        shown.surface,
        tree.scene(),
        &tree.atlas,
        tree.pendingUploads(),
        width,
        height,
      )
      tree.clearUploads()
      run pumpOwner(
        &mut state,
        &mut tree,
        &mut content,
        &mut companion,
        &mut inspector,
        theirs,
        time,
      )
      platform.setCursor(shown.window, windowCursor(tree.cursor()))
    }
    Event.Resized { size, scaleFactor, .. } => {
      shown.width = size.width
      shown.height = size.height
      shown.scale = scaleFactor
      run pumpOwner(
        &mut state,
        &mut tree,
        &mut content,
        &mut companion,
        &mut inspector,
        theirs,
        time,
      )
      platform.requestFrame(shown.window)
    }
    Event.ScaleFactorChanged { scaleFactor, .. } => {
      shown.scale = scaleFactor
      run pumpOwner(
        &mut state,
        &mut tree,
        &mut content,
        &mut companion,
        &mut inspector,
        theirs,
        time,
      )
      platform.requestFrame(shown.window)
    }
    Event.CloseRequested { .. } => {
      // The window stays until its owner closes its root.
      run pumpOwner(
        &mut state,
        &mut tree,
        &mut content,
        &mut companion,
        &mut inspector,
        theirs,
        time,
      )
    }
    _ => {
      if let Option<Input>.Some { value: input } = run toInput(event) {
        if keyInput(&input) && run companion.key(&mut tree, &mut inspector, &input) {
          return ()
        }
        run tree.beginAt(root, &input)

        // Keys go to the key root, which may be another window's.
        let into = tree.current
        let mine = companion.owns(into)
        let prevented = if mine {
          run companion.decide(&mut tree, &mut inspector)
        } else {
          run content.decide(&mut state, &mut tree)
        }
        run tree.finish(move input, prevented)
        drop run tree.useRoot(root)
        run serveInput(&mut platform, shown.window, &mut tree, &mut shown.host)
        run pumpOwner(
          &mut state,
          &mut tree,
          &mut content,
          &mut companion,
          &mut inspector,
          mine,
          time,
        )
        drop run tree.useRoot(root)
        platform.setCursor(shown.window, windowCursor(tree.cursor()))
      } else {
        match &event.* {
          Event.Focused { .. } => run pumpOwner(
            &mut state,
            &mut tree,
            &mut content,
            &mut companion,
            &mut inspector,
            theirs,
            time,
          )
          _ => {}
        }
      }
    }
  }
}

/// Pumps the companion when `theirs`, else the client.
effect fn pumpOwner<H: WindowClient<S, E, R>, K: Companion, S, E, ? R>(
  state: &mut S,
  tree: &mut UiTree<'_>,
  content: &mut H,
  companion: &mut K,
  inspector: &mut Inspector,
  theirs: bool,
  time: f64,
) -> ()
  ! E | TreeError | OutOfMemoryError
  ? R | &mut Allocator {
  if theirs {
    drop run companion.pump(&mut tree, &mut inspector, time)
  } else {
    run content.pump(&mut state, &mut tree)
  }
}

/// Whether `input` is a key press or release, which a companion sees first.
fn keyInput(input: &Input) -> bool {
  return match &input.* {
    Input.KeyDown { .. } => true
    Input.KeyUp { .. } => true
    _ => false
  }
}

/// The part of a first window of `width` by `height` the client's first root has: all of it,
/// or what `dock` leaves.
fn clientSize(width: f64, height: f64, dock: &Option<Dock>) -> Size2<f64> {
  return match &dock.* {
    Option<Dock>.Some { value } => {
      let w = if value.area.xMin > 0.0 {
        f64.min(width, f32.toF64(value.area.xMin))
      } else {
        width
      }
      let h = if value.area.yMin > 0.0 {
        f64.min(height, f32.toF64(value.area.yMin))
      } else {
        height
      }
      Size2<f64>.new(w, h)
    }
    Option<Dock>.None => Size2<f64>.new(width, height)
  }
}

fn dockRoot(dock: &Option<Dock>) -> u32 {
  return match &dock.* {
    Option<Dock>.Some { value } => value.root
    Option<Dock>.None => NONE
  }
}

fn sameDock(a: &Option<Dock>, b: &Option<Dock>) -> bool {
  return match &a.* {
    Option<Dock>.Some { value: x } => match &b.* {
      Option<Dock>.Some { value: y } => x.root == y.root && x.area.xMin == y.area.xMin
        && x.area.yMin == y.area.yMin
        && x.area.xMax == y.area.xMax
        && x.area.yMax == y.area.yMax
      Option<Dock>.None => false
    }
    Option<Dock>.None => b.isNone()
  }
}

/// Whether a node's test id, label or text is `value`.
effect fn exists(tree: &UiTree<'_>, value: string) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut found = List<u32>.make()
  run findAll(tree, value, &mut found)
  return found.length() != 0
}

/// Runs a retained-tree client until close or until the scripted rendering check completes.
/// Resource mutations apply before `start`. No ui-app runtime or view builder is required.
pub effect fn runWindow<H: WindowClient<S, E, R>, S, E, ? R>(
  state: &mut S,
  collection: &FontCollection,
  resources: List<Mutation>,
  options: RunOptions,
  inspector: Inspector,
  content: &mut H,
) -> i32
  ! E | WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? R | &mut Allocator {
  let mut none = NoCompanion {}
  return run runWindowWith<H, NoCompanion, S, E, R>(
    &mut state,
    collection,
    move resources,
    move options,
    move inspector,
    &mut content,
    &mut none,
  )
}

/// [`runWindow`] with `companion` beside the client, in the same tree (see `companion.silk`).
/// Check mode runs no companion.
pub effect fn runWindowWith<H: WindowClient<S, E, R>, K: Companion, S, E, ? R>(
  state: &mut S,
  collection: &FontCollection,
  resources: List<Mutation>,
  options: RunOptions,
  inspector: Inspector,
  content: &mut H,
  companion: &mut K,
) -> i32
  ! E | WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? R | &mut Allocator {
  let check = options.check
  let mut inspector = if check {
    drop inspector
    Inspector.off()
  } else {
    move inspector
  }
  inspector.deferInput()
  let mut clock = Clock.make()
  let started = run seconds(&mut clock)
  // SILK_UI_TRACE_FRAMES prints a line on standard error as each frame is presented, for
  // benchmarks that time startup and input to pixels from outside the process.
  let tracing = !check && (run environmentVariable("SILK_UI_TRACE_FRAMES")).isSome()
  if tracing {
    StderrWriter.print("silk-ui: host started\n", &())
  }
  let mut tree = run UiTree.make(collection)

  // A window per root. In the browser a window is a canvas, and the renderer knows the
  // canvases of four.
  static if Intrinsic.targetArchitecture() == "wasm32" {
    tree.rootSupport = RootSupport { count: 4, extra: ExtraRoot.Window }
  } else {
    tree.rootSupport = RootSupport { count: u32.MAX, extra: ExtraRoot.Window }
  }
  run content.setup(&mut state, &mut tree)
  run tree.apply(move resources)
  if inspector.enabled() {
    run content.report(&mut state, &mut inspector)
  }
  run content.start(&mut state, &mut tree)
  if !check {
    run companion.attach(&mut tree, &mut inspector)
  }
  let mut snapshot = CpuSnapshot.make()

  let mut options = move options
  let launched = Intrinsic.replace(options.platform, Option<Launched>.None)
  let mut platform = match move launched {
    Option<Launched>.Some { value } => HostPlatform.proxied(move value)
    Option<Launched>.None => HostPlatform.direct(run NativePlatform.start())
  }
  let mut windowOptions = WindowOptions.make(options.title, options.width, options.height)
  windowOptions.minSize = Option<Size2<f64>>.some(Size2<f64>.new(240.0, 200.0))
  content.configure(&state.*, &mut windowOptions)
  let window = run platform.openWindow(&windowOptions)
  let owner = window
  if tracing {
    StderrWriter.print("silk-ui: window open\n", &())
  }
  run content.opened(&mut state, &mut platform, owner)

  // What `start` asked of the window before there was one.
  if !check && run content.update(&mut state, &mut tree, &mut platform, owner) {
    platform.requestFrame(owner)
  }

  // A request line for the inspector ends the wait for the next event, as a post does.
  run inspector.wakeWith(platform.nudge())
  let mut host = HostState.of(&platform)
  let raw = platform.rawSurface(window)

  // The GPU lives on the render thread; frames go there as copies (see render_thread.silk).
  let mut renderer = run RenderThread.start(raw, owner, RenderSettings { check: check })
  if tracing {
    StderrWriter.print("silk-ui: gpu ready\n", &())
  }

  // With a platform thread, wheels scroll the frame on screen at once (render_thread.silk);
  // the tree takes the offsets on its next pass.
  let compositing = platform.threaded() && !check
  static if Intrinsic.targetArchitecture() != "wasm32" {
    if compositing {
      platform.setCompositor(renderer.compositor())
    }
  }
  let mut fastScrolls = List<FastScrolled>.make()
  let mut fastSeq: u64 = 0

  let initial = platform.contentSize(window)
  let mut width = initial.width
  let mut height = initial.height
  let mut scale = platform.scaleFactor(window)

  // The companion's root docked in this window, if one is: the client has the rest of it. The
  // pointer is in one of the two, and a press keeps going to the one it began in.
  let mut dock = if check {
    Option<Dock>.None
  } else {
    companion.dock(f64.toF32(width), f64.toF32(height))
  }
  let mut pointerIn = FIRST_ROOT
  let mut pressIn = NONE
  let mut composed = Scene.make()

  // The windows of the roots past the first, with those `start` opened.
  let mut others = List<RootWindow>.make()
  if run syncWindows(&mut tree, &mut platform, &mut renderer, &mut others, dockRoot(&dock)) {
    run content.pump(&mut state, &mut tree)
  }
  let mut drawn: u64 = 0
  let mut status: i32 = 0
  let mut backlog = List<Event>.make()
  let first = clientSize(width, height, &dock)
  run content.resize(&mut state, &mut tree, f64.toF32(first.width), f64.toF32(first.height))
  platform.requestFrame(owner)
  while true {
    // The first root is current but while a window of another root is served.
    drop run tree.useRoot(FIRST_ROOT)

    // Wait for input or a frame, at most until the next timer.
    let now = (run seconds(&mut clock)) - started
    let backgroundChanged = run content.poll(&mut state, &mut tree, now)
    if backgroundChanged {
      platform.requestFrame(owner)
    }
    if !check && content.quitting(&state.*) {
      break
    }
    let wait = if check {
      Wait.Seconds { seconds: 0.016 }
    } else {
      let mut deadline = match content.nextDeadline(&state.*) {
        Option<f64>.Some { value } => if value > now {
          value - now
        } else {
          0.0
        }
        Option<f64>.None => -1.0
      }
      if let Option<f64>.Some { value } = content.wakeAfter(&state.*) {
        if deadline < 0.0 || value < deadline {
          deadline = f64.max(0.0, value)
        }
      }
      if let Option<f64>.Some { value } = companion.nextDeadline() {
        let due = f64.max(0.0, value - now)
        if deadline < 0.0 || due < deadline {
          deadline = due
        }
      }
      match inspector.pollInterval() {
        Option<f64>.Some { value } => Wait.Seconds {
          seconds: if deadline >= 0.0 && deadline < value {
            deadline
          } else {
            value
          },
        }
        Option<f64>.None => if deadline >= 0.0 {
          Wait.Seconds { seconds: deadline }
        } else {
          Wait.Forever
        }
      }
    }
    let mut next = if backlog.length() != 0 {
      Option<Event>.some(backlog.remove(0))
    } else {
      run platform.nextEvent(wait)
    }
    if !check {
      let taken = move next
      next = match move taken {
        Option<Event>.Some { value } => Option<Event>.some(
          run coalesce(&mut platform, move value, &mut backlog),
        )
        Option<Event>.None => Option<Event>.None
      }
    }
    if compositing {
      run platform.takeFastScrolls(&mut fastScrolls)
      if fastScrolls.length() != 0 {
        let list = fastScrolls.asSlice()
        let s = f64.toF32(scale)
        let mut f: usize = 0
        while f < list.length {
          run tree.scrolledElsewhere(list[f].node, list[f].x / s, list[f].y / s)
          if list[f].seq > fastSeq {
            fastSeq = list[f].seq
          }
          f = f + 1
        }
        fastScrolls.clear()
        run content.pump(&mut state, &mut tree)
        platform.requestFrame(owner)
      }
    }
    let time = (run seconds(&mut clock)) - started
    if check && next.isNone() {
      next = Option<Event>.some(Event.RequestFrame { window: owner, targetTime: time })
    }
    let mut redraw = backgroundChanged
    if !check {
      run content.tick(&mut state, &mut tree, time, false)
      redraw = content.needsFrame(&state.*, &tree)
    }
    if inspector.enabled() {
      run content.report(&mut state, &mut inspector)
    }
    if run inspector.poll(&mut tree) {
      while true {
        // Input from the inspector is answered like window input: the client decides
        // between the records and the default action.
        if run inspector.beginNext(&mut tree) {
          run inspector.observe(&tree)
          let prevented = run content.decide(&mut state, &mut tree)
          run inspector.finishNext(&mut tree, prevented)
        }
        run serve(&mut platform, owner, &mut tree, &mut host)
        run inspector.observe(&tree)
        run content.pump(&mut state, &mut tree)
        if !inspector.hasInput() {
          break
        }
      }
      platform.setCursor(owner, windowCursor(tree.cursor()))
      redraw = true
    }
    let about = match &next {
      Option<Event>.Some { value } => windowOf(&value)
      Option<Event>.None => 0
    }
    let other = windowAt(&others, about)
    if about != 0 && about != owner.value && other == usize.MAX {
      // An event a closed window sent before it went: nobody's.
      drop Intrinsic.replace(next, Option<Event>.None)
    } else if other != usize.MAX {
      if let Option<Event>.Some { value } = &next {
        let shown = &mut others.asMutSlice()[other]
        run otherEvent(
          &mut state,
          &mut tree,
          &mut content,
          &mut companion,
          &mut inspector,
          &mut platform,
          &mut renderer,
          &mut snapshot,
          &mut shown,
          &value,
          time,
        )
      }
      drop run tree.useRoot(FIRST_ROOT)
      if !check {
        redraw = redraw || content.needsFrame(&state.*, &tree)
      }
    } else if let Option<Event>.Some { value } = &next {
      let mut resized = false
      let keyed = tree.keyRoot
      run reportWindow(&mut tree, &value)
      if let Event.Focused { focused, .. } = &value {
        // The window has the keyboard again: the dock keeps it if it had it.
        if focused && keyed == dockRoot(&dock) {
          run tree.reportRoot(keyed, RootEventKind.Focused)
        }
      }
      if let Event.AppearanceChanged { .. } = &value {
        // Every window shows in the one appearance.
        let list = others.asSlice()
        let mut o: usize = 0
        while o < list.length {
          run reportWindowOf(&mut tree, list[o].root, &value)
          o = o + 1
        }
      }
      if !check && run content.event(&mut state, &mut tree, &value) {
        redraw = true
      } else {
        match &value {
          Event.RequestFrame { targetTime, .. } => {
            if deviceSize(width, scale) > 0 && deviceSize(height, scale) > 0 {
              let area = clientSize(width, height, &dock)
              let viewport = FrameInput {
                width: f64.toF32(area.width),
                height: f64.toF32(area.height),
                scale: f64.toF32(scale),
                time: targetTime,
              }
              if check && drawn == 1 {
                run content.checkInput(&mut state, &mut tree, viewport, options.checkClick)
              }
              if !check && content.wantsFrames(&state.*) {
                run content.tick(&mut state, &mut tree, time, true)
              }
              let frameStart = run seconds(&mut clock)
              run content.prepare(&mut state, &mut tree)

              // Publish accessibility geometry after virtual rows have settled.
              run content.layout(&mut state, &mut tree, viewport)
              let layoutEnd = run seconds(&mut clock)
              run content.frame(&mut state, &mut tree, viewport, &inspector)
              let canvasEnd = run seconds(&mut clock)
              inspector.timed(
                f64.toF32((layoutEnd - frameStart) * 1000.0),
                f64.toF32((canvasEnd - layoutEnd) * 1000.0),
              )
              if let Option<Dock>.Some { value: docked } = dock {
                // The dock is laid out at the whole window's size, over the client's root.
                let whole = FrameInput {
                  width: f64.toF32(width),
                  height: f64.toF32(height),
                  scale: f64.toF32(scale),
                  time: targetTime,
                }
                run companion.layout(&mut tree, &mut inspector, docked.root, whole)
                drop run tree.useRoot(FIRST_ROOT)
              }
              run serve(&mut platform, owner, &mut tree, &mut host)
              run inspector.afterFrameScene(&tree, content.scene(&state.*, &tree))
              if let Option<Dock>.Some { value: docked } = dock {
                composed.clear()
                run composed.replay(
                  inspector.sceneWith(content.scene(&state.*, &tree)),
                  0,
                  usize.MAX,
                )
                run composed.replay(tree.sceneOf(docked.root), 0, usize.MAX)
                run composed.finish()
              }
              run snapshot.copyUploads(&tree)
              let deviceWidth = deviceSize(width, scale)
              let deviceHeight = deviceSize(height, scale)
              let checked = check && drawn + 1 == CHECK_FRAME
              if checked && !(run exists(&tree, options.checkExpect)) {
                StderrWriter.print("check: the scripted click did not reach the client\n", &())
                status = 1
              }
              let compared = checked && status == 0
              let reference = if compared {
                run snapshot.renderSceneOver(&tree, content.scene(&state.*, &tree), color.white())
              } else {
                run Pixmap.make(0, 0)
              }
              let mut fast = if compositing {
                run fastScrollOf(&tree, f64.toF32(scale))
              } else {
                FastScroll.make()
              }
              if let Option<Dock>.Some { value: docked } = dock {
                // Wheels over the dock are the companion's to scroll.
                let s = f64.toF32(scale)
                run fast.blocked.append(
                  Rect<f32>.new(
                    docked.area.xMin * s,
                    docked.area.yMin * s,
                    docked.area.xMax * s,
                    docked.area.yMax * s,
                  ),
                )
              }
              run renderer.submit(
                if dock.isSome() {
                  &composed
                } else {
                  inspector.sceneWith(content.scene(&state.*, &tree))
                },
                &tree.atlas,
                tree.pendingUploads(),
                deviceWidth,
                deviceHeight,
                compared,
                reference.data(),
                move fast,
                fastSeq,
              )
              tree.clearUploads()
              drawn = drawn + 1
              let submitted = run seconds(&mut clock)
              if tracing {
                StderrWriter.print("silk-ui: frame {} submitted\n", &.(drawn))
              }

              // Check mode and lowest-latency apps wait for each frame on this thread.
              if check || options.lowestLatency || tracing {
                let report = run renderer.waitFrames(drawn)
                if compared {
                  status = report.status
                }
              }
              if tracing {
                StderrWriter.print("silk-ui: frame {} presented\n", &.(drawn))
              }
              if content.profile(&state.*) {
                let report = renderer.report()
                StderrWriter.print(
                  "frame-ms: layout={} canvas={} upload={} draw={} present={} interval={} acquire={} submit={}\n",
                  &(
                    (layoutEnd - frameStart) * 1000.0,
                    (canvasEnd - layoutEnd) * 1000.0,
                    report.upload,
                    report.draw,
                    report.present,
                    report.interval,
                    report.acquire,
                    (submitted - canvasEnd) * 1000.0
                  ),
                )
              }
              if check && drawn >= CHECK_FRAME {
                break
              }
              run content.pump(&mut state, &mut tree)
              platform.setCursor(owner, windowCursor(tree.cursor()))
            }
            redraw = check || content.wantsFrames(&state.*) || content.needsFrame(&state.*, &tree)
              || dock.isSome() && tree.needsFrameOf(dockRoot(&dock))
          }
          Event.Resized { size, scaleFactor, .. } => {
            width = size.width
            height = size.height
            scale = scaleFactor
            resized = true
          }
          Event.ScaleFactorChanged { scaleFactor, .. } => {
            scale = scaleFactor
            resized = true
          }
          Event.CloseRequested { .. } => {
            if check || run content.closing(&mut state) {
              break
            }

            // The client keeps the window: what it queued while deciding is handled next.
            redraw = true
          }
          Event.QuitRequested => {
            if check || run content.closing(&mut state) {
              break
            }
            redraw = true
          }
          _ => {
            let fed = if check {
              Option<Input>.None
            } else {
              run toInput(&value)
            }
            if let Option<Input>.Some { value: input } = move fed {
              // The root the input is for: with a dock, the pointer's side, or the side a
              // press began on until it ends.
              let target = dockTarget(&input, &dock, pressIn, pointerIn)
              if keyInput(&input) && run companion.key(&mut tree, &mut inspector, &input) {
                // The companion's shortcut: nobody else sees it.
                drop run tree.useRoot(FIRST_ROOT)
                redraw = true
              } else if target == FIRST_ROOT && inspector.picking()
                && run inspector.pickInput(&tree, &input) {
                // The inspector's picker takes the pointer before the app sees it.
                redraw = true
              } else {
                if dock.isSome() {
                  if pointed(&input) && target != pointerIn {
                    // The side the pointer left hears it leave, as when it leaves the window.
                    run tree.dispatchTo(pointerIn, Input.PointerLeave)
                    let left = companion.owns(pointerIn)
                    run pumpOwner(
                      &mut state,
                      &mut tree,
                      &mut content,
                      &mut companion,
                      &mut inspector,
                      left,
                      time,
                    )
                    pointerIn = target
                  }
                  match &input {
                    Input.PointerDown { .. } => {
                      pressIn = target

                      // Keys follow the press, as between windows.
                      if tree.keyRoot != target {
                        run tree.reportRoot(target, RootEventKind.Focused)
                      }
                    }
                    Input.PointerUp { .. } => {
                      pressIn = NONE
                    }
                    Input.PointerCancel => {
                      pressIn = NONE
                    }
                    _ => {}
                  }
                }

                // As a browser does: the handlers of the input see it first, and the default
                // action runs unless one of them prevented it.
                run tree.beginAt(target, &input)
                let into = tree.current
                if companion.owns(into) {
                  let prevented = run companion.decide(&mut tree, &mut inspector)
                  run tree.finish(move input, prevented)
                  run serve(&mut platform, owner, &mut tree, &mut host)
                  drop run companion.pump(&mut tree, &mut inspector, time)
                  drop run tree.useRoot(into)
                  platform.setCursor(owner, windowCursor(tree.cursor()))
                  redraw = tree.needsFrameOf(into) || inspector.wantsFrame()
                  drop run tree.useRoot(FIRST_ROOT)
                } else {
                  let prevented = run content.decide(&mut state, &mut tree)
                  run tree.finish(move input, prevented)
                  run serve(&mut platform, owner, &mut tree, &mut host)
                  run inspector.observe(&tree)
                  run content.pump(&mut state, &mut tree)
                  platform.setCursor(owner, windowCursor(tree.cursor()))
                  redraw = content.needsFrame(&state.*, &tree)
                }
              }
            }
          }
        }
      }
      if resized {
        let area = clientSize(width, height, &dock)
        if dock.isSome() {
          run tree.reportRoot(
            FIRST_ROOT,
            RootEventKind.Resized { width: f64.toF32(area.width), height: f64.toF32(area.height) },
          )
        }
        run content.resize(&mut state, &mut tree, f64.toF32(area.width), f64.toF32(area.height))
        redraw = true
      }
    }
    if !check && run content.update(&mut state, &mut tree, &mut platform, owner) {
      redraw = true
    }
    if inspector.enabled() && (content.needsFrame(&state.*, &tree) || inspector.wantsFrame()) {
      let area = clientSize(width, height, &dock)
      run content.prepare(&mut state, &mut tree)
      run content.layout(
        &mut state,
        &mut tree,
        FrameInput {
          width: f64.toF32(area.width),
          height: f64.toF32(area.height),
          scale: f64.toF32(scale),
          time: time,
        },
      )
      run serve(&mut platform, owner, &mut tree, &mut host)
      let composedInput = tree.input
      run content.frame(&mut state, &mut tree, composedInput, &inspector)
      run inspector.afterFrameScene(&tree, content.scene(&state.*, &tree))
      redraw = true
    }

    // The companion hears what came for it (the inspector's pushes, its timers) and may move
    // its root between a window and the dock; the client's root then has the window's rest.
    if !check {
      let changed = run companion.pump(&mut tree, &mut inspector, time)
      if changed && dock.isSome() {
        redraw = true
      }
      drop run tree.useRoot(FIRST_ROOT)
      let now = companion.dock(f64.toF32(width), f64.toF32(height))
      if !sameDock(&dock, &now) {
        dock = now
        pointerIn = FIRST_ROOT
        pressIn = NONE
        let area = clientSize(width, height, &dock)
        run tree.reportRoot(
          FIRST_ROOT,
          RootEventKind.Resized { width: f64.toF32(area.width), height: f64.toF32(area.height) },
        )
        run content.resize(&mut state, &mut tree, f64.toF32(area.width), f64.toF32(area.height))
        redraw = true
      }
      if dock.isSome() && tree.needsFrameOf(dockRoot(&dock)) {
        redraw = true
      }
      redraw = redraw || inspector.wantsFrame()
    }

    // Windows open, change and close with their roots; each is framed when its root needs it.
    if run syncWindows(&mut tree, &mut platform, &mut renderer, &mut others, dockRoot(&dock)) {
      run content.pump(&mut state, &mut tree)
      drop run tree.useRoot(FIRST_ROOT)
      redraw = redraw || content.needsFrame(&state.*, &tree)
    }
    let list = others.asSlice()
    let mut o: usize = 0
    while o < list.length {
      if tree.needsFrameOf(list[o].root) {
        platform.requestFrame(list[o].window)
      }
      o = o + 1
    }
    if redraw {
      platform.requestFrame(owner)
    }
  }
  run inspector.close()
  platform.clearCompositor()
  renderer.stop()
  while others.length() != 0 {
    platform.closeWindow(others.remove(0).window)
  }
  platform.closeWindow(owner)
  return status
}

static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.platform.windows.host_input { WindowsHostInput }
} else {
  static if Intrinsic.targetOperatingSystem() == "darwin"
    || Intrinsic.targetOperatingSystem() == "linux" {
    import silk.platform.native.host_input { NativeHostInput }
    import silk.system.host_input_native { OsHostInput }
  }
}

/// `Inspector.start` with this process's environment, for code that has no `HostInput`, such
/// as an app on the UI thread of `platform_thread.launch`. Off when the environment cannot be
/// read.
pub effect fn startInspector(options: InspectorOptions) -> Inspector
  ! OutOfMemoryError
  ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    let captured = run Effect.result(WindowsHostInput.capture())
    let mut inputs = match move captured {
      Result.Success { value } => move value
      Result.Failure { error } => match move error {
        HostInputError _failure => {
          return Inspector.off()
        }
        OutOfMemoryError failure => {
          fail move failure
        }
      }
    }
    return run inspectorWith(move options) |> Effect.provideMut<HostInput>(&mut inputs)
  } else {
    static if Intrinsic.targetOperatingSystem() == "darwin"
      || Intrinsic.targetOperatingSystem() == "linux" {
      let captured = run Effect.result(unsafe NativeHostInput.environmentSnapshot())
      let snapshot = match move captured {
        Result.Success { value } => move value
        Result.Failure { error } => match move error {
          HostInputError _failure => {
            return Inspector.off()
          }
          OutOfMemoryError failure => {
            fail move failure
          }
        }
      }
      let mut inputs = OsHostInput.make(move snapshot)
      return run inspectorWith(move options) |> Effect.provideMut<HostInput>(&mut inputs)
    } else {
      drop options
      return Inspector.off()
    }
  }
}

/// The value of this process's environment variable `name`, for code that has no `HostInput`
/// (see `startInspector`). None when it is not set, is not UTF-8 or the environment cannot be
/// read.
pub effect fn environmentVariable(name: string) -> Option<String>
  ! OutOfMemoryError
  ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    let captured = run Effect.result(WindowsHostInput.capture())
    let mut inputs = match move captured {
      Result.Success { value } => move value
      Result.Failure { error } => match move error {
        HostInputError _failure => {
          return Option<String>.None
        }
        OutOfMemoryError failure => {
          fail move failure
        }
      }
    }
    return run variableIn(name) |> Effect.provideMut<HostInput>(&mut inputs)
  } else {
    static if Intrinsic.targetOperatingSystem() == "darwin"
      || Intrinsic.targetOperatingSystem() == "linux" {
      let captured = run Effect.result(unsafe NativeHostInput.environmentSnapshot())
      let snapshot = match move captured {
        Result.Success { value } => move value
        Result.Failure { error } => match move error {
          HostInputError _failure => {
            return Option<String>.None
          }
          OutOfMemoryError failure => {
            fail move failure
          }
        }
      }
      let mut inputs = OsHostInput.make(move snapshot)
      return run variableIn(name) |> Effect.provideMut<HostInput>(&mut inputs)
    } else {
      return Option<String>.None
    }
  }
}

effect fn variableIn(name: string) -> Option<String>
  ! OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let read = run Effect.result(HostInput.variableNamed(name))
  let value = match move read {
    Result.Success { value: found } => match move found {
      Option<Bytes>.Some { value: bytes } => move bytes
      Option<Bytes>.None => {
        return Option<String>.None
      }
    }
    Result.Failure { error } => match move error {
      HostInputError _failure => {
        return Option<String>.None
      }
      OutOfMemoryError failure => {
        fail move failure
      }
    }
  }
  return match HostInput.text(value.asSlice()) {
    Result<string, InvalidUtf8>.Success { value: text } => Option<String>.some(
      run String.copy(text),
    )
    Result<string, InvalidUtf8>.Failure { error: _ } => Option<String>.None
  }
}

effect fn inspectorWith(options: InspectorOptions) -> Inspector
  ! OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let started = run Effect.result(Inspector.start(move options))
  return match move started {
    Result.Success { value } => move value
    Result.Failure { error } => match move error {
      HostInputError _failure => Inspector.off()
      OutOfMemoryError failure => {
        fail move failure
      }
    }
  }
}
