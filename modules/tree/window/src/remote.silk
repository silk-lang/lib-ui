//! What the loader reads from outside the program: local files and HTTP(S), on native
//! workers (`images`). A WebAssembly host has neither here, so those loads fail; a page loads
//! its pictures itself (see `ui-app-dom`).
static if Intrinsic.targetArchitecture() == "wasm32" {
  import silk.mem.allocator { Allocator, OutOfMemoryError }
  import ui_tree.legacy { UiTree, TreeError }
  pub import ui_tree.image_load { ImageState }
  import silk.collections.bytes { Bytes }
  import silk.collections.list { List }

  /// A font stylesheet that was read; none are, here.
  pub struct SheetData {
    pub id: u32,
    pub css: Bytes,
  }

  /// Loads nothing: every request fails at once.
  pub struct Remote {}

  impl Remote {
    pub fn make() -> Remote {
      return Remote {}
    }

    pub fn forFonts() -> Remote {
      return Remote {}
    }

    pub fn forSheets() -> Remote {
      return Remote {}
    }

    pub effect fn sheetFile(self: &mut Self, id: u32, path: string) -> ()
      ! OutOfMemoryError
      ? &mut Allocator {}

    pub effect fn sheetUrl(self: &mut Self, id: u32, url: string) -> ()
      ! OutOfMemoryError
      ? &mut Allocator {}

    pub effect fn takeSheets(self: &mut Self, out: &mut List<SheetData>) -> ()
      ! OutOfMemoryError
      ? &mut Allocator {}

    pub effect fn fontFile(self: &mut Self, face: u32, path: string) -> ()
      ! OutOfMemoryError
      ? &mut Allocator {}

    pub effect fn fontUrl(self: &mut Self, face: u32, url: string) -> ()
      ! OutOfMemoryError
      ? &mut Allocator {}

    pub effect fn file(self: &mut Self, resource: u32, path: string) -> ()
      ! OutOfMemoryError
      ? &mut Allocator {}

    pub effect fn fileIcon(self: &mut Self, resource: u32, path: string) -> ()
      ! OutOfMemoryError
      ? &mut Allocator {}

    pub effect fn url(self: &mut Self, resource: u32, url: string) -> ()
      ! OutOfMemoryError
      ? &mut Allocator {}

    pub effect fn urlIcon(self: &mut Self, resource: u32, url: string) -> ()
      ! OutOfMemoryError
      ? &mut Allocator {}

    pub fn state(self: &Self, resource: u32) -> ImageState {
      return ImageState.Failed
    }

    pub fn pending(self: &Self) -> bool {
      return false
    }

    pub effect fn poll(self: &mut Self, tree: &mut UiTree<'_>) -> bool
      ! TreeError | OutOfMemoryError
      ? &mut Allocator {
      return false
    }
  }
} else {
  pub import images { Images as Remote, ImageState, SheetData }
}
