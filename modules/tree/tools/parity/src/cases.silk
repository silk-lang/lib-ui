//! The parity cases. Each builds a tree with the public API, feeds it inputs and reports.
//! Every node a case wants compared has a test id, which becomes its `id` in the page.
import scenario { Scenario }
import ui_tree.css
import ui_tree.css { px, Declaration, Property }
import ui_tree.lib { Tree, TreeError, EventKind, Overflow, Attribute, BoxNode, Position }
import ui_fixtures.fixtures as fixtures
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

fn sized(width: f32, height: f32) -> [Declaration; 2] {
  return [css.width(px(width)), css.height(px(height))]
}

effect fn named(tree: &mut Tree<'_>, style: &[Declaration], id: string) -> BoxNode
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let node = run tree.box(style)
  run tree.setTestId(node, id)
  return node
}

/// A click on a nested box runs the handlers of the box and then of its ancestors.
effect fn clickBubbles() -> String
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run Tree.make(&fonts)
  let mut scenario = Scenario.make("click-bubbles")
  let root = run named(&mut tree, &[], "root")
  let outer = run named(&mut tree, &sized(200.0, 100.0), "outer")
  let inner = run named(&mut tree, &sized(100.0, 50.0), "inner")
  let aside = run named(&mut tree, &sized(100.0, 50.0), "aside")
  run tree.append(root, outer)
  run tree.append(outer, inner)
  run tree.append(root, aside)
  run tree.setRoot(root)
  run tree.listen(outer, &[EventKind.PointerDown, EventKind.PointerUp, EventKind.Click])
  run tree.listen(inner, &[EventKind.PointerDown, EventKind.Click])
  run tree.listen(aside, &[EventKind.Click])
  run tree.listen(root, &[EventKind.Click, EventKind.PointerUp])
  run scenario.settle(&mut tree)
  run scenario.click(&mut tree, 20.0, 20.0)
  run scenario.click(&mut tree, 150.0, 80.0)
  return run scenario.report(&mut tree)
}

/// Down on one box and up on another: the up goes to the box under the pointer, and the
/// click to their common ancestor.
effect fn releaseElsewhere() -> String
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run Tree.make(&fonts)
  let mut scenario = Scenario.make("release-elsewhere")
  let root = run named(&mut tree, &[], "root")
  let first = run named(&mut tree, &sized(100.0, 50.0), "first")
  let second = run named(&mut tree, &sized(100.0, 50.0), "second")
  run tree.append(root, first)
  run tree.append(root, second)
  run tree.setRoot(root)
  let kinds = [EventKind.PointerDown, EventKind.PointerUp, EventKind.Click]
  run tree.listen(root, &kinds)
  run tree.listen(first, &kinds)
  run tree.listen(second, &kinds)
  run scenario.settle(&mut tree)
  run scenario.moveTo(&mut tree, 20.0, 20.0)
  run scenario.press(&mut tree, 20.0, 20.0)
  run scenario.moveTo(&mut tree, 20.0, 70.0)
  run scenario.release(&mut tree, 20.0, 70.0)
  return run scenario.report(&mut tree)
}

/// Enter and leave do not bubble; they are told to each box the pointer enters or leaves.
effect fn enterAndLeave() -> String
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run Tree.make(&fonts)
  let mut scenario = Scenario.make("enter-and-leave")
  let root = run named(&mut tree, &[], "root")
  let outer = run named(&mut tree, &sized(200.0, 100.0), "outer")
  let inner = run named(&mut tree, &sized(100.0, 50.0), "inner")
  run tree.append(root, outer)
  run tree.append(outer, inner)
  run tree.setRoot(root)
  run tree.listen(outer, &[EventKind.PointerEnter, EventKind.PointerLeave])
  run tree.listen(inner, &[EventKind.PointerEnter, EventKind.PointerLeave])
  run scenario.settle(&mut tree)
  run scenario.moveTo(&mut tree, 300.0, 200.0)
  run scenario.moveTo(&mut tree, 150.0, 80.0)
  run scenario.moveTo(&mut tree, 20.0, 20.0)
  run scenario.moveTo(&mut tree, 150.0, 80.0)
  run scenario.moveTo(&mut tree, 300.0, 200.0)
  return run scenario.report(&mut tree)
}

/// A wheel over a scroll container scrolls it, stops at the end, and tells scroll listeners.
effect fn wheelScrolls() -> String
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run Tree.make(&fonts)
  let mut scenario = Scenario.make("wheel-scrolls")
  let root = run named(&mut tree, &[], "root")
  let scroller = run named(
    &mut tree,
    &[css.width(px(200.0)), css.height(px(100.0)), css.overflowY(Overflow.Scroll)],
    "scroller",
  )
  let content = run named(&mut tree, &sized(100.0, 400.0), "content")
  run tree.append(root, scroller)
  run tree.append(scroller, content)
  run tree.setRoot(root)
  run tree.listen(scroller, &[EventKind.Scroll, EventKind.Wheel])
  run scenario.settle(&mut tree)
  run scenario.moveTo(&mut tree, 50.0, 50.0)
  run scenario.wheel(&mut tree, 50.0, 50.0, 0.0, 120.0)
  run scenario.wheel(&mut tree, 50.0, 50.0, 0.0, 500.0)
  run scenario.wheel(&mut tree, 50.0, 50.0, 0.0, -40.0)
  return run scenario.report(&mut tree)
}

/// Tab moves focus through the focusable boxes in tree order; focus and blur do not bubble.
effect fn tabMovesFocus() -> String
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run Tree.make(&fonts)
  let mut scenario = Scenario.make("tab-moves-focus")
  let root = run named(&mut tree, &[], "root")
  let first = run named(&mut tree, &sized(100.0, 30.0), "first")
  let skipped = run named(&mut tree, &sized(100.0, 30.0), "skipped")
  let second = run named(&mut tree, &sized(100.0, 30.0), "second")
  run tree.append(root, first)
  run tree.append(root, skipped)
  run tree.append(root, second)
  run tree.setRoot(root)
  run tree.setAttribute(first, Attribute.TabIndex { value: 0 })
  run tree.setAttribute(second, Attribute.TabIndex { value: 0 })
  run tree.listen(root, &[EventKind.Focus, EventKind.Blur, EventKind.KeyDown])
  run tree.listen(first, &[EventKind.Focus, EventKind.Blur])
  run tree.listen(second, &[EventKind.Focus, EventKind.Blur, EventKind.KeyDown])
  run scenario.settle(&mut tree)
  run scenario.key(&mut tree, "Tab")
  run scenario.key(&mut tree, "Tab")
  return run scenario.report(&mut tree)
}

/// Block boxes stack; padding, border and margin place the content as in CSS.
effect fn blockBoxes() -> String
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run Tree.make(&fonts)
  let mut scenario = Scenario.make("block-boxes")
  let root = run named(&mut tree, &[css.padding(px(10.0))], "root")
  let first = run named(&mut tree, &[css.height(px(40.0)), css.marginBottom(px(20.0))], "first")
  let second = run named(
    &mut tree,
    &[css.width(px(120.0)), css.height(px(30.0)), css.marginTop(px(8.0)), css.padding(px(5.0))],
    "second",
  )
  let child = run named(&mut tree, &[css.height(px(10.0))], "child")
  run tree.append(root, first)
  run tree.append(root, second)
  run tree.append(second, child)
  run tree.setRoot(root)
  return run scenario.report(&mut tree)
}

fn z(value: f32) -> Declaration {
  return css.declare(Property.ZIndex, css.number(value))
}

/// Overlapping boxes take the pointer in paint order: positive z-index over z auto over in-flow
/// content over negative z-index (CSS 2 Appendix E).
effect fn zIndexStacks() -> String
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run Tree.make(&fonts)
  let mut scenario = Scenario.make("z-index-stacks")
  let root = run named(&mut tree, &[], "root")
  let a = run named(
    &mut tree,
    &[css.width(px(100.0)), css.height(px(100.0)), css.position(Position.Relative), z(1.0)],
    "a",
  )
  let b = run named(
    &mut tree,
    &[
      css.width(px(60.0)),
      css.height(px(60.0)),
      css.position(Position.Absolute),
      css.top(px(0.0)),
      css.left(px(0.0)),
    ],
    "b",
  )
  let c = run named(
    &mut tree,
    &[
      css.width(px(80.0)),
      css.height(px(80.0)),
      css.position(Position.Absolute),
      css.top(px(50.0)),
      css.left(px(50.0)),
      z(-1.0),
    ],
    "c",
  )
  let d = run named(&mut tree, &sized(200.0, 30.0), "d")
  let e = run named(
    &mut tree,
    &[
      css.width(px(50.0)),
      css.height(px(50.0)),
      css.position(Position.Relative),
      css.top(px(-20.0)),
    ],
    "e",
  )
  run tree.append(root, a)
  run tree.append(root, b)
  run tree.append(root, c)
  run tree.append(root, d)
  run tree.append(d, e)
  run tree.setRoot(root)
  let kinds = [EventKind.PointerDown]
  run tree.listen(a, &kinds)
  run tree.listen(b, &kinds)
  run tree.listen(c, &kinds)
  run tree.listen(d, &kinds)
  run tree.listen(e, &kinds)
  run scenario.settle(&mut tree)
  run scenario.click(&mut tree, 30.0, 30.0)
  run scenario.click(&mut tree, 110.0, 60.0)
  run scenario.click(&mut tree, 20.0, 90.0)
  run scenario.click(&mut tree, 20.0, 115.0)
  run scenario.click(&mut tree, 120.0, 120.0)
  return run scenario.report(&mut tree)
}

/// Every case, as a JSON array.
pub effect fn all() -> String
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut out = String.make()
  run out.append("[")
  run out.append((run clickBubbles()).view())
  run out.append(",\n")
  run out.append((run releaseElsewhere()).view())
  run out.append(",\n")
  run out.append((run enterAndLeave()).view())
  run out.append(",\n")
  run out.append((run wheelScrolls()).view())
  run out.append(",\n")
  run out.append((run tabMovesFocus()).view())
  run out.append(",\n")
  run out.append((run blockBoxes()).view())
  run out.append(",\n")
  run out.append((run zIndexStacks()).view())
  run out.append("]")
  return move out
}
