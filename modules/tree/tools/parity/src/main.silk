//! Runs each parity case in the tree and prints, as JSON, the page a browser should build for
//! it, the inputs to replay there and what the tree saw: the handlers that ran in order, the
//! border boxes, the scroll offsets and the focused node. `silk task browser parity` replays
//! the same inputs in Chromium and compares.
import cases { all }
import ui_tree.lib { TreeError }
import silk.core.effect { Effect }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter, StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

effect fn application() -> i32
  ! TreeError | OutOfMemoryError | WriterError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut stdout = StdoutWriter.make()
  let report = run all() |> Effect.provideMut<Allocator>(&mut allocator)
  run Writer.writeString(String.view(&report)) |> Effect.provideMut<Writer>(&mut stdout)
  run Writer.writeString("\n") |> Effect.provideMut<Writer>(&mut stdout)
  return 0
}

effect fn failed(error: TreeError | OutOfMemoryError | WriterError) -> i32 {
  drop error
  let mut stderr = StderrWriter.make()
  let written = run Writer.writeString("ui-tree-parity: a case failed to run\n")
    |> Effect.provideMut<Writer>(&mut stderr)
    |> Effect.result
  drop written
  return 1
}

pub fn main() -> i32 {
  return run application() |> Effect.catchAll(failed)
}
