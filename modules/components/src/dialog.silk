//! [`dialog`]: a modal dialog over a scrim, and [`Disclosure`], the open state it (and
//! [`popover`](popover)) keeps in the model.
//!
//! An open dialog takes focus (or a field inside it that calls `ui.takeFocus()` does), keeps
//! Tab and Shift+Tab inside it, and closes with Escape or a click on the scrim. When it closes,
//! the button made with [`dialogButton`] takes focus back.
import ui_tree.css
import ui_tree.css { px, percent, Keyword }
import theme { Theme, raised }
import layout { heading }
import button { Tone, buttonLook }
import ui_app.ui { Ui, Reply, textKey }
import silk.num.u64
import ui_tree.mutation { Position, Align, Role }
import ui_tree.node { Event, EventKind }
import silk.core.ownership { Copy }
import silk.text.string { String }

/// Whether a dialog or popover is open, and whether focus goes back to its button.
pub struct Disclosure {
  pub open: bool,
  pub returnFocus: bool,
}

impl Copy for Disclosure {}

impl Disclosure {
  pub fn make() -> Disclosure {
    return Disclosure { open: false, returnFocus: false }
  }

  pub fn show(self: &mut Self) -> () {
    self.open = true
    self.returnFocus = false
  }

  /// Closes it; its button takes focus back.
  pub fn hide(self: &mut Self) -> () {
    self.open = false
    self.returnFocus = true
  }

  /// Opens it when `open`, closes it otherwise.
  pub fn set(self: &mut Self, open: bool) -> () {
    if open {
      self.show()
    } else {
      self.hide()
    }
  }
}

/// Whether `event` is an Escape key press.
pub fn isEscape(event: &Event) -> bool {
  return String.view(&event.key) == "Escape"
}

/// The button that opens the dialog of `state`; it takes focus back when the dialog closes.
pub fn dialogButton<M>(
  ui: &mut Ui<M>,
  theme: &Theme,
  state: &Disclosure,
  tone: Tone,
  label: string,
  onOpen: fn() -> M,
) -> () {
  let back = !state.open && state.returnFocus
  ui.pressable(
    onOpen,
    |ui| {
      buttonLook(&mut ui, &theme, tone, false)
      ui.expanded(state.open)
      if back {
        ui.takeFocus()
      }
      ui.text(label)
    },
  )
}

/// While `state.open`: a modal dialog titled `title` over a scrim, with `body` below the
/// title. Escape and a click on the scrim send `onClose()`.
pub fn dialog<M>(
  ui: &mut Ui<M>,
  theme: &Theme,
  state: &Disclosure,
  title: string,
  onClose: fn() -> M,
  body: fn(&mut Ui<M>) -> (),
) -> () {
  if !state.open {
    return ()
  }
  ui.overlay(
    u64.bitXor(textKey(title), 0xD1A1),
    |ui| {
      ui.box(
        |ui| {
          ui.testId("scrim")
          ui.style(
            &[
              css.position(Position.Fixed),
              css.top(px(0.0)),
              css.right(px(0.0)),
              css.bottom(px(0.0)),
              css.left(px(0.0)),
              css.display(Keyword.Flex),
              css.alignItems(Align.Center),
              css.justifyContent(Align.Center),
            ],
          )
          ui.background(theme.scrim)
          ui.onClick(onClose)
          ui.column(
            |ui| {
              ui.accessRole(Role.Dialog)
              ui.label(title)
              ui.focusTrap(true)
              ui.tabIndex(-1)
              ui.takeFocus()
              raised(&mut ui, &theme)
              ui.padding(20.0)
              ui.gap(14.0)
              ui.style(
                &[
                  css.width(px(360.0)),
                  css.maxWidth(percent(90.0)),
                ],
              )

              // Clicks inside stop here, so they do not reach the scrim.
              ui.on(EventKind.Click, |event| Reply<M>.Stop)
              ui.onKeyDown(
                |event| if isEscape(event) {
                  Reply<M>.EmitAndStop { message: onClose() }
                } else {
                  Reply<M>.Pass
                },
              )
              heading(&mut ui, &theme, 1, title)
              body(&mut ui)
            },
          )
        },
      )
    },
  )
}
