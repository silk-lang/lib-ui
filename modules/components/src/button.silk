//! Buttons: [`button`], [`primaryButton`], and [`buttonWith`] for the other tones and the
//! disabled state. A button is a focusable box with role button; it sends its message when
//! clicked, or pressed with Enter or Space while focused (the tree turns those keys into
//! clicks).
import ui_tree.css
import ui_tree.css { px, Keyword }
import theme { Theme, border, padding2, focusRing, clear }
import ui_app.ui { Ui }
import ui_tree.mutation {
  Align,
  Cursor,
  WhiteSpace,
  FlexDirection,
  BoxSizing
}

/// How a button stands out.
pub enum Tone {
  /// The main action of a view: filled with the accent.
  Primary,
  /// Other actions: bordered.
  Secondary,
  /// Quiet actions in toolbars: no border until hovered.
  Ghost,
  /// Destructive actions: filled red.
  Danger,
}

/// The button look for `tone` on the open node: padding, border, colors and the hover, press
/// and focus ring variants.
pub fn buttonLook<M>(ui: &mut Ui<M>, theme: &Theme, tone: Tone, disabled: bool) -> () {
  padding2(&mut ui, 4.0, 12.0)
  ui.style(
    &[
      css.display(Keyword.Flex),
      css.flexDirection(FlexDirection.Row),
      css.boxSizing(BoxSizing.BorderBox),
      css.minHeight(px(theme.controlHeight)),
      css.alignItems(Align.Center),
      css.justifyContent(Align.Center),
      css.whiteSpace(WhiteSpace.NoWrap),
      css.flexShrink(0.0),
    ],
  )
  if tone == Tone.Primary {
    border(&mut ui, 1.0, theme.accent, theme.radius)
    ui.background(theme.accent)
    ui.color(theme.accentText)
    ui.hover(&[css.backgroundColor(theme.accentHover)])
    ui.active(&[css.backgroundColor(theme.accentHover)])
  } else if tone == Tone.Danger {
    border(&mut ui, 1.0, theme.danger, theme.radius)
    ui.background(theme.danger)
    ui.color(theme.accentText)
    ui.hover(&[css.backgroundColor(theme.dangerHover)])
    ui.active(&[css.backgroundColor(theme.dangerHover)])
  } else if tone == Tone.Ghost {
    border(&mut ui, 1.0, clear(), theme.radius)
    ui.hover(&[css.backgroundColor(theme.hover)])
    ui.active(&[css.backgroundColor(theme.pressed)])
  } else {
    border(&mut ui, 1.0, theme.border, theme.radius)
    ui.background(theme.surface)
    ui.hover(&[css.backgroundColor(theme.hover)])
    ui.active(&[css.backgroundColor(theme.pressed)])
  }
  if disabled {
    ui.style(&[css.opacity(0.5)])
    ui.cursor(Cursor.NotAllowed)
  }
  focusRing(&mut ui, &theme)
}

/// A bordered button labeled `label` that sends `onPress()`.
pub fn button<M>(ui: &mut Ui<M>, theme: &Theme, label: string, onPress: fn() -> M) -> () {
  buttonWith(&mut ui, &theme, Tone.Secondary, false, label, onPress)
}

/// The view's main action, filled with the accent.
pub fn primaryButton<M>(ui: &mut Ui<M>, theme: &Theme, label: string, onPress: fn() -> M) -> () {
  buttonWith(&mut ui, &theme, Tone.Primary, false, label, onPress)
}

/// A button of `tone`. A `disabled` button takes no focus and sends nothing.
pub fn buttonWith<M>(
  ui: &mut Ui<M>,
  theme: &Theme,
  tone: Tone,
  disabled: bool,
  label: string,
  onPress: fn() -> M,
) -> () {
  ui.pressable(
    onPress,
    |ui| {
      buttonLook(&mut ui, &theme, tone, disabled)
      ui.disabled(disabled)
      ui.text(label)
    },
  )
}

/// A button with any content: `body` adds it (an icon and a label, say) and may style it.
pub fn buttonBox<M>(
  ui: &mut Ui<M>,
  theme: &Theme,
  tone: Tone,
  onPress: fn() -> M,
  body: fn(&mut Ui<M>) -> (),
) -> () {
  ui.pressable(
    onPress,
    |ui| {
      buttonLook(&mut ui, &theme, tone, false)
      ui.style(&[css.columnGap(px(6.0))])
      body(&mut ui)
    },
  )
}
