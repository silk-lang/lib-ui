//! Layout and text helpers: [`spacer`], [`divider`], [`stack`] and [`layer`], [`scrollView`],
//! [`card`], [`heading`], [`caption`] and [`paragraph`]. `ui.row` and `ui.column` (flex
//! containers) come with the framework.
import ui_tree.css
import ui_tree.css { px }
import theme { Theme, border, padding2 }
import ui_app.ui { Ui }
import ui_tree.mutation { Position, Overflow, Role, Align, WhiteSpace }

/// A box that takes the free space of a row or column, pushing what follows to the end.
pub fn spacer<M>(ui: &mut Ui<M>) -> () {
  ui.box(
    |ui| {
      ui.grow(1.0)
    },
  )
}

/// A one pixel line across a column (or down a row, with `vertical`).
pub fn divider<M>(ui: &mut Ui<M>, theme: &Theme, vertical: bool) -> () {
  ui.box(
    |ui| {
      ui.background(theme.border)
      ui.style(&[css.flexShrink(0.0), css.alignSelf(Align.Stretch)])
      if vertical {
        ui.width(px(1.0))
      } else {
        ui.height(px(1.0))
      }
    },
  )
}

/// A box whose [`layer`] children sit on top of each other, filling it.
pub fn stack<M>(ui: &mut Ui<M>, body: fn(&mut Ui<M>) -> ()) -> () {
  ui.box(
    |ui| {
      ui.style(&[css.position(Position.Relative)])
      body(&mut ui)
    },
  )
}

/// A layer of a [`stack`]: positioned over the whole stack. Later layers draw on top.
pub fn layer<M>(ui: &mut Ui<M>, body: fn(&mut Ui<M>) -> ()) -> () {
  ui.box(
    |ui| {
      ui.style(
        &[
          css.position(Position.Absolute),
          css.top(px(0.0)),
          css.right(px(0.0)),
          css.bottom(px(0.0)),
          css.left(px(0.0)),
        ],
      )
      body(&mut ui)
    },
  )
}

/// A column `height` CSS pixels tall that scrolls vertically when its content is taller. The
/// tree keeps the scroll offset; the wheel, the scroll bar and focus moves scroll it.
pub fn scrollView<M>(ui: &mut Ui<M>, theme: &Theme, height: f32, body: fn(&mut Ui<M>) -> ()) -> () {
  ui.column(
    |ui| {
      ui.height(px(height))
      ui.style(
        &[
          css.overflowY(Overflow.Auto),
          css.overflowX(Overflow.Hidden),
          css.flexShrink(0.0),
        ],
      )
      border(&mut ui, 1.0, theme.border, theme.radius)
      body(&mut ui)
    },
  )
}

/// A raised surface with a border and padding, laying out its children in a column.
pub fn card<M>(ui: &mut Ui<M>, theme: &Theme, body: fn(&mut Ui<M>) -> ()) -> () {
  ui.column(
    |ui| {
      ui.background(theme.surface)
      border(&mut ui, 1.0, theme.border, theme.radius + 2.0)
      ui.padding(14.0)
      ui.gap(10.0)
      body(&mut ui)
    },
  )
}

/// A heading: bold, in the heading size (`level` 1) or a step smaller (2 and up).
pub fn heading<M>(ui: &mut Ui<M>, theme: &Theme, level: u32, text: string) -> () {
  ui.box(
    |ui| {
      ui.accessRole(Role.Heading)
      ui.fontSize(
        if level <= 1 {
          theme.headingSize
        } else {
          theme.fontSize + 1.0
        },
      )
      ui.style(&[css.fontWeight(700.0)])
      ui.text(text)
    },
  )
}

/// Small, muted text: a hint or a field's label.
pub fn caption<M>(ui: &mut Ui<M>, theme: &Theme, text: string) -> () {
  ui.box(
    |ui| {
      ui.fontSize(theme.smallSize)
      ui.color(theme.mutedText)
      ui.text(text)
    },
  )
}

/// A paragraph of body text that wraps.
pub fn paragraph<M>(ui: &mut Ui<M>, text: string) -> () {
  ui.box(
    |ui| {
      ui.accessRole(Role.Paragraph)
      ui.style(&[css.whiteSpace(WhiteSpace.Normal)])
      ui.text(text)
    },
  )
}

/// Keeps the open node one line high: its text does not wrap.
pub fn noWrap<M>(ui: &mut Ui<M>) -> () {
  ui.style(&[css.whiteSpace(WhiteSpace.NoWrap)])
}

/// Padding of `vertical` and `horizontal` CSS pixels on the open node.
pub fn pad<M>(ui: &mut Ui<M>, vertical: f32, horizontal: f32) -> () {
  padding2(&mut ui, vertical, horizontal)
}
