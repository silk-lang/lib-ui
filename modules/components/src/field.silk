//! Text entry: [`textField`] (one line) and [`textArea`] (several lines), over the tree's
//! `input` node. The tree edits the text (caret, selection, clipboard, undo, input methods);
//! the model owns the value: each edit sends `onChange(newValue)` and the view passes the value
//! back, so the input is controlled without fighting the caret.
import ui_app.heap { allocate }
import ui_tree.css
import ui_tree.css { px }
import theme { Theme, border, padding2 }
import layout { caption }
import ui_app.ui { Ui }
import ui_tree.mutation { BoxShadow, BoxSizing }
import silk.text.string { String }
import silk.num.u32

/// The input look: border, radius, padding, the accent border while focused.
fn inputLook<M>(ui: &mut Ui<M>, theme: &Theme) -> () {
  border(&mut ui, 1.0, theme.border, theme.radius)
  padding2(&mut ui, 5.0, 8.0)
  ui.background(theme.surface)
  ui.style(
    &[
      css.lineHeight(px(20.0)),
      css.boxSizing(BoxSizing.BorderBox),
      css.placeholderColor(theme.mutedText),
      css.caretColor(theme.accent),
      css.selectionColor(theme.highlight),
    ],
  )
  ui.focused(
    &[
      css.borderColor(theme.accent),
      allocate(css.boxShadow(BoxShadow { offsetX: 0.0, offsetY: 0.0, blur: 0.0, spread: 1.0, color: theme.accent, inset: false, })),
    ],
  )
}

/// A one-line text field: `label` above it (and as its accessible name), `placeholder` while
/// empty, the model's `value`, and `onChange(newValue)` on every edit. `body` adds to the input
/// node: a test id, `ui.onEnter(|| Message.Submit)`, `ui.takeFocus()`.
pub fn textField<M>(
  ui: &mut Ui<M>,
  theme: &Theme,
  label: string,
  placeholder: string,
  value: string,
  onChange: fn(String) -> M,
  body: fn(&mut Ui<M>) -> (),
) -> () {
  ui.column(
    |ui| {
      ui.gap(4.0)
      caption(&mut ui, &theme, label)
      ui.input(
        value,
        |ui| {
          ui.label(label)
          ui.placeholder(placeholder)
          inputLook(&mut ui, &theme)
          ui.height(px(theme.controlHeight + 2.0))
          ui.onInput(onChange)
          body(&mut ui)
        },
      )
    },
  )
}

/// A text area `rows` lines tall: Enter starts a new line, text wraps, and it scrolls when the
/// text is longer.
pub fn textArea<M>(
  ui: &mut Ui<M>,
  theme: &Theme,
  label: string,
  placeholder: string,
  value: string,
  rows: u32,
  onChange: fn(String) -> M,
  body: fn(&mut Ui<M>) -> (),
) -> () {
  ui.column(
    |ui| {
      ui.gap(4.0)
      caption(&mut ui, &theme, label)
      ui.input(
        value,
        |ui| {
          ui.label(label)
          ui.placeholder(placeholder)
          ui.multiline(true)
          inputLook(&mut ui, &theme)
          ui.height(px(u32.toF32(rows) * 20.0 + 12.0))
          ui.onInput(onChange)
          body(&mut ui)
        },
      )
    },
  )
}
