//! Lists: [`list`] (rows with list semantics), [`selectList`] (one selected row, chosen with
//! the pointer or the arrow keys) and [`virtualList`] (only the rows in view exist, for long
//! lists).
import ui_tree.css
import ui_tree.css { px }
import theme { Theme, border, corners, focusRing, padding2, edges }
import ui_app.ui { Ui, Reply }
import ui_tree.mutation { Overflow, Role, Cursor, Align }
import ui_tree.node { Event, EventKind }
import silk.core.option { Option }
import silk.num.f32
import silk.num.usize
import silk.num.u64
import silk.text.string { String }

/// No row selected, for [`selectList`].
pub const NO_SELECTION: usize = usize.MAX

/// A list of `items`, one row each, keyed by `key` so rows keep their tree state when items
/// move. `row` builds a row's content.
pub fn list<M, T>(
  ui: &mut Ui<M>,
  theme: &Theme,
  label: string,
  items: &[T],
  key: fn(&T) -> u64,
  row: fn(&mut Ui<M>, &T) -> (),
) -> () {
  ui.column(
    |ui| {
      ui.accessRole(Role.List)
      ui.label(label)
      border(&mut ui, 1.0, theme.border, theme.radius)
      ui.background(theme.surface)
      ui.each(
        items,
        key,
        |ui, item| {
          ui.row(
            |ui| {
              ui.accessRole(Role.ListItem)
              padding2(&mut ui, 6.0, 10.0)
              ui.gap(8.0)
              edges(&mut ui, 0.0, 0.0, 1.0, 0.0, theme.border)
              row(&mut ui, item)
            },
          )
        },
      )
    },
  )
}

/// The row a key moves the selection to in a list of `count` rows, or none.
pub fn moveSelection(event: &Event, selected: usize, count: usize) -> Option<usize> {
  if count == 0 || event.modifiers != 0 {
    return Option<usize>.None
  }
  let key = String.view(&event.key)
  let none = selected == NO_SELECTION || selected >= count
  if key == "ArrowDown" {
    return Option<usize>.Some {
      value: if none {
        0
      } else if selected + 1 < count {
        selected + 1
      } else {
        selected
      },
    }
  }
  if key == "ArrowUp" {
    return Option<usize>.Some {
      value: if none {
        count - 1
      } else if selected > 0 {
        selected - 1
      } else {
        0
      },
    }
  }
  if key == "Home" {
    return Option<usize>.Some { value: 0 }
  }
  if key == "End" {
    return Option<usize>.Some { value: count - 1 }
  }
  return Option<usize>.None
}

/// A list with one selected row (`selected`, or [`NO_SELECTION`]). The list is one tab stop:
/// focused, Up, Down, Home and End move the selection; a click selects a row. Both send
/// `onSelect(index)`. The selected row scrolls into view when it changes. `row` builds a row's
/// content and is told whether the row is selected.
pub fn selectList<M, T>(
  ui: &mut Ui<M>,
  theme: &Theme,
  label: string,
  items: &[T],
  key: fn(&T) -> u64,
  selected: usize,
  onSelect: fn(usize) -> M,
  row: fn(&mut Ui<M>, &T, bool) -> (),
) -> () {
  let count = items.length
  ui.column(
    |ui| {
      ui.accessRole(Role.ListBox)
      ui.label(label)
      ui.tabIndex(0)
      border(&mut ui, 1.0, theme.border, theme.radius)
      ui.background(theme.surface)
      ui.padding(4.0)
      ui.gap(2.0)
      ui.style(&[css.overflowY(Overflow.Auto)])
      focusRing(&mut ui, &theme)
      ui.onKeyDown(
        |event| match moveSelection(event, selected, count) {
          Option<usize>.Some { value: next } => Reply<M>.EmitAndStop { message: onSelect(next) }
          Option<usize>.None => Reply<M>.Pass
        },
      )
      ui.enumerate(
        items,
        key,
        |ui, index, item| {
          let isSelected = index == selected
          ui.row(
            |ui| {
              ui.accessRole(Role.Option)
              ui.selected(isSelected)
              ui.cursor(Cursor.Pointer)
              padding2(&mut ui, 5.0, 8.0)
              ui.gap(8.0)
              ui.style(&[css.borderRadius(px(theme.radius - 2.0))])
              if isSelected {
                ui.background(theme.highlight)
                ui.reveal()
              } else {
                ui.hover(&[css.backgroundColor(theme.hover)])
              }
              ui.onClick(|| onSelect(index))
              row(&mut ui, item, isSelected)
            },
          )
        },
      )
    },
  )
}

/// Which rows of a virtual list exist: `first` up to (not including) `end`.
pub struct Window {
  pub first: usize,
  pub end: usize,
}

/// The rows a viewport `height` tall scrolled by `offset` shows out of `count` rows
/// `rowHeight` tall, with `overscan` more on each side.
pub fn visibleRows(
  count: usize,
  rowHeight: f32,
  height: f32,
  offset: f32,
  overscan: usize,
) -> Window {
  if count == 0 || rowHeight <= 0.0 {
    return Window { first: 0, end: 0 }
  }
  let top = f32.max(offset, 0.0)
  let firstShown = f32.toUsize(f32.floor(top / rowHeight))
  let lastShown = f32.toUsize(f32.ceil((top + height) / rowHeight))
  let first = if firstShown > overscan {
    firstShown - overscan
  } else {
    0
  }
  let mut end = lastShown + overscan
  if end > count {
    end = count
  }
  return Window {
    first: if first > end {
      end
    } else {
      first
    },
    end: end,
  }
}

/// A list of `count` rows, each `rowHeight` tall, in a box `height` tall that scrolls: only the
/// rows in view (and a few around them) exist, so it costs the same for ten rows or a million.
/// The model keeps the scroll offset: the list sends `onScroll(offset)` as it scrolls and the
/// view passes `offset` back. `row(ui, index)` builds row `index`'s content.
pub fn virtualList<M>(
  ui: &mut Ui<M>,
  theme: &Theme,
  label: string,
  count: usize,
  rowHeight: f32,
  height: f32,
  offset: f32,
  onScroll: fn(f32) -> M,
  row: fn(&mut Ui<M>, usize) -> (),
) -> () {
  let window = visibleRows(count, rowHeight, height, offset, 4)
  ui.column(
    |ui| {
      ui.accessRole(Role.List)
      ui.label(label)
      ui.height(px(height))
      ui.style(
        &[
          css.overflowY(Overflow.Auto),
          css.overflowX(Overflow.Hidden),
          css.flexShrink(0.0),
        ],
      )
      border(&mut ui, 1.0, theme.border, theme.radius)
      ui.background(theme.surface)
      ui.on(EventKind.Scroll, |event| Reply<M>.Emit { message: onScroll(event.y) })

      // The space above and below the rows that exist.
      ui.box(
        |ui| {
          ui.style(
            &[
              css.height(px(usize.toF32(window.first) * rowHeight)),
              css.flexShrink(0.0),
            ],
          )
        },
      )
      let mut index = window.first
      while index < window.end {
        ui.key(usize.toU64(index))
        ui.row(
          |ui| {
            ui.accessRole(Role.ListItem)
            ui.style(
              &[
                css.height(px(rowHeight)),
                css.flexShrink(0.0),
                css.alignItems(Align.Center),
              ],
            )
            padding2(&mut ui, 0.0, 10.0)
            row(&mut ui, index)
          },
        )
        index = index + 1
      }
      ui.box(
        |ui| {
          ui.style(
            &[
              css.height(px(usize.toF32(count - window.end) * rowHeight)),
              css.flexShrink(0.0),
            ],
          )
        },
      )
    },
  )
}
