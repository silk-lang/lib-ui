//! A shell for a page: line editing and a few commands, enough to show the terminal's
//! colors, styles, scrollback and selection with no process behind it.
import ui_app.font { Font, Fonts }
import ghostty_vt.terminal { GhosttyError }
import ui_ghostty.view { TerminalView, TerminalMessage, Options, Outgoing }
import ui_app.css
import ui_app.css { percent, px, BoxSizing }
import ui_app.lib { Document, Node, NoCommand, NoOutput, Program, Subscriptions, Update }
import silk.color.rgba { Rgba }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.u32
import silk.core.result { Result }
import silk.text.string { String, InvalidUtf8 }

/// The font the terminal draws with: the first monospace font installed.
pub const MONO: Font = Font.of(
  "ui-monospace, SF Mono, Menlo, Cascadia Mono, Consolas, JetBrains Mono, DejaVu Sans Mono, Liberation Mono, monospace",
)

const PROMPT: string = "\x1b[1;36mghostty\x1b[0m:\x1b[1;34m~\x1b[0m$ "

pub union Message {
  Term { pub message: TerminalMessage },
  Tick,
}

pub struct WebShell {
  view: TerminalView,
  line: String,
}

type Next = Update<WebShell, NoCommand, NoOutput>

effect fn noView(error: GhosttyError) -> TerminalView {
  drop error
  return Intrinsic.trap("ui-ghostty-web: could not make a terminal")
}

effect fn say(view: &mut TerminalView, text: string) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run view.write(String.utf8Bytes(text))
}

/// `value` in decimal.
effect fn number(text: &mut String, value: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if value >= 10 {
    run number(&mut text, value / 10)
  }
  let digit = u32.toUsize(value % 10)
  run text.append(String.slice("0123456789", digit, 1))
}

/// The first word of `line` and the rest.
fn word(line: string) -> string {
  let bytes = String.utf8Bytes(line)
  let mut i: usize = 0
  while i < bytes.length && bytes[i] != 32 {
    i = i + 1
  }
  return String.slice(line, 0, i)
}

fn rest(line: string) -> string {
  let bytes = String.utf8Bytes(line)
  let mut i: usize = 0
  while i < bytes.length && bytes[i] != 32 {
    i = i + 1
  }
  while i < bytes.length && bytes[i] == 32 {
    i = i + 1
  }
  return String.slice(line, i, bytes.length - i)
}

fn parse(text: string) -> u32 {
  let bytes = String.utf8Bytes(text)
  let mut value: u32 = 0
  let mut i: usize = 0
  while i < bytes.length && bytes[i] >= 48 && bytes[i] <= 57 && value < 100000 {
    value = value * 10 + u8.toU32(bytes[i] - 48)
    i = i + 1
  }
  return value
}

effect fn colors(out: &mut String) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run out.append("The 16 colors:\r\n")
  let mut i: u32 = 0
  while i < 16 {
    run out.append("\x1b[48;5;")
    run number(&mut out, i)
    run out.append("m  ")
    if i == 7 {
      run out.append("\x1b[0m\r\n")
    }
    i = i + 1
  }
  run out.append("\x1b[0m\r\n\r\nThe 6x6x6 cube:\r\n")
  i = 16
  while i < 232 {
    run out.append("\x1b[48;5;")
    run number(&mut out, i)
    run out.append("m ")
    if (i - 16) % 36 == 35 {
      run out.append("\x1b[0m\r\n")
    }
    i = i + 1
  }
  run out.append("\r\nTrue color:\r\n")
  i = 0
  while i < 72 {
    let red = 255 - i * 255 / 71
    let green = i * 255 / 71
    run out.append("\x1b[48;2;")
    run number(&mut out, red)
    run out.append(";")
    run number(&mut out, green)
    run out.append(";128m ")
    i = i + 1
  }
  run out.append("\x1b[0m\r\n\r\n")
  run out.append(
    "\x1b[1mbold\x1b[0m \x1b[2mfaint\x1b[0m \x1b[3mitalic\x1b[0m \x1b[4munderline\x1b[0m "
  )
  run out.append(
    "\x1b[9mstrike\x1b[0m \x1b[7minverse\x1b[0m \x1b[31mred\x1b[0m \x1b[32mgreen\x1b[0m \x1b[33myellow\x1b[0m \x1b[34mblue\x1b[0m\r\n"
  )
  run out.append("Wide text: 日本語の文字と絵文字 🎉 sit in two cells each.\r\n")
}

effect fn execute(view: &mut TerminalView, line: string) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let command = word(line)
  let mut out = String.make()
  if command == "" {
  } else if command == "help" {
    run out.append("This page runs libghostty-vt in WebAssembly and draws the screen with DOM nodes.\r\n")
    run out.append("There is no process behind it, so a few commands are built in:\r\n\r\n")
    run out.append("  \x1b[1mcolors\x1b[0m     the palette, true color and text styles\r\n")
    run out.append("  \x1b[1mseq\x1b[0m N      count to N, to fill the scrollback\r\n")
    run out.append("  \x1b[1mecho\x1b[0m TEXT  print TEXT\r\n")
    run out.append("  \x1b[1mclear\x1b[0m      clear the screen (or Ctrl+L)\r\n\r\n")
    run out.append("Drag to select (twice for a word, three times for a line), scroll with the wheel.\r\n")
  } else if command == "colors" {
    run colors(&mut out)
  } else if command == "seq" {
    let count = parse(rest(line))
    let mut i: u32 = 1
    while i <= count {
      run number(&mut out, i)
      run out.append("\r\n")
      i = i + 1
    }
  } else if command == "echo" {
    run out.append(rest(line))
    run out.append("\r\n")
  } else if command == "clear" {
    run out.append("\x1b[H\x1b[2J\x1b[3J")
  } else {
    run out.append(command)
    run out.append(": command not found; try \x1b[1mhelp\x1b[0m\r\n")
  }
  run out.append(PROMPT)
  run say(&mut view, out.view())
}

/// The line discipline: echo, Backspace, Enter, Ctrl+C, Ctrl+L. Other control sequences
/// (arrows, function keys) are ignored.
effect fn typed(model: &mut WebShell, bytes: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let all = String.fromUtf8(bytes) |> Result<string, InvalidUtf8>.unwrapOr("")
  let mut echo = String.make()
  let mut i: usize = 0
  while i < bytes.length {
    let byte = bytes[i]
    if byte == 13 {
      run say(&mut model.view, echo.view())
      echo.clear()
      run say(&mut model.view, "\r\n")
      let line = run String.copy(model.line.view())
      model.line.clear()
      run execute(&mut model.view, line.view())
    } else if byte == 127 || byte == 8 {
      // One whole character, however many bytes it took.
      let mut length = String.byteLength(model.line.view())
      if length > 0 {
        let raw = String.utf8Bytes(model.line.view())
        length = length - 1
        while length > 0 && u8.bitAnd(raw[length], 192) == 128 {
          length = length - 1
        }
        let kept = run String.copy(String.slice(model.line.view(), 0, length))
        model.line = move kept
        run echo.append("\x08 \x08")
      }
    } else if byte == 3 {
      model.line.clear()
      run echo.append("^C\r\n")
      run echo.append(PROMPT)
    } else if byte == 12 {
      model.line.clear()
      run echo.append("\x1b[H\x1b[2J")
      run echo.append(PROMPT)
    } else if byte == 27 {
      // Skip an escape sequence: ESC [ ... final byte, or ESC O x.
      i = i + 1
      if i < bytes.length && (bytes[i] == 91 || bytes[i] == 79) {
        i = i + 1
        while i < bytes.length && (bytes[i] < 64 || bytes[i] > 126) {
          i = i + 1
        }
      }
    } else if byte >= 32 {
      let start = i
      while i + 1 < bytes.length && bytes[i + 1] >= 32 && bytes[i + 1] != 127 {
        i = i + 1
      }
      let text = String.slice(all, start, i + 1 - start)
      run model.line.append(text)
      run echo.append(text)
    }
    i = i + 1
  }
  run say(&mut model.view, echo.view())
}

fn background() -> Rgba<f32> {
  let hex = Options.defaults(MONO).background
  let r = u32.toF32(u32.bitAnd(u32.shiftRight(hex, 16), 255)) / 255.0
  let g = u32.toF32(u32.bitAnd(u32.shiftRight(hex, 8), 255)) / 255.0
  let b = u32.toF32(u32.bitAnd(hex, 255)) / 255.0
  return Rgba<f32> { r: r, g: g, b: b, a: 1.0 }
}

impl Program<Message, NoCommand> for WebShell {
  effect fn init() -> Next
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut view = run Effect.catch<GhosttyError>(
      TerminalView.make(80, 24, Options.defaults(MONO)),
      noView,
    )
    run say(&mut view, "\x1b[1mlibghostty-vt\x1b[0m on the Silk UI tree, in your browser. Type \x1b[1mhelp\x1b[0m.\r\n\r\n")
    run say(&mut view, PROMPT)
    drop view.take()
    return Next.of(WebShell { view: move view, line: String.make() })
  }

  effect fn update(mut model: WebShell, message: Message) -> Next
    ! OutOfMemoryError
    ? &mut Allocator {
    match move message {
      Message.Term { message: inner } => {
        run model.view.update(move inner)
      }
      Message.Tick => {
        run model.view.update(TerminalMessage.Ticked)
      }
    }
    let mut out = model.view.take()
    while out.length() > 0 {
      match out.remove(0) {
        Outgoing.Send { bytes } => {
          run typed(&mut model, bytes.asSlice())
        }
        Outgoing.Copy { text: _text } => {}
        Outgoing.Resize { columns: _columns, rows: _rows } => {}
        Outgoing.Title { text: _title } => {}
      }
    }
    return Next.of(move model)
  }

  fn view(model: &WebShell, h: &Document<Message>) -> Node {
    return h.box(
      &[
        h.style(
          &[
            css.width(percent(100.0)),
            css.height(percent(100.0)),
            css.boxSizing(BoxSizing.BorderBox),
            css.padding(px(8.0)),
            css.backgroundColor(background()),
          ],
        ),
      ],
      &[
        h.map(
          |inner: &Document<TerminalMessage>| model.view.view(inner),
          |message| Message.Term { message: move message },
        ),
      ],
    )
  }

  fn subscriptions(model: &WebShell, subs: &mut Subscriptions<Message>) -> () {
    if model.view.autoscrolling() {
      subs.every(1, 0.05, |_time| Message.Tick)
    }
  }

  fn fonts(model: &WebShell, fonts: &mut Fonts) -> () {
    fonts.family(MONO)
  }
}
