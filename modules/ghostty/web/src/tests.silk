//! The page's program on a tree, natively: `silk test --manifest-path modules/ghostty/web/silk.toml --root src/tests.silk`.
import shell { WebShell, Message }
import ui_app.lib { NoCommand }
import ui_app.program as program
import ui_app.runtime { pump }
import ui_app.harness { press, typeText, snapshot }
import ui_tree.legacy { UiTree, TreeError, FrameInput }
import ui_fixtures.fixtures as fixtures
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }

fn viewport() -> FrameInput {
  return FrameInput { width: 640.0, height: 360.0, scale: 1.0, time: 0.0 }
}

effect fn body() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut app = run program.make<WebShell, Message, NoCommand>()
  run app.start(&mut tree, 0.0)
  let mut i = 0
  while i < 4 {
    run tree.frame(viewport())
    drop run pump(&mut app, &mut tree)
    i = i + 1
  }
  run typeText(&mut app, &mut tree, viewport(), "echo hi there")
  run press(&mut app, &mut tree, viewport(), "Enter", 0)
  let text = run snapshot(&mut tree, viewport())
  run Testing.expect(String.contains(text.view(), "hi there"), "the built-in shell answers")
}

test effect fn shellAnswers() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run body() |> Effect.provideMut<Allocator>(&mut allocator)
}
