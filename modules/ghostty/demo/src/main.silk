//! A simple terminal: the user's shell on a PTY, in a native window.
//!
//! Select with the mouse (two clicks a word, three a line, Alt-drag a block), scroll back with
//! the wheel or Shift+PageUp, copy and paste with Cmd+C / Cmd+V on macOS or Ctrl+Shift+C /
//! Ctrl+Shift+V elsewhere. Resize the window and the shell's grid follows.
import app { TerminalApp, Message, Command }
import ui_app.lib { Shell }
import ui_app_window.program { Launched, Window, failed, launch, show, systemFonts }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

effect fn terminal(platform: Option<Launched>) -> i32
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut window = run Window.make("Terminal", 820.0, 520.0)
  let mut shell = window.shell()
  let fonts = run systemFonts()
  return run show<TerminalApp, Message, Command, &mut Shell | &mut Allocator>(
    move window,
    &fonts,
    move platform,
  )
    |> Effect.provideMut<Shell>(&mut shell)
}

fn start(platform: Option<Launched>) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(terminal(move platform), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

pub fn main() -> i32 {
  return launch(
    fn(platform: Option<Launched>) -> i32 {
      return start(move platform)
    },
  )
}
