//! Chooses the native inputs that `[native]` cannot express.
//!
//! - WebAssembly links the archive `scripts/prepare --wasm` builds: `[native].link`'s `os`
//!   filter has no value for a browser.
//! - Windows links the bridge that `scripts/prepare` compiles there: Clang, given the
//!   extended-length path Silk passes on Windows, finds no header beside the file.
//! - Everywhere else compiles the bridge here.
import silk.build.plan { Plan }

static fn plan() -> string<'static> {
  let mut plan = Plan.empty()
  static if Intrinsic.targetOperatingSystem() != "windows" {
    plan = Plan.compileC(plan, "native/bridge.c")
    plan = Plan.compileC(plan, "native/input.c")
  }
  static if Intrinsic.targetArchitecture() == "wasm32" {
    plan = Plan.linkArchive(plan, "native/build/wasm32/libghostty-vt.a")
  }
  return plan
}

pub const PLAN: string = plan()
