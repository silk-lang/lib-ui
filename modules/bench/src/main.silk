effect fn views(r: &mut Run<'_>, name: string, step: ViewStep, shape: Shape) -> ()
  ! TreeError | OutOfMemoryError | WriterError
  ? &mut Allocator | &mut MonotonicClock | &mut Writer {
  if r.wants(name) {
    let mut bench = run Views.make(r.fonts, step, shape)
    run r.report(name, &mut bench)
  }
}

effect fn all(r: &mut Run<'_>) -> ()
  ! TreeError | OutOfMemoryError | WriterError
  ? &mut Allocator | &mut MonotonicClock | &mut Writer {
  run Writer.writeString("benchmark                                                       median      least       ops\n")
  run lifetime(&mut r, "trees::Lifetime.build[Tiles=2000]", LifetimeStep.Build)
  run lifetime(&mut r, "trees::Lifetime.attach[Tiles=2000]", LifetimeStep.Attach)
  run lifetime(&mut r, "trees::Lifetime.attach_top_down[Tiles=2000]", LifetimeStep.AttachTopDown)
  run lifetime(&mut r, "trees::Lifetime.lay_out[Tiles=2000]", LifetimeStep.LayOut)
  run lifetime(&mut r, "trees::Lifetime.detach[Tiles=2000]", LifetimeStep.Detach)
  run lifetime(&mut r, "trees::Lifetime.clear[Tiles=2000]", LifetimeStep.Clear)
  run lifetime(&mut r, "trees::Lifetime.first_frame[Tiles=2000]", LifetimeStep.FirstFrame)
  run propagation(&mut r, "trees::Propagation.font_family[Tiles=2000]", Change.FontFamily)
  run propagation(&mut r, "trees::Propagation.font_weight[Tiles=2000]", Change.FontWeight)
  run propagation(&mut r, "trees::Propagation.is_visible[Tiles=2000]", Change.Visible)
  run propagation(&mut r, "trees::Propagation.flow_direction[Tiles=2000]", Change.Direction)
  run propagation(&mut r, "trees::Propagation.font_size[Tiles=2000]", Change.FontSize)
  run propagation(&mut r, "trees::Propagation.foreground[Tiles=2000]", Change.Color)
  run labels(&mut r, "trees::Text.create_and_measure[Labels=2000]", TextStep.CreateAndMeasure)
  run labels(&mut r, "trees::Text.change_and_lay_out[Labels=2000]", TextStep.ChangeAndLayOut)
  run labels(&mut r, "trees::Text.narrow_and_lay_out[Labels=2000]", TextStep.NarrowAndLayOut)
  run panels(&mut r, "layout_subsystem::PanelMeasureArrange.stack_vertical", Panel.StackVertical)
  run panels(&mut r, "layout_subsystem::PanelMeasureArrange.stack_horizontal", Panel.StackHorizontal)
  run panels(&mut r, "layout_subsystem::PanelMeasureArrange.grid", Panel.Grid)
  run panels(&mut r, "layout_subsystem::PanelMeasureArrange.wrap", Panel.Wrap)
  run panels(&mut r, "layout_subsystem::PanelMeasureArrange.canvas", Panel.Canvas)
  run panels(&mut r, "layout_subsystem::PanelMeasureArrange.uniform_grid", Panel.UniformGrid)
  run invalidation(&mut r, "layout_subsystem::Invalidation.resize_one_leaf[Leaves=4000]", InvalidationStep.ResizeOneLeaf)
  run invalidation(&mut r, "layout_subsystem::Invalidation.measure_every_leaf[Leaves=4000]", InvalidationStep.MeasureEveryLeaf)
  run nested(&mut r, "layout_subsystem::NestedDepth.remeasure_rearrange[Depth=200]", DepthStep.RemeasureRearrange)
  run nested(&mut r, "layout_subsystem::NestedDepth.leaf_resized[Depth=200]", DepthStep.LeafResized)
  run sizes(&mut r, "layout_subsystem::SizeChange.wrap", Sized.Wrap)
  run sizes(&mut r, "layout_subsystem::SizeChange.stretch_stack", Sized.StretchStack)
  run sizes(&mut r, "layout_subsystem::SizeChange.star_grid", Sized.StarGrid)
  run sizes(&mut r, "layout_subsystem::SizeChange.canvas", Sized.Canvas)
  run views(&mut r, "declarative::ViewBenchmark.mount_list_run_once", ViewStep.MountList, Shape.List)
  run views(&mut r, "declarative::ViewBenchmark.run_unchanged", ViewStep.RunUnchanged, Shape.List)
  run views(&mut r, "declarative::ViewBenchmark.run_one_row_changed", ViewStep.RunOneRowChanged, Shape.List)
  run views(&mut r, "declarative::ViewBenchmark.move_one_row", ViewStep.MoveOneRow, Shape.List)
  run views(&mut r, "declarative::ViewBenchmark.reverse_rows", ViewStep.ReverseRows, Shape.List)
  run views(&mut r, "declarative::ViewBenchmark.run_parent_of_components[always]", ViewStep.RunParentOfComponents, Shape.Components)
  run views(&mut r, "declarative::ViewBenchmark.run_parent_of_components[memoized by default]", ViewStep.RunParentOfComponents, Shape.Memoized)
}

effect fn application() -> i32
  ! TreeError | OutOfMemoryError | WriterError | HostInputError
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut stdout = StdoutWriter.make()
  let mut clock = OsMonotonicClock.make()
  let arguments = run HostInput.arguments() |> Effect.provideMut<Allocator>(&mut allocator)
  let fonts = run fixtures.fonts() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut r = Run {
    fonts: &fonts,
    settings: Settings.standard(),
    filters: List<String>.make(),
    out: String.make(),
    ran: 0,
  }
  let mut i: usize = 1
  while i < arguments.length() {
    let bytes = arguments.asSlice()[i].asSlice()
    let text = unsafe String.fromUtf8Unchecked(bytes)
    if text == "--smoke" {
      r.settings = Settings.smokeOnly()
    } else if text == "--quick" {
      r.settings = Settings.quick()
    } else {
      let copy = run String.copy(text) |> Effect.provideMut<Allocator>(&mut allocator)
      run r.filters.append(move copy) |> Effect.provideMut<Allocator>(&mut allocator)
    }
    i = i + 1
  }
  run all(&mut r)
    |> Effect.provideMut<Allocator>(&mut allocator)
    |> Effect.provideMut<MonotonicClock>(&mut clock)
    |> Effect.provideMut<Writer>(&mut stdout)
  if r.ran == 0 {
    return 1
  }
  return 0
}

effect fn failed(error: TreeError | OutOfMemoryError | WriterError | HostInputError) -> i32 {
  drop error
  let mut stderr = StderrWriter.make()
  let written = run Writer.writeString("ui-bench: a benchmark failed to run\n")
    |> Effect.provideMut<Writer>(&mut stderr)
    |> Effect.result
  drop written
  return 1
}

pub effect fn main() -> i32
  ? &mut HostInput {
  return run application() |> Effect.catchAll(failed)
}
