//! Runs the lib-ui benchmarks and prints a table of the time of one operation of each.
//!
//! ```sh
//! silk run --release --manifest-path modules/bench/silk.toml               # every benchmark
//! silk run --release --manifest-path modules/bench/silk.toml -- Lifetime   # names containing it
//! silk run --release --manifest-path modules/bench/silk.toml -- --quick    # shorter samples
//! silk run --manifest-path modules/bench/silk.toml -- --smoke              # each body once
//! ```
//!
//! The names are FerroUI's (`category::Class.benchmark[parameters]`), so the two tables can
//! be read side by side; see the README for what each operation includes.
import harness { Bench, Settings, measure, duration, decimal, pad }
import trees {
  Lifetime,
  LifetimeStep,
  Propagation,
  Change,
  Labels,
  TextStep,
  Panels,
  Panel,
  Invalidation,
  InvalidationStep,
  Nested,
  DepthStep,
  SizeChange,
  Sized
}
import views { Views, ViewStep, Shape }
import walls { Fixture }
import ui_fixtures.fixtures as fixtures
import ui_tree.lib { TreeError }
import font_collection.lib { FontCollection }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter, StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.host_input { HostInput, HostInputError }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.text.string { String }

struct Run<'f> {
  fonts: &'f FontCollection,
  settings: Settings,
  filters: List<String>,
  out: String,
  ran: usize,
}

impl<'f> Run<'f> {
  fn wants(self: &Self, name: string) -> bool {
    if self.filters.length() == 0 {
      return true
    }
    let mut i: usize = 0
    while i < self.filters.length() {
      if String.contains(name, String.view(&self.filters.asSlice()[i])) {
        return true
      }
      i = i + 1
    }
    return false
  }

  effect fn fixture(self: &Self) -> Fixture<'f>
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    return run Fixture.make(self.fonts)
  }

  effect fn report<B: Bench>(self: &mut Self, name: string, bench: &mut B) -> ()
    ! TreeError | OutOfMemoryError | WriterError
    ? &mut Allocator | &mut MonotonicClock | &mut Writer {
    let result = run measure(&mut bench, self.settings)
    let mut line = String.make()
    run line.append(name)
    run pad(&mut line, 0, 64)
    let at = line.ownedByteLength()
    run duration(&mut line, result.median)
    run pad(&mut line, at, 12)
    let least = line.ownedByteLength()
    run duration(&mut line, result.least)
    run pad(&mut line, least, 12)
    run decimal(&mut line, u64.toI64(result.operations))
    run line.append("\n")
    run Writer.writeString(String.view(&line))
    self.ran = self.ran + 1
  }
}

import silk.num.u64

effect fn lifetime(r: &mut Run<'_>, name: string, step: LifetimeStep) -> ()
  ! TreeError | OutOfMemoryError | WriterError
  ? &mut Allocator | &mut MonotonicClock | &mut Writer {
  if r.wants(name) {
    let mut bench = Lifetime.make(run r.fixture(), step)
    run r.report(name, &mut bench)
  }
}

effect fn propagation(r: &mut Run<'_>, name: string, change: Change) -> ()
  ! TreeError | OutOfMemoryError | WriterError
  ? &mut Allocator | &mut MonotonicClock | &mut Writer {
  if r.wants(name) {
    let mut bench = run Propagation.make(run r.fixture(), change)
    run r.report(name, &mut bench)
  }
}

