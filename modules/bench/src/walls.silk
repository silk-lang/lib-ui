//! The scenes the tree benchmarks share: a 1280 x 820 root, a wall of small tiles placed
//! absolutely (each a rounded box with a label, a dot and a value: six nodes), and leaves.
//! The tile wall follows the `trees` fixture of FerroUI's benchmarks (scenario and sizes
//! only), in CSS: a Border is a box, a StackPanel a flex box, a TextBlock a text node, Canvas
//! placement absolute `left`/`top`.
import ui_tree.css
import ui_tree.css { px, Keyword, Declaration }
import ui_tree.lib {
  Tree,
  TreeError,
  Viewport,
  BoxNode,
  TextNode,
  FontFamily,
  FlexDirection,
  Position,
  Overflow,
  Align
}
import font_collection.lib { FontCollection }
import layout.lib { InvalidNode }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.color.rgba { Rgba }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.usize
import silk.text.string { String }

pub const WIDTH: f32 = 1280.0

pub const HEIGHT: f32 = 820.0

pub const TILES: usize = 2000

pub fn viewport() -> Viewport {
  return Viewport { width: WIDTH, height: HEIGHT, scale: 1.0 }
}

pub fn rgb(r: f32, g: f32, b: f32) -> Rgba<f32> {
  return Rgba<f32> { r: r, g: g, b: b, a: 1.0 }
}

pub fn label() -> Rgba<f32> {
  return rgb(1.0, 1.0, 1.0)
}

pub fn blue() -> Rgba<f32> {
  return rgb(0.118, 0.251, 0.686)
}

pub fn red() -> Rgba<f32> {
  return rgb(0.863, 0.149, 0.149)
}

pub fn teal() -> Rgba<f32> {
  return rgb(0.059, 0.463, 0.431)
}

/// `value` with at least `width` digits.
pub effect fn digits(value: usize, width: usize) -> String ! OutOfMemoryError ? &mut Allocator {
  let mut out = String.make()
  let mut buffer: [u8; 20] = [0; 20]
  let mut count: usize = 0
  let mut rest = value
  while count < width || rest != 0 {
    buffer[count] = usize.toU8(rest % 10) + 48
    count = count + 1
    rest = rest / 10
  }
  while count > 0 {
    count = count - 1
    let one: [u8; 1] = [buffer[count]]
    run out.append(unsafe String.fromUtf8Unchecked(&one))
  }
  return move out
}

/// A tree whose root fills the viewport, laid out once.
pub struct Fixture<'a> {
  pub tree: Tree<'a>,
  pub root: BoxNode,
  pub family: FontFamily,
  pub time: f64,
}

impl<'a> Fixture<'a> {
  pub effect fn make(fonts: &'a FontCollection) -> Fixture<'a>
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut tree = run Tree.make(fonts)
    let family = run tree.fontFamily("Noto Sans, sans-serif")
    let root = run tree.box(
      &[
        css.fontFamily(family.raw()),
        css.position(Position.Relative),
        css.width(px(WIDTH)),
        css.height(px(HEIGHT)),
      ],
    )
    run tree.setRoot(root)
    let mut fixture = Fixture { tree: move tree, root: root, family: family, time: 0.0 }
    run fixture.frame()
    return move fixture
  }

  /// Lays out, paints and forgets the uploads: a whole frame.
  pub effect fn frame(self: &mut Self) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    self.time = self.time + 0.016
    drop run self.tree.frame(viewport(), self.time)
    self.tree.clearUploads()
  }

  /// Resolves styles and lays out, without painting.
  pub effect fn layOut(self: &mut Self) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.tree.layoutNow()
  }

  /// Forgets every kept layout result, as if every node's measure and arrange were invalid.
  pub effect fn invalidateLayout(self: &mut Self) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let engine = self.tree.engineMut()
    engine.output.invalidate()
    let top = engine.layout.root()
    run Effect.catchAll(engine.layout.markDirty(top), ignored)
  }
}

effect fn ignored(error: InvalidNode) -> () {
  drop error
}

/// The six nodes of one tile.
pub struct Tile {
  pub tile: BoxNode,
  pub content: BoxNode,
  pub name: TextNode,
  pub line: BoxNode,
  pub spot: BoxNode,
  pub value: TextNode,
}

impl Copy for Tile {}

pub fn tileLeft(index: usize) -> f32 {
  return usize.toF32(index % 200) * 6.0
}

pub fn tileTop(index: usize) -> f32 {
  return usize.toF32(index / 200) * 5.0
}

/// The nodes of tile `index`, made but not put together.
pub effect fn tileParts(tree: &mut Tree<'_>, index: usize) -> Tile
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let height: f32 = 4.0
  let dot = height * 0.22
  let tile = run tree.box(
    &[
      css.position(Position.Absolute),
      css.left(px(tileLeft(index))),
      css.top(px(tileTop(index))),
      css.width(px(5.0)),
      css.height(px(height)),
      css.borderRadius(px(1.0)),
      css.padding(px(height * 0.06)),
      css.backgroundColor(blue()),
      css.overflow(Overflow.Hidden),
    ],
  )
  let content = run tree.box(
    &[
      css.display(Keyword.Flex),
      css.flexDirection(FlexDirection.Column),
      css.color(label()),
      css.fontSize(px(height * 0.30)),
    ],
  )
  let nameText = run digits(index, 5)
  let name = run tree.text(String.view(&nameText))
  let line = run tree.box(
    &[
      css.display(Keyword.Flex),
      css.flexDirection(FlexDirection.Row),
      css.alignItems(Align.Center),
      css.gap(px(dot * 0.5)),
      css.fontSize(px(height * 0.26)),
    ],
  )
  let spot = run tree.box(
    &[
      css.width(px(dot)),
      css.height(px(dot)),
      css.borderRadius(px(dot / 2.0)),
      css.backgroundColor(red()),
    ],
  )
  let valueText = run digits(index % 1000, 3)
  let value = run tree.text(String.view(&valueText))
  return Tile { tile: tile, content: content, name: name, line: line, spot: spot, value: value }
}

/// Puts a tile's nodes together, from the leaves up.
pub effect fn assemble(tree: &mut Tree<'_>, parts: Tile) -> ()
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  run tree.append(parts.line, parts.spot)
  run tree.append(parts.line, parts.value)
  run tree.append(parts.content, parts.name)
  run tree.append(parts.content, parts.line)
  run tree.append(parts.tile, parts.content)
}

/// A detached canvas holding `count` tiles.
pub effect fn wall(tree: &mut Tree<'_>, count: usize) -> BoxNode
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let canvas = run tree.box(
    &[
      css.position(Position.Relative),
      css.width(px(WIDTH)),
      css.height(px(HEIGHT)),
    ],
  )
  let mut i: usize = 0
  while i < count {
    let parts = run tileParts(&mut tree, i)
    run assemble(&mut tree, parts)
    run tree.append(canvas, parts.tile)
    i = i + 1
  }
  return canvas
}

/// A leaf: a fixed-size coloured box.
pub effect fn leaf(tree: &mut Tree<'_>, width: f32, height: f32, extra: &[Declaration]) -> BoxNode
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let node = run tree.box(
    &[css.width(px(width)), css.height(px(height)), css.backgroundColor(blue())],
  )
  if extra.length != 0 {
    let mut style = List<Declaration>.make()
    run style.append(css.width(px(width)))
    run style.append(css.height(px(height)))
    run style.append(css.backgroundColor(blue()))
    let mut i: usize = 0
    while i < extra.length {
      run style.append(run css.cloneDeclaration(&extra[i]))
      i = i + 1
    }
    run tree.setStyle(node, style.asSlice())
  }
  return node
}
