//! Rich text in an input: styled runs and inline atoms over its value.
//!
//! The value stays one string. An atom (a mention, a chip) sits in it as one
//! [`OBJECT`] character, so the caret steps over it as one unit and every offset is still a
//! UTF-8 byte offset into the value. Marks are bits: what each one looks like is the
//! client's, set with `Mutation.DefineMark`.
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

/// U+FFFC OBJECT REPLACEMENT CHARACTER: where an atom sits in an input's value.
pub const OBJECT: string<'static> = "\u{fffc}"

/// The marks of the value bytes [`start`, `end`), as bits (bit `n` for mark `n`).
pub struct MarkSpan {
  pub start: usize,
  pub end: usize,
  pub marks: u32,
}

impl Copy for MarkSpan {}

/// An inline atom: `kind` picks its look (`Mutation.DefineAtom`), `label` is the text it
/// shows, and `data` is the client's own (an id, a path).
pub struct Atom {
  pub kind: u32,
  pub label: String,
  pub data: String,
}

impl Atom {
  pub effect fn copy(self: &Self) -> Atom
    ! OutOfMemoryError
    ? &mut Allocator {
    return Atom {
      kind: self.kind,
      label: run String.copy(String.view(&self.label)),
      data: run String.copy(String.view(&self.data)),
    }
  }
}
