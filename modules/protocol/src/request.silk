//! What a tree asks of its host.
import silk.text.string { String }

/// Something the tree asks of its host, which owns the clipboard and loads files. Drain them
/// with `UiTree.takeRequests` after dispatching input and after each frame.
pub union HostRequest {
  /// Put `text` on the clipboard (copy and cut).
  WriteClipboard { pub text: String },
  /// Read the clipboard and answer with `Input.Paste { target, text }` (paste).
  ReadClipboard { pub target: u32 },
  /// Load the file of declared font face `face`: text laid out needs a character its
  /// `unicode-range` covers. Answer with `UiTree.loadFontFace`, or `UiTree.failFontFace` when
  /// it cannot load; the text draws with a fallback until then.
  LoadFontFace { pub face: u32 },
}
