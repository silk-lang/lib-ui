//! Option structs that mutations carry.
import silk.core.ownership { Copy }

/// Placement preferences for a popup in logical viewport pixels.
pub struct AnchorOptions {
  /// Distance between the anchor and popup.
  pub gap: f32,
  /// Height used to choose whether the popup opens above or below its anchor.
  pub preferredHeight: f32,
  /// Aligns the popup to the anchor's right edge.
  pub alignEnd: bool,
  /// Keeps the popup at least as wide as its anchor, within viewport limits.
  pub matchWidth: bool,
}

impl Copy for AnchorOptions {}

/// Configuration for a vertical list with measured item heights.
pub struct VirtualOptions {
  /// Estimated height of each unmeasured item, in CSS pixels. Must be finite and positive.
  pub estimatedHeight: f32,
  /// Extra content mounted above and below the viewport, in CSS pixels. Must be finite and nonnegative.
  pub overscan: f32,
  /// Space after each item, in CSS pixels. Must be finite and nonnegative.
  pub gap: f32,
  /// Change this value when item order or size-affecting content changes.
  pub revision: u64,
}

impl Copy for VirtualOptions {}

/// One mounted client node and its logical item index.
pub struct VirtualItem {
  /// Logical item index.
  pub index: usize,
  /// Client node ID of a direct child box of the virtual scroll container.
  pub id: u32,
}

impl Copy for VirtualItem {}
