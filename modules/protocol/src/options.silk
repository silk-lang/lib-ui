//! Option structs that mutations carry.
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.geometry.point { Point2 }
import silk.geometry.size { Size2 }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

/// What a root asks to be. A backend gives what it has (see `RootSupport`).
pub enum RootKind {
  /// A top-level window of its own.
  Window,
  /// A window that belongs to its parent root, such as a palette or a tool window.
  Panel,
  /// A surface inside another root or a host element, with no window of its own.
  Embedded,
}

/// What a client asks of a root. Every field is a request: what the system applied comes back
/// as root events (`ui_protocol.root`).
pub struct RootOptions {
  /// The window title; empty for none.
  pub title: String,
  /// The content size in CSS pixels, or None for the backend's choice.
  pub size: Option<Size2<f32>>,
  /// The position of the content's top left corner in screen CSS pixels, or None for the
  /// backend's choice.
  pub position: Option<Point2<f32>>,
  pub resizable: bool,
  /// The root this one belongs to, for a panel.
  pub parent: Option<u32>,
  pub kind: RootKind,
}

impl RootOptions {
  /// A resizable window with no title, placed and sized by the backend.
  pub fn default() -> RootOptions {
    return RootOptions {
      title: String.make(),
      size: Option<Size2<f32>>.None,
      position: Option<Point2<f32>>.None,
      resizable: true,
      parent: Option<u32>.None,
      kind: RootKind.Window,
    }
  }

  pub effect fn copy(self: &Self) -> RootOptions
    ! OutOfMemoryError
    ? &mut Allocator {
    return RootOptions {
      title: run String.copy(String.view(&self.title)),
      size: self.size,
      position: self.position,
      resizable: self.resizable,
      parent: self.parent,
      kind: self.kind,
    }
  }
}

/// Placement preferences for a popup in logical viewport pixels.
pub struct AnchorOptions {
  /// Distance between the anchor and popup.
  pub gap: f32,
  /// Height used to choose whether the popup opens above or below its anchor.
  pub preferredHeight: f32,
  /// Aligns the popup to the anchor's right edge.
  pub alignEnd: bool,
  /// Keeps the popup at least as wide as its anchor, within viewport limits.
  pub matchWidth: bool,
}

impl Copy for AnchorOptions {}

/// Configuration for a vertical list with measured item heights.
pub struct VirtualOptions {
  /// Estimated height of each unmeasured item, in CSS pixels. Must be finite and positive.
  pub estimatedHeight: f32,
  /// Extra content mounted above and below the viewport, in CSS pixels. Must be finite and nonnegative.
  pub overscan: f32,
  /// Space after each item, in CSS pixels. Must be finite and nonnegative.
  pub gap: f32,
  /// Change this value when item order or size-affecting content changes.
  pub revision: u64,
}

impl Copy for VirtualOptions {}

/// One mounted client node and its logical item index.
pub struct VirtualItem {
  /// Logical item index.
  pub index: usize,
  /// Client node ID of a direct child box of the virtual scroll container.
  pub id: u32,
}

impl Copy for VirtualItem {}
