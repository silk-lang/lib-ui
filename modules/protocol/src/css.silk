//! The CSS vocabulary clients build styles with, re-exported from css-properties so a client
//! needs one import. `css.width(css.px(120.0))` is the declaration `width: 120px`.
//!
//! ```silk
//! import ui_tree.css
//! import ui_tree.css { px, percent }
//!
//! let style = [css.display(Keyword.Flex), css.width(percent(100.0)), css.paddingTop(px(8.0))]
//! ```
