pub import properties.catalog { Property }
import properties.catalog
import properties.values
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// Whether every longhand of `inner` is also a longhand of `outer`. A property covers itself.
pub fn covers(outer: Property, inner: Property) -> bool {
  let innerCount = catalog.longhandCount(inner)
  let outerCount = catalog.longhandCount(outer)
  let mut i: usize = 0
  while i < innerCount {
    let wanted = catalog.longhandAt(inner, i)
    let mut found = false
    let mut j: usize = 0
    while j < outerCount {
      if catalog.longhandAt(outer, j) == wanted {
        found = true
        break
      }
      j = j + 1
    }
    if !found {
      return false
    }
    i = i + 1
  }
  return true
}

/// Whether `property` is a shorthand.
pub fn isShorthand(property: Property) -> bool {
  return catalog.longhandCount(property) > 1
}

/// Sets a copy of `declaration` in `list` the way CSSOM's `setProperty` does. A longhand
/// replaces its earlier value in place. A shorthand removes what it covers and goes last, so a
/// longhand set after a shorthand keeps overriding it and one set before it does not.
pub effect fn set(list: &mut List<Declaration>, declaration: &Declaration) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let copy = run values.cloneDeclaration(declaration)
  let property = declaration.property
  if catalog.longhandCount(property) > 1 {
    let mut i = list.length()
    while i > 0 {
      i = i - 1
      if covers(property, list.asSlice()[i].property) {
        drop list.remove(i)
      }
    }
    run list.append(move copy)
    return ()
  }
  let mut i: usize = 0
  while i < list.length() {
    if list.asSlice()[i].property == property {
      list.set(i, move copy)
      return ()
    }
    i = i + 1
  }
  run list.append(move copy)
}
