//! The accessibility attributes that have no field of their own on a wire or in markup, as
//! their ARIA attribute: a name (`aria-level`) and value text (`"2"`), the way the DOM writes
//! them. Backends that speak HTML, inspectors and script bridges share these two functions,
//! so a new attribute is added here once.
import mutation { Attribute, Role, TriState, Live, Orientation }
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.i32
import silk.num.u32
import silk.num.u8
import silk.text.string { String }

/// The ARIA name of `attribute`, with its value text appended to `value`, or None for an
/// attribute that is not one of these. Empty value text means the DOM attribute is absent,
/// as it is for each attribute's default (`aria-level` 0, `aria-live` off, `aria-pressed`
/// unset, a false flag).
pub effect fn ariaText(attribute: &Attribute, value: &mut Bytes) -> Option<string<'static>>
  ! OutOfMemoryError
  ? &mut Allocator {
  match &attribute.* {
    Attribute.Level { value: level } => {
      run number(&mut value, level)
      return Option<string<'static>>.some("aria-level")
    }
    Attribute.Description { value: text } => {
      run value.append(String.utf8Bytes(String.view(&text)))
      return Option<string<'static>>.some("aria-description")
    }
    Attribute.RoleDescription { value: text } => {
      run value.append(String.utf8Bytes(String.view(&text)))
      return Option<string<'static>>.some("aria-roledescription")
    }
    Attribute.ValueText { value: text } => {
      run value.append(String.utf8Bytes(String.view(&text)))
      return Option<string<'static>>.some("aria-valuetext")
    }
    Attribute.Hidden { value: on } => {
      run flag(&mut value, on)
      return Option<string<'static>>.some("aria-hidden")
    }
    Attribute.Live { value: live } => {
      run value.append(String.utf8Bytes(liveName(live)))
      return Option<string<'static>>.some("aria-live")
    }
    Attribute.Atomic { value: on } => {
      run flag(&mut value, on)
      return Option<string<'static>>.some("aria-atomic")
    }
    Attribute.Busy { value: on } => {
      run flag(&mut value, on)
      return Option<string<'static>>.some("aria-busy")
    }
    Attribute.Pressed { value: state } => {
      run value.append(String.utf8Bytes(triStateName(state)))
      return Option<string<'static>>.some("aria-pressed")
    }
    Attribute.Required { value: on } => {
      run flag(&mut value, on)
      return Option<string<'static>>.some("aria-required")
    }
    Attribute.Invalid { value: on } => {
      run flag(&mut value, on)
      return Option<string<'static>>.some("aria-invalid")
    }
    Attribute.MultiSelectable { value: on } => {
      run flag(&mut value, on)
      return Option<string<'static>>.some("aria-multiselectable")
    }
    Attribute.Orientation { value: orientation } => {
      run value.append(String.utf8Bytes(orientationName(orientation)))
      return Option<string<'static>>.some("aria-orientation")
    }
    Attribute.PosInSet { value: index } => {
      run number(&mut value, index)
      return Option<string<'static>>.some("aria-posinset")
    }
    Attribute.SetSize { value: size } => {
      run number(&mut value, size)
      return Option<string<'static>>.some("aria-setsize")
    }
    Attribute.Modal { value: on } => {
      run flag(&mut value, on)
      return Option<string<'static>>.some("aria-modal")
    }
    _ => {
      return Option<string<'static>>.none()
    }
  }
}

/// The attribute that ARIA attribute `name` (`aria-level`, lowercase) with value text
/// `value` sets, as [`ariaText`] writes them and as the DOM reads them: a flag is `"true"`,
/// anything else false; a number that does not parse is 0. None for a name not handled here.
pub effect fn ariaAttribute(name: &[u8], value: &[u8]) -> Option<Attribute>
  ! OutOfMemoryError
  ? &mut Allocator {
  if same(name, b"aria-level") { return Option<Attribute>.some(Attribute.Level { value: parse(value) }) }
  if same(name, b"aria-description") { return Option<Attribute>.some(Attribute.Description { value: run text(value) }) }
  if same(name, b"aria-roledescription") { return Option<Attribute>.some(Attribute.RoleDescription { value: run text(value) }) }
  if same(name, b"aria-valuetext") { return Option<Attribute>.some(Attribute.ValueText { value: run text(value) }) }
  if same(name, b"aria-hidden") { return Option<Attribute>.some(Attribute.Hidden { value: same(value, b"true") }) }
  if same(name, b"aria-live") { return Option<Attribute>.some(Attribute.Live { value: liveOf(value) }) }
  if same(name, b"aria-atomic") { return Option<Attribute>.some(Attribute.Atomic { value: same(value, b"true") }) }
  if same(name, b"aria-busy") { return Option<Attribute>.some(Attribute.Busy { value: same(value, b"true") }) }
  if same(name, b"aria-pressed") { return Option<Attribute>.some(Attribute.Pressed { value: triStateOf(value) }) }
  if same(name, b"aria-required") { return Option<Attribute>.some(Attribute.Required { value: same(value, b"true") }) }
  if same(name, b"aria-invalid") {
    // Every value but "false" ("true", "grammar", "spelling") is invalid; empty is absent.
    return Option<Attribute>.some(Attribute.Invalid { value: value.length != 0 && !same(value, b"false") })
  }
  if same(name, b"aria-multiselectable") { return Option<Attribute>.some(Attribute.MultiSelectable { value: same(value, b"true") }) }
  if same(name, b"aria-orientation") { return Option<Attribute>.some(Attribute.Orientation { value: orientationOf(value) }) }
  if same(name, b"aria-posinset") { return Option<Attribute>.some(Attribute.PosInSet { value: parse(value) }) }
  if same(name, b"aria-setsize") { return Option<Attribute>.some(Attribute.SetSize { value: parse(value) }) }
  if same(name, b"aria-modal") { return Option<Attribute>.some(Attribute.Modal { value: same(value, b"true") }) }
  return Option<Attribute>.none()
}

pub fn liveName(value: Live) -> string<'static> {
  return match value {
    Live.Off => ""
    Live.Polite => "polite"
    Live.Assertive => "assertive"
  }
}

pub fn triStateName(value: TriState) -> string<'static> {
  return match value {
    TriState.Unset => ""
    TriState.False => "false"
    TriState.True => "true"
    TriState.Mixed => "mixed"
  }
}

pub fn orientationName(value: Orientation) -> string<'static> {
  return match value {
    Orientation.Unset => ""
    Orientation.Horizontal => "horizontal"
    Orientation.Vertical => "vertical"
  }
}

fn liveOf(value: &[u8]) -> Live {
  if same(value, b"polite") { return Live.Polite }
  if same(value, b"assertive") { return Live.Assertive }
  return Live.Off
}

fn triStateOf(value: &[u8]) -> TriState {
  if same(value, b"true") { return TriState.True }
  if same(value, b"false") { return TriState.False }
  if same(value, b"mixed") { return TriState.Mixed }
  return TriState.Unset
}

fn orientationOf(value: &[u8]) -> Orientation {
  if same(value, b"horizontal") { return Orientation.Horizontal }
  if same(value, b"vertical") { return Orientation.Vertical }
  return Orientation.Unset
}

effect fn flag(out: &mut Bytes, on: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  if on { run out.append(b"true") }
}

/// Appends `value` in decimal; 0 appends nothing, the absent attribute.
effect fn number(out: &mut Bytes, value: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  if value == 0 { return () }
  if value < 0 { run out.append(b"-") }
  run digits(&mut out, if value < 0 { i32.toU32(0 - value) } else { i32.toU32(value) })
}

effect fn digits(out: &mut Bytes, value: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  if value >= 10 { run digits(&mut out, value / 10) }
  run out.append(&[u32.toU8(48 + value % 10)])
}

/// A decimal integer with an optional sign, as HTML parses one; 0 when there is none.
fn parse(value: &[u8]) -> i32 {
  let mut i: usize = 0
  let negative = value.length > 0 && value[0] == 45
  if negative || (value.length > 0 && value[0] == 43) { i = 1 }
  let mut result: i32 = 0
  while i < value.length && value[i] >= 48 && value[i] <= 57 && result < 100000000 {
    result = result * 10 + u8.toI32(value[i] - 48)
    i = i + 1
  }
  return if negative { 0 - result } else { result }
}

effect fn text(value: &[u8]) -> String ! OutOfMemoryError ? &mut Allocator {
  return run String.copy(unsafe String.fromUtf8Unchecked(value))
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] { return false }
    i = i + 1
  }
  return true
}

/// The role an HTML element has without a `role` attribute, from the HTML-AAM mappings
/// (`"h2"` is a heading, `"nav"` navigation). Tags whose role depends on attributes or on
/// where they are (`a`, `img`, `header`, `section`, `th`, `select`) are left out, as are
/// those without one (`div`, `span`): `Role.None`. `td` is a table cell.
pub fn implicitRole(tag: &[u8]) -> Role {
  if same(tag, b"button") { return Role.Button }
  if same(tag, b"h1") { return Role.Heading }
  if same(tag, b"h2") { return Role.Heading }
  if same(tag, b"h3") { return Role.Heading }
  if same(tag, b"h4") { return Role.Heading }
  if same(tag, b"h5") { return Role.Heading }
  if same(tag, b"h6") { return Role.Heading }
  if same(tag, b"p") { return Role.Paragraph }
  if same(tag, b"nav") { return Role.Navigation }
  if same(tag, b"main") { return Role.Main }
  if same(tag, b"aside") { return Role.Complementary }
  if same(tag, b"article") { return Role.Article }
  if same(tag, b"figure") { return Role.Figure }
  if same(tag, b"form") { return Role.Form }
  if same(tag, b"search") { return Role.Search }
  if same(tag, b"ul") { return Role.List }
  if same(tag, b"ol") { return Role.List }
  if same(tag, b"menu") { return Role.List }
  if same(tag, b"li") { return Role.ListItem }
  if same(tag, b"dialog") { return Role.Dialog }
  if same(tag, b"table") { return Role.Table }
  if same(tag, b"thead") { return Role.RowGroup }
  if same(tag, b"tbody") { return Role.RowGroup }
  if same(tag, b"tfoot") { return Role.RowGroup }
  if same(tag, b"tr") { return Role.Row }
  if same(tag, b"td") { return Role.Cell }
  if same(tag, b"hr") { return Role.Separator }
  if same(tag, b"progress") { return Role.ProgressBar }
  if same(tag, b"fieldset") { return Role.Group }
  if same(tag, b"details") { return Role.Group }
  if same(tag, b"output") { return Role.Status }
  if same(tag, b"textarea") { return Role.TextBox }
  if same(tag, b"option") { return Role.Option }
  return Role.None
}

/// The heading level of `h1` to `h6`; 0 for other tags.
pub fn implicitLevel(tag: &[u8]) -> i32 {
  if tag.length == 2 && tag[0] == 104 && tag[1] >= 49 && tag[1] <= 54 { return u8.toI32(tag[1] - 48) }
  return 0
}
