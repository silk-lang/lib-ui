//! The plain data a UI tree and its client exchange. Nothing here holds a tree: every value can
//! be built on one side of a wire and read on the other.
//!
//! This front door carries the typed forms: [`Input`] going in, [`EventRecord`] and
//! [`HostRequest`] coming out, node handles, and [`Propagation`] for walking an event's path.
//! The flat forms that travel as they are live in the `input`, `record` and `request` modules.
pub import id {
  NodeId,
  Node,
  Parent,
  Textual,
  Sourced,
  BoxNode,
  TextNode,
  ImageNode,
  IconNode,
  InputNode,
  CanvasNode,
  FontFamily,
  FontFaceId,
  Resource
}
pub import event {
  Input,
  Modifiers,
  Button,
  Pointer,
  Key,
  InputType,
  InputChange,
  Selection,
  Event,
  EventRecord,
  HostRequest,
  DefaultAction,
  Propagation,
  Phase,
  Step,
  listenFlags,
  listenFlag,
  preventFlags,
  bubbles
}
pub import record { EventKind }
pub import mutation { Mutation, Attribute, NodeKind, StyleState, Role, Cursor, CanvasCommand, Declaration, Value, Keyword, NOT_FOCUSABLE, FIRST_ROOT }
pub import batch { Batch }
pub import grid { Grid }
pub import options { AnchorOptions, VirtualOptions, VirtualItem, RootOptions, RootKind }
pub import root { RootEvent, RootEventKind, RootSupport, ExtraRoot }
