//! Roots: the top-level trees a client opens with `Mutation.OpenRoot`, what happens to them,
//! and what a backend can show.
//!
//! A backend maps a root to what it has: an OS window, a canvas, a host element, a document.
//! Root events tell the client what the system did with a root. They name the root; element
//! events do not need to, because the first id of their path is the root's node.
import silk.core.ownership { Copy }

/// What happened to a root.
pub union RootEventKind {
  /// The user asked to close the root's window. The root stays open until the client sends
  /// `Mutation.CloseRoot`.
  CloseRequested,
  /// The root's viewport is now `width` by `height` CSS pixels.
  Resized { pub width: f32, pub height: f32 },
  /// The root's window took the keyboard: key input goes to this root.
  Focused,
  /// The root's window lost the keyboard.
  Blurred,
  /// The root now draws at `scale` device pixels per CSS pixel.
  ScaleChanged { pub scale: f32 },
  /// The system appearance the root is shown in changed.
  AppearanceChanged { pub dark: bool },
  /// The backend could not show the root, so it is not open.
  Failed,
}

impl Copy for RootEventKind {}

/// A root event for the client.
pub struct RootEvent {
  pub root: u32,
  pub kind: RootEventKind,
}

impl Copy for RootEvent {}

impl RootEvent {
  /// Whether `other` says the same kind of thing about the same root, so it replaces this one
  /// in a queue: a resize the client has not seen yet is out of date once another comes.
  /// Focus and blur are one kind.
  pub fn replacedBy(self: &Self, other: &RootEvent) -> bool {
    if self.root != other.root {
      return false
    }
    return rootEventClass(self.kind) == rootEventClass(other.kind)
  }
}

fn rootEventClass(kind: RootEventKind) -> u32 {
  return match kind {
    RootEventKind.CloseRequested => 0
    RootEventKind.Resized { .. } => 1
    RootEventKind.Focused => 2
    RootEventKind.Blurred => 2
    RootEventKind.ScaleChanged { .. } => 3
    RootEventKind.AppearanceChanged { .. } => 4
    RootEventKind.Failed => 5
  }
}

/// What a root past the first becomes on a backend.
pub enum ExtraRoot {
  /// Nothing: opening one fails.
  None,
  /// An OS window with a render surface of its own.
  Window,
  /// A surface of its own with no window, laid out and painted on request, as a headless tree
  /// does.
  Surface,
  /// A document of its own, written when asked for by root id.
  Document,
}

/// How many roots a backend can show at once and what a root past the first becomes. The
/// first root (`FIRST_ROOT`) always opens.
pub struct RootSupport {
  pub count: u32,
  pub extra: ExtraRoot,
}

impl Copy for RootSupport {}

impl RootSupport {
  /// A backend that shows the first root only.
  pub fn single() -> RootSupport {
    return RootSupport { count: 1, extra: ExtraRoot.None }
  }

  /// Whether a root past the first, with `open` roots open already, can open.
  pub fn admits(self: Self, open: u32) -> bool {
    return self.extra != ExtraRoot.None && open < self.count
  }
}
