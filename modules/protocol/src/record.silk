//! The event record a tree queues for its client, in the flat form that travels: one struct
//! with a kind and every payload field. `event.EventRecord` is the typed reading of it.
import silk.collections.list { List }
import silk.geometry.rect { Rect }
import silk.text.string { String }

pub enum EventKind {
  PointerDown,
  PointerUp,
  Click,
  PointerMove,
  PointerEnter,
  PointerLeave,
  Wheel,
  KeyDown,
  KeyUp,
  Focus,
  Blur,
  Input,
  Scroll,
  /// The target border box changed after layout; does not bubble.
  Layout,
  /// The press ended without a release (`Input.PointerCancel`). No click follows.
  PointerCancel,
  /// The node took the pointer capture of the press (`Mutation.SetPointerCapture`).
  GotPointerCapture,
  /// The node lost a capture it took: it was released, another node took it, or the press
  /// ended.
  LostPointerCapture,
  /// A transition was created, as DOM `transitionrun`: it may still wait for its delay.
  TransitionRun,
  /// A transition left its delay, as DOM `transitionstart`.
  TransitionStart,
  /// A transition finished, as DOM `transitionend`.
  TransitionEnd,
  /// A transition was removed before it finished, as DOM `transitioncancel`.
  TransitionCancel,
  /// A keyframe animation left its delay, as DOM `animationstart`.
  AnimationStart,
  /// A keyframe animation began another iteration, as DOM `animationiteration`.
  AnimationIteration,
  /// A keyframe animation finished, as DOM `animationend`.
  AnimationEnd,
  /// A keyframe animation was removed before it finished, as DOM `animationcancel`.
  AnimationCancel,
}

/// An event record for the client. `path` holds the node ids from the root to the target, so
/// the client can run capture and bubbling over it.
///
/// Pointer down, up, move, click and wheel records and key records are queued when the target
/// or any node on its path listens for them (they bubble). Enter, leave, focus, blur and scroll
/// records are queued only for a target that listens itself.
pub struct Event {
  pub kind: EventKind,
  pub target: u32,
  /// The measured viewport-relative border box in CSS pixels, for Layout records.
  pub bounds: Rect<f32>,
  pub path: List<u32>,
  /// The pointer in CSS pixels of the viewport, for pointer and wheel records. For `Scroll`
  /// records, the container's new scroll offset.
  pub x: f32,
  pub y: f32,
  /// `MOD_*` bits.
  pub modifiers: u32,
  /// The button of pointer down, up and click records (`BUTTON_*`).
  pub button: u32,
  /// The click count of pointer down and click records: 1 for a single click, 2 for a double
  /// click, 0 for a click made with the keyboard.
  pub detail: u32,
  /// The wheel delta of `Wheel` records in CSS pixels, positive down and right.
  pub deltaX: f32,
  pub deltaY: f32,
  /// The UI Events `key` and `code` of key records.
  pub key: String,
  pub code: String,
  pub repeat: bool,
  /// The value of an input after the change an `Input` record reports.
  pub value: String,
  /// What the change was, named as DOM `InputEvent.inputType` names it: `insertText`,
  /// `insertLineBreak`, `insertFromPaste`, `deleteContentBackward`, `deleteContentForward`,
  /// `deleteWordBackward`, `deleteWordForward`, `deleteSoftLineBackward`,
  /// `deleteSoftLineForward`, `deleteByCut`, `deleteByComposition`, `historyUndo` or
  /// `historyRedo`.
  pub inputType: String,
  /// The selection of an `Input` record's input after the change: UTF-8 byte offsets into
  /// `value`, start before end.
  pub selectionStart: usize,
  pub selectionEnd: usize,
  /// The CSS property of transition records (`opacity`, `margin-top`), and the
  /// `@keyframes` name of animation records.
  pub name: String,
  /// Seconds the transition or animation had run, not counting its delay, as DOM
  /// `elapsedTime`.
  pub elapsedTime: f32,
}

impl Event {
  /// A record of `kind` for `target` with every payload field empty.
  pub fn make(kind: EventKind, target: u32, path: List<u32>) -> Event {
    return Event {
      kind: kind,
      target: target,
      bounds: Rect<f32>.new(0.0, 0.0, 0.0, 0.0),
      path: move path,
      x: 0.0,
      y: 0.0,
      modifiers: 0,
      button: 0,
      detail: 0,
      deltaX: 0.0,
      deltaY: 0.0,
      key: String.make(),
      code: String.make(),
      repeat: false,
      value: String.make(),
      inputType: String.make(),
      selectionStart: 0,
      selectionEnd: 0,
      name: String.make(),
      elapsedTime: 0.0,
    }
  }
}
