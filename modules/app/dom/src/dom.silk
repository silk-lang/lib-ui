//! [`Dom`]: the browser document as a [`Backend`]. A render's mutations go to
//! `js/silk-ui-dom.js` as one buffer; the events it hears come back one record at a time.
import wire { writeMutation, readEvent, readByte, readFloat }
import ui_app.backend { Backend, Measured, TreeError }
import ui_protocol.mutation { Mutation }
import ui_protocol.record { Event }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.geometry.rect { Rect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }

static if Intrinsic.targetArchitecture() == "wasm32" {
  @foreign(noCapture: .("bytes"))
  unsafe extern "C" fn hostApply(bytes: ?[*]const u8, length: usize) -> () as "dom#apply"

  @foreign(noCapture: .("out"))
  unsafe extern "C" fn hostMeasure(id: u32, out: ?[*]mut u8) -> u32 as "dom#measure"

  fn apply(bytes: &[u8]) -> () {
    unsafe hostApply(Pointer.fromSlice(bytes), bytes.length)
  }

  fn measureInto(id: u32, out: &mut [u8]) -> bool {
    return unsafe hostMeasure(id, Pointer.fromMutSlice(&mut out)) != 0
  }
} else {
  // No document off the browser: batches are still encoded, for tests to read.
  fn apply(bytes: &[u8]) -> () {
    return ()
  }

  fn measureInto(id: u32, out: &mut [u8]) -> bool {
    return false
  }
}

pub struct Dom {
  /// The last batch, encoded.
  pub out: Bytes,
  /// Where the host writes an event record before it calls in.
  pub scratch: Bytes,
  /// Mutations the document backend dropped since the start (see `wire`).
  pub dropped: usize,
  width: f32,
  height: f32,
  waiting: List<Event>,
}

impl Dom {
  pub fn make() -> Dom {
    return Dom {
      out: Bytes.make(),
      scratch: Bytes.make(),
      dropped: 0,
      width: 0.0,
      height: 0.0,
      waiting: List<Event>.make(),
    }
  }

  /// The viewport is now `width` by `height` CSS pixels.
  pub fn setViewport(self: &mut Self, width: f32, height: f32) -> () {
    self.width = width
    self.height = height
  }

  /// Makes room for a record of `size` bytes and returns where the host writes it.
  pub effect fn reserve(self: &mut Self, size: usize) -> usize
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.scratch.length() < size {
      self.scratch = run Bytes.zeroed(size)
    }
    return Pointer.addressMany(Pointer.fromSlice(self.scratch.asSlice()))
  }

  /// Queues the record the host wrote in the first `length` bytes of the scratch.
  pub effect fn receive(self: &mut Self, length: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if length > self.scratch.length() {
      return ()
    }
    let event = run readEvent(self.scratch.asSlice())
    run self.waiting.append(move event)
  }
}

impl Backend for Dom {
  effect fn mutate(self: &mut Self, batch: List<Mutation>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    self.out.clear()
    let list = batch.asSlice()
    let mut i: usize = 0
    while i < list.length {
      if !run writeMutation(&mut self.out, &list[i]) {
        self.dropped = self.dropped + 1
      }
      i = i + 1
    }
    if self.out.length() != 0 {
      apply(self.out.asSlice())
    }
  }

  effect fn events(self: &mut Self, out: &mut List<Event>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut taken = Intrinsic.replace(self.waiting, List<Event>.make())
    while taken.length() != 0 {
      run out.append(taken.remove(0))
    }
  }

  fn viewport(self: &Self) -> Rect<f32> {
    return Rect<f32>.new(0.0, 0.0, self.width, self.height)
  }

  effect fn measure(self: &Self, id: u32) -> Option<Measured>
    ! OutOfMemoryError
    ? &mut Allocator {
    // Four floats (left, top, width, height) and three flags (pressed, hovered, focused).
    let mut box = run Bytes.zeroed(19)
    if !measureInto(id, box.asMutSlice()) {
      return Option<Measured>.None
    }
    let bytes = box.asSlice()
    let mut at: usize = 0
    let left = readFloat(bytes, &mut at)
    let top = readFloat(bytes, &mut at)
    let width = readFloat(bytes, &mut at)
    let height = readFloat(bytes, &mut at)
    let pressed = readByte(bytes, &mut at) != 0
    let hovered = readByte(bytes, &mut at) != 0
    let focused = readByte(bytes, &mut at) != 0
    return Option<Measured>.Some {
      value: Measured {
        bounds: Rect<f32>.new(left, top, width, height),
        pressed: pressed,
        hovered: hovered,
        focused: focused,
      },
    }
  }
}
