//! [`Backend`]: what the runtime needs from the thing that shows the UI. `UiTree` is one; a
//! browser document is another (`ui-app-dom`).
import ui_protocol.mutation { Mutation }
import ui_protocol.record { Event }
import ui_protocol.root { RootEvent, RootSupport }
import ui_tree.engine { UiTree }
pub import ui_tree.engine { TreeError }
import ui_tree.inspect { NodeInfo, info }
import ui_tree.virtual_list { VirtualRange }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.geometry.rect { Rect }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// Where a node is and what the pointer and focus do to it, for `ui.anchorRect`.
pub struct Measured {
  pub bounds: Rect<f32>,
  pub pressed: bool,
  pub hovered: bool,
  pub focused: bool,
}

impl Copy for Measured {}

/// Shows the UI: takes mutation batches, gives event records back.
pub interface Backend {
  /// Applies one render's mutations, in order.
  effect fn mutate(self: &mut Self, batch: List<Mutation>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator

  /// Moves the event records that wait into `out`, oldest first.
  effect fn events(self: &mut Self, out: &mut List<Event>) -> () ! OutOfMemoryError ? &mut Allocator

  /// Moves the root events that wait into `out`, oldest first. A backend that reports none
  /// has nothing to move.
  effect fn rootEvents(self: &mut Self, out: &mut List<RootEvent>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return ()
  }

  /// The viewport of root `root`, in CSS pixels.
  fn viewport(self: &Self, root: u32) -> Rect<f32>

  /// How many roots the backend shows and what a root past the first becomes. One it cannot
  /// show gets a `Failed` root event when it is opened.
  fn roots(self: &Self) -> RootSupport

  /// The layout box of node `id`, if it has one.
  effect fn measure(self: &Self, id: u32) -> Option<Measured> ! OutOfMemoryError ? &mut Allocator

  /// The item range virtual list `id` wants. A backend without virtual lists has none.
  fn range(self: &Self, id: u32) -> Option<VirtualRange> {
    return Option<VirtualRange>.None
  }

  /// Whether `mutate` copies what it needs out of a batch and keeps none of its values, as a
  /// backend that encodes batches for another process does. The runtime then makes the text
  /// of a batch in a scratch allocator it resets every render, which is cheaper than the heap.
  /// A backend that keeps strings or lists of a batch (as `UiTree` does) says no.
  fn copiesBatches(self: &Self) -> bool {
    return false
  }

  /// The app followed a link to `path`. A backend with an address bar shows it there.
  fn navigate(self: &mut Self, path: string) -> () {
    return ()
  }
}

impl<'a> Backend for UiTree<'a> {
  effect fn mutate(self: &mut Self, batch: List<Mutation>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.apply(move batch)
  }

  effect fn events(self: &mut Self, out: &mut List<Event>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.takeEvents(&mut out)
  }

  effect fn rootEvents(self: &mut Self, out: &mut List<RootEvent>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.takeRootEvents(&mut out)
  }

  fn viewport(self: &Self, root: u32) -> Rect<f32> {
    return self.rootViewport(root)
  }

  fn roots(self: &Self) -> RootSupport {
    return self.rootSupport
  }

  effect fn measure(self: &Self, id: u32) -> Option<Measured>
    ! OutOfMemoryError
    ? &mut Allocator {
    if let Option<NodeInfo>.Some { value: node } = run info(self, id) {
      if node.laidOut {
        return Option<Measured>.Some {
          value: Measured {
            bounds: node.bounds,
            pressed: node.pressed,
            hovered: node.hovered,
            focused: node.focused,
          },
        }
      }
    }
    return Option<Measured>.None
  }

  fn range(self: &Self, id: u32) -> Option<VirtualRange> {
    return self.virtualRange(id)
  }
}
