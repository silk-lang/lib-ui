/// A declaration from CSS text, for a property this module has no function for:
/// `css.raw(Property.Translate, "0 -2px")`. A document backend applies any of them; the tree
/// renderer the ones it knows.
pub fn raw(property: Property, value: string) -> Declaration {
  return declare(property, allocate(text(String.utf8Bytes(value))))
}

/// `letter-spacing`, as CSS text: `"-0.01em"`.
pub fn letterSpacing(value: string) -> Declaration {
  return raw(Property.LetterSpacing, value)
}

/// `text-transform`, as CSS text: `"uppercase"`.
pub fn textTransform(value: string) -> Declaration {
  return raw(Property.TextTransform, value)
}

/// `font-variant-numeric`, as CSS text: `"tabular-nums"`.
pub fn fontVariantNumeric(value: string) -> Declaration {
  return raw(Property.FontVariantNumeric, value)
}

/// `font-feature-settings`, as CSS text.
pub fn fontFeatureSettings(value: string) -> Declaration {
  return raw(Property.FontFeatureSettings, value)
}

