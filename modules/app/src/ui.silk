//! [`Ui`]: the builder a view writes its nodes into, and the arena it records them in.
//!
//! A view is a plain function of the model that calls `Ui` methods. Child content is a lambda
//! that the builder calls at once, so nothing is stored but plain data: every node becomes an
//! [`Entry`] in a flat arena, with its style properties, attributes, text and listener flags.
//!
//! The same view runs in two modes:
//!
//! - **Render.** Every node is recorded. Each new entry is matched with the entry of the last
//!   render at the same place: same parent, then the same key, or the same position among the
//!   unkeyed siblings. The diff (`diff.silk`) turns the two arenas into tree mutations.
//! - **Dispatch.** An event record from the tree names the path of node ids from the root to
//!   its target. The view runs again, but a node's children run only when the node is on that
//!   path, and handlers (`on`, `onClick`, ...) are called only there. Their replies bubble from
//!   the target up. Handlers are lambdas that are never stored.
pub import ui_protocol.grid { Grid }
import ui_protocol.css { Value }
import ui_protocol.css
import ui_protocol.css { px, number, Keyword, Declaration }
import ui_protocol.options { AnchorOptions }
import virtual_list { VirtualList, VirtualOptions, VirtualRow }
import heap { Heap }
import aria { AriaField, AriaValues }
import ui_protocol.mutation {
  NodeKind,
  StyleState,
  FlexDirection,
  Position,
  Overflow,
  Role,
  TriState,
  Live,
  Orientation,
  Cursor,
  CanvasCommand,
  LISTEN_POINTER_DOWN,
  LISTEN_POINTER_UP,
  LISTEN_CLICK,
  LISTEN_POINTER_MOVE,
  LISTEN_POINTER_ENTER,
  LISTEN_POINTER_LEAVE,
  LISTEN_WHEEL,
  LISTEN_KEY_DOWN,
  LISTEN_KEY_UP,
  LISTEN_FOCUS,
  LISTEN_BLUR,
  LISTEN_INPUT,
  LISTEN_SCROLL,
  LISTEN_LAYOUT,
  LISTEN_POINTER_CANCEL,
  LISTEN_GOT_POINTER_CAPTURE,
  LISTEN_LOST_POINTER_CAPTURE,
  LISTEN_LOAD,
  LISTEN_ERROR
}
import ui_protocol.record { Event, EventKind }
pub import ui_protocol.event { DefaultAction }
import ui_protocol.event { preventFlags, bubbles, EventRecord, Propagation, Step, Phase }
import silk.collections.hash { Hash, Word }
import silk.collections.hash_map { HashMap }
import silk.collections.list { List }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.color.rgba { Rgba }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.geometry.rect { Rect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.num.u8
import silk.num.i64
import silk.num.f64
import silk.text.string { String }

/// No entry.
pub const NO_ENTRY: u32 = 4294967295

/// The tree id of the runtime's root box. A view's top-level nodes are its children.
pub const ROOT_ID: u32 = 1

/// Who a node is among its siblings: its key, or its position among the unkeyed ones.
pub struct Identity {
  pub keyed: bool,
  pub value: u64,
}

impl Copy for Identity {}

impl Identity {
  pub fn same(self: &Self, other: &Identity) -> bool {
    return self.keyed == other.keyed && self.value == other.value
  }
}

/// `span` moved by `shift` (wrapping), or left alone when empty.
fn shifted(span: Span, shift: u32) -> Span {
  if span.length == 0 {
    return Span.empty()
  }
  return Span { start: u32.wrappingAdd(span.start, shift), length: span.length }
}

/// A byte range in the arena's text pool, or a range in its canvas pool.
pub struct Span {
  pub start: u32,
  pub length: u32,
}

impl Copy for Span {}

impl Span {
  pub fn empty() -> Span {
    return Span { start: 0, length: 0 }
  }
}

/// One node of a render.
pub struct Entry {
  pub parent: u32,
  pub firstChild: u32,
  pub lastChild: u32,
  pub next: u32,
  pub childCount: u32,
  /// The index among its siblings.
  pub position: u32,
  pub kind: NodeKind,
  pub identity: Identity,
  /// How many unkeyed children it has so far, and how many `lazy` regions.
  pub unkeyed: u32,
  pub lazies: u32,
  pub firstStyle: u32,
  pub lastStyle: u32,
  pub text: Span,
  /// `Attribute.Element` and `ClassName`: for a document backend.
  pub element: Span,
  pub className: Span,
  pub listeners: u32,
  /// The listener flags of the kinds a handler answers by running code on the record (`on`):
  /// a dispatch of such a record runs the view, the others are answered from `Ui.kept`.
  pub liveKinds: u32,
  /// The matching entry of the last render, or `NO_ENTRY`.
  pub old: u32,
  /// The tree id, given by the diff.
  pub id: u32,
  /// Copied by `lazy` from the last render, with everything below it: nothing to diff.
  pub copied: bool,
  /// A copied entry whose kept replies came with it (see `Ui.keep`), so a dispatch through it
  /// can be answered without running the view.
  pub carried: bool,
  /// The keyed lazy record whose region starts at this entry, or `NO_ENTRY`.
  pub lazy: u32,
  /// The entry's rare attributes: an index into `Arena.extras`, 0 (the defaults) when it
  /// sets none of them.
  pub extra: u32,
}

impl Copy for Entry {}

/// The attributes most nodes do not set, kept apart so an `Entry` stays small to build, copy
/// and diff. `Arena.extras` holds them; `Entry.extra` is the index there plus one, or 0.
pub struct Extra {
  pub label: Span,
  pub testId: Span,
  pub accessRole: Role,
  pub hasValueRange: bool,
  pub valueMin: f32,
  pub valueMax: f32,
  pub valueNow: f32,
  pub hasTabIndex: bool,
  pub tabIndex: i32,
  pub hasCursor: bool,
  pub cursor: Cursor,
  pub disabled: bool,
  pub focusTrap: bool,
  /// `Attribute.Prevent` flags.
  pub prevents: u32,
  /// `Attribute.Checked`, `Selected` and `Expanded`.
  pub checked: bool,
  pub selected: bool,
  pub expanded: bool,
  /// Input attributes.
  pub placeholder: Span,
  /// `Attribute.Href`: where a click on the node goes.
  pub href: Span,
  /// `Attribute.Transition`.
  pub transition: Span,
  /// `Attribute.ElementId`: for a document backend.
  pub elementId: Span,
  pub multiline: bool,
  pub readOnly: bool,
  /// `takeFocus` was called: the diff focuses the node when this render asks and the last
  /// did not.
  pub wantsFocus: bool,
  /// `reveal` was called, the same way.
  pub wantsReveal: bool,
  /// `capturePointer` was called: the diff captures when this render asks and the last did
  /// not, and releases when the last asked and this one does not.
  pub wantsCapture: bool,
  /// `scrollTo` was called with these offsets: the diff scrolls when they are new.
  pub hasScroll: bool,
  pub scrollX: f32,
  pub scrollY: f32,
  /// `anchor` was called with `anchor`: the runtime reads the node's layout box for
  /// `anchorRect`.
  pub hasAnchor: bool,
  pub anchor: u64,
  /// Whether this node has tree-managed anchor placement.
  pub hasPlacement: bool,
  /// View key of the anchor used for placement.
  pub placementTarget: u64,
  /// Placement preferences forwarded to the backend.
  pub placementOptions: AnchorOptions,
  /// The image or icon resource, or `NO_ENTRY`.
  pub source: u32,
  pub grid: u32,
  pub hasCanvas: bool,
  pub canvas: Span,
  /// The other ARIA states and properties (`level`, `live`, `pressed` ...), and the text ones.
  pub aria: AriaValues,
  pub description: Span,
  pub roleDescription: Span,
  pub valueText: Span,
}

impl Copy for Extra {}

impl Extra {
  pub fn make() -> Extra {
    return Extra {
      label: Span.empty(),
      testId: Span.empty(),
      accessRole: Role.None,
      hasValueRange: false,
      valueMin: 0.0,
      valueMax: 0.0,
      valueNow: 0.0,
      hasTabIndex: false,
      tabIndex: 0,
      hasCursor: false,
      cursor: Cursor.Default,
      disabled: false,
      focusTrap: false,
      prevents: 0,
      checked: false,
      selected: false,
      expanded: false,
      placeholder: Span.empty(),
      href: Span.empty(),
      transition: Span.empty(),
      elementId: Span.empty(),
      multiline: false,
      readOnly: false,
      wantsFocus: false,
      wantsReveal: false,
      wantsCapture: false,
      hasScroll: false,
      scrollX: 0.0,
      scrollY: 0.0,
      hasAnchor: false,
      anchor: 0,
      hasPlacement: false,
      placementTarget: 0,
      placementOptions: AnchorOptions {
        gap: 0.0,
        preferredHeight: 0.0,
        alignEnd: false,
        matchWidth: false,
      },
      source: NO_ENTRY,
      grid: NO_ENTRY,
      hasCanvas: false,
      canvas: Span.empty(),
      aria: AriaValues.make(),
      description: Span.empty(),
      roleDescription: Span.empty(),
      valueText: Span.empty(),
    }
  }
}

impl Entry {
  pub fn make(kind: NodeKind, parent: u32, identity: Identity) -> Entry {
    return Entry {
      parent: parent,
      firstChild: NO_ENTRY,
      lastChild: NO_ENTRY,
      next: NO_ENTRY,
      childCount: 0,
      position: 0,
      kind: kind,
      identity: identity,
      unkeyed: 0,
      lazies: 0,
      firstStyle: NO_ENTRY,
      lastStyle: NO_ENTRY,
      text: Span.empty(),
      element: Span.empty(),
      className: Span.empty(),
      listeners: 0,
      liveKinds: 0,
      old: NO_ENTRY,
      id: 0,
      copied: false,
      carried: false,
      lazy: NO_ENTRY,
      extra: 0,
    }
  }
}

/// One style property of an entry, in a list per entry.
pub struct StyleRecord {
  pub entry: u32,
  pub state: StyleState,
  pub declaration: Declaration,
  pub next: u32,
}

/// A `lazy` region of a render: the entries, styles, text and canvas commands its body made.
pub struct LazyRecord {
  pub parent: u32,
  pub ordinal: u32,
  pub hash: u64,
  pub entryStart: u32,
  pub entryEnd: u32,
  pub styleStart: u32,
  pub styleEnd: u32,
  pub byteStart: u32,
  pub byteEnd: u32,
  pub canvasStart: u32,
  pub canvasEnd: u32,
  /// Made by `lazyKeyed`: found by the key of the node it starts with, not by its ordinal.
  pub keyed: bool,
}

impl Copy for LazyRecord {}

/// The keyed lazy regions of the last render, by key and hash: what a view builder that
/// describes nodes before playing them can skip (see `Ui.lazyKeyed`). A direct-mapped table of
/// `hintKey`s: a hint that loses its slot to another only costs that region's body a run.
pub struct LazyHints {
  slots: List<u64>,
  count: usize,
}

impl LazyHints {
  fn make() -> LazyHints {
    return LazyHints { slots: List<u64>.make(), count: 0 }
  }

  /// Whether the last render had a keyed lazy region with `key` and `hash`. A hint: the region
  /// can still not be reusable, which `Ui.reuseKeyed` says.
  pub fn has(self: &Self, key: u64, hash: u64) -> bool {
    let size = self.slots.length()
    if size == 0 {
      return false
    }
    let value = hintKey(key, hash)
    let slots = self.slots.asSlice()
    let mask = size - 1
    let at = u64.toUsize(u64.bitAnd(value, usize.toU64(mask)))
    let mut j: usize = 0
    while j < HINT_PROBES {
      let found = slots[(at + j) & mask]
      if found == value {
        return true
      }
      if found == 0 {
        return false
      }
      j = j + 1
    }
    return false
  }

  /// Empties the table, sized for about as many hints as it held.
  fn reset(self: &mut Self, heap: &mut Heap) -> () {
    let mut size: usize = 64
    while size < self.count * 4 {
      size = size * 2
    }
    if self.slots.length() != size {
      self.slots.clear()
      heap.alloc(self.slots.appendRepeated(0, size))
    } else {
      let slots = self.slots.asMutSlice()
      let mut i: usize = 0
      while i < slots.length {
        slots[i] = 0
        i = i + 1
      }
    }
    self.count = 0
  }

  fn insert(self: &mut Self, heap: &mut Heap, key: u64, hash: u64) -> () {
    if self.slots.length() < (self.count + 1) * 2 {
      // Grow and move the hints over: each is placed by its own bits.
      let mut size: usize = 64
      while size < (self.count + 1) * 4 {
        size = size * 2
      }
      let old = Intrinsic.replace(self.slots, List<u64>.make())
      heap.alloc(self.slots.appendRepeated(0, size))
      let mut i: usize = 0
      while i < old.length() {
        let value = old.asSlice()[i]
        if value != 0 {
          self.place(value)
        }
        i = i + 1
      }
    }
    self.place(hintKey(key, hash))
    self.count = self.count + 1
  }

  /// Puts `value` in the first free slot of its probes, or over the last of them.
  fn place(self: &mut Self, value: u64) -> () {
    let slots = self.slots.asMutSlice()
    let mask = slots.length - 1
    let at = u64.toUsize(u64.bitAnd(value, usize.toU64(mask)))
    let mut j: usize = 0
    while j < HINT_PROBES - 1 && slots[(at + j) & mask] != 0 && slots[(at + j) & mask] != value {
      j = j + 1
    }
    slots[(at + j) & mask] = value
  }
}

/// How many slots a hint may sit in after its own.
const HINT_PROBES: usize = 4

fn hintKey(key: u64, hash: u64) -> u64 {
  let value = u64.bitXor(mix(key), hash)
  return if value == 0 {
    1
  } else {
    value
  }
}

/// The flat record of one render. Entry 0 is the runtime's root box.
pub struct Arena {
  pub entries: List<Entry>,
  pub styles: List<StyleRecord>,
  pub bytes: List<u8>,
  pub grids: List<Grid>,
  pub canvas: List<CanvasCommand>,
  pub lazies: List<LazyRecord>,
  /// The rare attributes of entries; entry `extra` of an entry is at `extra - 1`.
  pub extras: List<Extra>,
}

impl Arena {
  pub fn make() -> Arena {
    return Arena {
      entries: List<Entry>.make(),
      styles: List<StyleRecord>.make(),
      bytes: List<u8>.make(),
      grids: List<Grid>.make(),
      canvas: List<CanvasCommand>.make(),
      lazies: List<LazyRecord>.make(),
      extras: List<Extra>.make(),
    }
  }

  pub fn clear(self: &mut Self) -> () {
    self.extras.clear()
    self.entries.clear()
    self.styles.clear()
    self.bytes.clear()
    self.grids.clear()
    self.canvas.clear()
    self.lazies.clear()
  }

  pub fn length(self: &Self) -> u32 {
    return usize.toU32(self.entries.length())
  }

  pub fn entry(self: &Self, index: u32) -> Entry {
    return self.entries.get(u32.toUsize(index))
  }

  /// Entry `index`, in place, to change a field or two without copying the entry.
  pub fn entryMut(self: &mut Self, index: u32) -> &mut Entry {
    return &mut self.entries.asMutSlice()[u32.toUsize(index)]
  }

  /// Entry `index`, in place: for reads of a field or two, where a copy of the whole entry
  /// would cost more than the read.
  pub fn entryRef(self: &Self, index: u32) -> &Entry {
    return &self.entries.asSlice()[u32.toUsize(index)]
  }

  /// The rare attributes of `entry`, or none when it sets none.
  pub fn extraOf(self: &Self, entry: &Entry) -> Option<&Extra> {
    if entry.extra == 0 {
      return Option<&Extra>.None
    }
    return Option<&Extra>.Some { value: &self.extras.asSlice()[u32.toUsize(entry.extra) - 1] }
  }

  /// The rare attributes of `entry`, the defaults when it sets none.
  pub fn extraCopy(self: &Self, entry: &Entry) -> Extra {
    if entry.extra == 0 {
      return Extra.make()
    }
    return self.extras.asSlice()[u32.toUsize(entry.extra) - 1]
  }

  pub fn setEntry(self: &mut Self, index: u32, entry: Entry) -> () {
    self.entries.set(u32.toUsize(index), entry)
  }

  /// The bytes of `span`.
  pub fn text(self: &Self, span: Span) -> &[u8] {
    if span.length == 0 {
      return Slice.view(self.bytes.asSlice(), 0, 0)
    }
    return Slice.view(self.bytes.asSlice(), u32.toUsize(span.start), u32.toUsize(span.length))
  }

  pub fn commands(self: &Self, span: Span) -> &[CanvasCommand] {
    if span.length == 0 {
      return Slice.view(self.canvas.asSlice(), 0, 0)
    }
    return Slice.view(self.canvas.asSlice(), u32.toUsize(span.start), u32.toUsize(span.length))
  }

  /// Makes this arena a copy of `other`.
  pub effect fn copyFrom(self: &mut Self, other: &Arena) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.clear()
    let mut g: usize = 0
    while g < other.grids.length() {
      run self.grids.append(run other.grids.asSlice()[g].copy())
      g = g + 1
    }
    run self.entries.appendSlice(other.entries.asSlice())
    let records = other.styles.asSlice()
    let mut r: usize = 0
    while r < records.length {
      let copy = run css.cloneDeclaration(&records[r].declaration)
      run self.styles.append(
        StyleRecord {
          entry: records[r].entry,
          state: records[r].state,
          declaration: move copy,
          next: records[r].next,
        },
      )
      r = r + 1
    }
    run self.bytes.appendSlice(other.bytes.asSlice())
    run self.canvas.appendSlice(other.canvas.asSlice())
    run self.lazies.appendSlice(other.lazies.asSlice())
    run self.extras.appendSlice(other.extras.asSlice())
  }

  /// The effective `state` properties of `index`, later ones replacing earlier ones.
  pub effect fn effectiveStyle(
    self: &Self,
    index: u32,
    state: StyleState,
    out: &mut List<Declaration>,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    out.clear()
    let records = self.styles.asSlice()
    let mut at = self.entries.asSlice()[u32.toUsize(index)].firstStyle
    while at != NO_ENTRY {
      let record = &records[u32.toUsize(at)]
      if record.state == state {
        run css.set(&mut out.*, &record.declaration)
      }
      at = record.next
    }
  }
}

/// What a handler answers: a message or not, and whether the event goes on to the handlers of
/// the nodes above.
pub union Reply<M> {
  /// Sends `message`; the event bubbles on.
  Emit { pub message: M },
  /// Sends `message`; nodes above do not see the event.
  EmitAndStop { pub message: M },
  /// Sends nothing; nodes above do not see the event.
  Stop,
  /// Sends nothing; the event bubbles on.
  Pass,
  /// Sends nothing and prevents the default action of the input (focus on a press, scrolling
  /// on a wheel, what a key does), as `preventDefault`; the event bubbles on.
  Prevent,
  /// Everything spelled out, as Elm's `custom`: an optional message, whether nodes above see
  /// the event, and whether the default action is prevented.
  Custom { pub message: Option<M>, pub stopPropagation: bool, pub preventDefault: bool },
}

/// A reply a render kept for entry `entry`, for the next record of `kind` (see `Ui.keep`).
pub struct Kept<M> {
  pub entry: u32,
  pub kind: EventKind,
  pub reply: Reply<M>,
  /// The reply was taken, by a dispatch or by a copy of its region.
  pub taken: bool,
}

/// A reply and the depth of the node whose handler gave it.
pub struct Answer<M> {
  pub depth: u32,
  pub reply: Reply<M>,
}

/// The layout box of an anchored node, as the tree laid it out last.
pub struct AnchorRect {
  pub key: u64,
  pub rect: Rect<f32>,
  /// Whether the node was pressed (a primary button press on it or inside it that has not
  /// ended): a drag in progress.
  pub pressed: bool,
  pub hovered: bool,
  pub focused: bool,
}

impl Copy for AnchorRect {}

/// The key of the overlay layer's host box under the root (see [`Ui.overlay`]).
pub const OVERLAY_KEY: u64 = 0x0F7EA11A7E570001

fn overlayIdentity() -> Identity {
  return Identity { keyed: true, value: OVERLAY_KEY }
}

/// The image and icon URLs the views named, each with the resource id the host knows it by.
///
/// A URL gets its id the first time a view names it and keeps it, so the host loads each URL
/// once (`Mutation.LoadImage`/`LoadIcon`) and every node showing it shares the resource. The
/// declared windows share the table with the app's view.
pub struct Sources {
  index: HashMap<Word, u32>,
  bytes: List<u8>,
  /// The URL of resource `id` at `id - 1`.
  spans: List<Span>,
  icons: List<bool>,
  /// Resources named since the last render's loads were sent.
  pub pending: List<u32>,
}

impl Sources {
  pub fn make() -> Sources {
    return Sources {
      index: HashMap<Word, u32>.make(Hash.seed(0x5352434B)),
      bytes: List<u8>.make(),
      spans: List<Span>.make(),
      icons: List<bool>.make(),
      pending: List<u32>.make(),
    }
  }

  /// How many resources the table holds.
  pub fn length(self: &Self) -> u32 {
    return usize.toU32(self.spans.length())
  }

  /// The URL of resource `resource`, as the view wrote it.
  pub fn url(self: &Self, resource: u32) -> string {
    let span = self.spans.asSlice()[u32.toUsize(resource - 1)]
    let bytes = Slice.view(self.bytes.asSlice(), u32.toUsize(span.start), u32.toUsize(span.length))
    return match String.fromUtf8(bytes) {
      Result.Success { value } => value
      Result.Failure { error: _ } => ""
    }
  }

  /// Whether resource `resource` is an icon rather than an image.
  pub fn isIcon(self: &Self, resource: u32) -> bool {
    return self.icons.asSlice()[u32.toUsize(resource - 1)]
  }

  fn matches(self: &Self, resource: u32, icon: bool, bytes: &[u8]) -> bool {
    if self.isIcon(resource) != icon {
      return false
    }
    let span = self.spans.asSlice()[u32.toUsize(resource - 1)]
    if u32.toUsize(span.length) != bytes.length {
      return false
    }
    let stored = self.bytes.asSlice()
    let start = u32.toUsize(span.start)
    let mut i: usize = 0
    while i < bytes.length {
      if stored[start + i] != bytes[i] {
        return false
      }
      i = i + 1
    }
    return true
  }

  /// The resource id of `url` as an icon or an image, new ones queued for loading.
  pub fn resolve(self: &mut Self, heap: &mut Heap, icon: bool, url: string) -> u32 {
    let bytes = String.utf8Bytes(url)
    let tag: u64 = if icon { 0x49434F4E } else { 0x494D4147 }
    let key = Hash.word(u64.bitXor(textKey(url), tag))
    if let Option<u32>.Some { value: known } = self.index.get(key) {
      if self.matches(known, icon, bytes) {
        return known
      }
      // A hash collision: the slow path keeps the answer exact.
      let mut id: u32 = 1
      while id <= self.length() {
        if self.matches(id, icon, bytes) {
          return id
        }
        id = id + 1
      }
    }
    let start = usize.toU32(self.bytes.length())
    heap.alloc(self.bytes.appendSlice(bytes))
    heap.alloc(self.spans.append(Span { start: start, length: usize.toU32(bytes.length) }))
    heap.alloc(self.icons.append(icon))
    let resource = self.length()
    heap.alloc(self.pending.append(resource))
    if !self.index.contains(key) {
      drop heap.alloc(self.index.insert(key, resource))
    }
    return resource
  }
}

/// The builder a view writes into. See the module documentation.
/// How large the lists of the last view description were (see `document.render`), so the
/// next pass can make room for them at once.
pub struct PassSizes {
  pub records: usize,
  pub kids: usize,
  pub ops: usize,
  pub attrs: usize,
  pub bytes: usize,
  pub styles: usize,
}

impl Copy for PassSizes {}

pub struct Ui<M> {
  /// Sizes of the last view description.
  pub passSizes: PassSizes,
  /// The replies this render kept, in entry order (see `keep`).
  kept: List<Kept<M>>,
  /// The replies the last render kept: a region `lazy` copies takes its replies from here.
  previousKept: List<Kept<M>>,
  /// A dispatch took replies from `kept` since the render: the next one runs the view.
  keptSpent: bool,
  /// The keyed lazy regions of the last render, and of this one so far.
  hints: LazyHints,
  nextHints: LazyHints,
  /// Where the last `carryKept` stopped in `previousKept`: the guess for the next.
  keptCursor: usize,
  /// This render runs every lazy body: a first try found a region it skipped not reusable.
  noReuse: bool,
  /// `reuseKeyed` could not copy a region whose body the view builder skipped: the render has
  /// to be done again with `restartRender`.
  pub lazyMissed: bool,
  /// Whether a node of this render, or of the last, asked for focus, a reveal, a pointer
  /// capture, a scroll, an anchor or a placement. Without it, the passes over every entry that
  /// look for those are skipped.
  pub marked: bool,
  pub previousMarked: bool,
  /// Allocation for views, as [`Heap.alloc`].
  pub heap: Heap,
  pub arena: Arena,
  pub previous: Arena,
  lookup: HashMap<Word, u32>,
  claimed: List<bool>,
  /// The lazy records of the last render by parent and ordinal (see `lazyKey`).
  lazyIndex: HashMap<Word, u32>,
  /// Whether `lazyIndex` holds this render's previous tree. It and `lookup` are built on the
  /// first miss of the guesses that match old entries in order, so a render that keeps its
  /// structure never hashes.
  indexed: bool,
  /// The entries of the previous tree whose children are in `lookup`.
  childrenIndexed: List<bool>,
  /// The lazy record after the last one reused: the guess for the next `lazy` call.
  lazyCursor: usize,
  current: u32,
  hasPendingKey: bool,
  pendingKey: u64,
  dispatching: bool,
  path: List<Identity>,
  depth: u32,
  ordinals: List<u32>,
  event: Event,
  answers: List<Answer<M>>,
  /// A handler of a dispatch pass asked for the default action to be prevented.
  prevented: bool,
  /// Entries the last render copied with `lazy` instead of running the body.
  pub reused: u32,
  /// The layout boxes of anchored nodes, filled by the runtime before each pass.
  pub anchors: List<AnchorRect>,
  pub viewportBounds: Rect<f32>,
  /// The overlay host entry of this render, or `NO_ENTRY`.
  overlayHost: u32,
  /// How many times `overlay` ran this pass.
  overlays: u32,
  /// A dispatch pass for an event in an overlay, outside that overlay's body: every node's
  /// body runs (to find the `overlay` call), and no handler does.
  searching: bool,
  /// View identities and the last virtual ranges requested by the backend.
  pub virtualLists: List<VirtualList>,
  /// Backend containers whose virtual view was removed.
  pub removedVirtualPorts: List<u32>,
  /// The tree id of the root entry: `ROOT_ID`, or the root node of a window the model
  /// declared (see `windows`).
  pub rootId: u32,
  /// The image and icon URLs named so far (see `Sources`).
  pub sources: Sources,
}

/// The listener flag that records of `kind` need.
pub fn listenerFlag(kind: EventKind) -> u32 {
  return match kind {
    EventKind.PointerDown => LISTEN_POINTER_DOWN
    EventKind.PointerUp => LISTEN_POINTER_UP
    EventKind.Click => LISTEN_CLICK
    EventKind.PointerMove => LISTEN_POINTER_MOVE
    EventKind.PointerEnter => LISTEN_POINTER_ENTER
    EventKind.PointerLeave => LISTEN_POINTER_LEAVE
    EventKind.Wheel => LISTEN_WHEEL
    EventKind.KeyDown => LISTEN_KEY_DOWN
    EventKind.KeyUp => LISTEN_KEY_UP
    EventKind.Focus => LISTEN_FOCUS
    EventKind.Blur => LISTEN_BLUR
    EventKind.Input => LISTEN_INPUT
    EventKind.Layout => LISTEN_LAYOUT
    EventKind.PointerCancel => LISTEN_POINTER_CANCEL
    EventKind.GotPointerCapture => LISTEN_GOT_POINTER_CAPTURE
    EventKind.LostPointerCapture => LISTEN_LOST_POINTER_CAPTURE
    EventKind.Load => LISTEN_LOAD
    EventKind.Error => LISTEN_ERROR
    EventKind.Scroll => LISTEN_SCROLL
  }
}

fn mix(value: u64) -> u64 {
  let mut z = u64.wrappingAdd(value, 0x9E3779B97F4A7C15)
  z = u64.wrappingMultiply(u64.bitXor(z, u64.shiftRight(z, 30)), 0xBF58476D1CE4E5B9)
  z = u64.wrappingMultiply(u64.bitXor(z, u64.shiftRight(z, 27)), 0x94D049BB133111EB)
  return u64.bitXor(z, u64.shiftRight(z, 31))
}

/// The lookup key of the child `identity` of entry `parent`.
fn slotKey(parent: u32, identity: Identity) -> u64 {
  let tag: u64 = if identity.keyed {
    1
  } else {
    2
  }
  return mix(u64.bitXor(mix(u32.toU64(parent) * 4 + tag), identity.value))
}

/// The key of the lazy record of `parent`'s `ordinal`-th `lazy` call: exact, no hashing.
fn lazyKey(parent: u32, ordinal: u32) -> Word {
  return Hash.word(u64.bitOr(u64.shiftLeft(u32.toU64(parent), 32), u32.toU64(ordinal)))
}

/// A 64-bit key for text, for `ui.key` and `ui.each` (FNV-1a).
pub fn textKey(value: string) -> u64 {
  let bytes = String.utf8Bytes(value)
  let mut hash: u64 = 0xCBF29CE484222325
  let mut i: usize = 0
  while i < bytes.length {
    hash = u64.wrappingMultiply(u64.bitXor(hash, u8.toU64(bytes[i])), 0x100000001B3)
    i = i + 1
  }
  return hash
}

impl<M> Ui<M> {
  pub fn make() -> Ui<M> {
    return Ui<M> {
      passSizes: PassSizes { records: 0, kids: 0, ops: 0, attrs: 0, bytes: 0, styles: 0 },
      kept: List<Kept<M>>.make(),
      previousKept: List<Kept<M>>.make(),
      keptSpent: false,
      hints: LazyHints.make(),
      nextHints: LazyHints.make(),
      keptCursor: 0,
      noReuse: false,
      lazyMissed: false,
      marked: false,
      previousMarked: false,
      heap: Heap.make(),
      arena: Arena.make(),
      previous: Arena.make(),
      lookup: HashMap<Word, u32>.make(Hash.seed(0x5EED)),
      claimed: List<bool>.make(),
      lazyIndex: HashMap<Word, u32>.make(Hash.seed(0x6C617A79)),
      indexed: false,
      childrenIndexed: List<bool>.make(),
      lazyCursor: 0,
      current: 0,
      hasPendingKey: false,
      pendingKey: 0,
      dispatching: false,
      path: List<Identity>.make(),
      depth: 0,
      ordinals: List<u32>.make(),
      event: Event.make(EventKind.Click, 0, List<u32>.make()),
      answers: List<Answer<M>>.make(),
      prevented: false,
      reused: 0,
      anchors: List<AnchorRect>.make(),
      viewportBounds: Rect<f32>.new(0.0, 0.0, 0.0, 0.0),
      overlayHost: NO_ENTRY,
      overlays: 0,
      searching: false,
      virtualLists: List<VirtualList>.make(),
      removedVirtualPorts: List<u32>.make(),
      rootId: ROOT_ID,
      sources: Sources.make(),
    }
  }

  /// Runs allocating work for the view (see [`Heap.alloc`]).
  pub fn alloc<A>(self: &mut Self, work: once Effect<A ! OutOfMemoryError ? &mut Allocator>) -> A {
    return self.heap.alloc(move work)
  }

  /// Whether this pass is a dispatch pass rather than a render.
  pub fn isDispatching(self: &Self) -> bool {
    return self.dispatching
  }

  /// The event the pass is dispatching.
  pub fn dispatched(self: &Self) -> &Event {
    return &self.event
  }

  // Passes, driven by the runtime.

  /// Starts a render: the last render becomes `previous`, and the root entry is open.
  pub effect fn beginRender(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    // The last render becomes `previous`; the one before it gives its lists to this one.
    let last = Intrinsic.replace(self.arena, Arena.make())
    let older = Intrinsic.replace(self.previous, move last)
    self.arena = move older
    let lastKept = Intrinsic.replace(self.kept, List<Kept<M>>.make())
    let olderKept = Intrinsic.replace(self.previousKept, move lastKept)
    self.kept = move olderKept
    let lastHints = Intrinsic.replace(self.nextHints, LazyHints.make())
    let olderHints = Intrinsic.replace(self.hints, move lastHints)
    self.nextHints = move olderHints
    self.lookup.clear()
    self.previousMarked = self.marked
    self.lazyIndex.clear()
    self.indexed = false
    self.childrenIndexed.clear()
    run self.childrenIndexed.appendRepeated(false, u32.toUsize(self.previous.length()))
    self.noReuse = false
    self.resetRender()
  }

  /// Starts the render again, running every lazy body: a view builder skipped a body that
  /// `reuseKeyed` then could not copy (`lazyMissed`).
  pub fn restartRender(self: &mut Self) -> () {
    self.noReuse = true
    self.resetRender()
  }

  fn resetRender(self: &mut Self) -> () {
    let lists = self.virtualLists.asMutSlice()
    let mut v: usize = 0
    while v < lists.length {
      lists[v].seen = false
      v = v + 1
    }
    self.arena.clear()
    self.kept.clear()
    self.nextHints.reset(&mut self.heap)
    self.keptCursor = 0
    self.keptSpent = false
    self.lazyMissed = false
    self.marked = false
    self.lazyCursor = 0
    self.claimed.clear()
    let count = self.previous.length()
    self.heap.alloc(self.claimed.appendRepeated(false, u32.toUsize(count)))
    let mut root = Entry.make(NodeKind.Box, NO_ENTRY, Identity { keyed: false, value: 0 })
    root.id = self.rootId
    if count > 0 {
      root.old = 0
    }
    self.heap.alloc(self.arena.entries.append(root))
    self.current = 0
    self.hasPendingKey = false
    self.dispatching = false
    self.reused = 0
    self.overlayHost = NO_ENTRY
    self.overlays = 0
    self.searching = false
  }

  /// The keyed lazy regions of the last render (see `lazyKeyed`).
  pub fn lazyHints(self: &Self) -> &LazyHints {
    return &self.hints
  }

  /// Whether a view builder may skip a lazy body whose region the hints name.
  pub fn mayReuse(self: &Self) -> bool {
    return !self.dispatching && !self.searching && !self.noReuse
  }

  /// Ends a render: the overlay layer, if any, moves after the root's other children so it is
  /// drawn (and hit) above them.
  pub fn endRender(self: &mut Self) -> () {
    let mut v = self.virtualLists.length()
    while v > 0 {
      v = v - 1
      if !self.virtualLists.asSlice()[v].seen {
        let port = self.virtualLists.asSlice()[v].port
        self.heap.alloc(self.removedVirtualPorts.append(self.previous.entry(port).id))
        drop self.virtualLists.remove(v)
      }
    }
    let host = self.overlayHost
    if host == NO_ENTRY {
      return ()
    }
    let mut root = self.arena.entry(0)
    if root.lastChild == host {
      return ()
    }

    // Unlink the host.
    let after = self.arena.entry(host).next
    if root.firstChild == host {
      root.firstChild = after
    } else {
      let mut at = root.firstChild
      while at != NO_ENTRY {
        let mut entry = self.arena.entry(at)
        if entry.next == host {
          entry.next = after
          self.arena.setEntry(at, entry)
          break
        }
        at = entry.next
      }
    }

    // Append it, and number the children again.
    let mut last = self.arena.entry(root.lastChild)
    last.next = host
    self.arena.setEntry(root.lastChild, last)
    let mut moved = self.arena.entry(host)
    moved.next = NO_ENTRY
    self.arena.setEntry(host, moved)
    root.lastChild = host
    self.arena.setEntry(0, root)
    let mut position: u32 = 0
    let mut at = root.firstChild
    while at != NO_ENTRY {
      let mut entry = self.arena.entry(at)
      entry.position = position
      self.arena.setEntry(at, entry)
      position = position + 1
      at = entry.next
    }
  }

  /// Starts a dispatch pass for `event`, whose path the runtime resolved to `path` (the
  /// identities below the root, outermost first).
  pub effect fn beginDispatch(self: &mut Self, event: Event, path: &[Identity]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.event = move event
    self.path.clear()
    run self.path.appendSlice(path)
    self.depth = 0
    self.ordinals.clear()
    run self.ordinals.append(0)
    self.answers.clear()
    self.hasPendingKey = false
    self.dispatching = true
    self.overlays = 0
    self.searching = self.path.length() > 0 && self.path.get(0).same(&overlayIdentity())
  }

  /// Ends a dispatch pass and moves the messages its handlers sent, in bubbling order, into
  /// `out`.
  pub effect fn endDispatch(self: &mut Self, out: &mut List<M>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.dispatching = false
    self.searching = false
    // The shared walk decides the order (the target, then its ancestors for kinds that
    // bubble) and what stopping means, so this client agrees with every other one.
    let record = run EventRecord.lift(&self.event)
    let mut walk = Propagation.over(&record)
    let mut step = walk.next()
    while let Option<Step>.Some { value: at } = step {
      if at.phase != Phase.Capture {
        let depth = usize.toU32(at.depth)
        // Handlers of the same node answer in the order they were declared; one that stops
        // the event also keeps the node's later handlers from answering.
        let mut stopped = false
        let mut i: usize = 0
        while i < self.answers.length() && !stopped {
          if self.answers.asSlice()[i].depth == depth {
            let answer = self.answers.remove(i)
            match move answer.reply {
              Reply<M>.Emit { message } => {
                run out.append(move message)
              }
              Reply<M>.EmitAndStop { message } => {
                run out.append(move message)
                stopped = true
              }
              Reply<M>.Stop => {
                stopped = true
              }
              Reply<M>.Pass => {}
              Reply<M>.Prevent => {
                walk.preventDefault()
              }
              Reply<M>.Custom { message, stopPropagation, preventDefault } => {
                if let Option<M>.Some { value } = move message {
                  run out.append(move value)
                }
                if preventDefault {
                  walk.preventDefault()
                }
                if stopPropagation {
                  stopped = true
                }
              }
            }
          } else {
            i = i + 1
          }
        }
        if stopped {
          walk.stopPropagation()
        }
      }
      step = walk.next()
    }
    if walk.defaultPrevented() {
      self.prevented = true
    }
    self.answers.clear()
  }

  // Nodes.

  /// Uses `value` as the key of the next node this view opens, so the node keeps its identity
  /// (and its tree state: focus, scroll, hover) when siblings come and go or move.
  pub fn key(self: &mut Self, value: u64) -> () {
    self.hasPendingKey = true
    self.pendingKey = value
  }

  /// The identity of the next child of the open node.
  fn nextIdentity(self: &mut Self) -> Identity {
    if self.hasPendingKey {
      self.hasPendingKey = false
      return Identity { keyed: true, value: self.pendingKey }
    }
    if self.dispatching {
      let at = u32.toUsize(self.depth)
      let ordinal = self.ordinals.get(at)
      self.ordinals.set(at, ordinal + 1)
      return Identity { keyed: false, value: u32.toU64(ordinal) }
    }
    let parent = self.arena.entryMut(self.current)
    let ordinal = parent.unkeyed
    parent.unkeyed = ordinal + 1
    return Identity { keyed: false, value: u32.toU64(ordinal) }
  }

  /// Adds the children of `oldParent`, an entry of the previous tree, to `lookup`, once a
  /// render: only the parents whose children did not match in order are hashed.
  fn indexChildren(self: &mut Self, oldParent: u32) -> () {
    if self.childrenIndexed.get(u32.toUsize(oldParent)) {
      return ()
    }
    self.childrenIndexed.set(u32.toUsize(oldParent), true)
    let mut at = self.previous.entryRef(oldParent).firstChild
    while at != NO_ENTRY {
      let entry = self.previous.entryRef(at)
      let key = Hash.word(slotKey(oldParent, entry.identity))
      let next = entry.next
      drop self.heap.alloc(self.lookup.insert(key, at))
      at = next
    }
  }

  /// Builds `lazyIndex` from the previous tree, once a render.
  fn index(self: &mut Self) -> () {
    if self.indexed {
      return ()
    }
    self.indexed = true
    let mut l: usize = 0
    while l < self.previous.lazies.length() {
      let record = self.previous.lazies.get(l)
      if !record.keyed {
        drop self.heap.alloc(self.lazyIndex.insert(lazyKey(record.parent, record.ordinal), usize.toU32(l)))
      }
      l = l + 1
    }
  }

  /// The entry of the last render that matches child `identity` of `parent`, unclaimed.
  fn matchOld(self: &mut Self, parent: u32, identity: Identity, kind: NodeKind) -> u32 {
    let found = self.findOld(parent, identity)
    if found == NO_ENTRY || self.claimed.get(u32.toUsize(found)) {
      return NO_ENTRY
    }
    if self.previous.entryRef(found).kind != kind {
      return NO_ENTRY
    }
    self.claimed.set(u32.toUsize(found), true)
    return found
  }

  /// The entry of the last render at child `identity` of `parent`, claimed or not.
  fn findOld(self: &mut Self, parent: u32, identity: Identity) -> u32 {
    let oldParent = self.arena.entryRef(parent).old
    if oldParent == NO_ENTRY {
      return NO_ENTRY
    }
    let mut found = NO_ENTRY
    // The old child after the one the last opened child matched, or the old parent's first.
    let upLast = self.arena.entryRef(parent).lastChild
    let mut guess = self.previous.entryRef(oldParent).firstChild
    if upLast != NO_ENTRY {
      let last = self.arena.entryRef(upLast).old
      guess = if last == NO_ENTRY {
        NO_ENTRY
      } else {
        self.previous.entryRef(last).next
      }
    }
    if guess != NO_ENTRY {
      let entry = self.previous.entryRef(guess)
      if entry.parent == oldParent && entry.identity.same(&identity) {
        found = guess
      }
    }
    let mut collided = false
    if found == NO_ENTRY {
      self.indexChildren(oldParent)
      if let Option<u32>.Some { value } = self.lookup.get(Hash.word(slotKey(oldParent, identity))) {
        let entry = self.previous.entryRef(value)
        if entry.parent == oldParent && entry.identity.same(&identity) {
          found = value
        } else {
          collided = true
        }
      }
    }
    if found == NO_ENTRY && collided {
      // A lookup collision (another entry took the slot): look through the old parent's
      // children. A miss with no entry in the slot is no match at all.
      let mut at = self.previous.entry(oldParent).firstChild
      while at != NO_ENTRY {
        let entry = self.previous.entry(at)
        if entry.identity.same(&identity) {
          found = at
          break
        }
        at = entry.next
      }
    }
    return found
  }

  /// Whether this render or the last has a node that asks for focus, a reveal, a capture, a
  /// scroll, an anchor or a placement.
  pub fn hasMarks(self: &Self) -> bool {
    return self.marked || self.previousMarked
  }

  /// Makes room for `count` more nodes in this render, so a view that knows its size up
  /// front does not grow the arena (and copy it) as it opens them. The room is exact: an
  /// entry is large, and a doubled capacity for a long list is memory nothing ever uses.
  pub fn reserveNodes(self: &mut Self, count: usize) -> () {
    if !self.dispatching && !self.searching {
      self.heap.alloc(self.arena.entries.reserveExact(count))
    }
  }

  /// Opens a child of `kind` under the open node; returns it.
  fn open(self: &mut Self, kind: NodeKind, identity: Identity) -> u32 {
    let parent = self.current
    let index = self.arena.length()
    let mut entry = Entry.make(kind, parent, identity)
    entry.old = self.matchOld(parent, identity, kind)
    let lastChild = self.arena.entryRef(parent).lastChild
    if lastChild != NO_ENTRY {
      let last = self.arena.entryMut(lastChild)
      last.next = index
    }
    let up = self.arena.entryMut(parent)
    entry.position = up.childCount
    up.childCount = up.childCount + 1
    if up.lastChild == NO_ENTRY {
      up.firstChild = index
    }
    up.lastChild = index
    self.heap.alloc(self.arena.entries.append(entry))
    return index
  }

  /// A node of `kind`. `body` sets its style, attributes and handlers and adds its children.
  pub fn node(self: &mut Self, kind: NodeKind, body: fn(&mut Ui<M>) -> ()) -> () {
    if self.searching {
      self.hasPendingKey = false
      body(&mut self)
      self.hasPendingKey = false
      return ()
    }
    let identity = self.nextIdentity()
    if self.dispatching {
      let at = u32.toUsize(self.depth)
      if at < self.path.length() && self.path.get(at).same(&identity) {
        self.depth = self.depth + 1
        if self.ordinals.length() <= u32.toUsize(self.depth) {
          self.heap.alloc(self.ordinals.append(0))
        }
        self.ordinals.set(u32.toUsize(self.depth), 0)
        body(&mut self)
        self.hasPendingKey = false
        self.depth = self.depth - 1
      }
      return ()
    }
    let index = self.open(kind, identity)
    let parent = self.current
    self.current = index
    body(&mut self)
    self.hasPendingKey = false
    self.current = parent
  }

  /// Mounts the visible items of a variable-height vertical list in the current column.
  ///
  /// # Details
  ///
  /// The current column must have a bounded height. This method owns its scrolling and
  /// children. Do not add other children, gaps, or vertical padding to that column.
  /// Item keys must be unique and stable. `listKey` must be unique in the view.
  /// A focused item remains mounted outside the visible range until focus leaves it.
  /// The tree measures heights after layout. Width changes and `options.revision` changes
  /// discard measurements. Unmounted items retain no widget state; keep data in the model.
  /// Inspection and native accessibility expose mounted items only.
  /// Use `runtime.frame` in custom hosts to settle measurements before presentation.
  pub fn virtualItems(
    self: &mut Self,
    listKey: u64,
    count: usize,
    options: VirtualOptions,
    key: fn(usize) -> u64,
    body: fn(&mut Ui<M>, usize) -> (),
  ) -> () {
    let mut v: usize = 0
    while v < self.virtualLists.length() && self.virtualLists.asSlice()[v].key != listKey {
      v = v + 1
    }
    if v == self.virtualLists.length() {
      if self.dispatching || self.searching {
        return ()
      }
      self.heap.alloc(self.virtualLists.append(VirtualList.make(listKey, options)))
    }
    if !self.dispatching && !self.searching {
      let list = &mut self.virtualLists.asMutSlice()[v]
      if list.count != count || list.options.revision != options.revision {
        if list.pinned != usize.MAX {
          let mut candidate: usize = 0
          while candidate < count && key(candidate) != list.pinnedKey {
            candidate = candidate + 1
          }
          list.pinned = if candidate < count {
            candidate
          } else {
            usize.MAX
          }
        }
      }
      list.count = count
      if list.first > count {
        list.first = count
      }
      if list.end > count {
        list.end = count
      }
      list.options = options
      list.port = self.current
      list.seen = true
      list.rows.clear()
    }
    self.style(
      &[css.overflowY(Overflow.Auto), css.overflowX(Overflow.Hidden), css.minHeight(px(0.0))],
    )
    let first = self.virtualLists.asSlice()[v].first
    let end = self.virtualLists.asSlice()[v].end
    let pinned = self.virtualLists.asSlice()[v].pinned
    let mut i = if pinned < first {
      pinned
    } else {
      first
    }
    while i < end || (pinned < count && i == pinned) {
      self.key(key(i))
      self.column(
        |ui| {
          ui.style(&[css.flexShrink(0.0)])
          if !ui.dispatching && !ui.searching {
            ui.heap.alloc(
              ui.virtualLists.asMutSlice()[v].rows.append(
                VirtualRow { index: i, entry: ui.current },
              ),
            )
          }
          body(&mut ui, i)
        },
      )
      let cursor = i + 1
      if i < first {
        i = first
      } else if cursor == end && pinned >= end && pinned < count {
        i = pinned
      } else {
        i = cursor
      }
    }
  }

  /// A leaf node of `kind` with no body.
  fn leaf(self: &mut Self, kind: NodeKind) -> u32 {
    if self.searching {
      self.hasPendingKey = false
      return NO_ENTRY
    }
    let identity = self.nextIdentity()
    if self.dispatching {
      return NO_ENTRY
    }
    return self.open(kind, identity)
  }

  /// A box (`display: block`).
  pub fn box(self: &mut Self, body: fn(&mut Ui<M>) -> ()) -> () {
    self.node(NodeKind.Box, body)
  }

  /// A flex row.
  pub fn row(self: &mut Self, body: fn(&mut Ui<M>) -> ()) -> () {
    self.node(
      NodeKind.Box,
      |ui| {
        ui.style(&[css.display(Keyword.Flex), css.flexDirection(FlexDirection.Row)])
        body(&mut ui)
      },
    )
  }

  /// A flex column.
  pub fn column(self: &mut Self, body: fn(&mut Ui<M>) -> ()) -> () {
    self.node(
      NodeKind.Box,
      |ui| {
        ui.style(&[css.display(Keyword.Flex), css.flexDirection(FlexDirection.Column)])
        body(&mut ui)
      },
    )
  }

  /// A text node: a run of text styled by its parent.
  pub fn text(self: &mut Self, value: string) -> () {
    let index = self.leaf(NodeKind.Text)
    if index != NO_ENTRY {
      let span = self.store(String.utf8Bytes(value))
      let mut entry = self.arena.entry(index)
      entry.text = span
      self.arena.setEntry(index, entry)
    }
  }

  /// A text node showing `value` in decimal.
  pub fn number(self: &mut Self, value: i64) -> () {
    let index = self.leaf(NodeKind.Text)
    if index != NO_ENTRY {
      let start = usize.toU32(self.arena.bytes.length())
      let mut magnitude: u64 = if value < 0 {
        i64.toU64(0 - (value + 1)) + 1
      } else {
        i64.toU64(value)
      }
      let mut digits: [u8; 20] = [0; 20]
      let mut count: usize = 0
      while true {
        digits[count] = u64.toU8(magnitude % 10) + 48
        count = count + 1
        magnitude = magnitude / 10
        if magnitude == 0 {
          break
        }
      }
      if value < 0 {
        self.heap.alloc(self.arena.bytes.append(45))
      }
      while count > 0 {
        count = count - 1
        self.heap.alloc(self.arena.bytes.append(digits[count]))
      }
      let mut entry = self.arena.entry(index)
      entry.text = Span { start: start, length: usize.toU32(self.arena.bytes.length()) - start }
      self.arena.setEntry(index, entry)
    }
  }

  /// A text node showing `value` with `places` digits after the point (at most 6), rounded.
  pub fn decimal(self: &mut Self, value: f64, places: u32) -> () {
    let index = self.leaf(NodeKind.Text)
    if index == NO_ENTRY {
      return ()
    }
    let start = usize.toU32(self.arena.bytes.length())
    let digits = if places > 6 {
      6
    } else {
      places
    }
    let mut scale: f64 = 1.0
    let mut p: u32 = 0
    while p < digits {
      scale = scale * 10.0
      p = p + 1
    }
    let negative = value < 0.0
    let magnitude = if negative {
      0.0 - value
    } else {
      value
    }
    let scaled = f64.toU64(f64.floor(magnitude * scale + 0.5))
    if negative && scaled != 0 {
      self.heap.alloc(self.arena.bytes.append(45))
    }
    let units = scaled / f64.toU64(scale)
    self.appendDigits(units, 1)
    if digits > 0 {
      self.heap.alloc(self.arena.bytes.append(46))
      self.appendDigits(scaled % f64.toU64(scale), digits)
    }
    let mut entry = self.arena.entry(index)
    entry.text = Span { start: start, length: usize.toU32(self.arena.bytes.length()) - start }
    self.arena.setEntry(index, entry)
  }

  /// Appends `value` in decimal to the text pool, padded with zeros to `width` digits.
  fn appendDigits(self: &mut Self, value: u64, width: u32) -> () {
    let mut digits: [u8; 20] = [0; 20]
    let mut count: usize = 0
    let mut rest = value
    while true {
      digits[count] = u64.toU8(rest % 10) + 48
      count = count + 1
      rest = rest / 10
      if rest == 0 {
        break
      }
    }
    while count < u32.toUsize(width) && count < 20 {
      digits[count] = 48
      count = count + 1
    }
    while count > 0 {
      count = count - 1
      self.heap.alloc(self.arena.bytes.append(digits[count]))
    }
  }

  /// Sets the open node’s Grid template, including grid-item placement.
  pub fn gridTemplate(self: &mut Self, value: &Grid) -> () {
    if self.dispatching || self.searching {
      return ()
    }
    let index = usize.toU32(self.arena.grids.length())
    let copy = self.heap.alloc(value.copy())
    self.heap.alloc(self.arena.grids.append(move copy))
    let extra = self.extraMut()
    extra.grid = index
  }

  /// A Grid container; the template owns tracks, names, repeats and areas.
  pub fn grid(self: &mut Self, value: &Grid, body: fn(&mut Ui<M>) -> ()) -> () {
    self.box(
      |ui| {
        ui.style(&[css.display(Keyword.Grid)])
        ui.gridTemplate(value)
        body(&mut ui)
      },
    )
  }

  /// Delivers the measured viewport-relative border box after it changes. Does not bubble.
  /// Keep the callback idempotent; changing layout from it can schedule another frame.
  pub fn onLayout(self: &mut Self, handler: fn(Rect<f32>) -> M) -> () {
    self.on(EventKind.Layout, |event| Reply<M>.Emit { message: handler(event.bounds) })
  }

  /// Sets the image or icon source of the open node to `url`, a WHATWG URL. The host loads it
  /// with its loader for the URL's scheme; a relative URL names one of the app's own files.
  pub fn source(self: &mut Self, url: string) -> () {
    if self.dispatching || self.searching {
      return ()
    }
    let icon = self.arena.entryRef(self.current).kind == NodeKind.Icon
    let resource = self.sources.resolve(&mut self.heap, icon, url)
    let extra = self.extraMut()
    extra.source = resource
  }

  /// An image node showing `url` at its natural size.
  pub fn image(self: &mut Self, url: string) -> () {
    self.imageWith(url, |ui| {})
  }

  /// An image with its own sizing, fit, accessibility label and input handlers.
  pub fn imageWith(self: &mut Self, url: string, body: fn(&mut Ui<M>) -> ()) -> () {
    self.node(
      NodeKind.Image,
      |ui| {
        ui.source(url)
        ui.accessRole(Role.Image)
        body(&mut ui)
      },
    )
  }

  /// An SVG mask icon from `url`, tinted with the inherited text color.
  pub fn icon(self: &mut Self, url: string) -> () {
    self.iconWith(url, |ui| {})
  }

  /// An icon with its own dimensions and attributes.
  pub fn iconWith(self: &mut Self, url: string, body: fn(&mut Ui<M>) -> ()) -> () {
    self.node(
      NodeKind.Icon,
      |ui| {
        ui.source(url)
        body(&mut ui)
      },
    )
  }

  /// An input node with value `value`. The view controls the value.
  pub fn input(self: &mut Self, value: string, body: fn(&mut Ui<M>) -> ()) -> () {
    self.node(
      NodeKind.Input,
      |ui| {
        ui.setText(value)
        body(&mut ui)
      },
    )
  }

  /// A canvas node drawing `commands`.
  pub fn canvas(self: &mut Self, commands: &[CanvasCommand], body: fn(&mut Ui<M>) -> ()) -> () {
    self.node(
      NodeKind.Canvas,
      |ui| {
        if !ui.dispatching {
          let start = usize.toU32(ui.arena.canvas.length())
          ui.heap.alloc(ui.arena.canvas.appendSlice(commands))
          let extra = ui.extraMut()
          extra.hasCanvas = true
          extra.canvas = Span { start: start, length: usize.toU32(commands.length) }
        }
        body(&mut ui)
      },
    )
  }

  /// A button: a focusable box with role button and a text label, sending `onPress` when
  /// clicked or pressed with Enter or Space.
  pub fn button(self: &mut Self, label: string, onPress: fn() -> M) -> () {
    self.pressable(
      onPress,
      |ui| {
        ui.text(label)
      },
    )
  }

  /// A focusable box with role button that sends `onPress` when clicked or pressed with Enter
  /// or Space; `body` styles it and adds its content.
  pub fn pressable(self: &mut Self, onPress: fn() -> M, body: fn(&mut Ui<M>) -> ()) -> () {
    self.node(
      NodeKind.Box,
      |ui| {
        ui.accessRole(Role.Button)
        ui.tabIndex(0)
        ui.cursor(Cursor.Pointer)
        ui.onClick(onPress)
        body(&mut ui)
      },
    )
  }

  /// One child per item of `items`, keyed by `key`: the first node `body` opens for an item
  /// takes the item's key.
  pub fn each<T>(
    self: &mut Self,
    items: &[T],
    key: fn(&T) -> u64,
    body: fn(&mut Ui<M>, &T) -> (),
  ) -> () {
    let mut i: usize = 0
    while i < items.length {
      self.key(key(&items[i]))
      body(&mut self, &items[i])
      self.hasPendingKey = false
      i = i + 1
    }
  }

  /// As [`each`], with the item's index.
  pub fn enumerate<T>(
    self: &mut Self,
    items: &[T],
    key: fn(&T) -> u64,
    body: fn(&mut Ui<M>, usize, &T) -> (),
  ) -> () {
    let mut i: usize = 0
    while i < items.length {
      self.key(key(&items[i]))
      body(&mut self, i, &items[i])
      self.hasPendingKey = false
      i = i + 1
    }
  }

  /// Reuses what `body` made in the last render when `hash` (a hash of everything `body`
  /// reads) is the same as then, as Elm's `Html.lazy`: the region is copied and the diff skips
  /// it. Each `lazy` call is told apart from the others under the same node by its order.
  /// `body` should only open nodes; style and attribute calls outside a node of its own are
  /// not kept when the region is reused.
  pub fn lazy(self: &mut Self, hash: u64, body: fn(&mut Ui<M>) -> ()) -> () {
    if self.dispatching {
      body(&mut self)
      return ()
    }
    let parent = self.current
    let mut up = self.arena.entry(parent)
    let ordinal = up.lazies
    up.lazies = ordinal + 1
    self.arena.setEntry(parent, up)
    let oldParent = up.old
    if oldParent != NO_ENTRY {
      // At most one record has this parent and ordinal: usually the one after the last reused.
      let mut found = NO_ENTRY
      let cursor = self.lazyCursor
      if cursor < self.previous.lazies.length() {
        let next = self.previous.lazies.get(cursor)
        if next.parent == oldParent && next.ordinal == ordinal {
          found = usize.toU32(cursor)
        }
      }
      if found == NO_ENTRY {
        self.index()
        if let Option<u32>.Some { value } = self.lazyIndex.get(lazyKey(oldParent, ordinal)) {
          found = value
        }
      }
      if found != NO_ENTRY {
        let at = u32.toUsize(found)
        self.lazyCursor = at + 1
        let record = self.previous.lazies.get(at)
        if record.parent == oldParent && record.ordinal == ordinal && record.hash == hash
          && self.unclaimedRange(record.entryStart, record.entryEnd) {
          let mut containsVirtual = false
          let mut v: usize = 0
          while v < self.virtualLists.length() {
            let list = &self.virtualLists.asSlice()[v]
            if !list.seen
              && (list.port == oldParent
                || (list.port >= record.entryStart && list.port < record.entryEnd)) {
              containsVirtual = true
            }
            v = v + 1
          }
          if !containsVirtual {
            self.copyLazy(record, at, parent)
            return ()
          }
        }
      }
    }
    let entryStart = self.arena.length()
    let styleStart = usize.toU32(self.arena.styles.length())
    let byteStart = usize.toU32(self.arena.bytes.length())
    let canvasStart = usize.toU32(self.arena.canvas.length())
    let overlaysBefore = self.overlays
    body(&mut self)
    if self.overlays != overlaysBefore {
      // An overlay's nodes live outside the region, so it cannot be copied.
      return ()
    }
    let record = LazyRecord {
      parent: parent,
      ordinal: ordinal,
      hash: hash,
      entryStart: entryStart,
      entryEnd: self.arena.length(),
      styleStart: styleStart,
      styleEnd: usize.toU32(self.arena.styles.length()),
      byteStart: byteStart,
      byteEnd: usize.toU32(self.arena.bytes.length()),
      canvasStart: canvasStart,
      canvasEnd: usize.toU32(self.arena.canvas.length()),
      keyed: false,
    }
    self.heap.alloc(self.arena.lazies.append(record))
  }

  /// A lazy region that is one keyed node: `body` opens it after `ui.key(key)`. Found again
  /// by that key, so it is reused when its siblings come and go or move, as a keyed row of a
  /// list. Its key and hash go in the hints of the next render (see `lazyHints`).
  pub fn lazyKeyed(self: &mut Self, key: u64, hash: u64, body: fn(&mut Ui<M>) -> ()) -> () {
    if self.dispatching || self.searching {
      body(&mut self)
      return ()
    }
    if !self.noReuse && self.hints.has(key, hash) && self.reuseKeyed(key, hash) {
      return ()
    }
    let parent = self.current
    let entryStart = self.arena.length()
    let styleStart = usize.toU32(self.arena.styles.length())
    let byteStart = usize.toU32(self.arena.bytes.length())
    let canvasStart = usize.toU32(self.arena.canvas.length())
    let overlaysBefore = self.overlays
    body(&mut self)
    if self.overlays != overlaysBefore || self.arena.length() == entryStart {
      return ()
    }
    let root = self.arena.entryRef(entryStart)
    if root.parent != parent || !root.identity.keyed || root.identity.value != key {
      return ()
    }
    let record = LazyRecord {
      parent: parent,
      ordinal: u32.MAX,
      hash: hash,
      entryStart: entryStart,
      entryEnd: self.arena.length(),
      styleStart: styleStart,
      styleEnd: usize.toU32(self.arena.styles.length()),
      byteStart: byteStart,
      byteEnd: usize.toU32(self.arena.bytes.length()),
      canvasStart: canvasStart,
      canvasEnd: usize.toU32(self.arena.canvas.length()),
      keyed: true,
    }
    self.markKeyed(record)
  }

  /// Appends keyed lazy record `record` of this render and names it in the next hints.
  fn markKeyed(self: &mut Self, record: LazyRecord) -> () {
    let index = usize.toU32(self.arena.lazies.length())
    self.heap.alloc(self.arena.lazies.append(record))
    let root = self.arena.entryMut(record.entryStart)
    root.lazy = index
    let key = root.identity.value
    self.nextHints.insert(&mut self.heap, key, record.hash)
  }

  /// Copies the keyed lazy region of the last render with `key` under the open node when its
  /// hash is `hash`; false when there is none to copy, and nothing changed.
  pub fn reuseKeyed(self: &mut Self, key: u64, hash: u64) -> bool {
    if self.dispatching || self.searching || self.noReuse {
      return false
    }
    let parent = self.current
    let oldParent = self.arena.entryRef(parent).old
    if oldParent == NO_ENTRY {
      return false
    }
    let found = self.findOld(parent, Identity { keyed: true, value: key })
    if found == NO_ENTRY {
      return false
    }
    let at = self.previous.entryRef(found).lazy
    if at == NO_ENTRY {
      return false
    }
    let record = self.previous.lazies.get(u32.toUsize(at))
    if !record.keyed || record.hash != hash || record.entryStart != found
      || !self.unclaimedRange(record.entryStart, record.entryEnd) {
      return false
    }
    let mut v: usize = 0
    while v < self.virtualLists.length() {
      let list = &self.virtualLists.asSlice()[v]
      if !list.seen && list.port >= record.entryStart && list.port < record.entryEnd {
        return false
      }
      v = v + 1
    }
    self.copyLazy(record, u32.toUsize(at), parent)
    return true
  }

  fn unclaimedRange(self: &Self, start: u32, end: u32) -> bool {
    let mut i = start
    while i < end {
      if self.claimed.get(u32.toUsize(i)) {
        return false
      }
      i = i + 1
    }
    return true
  }

  /// Copies lazy region `record` (record `at` of the last render) under `parent`.
  fn copyLazy(self: &mut Self, record: LazyRecord, at: usize, parent: u32) -> () {
    let entryStart = self.arena.length()
    let styleStart = usize.toU32(self.arena.styles.length())
    let byteStart = usize.toU32(self.arena.bytes.length())
    let canvasStart = usize.toU32(self.arena.canvas.length())
    let entryShift = u32.wrappingSubtract(entryStart, record.entryStart)
    let styleShift = u32.wrappingSubtract(styleStart, record.styleStart)
    let byteShift = u32.wrappingSubtract(byteStart, record.byteStart)
    let canvasShift = u32.wrappingSubtract(canvasStart, record.canvasStart)
    self.reused = self.reused + (record.entryEnd - record.entryStart)
    let inside = |index: u32| index != NO_ENTRY && index >= record.entryStart
      && index < record.entryEnd
    let count = u32.toUsize(record.entryEnd - record.entryStart)
    let mut c: usize = 0
    while c < count {
      self.claimed.set(u32.toUsize(record.entryStart) + c, true)
      c = c + 1
    }
    if self.previousMarked {
      self.marked = true
    }
    // One copy of the whole region, then each entry is moved to its new place in it.
    self.heap.alloc(
      self.arena.entries.appendSlice(
        Slice.view(self.previous.entries.asSlice(), u32.toUsize(record.entryStart), count),
      ),
    )
    let mut extras = false
    let mut tops: usize = 0
    let entries = self.arena.entries.asMutSlice()
    let mut k: usize = 0
    while k < count {
      let entry = &mut entries[u32.toUsize(entryStart) + k]
      entry.old = record.entryStart + usize.toU32(k)
      entry.carried = !entry.copied || entry.carried
      entry.copied = true
      entry.lazy = NO_ENTRY
      if entry.firstChild != NO_ENTRY {
        entry.firstChild = u32.wrappingAdd(entry.firstChild, entryShift)
        entry.lastChild = u32.wrappingAdd(entry.lastChild, entryShift)
      }
      if entry.firstStyle != NO_ENTRY {
        entry.firstStyle = u32.wrappingAdd(entry.firstStyle, styleShift)
        entry.lastStyle = u32.wrappingAdd(entry.lastStyle, styleShift)
      }
      if byteShift != 0 {
        entry.text = shifted(entry.text, byteShift)
        entry.element = shifted(entry.element, byteShift)
        entry.className = shifted(entry.className, byteShift)
      }
      if entry.extra != 0 {
        extras = true
      }
      if entry.parent != NO_ENTRY && entry.parent >= record.entryStart
        && entry.parent < record.entryEnd {
        entry.parent = u32.wrappingAdd(entry.parent, entryShift)
        if entry.next != NO_ENTRY {
          entry.next = u32.wrappingAdd(entry.next, entryShift)
        }
      } else {
        // A top-level node of the region: linked under the new parent below.
        entry.parent = parent
        entry.next = NO_ENTRY
        tops = tops + 1
      }
      k = k + 1
    }
    // A keyed row has one top-level node, its first: with no extras to copy, that one is all
    // the second pass has to do.
    let fixAll = extras || tops != 1
    let fixCount = if fixAll {
      count
    } else {
      1
    }
    k = 0
    while k < fixCount {
      let index = entryStart + usize.toU32(k)
      let from = self.arena.entryRef(index).extra
      if extras && from != 0 {
        let mut extra = self.previous.extras.asSlice()[u32.toUsize(from) - 1]
        extra.label = shifted(extra.label, byteShift)
        extra.testId = shifted(extra.testId, byteShift)
        extra.placeholder = shifted(extra.placeholder, byteShift)
        extra.href = shifted(extra.href, byteShift)
        extra.transition = shifted(extra.transition, byteShift)
        extra.elementId = shifted(extra.elementId, byteShift)
        extra.canvas = shifted(extra.canvas, canvasShift)
        if extra.grid != NO_ENTRY {
          let grid = self.heap.alloc(self.previous.grids.asSlice()[u32.toUsize(extra.grid)].copy())
          extra.grid = usize.toU32(self.arena.grids.length())
          self.heap.alloc(self.arena.grids.append(move grid))
        }
        self.heap.alloc(self.arena.extras.append(extra))
        let at = usize.toU32(self.arena.extras.length())
        let entry = self.arena.entryMut(index)
        entry.extra = at
      }
      if self.arena.entryRef(index).parent == parent {
        let mut identity = self.arena.entryRef(index).identity
        let up = self.arena.entryMut(parent)
        let position = up.childCount
        up.childCount = position + 1
        if !identity.keyed {
          identity = Identity { keyed: false, value: u32.toU64(up.unkeyed) }
          up.unkeyed = up.unkeyed + 1
        }
        let lastChild = up.lastChild
        up.lastChild = index
        if lastChild == NO_ENTRY {
          up.firstChild = index
        } else {
          let last = self.arena.entryMut(lastChild)
          last.next = index
        }
        let entry = self.arena.entryMut(index)
        entry.position = position
        entry.identity = identity
      }
      k = k + 1
    }
    let mut s = record.styleStart
    while s < record.styleEnd {
      let source = &self.previous.styles.asSlice()[u32.toUsize(s)]
      let mut style = StyleRecord {
        entry: source.entry,
        state: source.state,
        declaration: self.heap.alloc(css.cloneDeclaration(&source.declaration)),
        next: source.next,
      }
      if inside(style.entry) {
        style.entry = u32.wrappingAdd(style.entry, entryShift)
        if style.next != NO_ENTRY {
          style.next = u32.wrappingAdd(style.next, styleShift)
        }
        self.heap.alloc(self.arena.styles.append(move style))
      } else {
        // A style of the parent made by the body: dropped (see `lazy`), but its slot stays so
        // the shifts hold.
        style.entry = NO_ENTRY
        style.next = NO_ENTRY
        self.heap.alloc(self.arena.styles.append(move style))
      }
      s = s + 1
    }
    self.heap.alloc(
      self.arena.bytes.appendSlice(
        Slice.view(
          self.previous.bytes.asSlice(),
          u32.toUsize(record.byteStart),
          u32.toUsize(record.byteEnd - record.byteStart),
        ),
      ),
    )
    self.heap.alloc(
      self.arena.canvas.appendSlice(
        Slice.view(
          self.previous.canvas.asSlice(),
          u32.toUsize(record.canvasStart),
          u32.toUsize(record.canvasEnd - record.canvasStart),
        ),
      ),
    )

    // Lazy regions nested in this one move with it. They were recorded while its body ran,
    // so they are among the records just before it whose regions start inside it.
    let mut first = at
    while first > 0 && self.previous.lazies.get(first - 1).entryStart >= record.entryStart {
      first = first - 1
    }
    let mut n: usize = first
    while n < at {
      let inner = self.previous.lazies.get(n)
      if inside(inner.parent) {
        let moved = LazyRecord {
          parent: u32.wrappingAdd(inner.parent, entryShift),
          ordinal: inner.ordinal,
          hash: inner.hash,
          entryStart: u32.wrappingAdd(inner.entryStart, entryShift),
          entryEnd: u32.wrappingAdd(inner.entryEnd, entryShift),
          styleStart: u32.wrappingAdd(inner.styleStart, styleShift),
          styleEnd: u32.wrappingAdd(inner.styleEnd, styleShift),
          byteStart: u32.wrappingAdd(inner.byteStart, byteShift),
          byteEnd: u32.wrappingAdd(inner.byteEnd, byteShift),
          canvasStart: u32.wrappingAdd(inner.canvasStart, canvasShift),
          canvasEnd: u32.wrappingAdd(inner.canvasEnd, canvasShift),
          keyed: inner.keyed,
        }
        if moved.keyed {
          self.markKeyed(moved)
        } else {
          self.heap.alloc(self.arena.lazies.append(moved))
        }
      }
      n = n + 1
    }
    let copied = LazyRecord {
      parent: parent,
      ordinal: record.ordinal,
      hash: record.hash,
      entryStart: entryStart,
      entryEnd: self.arena.length(),
      styleStart: styleStart,
      styleEnd: usize.toU32(self.arena.styles.length()),
      byteStart: byteStart,
      byteEnd: usize.toU32(self.arena.bytes.length()),
      canvasStart: canvasStart,
      canvasEnd: usize.toU32(self.arena.canvas.length()),
      keyed: record.keyed,
    }
    if copied.keyed {
      self.markKeyed(copied)
    } else {
      self.heap.alloc(self.arena.lazies.append(copied))
    }
    self.carryKept(record.entryStart, record.entryEnd, entryShift)
  }

  /// Moves the replies the last render kept for its entries `start..end` to this render's,
  /// at the entries `shift` after them, where `copyLazy` put them. A reply a dispatch took is
  /// gone: its entry is no longer `carried`, and a dispatch through it runs the view.
  fn carryKept(self: &mut Self, start: u32, end: u32, shift: u32) -> () {
    let mut low: usize = 0
    let mut high = self.previousKept.length()
    // Regions are mostly copied in order: try where the last one stopped.
    let guess = self.keptCursor
    if guess <= high && (guess == high || self.previousKept.asSlice()[guess].entry >= start)
      && (guess == 0 || self.previousKept.asSlice()[guess - 1].entry < start) {
      low = guess
      high = guess
    }
    while low < high {
      let middle = (low + high) / 2
      if self.previousKept.asSlice()[middle].entry < start {
        low = middle + 1
      } else {
        high = middle
      }
    }
    while low < self.previousKept.length() && self.previousKept.asSlice()[low].entry < end {
      let item = &mut self.previousKept.asMutSlice()[low]
      let target = u32.wrappingAdd(item.entry, shift)
      if item.taken {
        let entry = self.arena.entryMut(target)
        entry.carried = false
      } else {
        item.taken = true
        let kind = item.kind
        let reply = Intrinsic.replace(item.reply, Reply<M>.Pass)
        let kept = Kept<M> { entry: target, kind: kind, reply: move reply, taken: false }
        self.heap.alloc(self.kept.append(move kept))
      }
      low = low + 1
    }
    self.keptCursor = low
  }

  fn store(self: &mut Self, bytes: &[u8]) -> Span {
    let start = usize.toU32(self.arena.bytes.length())
    self.heap.alloc(self.arena.bytes.appendSlice(bytes))
    return Span { start: start, length: usize.toU32(bytes.length) }
  }

  /// Sets the value of the open text or input node.
  pub fn setText(self: &mut Self, value: string) -> () {
    if self.dispatching {
      return ()
    }
    let span = self.store(String.utf8Bytes(value))
    let entry = self.arena.entryMut(self.current)
    entry.text = span
  }

  // Style.

  /// Adds `properties` to the open node's `state` look; later ones replace earlier ones.
  pub fn styleFor(self: &mut Self, state: StyleState, properties: &[Declaration]) -> () {
    if self.dispatching {
      return ()
    }
    let mut i: usize = 0
    while i < properties.length {
      let at = usize.toU32(self.arena.styles.length())
      let record = StyleRecord {
        entry: self.current,
        state: state,
        declaration: self.heap.alloc(css.cloneDeclaration(&properties[i])),
        next: NO_ENTRY,
      }
      self.heap.alloc(self.arena.styles.append(move record))
      let mut entry = self.arena.entry(self.current)
      if entry.lastStyle == NO_ENTRY {
        entry.firstStyle = at
      } else {
        let records = self.arena.styles.asMutSlice()
        records[u32.toUsize(entry.lastStyle)].next = at
      }
      entry.lastStyle = at
      self.arena.setEntry(self.current, entry)
      i = i + 1
    }
  }

  /// Adds `properties` to the open node's base style.
  pub fn style(self: &mut Self, properties: &[Declaration]) -> () {
    self.styleFor(StyleState.Base, properties)
  }

  /// The look while hovered.
  pub fn hover(self: &mut Self, properties: &[Declaration]) -> () {
    self.styleFor(StyleState.Hover, properties)
  }

  /// The look while pressed.
  pub fn active(self: &mut Self, properties: &[Declaration]) -> () {
    self.styleFor(StyleState.Active, properties)
  }

  /// The look while focused.
  pub fn focused(self: &mut Self, properties: &[Declaration]) -> () {
    self.styleFor(StyleState.Focus, properties)
  }

  /// The look while focused from the keyboard (focus rings).
  pub fn focusVisible(self: &mut Self, properties: &[Declaration]) -> () {
    self.styleFor(StyleState.FocusVisible, properties)
  }

  /// Padding on all four sides, in CSS pixels.
  pub fn padding(self: &mut Self, value: f32) -> () {
    self.style(&[css.padding(px(value))])
  }

  /// The gap between rows and columns of a flex container.
  pub fn gap(self: &mut Self, value: f32) -> () {
    self.style(&[css.rowGap(px(value)), css.columnGap(px(value))])
  }

  pub fn background(self: &mut Self, color: Rgba<f32>) -> () {
    self.style(&[css.backgroundColor(color)])
  }

  /// The text color.
  pub fn color(self: &mut Self, color: Rgba<f32>) -> () {
    self.style(&[css.color(color)])
  }

  pub fn fontSize(self: &mut Self, value: f32) -> () {
    self.style(&[css.fontSize(px(value))])
  }

  pub fn width(self: &mut Self, value: Value) -> () {
    self.style(&[css.width(move value)])
  }

  pub fn height(self: &mut Self, value: Value) -> () {
    self.style(&[css.height(move value)])
  }

  /// `flex-grow`.
  pub fn grow(self: &mut Self, value: f32) -> () {
    self.style(&[css.flexGrow(value)])
  }

  // Attributes.

  /// The rare attributes of the open node, made when it sets its first one.
  fn extraMut(self: &mut Self) -> &mut Extra {
    let at = self.arena.entryRef(self.current).extra
    if at != 0 {
      return &mut self.arena.extras.asMutSlice()[u32.toUsize(at) - 1]
    }
    self.heap.alloc(self.arena.extras.append(Extra.make()))
    let index = usize.toU32(self.arena.extras.length())
    let entry = self.arena.entryMut(self.current)
    entry.extra = index
    return &mut self.arena.extras.asMutSlice()[u32.toUsize(index) - 1]
  }

  pub fn accessRole(self: &mut Self, value: Role) -> () {
    if !self.dispatching {
      let extra = self.extraMut()
      extra.accessRole = value
    }
  }

  /// The accessible name.
  pub fn label(self: &mut Self, value: string) -> () {
    if !self.dispatching {
      let span = self.store(String.utf8Bytes(value))
      let extra = self.extraMut()
      extra.label = span
    }
  }

  /// The numeric accessibility range of the open control. Omitting it in the next view clears it.
  pub fn valueRange(self: &mut Self, min: f32, max: f32, value: f32) -> () {
    if !self.dispatching {
      let extra = self.extraMut()
      extra.hasValueRange = true
      extra.valueMin = min
      extra.valueMax = max
      extra.valueNow = value
    }
  }

  /// A stable name for tests and inspectors.
  pub fn testId(self: &mut Self, value: string) -> () {
    if !self.dispatching {
      let span = self.store(String.utf8Bytes(value))
      let extra = self.extraMut()
      extra.testId = span
    }
  }

  pub fn tabIndex(self: &mut Self, value: i32) -> () {
    if !self.dispatching {
      let extra = self.extraMut()
      extra.hasTabIndex = true
      extra.tabIndex = value
    }
  }

  pub fn cursor(self: &mut Self, value: Cursor) -> () {
    if !self.dispatching {
      let extra = self.extraMut()
      extra.hasCursor = true
      extra.cursor = value
    }
  }

  pub fn disabled(self: &mut Self, value: bool) -> () {
    if !self.dispatching {
      let extra = self.extraMut()
      extra.disabled = value
    }
  }

  /// Whether a handler asked for the default action to be prevented since the last call.
  pub fn takePrevented(self: &mut Self) -> bool {
    let value = self.prevented
    self.prevented = false
    return value
  }

  /// Turns default actions off for input aimed at the open node or anything inside it: the
  /// declarative `preventDefault`, for what the view knows ahead of time. A canvas that pans
  /// itself prevents `Scroll`; a toolbar button that must not take focus from an editor
  /// prevents `Focus`. The handlers still run.
  pub fn prevent(self: &mut Self, actions: &[DefaultAction]) -> () {
    if !self.dispatching {
      let extra = self.extraMut()
      extra.prevents = preventFlags(actions)
    }
  }

  /// `prevent`, with the actions as `PREVENT_*` flags.
  pub fn preventMask(self: &mut Self, flags: u32) -> () {
    if !self.dispatching {
      let extra = self.extraMut()
      extra.prevents = flags
    }
  }

  pub fn focusTrap(self: &mut Self, value: bool) -> () {
    if !self.dispatching {
      let extra = self.extraMut()
      extra.focusTrap = value
    }
  }

  /// The level of a heading, or the nesting level of a tree item or row, from 1
  /// (`aria-level`).
  pub fn level(self: &mut Self, value: i32) -> () { self.aria(AriaField.Level, value) }

  /// The accessible description, read after the name (`aria-description`).
  pub fn description(self: &mut Self, value: string) -> () { self.ariaText(AriaField.Description, value) }

  /// A name for the role, read in its place (`aria-roledescription`).
  pub fn roleDescription(self: &mut Self, value: string) -> () { self.ariaText(AriaField.RoleDescription, value) }

  /// The value range's value as words (`aria-valuetext`).
  pub fn valueText(self: &mut Self, value: string) -> () { self.ariaText(AriaField.ValueText, value) }

  /// Leaves the node and its subtree out of what assistive technology sees (`aria-hidden`).
  pub fn hidden(self: &mut Self, value: bool) -> () { self.aria(AriaField.Hidden, flagValue(value)) }

  /// How changes inside the node are announced (`aria-live`).
  pub fn live(self: &mut Self, value: Live) -> () {
    self.aria(AriaField.Live, match value {
      Live.Off => 0
      Live.Polite => 1
      Live.Assertive => 2
    })
  }

  /// Whether a change inside a live node is read as the whole node (`aria-atomic`).
  pub fn atomic(self: &mut Self, value: bool) -> () { self.aria(AriaField.Atomic, flagValue(value)) }

  /// Whether the node is being updated, so its announcements wait (`aria-busy`).
  pub fn busy(self: &mut Self, value: bool) -> () { self.aria(AriaField.Busy, flagValue(value)) }

  /// The state of a toggle button (`aria-pressed`).
  pub fn pressed(self: &mut Self, value: TriState) -> () {
    self.aria(AriaField.Pressed, match value {
      TriState.Unset => 0
      TriState.False => 1
      TriState.True => 2
      TriState.Mixed => 3
    })
  }

  /// A checkbox that is neither checked nor unchecked (`aria-checked="mixed"`).
  pub fn indeterminate(self: &mut Self, value: bool) -> () { self.aria(AriaField.Indeterminate, flagValue(value)) }

  /// A field that must be filled in (`aria-required`).
  pub fn required(self: &mut Self, value: bool) -> () { self.aria(AriaField.Required, flagValue(value)) }

  /// A value that failed validation (`aria-invalid`).
  pub fn invalid(self: &mut Self, value: bool) -> () { self.aria(AriaField.Invalid, flagValue(value)) }

  /// A list box, grid or tree in which several items can be selected (`aria-multiselectable`).
  pub fn multiSelectable(self: &mut Self, value: bool) -> () { self.aria(AriaField.MultiSelectable, flagValue(value)) }

  /// The direction of a slider, separator, toolbar or list (`aria-orientation`).
  pub fn orientation(self: &mut Self, value: Orientation) -> () {
    self.aria(AriaField.Orientation, match value {
      Orientation.Unset => 0
      Orientation.Horizontal => 1
      Orientation.Vertical => 2
    })
  }

  /// The node's position in its set, from 1, for sets not all in view (`aria-posinset`).
  pub fn posInSet(self: &mut Self, value: i32) -> () { self.aria(AriaField.PosInSet, value) }

  /// The number of items in the node's set; -1 when unknown (`aria-setsize`).
  pub fn setSize(self: &mut Self, value: i32) -> () { self.aria(AriaField.SetSize, value) }

  /// A dialog that keeps the rest of the window out of reach (`aria-modal`).
  pub fn modal(self: &mut Self, value: bool) -> () { self.aria(AriaField.Modal, flagValue(value)) }

  /// Sets a flag or number attribute of the open node (see [`AriaValues.set`]).
  pub fn aria(self: &mut Self, field: AriaField, value: i32) -> () {
    if !self.dispatching {
      let extra = self.extraMut()
      extra.aria.set(field, value)
    }
  }

  /// Sets a text attribute of the open node: `Description`, `RoleDescription` or `ValueText`.
  pub fn ariaText(self: &mut Self, field: AriaField, value: string) -> () {
    if !self.dispatching {
      let span = self.store(String.utf8Bytes(value))
      let extra = self.extraMut()
      match field {
        AriaField.Description => { extra.description = span }
        AriaField.RoleDescription => { extra.roleDescription = span }
        AriaField.ValueText => { extra.valueText = span }
        _ => {}
      }
    }
  }

  /// Whether a checkbox, radio button or switch is checked (`aria-checked`).
  pub fn checked(self: &mut Self, value: bool) -> () {
    if !self.dispatching {
      let extra = self.extraMut()
      extra.checked = value
    }
  }

  /// Whether a tab, option or list item is the selected one (`aria-selected`).
  pub fn selected(self: &mut Self, value: bool) -> () {
    if !self.dispatching {
      let extra = self.extraMut()
      extra.selected = value
    }
  }

  /// Whether what this node controls is open (`aria-expanded`).
  pub fn expanded(self: &mut Self, value: bool) -> () {
    if !self.dispatching {
      let extra = self.extraMut()
      extra.expanded = value
    }
  }

  /// The text an empty input shows.
  pub fn placeholder(self: &mut Self, value: string) -> () {
    if !self.dispatching {
      let span = self.store(String.utf8Bytes(value))
      let extra = self.extraMut()
      extra.placeholder = span
    }
  }

  /// Makes the open node a link to `path`, a path of the app such as `"/guide"`. A click on it
  /// with no modifier moves the runtime's location there (see `Subscriptions.location`), unless
  /// a handler prevents it. A document backend shows it as an `a`.
  pub fn href(self: &mut Self, path: string) -> () {
    if !self.dispatching {
      let span = self.store(String.utf8Bytes(path))
      let entry = self.arena.entryMut(self.current)
      entry.listeners = u32.bitOr(entry.listeners, listenerFlag(EventKind.Click))
      let extra = self.extraMut()
      extra.href = span
    }
  }

  /// How the open node's style changes ease, as CSS `transition` text
  /// (`"background-color 150ms ease"`). A document backend applies it; the tree changes styles
  /// at once.
  pub fn transition(self: &mut Self, value: string) -> () {
    if !self.dispatching {
      let span = self.store(String.utf8Bytes(value))
      let extra = self.extraMut()
      extra.transition = span
    }
  }

  /// The element a document backend shows the open node as, by HTML tag name (`"tr"`,
  /// `"button"`), in place of its kind's own. The tree renderer ignores it.
  pub fn element(self: &mut Self, name: string) -> () {
    if !self.dispatching {
      let span = self.store(String.utf8Bytes(name))
      let entry = self.arena.entryMut(self.current)
      entry.element = span
    }
  }

  /// The open node's classes, as the HTML `class` attribute (`"btn btn-primary"`), so the
  /// page's stylesheets apply to it in a document backend. The tree renderer ignores it.
  pub fn className(self: &mut Self, value: string) -> () {
    if !self.dispatching {
      let span = self.store(String.utf8Bytes(value))
      let entry = self.arena.entryMut(self.current)
      entry.className = span
    }
  }

  /// The open node's HTML `id` in a document backend. The tree renderer ignores it.
  pub fn elementId(self: &mut Self, value: string) -> () {
    if !self.dispatching {
      let span = self.store(String.utf8Bytes(value))
      let extra = self.extraMut()
      extra.elementId = span
    }
  }

  /// Makes the open input take several lines.
  pub fn multiline(self: &mut Self, value: bool) -> () {
    if !self.dispatching {
      let extra = self.extraMut()
      extra.multiline = value
    }
  }

  /// Makes the open input selectable but not editable.
  pub fn readOnly(self: &mut Self, value: bool) -> () {
    if !self.dispatching {
      let extra = self.extraMut()
      extra.readOnly = value
    }
  }

  // Focus, anchors and overlays.

  /// Moves focus to the open node when this render asks for it and the last one did not (or
  /// the node is new): a dialog focusing its first field when it opens, a menu its highlighted
  /// item as the arrow keys move. Asking again in the next renders does nothing more, so a
  /// view can ask for as long as the condition holds. The last node asking wins.
  pub fn takeFocus(self: &mut Self) -> () {
    if !self.dispatching {
      self.marked = true
      let extra = self.extraMut()
      extra.wantsFocus = true
    }
  }

  /// Scrolls the open node into view when this render asks and the last one did not (or the
  /// node is new), as [`takeFocus`] does for focus: the highlighted row of a list that the
  /// arrow keys move.
  pub fn reveal(self: &mut Self) -> () {
    if !self.dispatching {
      self.marked = true
      let extra = self.extraMut()
      extra.wantsReveal = true
    }
  }

  /// Captures the pointer of the press in progress for the open node when this render asks and
  /// the last one did not: the node gets the moves and the release wherever the pointer goes,
  /// which is what a drag needs. The capture ends with the press, or when a render stops
  /// asking.
  pub fn capturePointer(self: &mut Self) -> () {
    if !self.dispatching {
      self.marked = true
      let extra = self.extraMut()
      extra.wantsCapture = true
    }
  }

  /// Scrolls the open node, a scroll container, to the offsets (`x`, `y`) in CSS pixels when
  /// this render asks for offsets the last one did not ask for (or the node is new). The user
  /// scrolls freely in between: the view moves the container only by asking for new offsets.
  pub fn scrollTo(self: &mut Self, x: f32, y: f32) -> () {
    if !self.dispatching {
      self.marked = true
      let extra = self.extraMut()
      extra.hasScroll = true
      extra.scrollX = x
      extra.scrollY = y
    }
  }

  /// Names the open node `key` for [`anchorRect`]: the runtime reads its layout box from the
  /// tree before each render and dispatch. Keys should be unique in the view.
  pub fn anchor(self: &mut Self, key: u64) -> () {
    if !self.dispatching {
      self.marked = true
      let extra = self.extraMut()
      extra.hasAnchor = true
      extra.anchor = key
    }
  }

  /// Attaches this popup to the node named by `anchor(key)` in the same view.
  /// The tree updates placement after scrolling and layout. The anchor key must exist.
  pub fn anchored(self: &mut Self, key: u64, options: AnchorOptions) -> () {
    if !self.dispatching && !self.searching {
      self.marked = true
      let extra = self.extraMut()
      extra.hasPlacement = true
      extra.placementTarget = key
      extra.placementOptions = options
    }
  }

  /// The border box, in CSS pixels of the viewport, of the node anchored as `key` in the last
  /// render, as the tree last laid it out; none before it was laid out. A popup places itself
  /// next to it, and a slider maps a pointer position to a value with it.
  /// The current window content bounds, in logical pixels, for collision-aware overlays.
  pub fn viewport(self: &Self) -> Rect<f32> {
    return self.viewportBounds
  }

  pub fn anchorRect(self: &Self, key: u64) -> Option<Rect<f32>> {
    let anchors = self.anchors.asSlice()
    let mut i: usize = 0
    while i < anchors.length {
      if anchors[i].key == key {
        return Option<Rect<f32>>.Some { value: anchors[i].rect }
      }
      i = i + 1
    }
    return Option<Rect<f32>>.None
  }

  /// Whether the node anchored as `key` is pressed: a press on it or inside it is in progress.
  pub fn anchorPressed(self: &Self, key: u64) -> bool {
    let anchors = self.anchors.asSlice()
    let mut i: usize = 0
    while i < anchors.length {
      if anchors[i].key == key {
        return anchors[i].pressed
      }
      i = i + 1
    }
    return false
  }

  /// Adds the nodes `body` opens to the overlay layer instead of the open node: a box under
  /// the root, after everything else, so they are drawn and hit above the rest of the view
  /// (menus, popovers, tooltips, dialogs). `key` names this overlay among the others (unique in
  /// the view, as the anchor key of the popup's button usually is): its nodes go in a box of
  /// their own, keyed `key`, at the viewport's top left with no size. Place them with
  /// `position: absolute` and `inset` (next to an [`anchorRect`]) or `position: fixed`.
  ///
  /// Events in an overlay bubble to the root, not to the node that opened it. To find the
  /// handlers of an event in an overlay, the dispatch pass runs the whole view, because the
  /// `overlay` call can be anywhere in it; handlers outside the overlay do not run. `lazy`
  /// does not reuse a region that opened an overlay.
  pub fn overlay(self: &mut Self, key: u64, body: fn(&mut Ui<M>) -> ()) -> () {
    self.overlays = self.overlays + 1
    let pending = self.hasPendingKey
    self.hasPendingKey = false
    let identity = Identity { keyed: true, value: key }
    if self.dispatching {
      if !self.searching {
        // The event is not in an overlay, or is in this one's parent region: nothing here.
        self.hasPendingKey = pending
        return ()
      }
      if self.path.length() < 2 || !self.path.get(1).same(&identity) {
        // Another overlay: one nested in this one may hold the event.
        body(&mut self)
        self.hasPendingKey = pending
        return ()
      }
      let depth = self.depth
      let mut saved = List<u32>.make()
      self.heap.alloc(saved.appendSlice(self.ordinals.asSlice()))
      while self.ordinals.length() < 3 {
        self.heap.alloc(self.ordinals.append(0))
      }
      self.depth = 2
      self.ordinals.set(2, 0)
      self.searching = false
      body(&mut self)
      self.searching = true
      self.ordinals.clear()
      self.heap.alloc(self.ordinals.appendSlice(saved.asSlice()))
      self.depth = depth
      self.hasPendingKey = pending
      return ()
    }
    let parent = self.current
    if self.overlayHost == NO_ENTRY {
      self.current = 0
      let host = self.open(NodeKind.Box, overlayIdentity())
      self.current = host
      self.zeroBox()
      self.testId("overlay")
      self.overlayHost = host
    }
    self.current = self.overlayHost
    let wrapper = self.open(NodeKind.Box, identity)
    self.current = wrapper
    self.zeroBox()
    body(&mut self)
    self.hasPendingKey = pending
    self.current = parent
  }

  /// Makes the open node a positioned box with no size at its containing block's top left.
  fn zeroBox(self: &mut Self) -> () {
    self.style(
      &[
        css.position(Position.Absolute),
        css.top(px(0.0)),
        css.left(px(0.0)),
        css.width(px(0.0)),
        css.height(px(0.0)),
      ],
    )
  }

  // Handlers.

  /// Handles records of `kind` at the open node: `handler` runs during dispatch when the record
  /// targets this node or, for bubbling kinds, a node below it.
  pub fn on(self: &mut Self, kind: EventKind, handler: fn(&Event) -> Reply<M>) -> () {
    if !self.dispatching {
      let entry = self.arena.entryMut(self.current)
      entry.listeners = u32.bitOr(entry.listeners, listenerFlag(kind))
      entry.liveKinds = u32.bitOr(entry.liveKinds, listenerFlag(kind))

      return ()
    }
    if self.searching || self.event.kind != kind {
      return ()
    }
    if !bubbles(kind) && u32.toUsize(self.depth) != self.path.length() {
      return ()
    }
    let reply = handler(&self.event)
    let answer = Answer<M> { depth: self.depth, reply: move reply }
    self.heap.alloc(self.answers.append(move answer))
  }

  /// The open node answers the next record of `kind` with `reply`, which it already has: a
  /// handler that sends a fixed message. A render keeps the reply, and a dispatch of a record
  /// whose path has only such handlers for its kind takes them from here instead of running
  /// the view again (see `answerKept`). In a dispatch pass it is a handler as `on` is.
  pub fn keep(self: &mut Self, kind: EventKind, reply: Reply<M>) -> () {
    if self.dispatching {
      if self.searching || self.event.kind != kind {
        return ()
      }
      if !bubbles(kind) && u32.toUsize(self.depth) != self.path.length() {
        return ()
      }
      let answer = Answer<M> { depth: self.depth, reply: move reply }
      self.heap.alloc(self.answers.append(move answer))
      return ()
    }
    let entry = self.arena.entryMut(self.current)
    entry.listeners = u32.bitOr(entry.listeners, listenerFlag(kind))

    let kept = Kept<M> { entry: self.current, kind: kind, reply: move reply, taken: false }
    self.heap.alloc(self.kept.append(move kept))
  }

  /// Answers the record `beginDispatch` started from the replies the last render kept, for
  /// the path whose entries (root first) are `entries`. False when it cannot: a node on the
  /// path answers the record's kind by running code, or was copied by `lazy` without its kept
  /// replies, or a dispatch already took the kept replies. The runtime then runs the view.
  pub fn answerKept(self: &mut Self, entries: &[u32]) -> bool {
    if self.keptSpent || self.searching || entries.length == 0 {
      return false
    }
    let kind = self.event.kind
    let flag = listenerFlag(kind)
    let mut i: usize = 0
    while i < entries.length {
      let entry = self.arena.entryRef(entries[i])
      if (entry.copied && !entry.carried) || u32.bitAnd(entry.liveKinds, flag) != 0 {
        return false
      }
      i = i + 1
    }
    self.keptSpent = true
    let last = entries.length - 1
    let mut depth: usize = 0
    while depth < entries.length {
      if bubbles(kind) || depth == last {
        let target = entries[depth]
        // The first kept reply of `target`: `kept` is in entry order.
        let mut low: usize = 0
        let mut high = self.kept.length()
        while low < high {
          let middle = (low + high) / 2
          if self.kept.asSlice()[middle].entry < target {
            low = middle + 1
          } else {
            high = middle
          }
        }
        while low < self.kept.length() && self.kept.asSlice()[low].entry == target {
          if self.kept.asSlice()[low].kind == kind {
            let item = &mut self.kept.asMutSlice()[low]
            item.taken = true
            let reply = Intrinsic.replace(item.reply, Reply<M>.Pass)
            let answer = Answer<M> { depth: usize.toU32(depth), reply: move reply }
            self.heap.alloc(self.answers.append(move answer))
          }
          low = low + 1
        }
      }
      depth = depth + 1
    }
    return true
  }

  /// Sends `handler()` when the open node is clicked (or pressed with Enter or Space when it is
  /// a focused button).
  pub fn onClick(self: &mut Self, handler: fn() -> M) -> () {
    self.on(EventKind.Click, |event| Reply<M>.Emit { message: handler() })
  }

  pub fn onPointerDown(self: &mut Self, handler: fn(&Event) -> Reply<M>) -> () {
    self.on(EventKind.PointerDown, handler)
  }

  pub fn onKeyDown(self: &mut Self, handler: fn(&Event) -> Reply<M>) -> () {
    self.on(EventKind.KeyDown, handler)
  }

  pub fn onFocus(self: &mut Self, handler: fn() -> M) -> () {
    self.on(EventKind.Focus, |event| Reply<M>.Emit { message: handler() })
  }

  /// Sends `handler()` when the open image's or icon's source has loaded, as DOM `load`.
  pub fn onLoad(self: &mut Self, handler: fn() -> M) -> () {
    self.on(EventKind.Load, |event| Reply<M>.Emit { message: handler() })
  }

  /// Sends `handler()` when the open image's or icon's source failed to load or decode, as
  /// DOM `error`.
  pub fn onError(self: &mut Self, handler: fn() -> M) -> () {
    self.on(EventKind.Error, |event| Reply<M>.Emit { message: handler() })
  }

  pub fn onBlur(self: &mut Self, handler: fn() -> M) -> () {
    self.on(EventKind.Blur, |event| Reply<M>.Emit { message: handler() })
  }

  /// Sends `handler(value)` when the open input's value changes; `value` is the input's new
  /// value, a copy the message can keep.
  pub fn onInput(self: &mut Self, handler: fn(String) -> M) -> () {
    if !self.dispatching {
      self.on(EventKind.Input, |event| Reply<M>.Pass)
      return ()
    }
    if self.searching || self.event.kind != EventKind.Input {
      return ()
    }
    let value = self.heap.alloc(String.copy(String.view(&self.event.value)))
    let message = handler(move value)
    let answer = Answer<M> { depth: self.depth, reply: Reply<M>.Emit { message: move message } }
    self.heap.alloc(self.answers.append(move answer))
  }

  /// Sends `handler()` when Enter goes down with no modifier in the open node or below it (an
  /// input's submit), and stops the key there.
  pub fn onEnter(self: &mut Self, handler: fn() -> M) -> () {
    self.on(
      EventKind.KeyDown,
      |event| if String.view(&event.key) == "Enter" && event.modifiers == 0 {
        Reply<M>.EmitAndStop { message: handler() }
      } else {
        Reply<M>.Pass
      },
    )
  }
}

fn flagValue(value: bool) -> i32 {
  return if value { 1 } else { 0 }
}
