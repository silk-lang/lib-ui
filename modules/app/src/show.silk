  }
}

impl Shown for f32 {
  effect fn shown(self: &Self, to: &mut Printer) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run to.real(f32.toF64(self.*))
  }
}

impl Shown for f64 {
  effect fn shown(self: &Self, to: &mut Printer) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run to.real(self.*)
  }
}

static fn leaf<T>() -> bool {
  let name = Reflect.typeName<T>()
  return name == "String" || name == "bool" || name == "u8" || name == "u16" || name == "u32"
    || name == "u64"
    || name == "usize"
    || name == "i8"
    || name == "i16"
    || name == "i32"
    || name == "i64"
    || name == "f32"
    || name == "f64"
}

static fn isList<T>() -> bool {
  let name = Reflect.typeName<T>()
  return StaticText.byteLength(name) > 5 && StaticText.slice(name, 0, 5) == "List<"
}

/// The wrappers a runtime puts around a program's model and commands show as what they wrap.
static fn wrapper<T>() -> bool {
  let name = Reflect.typeName<T>()
  return (StaticText.byteLength(name) > 7 && StaticText.slice(name, 0, 7) == "Hosted<")
    || (StaticText.byteLength(name) > 4 && StaticText.slice(name, 0, 4) == "Run<")
}

static fn fieldCount<U>(variant: Intrinsic.Variant<U>) -> usize {
  let mut count: usize = 0
  static for _field in Reflect.variantFields(variant) {
    count = count + 1
  }
  return count
}

static fn structFields<T>() -> usize {
  let mut count: usize = 0
  static for _field in Reflect.fields<T>() {
    count = count + 1
  }
  return count
}

effect fn member<T: Shown>(value: &T, to: &mut Printer) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run Shown.shown(value, &mut to)
}

effect fn listOf<T>(list: &List<T>, to: &mut Printer) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let items = list.asSlice()
  if !to.pretty {
    run to.write("[")
    let mut i: usize = 0
    while i < items.length && i < 8 {
      if i != 0 {
        run to.write(", ")
      }
      run walk(&items[i], &mut to)
      i = i + 1
    }
    if i < items.length {
      run to.write(", …")
    }
    return run to.write("]")
  }
  run to.write("[")
  run to.unsigned(usize.toU64(items.length))
  run to.write("]")
  to.depth = to.depth + 1
  let mut i: usize = 0
  while i < items.length && i < MAX_ITEMS {
    run to.line()
    run to.unsigned(usize.toU64(i))
    run to.write(": ")
    run walk(&items[i], &mut to)
    i = i + 1
  }
  if i < items.length {
    run to.line()
    run to.write("… ")
    run to.unsigned(usize.toU64(items.length - i))
    run to.write(" more")
  }
  to.depth = to.depth - 1
}

struct Holder<'a, T> {
  pub item: &'a T,
}

/// Writes `value` to `to`.
pub effect fn walk<T>(value: &T, to: &mut Printer) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let holder = Holder<T> { item: value }

  // The loop has one turn. Its body is checked with the type `T` is, not with the parameter,
  // which is what lets one function treat a number, a list and a struct each in its own way.
  static for held in Reflect.fields<Holder<T>>() {
    let item = Reflect.borrowField(&holder, held).*
    static if leaf<T>() {
      run member(item, &mut to)
    } else {
      static if isList<T>() {
        run listOf(item, &mut to)
      } else {
        static if wrapper<T>() {
          static for field in Reflect.fields<T>() {
            run walk(Reflect.borrowField(item, field), &mut to)
          }
        } else {
          static if Reflect.typeKind(Reflect.typeOf<T>()) == namedKind {
            run to.write(Reflect.typeName<T>())
            static if structFields<T>() != 0 {
              if !to.pretty {
                run to.write(" { ")
              }
              to.depth = to.depth + 1
              let mut first = true
              static for field in Reflect.fields<T>() {
                if to.pretty {
                  run to.line()
                } else if !first {
                  run to.write(", ")
                }
                first = false
                run to.write(Reflect.fieldLabel(field))
                run to.write(": ")
                run walk(Reflect.borrowField(item, field), &mut to)
              }
              to.depth = to.depth - 1
              if !to.pretty {
                run to.write(" }")
              }
            }
          } else {
            static if Reflect.typeKind(Reflect.typeOf<T>()) == unionKind {
              static for variant in Reflect.variants<T>() {
                if Reflect.isVariant(item, variant) {
                  run to.write(Reflect.variantLabel(variant))
                  static if fieldCount(variant) != 0 {
                    if !to.pretty {
                      run to.write(" { ")
                    }
                    to.depth = to.depth + 1
                    let mut first = true
                    static for field in Reflect.variantFields(variant) {
                      if to.pretty {
                        run to.line()
                      } else if !first {
                        run to.write(", ")
                      }
                      first = false
                      run to.write(Reflect.fieldLabel(field))
                      run to.write(": ")
                      run walk(Reflect.borrowVariantField(item, variant, field), &mut to)
                    }
                    to.depth = to.depth - 1
                    if !to.pretty {
                      run to.write(" }")
                    }
                  }
                }
              }
            } else {
              run to.write("<")
              run to.write(Reflect.typeName<T>())
              run to.write(">")
            }
          }
        }
      }
    }
  }
}

/// `value` on one line: `Chose { action: 3 }`.
pub effect fn show<T>(value: &T) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut to = Printer.make(false)
  run walk(value, &mut to)
  return move to.out
}

/// `value` with one line per field, indented by depth.
pub effect fn showTree<T>(value: &T) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut to = Printer.make(true)
  run walk(value, &mut to)
  return move to.out
}
