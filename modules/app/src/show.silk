//! [`show`]: any value as text, by reflection. It is how the journal writes down a program's
//! messages, commands and model without the program saying how.
//!
//! Structs and unions show their `pub` fields; lists show their items; numbers, booleans and
//! strings show themselves. A type reflection cannot open (an enum, an array, a map) shows as
//! its name in angle brackets.
//!
//! The pretty form is one line per field, indented by depth, so two of them compare line by
//! line:
//!
//! ```text
//! Notes
//!   text: "hello"
//!   dirty: true
//!   todos: [1]
//!     0: Todo
//!       title: "milk"
//! ```
import silk.collections.list { List }
import silk.core.reflect { Reflect, namedKind, unionKind }
import silk.core.static_text { StaticText }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.num.i16
import silk.num.i32
import silk.num.i64
import silk.num.i8
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize
import silk.text.string { String }

/// The most items of a list the pretty form shows.
pub const MAX_ITEMS: usize = 100

/// The most bytes of a string either form shows.
pub const MAX_TEXT: usize = 240

/// Where a value is being written.
pub struct Printer {
  pub out: String,
  pub pretty: bool,
  depth: u32,
}

impl Printer {
  pub fn make(pretty: bool) -> Printer {
    return Printer { out: String.make(), pretty: pretty, depth: 0 }
  }

  effect fn write(self: &mut Self, text: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.out.append(text)
  }

  /// Starts the line of a child in the pretty form.
  effect fn line(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.out.append("\n")
    let mut i: u32 = 0
    while i < self.depth {
      run self.out.append("  ")
      i = i + 1
    }
  }

  pub effect fn unsigned(self: &mut Self, value: u64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut digits: [u8; 20] = [0; 20]
    let mut at: usize = 20
    let mut rest = value
    while true {
      at = at - 1
      digits[at] = 48 + u64.toU8(rest % 10)
      rest = rest / 10
      if rest == 0 {
        break
      }
    }
    while at < 20 {
      let one: [u8; 1] = [digits[at]]

      // An ASCII digit is a whole character.
      run self.out.append(unsafe String.fromUtf8Unchecked(&one))
      at = at + 1
    }
  }

  pub effect fn signed(self: &mut Self, value: i64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if value < 0 {
      run self.out.append("-")

      // The least value has no positive counterpart.
      run self.unsigned(i64.toU64(-(value + 1)) + 1)
    } else {
      run self.unsigned(i64.toU64(value))
    }
  }

  /// At most four digits after the point, without trailing zeros.
  pub effect fn real(self: &mut Self, value: f64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if value != value {
      return run self.out.append("NaN")
    }
    let mut rest = value
    if rest < 0.0 {
      run self.out.append("-")
      rest = -rest
    }
    if rest > 9.0e15 {
      return run self.out.append("∞")
    }
    let scaled = f64.toU64(rest * 10000.0 + 0.5)
    run self.unsigned(scaled / 10000)
    let mut fraction = scaled % 10000
    if fraction == 0 {
      return ()
    }
    run self.out.append(".")
    let mut place: u64 = 1000
    while fraction != 0 {
      run self.unsigned(fraction / place)
      fraction = fraction % place
      place = place / 10
    }
  }

  pub effect fn quoted(self: &mut Self, text: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let bytes = String.utf8Bytes(text)
    let mut end = bytes.length
    if end > MAX_TEXT {
      end = MAX_TEXT

      // Not in the middle of a character.
      while end > 0 && (bytes[end] & 0xC0) == 0x80 {
        end = end - 1
      }
    }
    run self.out.append("\"")
    let mut from: usize = 0
    let mut i: usize = 0
    while i < end {
      let byte = bytes[i]
      if byte == 10 || byte == 34 || byte == 92 || byte == 9 || byte == 13 {
        run self.out.append(String.slice(text, from, i - from))
        run self.out.append(
          if byte == 10 {
            "\\n"
          } else if byte == 34 {
            "\\\""
          } else if byte == 9 {
            "\\t"
          } else if byte == 13 {
            "\\r"
          } else {
            "\\\\"
          },
        )
        from = i + 1
      }
      i = i + 1
    }
    run self.out.append(String.slice(text, from, end - from))
    if end < bytes.length {
      run self.out.append("…")
    }
    run self.out.append("\"")
  }
}

/// A value that writes itself: the leaves of what [`show`] walks.
pub interface Shown {
  effect fn shown(self: &Self, to: &mut Printer) -> () ! OutOfMemoryError ? &mut Allocator
}

impl Shown for String {
  effect fn shown(self: &Self, to: &mut Printer) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run to.quoted(String.view(self))
  }
}

impl Shown for bool {
  effect fn shown(self: &Self, to: &mut Printer) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run to.write(
      if self.* {
        "true"
      } else {
        "false"
      },
    )
  }
}

impl Shown for u8 {
  effect fn shown(self: &Self, to: &mut Printer) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run to.unsigned(u8.toU64(self.*))
  }
}

impl Shown for u16 {
  effect fn shown(self: &Self, to: &mut Printer) -> ()
