//! The app contract: [`App`] (view, update, subscriptions) on the model, [`Perform`] on the
//! command type, and the [`Context`] and [`Subscriptions`] builders they write into.
import heap { Heap }
import program { Submodel }
import ui { Ui }
import silk.core.option { Option }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.u8
import silk.num.u64
import silk.num.usize
import silk.text.string { String }

/// An app, implemented by its model type `Self` for its message type `M` and command type `C`.
///
/// `view` and `update` are plain functions: the runtime calls `view` to render and again to
/// dispatch each event, and `update` for each message. Neither stores closures, and all their
/// effects go through the builders: nodes and handlers into the [`Ui`], commands into the
/// [`Context`], and memory through `ui.alloc` and `cx.alloc`.
pub interface App<M, C> {
  /// Describes the UI for the model.
  fn view(self: &Self, ui: &mut Ui<M>) -> ()

  /// Applies `message` to the model. Work with effects goes out as commands: `cx.command(c)`.
  fn update(self: &mut Self, message: M, cx: &mut Context<C>) -> ()

  /// The subscriptions the model wants now. The runtime asks after every update, starts the
  /// new ones and stops the ones that are gone, by key. None by default.
  fn subscriptions(self: &Self, subs: &mut Subscriptions<M>) -> () {
    return ()
  }
}

/// How a command turns into a message: the only effectful code of an app. `E` and `R` are the
/// failures and requirements of that work (storage, network, clocks), provided once where the
/// app starts, and swappable in tests. `perform` takes the command by value, so a command can
/// move what it carries (a `String`, a buffer) into the work.
pub interface Perform<M, E, ? R> {
  effect fn perform(self: Self) -> M ! E ? R
}

/// The command type of an app without commands.
pub struct NoCommand {}

impl<M> Perform<M, never ? never> for NoCommand {
  effect fn perform(self: Self) -> M {
    return Intrinsic.trap("ui-app: NoCommand is never performed")
  }
}

/// What `update` writes into: commands to perform after it, and memory.
pub struct Context<C> {
  pub heap: Heap,
  pub commands: List<C>,
  /// Where this update moves the location to, if anywhere.
  pub destination: Option<String>,
}

impl<C> Context<C> {
  pub fn make() -> Context<C> {
    return Context<C> {
      heap: Heap.make(),
      commands: List<C>.make(),
      destination: Option<String>.none(),
    }
  }

  /// Moves the location to `path` after this update, as a click on a link to it does.
  pub fn navigate(self: &mut Self, path: string) -> () {
    self.destination = Option<String>.some(self.heap.alloc(String.copy(path)))
  }

  /// Performs `command` after this update; the message it produces is handled next.
  pub fn command(self: &mut Self, command: C) -> () {
    self.heap.alloc(self.commands.append(move command))
  }

  /// Runs allocating work (see [`Heap.alloc`]).
  pub fn alloc<A>(self: &mut Self, work: once Effect<A ! OutOfMemoryError ? &mut Allocator>) -> A {
    return self.heap.alloc(move work)
  }

  /// A copy of `value` as an owned `String`.
  pub fn copy(self: &mut Self, value: string) -> String {
    return self.heap.alloc(String.copy(value))
  }
}

/// The kinds of subscription.
pub enum SubscriptionKind {
  /// A message every `interval` seconds.
  Every,
  /// A message per display frame.
  AnimationFrame,
  /// A message when a key with exact modifiers goes down, wherever focus is.
  KeyBinding,
  /// A message when the viewport changes size.
  Resize,
  /// A message when the location changes.
  Location,
  /// A message when the host posts to a named port.
  Port,
}

/// One subscription the model asked for.
pub struct SubscriptionRecord {
  pub key: u64,
  pub kind: SubscriptionKind,
  pub interval: f64,
  pub keyStart: u32,
  pub keyLength: u32,
  pub modifiers: u32,
}

impl Copy for SubscriptionRecord {}

/// What a firing subscription delivers to its handler.
pub struct Delivery {
  pub kind: SubscriptionKind,
  pub key: u64,
  /// The time in seconds (timers, frames).
  pub time: f64,
  /// The viewport size (resize).
  pub width: f32,
  pub height: f32,
}

impl Copy for Delivery {}

/// The builder `subscriptions` writes into. As with views, handlers are lambdas that are never
/// stored: the runtime asks again when a subscription fires and calls the matching handler.
pub struct Subscriptions<M> {
  pub heap: Heap,
  pub records: List<SubscriptionRecord>,
  pub bytes: List<u8>,
  delivering: bool,
  delivery: Delivery,
  pub messages: List<M>,
  /// Where the app is: the path the runtime was last moved to. `"/"` until then.
  pub current: String,
  /// What the host posted, while a port's handler is asked for its message.
  pub posted: String,
}

impl<M> Subscriptions<M> {
  pub fn make() -> Subscriptions<M> {
    return Subscriptions<M> {
      heap: Heap.make(),
      records: List<SubscriptionRecord>.make(),
      bytes: List<u8>.make(),
      delivering: false,
      delivery: Delivery {
        kind: SubscriptionKind.Every,
        key: 0,
        time: 0.0,
        width: 0.0,
        height: 0.0,
      },
      messages: List<M>.make(),
      current: String.make(),
      posted: String.make(),
    }
  }

  /// Starts collecting the model's subscriptions.
  pub fn beginCollect(self: &mut Self) -> () {
    self.records.clear()
    self.bytes.clear()
    self.delivering = false
  }

  /// Starts delivering `delivery` to the handler with its kind and key.
  pub fn beginDelivery(self: &mut Self, delivery: Delivery) -> () {
    self.delivering = true
    self.delivery = delivery
  }

  /// The collected subscriptions.
  pub fn list(self: &Self) -> &[SubscriptionRecord] {
    return self.records.asSlice()
  }

  /// The key name of a key binding.
  pub fn keyName(self: &Self, record: SubscriptionRecord) -> &[u8] {
    return Slice.view(
      self.bytes.asSlice(),
      u32.toUsize(record.keyStart),
      u32.toUsize(record.keyLength),
    )
  }

  fn add(self: &mut Self, record: SubscriptionRecord) -> () {
    self.heap.alloc(self.records.append(record))
  }

  fn wants(self: &Self, kind: SubscriptionKind, key: u64) -> bool {
    return self.delivering && self.delivery.kind == kind && self.delivery.key == key
  }

  /// `handler(time)` every `interval` seconds, the first one `interval` after the
  /// subscription starts.
  pub fn every(self: &mut Self, key: u64, interval: f64, handler: fn(f64) -> M) -> () {
    if self.wants(SubscriptionKind.Every, key) {
      self.heap.alloc(self.messages.append(handler(self.delivery.time)))
    } else if !self.delivering {
      self.add(
        SubscriptionRecord {
          key: key,
          kind: SubscriptionKind.Every,
          interval: interval,
          keyStart: 0,
          keyLength: 0,
          modifiers: 0,
        },
      )
    }
  }

  /// `handler(time)` once per display frame, with the frame's time in seconds. For motion the
  /// model drives (a game, a chart); style changes animate better inside the tree.
  pub fn animationFrame(self: &mut Self, key: u64, handler: fn(f64) -> M) -> () {
    if self.wants(SubscriptionKind.AnimationFrame, key) {
      self.heap.alloc(self.messages.append(handler(self.delivery.time)))
    } else if !self.delivering {
      self.add(
        SubscriptionRecord {
          key: key,
          kind: SubscriptionKind.AnimationFrame,
          interval: 0.0,
          keyStart: 0,
          keyLength: 0,
          modifiers: 0,
        },
      )
    }
  }

  /// `handler()` when the key named `name` (a UI Events `key`, such as `"n"` or `"Escape"`)
  /// goes down with exactly the `MOD_*` bits `modifiers`, wherever focus is. A handler in the
  /// view that stops the event first wins. While a text input has focus only chords with
  /// Control, Alt or Meta, and Escape, fire: the other keys are the input's.
  pub fn keyBinding(
    self: &mut Self,
    key: u64,
    name: string,
    modifiers: u32,
    handler: fn() -> M,
  ) -> () {
    if self.wants(SubscriptionKind.KeyBinding, key) {
      self.heap.alloc(self.messages.append(handler()))
    } else if !self.delivering {
      let start = usize.toU32(self.bytes.length())
      self.heap.alloc(self.bytes.appendSlice(String.utf8Bytes(name)))
      self.add(
        SubscriptionRecord {
          key: key,
          kind: SubscriptionKind.KeyBinding,
          interval: 0.0,
          keyStart: start,
          keyLength: usize.toU32(String.byteLength(name)),
          modifiers: modifiers,
        },
      )
    }
  }

  /// `handler(width, height)` when the viewport changes size, in CSS pixels.
  pub fn resize(self: &mut Self, key: u64, handler: fn(f32, f32) -> M) -> () {
    if self.wants(SubscriptionKind.Resize, key) {
      self.heap.alloc(self.messages.append(handler(self.delivery.width, self.delivery.height)))
    } else if !self.delivering {
      self.add(
        SubscriptionRecord {
          key: key,
          kind: SubscriptionKind.Resize,
          interval: 0.0,
          keyStart: 0,
          keyLength: 0,
          modifiers: 0,
        },
      )
    }
  }

  /// `handler(path)` when the location changes, and once with the location the app starts at,
  /// before the first render. The path is the app's own, such as `"/guide"`: a document backend
  /// takes it from the address bar, and every backend moves it when a link (`h.link`) is
  /// clicked.
  pub fn location(self: &mut Self, key: u64, handler: fn(string) -> M) -> () {
    if self.wants(SubscriptionKind.Location, key) {
      let mut path: string = String.view(&self.current)
      if String.byteLength(path) == 0 {
        path = "/"
      }
      let message = handler(path)
      self.heap.alloc(self.messages.append(move message))
    } else if !self.delivering {
      self.add(
        SubscriptionRecord {
          key: key,
          kind: SubscriptionKind.Location,
          interval: 0.0,
          keyStart: 0,
          keyLength: 0,
          modifiers: 0,
        },
      )
    }
  }

  /// `handler(text)` when the host posts `text` to the port `name`. This is how work that
  /// outlives a command comes back: the command starts it (a request, a timer, a socket) and
  /// returns, and the host posts the result when it has one (`post`; `page.post(name, text)`
  /// in a document).
  pub fn port(self: &mut Self, key: u64, name: string, handler: fn(String) -> M) -> () {
    if self.wants(SubscriptionKind.Port, key) {
      let message = handler(self.heap.alloc(String.copy(String.view(&self.posted))))
      self.heap.alloc(self.messages.append(move message))
    } else if !self.delivering {
      let start = usize.toU32(self.bytes.length())
      self.heap.alloc(self.bytes.appendSlice(String.utf8Bytes(name)))
      self.add(
        SubscriptionRecord {
          key: key,
          kind: SubscriptionKind.Port,
          interval: 0.0,
          keyStart: start,
          keyLength: usize.toU32(String.byteLength(name)),
          modifiers: 0,
        },
      )
    }
  }

  // What the shell says (see `shell.silk`). Each is a port with a reserved name.

  /// `handler(action)` when an item of the menu a `Shell.setMenu` installed is chosen.
  pub fn menuAction(self: &mut Self, key: u64, handler: fn(u32) -> M) -> () {
    self.port(key, PORT_MENU, |text| handler(leadingNumber(String.view(&text))))
  }

  /// `handler(request, paths)` when a dialog `Shell.openFile` or `Shell.saveFile` opened
  /// closes: the request it was opened with and the paths chosen, none when cancelled.
  pub fn files(self: &mut Self, key: u64, handler: fn(u32, List<String>) -> M) -> () {
    self.port(
      key,
      PORT_FILES,
      |text| handler(leadingNumber(String.view(&text)), linesAfterFirst(String.view(&text))),
    )
  }

  /// `handler(dark)` when the system's appearance changes.
  pub fn appearance(self: &mut Self, key: u64, handler: fn(bool) -> M) -> () {
    self.port(key, PORT_APPEARANCE, |text| handler(String.view(&text) == "dark"))
  }

  /// `handler(focused)` when the window becomes the one the user works in, or stops being it.
  pub fn windowFocus(self: &mut Self, key: u64, handler: fn(bool) -> M) -> () {
    self.port(key, PORT_FOCUS, |text| handler(String.view(&text) == "1"))
  }

  /// `handler()` when the user asks to close the window or quit. A program that subscribes
  /// decides: the window stays until a command calls `Shell.quit`. Without the subscription
  /// the window closes at once.
  pub fn closeRequested(self: &mut Self, key: u64, handler: fn() -> M) -> () {
    self.port(key, PORT_CLOSE, |text| handler())
  }

  /// The subscriptions `body` asks for, as this builder's: each message goes through `wrap`.
  /// `scope` keeps the keys in `body` apart from the ones around it, so two children may use
  /// the same keys under different scopes.
  pub fn lift<CM>(
    self: &mut Self,
    scope: u64,
    body: fn(&mut Subscriptions<CM>) -> (),
    wrap: fn(CM) -> M,
  ) -> () {
    let mut inner = Subscriptions<CM>.make()
    inner.current = self.heap.alloc(String.copy(String.view(&self.current)))
    inner.posted = self.heap.alloc(String.copy(String.view(&self.posted)))
    body(&mut inner)
    if !self.delivering {
      let mut i: usize = 0
      while i < inner.records.length() {
        let mut record = inner.records.get(i)
        let name = inner.keyName(record)
        record.key = scoped(scope, record.key)
        record.keyStart = usize.toU32(self.bytes.length())
        self.heap.alloc(self.bytes.appendSlice(name))
        self.add(record)
        i = i + 1
      }
      return ()
    }

    // The delivery names a scoped key: find the key `body` gave it, and ask `body` again.
    let mut i: usize = 0
    while i < inner.records.length() {
      let record = inner.records.get(i)
      if record.kind == self.delivery.kind && scoped(scope, record.key) == self.delivery.key {
        let mut delivery = self.delivery
        delivery.key = record.key
        inner.beginDelivery(delivery)
        body(&mut inner)
        while inner.messages.length() > 0 {
          self.heap.alloc(self.messages.append(wrap(inner.messages.remove(0))))
        }
        return ()
      }
      i = i + 1
    }
  }

  /// A child's subscriptions. `wrap` turns each of the child's messages into one of this
  /// builder's, and `scope` tells this child from the others (see [`Subscriptions.lift`]).
  pub fn submodel<Child: Submodel<CM, CC, CO>, CM, CC, CO>(
    self: &mut Self,
    scope: u64,
    child: &Child,
    wrap: fn(CM) -> M,
  ) -> () {
    self.lift(
      scope,
      |inner: &mut Subscriptions<CM>| Submodel.subscriptions(child, &mut inner),
      wrap,
    )
  }
}

/// The port a host posts a chosen menu item to: the action, in decimal.
pub const PORT_MENU: string = "shell:menu"

/// The port a host posts a closed file dialog to: the request in decimal, then one line per
/// path.
pub const PORT_FILES: string = "shell:files"

/// The port a host posts the system's appearance to: `"dark"` or `"light"`.
pub const PORT_APPEARANCE: string = "shell:appearance"

/// The port a host posts the window's focus to: `"1"` or `"0"`.
pub const PORT_FOCUS: string = "shell:focus"

/// The port a host posts a request to close the window to.
pub const PORT_CLOSE: string = "shell:close"

/// The decimal number `text` starts with; zero when it starts with none.
fn leadingNumber(text: string) -> u32 {
  let bytes = String.utf8Bytes(text)
  let mut value: u32 = 0
  let mut i: usize = 0
  while i < bytes.length && bytes[i] >= 48 && bytes[i] <= 57 {
    value = value * 10 + (u8.toU32(bytes[i]) - 48)
    i = i + 1
  }
  return value
}

/// The lines of `text` after its first, without the empty ones.
fn linesAfterFirst(text: string) -> List<String> {
  let mut heap = Heap.make()
  let mut lines = List<String>.make()
  let bytes = String.utf8Bytes(text)
  let mut i: usize = 0
  while i < bytes.length && bytes[i] != 10 {
    i = i + 1
  }
  while i < bytes.length {
    let start = i + 1
    i = start
    while i < bytes.length && bytes[i] != 10 {
      i = i + 1
    }
    if i > start {
      if let Result.Success { value } = String.fromUtf8(Slice.view<u8>(bytes, start, i - start)) {
        let line = heap.alloc(String.copy(value))
        heap.alloc(lines.append(move line))
      }
    }
  }
  return move lines
}

/// `key` as seen from outside the scope `scope`.
fn scoped(scope: u64, key: u64) -> u64 {
  let mut z = u64.wrappingAdd(
    u64.bitXor(u64.wrappingMultiply(scope, 0x9E3779B97F4A7C15), key),
    0x9E3779B97F4A7C15,
  )
  z = u64.wrappingMultiply(u64.bitXor(z, u64.shiftRight(z, 30)), 0xBF58476D1CE4E5B9)
  z = u64.wrappingMultiply(u64.bitXor(z, u64.shiftRight(z, 27)), 0x94D049BB133111EB)
  return u64.bitXor(z, u64.shiftRight(z, 31))
}
