//! [`Journal`]: what a program did, one [`Step`] per message, for an inspector to read.
//!
//! A runtime keeps no journal until a host asks for one (`Runtime.record`): writing down a
//! model after every message costs time that only someone watching should pay.
import ui_protocol.record { EventKind }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

/// How many steps a journal keeps; older ones are dropped.
pub const STEP_LIMIT: usize = 200

/// The most bytes of a model a step keeps.
pub const MODEL_LIMIT: usize = 262144

/// One message, and what `update` made of it.
pub struct Step {
  /// The step's number, from 1. Step 1 is the model `init` made.
  pub seq: u64,
  /// The runtime's time when the message was handled, in seconds.
  pub time: f64,
  /// Where the message came from: `"click #12"`, `"port menu"`, `"timer"`, `"command Save"`.
  pub cause: String,
  /// The message, on one line.
  pub message: String,
  /// The commands `update` returned, one line each.
  pub commands: List<String>,
  /// The model after `update`, one line per field.
  pub model: String,
}

pub struct Journal {
  pub on: bool,
  pub steps: List<Step>,
  /// The number the next step gets.
  pub next: u64,
  /// Where each queued message came from, in the queue's order.
  pub causes: List<String>,
  /// The port being posted to, while its subscriptions are asked for their messages.
  pub port: String,
}

impl Journal {
  pub fn make() -> Journal {
    return Journal {
      on: false,
      steps: List<Step>.make(),
      next: 1,
      causes: List<String>.make(),
      port: String.make(),
    }
  }

  /// Adds a step and drops the oldest one past [`STEP_LIMIT`].
  pub effect fn add(
    self: &mut Self,
    time: f64,
    cause: String,
    message: String,
    commands: List<String>,
    model: String,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.steps.append(
      Step {
        seq: self.next,
        time: time,
        cause: move cause,
        message: move message,
        commands: move commands,
        model: move model,
      },
    )
    self.next = self.next + 1
    if self.steps.length() > STEP_LIMIT {
      drop self.steps.remove(0)
    }
  }

  /// Takes the steps added since the last call.
  pub fn take(self: &mut Self) -> List<Step> {
    return Intrinsic.replace(self.steps, List<Step>.make())
  }
}

/// The DOM name of an event kind.
pub fn eventName(kind: EventKind) -> string<'static> {
  return match kind {
    EventKind.PointerDown => "pointerdown"
    EventKind.PointerUp => "pointerup"
    EventKind.Click => "click"
    EventKind.PointerMove => "pointermove"
    EventKind.PointerEnter => "pointerenter"
    EventKind.PointerLeave => "pointerleave"
    EventKind.Wheel => "wheel"
    EventKind.KeyDown => "keydown"
    EventKind.KeyUp => "keyup"
    EventKind.Focus => "focus"
    EventKind.Blur => "blur"
    EventKind.Input => "input"
    EventKind.Layout => "layout"
    EventKind.PointerCancel => "pointercancel"
    EventKind.GotPointerCapture => "gotpointercapture"
    EventKind.LostPointerCapture => "lostpointercapture"
    EventKind.Load => "load"
    EventKind.Error => "error"
    EventKind.Scroll => "scroll"
  }
}
