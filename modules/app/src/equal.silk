//! Equality for the tree's style and canvas values, which the view diff compares to send only
//! what changed.
import ui_tree.css
import ui_tree.css { percent }
import ui_tree.mutation { CanvasCommand }
import ui_tree.mutation {
  UnicodeBidi,
  WritingMode,
  TextOrientation,
  VerticalAlign,
  BaselineSource,
  TextWrap,
  WhiteSpaceCollapse,
  TextJustify,
  TabSize,
  BoxDecorationBreak,
  MarginBreak,
  BreakInside,
  ScrollbarWidth,
  ScrollbarGutter,
  Float,
  Clear,
  Visibility,
  Dimension
}

/// Whether two canvas commands draw the same thing.
pub fn sameCommand(a: CanvasCommand, b: CanvasCommand) -> bool {
  return match a {
    CanvasCommand.FillRect { x, y, width, height, radius, color } => if let CanvasCommand.FillRect {
      x: x2,
      y: y2,
      width: width2,
      height: height2,
      radius: radius2,
      color: color2,
    } = b {
      x == x2 && y == y2 && width == width2 && height == height2 && radius == radius2
        && &color == &color2
    } else {
      false
    }
    CanvasCommand.MoveTo { x, y } => if let CanvasCommand.MoveTo { x: x2, y: y2 } = b {
      x == x2 && y == y2
    } else {
      false
    }
    CanvasCommand.LineTo { x, y } => if let CanvasCommand.LineTo { x: x2, y: y2 } = b {
      x == x2 && y == y2
    } else {
      false
    }
    CanvasCommand.QuadTo { x1, y1, x, y } => if let CanvasCommand.QuadTo {
      x1: a1,
      y1: b1,
      x: x2,
      y: y2
    } = b {
      x1 == a1 && y1 == b1 && x == x2 && y == y2
    } else {
      false
    }
    CanvasCommand.CubicTo { x1, y1, x2, y2, x, y } => if let CanvasCommand.CubicTo {
      x1: a1,
      y1: b1,
      x2: a2,
      y2: b2,
      x: x3,
      y: y3,
    } = b {
      x1 == a1 && y1 == b1 && x2 == a2 && y2 == b2 && x == x3 && y == y3
    } else {
      false
    }
    CanvasCommand.Close => if let CanvasCommand.Close = b {
      true
    } else {
      false
    }
    CanvasCommand.Fill { color } => if let CanvasCommand.Fill { color: other } = b {
      &color == &other
    } else {
      false
    }
    CanvasCommand.Stroke { color, width } => if let CanvasCommand.Stroke {
      color: other,
      width: w
    } = b {
      &color == &other && width == w
    } else {
      false
    }
  }
}

fn sameDimension(a: Dimension, b: Dimension) -> bool {
  return a.kind == b.kind && a.value == b.value && a.percent == b.percent
}

fn sameTabSize(a: TabSize, b: TabSize) -> bool {
  return match a {
    TabSize.Number { value } => if let TabSize.Number { value: other } = b {
      value == other
    } else {
      false
    }
    TabSize.Length { value } => if let TabSize.Length { value: other } = b {
      value == other
    } else {
      false
    }
  }
}
