//! The ARIA states and properties a view sets beyond role, label and the checked, selected
//! and expanded states: one compact value per node, so nodes without them cost nothing more
//! than the extras they already have.
import ui_protocol.mutation { Mutation, Attribute, TriState, Live, Orientation }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.ownership { Copy }

/// Which attribute an [`AriaValues`] change sets.
pub enum AriaField {
  Level,
  Description,
  RoleDescription,
  ValueText,
  Hidden,
  Live,
  Atomic,
  Busy,
  Pressed,
  Indeterminate,
  Required,
  Invalid,
  MultiSelectable,
  Orientation,
  PosInSet,
  SetSize,
  Modal,
}

const HIDDEN: u32 = 1
const ATOMIC: u32 = 2
const BUSY: u32 = 4
const INDETERMINATE: u32 = 8
const REQUIRED: u32 = 16
const INVALID: u32 = 32
const MULTI_SELECTABLE: u32 = 64
const MODAL: u32 = 128

/// The flags, numbers and enum values of a node's attributes. Text attributes are kept as
/// spans by the owner, beside this.
pub struct AriaValues {
  pub flags: u32,
  pub level: i32,
  pub posInSet: i32,
  pub setSize: i32,
  pub live: Live,
  pub pressed: TriState,
  pub orientation: Orientation,
}

impl Copy for AriaValues {}

impl AriaValues {
  pub fn make() -> AriaValues {
    return AriaValues {
      flags: 0,
      level: 0,
      posInSet: 0,
      setSize: 0,
      live: Live.Off,
      pressed: TriState.Unset,
      orientation: Orientation.Unset,
    }
  }

  /// Sets a flag or number field from `value` (flags take nonzero as true; `Live`,
  /// `Pressed` and `Orientation` take their enum's order). Text fields are not here.
  pub fn set(self: &mut Self, field: AriaField, value: i32) -> () {
    match field {
      AriaField.Level => { self.level = value }
      AriaField.PosInSet => { self.posInSet = value }
      AriaField.SetSize => { self.setSize = value }
      AriaField.Live => { self.live = if value == 2 { Live.Assertive } else if value == 1 { Live.Polite } else { Live.Off } }
      AriaField.Pressed => {
        self.pressed = if value == 3 { TriState.Mixed } else if value == 2 { TriState.True } else if value == 1 { TriState.False } else { TriState.Unset }
      }
      AriaField.Orientation => {
        self.orientation = if value == 2 { Orientation.Vertical } else if value == 1 { Orientation.Horizontal } else { Orientation.Unset }
      }
      AriaField.Hidden => { self.flag(HIDDEN, value) }
      AriaField.Atomic => { self.flag(ATOMIC, value) }
      AriaField.Busy => { self.flag(BUSY, value) }
      AriaField.Indeterminate => { self.flag(INDETERMINATE, value) }
      AriaField.Required => { self.flag(REQUIRED, value) }
      AriaField.Invalid => { self.flag(INVALID, value) }
      AriaField.MultiSelectable => { self.flag(MULTI_SELECTABLE, value) }
      AriaField.Modal => { self.flag(MODAL, value) }
      _ => {}
    }
  }

  fn flag(self: &mut Self, bit: u32, value: i32) -> () {
    self.flags = if value != 0 { self.flags | bit } else { self.flags & ~bit }
  }

  fn has(self: &Self, bit: u32) -> bool {
    return (self.flags & bit) != 0
  }

  /// Appends a `SetAttribute` on node `id` for each value that differs from `before`.
  pub effect fn changes(self: &Self, before: &AriaValues, id: u32, out: &mut List<Mutation>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.level != before.level { run set(&mut out, id, Attribute.Level { value: self.level }) }
    if self.live != before.live { run set(&mut out, id, Attribute.Live { value: self.live }) }
    if self.pressed != before.pressed { run set(&mut out, id, Attribute.Pressed { value: self.pressed }) }
    if self.orientation != before.orientation { run set(&mut out, id, Attribute.Orientation { value: self.orientation }) }
    if self.posInSet != before.posInSet { run set(&mut out, id, Attribute.PosInSet { value: self.posInSet }) }
    if self.setSize != before.setSize { run set(&mut out, id, Attribute.SetSize { value: self.setSize }) }
    let changed = self.flags ^ before.flags
    if (changed & HIDDEN) != 0 { run set(&mut out, id, Attribute.Hidden { value: self.has(HIDDEN) }) }
    if (changed & ATOMIC) != 0 { run set(&mut out, id, Attribute.Atomic { value: self.has(ATOMIC) }) }
    if (changed & BUSY) != 0 { run set(&mut out, id, Attribute.Busy { value: self.has(BUSY) }) }
    if (changed & INDETERMINATE) != 0 { run set(&mut out, id, Attribute.Indeterminate { value: self.has(INDETERMINATE) }) }
    if (changed & REQUIRED) != 0 { run set(&mut out, id, Attribute.Required { value: self.has(REQUIRED) }) }
    if (changed & INVALID) != 0 { run set(&mut out, id, Attribute.Invalid { value: self.has(INVALID) }) }
    if (changed & MULTI_SELECTABLE) != 0 { run set(&mut out, id, Attribute.MultiSelectable { value: self.has(MULTI_SELECTABLE) }) }
    if (changed & MODAL) != 0 { run set(&mut out, id, Attribute.Modal { value: self.has(MODAL) }) }
  }
}

effect fn set(out: &mut List<Mutation>, id: u32, attribute: Attribute) -> () ! OutOfMemoryError ? &mut Allocator {
  run out.append(Mutation.SetAttribute { id: id, attribute: move attribute })
}
