//! The view diff: compares a render's arena with the last one and writes the tree mutations
//! that turn the last into the new one.
//!
//! Entries were already matched while the view ran (same parent, then the same key or position
//! among unkeyed siblings, and the same kind). The diff then walks the new arena from the root:
//!
//! - an entry with no match is created, with everything set, and inserted;
//! - a matched entry keeps its tree id and gets only what changed: `SetStyle` with the
//!   properties that changed (or `ClearStyle` first when one was removed), `SetText`,
//!   `SetAttribute`, `SetListeners`, `SetSource` and `SetCanvas`;
//! - old children that nothing matched are destroyed, with their subtrees;
//! - children are put in order with the fewest moves: the longest run of matched children
//!   whose old order is already right stays, and the others move with `InsertBefore`;
//! - an entry `lazy` copied from the last render is skipped with its subtree;
//! - last, a node that asks for focus (`takeFocus`) and did not in the last render gets it.
import ui_protocol.css
import ui_protocol.css { Declaration }
import ui_protocol.grid { Grid }
import silk.mem.box { Box }
import ui { Arena, Entry, Extra, Span, NO_ENTRY, ROOT_ID }
import aria { AriaField }
import backend { Backend }
import equal { sameCommand }
import ui_protocol.css { Property }
import ui_protocol.mutation {
  Mutation,
  NodeKind,
  StyleState,
  Attribute,
  Role,
  Cursor,
  CanvasCommand,
  NOT_FOCUSABLE,
}
import silk.collections.hash { Hash, Word }
import silk.collections.hash_map { HashMap }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError, SystemAllocator }
import silk.mem.arena { Arena as BumpArena, ArenaReset }
import silk.core.effect { Effect }
import silk.num.u32
import silk.num.usize
import silk.text.string { String }

/// What the diff keeps between renders: the next tree id to hand out, and which tree id is
/// which entry of the newest render.
pub struct DiffState {
  pub nextId: u32,
  /// Tree id to entry index in the newest render.
  /// Built by `entryOf` on its first call after a render: dispatch needs it, a render does not.
  ids: HashMap<Word, u32>,
  indexed: bool,
  /// Lookups `entryOf` answered by scanning since the last render.
  scans: u32,
  /// Whether a node of this render or the last asks for focus, a reveal, a capture or a
  /// scroll (`Ui.hasMarks`). False skips the pass that looks for them. True by default.
  pub marked: bool,
  used: List<bool>,
  newStyle: List<Declaration>,
  oldStyle: List<Declaration>,
  changed: List<Declaration>,
  children: List<u32>,
  positions: List<u32>,
  stable: List<bool>,
  tails: List<usize>,
  previous: List<usize>,
  /// Whether the backend copies what it needs out of a batch and keeps none of it
  /// (`Backend.copiesBatches`): the text of the mutations then comes from `scratch`.
  pub transient: bool,
  /// How many mutations of this render the backend took before its end (`Backend.mutateEarly`).
  /// The runtime sets it to 0 when a render starts.
  pub taken: usize,
  /// A bump allocator for the text of one render's mutations, reset at the next render. A
  /// string there costs a pointer bump instead of a heap allocation, and dropping it a count.
  scratch: BumpArena<SystemAllocator>,
}

impl DiffState {
  pub fn make() -> DiffState {
    return DiffState {
      nextId: ROOT_ID + 1,
      ids: HashMap<Word, u32>.make(Hash.seed(0xD1FF)),
      indexed: false,
      scans: 0,
      marked: true,
      used: List<bool>.make(),
      newStyle: List<Declaration>.make(),
      oldStyle: List<Declaration>.make(),
      changed: List<Declaration>.make(),
      children: List<u32>.make(),
      positions: List<u32>.make(),
      stable: List<bool>.make(),
      tails: List<usize>.make(),
      previous: List<usize>.make(),
      transient: false,
      taken: 0,
      scratch: BumpArena<SystemAllocator>.make(Allocator.systemAllocatorProvider()),
    }
  }

  /// The entry of `arena`, the newest render, with tree id `id`, or `NO_ENTRY`.
  pub effect fn entryOf(self: &mut Self, arena: &Arena, id: u32) -> u32
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.indexed && self.scans < 16 {
      // A dispatch looks up the few ids on one path: a scan of the ids is cheaper than
      // indexing a large render.
      self.scans = self.scans + 1
      let entries = arena.entries.asSlice()
      let mut k: usize = 0
      while k < entries.length {
        if entries[k].id == id {
          return usize.toU32(k)
        }
        k = k + 1
      }
      return NO_ENTRY
    }
    if !self.indexed {
      self.indexed = true
      self.ids.clear()
      let count = arena.length()
      let mut i: u32 = 0
      while i < count {
        let entryId = arena.entryRef(i).id
        if entryId != 0 {
          drop run self.ids.insert(Hash.word(u32.toU64(entryId)), i)
        }
        i = i + 1
      }
    }
    return match self.ids.get(Hash.word(u32.toU64(id))) {
      Option<u32>.Some { value } => value
      Option<u32>.None => NO_ENTRY
    }
  }
}

/// Writes the mutations that turn the tree from `old` (the last render, empty at first) into
/// `next`, and gives every entry of `next` its tree id. The root entry is the runtime's root
/// box, which the runtime created.
pub effect fn diff<B: Backend>(
  next: &mut Arena,
  old: &Arena,
  state: &mut DiffState,
  out: &mut List<Mutation>,
  tree: &mut B,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run diffFrom(&mut next, old, &mut state, &mut out, &mut tree, ROOT_ID)
}

/// [`diff`] for a root entry whose tree id is `rootId`: the root box of a window the model
/// declared, which the runtime created.
///
/// `tree` is the backend the batch is for. When the batch grows past [`EARLY`] mutations and
/// the backend copies batches, it is offered what there is (`Backend.mutateEarly`), so a large
/// render does not hold all its mutations at once.
pub effect fn diffFrom<B: Backend>(
  next: &mut Arena,
  old: &Arena,
  state: &mut DiffState,
  out: &mut List<Mutation>,
  tree: &mut B,
  rootId: u32,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  state.indexed = false
  state.scans = 0
  // The last batch is gone (a backend that copies drops it in `mutate`): its chunk is free.
  state.scratch.reset(ArenaReset.RetainCapacity)
  state.used.clear()
  run state.used.appendRepeated(false, u32.toUsize(old.length()))
  let count = next.length()
  let mut fresh: usize = 0
  let mut i: u32 = 0
  while i < count {
    let entry = next.entryRef(i)
    if entry.old != NO_ENTRY {
      state.used.set(u32.toUsize(entry.old), true)
    } else {
      fresh = fresh + 1
    }
    i = i + 1
  }
  // A new node is a create, an insert and a few attributes: room for them at once, so a large
  // mount does not grow the batch (and copy it) many times.
  let room = fresh * 6 + 16
  run out.reserve(if state.transient && room > EARLY + 64 {
    EARLY + 64
  } else {
    room
  })
  let mut root = next.entry(0)
  root.id = rootId
  next.setEntry(0, root)
  run props(&next, 0, &old, root.old, rootId, &mut state, &mut out)
  run children(&mut next, 0, &old, root.old, &mut state, &mut out, &mut tree)

  // Focus requests, once every node is in place: the last node that asks now and did not ask
  // in the last render.
  let mut focus: u32 = 0
  let mut f: u32 = if state.marked {
    0
  } else {
    count
  }
  while f < count {
    let entry = next.entryRef(f)
    if entry.extra != 0 {
      let ex = next.extraCopy(entry)
      if ex.wantsFocus && (entry.old == NO_ENTRY || !old.extraCopy(old.entryRef(entry.old)).wantsFocus) {
        focus = entry.id
      }
    }
    f = f + 1
  }
  let mut f2: u32 = if state.marked {
    0
  } else {
    count
  }
  while f2 < count {
    let entry = next.entryRef(f2)
    let hadExtra = entry.old != NO_ENTRY && old.entryRef(entry.old).extra != 0
    if entry.extra != 0 || hadExtra {
      let ex = next.extraCopy(entry)
      let px = if entry.old == NO_ENTRY {
        Extra.make()
      } else {
        old.extraCopy(old.entryRef(entry.old))
      }
      if ex.wantsReveal && !px.wantsReveal {
        run out.append(Mutation.ScrollIntoView { id: entry.id })
      }
      if ex.wantsCapture && !px.wantsCapture {
        run out.append(Mutation.SetPointerCapture { id: entry.id })
      } else if px.wantsCapture && !ex.wantsCapture {
        run out.append(Mutation.ReleasePointerCapture)
      }
      if ex.hasScroll && !(px.hasScroll && px.scrollX == ex.scrollX && px.scrollY == ex.scrollY) {
        run out.append(Mutation.ScrollTo { id: entry.id, x: ex.scrollX, y: ex.scrollY })
      }
    }
    f2 = f2 + 1
  }
  if focus != 0 {
    run out.append(Mutation.Focus { id: focus })
  }
}

/// How long a batch gets before a backend that copies batches is offered it during the diff.
pub const EARLY: usize = 4096

/// Offers the backend the mutations made so far (`Backend.mutateEarly`).
effect fn offer<B: Backend>(state: &mut DiffState, out: &mut List<Mutation>, tree: &mut B) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if !state.transient {
    return ()
  }
  let before = out.length()
  run Backend.mutateEarly(&mut tree, &mut out)
  state.taken = state.taken + (before - out.length())
}

/// Creates entry `index` and its subtree. Returns its id.
effect fn create<B: Backend>(
  next: &mut Arena,
  index: u32,
  old: &Arena,
  state: &mut DiffState,
  out: &mut List<Mutation>,
  tree: &mut B,
) -> u32
  ! OutOfMemoryError
  ? &mut Allocator {
  let id = state.nextId
  state.nextId = state.nextId + 1
  let mut entry = next.entry(index)
  entry.id = id
  next.setEntry(index, entry)
  run out.append(Mutation.Create { id: id, kind: entry.kind })
  run props(&next, index, &old, NO_ENTRY, id, &mut state, &mut out)
  let mut child = entry.firstChild
  while child != NO_ENTRY {
    let childId = run create(&mut next, child, &old, &mut state, &mut out, &mut tree)
    run out.append(Mutation.InsertBefore { parent: id, child: childId, before: Option<u32>.None })
    if out.length() >= EARLY {
      run offer(&mut state, &mut out, &mut tree)
    }
    child = next.entryRef(child).next
  }
  return id
}

/// Brings matched entry `index` up to date with its old entry. Returns its id.
effect fn update<B: Backend>(
  next: &mut Arena,
  index: u32,
  old: &Arena,
  state: &mut DiffState,
  out: &mut List<Mutation>,
  tree: &mut B,
) -> u32
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut entry = next.entry(index)
  let before = old.entryRef(entry.old)
  let id = before.id
  entry.id = id
  next.setEntry(index, entry)
  if entry.copied {
    // Copied by `lazy`: same ids, nothing to send.
    return id
  }
  run props(&next, index, &old, entry.old, id, &mut state, &mut out)
  run children(&mut next, index, &old, entry.old, &mut state, &mut out, &mut tree)
  return id
}

/// Reconciles the children of `index` with those of its old entry `before` (or none).
effect fn children<B: Backend>(
  next: &mut Arena,
  index: u32,
  old: &Arena,
  before: u32,
  state: &mut DiffState,
  out: &mut List<Mutation>,
  tree: &mut B,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  // A leaf before and now (most nodes of a large view): nothing to reconcile.
  if next.entryRef(index).firstChild == NO_ENTRY
    && (before == NO_ENTRY || old.entryRef(before).firstChild == NO_ENTRY) {
    return ()
  }
  let parentId = next.entryRef(index).id
  if before != NO_ENTRY {
    let mut child = old.entryRef(before).firstChild
    while child != NO_ENTRY {
      let entry = old.entryRef(child)
      if !state.used.get(u32.toUsize(child)) {
        run out.append(Mutation.Destroy { id: entry.id })
      }
      child = entry.next
    }
  }

  // The new children, and which of the matched ones can stay where they are.
  let start = state.children.length()
  let mut child = next.entryRef(index).firstChild
  while child != NO_ENTRY {
    run state.children.append(child)
    child = next.entryRef(child).next
  }
  let end = state.children.length()
  let stableStart = state.stable.length()
  run stableRun(&next, &old, start, end, &mut state)

  let mut after = Option<u32>.None
  let mut i = end
  while i > start {
    i = i - 1
    let current = state.children.get(i)
    let matched = next.entryRef(current).old
    if matched == NO_ENTRY {
      let id = run create(&mut next, current, &old, &mut state, &mut out, &mut tree)
      run out.append(Mutation.InsertBefore { parent: parentId, child: id, before: after })
      after = Option<u32>.Some { value: id }
    } else {
      let id = run update(&mut next, current, &old, &mut state, &mut out, &mut tree)
      if !state.stable.get(stableStart + (i - start)) {
        run out.append(Mutation.InsertBefore { parent: parentId, child: id, before: after })
      }
      after = Option<u32>.Some { value: id }
    }
    if out.length() >= EARLY {
      run offer(&mut state, &mut out, &mut tree)
    }
  }
  state.children.truncate(start)
  state.stable.truncate(stableStart)
}

/// Appends to `state.stable` one flag per child in `state.children[start..end]`: true for the
/// matched children in the longest run whose old positions increase, which need no move.
effect fn stableRun(
  next: &Arena,
  old: &Arena,
  start: usize,
  end: usize,
  state: &mut DiffState,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let stableStart = state.stable.length()
  // Most renders keep every child matched and in order: all of them stay.
  let mut ordered = true
  let mut last: u32 = 0
  let mut k = start
  while k < end {
    let matched = next.entryRef(state.children.get(k)).old
    if matched == NO_ENTRY {
      ordered = false
      break
    }
    let position = old.entryRef(matched).position
    if k > start && position <= last {
      ordered = false
      break
    }
    last = position
    k = k + 1
  }
  if ordered {
    run state.stable.appendRepeated(true, end - start)
    return ()
  }
  run state.stable.appendRepeated(false, end - start)

  // Longest increasing subsequence of old positions over the matched children (patience
  // sorting): `tails[k]` is the child (offset from `start`) ending the best run of length k + 1,
  // `previous` the child before it.
  state.tails.clear()
  state.previous.clear()
  state.positions.clear()
  let mut i: usize = 0
  while i < end - start {
    let matched = next.entryRef(state.children.get(start + i)).old
    let position = if matched == NO_ENTRY {
      0
    } else {
      old.entryRef(matched).position
    }
    run state.positions.append(position)
    run state.previous.append(usize.MAX)
    if matched != NO_ENTRY {
      let mut low: usize = 0
      let mut high = state.tails.length()
      while low < high {
        let middle = (low + high) / 2
        if state.positions.get(state.tails.get(middle)) < position {
          low = middle + 1
        } else {
          high = middle
        }
      }
      if low > 0 {
        state.previous.set(i, state.tails.get(low - 1))
      }
      if low == state.tails.length() {
        run state.tails.append(i)
      } else {
        state.tails.set(low, i)
      }
    }
    i = i + 1
  }
  if state.tails.length() == 0 {
    return ()
  }
  let mut at = state.tails.get(state.tails.length() - 1)
  while true {
    state.stable.set(stableStart + at, true)
    let back = state.previous.get(at)
    if back == usize.MAX {
      break
    }
    at = back
  }
}

/// Writes what differs between entry `index` and old entry `before` (or everything when there
/// is none) for tree node `id`.
effect fn props(
  next: &Arena,
  index: u32,
  old: &Arena,
  before: u32,
  id: u32,
  state: &mut DiffState,
  out: &mut List<Mutation>,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let entry = next.entryRef(index)
  let fresh = before == NO_ENTRY
  let prior = if fresh {
    Entry.make(entry.kind, NO_ENTRY, entry.identity)
  } else {
    old.entry(before)
  }
  // First, so a document backend makes the element right after the `Create`.
  let element = next.text(entry.element)
  if !sameBytes(element, old.text(prior.element)) {
    run out.append(
      Mutation.SetAttribute { id: id, attribute: Attribute.Element { name: run copyText(&mut state, element) } },
    )
  }
  let className = next.text(entry.className)
  if !sameBytes(className, old.text(prior.className)) {
    run out.append(
      Mutation.SetAttribute {
        id: id,
        attribute: Attribute.ClassName { value: run copyText(&mut state, className) },
      },
    )
  }
  if entry.extra != 0 || prior.extra != 0 {
    let ex = next.extraCopy(entry)
    let px = old.extraCopy(&prior)
    let elementId = next.text(ex.elementId)
    if !sameBytes(elementId, old.text(px.elementId)) {
      run out.append(
        Mutation.SetAttribute {
          id: id,
          attribute: Attribute.ElementId { value: run copyText(&mut state, elementId) },
        },
      )
    }
  }
  // Most nodes of a large view have no style of their own, before or now: nothing to compare.
  if entry.firstStyle != NO_ENTRY || prior.firstStyle != NO_ENTRY {
    run styles(&next, index, &old, before, id, StyleState.Base, &mut state, &mut out)
    run styles(&next, index, &old, before, id, StyleState.Hover, &mut state, &mut out)
    run styles(&next, index, &old, before, id, StyleState.Active, &mut state, &mut out)
    run styles(&next, index, &old, before, id, StyleState.Focus, &mut state, &mut out)
    run styles(&next, index, &old, before, id, StyleState.FocusVisible, &mut state, &mut out)
    run styles(&next, index, &old, before, id, StyleState.Starting, &mut state, &mut out)
  }

  if entry.kind == NodeKind.Text || entry.kind == NodeKind.Input {
    let text = next.text(entry.text)
    if !sameBytes(text, old.text(prior.text))
      || (fresh && entry.kind == NodeKind.Input && text.length != 0) {
      run out.append(Mutation.SetText { id: id, value: run copyText(&mut state, text) })
    }
  }
  if entry.extra != 0 || prior.extra != 0 {
    let ex = next.extraCopy(entry)
    let px = old.extraCopy(&prior)
    if ex.accessRole != px.accessRole {
      run out.append(
        Mutation.SetAttribute { id: id, attribute: Attribute.Role { value: ex.accessRole } },
      )
    }
    if ex.hasValueRange != px.hasValueRange || ex.valueMin != px.valueMin
      || ex.valueMax != px.valueMax
      || ex.valueNow != px.valueNow {
      let attribute = if ex.hasValueRange {
        Attribute.ValueRange { min: ex.valueMin, max: ex.valueMax, value: ex.valueNow }
      } else {
        Attribute.ClearValueRange
      }
      run out.append(Mutation.SetAttribute { id: id, attribute: move attribute })
    }
    let label = next.text(ex.label)
    if !sameBytes(label, old.text(px.label)) {
      run out.append(
        Mutation.SetAttribute { id: id, attribute: Attribute.Label { value: run copyText(&mut state, label) } },
      )
    }
    let testId = next.text(ex.testId)
    if !sameBytes(testId, old.text(px.testId)) {
      run out.append(
        Mutation.SetAttribute { id: id, attribute: Attribute.TestId { value: run copyText(&mut state, testId) } },
      )
    }
    if ex.hasTabIndex != px.hasTabIndex || ex.tabIndex != px.tabIndex {
      let value = if ex.hasTabIndex {
        ex.tabIndex
      } else {
        defaultTabIndex(entry.kind)
      }
      run out.append(Mutation.SetAttribute { id: id, attribute: Attribute.TabIndex { value: value } })
    }
    if ex.hasCursor != px.hasCursor || ex.cursor != px.cursor {
      run out.append(
        Mutation.SetAttribute { id: id, attribute: Attribute.Cursor { value: ex.cursor } },
      )
    }
    if ex.disabled != px.disabled {
      run out.append(
        Mutation.SetAttribute { id: id, attribute: Attribute.Disabled { value: ex.disabled } },
      )
    }
    if ex.prevents != px.prevents {
      run out.append(
        Mutation.SetAttribute { id: id, attribute: Attribute.Prevent { actions: ex.prevents } },
      )
    }
    if ex.focusTrap != px.focusTrap {
      run out.append(
        Mutation.SetAttribute { id: id, attribute: Attribute.FocusTrap { value: ex.focusTrap } },
      )
    }
    if ex.checked != px.checked {
      run out.append(
        Mutation.SetAttribute { id: id, attribute: Attribute.Checked { value: ex.checked } },
      )
    }
    if ex.selected != px.selected {
      run out.append(
        Mutation.SetAttribute { id: id, attribute: Attribute.Selected { value: ex.selected } },
      )
    }
    if ex.expanded != px.expanded {
      run out.append(
        Mutation.SetAttribute { id: id, attribute: Attribute.Expanded { value: ex.expanded } },
      )
    }
    run ex.aria.changes(&px.aria, id, &mut out)
    run textAttribute(next, ex.description, old, px.description, id, AriaField.Description, &mut state, &mut out)
    run textAttribute(next, ex.roleDescription, old, px.roleDescription, id, AriaField.RoleDescription, &mut state, &mut out)
    run textAttribute(next, ex.valueText, old, px.valueText, id, AriaField.ValueText, &mut state, &mut out)
    let href = next.text(ex.href)
    if !sameBytes(href, old.text(px.href)) {
      run out.append(
        Mutation.SetAttribute { id: id, attribute: Attribute.Href { value: run copyText(&mut state, href) } },
      )
    }
    let transition = next.text(ex.transition)
    if !sameBytes(transition, old.text(px.transition)) {
      run out.append(
        Mutation.SetAttribute {
          id: id,
          attribute: Attribute.Transition { value: run copyText(&mut state, transition) },
        },
      )
    }
    if entry.kind == NodeKind.Input {
      if ex.multiline != px.multiline {
        run out.append(
          Mutation.SetAttribute { id: id, attribute: Attribute.Multiline { value: ex.multiline } },
        )
      }
      if ex.readOnly != px.readOnly {
        run out.append(
          Mutation.SetAttribute { id: id, attribute: Attribute.ReadOnly { value: ex.readOnly } },
        )
      }
      let placeholder = next.text(ex.placeholder)
      if !sameBytes(placeholder, old.text(px.placeholder)) {
        run out.append(
          Mutation.SetAttribute {
            id: id,
            attribute: Attribute.Placeholder { value: run copyText(&mut state, placeholder) },
          },
        )
      }
    }
  }
  if entry.listeners != prior.listeners {
    run out.append(Mutation.SetListeners { id: id, flags: entry.listeners })
  }
  if entry.extra != 0 || prior.extra != 0 {
    let ex = next.extraCopy(entry)
    let px = old.extraCopy(&prior)
    if ex.source != px.source && ex.source != NO_ENTRY {
      run out.append(Mutation.SetSource { id: id, resource: ex.source })
    }
    if ex.grid != NO_ENTRY {
      let grid = &next.grids.asSlice()[u32.toUsize(ex.grid)]
      if px.grid == NO_ENTRY || !grid.same(&old.grids.asSlice()[u32.toUsize(px.grid)]) {
        run out.append(Mutation.SetGrid { id: id, value: run Box<Grid>.make(run grid.copy()) })
      }
    } else if px.grid != NO_ENTRY {
      run out.append(Mutation.SetGrid { id: id, value: run Box<Grid>.make(Grid.make()) })
    }
    if ex.hasCanvas || px.hasCanvas {
      let commands = next.commands(ex.canvas)
      if !sameCommands(commands, old.commands(px.canvas)) || fresh {
        let mut list = List<CanvasCommand>.make()
        run list.appendSlice(commands)
        run out.append(Mutation.SetCanvas { id: id, commands: move list })
      }
    }
  }
}

/// Sets the text attribute `field` of node `id` when its text changed.
effect fn textAttribute(next: &Arena, span: Span, old: &Arena, before: Span, id: u32, field: AriaField, state: &mut DiffState, out: &mut List<Mutation>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let text = next.text(span)
  if sameBytes(text, old.text(before)) {
    return ()
  }
  let value = run copyText(&mut state, text)
  let attribute = match field {
    AriaField.RoleDescription => Attribute.RoleDescription { value: move value }
    AriaField.ValueText => Attribute.ValueText { value: move value }
    _ => Attribute.Description { value: move value }
  }
  run out.append(Mutation.SetAttribute { id: id, attribute: move attribute })
}

/// The tab index a node of `kind` has when none is set.
fn defaultTabIndex(kind: NodeKind) -> i32 {
  return if kind == NodeKind.Input {
    0
  } else {
    NOT_FOCUSABLE
  }
}

/// Writes the `state` style changes of entry `index` against old entry `before`.
effect fn styles(
  next: &Arena,
  index: u32,
  old: &Arena,
  before: u32,
  id: u32,
  state: StyleState,
  differ: &mut DiffState,
  out: &mut List<Mutation>,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run next.effectiveStyle(index, state, &mut differ.newStyle)
  if before == NO_ENTRY {
    differ.oldStyle.clear()
  } else {
    run old.effectiveStyle(before, state, &mut differ.oldStyle)
  }
  let fresh = differ.newStyle.asSlice()
  let stale = differ.oldStyle.asSlice()

  // A property that is gone needs the whole look set again. So does a changed shorthand:
  // setting it alone would remove the longhands set after it.
  let mut reset = false
  let mut i: usize = 0
  while i < stale.length {
    if find(fresh, stale[i].property) == usize.MAX {
      reset = true
      break
    }
    i = i + 1
  }
  let mut changed = List<Declaration>.make()
  let mut j: usize = 0
  while j < fresh.length && !reset {
    let at = find(stale, fresh[j].property)
    if at == usize.MAX || !css.sameDeclaration(&fresh[j], &stale[at]) {
      if css.isShorthand(fresh[j].property) && stale.length != 0 {
        reset = true
      } else {
        let copy = run css.cloneDeclaration(&fresh[j])
        run changed.append(move copy)
      }
    }
    j = j + 1
  }
  if reset {
    run out.append(Mutation.ClearStyle { id: id, state: state })
    if fresh.length != 0 {
      let mut all = run List<Declaration>.makeWithCapacity(fresh.length)
      let mut k: usize = 0
      while k < fresh.length {
        let copy = run css.cloneDeclaration(&fresh[k])
        run all.append(move copy)
        k = k + 1
      }
      run out.append(Mutation.SetStyle { id: id, state: state, declarations: move all })
    }
    return ()
  }
  if changed.length() != 0 {
    run out.append(Mutation.SetStyle { id: id, state: state, declarations: move changed })
  }
}

fn find(declarations: &[Declaration], property: Property) -> usize {
  let mut i: usize = 0
  while i < declarations.length {
    if declarations[i].property == property {
      return i
    }
    i = i + 1
  }
  return usize.MAX
}

fn sameBytes(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut i: usize = 0
  while i < a.length {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn sameCommands(a: &[CanvasCommand], b: &[CanvasCommand]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut i: usize = 0
  while i < a.length {
    if !sameCommand(a[i], b[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

effect fn copyText(state: &mut DiffState, bytes: &[u8]) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  // The arena's text pool holds only whole strings a view gave (and digits): valid UTF-8.
  let text = unsafe String.fromUtf8Unchecked(bytes)
  if state.transient {
    return run String.copy(text) |> Effect.provideMut<Allocator>(&mut state.scratch)
  }
  return run String.copy(text)
}
