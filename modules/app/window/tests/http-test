#!/usr/bin/env node
// Own the loopback fixture server while direct Silk runs the image-loading tests.
import { createServer } from 'node:http';
import { readFile } from 'node:fs/promises';
import { resolve, sep } from 'node:path';
import { silk, root } from '../../../../scripts/internal.mjs';
import { execute } from '../../../../scripts/native-run.mjs';
const args = process.argv.slice(2);
const option = name => { const index = args.indexOf(name); return index < 0 ? undefined : args[index + 1]; };
const photos = resolve(root, 'modules/assets/assets/photos');
const server = createServer(async (request, response) => {
  try {
    const pathname = decodeURIComponent(new URL(request.url, 'http://localhost').pathname);
    const path = resolve(photos, '.' + pathname);
    if (!path.startsWith(photos + sep)) { response.writeHead(403); response.end(); return; }
    const bytes = await readFile(path);
    response.writeHead(200, { 'content-type': path.endsWith('.png') ? 'image/png' : 'image/jpeg', 'content-length': bytes.length });
    response.end(bytes);
  } catch (error) { response.writeHead(error.code === 'ENOENT' ? 404 : 500); response.end(); }
});
await new Promise((resolve, reject) => { server.once('error', reject); server.listen(28183, '127.0.0.1', resolve); });
try {
  await execute(option('--compiler') || silk, ['test', '--manifest-path', resolve(root, 'modules/app/window/tests/silk.toml'), '--root', 'src/http.silk',
    ...(option('--clang') ? ['--clang', option('--clang')] : [])], process.env, 1200000);
} finally { await new Promise(resolve => server.close(resolve)); }
