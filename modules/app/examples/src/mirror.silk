//! Two windows of one model: the first window counts and opens a second one, which shows the
//! same count and changes it too. The second window closes from its own close button, from
//! its Close button, or from the button that opened it. No commands.
import ui_app.font { Fonts }
import ui_app.css
import ui_app.css { px, Align }
import look { SANS, surfaceLook, press }
import ui_app.lib {
  Document,
  Node,
  NoCommand,
  NoOutput,
  Program,
  Update,
  Windows,
  WindowSpec,
  WindowEvent
}
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// The key the second window is declared under.
pub const SECOND: u64 = 1

pub struct Mirror {
  pub count: i64,
  /// Whether the model wants the second window.
  pub open: bool,
  /// Requests to close the second window from its close button so far.
  pub closeRequests: u64,
  /// The second window's size, as it last said.
  pub width: f32,
  pub height: f32,
}

pub union Message {
  Increment,
  Decrement,
  Open,
  Close,
  /// The user asked to close the second window: the model closes it.
  CloseRequested,
  SecondChanged { pub event: WindowEvent },
}

type Next = Update<Mirror, NoCommand, NoOutput>

/// The count and the buttons that change it, as both windows show them.
fn counter(model: &Mirror, h: &Document<Message>, id: string) -> Node {
  return h.row(
    &[h.style(&[css.columnGap(px(8.0)), css.alignItems(Align.Center)])],
    &[
      press(h, "-", false, Message.Decrement),
      h.box(&[h.testId(id), h.style(&[css.fontSize(px(20.0))])], &[h.number(model.count)]),
      press(h, "+", false, Message.Increment),
    ],
  )
}

/// The second window's view.
fn second(model: &Mirror, h: &Document<Message>) -> Node {
  return h.box(
    &[surfaceLook(h)],
    &[
      h.text("The same count, in another window"),
      counter(model, h, "second-count"),
      press(h, "Close", false, Message.Close),
    ],
  )
}

impl Program<Message, NoCommand> for Mirror {
  effect fn init() -> Next
    ! OutOfMemoryError
    ? &mut Allocator {
    return Next.of(Mirror { count: 0, open: false, closeRequests: 0, width: 0.0, height: 0.0 })
  }

  effect fn update(mut model: Mirror, message: Message) -> Next
    ! OutOfMemoryError
    ? &mut Allocator {
    match move message {
      Message.Increment => {
        model.count = model.count + 1
      }
      Message.Decrement => {
        model.count = model.count - 1
      }
      Message.Open => {
        model.open = true
      }
      Message.Close => {
        model.open = false
      }
      Message.CloseRequested => {
        model.closeRequests = model.closeRequests + 1
        model.open = false
      }
      Message.SecondChanged { event } => {
        match event {
          WindowEvent.Resized { width, height } => {
            model.width = width
            model.height = height
          }
          WindowEvent.Failed => {
            model.open = false
          }
          _ => {}
        }
      }
    }
    return Next.of(move model)
  }

  fn view(model: &Mirror, h: &Document<Message>) -> Node {
    return h.box(
      &[surfaceLook(h)],
      &[
        counter(model, h, "count"),
        if model.open {
          press(h, "Close second window", true, Message.Close)
        } else {
          press(h, "Open second window", false, Message.Open)
        },
      ],
    )
  }

  fn windows(model: &Mirror, w: &mut Windows<Message>) -> () {
    if model.open {
      w.window(
        SECOND,
        WindowSpec.titled("Second window").sized(320.0, 200.0),
        |h| second(model, h),
        || Message.CloseRequested,
      )
      w.listen(SECOND, |event| Message.SecondChanged { event: event })
    }
  }

  fn fonts(model: &Mirror, fonts: &mut Fonts) -> () {
    fonts.family(SANS)
  }
}
