//! The colors and the button look the examples share.
import ui_app.font { Font }
import ui_app.heap { allocate }
import ui_app.css
import ui_app.css { px, BorderStyle }
import ui_app.lib { Attr, Document, Node, Ui }
import silk.color.rgba { Rgba }
import silk.geometry.corners { Corners }
import silk.num.u32

/// The font the examples use: Noto Sans, which the tree fixtures carry, or the system's.
/// Each example names it in its `fonts`.
pub const SANS: Font = Font.of("Noto Sans, system-ui, sans-serif")

pub fn rgb(hex: u32) -> Rgba<f32> {
  let r = u32.toF32(u32.bitAnd(u32.shiftRight(hex, 16), 255)) / 255.0
  let g = u32.toF32(u32.bitAnd(u32.shiftRight(hex, 8), 255)) / 255.0
  let b = u32.toF32(u32.bitAnd(hex, 255)) / 255.0
  return Rgba<f32> { r: r, g: g, b: b, a: 1.0 }
}

/// The app surface: font, text color and background on the root.
pub fn surface<M>(ui: &mut Ui<M>) -> () {
  ui.style(
    &[
      css.fontFamily(SANS),
      css.fontSize(px(14.0)),
      css.color(rgb(0x1F2937)),
      css.backgroundColor(rgb(0xF9FAFB)),
    ],
  )
  ui.padding(16.0)
  ui.gap(10.0)
}

/// A rounded, bordered button look with hover, press and focus ring variants. `selected`
/// fills it.
pub fn buttonLook<M>(ui: &mut Ui<M>, selected: bool) -> () {
  let radius = Corners<f32> { topLeft: 6.0, topRight: 6.0, bottomRight: 6.0, bottomLeft: 6.0 }
  ui.style(
    &[
      css.paddingTop(px(4.0)),
      css.paddingBottom(px(4.0)),
      css.paddingLeft(px(10.0)),
      css.paddingRight(px(10.0)),
      css.borderTopWidth(px(1.0)),
      css.borderRightWidth(px(1.0)),
      css.borderBottomWidth(px(1.0)),
      css.borderLeftWidth(px(1.0)),
      css.borderStyle(BorderStyle.Solid),
      css.borderColor(rgb(0xD1D5DB)),
      allocate(
        css.borderRadii(radius.topLeft, radius.topRight, radius.bottomRight, radius.bottomLeft),
      ),
    ],
  )
  if selected {
    ui.style(
      &[
        css.backgroundColor(rgb(0x2563EB)),
        css.color(rgb(0xFFFFFF)),
        css.borderColor(rgb(0x2563EB)),
      ],
    )
  } else {
    ui.style(&[css.backgroundColor(rgb(0xFFFFFF))])
    ui.hover(&[css.backgroundColor(rgb(0xF3F4F6))])
  }
  ui.active(&[css.backgroundColor(rgb(0xE5E7EB))])
  ui.focusVisible(&[css.borderColor(rgb(0x2563EB))])
}

/// A text field with the border and corners of the buttons.
pub fn field<M>(ui: &mut Ui<M>) -> () {
  let radius = Corners<f32> { topLeft: 6.0, topRight: 6.0, bottomRight: 6.0, bottomLeft: 6.0 }
  ui.style(
    &[
      css.minWidth(px(0.0)),
      css.paddingTop(px(4.0)),
      css.paddingBottom(px(4.0)),
      css.paddingLeft(px(8.0)),
      css.paddingRight(px(8.0)),
      css.borderTopWidth(px(1.0)),
      css.borderRightWidth(px(1.0)),
      css.borderBottomWidth(px(1.0)),
      css.borderLeftWidth(px(1.0)),
      css.borderStyle(BorderStyle.Solid),
      css.borderColor(rgb(0xD1D5DB)),
      css.backgroundColor(rgb(0xFFFFFF)),
      allocate(
        css.borderRadii(radius.topLeft, radius.topRight, radius.bottomRight, radius.bottomLeft),
      ),
    ],
  )
  ui.focused(&[css.borderColor(rgb(0x2563EB))])
}

/// A button with the shared look that sends `onPress`.
pub fn button<M>(ui: &mut Ui<M>, label: string, selected: bool, onPress: fn() -> M) -> () {
  ui.pressable(
    onPress,
    |ui| {
      buttonLook(&mut ui, selected)
      ui.text(label)
    },
  )
}

// The same looks for a `Program`, whose view builds nodes with an `Document`.

/// The app surface: font, text color and background, for the view's top box.
pub fn surfaceLook<M>(h: &Document<M>) -> Attr {
  return h.style(
    &[
      css.fontFamily(SANS),
      css.fontSize(px(14.0)),
      css.color(rgb(0x1F2937)),
      css.backgroundColor(rgb(0xF9FAFB)),
      css.padding(px(16.0)),
      css.rowGap(px(10.0)),
      css.columnGap(px(10.0)),
    ],
  )
}

/// A rounded, bordered button look with hover, press and focus ring variants. `selected`
/// fills it.
pub fn pressLook<M>(h: &Document<M>, selected: bool) -> Attr {
  let radius = Corners<f32> { topLeft: 6.0, topRight: 6.0, bottomRight: 6.0, bottomLeft: 6.0 }
  return h.attrs(
    &[
      h.style(
        &[
          css.paddingTop(px(4.0)),
          css.paddingBottom(px(4.0)),
          css.paddingLeft(px(10.0)),
          css.paddingRight(px(10.0)),
          css.borderTopWidth(px(1.0)),
          css.borderRightWidth(px(1.0)),
          css.borderBottomWidth(px(1.0)),
          css.borderLeftWidth(px(1.0)),
          css.borderStyle(BorderStyle.Solid),
          css.borderColor(rgb(0xD1D5DB)),
          allocate(
            css.borderRadii(radius.topLeft, radius.topRight, radius.bottomRight, radius.bottomLeft),
          ),
        ],
      ),
      if selected {
        h.style(
          &[
            css.backgroundColor(rgb(0x2563EB)),
            css.color(rgb(0xFFFFFF)),
            css.borderColor(rgb(0x2563EB)),
          ],
        )
      } else {
        h.attrs(
          &[
            h.style(&[css.backgroundColor(rgb(0xFFFFFF))]),
            h.hover(&[css.backgroundColor(rgb(0xF3F4F6))]),
          ],
        )
      },
      h.active(&[css.backgroundColor(rgb(0xE5E7EB))]),
      h.focusVisible(&[css.borderColor(rgb(0x2563EB))]),
    ],
  )
}

/// A button with the shared look that sends `message`.
pub fn press<M>(h: &Document<M>, label: string, selected: bool, message: M) -> Node {
  return h.button(&[h.onClick(move message), pressLook(h, selected)], &[h.text(label)])
}
