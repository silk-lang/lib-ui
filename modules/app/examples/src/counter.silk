//! The counter: buttons, a number, key bindings and a timer subscription. No commands.
import ui_tree.css
import ui_tree.css { px }
import look { surfaceLook, press, rgb }
import ui_app.app { Subscriptions, NoCommand }
import ui_app.document { Document, Node }
import ui_app.program { NoOutput, Program, Update }
import ui_tree.input { MOD_CONTROL }
import ui_tree.mutation { Align }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub struct Counter {
  pub count: i64,
  /// Whether the timer adds one every second.
  pub running: bool,
  pub ticks: u64,
}

pub union Message {
  Increment,
  Decrement,
  Reset,
  ToggleTimer,
  Tick { pub time: f64 },
}

impl Counter {
  pub fn make() -> Counter {
    return Counter { count: 0, running: false, ticks: 0 }
  }
}

type Next = Update<Counter, NoCommand, NoOutput>

impl Program<Message, NoCommand> for Counter {
  effect fn init() -> Next
    ! OutOfMemoryError
    ? &mut Allocator {
    return Next.of(Counter.make())
  }

  effect fn update(mut model: Counter, message: Message) -> Next
    ! OutOfMemoryError
    ? &mut Allocator {
    match move message {
      Message.Increment => {
        model.count = model.count + 1
      }
      Message.Decrement => {
        model.count = model.count - 1
      }
      Message.Reset => {
        model.count = 0
      }
      Message.ToggleTimer => {
        model.running = !model.running
      }
      Message.Tick { time: _ } => {
        model.count = model.count + 1
        model.ticks = model.ticks + 1
      }
    }
    return Next.of(move model)
  }

  fn view(model: &Counter, h: &Document<Message>) -> Node {
    return h.box(
      &[surfaceLook(h)],
      &[
        h.row(
          &[h.style(&[css.rowGap(px(8.0)), css.columnGap(px(8.0)), css.alignItems(Align.Center)])],
          &[
            press(h, "-", false, Message.Decrement),
            h.box(
              &[h.testId("count"), h.style(&[css.fontSize(px(20.0))])],
              &[h.number(model.count)],
            ),
            press(h, "+", false, Message.Increment),
          ],
        ),
        h.row(
          &[h.style(&[css.rowGap(px(8.0)), css.columnGap(px(8.0))])],
          &[
            press(h, "Reset", false, Message.Reset),
            press(
              h,
              if model.running {
                "Stop"
              } else {
                "Auto"
              },
              model.running,
              Message.ToggleTimer,
            ),
          ],
        ),
        if model.running {
          h.box(&[h.style(&[css.color(rgb(0x6B7280))])], &[h.text("Counting up every second")])
        } else {
          h.empty()
        },
      ],
    )
  }

  fn subscriptions(model: &Counter, subs: &mut Subscriptions<Message>) -> () {
    subs.keyBinding(1, "ArrowUp", 0, || Message.Increment)
    subs.keyBinding(2, "ArrowDown", 0, || Message.Decrement)
    subs.keyBinding(3, "r", MOD_CONTROL, || Message.Reset)
    if model.running {
      subs.every(4, 1.0, |time| Message.Tick { time: time })
    }
  }
}
