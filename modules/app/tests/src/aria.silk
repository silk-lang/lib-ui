//! Accessibility attributes in the document backend's markup, by their ARIA names.
import ui_app_dom.html { Html }
import ui_app.backend { Backend, TreeError }
import ui_protocol.mutation { Mutation, Attribute, NodeKind, Role, TriState, Live, FIRST_ROOT }
import ui_protocol.options { RootOptions }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }

fn has(text: &[u8], needle: string) -> bool {
  let wanted = String.utf8Bytes(needle)
  let mut at: usize = 0
  while at + wanted.length <= text.length {
    let mut i: usize = 0
    while i < wanted.length && text[at + i] == wanted[i] { i = i + 1 }
    if i == wanted.length { return true }
    at = at + 1
  }
  return false
}

effect fn set(page: &mut Html, attribute: Attribute) -> () ! TreeError | OutOfMemoryError ? &mut Allocator {
  let mut batch = List<Mutation>.make()
  run batch.append(Mutation.SetAttribute { id: 1, attribute: move attribute })
  run page.mutate(move batch)
}

test effect fn ariaAttributesReachTheMarkup() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run markupBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn markupBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut page = Html.make()
  let mut batch = List<Mutation>.make()
  run batch.append(Mutation.Create { id: 1, kind: NodeKind.Box })
  run batch.append(Mutation.OpenRoot { root: FIRST_ROOT, node: 1, options: RootOptions.default() })
  run page.mutate(move batch)
  run set(&mut page, Attribute.Role { value: Role.Alert })
  run set(&mut page, Attribute.Level { value: 2 })
  run set(&mut page, Attribute.Live { value: Live.Polite })
  run set(&mut page, Attribute.Pressed { value: TriState.Mixed })
  run set(&mut page, Attribute.Checked { value: true })
  run set(&mut page, Attribute.Indeterminate { value: true })
  run set(&mut page, Attribute.Description { value: run String.copy("Saved just now") })
  let markup = run page.markup()
  let text = Bytes.asSlice(&markup)
  run Testing.expect(has(text, "role=\"alert\""), "the new role")
  run Testing.expect(has(text, "aria-level=\"2\""), "a number")
  run Testing.expect(has(text, "aria-live=\"polite\""), "a keyword")
  run Testing.expect(has(text, "aria-pressed=\"mixed\""), "a three-way state")
  run Testing.expect(has(text, "aria-checked=\"mixed\""), "indeterminate wins over checked")
  run Testing.expect(has(text, "aria-description=\"Saved just now\""), "text")

  run set(&mut page, Attribute.Level { value: 0 })
  run set(&mut page, Attribute.Live { value: Live.Off })
  run set(&mut page, Attribute.Indeterminate { value: false })
  let cleared = run page.markup()
  let after = Bytes.asSlice(&cleared)
  run Testing.expect(!has(after, "aria-level") && !has(after, "aria-live"), "defaults leave the attribute out")
  run Testing.expect(has(after, "aria-checked=\"true\""), "checked again without indeterminate")
}
