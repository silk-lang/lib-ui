//! The silk-ui docs site: a `Program` that runs in a page through `ui-app-dom`.
//!
//! Built for wasm it is the program the page runs. Built for the machine it is the static
//! build: it renders every page to markup and writes each as an `index.html` the wasm
//! program then hydrates.
import model { Browser, Command, Message, SECTIONS, sectionPath }
import site { Docs }
import theme { CHEVRON, MONO, SANS }
import ui_app_dom.html { Html, render }
import ui_app_dom.page
import ui_app.lib { TreeError }
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { String, InvalidUtf8 }

/// The [`Browser`] the page provides: three functions `index.html` passes to `mount`.
struct PageBrowser {}

static if Intrinsic.targetArchitecture() == "wasm32" {
  unsafe extern "C" fn hostRandom(sides: u32) -> u32 as "site#random"

  unsafe extern "C" fn hostSavedTheme() -> u32 as "site#savedTheme"

  unsafe extern "C" fn hostSaveTheme(theme: u32) -> () as "site#saveTheme"

  unsafe extern "C" fn hostAnswerLater(milliseconds: u32) -> () as "site#answerLater"

  impl Browser for PageBrowser {
    effect fn random(self: &mut Self, sides: u32) -> u32 {
      return unsafe hostRandom(sides)
    }

    effect fn savedTheme(self: &mut Self) -> u32 {
      return unsafe hostSavedTheme()
    }

    effect fn saveTheme(self: &mut Self, theme: u32) -> () {
      unsafe hostSaveTheme(theme)
    }

    effect fn answerLater(self: &mut Self, milliseconds: u32) -> () {
      unsafe hostAnswerLater(milliseconds)
    }
  }

  export "C" fn open() -> ?*mut u8 as "silk_ui_open" {
    let mut allocator = Allocator.systemAllocatorProvider()
    return run Effect.catchAll(page.open<Docs, Message, Command>(), page.unopened)
      |> Effect.provideMut<Allocator>(&mut allocator)
  }

  export "C" fn call(token: ?*mut u8, op: u32, a: f64, b: f64, c: f64) -> f64 as "silk_ui_call" {
    let mut allocator = Allocator.systemAllocatorProvider()
    let mut browser = PageBrowser {}
    return run Effect.catchAll(page.call<Docs, Message, Command>(token, op, a, b, c), page.failed)
      |> Effect.provideMut<Browser>(&mut browser)
      |> Effect.provideMut<Allocator>(&mut allocator)
  }
}

static if Intrinsic.targetArchitecture() == "wasm32" {
  pub fn main() -> i32 {
    return 0
  }
} else {
  import silk.io.writer_native { StderrWriter }
  import silk.system.filesystem_machine { MachineFileSystem }

  /// The [`Browser`] of a static build: no visit before this one, and a die that shows one.
  struct StaticBrowser {}

  impl Browser for StaticBrowser {
    effect fn random(self: &mut Self, sides: u32) -> u32 {
      return 1
    }

    effect fn savedTheme(self: &mut Self) -> u32 {
      return 0
    }

    effect fn saveTheme(self: &mut Self, theme: u32) -> () {}

    effect fn answerLater(self: &mut Self, milliseconds: u32) -> () {}
  }

  /// Where the markup goes in the page template, and where the base does.
  const MARKUP: string = "<!--silk-ui-->"

  const BASE: string = "%BASE%"

  // The same families `web/index.html` gives `mount`.
  const SANS_FAMILY: string = "Inter, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif"

  const MONO_FAMILY: string = "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"

  effect fn say(text: string) -> ()
    ! WriterError {
    let mut writer = StderrWriter.make()
    run Writer.writeString(text) |> Effect.provideMut<Writer>(&mut writer)
    run Writer.flush() |> Effect.provideMut<Writer>(&mut writer)
  }

  fn startsWith(text: &[u8], at: usize, token: &[u8]) -> bool {
    if at + token.length > text.length {
      return false
    }
    let mut i: usize = 0
    while i < token.length {
      if text[at + i] != token[i] {
        return false
      }
      i = i + 1
    }
    return true
  }

  /// `template` with the markup and the base in their places.
  effect fn fill(template: &[u8], markup: &[u8], base: &[u8]) -> Bytes
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut out = Bytes.make()
    let slot = String.utf8Bytes(MARKUP)
    let token = String.utf8Bytes(BASE)
    let mut from: usize = 0
    let mut i: usize = 0
    while i < template.length {
      if startsWith(template, i, slot) {
        run out.append(Slice.view<u8>(template, from, i - from))
        run out.append(markup)
        i = i + slot.length
        from = i
      } else if startsWith(template, i, token) {
        run out.append(Slice.view<u8>(template, from, i - from))
        run out.append(base)
        i = i + token.length
        from = i
      } else {
        i = i + 1
      }
    }
    run out.append(Slice.view<u8>(template, from, template.length - from))
    return move out
  }

  effect fn argument(index: usize) -> Bytes
    ! HostInputError | OutOfMemoryError
    ? &mut HostInput | &mut Allocator {
    return match run HostInput.argument(index) {
      Option<Bytes>.Some { value } => move value
      Option<Bytes>.None => Bytes.make()
    }
  }

  /// The path an argument names: itself when absolute, else from the working directory.
  effect fn place(name: &[u8]) -> Path
    ! FileError | HostInputError | OutOfMemoryError
    ? &mut HostInput | &mut Allocator {
    if name.length != 0 && name[0] == 47 {
      return run Path.fromBytes(name)
    }
    let cwd = run Path.fromBytes(Bytes.asSlice(&run HostInput.workingDirectory()))
    return run Path.resolveBytes(&cwd, name)
  }

  effect fn build() -> i32
    ! TreeError | OutOfMemoryError | WriterError | FileError | HostInputError
    ? &mut HostInput | &mut Allocator {
    let count = run HostInput.argumentCount()
    if count < 3 {
      run say("usage: ui-app-site <template.html> <out directory> [base]\n")
      return 2
    }
    let template = run place(Bytes.asSlice(&run argument(1)))
    let out = run place(Bytes.asSlice(&run argument(2)))
    let base = run argument(3)
    let baseText = String.fromUtf8(Bytes.asSlice(&base)) |> Result<string, InvalidUtf8>.unwrapOr("")

    let mut files = run MachineFileSystem.make()
    let page = run FileSystem.readFile(&template) |> Effect.provideMut<FileSystem>(&mut files)
    let mut browser = StaticBrowser {}
    let mut section: u32 = 0
    while section < SECTIONS {
      let path = sectionPath(section)
      let mut html = Html.make()
      run html.font(SANS, SANS_FAMILY)
      run html.font(MONO, MONO_FAMILY)
      run html.setBase(baseText)
      let mut chevron = Bytes.make()
      run chevron.append(Bytes.asSlice(&base))
      run chevron.append(b"/chevron.svg")
      run html.icon(
        CHEVRON,
        String.fromUtf8(Bytes.asSlice(&chevron)) |> Result<string, InvalidUtf8>.unwrapOr(""),
      )
      let markup = run render<Docs, Message, Command>(&mut html, path)
        |> Effect.provideMut<Browser>(&mut browser)
      let filled = run fill(Bytes.asSlice(&page), Bytes.asSlice(&markup), Bytes.asSlice(&base))

      // "/views/" is views/index.html under the out directory.
      let mut name = Bytes.make()
      run name.append(Slice.view<u8>(String.utf8Bytes(path), 1, String.byteLength(path) - 1))
      run name.append(b"index.html")
      let file = run Path.resolveBytes(&out, Bytes.asSlice(&name))
      run FileSystem.writeFileWithParents(&file, Bytes.asSlice(&filled))
        |> Effect.provideMut<FileSystem>(&mut files)
      run say("wrote ")
      run say(path)
      run say("\n")
      section = section + 1
    }
    return 0
  }

  effect fn failed<E>(error: E) -> i32
    ! WriterError {
    drop error
    run say("ui-app-site: rendering a page or writing it failed\n")
    return 2
  }

  effect fn failedQuietly<E>(error: E) -> i32 {
    drop error
    return 2
  }

  pub effect fn main() -> i32
    ? &mut HostInput {
    let mut allocator = Allocator.systemAllocatorProvider()
    return run Effect.catchAll(Effect.catchAll(build(), failed), failedQuietly)
      |> Effect.provideMut<Allocator>(&mut allocator)
  }
}
