//! The site's colors and fonts.
import silk.color.rgba { Rgba }
import silk.core.ownership { Copy }
import silk.num.u32

/// The font families `web/index.html` names: a sans and a monospace.
pub const SANS: u32 = 1

pub const MONO: u32 = 2

/// The icon resources `web/index.html` gives `mount`.
pub const CHEVRON: u32 = 1

pub fn rgb(hex: u32) -> Rgba<f32> {
  return rgba(hex, 1.0)
}

pub fn rgba(hex: u32, alpha: f32) -> Rgba<f32> {
  let r = u32.toF32(u32.bitAnd(u32.shiftRight(hex, 16), 255)) / 255.0
  let g = u32.toF32(u32.bitAnd(u32.shiftRight(hex, 8), 255)) / 255.0
  let b = u32.toF32(u32.bitAnd(hex, 255)) / 255.0
  return Rgba<f32> { r: r, g: g, b: b, a: alpha }
}

pub struct Theme {
  pub dark: bool,
  /// The page behind everything.
  pub page: Rgba<f32>,
  /// Cards and the sidebar.
  pub surface: Rgba<f32>,
  /// Hovered and inset surfaces.
  pub raised: Rgba<f32>,
  pub line: Rgba<f32>,
  pub text: Rgba<f32>,
  pub muted: Rgba<f32>,
  pub faint: Rgba<f32>,
  pub accent: Rgba<f32>,
  pub accentStrong: Rgba<f32>,
  pub accentSoft: Rgba<f32>,
  pub onAccent: Rgba<f32>,
  pub good: Rgba<f32>,
  pub warm: Rgba<f32>,
  pub codeSurface: Rgba<f32>,
  pub codeText: Rgba<f32>,
  pub codeKeyword: Rgba<f32>,
  pub codeType: Rgba<f32>,
  pub codeString: Rgba<f32>,
  pub codeComment: Rgba<f32>,
  pub codeNumber: Rgba<f32>,
}

impl Copy for Theme {}

pub fn theme(dark: bool) -> Theme {
  if dark {
    return Theme {
      dark: true,
      page: rgb(0x0B0D12),
      surface: rgb(0x12151C),
      raised: rgb(0x1A1E28),
      line: rgb(0x252A36),
      text: rgb(0xE8EAF0),
      muted: rgb(0x9AA3B5),
      faint: rgb(0x687083),
      accent: rgb(0x8B7CF6),
      accentStrong: rgb(0xA394FF),
      accentSoft: rgba(0x8B7CF6, 0.16),
      onAccent: rgb(0x0B0D12),
      good: rgb(0x4ADE80),
      warm: rgb(0xFBBF24),
      codeSurface: rgb(0x0E1117),
      codeText: rgb(0xD5D9E3),
      codeKeyword: rgb(0xC4A7FF),
      codeType: rgb(0x7DD3FC),
      codeString: rgb(0xA5E3A1),
      codeComment: rgb(0x687083),
      codeNumber: rgb(0xFBBF77),
    }
  }
  return Theme {
    dark: false,
    page: rgb(0xF6F5F2),
    surface: rgb(0xFFFFFF),
    raised: rgb(0xF0EEF8),
    line: rgb(0xE3E1DC),
    text: rgb(0x1B1D26),
    muted: rgb(0x5B6172),
    faint: rgb(0x8B90A0),
    accent: rgb(0x6D4AE8),
    accentStrong: rgb(0x5835D4),
    accentSoft: rgba(0x6D4AE8, 0.10),
    onAccent: rgb(0xFFFFFF),
    good: rgb(0x16A34A),
    warm: rgb(0xD97706),
    codeSurface: rgb(0x14161D),
    codeText: rgb(0xD5D9E3),
    codeKeyword: rgb(0xC4A7FF),
    codeType: rgb(0x7DD3FC),
    codeString: rgb(0xA5E3A1),
    codeComment: rgb(0x7A8296),
    codeNumber: rgb(0xFBBF77),
  }
}
