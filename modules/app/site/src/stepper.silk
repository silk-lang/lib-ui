//! A child the Submodels page embeds twice: a number that goes up and down by a step, and
//! tells its parent when it lands on a multiple of ten.
import kit { Tone, press, raw }
import theme { theme }
import ui_app.css
import ui_app.css { px, Align, Property, TextAlign }
import ui_app.lib { Document, Node, NoCommand, Receives, Submodel, Update }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub struct Stepper {
  pub name: string<'static>,
  pub value: i64,
  pub step: i64,
  /// The parent's theme: a child's view sees only its own model.
  pub dark: bool,
}

pub union StepperMessage {
  ClickedUp,
  ClickedDown,
}

/// What a stepper asks of whoever embeds it.
pub union StepperOutput {
  LandedOnTen { pub at: i64 },
}

/// What a parent may ask of a stepper.
pub union StepperInput {
  Reset,
  Themed { pub dark: bool },
}

type Step = Update<Stepper, NoCommand, StepperOutput>

impl Submodel<StepperMessage, NoCommand, StepperOutput> for Stepper {
  effect fn start(model: &Stepper) -> List<NoCommand>
    ! OutOfMemoryError
    ? &mut Allocator {
    return List<NoCommand>.make()
  }

  effect fn update(mut model: Stepper, message: StepperMessage) -> Step
    ! OutOfMemoryError
    ? &mut Allocator {
    match move message {
      StepperMessage.ClickedUp => {
        model.value = model.value + model.step
      }
      StepperMessage.ClickedDown => {
        model.value = model.value - model.step
      }
    }
    let value = model.value
    if value != 0 && value % 10 == 0 {
      return Step.of(move model).reporting(StepperOutput.LandedOnTen { at: value })
    }
    return Step.of(move model)
  }

  fn view(model: &Stepper, h: &Document<StepperMessage>) -> Node {
    let t = theme(model.dark)
    return h.row(
      &[h.style(&[css.alignItems(Align.Center), css.columnGap(px(10.0))])],
      &[
        h.box(
          &[h.style(&[css.color(t.muted), css.fontSize(px(14.0)), css.width(px(96.0))])],
          &[h.text(model.name)],
        ),
        press(h, &t, Tone.Plain, "-", StepperMessage.ClickedDown),
        h.box(
          &[
            h.style(
              &[
                css.color(t.text),
                css.fontSize(px(20.0)),
                css.fontWeight(650.0),
                css.minWidth(px(48.0)),
                css.textAlign(TextAlign.Center),
                raw(Property.FontVariantNumeric, b"tabular-nums"),
              ],
            ),
          ],
          &[h.number(model.value)],
        ),
        press(h, &t, Tone.Plain, "+", StepperMessage.ClickedUp),
      ],
    )
  }
}

impl Receives<StepperInput, NoCommand, StepperOutput> for Stepper {
  effect fn receive(mut model: Stepper, input: StepperInput) -> Step
    ! OutOfMemoryError
    ? &mut Allocator {
    match move input {
      StepperInput.Reset => {
        model.value = 0
      }
      StepperInput.Themed { dark } => {
        model.dark = dark
      }
    }
    return Step.of(move model)
  }
}
