//! The site's model, its messages and its commands.
import stepper { Stepper, StepperMessage }
import ui_app.lib { CommandSet }
import silk.collections.list { List }
import silk.mem.allocator { OutOfMemoryError }
import silk.text.string { String }

// The pages, in the order the sidebar lists them.
pub const OVERVIEW: u32 = 0

pub const PROGRAM: u32 = 1

pub const VIEWS: u32 = 2

pub const INPUT: u32 = 3

pub const SUBSCRIPTIONS: u32 = 4

pub const COMMANDS: u32 = 5

pub const SUBMODELS: u32 = 6

pub const BACKEND: u32 = 7

pub const SECTIONS: u32 = 8

/// Where page `section` is: the path its link goes to, and the directory a static build
/// writes its `index.html` in.
pub fn sectionPath(section: u32) -> string<'static> {
  if section == PROGRAM {
    return "/program/"
  }
  if section == VIEWS {
    return "/views/"
  }
  if section == INPUT {
    return "/input/"
  }
  if section == SUBSCRIPTIONS {
    return "/subscriptions/"
  }
  if section == COMMANDS {
    return "/commands/"
  }
  if section == SUBMODELS {
    return "/submodels/"
  }
  if section == BACKEND {
    return "/backends/"
  }
  return "/"
}

/// The page at `path`: the overview when no page is there. A query, a fragment and the last
/// slash do not count.
pub fn sectionAt(path: string) -> u32 {
  let bytes = String.utf8Bytes(path)
  let mut length: usize = 0
  while length < bytes.length && bytes[length] != 63 && bytes[length] != 35 {
    length = length + 1
  }
  while length > 1 && bytes[length - 1] == 47 {
    length = length - 1
  }
  let mut section: u32 = 1
  while section < SECTIONS {
    let wanted = String.utf8Bytes(sectionPath(section))
    if wanted.length - 1 == length {
      let mut same = true
      let mut i: usize = 0
      while i < length {
        if bytes[i] != wanted[i] {
          same = false
        }
        i = i + 1
      }
      if same {
        return section
      }
    }
    section = section + 1
  }
  return OVERVIEW
}

// Which todos the list shows.
pub const FILTER_ALL: u32 = 0

pub const FILTER_OPEN: u32 = 1

pub const FILTER_DONE: u32 = 2

/// How many slots the key binding demo's marker moves across.
pub const SLOTS: i64 = 9

pub struct Todo {
  pub id: u64,
  pub title: String,
  pub done: bool,
}

pub struct Site {
  pub section: u32,
  pub dark: bool,
  // The Views page.
  pub menu: bool,
  pub picked: u32,
  /// The viewport, in CSS pixels; zero until the first resize.
  pub width: f32,
  pub height: f32,
  // The Program page.
  pub count: i64,
  // The Input page.
  pub draft: String,
  pub todos: List<Todo>,
  pub nextTodo: u64,
  pub filter: u32,
  // The Subscriptions page.
  pub clock: bool,
  pub seconds: i64,
  pub wave: bool,
  pub phase: f32,
  pub lastFrame: f64,
  pub frames: i64,
  pub slot: i64,
  // The Commands page.
  pub face: u32,
  pub rolls: i64,
  pub total: i64,
  pub asking: bool,
  pub answer: String,
  // The Submodels page.
  pub first: Stepper,
  pub second: Stepper,
  pub tens: i64,
  pub lastTen: i64,
}

pub union Message {
  Went { pub section: u32 },
  WentBy { pub by: i64 },
  ToggledTheme,
  LoadedTheme { pub dark: bool },
  SavedTheme,
  Resized { pub width: f32, pub height: f32 },
  // The Views page.
  ToggledMenu,
  PickedBar { pub bar: u32 },
  // The Program page.
  Incremented,
  Decremented,
  ResetCount,
  // The Input page.
  ChangedDraft { pub value: String },
  SubmittedDraft,
  ToggledTodo { pub id: u64 },
  RemovedTodo { pub id: u64 },
  ClearedDone,
  PickedFilter { pub filter: u32 },
  // The Subscriptions page.
  ToggledClock,
  Ticked,
  ToggledWave,
  Framed { pub time: f64 },
  Nudged { pub by: i64 },
  // The Commands page.
  ClickedRoll,
  Rolled { pub face: u32 },
  ClickedAsk,
  Asked,
  Answered { pub text: String },
  // The Submodels page.
  GotFirst { pub message: StepperMessage },
  GotSecond { pub message: StepperMessage },
  ClickedResetSteppers,
}

/// What the page the program runs in can do for it. `main.silk` provides the real one.
pub service Browser {
  /// A whole number from 1 to `sides`.
  effect fn random(sides: u32) -> u32 ? &mut Browser

  /// The theme saved by an earlier visit: 0 none, 1 light, 2 dark.
  effect fn savedTheme() -> u32 ? &mut Browser

  effect fn saveTheme(theme: u32) -> () ? &mut Browser

  /// Posts the time of day to the port "answer", `milliseconds` from now.
  effect fn answerLater(milliseconds: u32) -> () ? &mut Browser
}

pub union Command {
  LoadTheme,
  SaveTheme { pub dark: bool },
  Roll { pub sides: u32 },
  Ask,
}

impl CommandSet<Message ? &mut Browser> for Command {
  effect fn execute(self: Self) -> Message
    ! OutOfMemoryError
    ? &mut Browser {
    match move self {
      Command.LoadTheme => {
        let saved = run Browser.savedTheme()
        return Message.LoadedTheme { dark: saved != 1 }
      }
      Command.SaveTheme { dark } => {
        run Browser.saveTheme(
          if dark {
            2
          } else {
            1
          },
        )
        return Message.SavedTheme
      }
      Command.Roll { sides } => {
        return Message.Rolled { face: run Browser.random(sides) }
      }
      Command.Ask => {
        // The answer is not here yet: it comes to the port, as `Answered`.
        run Browser.answerLater(900)
        return Message.Asked
      }
    }
  }
}
