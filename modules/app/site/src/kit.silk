//! The pieces the pages are made of: headings, prose, code, cards and buttons.
import theme { Theme, MONO, rgba }
import ui_app.css
import ui_app.css { px, Align, BorderStyle, BoxShadow, Keyword, Overflow, Property, WhiteSpace }
import ui_app.heap { Heap, allocate }
import ui_app.lib { Attr, Document, Node }
import silk.collections.list { List }
import silk.color.rgba { Rgba }
import silk.core.ownership { Copy }
import silk.text.string { String }

/// A declaration from CSS text, for what `css` has no function for.
pub fn raw(property: Property, value: &[u8]) -> css.Declaration {
  return css.declare(property, allocate(css.text(value)))
}

pub fn round(radius: f32) -> css.Declaration {
  return css.borderRadius(px(radius))
}

/// A one pixel border.
pub fn border<M>(h: &Document<M>, color: Rgba<f32>) -> Attr {
  return h.style(
    &[css.borderWidth(px(1.0)), css.borderStyle(BorderStyle.Solid), css.borderColor(color)],
  )
}

pub fn pad(vertical: f32, horizontal: f32) -> [css.Declaration; 4] {
  return [
    css.paddingTop(px(vertical)),
    css.paddingBottom(px(vertical)),
    css.paddingLeft(px(horizontal)),
    css.paddingRight(px(horizontal)),
  ]
}

// Prose.

/// The small label over a page title.
pub fn eyebrow<M>(h: &Document<M>, t: &Theme, value: string) -> Node {
  return h.box(
    &[
      h.style(
        &[
          css.color(t.accentStrong),
          css.fontSize(px(12.0)),
          css.fontWeight(600.0),
          raw(Property.LetterSpacing, b"0.08em"),
          raw(Property.TextTransform, b"uppercase"),
        ],
      ),
    ],
    &[h.text(value)],
  )
}

pub fn title<M>(h: &Document<M>, t: &Theme, value: string) -> Node {
  return h.box(
    &[
      h.style(
        &[
          css.color(t.text),
          css.fontSize(px(34.0)),
          css.fontWeight(700.0),
          css.lineHeight(px(40.0)),
          raw(Property.LetterSpacing, b"-0.02em"),
          css.marginTop(px(6.0)),
        ],
      ),
    ],
    &[h.text(value)],
  )
}

/// The paragraph under a page title.
pub fn lead<M>(h: &Document<M>, t: &Theme, value: string) -> Node {
  return h.box(
    &[
      h.style(
        &[
          css.color(t.muted),
          css.fontSize(px(17.0)),
          css.lineHeight(px(27.0)),
          css.marginTop(px(12.0)),
          css.maxWidth(px(640.0)),
        ],
      ),
    ],
    &[h.text(value)],
  )
}

pub fn heading<M>(h: &Document<M>, t: &Theme, value: string) -> Node {
  return h.box(
    &[
      h.style(
        &[
          css.color(t.text),
          css.fontSize(px(20.0)),
          css.fontWeight(650.0),
          css.lineHeight(px(28.0)),
          css.marginTop(px(40.0)),
          raw(Property.LetterSpacing, b"-0.01em"),
        ],
      ),
    ],
    &[h.text(value)],
  )
}

pub fn paragraph<M>(h: &Document<M>, t: &Theme, value: string) -> Node {
  return h.box(
    &[
      h.style(
        &[
          css.color(t.muted),
          css.fontSize(px(15.0)),
          css.lineHeight(px(25.0)),
          css.marginTop(px(10.0)),
          css.maxWidth(px(680.0)),
        ],
      ),
    ],
    &[h.text(value)],
  )
}

/// A name in monospace inside prose or a list.
pub fn mono<M>(h: &Document<M>, t: &Theme, value: string) -> Node {
  return h.box(
    &[
      h.style(
        &[
          css.display(Keyword.InlineBlock),
          css.fontFamily(MONO),
          css.fontSize(px(13.0)),
          css.color(t.accentStrong),
          css.backgroundColor(t.accentSoft),
          round(5.0),
        ],
      ),
      h.style(&pad(1.0, 6.0)),
    ],
    &[h.text(value)],
  )
}

/// A row of a definition list: a name in monospace and what it is.
pub fn term<M>(h: &Document<M>, t: &Theme, name: string, meaning: string) -> Node {
  return h.row(
    &[
      h.style(
        &[
          css.columnGap(px(14.0)),
          css.alignItems(Align.Baseline),
          css.borderTopWidth(px(1.0)),
          css.borderStyle(BorderStyle.Solid),
          css.borderColor(t.line),
        ],
      ),
      h.style(&pad(9.0, 0.0)),
    ],
    &[
      h.box(&[h.style(&[css.width(px(190.0)), css.flexShrink(0.0)])], &[mono(h, t, name)]),
      h.box(
        &[h.style(&[css.color(t.muted), css.fontSize(px(14.0)), css.lineHeight(px(22.0))])],
        &[h.text(meaning)],
      ),
    ],
  )
}

pub fn terms<M>(h: &Document<M>, children: &[Node]) -> Node {
  return h.column(&[h.style(&[css.marginTop(px(14.0)), css.maxWidth(px(720.0))])], children)
}

// Surfaces.

pub fn shadow(t: &Theme) -> css.Declaration {
  return allocate(
    css.boxShadow(
      BoxShadow {
        offsetX: 0.0,
        offsetY: 12.0,
        blur: 32.0,
        spread: -12.0,
        color: rgba(
          0x000000,
          if t.dark {
            0.6
          } else {
            0.18
          },
        ),
        inset: false,
      },
    ),
  )
}

pub fn card<M>(h: &Document<M>, t: &Theme, attributes: &[Attr], children: &[Node]) -> Node {
  let look = h.attrs(
    &[
      h.style(&[css.backgroundColor(t.surface), round(14.0), css.padding(px(20.0)), shadow(t)]),
      border(h, t.line),
    ],
  )
  return h.column(&[look, h.attrs(attributes)], children)
}

/// A live example: a labelled card holding running UI.
pub fn demo<M>(h: &Document<M>, t: &Theme, label: string, children: &[Node]) -> Node {
  return card(
    h,
    t,
    &[h.style(&[css.marginTop(px(18.0)), css.rowGap(px(14.0)), css.maxWidth(px(720.0))])],
    &[
      h.row(
        &[h.style(&[css.alignItems(Align.Center), css.columnGap(px(8.0))])],
        &[
          h.box(
            &[
              h.style(
                &[css.width(px(7.0)), css.height(px(7.0)), round(4.0), css.backgroundColor(t.good)],
              ),
            ],
            &[],
          ),
          h.box(
            &[
              h.style(
                &[
                  css.color(t.faint),
                  css.fontSize(px(11.0)),
                  css.fontWeight(600.0),
                  raw(Property.LetterSpacing, b"0.08em"),
                  raw(Property.TextTransform, b"uppercase"),
                ],
              ),
            ],
            &[h.text(label)],
          ),
        ],
      ),
      h.fragment(children),
    ],
  )
}

/// A small counter or state readout: a value over a caption.
pub fn stat<M>(h: &Document<M>, t: &Theme, value: Node, caption: string) -> Node {
  return h.column(
    &[
      h.style(&[css.backgroundColor(t.raised), round(10.0), css.minWidth(px(92.0))]),
      h.style(&pad(10.0, 14.0)),
    ],
    &[
      h.box(
        &[
          h.style(
            &[
              css.color(t.text),
              css.fontSize(px(22.0)),
              css.fontWeight(650.0),
              css.lineHeight(px(28.0)),
              raw(Property.FontVariantNumeric, b"tabular-nums"),
            ],
          ),
        ],
        &[value],
      ),
      h.box(&[h.style(&[css.color(t.faint), css.fontSize(px(12.0))])], &[h.text(caption)]),
    ],
  )
}

// Buttons.

/// How a button looks: filled with the accent, outlined, or bare.
pub enum Tone {
  Primary,
  Plain,
  Ghost,
}

pub fn pressLook<M>(h: &Document<M>, t: &Theme, tone: Tone) -> Attr {
  let base = h.attrs(
    &[
      h.style(
        &[
          css.fontSize(px(14.0)),
          css.fontWeight(550.0),
          css.lineHeight(px(20.0)),
          css.whiteSpace(WhiteSpace.NoWrap),
          round(9.0),
        ],
      ),
      h.style(&pad(7.0, 14.0)),
      h.focusVisible(&[allocate(css.boxShadow(ring(t)))]),
    ],
  )
  let tint = match tone {
    Tone.Primary => h.attrs(
      &[
        h.style(&[css.backgroundColor(t.accent), css.color(t.onAccent)]),
        border(h, t.accent),
        h.hover(&[css.backgroundColor(t.accentStrong), css.borderColor(t.accentStrong)]),
        h.active(&[css.opacity(0.85)]),
      ],
    )
    Tone.Plain => h.attrs(
      &[
        h.style(&[css.backgroundColor(t.surface), css.color(t.text)]),
        border(h, t.line),
        h.hover(&[css.backgroundColor(t.raised), css.borderColor(t.faint)]),
        h.active(&[css.opacity(0.8)]),
      ],
    )
    Tone.Ghost => h.attrs(
      &[
        h.style(&[css.color(t.muted)]),
        border(h, rgba(0x000000, 0.0)),
        h.hover(&[css.backgroundColor(t.raised), css.color(t.text)]),
        h.active(&[css.opacity(0.8)]),
      ],
    )
  }
  return h.attrs(&[base, tint])
}

fn ring(t: &Theme) -> BoxShadow {
  return BoxShadow {
    offsetX: 0.0,
    offsetY: 0.0,
    blur: 0.0,
    spread: 3.0,
    color: Rgba<f32> { r: t.accent.r, g: t.accent.g, b: t.accent.b, a: 0.45 },
    inset: false,
  }
}

/// A button that sends `message`.
pub fn press<M>(h: &Document<M>, t: &Theme, tone: Tone, label: string, message: M) -> Node {
  return h.button(&[h.onClick(move message), pressLook(h, t, tone)], &[h.text(label)])
}

// Code.

const PLAIN: u8 = 0

const KEYWORD: u8 = 1

const TYPE: u8 = 2

const TEXT: u8 = 3

const COMMENT: u8 = 4

const NUMBER: u8 = 5

struct Piece {
  start: usize,
  length: usize,
  kind: u8,
}

impl Copy for Piece {}

fn isLetter(byte: u8) -> bool {
  return byte >= 97 && byte <= 122 || byte >= 65 && byte <= 90 || byte == 95
}

fn isDigit(byte: u8) -> bool {
  return byte >= 48 && byte <= 57
}

fn isKeyword(word: string) -> bool {
  let words: [string; 24] = [
    "fn",
    "pub",
    "effect",
    "impl",
    "for",
    "struct",
    "union",
    "enum",
    "match",
    "return",
    "let",
    "mut",
    "move",
    "run",
    "if",
    "else",
    "while",
    "import",
    "export",
    "service",
    "type",
    "as",
    "const",
    "await",
  ]
  let mut i: usize = 0
  while i < words.length {
    if words[i] == word {
      return true
    }
    i = i + 1
  }
  return false
}

/// Splits a line of Silk (or JavaScript: close enough) into colored pieces.
fn pieces(line: string, out: &mut List<Piece>) -> () {
  let mut heap = Heap.make()
  let bytes = String.utf8Bytes(line)
  let mut at: usize = 0
  let mut plain: usize = 0
  while at < bytes.length {
    let byte = bytes[at]
    let mut end = at
    let mut kind = PLAIN
    if byte == 47 && at + 1 < bytes.length && bytes[at + 1] == 47 {
      end = bytes.length
      kind = COMMENT
    } else if byte == 34 {
      end = at + 1
      while end < bytes.length && bytes[end] != 34 {
        end = end + 1
      }
      if end < bytes.length {
        end = end + 1
      }
      kind = TEXT
    } else if isLetter(byte) {
      while end < bytes.length && (isLetter(bytes[end]) || isDigit(bytes[end])) {
        end = end + 1
      }
      if isKeyword(String.slice(line, at, end - at)) {
        kind = KEYWORD
      } else if byte >= 65 && byte <= 90 {
        kind = TYPE
      }
    } else if isDigit(byte) {
      while end < bytes.length && (isDigit(bytes[end]) || bytes[end] == 46) {
        end = end + 1
      }
      kind = NUMBER
    }
    if kind == PLAIN {
      at = if end > at {
        end
      } else {
        at + 1
      }
    } else {
      if plain < at {
        heap.alloc(out.append(Piece { start: plain, length: at - plain, kind: PLAIN }))
      }
      heap.alloc(out.append(Piece { start: at, length: end - at, kind: kind }))
      at = end
      plain = end
    }
  }
  if plain < bytes.length {
    heap.alloc(out.append(Piece { start: plain, length: bytes.length - plain, kind: PLAIN }))
  }
}

fn codeLine<M>(h: &Document<M>, t: &Theme, line: string) -> Node {
  let mut found = List<Piece>.make()
  pieces(line, &mut found)
  let look = h.style(&[css.whiteSpace(WhiteSpace.Pre), css.minHeight(px(20.0))])
  let colors = t.*
  return h.box(
    &[look],
    &[
      h.each(
        found.asSlice(),
        |piece| {
          let text = h.text(String.slice(line, piece.start, piece.length))
          if piece.kind == PLAIN {
            return text
          }
          let color = if piece.kind == KEYWORD {
            colors.codeKeyword
          } else if piece.kind == TYPE {
            colors.codeType
          } else if piece.kind == TEXT {
            colors.codeString
          } else if piece.kind == COMMENT {
            colors.codeComment
          } else {
            colors.codeNumber
          }
          return h.box(&[h.style(&[css.display(Keyword.Inline), css.color(color)])], &[text])
        },
      ),
    ],
  )
}

/// A block of highlighted code, one string per line.
pub fn code<M>(h: &Document<M>, t: &Theme, lines: &[string]) -> Node {
  return h.box(
    &[
      h.style(
        &[
          css.backgroundColor(t.codeSurface),
          css.color(t.codeText),
          css.fontFamily(MONO),
          css.fontSize(px(13.0)),
          css.lineHeight(px(20.0)),
          css.marginTop(px(16.0)),
          css.maxWidth(px(720.0)),
          css.overflowX(Overflow.Auto),
          round(12.0),
        ],
      ),
      h.style(&pad(16.0, 18.0)),
      border(
        h,
        if t.dark {
          t.line
        } else {
          t.codeSurface
        },
      ),
    ],
    &[h.each(lines, |line| codeLine(h, t, line.*))],
  )
}
