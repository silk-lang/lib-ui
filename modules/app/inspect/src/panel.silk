//! The Program panel: a silk-ui program, written with its own builder, that shows another
//! program's messages and the model after each. It runs in the inspected app and renders into a
//! [`View`] (see `ui_inspect_server.extension`): its mutation batches go to the client that has
//! the panel open, which draws them with its own fonts and look, and the client's event records
//! for its nodes come back. Nothing of it runs while no client looks.
import program { ProgramLog, DiffRow, KEPT, ADDED, REMOVED, diffRows }
import ui_app.css
import ui_app.css {
  px,
  percent,
  Keyword,
  Align,
  BorderStyle,
  BoxSizing,
  Overflow,
  TextAlign,
  WhiteSpace
}
import ui_app.backend { Backend, Measured, TreeError }
import ui_app.lib { Attr, Document, Heap, Node, NoCommand, NoOutput, Program, Role, Update }
import ui_inspect_server.extension { View }
import ui_inspect_server.remote { VIEW_FONT_UI, VIEW_FONT_MONO }
import ui_protocol.mutation { Mutation }
import ui_protocol.record { Event }
import ui_protocol.root { RootEvent, RootSupport }
import ui_tree.inspect { writeInt }
import silk.collections.list { List }
import silk.color.rgba { Rgba }
import silk.core.option { Option }
import silk.geometry.rect { Rect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.text.string { String }

/// One message the program handled, as the panel shows it.
pub struct PanelStep {
  pub seq: u64,
  pub cause: String,
  pub message: String,
  /// The commands update returned, joined with commas, and one by one.
  pub commands: String,
  pub commandList: List<String>,
  /// Whether the step left the model different.
  pub changed: bool,
  /// The model after the step.
  pub model: String,
}

/// The panel's model: a copy of what the log holds, and the step that is open.
pub struct ProgramPanel {
  pub attached: bool,
  /// The counters in one line.
  pub line: String,
  pub subscriptions: List<String>,
  /// The subscriptions in one line, `, ` between them.
  pub subscribed: String,
  pub steps: List<PanelStep>,
  /// The step whose model shows, or 0.
  pub opened: u64,
  pub diff: List<DiffRow>,
  pub changedLines: usize,
  /// Steps up to this one are cleared from the list.
  pub cleared: u64,
  /// Whether the model shows in full rather than as its diff with the model before.
  pub full: bool,
}

pub union PanelMessage {
  /// Open the model after step `seq`, or close it when it is open.
  OpenStep { pub seq: u64 },
  /// Hide the steps so far.
  Clear,
  /// Show the model in full, or its diff.
  Mode { pub full: bool },
}

type Next = Update<ProgramPanel, NoCommand, NoOutput>

impl ProgramPanel {
  pub fn make() -> ProgramPanel {
    return ProgramPanel {
      attached: false,
      line: String.make(),
      subscriptions: List<String>.make(),
      subscribed: String.make(),
      steps: List<PanelStep>.make(),
      opened: 0,
      diff: List<DiffRow>.make(),
      changedLines: 0,
      cleared: 0,
      full: false,
    }
  }

  fn last(self: &Self) -> u64 {
    let steps = self.steps.asSlice()
    if steps.length == 0 {
      return 0
    }
    return steps[steps.length - 1].seq
  }

  /// Takes what changed in `log` since the last call: new steps, the counters and the
  /// subscriptions. Returns whether anything did.
  pub effect fn sync(self: &mut Self, log: &ProgramLog) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut changed = self.attached != log.attached
    self.attached = log.attached
    let steps = log.steps.asSlice()
    let first = if steps.length == 0 {
      0
    } else {
      steps[0].seq
    }

    // A program that started again counts from one: what was copied is another run's.
    if steps.length != 0 && steps[steps.length - 1].seq < self.last() {
      self.steps.clear()
      self.opened = 0
      self.diff.clear()
      self.cleared = 0
      changed = true
    }
    while self.steps.length() != 0 && self.steps.asSlice()[0].seq < first {
      drop self.steps.remove(0)
      changed = true
    }
    let last = self.last()
    let mut i: usize = 0
    while i < steps.length {
      if steps[i].seq > last {
        let mut commands = String.make()
        let mut commandList = List<String>.make()
        let list = steps[i].commands.asSlice()
        let mut k: usize = 0
        while k < list.length {
          if k > 0 {
            run commands.append(", ")
          }
          run commands.append(String.view(&list[k]))
          run commandList.append(run String.copy(String.view(&list[k])))
          k = k + 1
        }
        let before = if i == 0 {
          String.view(&steps[i].model)
        } else {
          String.view(&steps[i - 1].model)
        }
        run self.steps.append(
          PanelStep {
            seq: steps[i].seq,
            cause: run String.copy(String.view(&steps[i].cause)),
            message: run String.copy(String.view(&steps[i].message)),
            commands: move commands,
            commandList: move commandList,
            changed: i == 0 || before != String.view(&steps[i].model),
            model: run String.copy(String.view(&steps[i].model)),
          },
        )
        changed = true
      }
      i = i + 1
    }
    let mut line = String.make()
    run counter(&mut line, log.stats.messages, "messages")
    run counter(&mut line, log.stats.commands, "commands")
    run counter(&mut line, log.stats.renders, "renders")
    run counter(&mut line, log.stats.mutations, "mutations in the last")
    run counter(&mut line, log.stats.reused, "of")
    run line.append(" ")
    run writeInt(&mut line, log.stats.nodes)
    run line.append(" nodes reused")
    if String.view(&line) != String.view(&self.line) {
      self.line = move line
      changed = true
    }
    if !sameLines(&self.subscriptions, &log.subscriptions) {
      self.subscriptions.clear()
      self.subscribed.clear()
      let subs = log.subscriptions.asSlice()
      let mut s: usize = 0
      while s < subs.length {
        run self.subscriptions.append(run String.copy(String.view(&subs[s])))
        if s > 0 {
          run self.subscribed.append(", ")
        }
        run self.subscribed.append(String.view(&subs[s]))
        s = s + 1
      }
      changed = true
    }
    return changed
  }

  /// Opens step `seq`: its model, compared with the model before it.
  effect fn open(self: &mut Self, seq: u64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.diff.clear()
    self.changedLines = 0
    self.opened = 0
    let steps = self.steps.asSlice()
    let mut i: usize = 0
    while i < steps.length {
      if steps[i].seq == seq {
        let before = if i == 0 {
          String.view(&steps[i].model)
        } else {
          String.view(&steps[i - 1].model)
        }
        self.changedLines = run diffRows(before, String.view(&steps[i].model), &mut self.diff)
        self.opened = seq
      }
      i = i + 1
    }
  }
}

effect fn counter(out: &mut String, value: u64, unit: string) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if out.ownedByteLength() != 0 {
    run out.append("  ·  ")
  }
  run writeInt(&mut out, value)
  run out.append(" ")
  run out.append(unit)
}

fn sameLines(a: &List<String>, b: &List<String>) -> bool {
  if a.length() != b.length() {
    return false
  }
  let x = a.asSlice()
  let y = b.asSlice()
  let mut i: usize = 0
  while i < x.length {
    if String.view(&x[i]) != String.view(&y[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

// The look. A view brings no theme of its own: it inherits the devtools' type and draws on their
// instrument black. These few colors repeat the devtools' (`ui_inspect_devtools.theme`), which
// this package must not depend on: keep the two in step.

fn rgba(hex: u32, alpha: u32) -> Rgba<f32> {
  let r = u32.toF32(u32.bitAnd(u32.shiftRight(hex, 16), 255)) / 255.0
  let g = u32.toF32(u32.bitAnd(u32.shiftRight(hex, 8), 255)) / 255.0
  let b = u32.toF32(u32.bitAnd(hex, 255)) / 255.0
  return Rgba<f32> { r: r, g: g, b: b, a: u32.toF32(alpha) / 255.0 }
}

fn rgb(hex: u32) -> Rgba<f32> {
  return rgba(hex, 255)
}

fn clear() -> Rgba<f32> {
  return Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }
}

const SURFACE: u32 = 0x17171A

const LINE: u32 = 0x26262B

const TEXT: u32 = 0xEDEDEA

const MUTED: u32 = 0x8A8A90

const FAINT: u32 = 0x5C5C63

const ACCENT: u32 = 0xFFB020

const ACCENT_DIM: u32 = 0xC99A45

/// The washes under a selected row and an added line (alpha over the accent), and under a
/// removed line.
const WASH: u32 = 0x1F

const HOVER: u32 = 0x5AC8FA

const RED: u32 = 0xF0857D

const RED_WASH: u32 = 0xF05A50

/// The messages' column, as wide as the design draws it.
const MESSAGES_WIDTH: f32 = 300.0

/// How many lines either side of a change read as its context (in full ink); the rest of the
/// model is muted.
const CONTEXT: usize = 4

fn ui(h: &Document<PanelMessage>, size: f32, line: f32) -> Attr {
  return h.style(&[css.fontFamilyNumber(VIEW_FONT_UI), css.fontSize(px(size)), css.lineHeight(px(line))])
}

fn mono(h: &Document<PanelMessage>, size: f32, line: f32) -> Attr {
  return h.style(
    &[css.fontFamilyNumber(VIEW_FONT_MONO), css.fontSize(px(size)), css.lineHeight(px(line))],
  )
}

fn ink(h: &Document<PanelMessage>, hex: u32, text: string) -> Node {
  return h.box(&[h.style(&[css.color(rgb(hex))])], &[h.text(text)])
}

/// A section label: Geist 11 in capitals, muted.
fn label(h: &Document<PanelMessage>, text: string) -> Node {
  return h.box(
    &[
      ui(h, 11.0, 14.0),
      h.style(&[css.color(rgb(MUTED)), css.whiteSpace(WhiteSpace.Pre), css.flexShrink(0.0)]),
    ],
    &[h.text(text)],
  )
}

/// The head of a list: its label, and at the right `trailing`.
fn head(h: &Document<PanelMessage>, inline: f32, children: &[Node]) -> Node {
  return h.row(
    &[
      h.style(
        &[
          css.alignItems(Align.Center),
          css.justifyContent(Align.SpaceBetween),
          css.columnGap(px(10.0)),
          css.height(px(32.0)),
          css.flexShrink(0.0),
          css.paddingLeft(px(inline)),
          css.paddingRight(px(inline)),
        ],
      ),
    ],
    children,
  )
}

/// `text` with ASCII letters in capitals (the tree has no `text-transform`).
effect fn capitals(text: string) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let bytes = String.utf8Bytes(text)
  let mut out = String.make()
  let mut start: usize = 0
  let mut i: usize = 0
  while i < bytes.length {
    if bytes[i] >= 97 && bytes[i] <= 122 {
      run out.append(String.slice(text, start, i - start))
      run out.append(String.slice("ABCDEFGHIJKLMNOPQRSTUVWXYZ", u8.toUsize(bytes[i] - 97), 1))
      start = i + 1
    }
    i = i + 1
  }
  run out.append(String.slice(text, start, bytes.length - start))
  return move out
}

/// A message in its two parts: its name, and what it carries (from the first space).
fn messageParts(message: string) -> [string; 2] {
  return match String.find(message, " ") {
    Option<usize>.Some { value: at } => [
      String.slice(message, 0, at),
      String.slice(message, at, String.byteLength(message) - at),
    ]
    Option<usize>.None => [message, ""]
  }
}

fn stepView(model: &ProgramPanel, h: &Document<PanelMessage>, step: &PanelStep) -> Node {
  let open = model.opened == step.seq
  let parts = messageParts(String.view(&step.message))
  let mut heap = Heap.make()
  let seq = heap.alloc(seqLine(step.seq))
  return h.keyed(
    step.seq,
    h.button(
      &[
        h.accessRole(Role.ListItem),
        h.label(String.view(&step.message)),
        h.onClick(PanelMessage.OpenStep { seq: step.seq }),
        h.style(
          &[
            css.display(Keyword.Flex),
            css.alignItems(Align.Center),
            css.columnGap(px(10.0)),
            css.height(px(28.0)),
            css.flexShrink(0.0),
            css.boxSizing(BoxSizing.BorderBox),
            css.paddingRight(px(12.0)),
            css.whiteSpace(WhiteSpace.Pre),
          ],
        ),
        if open {
          h.style(
            &[
              css.paddingLeft(px(10.0)),
              css.borderLeftWidth(px(2.0)),
              css.borderStyle(BorderStyle.Solid),
              css.borderColor(rgb(ACCENT)),
              css.backgroundColor(rgba(ACCENT, WASH)),
            ],
          )
        } else {
          h.style(&[css.paddingLeft(px(12.0))])
        },
        if open {
          h.none()
        } else {
          h.hover(&[css.backgroundColor(rgba(HOVER, 0x1A))])
        },
        h.focusVisible(&[css.backgroundColor(rgba(HOVER, 0x1A))]),
      ],
      &[
        h.box(
          &[
            mono(h, 11.0, 16.0),
            h.label(
              if step.changed {
                "changed the model"
              } else {
                ""
              },
            ),
            h.style(
              &[
                css.width(px(24.0)),
                css.flexShrink(0.0),
                css.textAlign(TextAlign.Right),
                css.color(
                  rgb(
                    if open {
                      ACCENT_DIM
                    } else if step.changed {
                      MUTED
                    } else {
                      FAINT
                    },
                  ),
                ),
              ],
            ),
          ],
          &[h.text(String.view(&seq))],
        ),
        h.box(
          &[
            h.style(
              &[
                css.flexGrow(1.0),
                css.flexBasis(px(0.0)),
                css.minWidth(px(0.0)),
                css.overflowX(Overflow.Hidden),
                css.color(
                  rgb(
                    if open {
                      ACCENT
                    } else {
                      TEXT
                    },
                  ),
                ),
              ],
            ),
            if open {
              h.style(&[css.fontWeight(500.0)])
            } else {
              h.none()
            },
          ],
          &[
            h.text(parts[0]),
            h.span(
              &[
                h.style(
                  &[
                    css.fontWeight(400.0),
                    css.color(
                      rgb(
                        if open {
                          ACCENT_DIM
                        } else {
                          MUTED
                        },
                      ),
                    ),
                  ],
                ),
              ],
              &[h.text(parts[1])],
            ),
          ],
        ),
        h.box(
          &[
            mono(h, 11.0, 16.0),
            h.style(
              &[
                css.flexShrink(0.0),
                css.color(
                  rgb(
                    if open {
                      ACCENT_DIM
                    } else {
                      FAINT
                    },
                  ),
                ),
              ],
            ),
          ],
          &[h.text(String.view(&step.cause))],
        ),
      ],
    ),
  )
}

effect fn seqLine(seq: u64) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = String.make()
  run writeInt(&mut text, seq)
  return move text
}

/// The step the model side shows: the one opened, or the newest.
fn shownStep(model: &ProgramPanel) -> Option<&PanelStep> {
  let steps = model.steps.asSlice()
  let mut i = steps.length
  while i > 0 {
    i = i - 1
    if steps[i].seq == model.opened || (model.opened == 0 && steps[i].seq > model.cleared) {
      return Option<&PanelStep>.some(&steps[i])
    }
  }
  return Option<&PanelStep>.None
}

/// "Model after 47 · SaveClicked", in capitals.
effect fn modelTitle(step: &PanelStep) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = run String.copy("Model after ")
  run writeInt(&mut text, step.seq)
  run text.append(" · ")
  run text.append(messageParts(String.view(&step.message))[0])
  return run capitals(String.view(&text))
}

/// Diff or Full: a small segmented control.
fn modeSwitch(model: &ProgramPanel, h: &Document<PanelMessage>) -> Node {
  return h.row(
    &[
      h.testId("model-mode"),
      h.accessRole(Role.TabList),
      h.style(
        &[
          css.alignItems(Align.Center),
          css.columnGap(px(2.0)),
          css.paddingTop(px(2.0)),
          css.paddingBottom(px(2.0)),
          css.paddingLeft(px(2.0)),
          css.paddingRight(px(2.0)),
          css.flexShrink(0.0),
          css.borderTopWidth(px(1.0)),
          css.borderRightWidth(px(1.0)),
          css.borderBottomWidth(px(1.0)),
          css.borderLeftWidth(px(1.0)),
          css.borderStyle(BorderStyle.Solid),
          css.borderColor(rgb(LINE)),
          css.borderRadius(px(5.0)),
          css.backgroundColor(rgb(SURFACE)),
        ],
      ),
    ],
    &[modeButton(h, "Diff", !model.full, false), modeButton(h, "Full", model.full, true)],
  )
}

fn modeButton(h: &Document<PanelMessage>, text: string, selected: bool, full: bool) -> Node {
  return h.button(
    &[
      h.label(text),
      h.onClick(PanelMessage.Mode { full: full }),
      ui(h, 11.0, 14.0),
      h.style(
        &[
          css.paddingTop(px(2.0)),
          css.paddingBottom(px(2.0)),
          css.paddingLeft(px(8.0)),
          css.paddingRight(px(8.0)),
          css.borderRadius(px(3.0)),
          css.backgroundColor(
            if selected {
              rgb(LINE)
            } else {
              clear()
            },
          ),
          css.color(
            rgb(
              if selected {
                TEXT
              } else {
                MUTED
              },
            ),
          ),
        ],
      ),
      h.hover(&[css.color(rgb(TEXT))]),
    ],
    &[h.text(text)],
  )
}

/// Whether line `at` of the diff is within [`CONTEXT`] lines of a change.
fn nearChange(rows: &[DiffRow], at: usize) -> bool {
  let from = if at > CONTEXT {
    at - CONTEXT
  } else {
    0
  }
  let mut i = from
  while i < rows.length && i <= at + CONTEXT {
    if rows[i].op != KEPT {
      return true
    }
    i = i + 1
  }
  return false
}

/// One line of the model: an added one in amber, a removed one in red, the rest muted unless
/// it is near a change.
fn modelLine(h: &Document<PanelMessage>, op: u8, line: string, near: bool) -> Node {
  let lead = if op == ADDED {
    "+ "
  } else if op == REMOVED {
    "- "
  } else {
    "  "
  }
  return h.row(
    &[
      h.style(
        &[
          css.paddingLeft(px(16.0)),
          css.paddingRight(px(16.0)),
          css.flexShrink(0.0),
          css.whiteSpace(WhiteSpace.Pre),
        ],
      ),
      if op == ADDED {
        h.style(&[css.backgroundColor(rgba(ACCENT, WASH)), css.color(rgb(ACCENT))])
      } else if op == REMOVED {
        h.style(&[css.backgroundColor(rgba(RED_WASH, WASH)), css.color(rgb(RED))])
      } else {
        h.style(
          &[
            css.color(
              rgb(
                if near {
                  TEXT
                } else {
                  MUTED
                },
              ),
            ),
          ],
        )
      },
    ],
    &[h.text(lead), h.text(line)],
  )
}

effect fn diffNodes(model: &ProgramPanel, h: &Document<PanelMessage>, out: &mut List<Node>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let rows = model.diff.asSlice()
  let mut i: usize = 0
  while i < rows.length {
    run out.append(
      h.keyed(
        usize.toU64(i) + 1,
        modelLine(h, rows[i].op, String.view(&rows[i].line), nearChange(rows, i)),
      ),
    )
    i = i + 1
  }
}

effect fn fullNodes(step: &PanelStep, h: &Document<PanelMessage>, out: &mut List<Node>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut lines = String.split(String.view(&step.model), "\n")
  let mut i: u64 = 1
  while true {
    match lines.next() {
      Option<string>.Some { value: line } => {
        run out.append(h.keyed(i, modelLine(h, KEPT, line, true)))
        i = i + 1
      }
      Option<string>.None => {
        break
      }
    }
  }
}

/// What a command led to: the later step it sent (`→ 48 Saved`), or "".
effect fn resultOf(model: &ProgramPanel, step: &PanelStep, command: string) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut cause = run String.copy("command ")
  run cause.append(command)
  let mut text = String.make()
  let steps = model.steps.asSlice()
  let mut i: usize = 0
  while i < steps.length {
    if steps[i].seq > step.seq && String.view(&steps[i].cause) == String.view(&cause) {
      run text.append("→ ")
      run writeInt(&mut text, steps[i].seq)
      run text.append(" ")
      run text.append(messageParts(String.view(&steps[i].message))[0])
      return move text
    }
    i = i + 1
  }
  return move text
}

effect fn commandNodes(
  model: &ProgramPanel,
  step: &PanelStep,
  h: &Document<PanelMessage>,
  out: &mut List<Node>,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut heap = Heap.make()
  let list = step.commandList.asSlice()
  let mut k: u64 = 1
  let mut c: usize = 0
  while c < list.length {
    let command = String.view(&list[c])
    let result = heap.alloc(resultOf(model, step, command))
    run out.append(
      h.keyed(
        k,
        h.row(
          &[
            h.accessRole(Role.ListItem),
            h.style(
              &[
                css.alignItems(Align.Center),
                css.columnGap(px(10.0)),
                css.height(px(26.0)),
                css.flexShrink(0.0),
                css.paddingLeft(px(16.0)),
                css.paddingRight(px(16.0)),
                css.whiteSpace(WhiteSpace.Pre),
              ],
            ),
          ],
          &[
            h.box(
              &[h.style(&[css.width(px(56.0)), css.flexShrink(0.0), css.color(rgb(MUTED))])],
              &[h.text("run")],
            ),
            h.box(
              &[
                h.style(
                  &[
                    css.flexGrow(1.0),
                    css.flexBasis(px(0.0)),
                    css.minWidth(px(0.0)),
                    css.overflowX(Overflow.Hidden),
                    css.color(rgb(TEXT)),
                  ],
                ),
              ],
              &[h.text(command)],
            ),
            h.box(
              &[mono(h, 11.0, 16.0), h.style(&[css.flexShrink(0.0), css.color(rgb(FAINT))])],
              &[h.text(String.view(&result))],
            ),
          ],
        ),
      ),
    )
    k = k + 1
    c = c + 1
  }
}

/// The model side: the step's model (its diff, or in full), then the commands it returned.
fn modelView(model: &ProgramPanel, h: &Document<PanelMessage>) -> Node {
  let mut heap = Heap.make()
  let step = match shownStep(model) {
    Option<&PanelStep>.Some { value } => value
    Option<&PanelStep>.None => {
      return h.column(
        &[h.style(&[css.flexGrow(1.0), css.flexBasis(px(0.0)), css.minWidth(px(0.0))])],
        &[],
      )
    }
  }
  let title = heap.alloc(modelTitle(step))
  let mut lines = List<Node>.make()
  if model.full || model.opened != step.seq {
    heap.alloc(fullNodes(step, h, &mut lines))
  } else {
    heap.alloc(diffNodes(model, h, &mut lines))
  }
  let mut commands = List<Node>.make()
  heap.alloc(commandNodes(model, step, h, &mut commands))
  return h.column(
    &[
      h.testId("model"),
      h.style(
        &[
          css.flexGrow(1.0),
          css.flexBasis(px(0.0)),
          css.minWidth(px(0.0)),
          css.minHeight(px(0.0)),
          css.overflowY(Overflow.Scroll),
          css.overflowX(Overflow.Hidden),
        ],
      ),
    ],
    &[
      head(h, 16.0, &[label(h, String.view(&title)), modeSwitch(model, h)]),
      if !model.full && model.opened == step.seq && model.changedLines == 0 {
        h.box(
          &[ui(h, 12.0, 16.0), h.style(&[css.paddingLeft(px(16.0)), css.paddingBottom(px(4.0))])],
          &[ink(h, MUTED, "The model did not change.")],
        )
      } else {
        h.empty()
      },
      h.column(
        &[
          mono(h, 12.0, 22.0),
          h.style(&[css.paddingTop(px(4.0)), css.paddingBottom(px(4.0)), css.flexShrink(0.0)]),
        ],
        &[h.fragment(lines.asSlice())],
      ),
      h.column(
        &[
          h.testId("commands"),
          h.accessRole(Role.List),
          mono(h, 12.0, 16.0),
          h.style(
            &[
              css.flexShrink(0.0),
              css.paddingBottom(px(8.0)),
              css.borderTopWidth(px(1.0)),
              css.borderStyle(BorderStyle.Solid),
              css.borderColor(rgb(LINE)),
            ],
          ),
        ],
        &[
          head(h, 16.0, &[label(h, "COMMANDS")]),
          if commands.length() == 0 {
            h.box(
              &[ui(h, 12.0, 16.0), h.style(&[css.paddingLeft(px(16.0)), css.height(px(26.0))])],
              &[ink(h, FAINT, "None returned.")],
            )
          } else {
            h.fragment(commands.asSlice())
          },
        ],
      ),
    ],
  )
}

/// The steps that are not cleared, newest first.
fn newestFirst(model: &ProgramPanel, h: &Document<PanelMessage>) -> Node {
  let mut heap = Heap.make()
  let mut nodes = List<Node>.make()
  let steps = model.steps.asSlice()
  let mut i = steps.length
  while i > 0 {
    i = i - 1
    if steps[i].seq > model.cleared {
      heap.alloc(nodes.append(stepView(model, h, &steps[i])))
    }
  }
  return h.fragment(nodes.asSlice())
}

impl Program<PanelMessage, NoCommand> for ProgramPanel {
  effect fn init() -> Next
    ! OutOfMemoryError
    ? &mut Allocator {
    return Next.of(ProgramPanel.make())
  }

  effect fn update(mut model: ProgramPanel, message: PanelMessage) -> Next
    ! OutOfMemoryError
    ? &mut Allocator {
    match move message {
      PanelMessage.OpenStep { seq } => {
        if model.opened == seq {
          model.opened = 0
          model.diff.clear()
        } else {
          run model.open(seq)
        }
      }
      PanelMessage.Clear => {
        model.cleared = model.last()
        model.opened = 0
        model.diff.clear()
      }
      PanelMessage.Mode { full } => {
        model.full = full
      }
    }
    return Next.of(move model)
  }

  fn view(model: &ProgramPanel, h: &Document<PanelMessage>) -> Node {
    if !model.attached && model.steps.length() == 0 {
      return h.column(
        &[h.testId("program"), ui(h, 12.0, 16.0), h.style(&[css.padding(px(12.0))])],
        &[ink(h, MUTED, "No program is attached yet.")],
      )
    }
    let mut shown: usize = 0
    let steps = model.steps.asSlice()
    let mut i: usize = 0
    while i < steps.length {
      if steps[i].seq > model.cleared {
        shown = shown + 1
      }
      i = i + 1
    }
    let mut heap = Heap.make()
    let count = heap.alloc(seqLine(usize.toU64(shown)))
    return h.row(
      &[
        h.testId("program"),
        mono(h, 12.0, 16.0),
        h.style(
          &[
            css.flexGrow(1.0),
            css.minHeight(px(0.0)),
            css.height(percent(100.0)),
            css.alignItems(Align.Stretch),
            css.color(rgb(TEXT)),
          ],
        ),
      ],
      &[
        h.column(
          &[
            h.style(
              &[
                css.width(px(MESSAGES_WIDTH)),
                css.flexShrink(0.0),
                css.minHeight(px(0.0)),
                css.boxSizing(BoxSizing.BorderBox),
                css.borderRightWidth(px(1.0)),
                css.borderStyle(BorderStyle.Solid),
                css.borderColor(rgb(LINE)),
              ],
            ),
          ],
          &[
            head(
              h,
              12.0,
              &[
                label(h, "MESSAGES"),
                h.box(
                  &[mono(h, 11.0, 14.0), h.style(&[css.color(rgb(MUTED))])],
                  &[h.text(String.view(&count))],
                ),
              ],
            ),
            if shown == 0 {
              h.box(
                &[
                  ui(h, 12.0, 16.0),
                  h.style(&[css.paddingLeft(px(12.0)), css.paddingRight(px(12.0))]),
                ],
                &[ink(h, MUTED, "No messages yet. Use the app, then look here.")],
              )
            } else {
              h.column(
                &[
                  h.testId("messages"),
                  h.accessRole(Role.List),
                  h.style(
                    &[
                      css.flexGrow(1.0),
                      css.flexBasis(px(0.0)),
                      css.minHeight(px(0.0)),
                      css.overflowY(Overflow.Scroll),
                      css.overflowX(Overflow.Hidden),
                    ],
                  ),
                ],
                &[newestFirst(model, h)],
              )
            },
            h.column(
              &[
                ui(h, 11.0, 16.0),
                h.style(
                  &[
                    css.flexShrink(0.0),
                    css.rowGap(px(2.0)),
                    css.paddingTop(px(8.0)),
                    css.paddingBottom(px(8.0)),
                    css.paddingLeft(px(12.0)),
                    css.paddingRight(px(12.0)),
                    css.borderTopWidth(px(1.0)),
                    css.borderStyle(BorderStyle.Solid),
                    css.borderColor(rgb(LINE)),
                    css.color(rgb(MUTED)),
                  ],
                ),
              ],
              &[
                h.box(&[h.testId("program-line")], &[h.text(String.view(&model.line))]),
                h.row(
                  &[
                    h.testId("subscriptions"),
                    h.style(&[css.alignItems(Align.Center), css.columnGap(px(6.0))]),
                  ],
                  &[
                    h.box(
                      &[
                        h.style(
                          &[
                            css.flexGrow(1.0),
                            css.flexBasis(px(0.0)),
                            css.minWidth(px(0.0)),
                            css.color(rgb(FAINT)),
                          ],
                        ),
                      ],
                      &[
                        if model.subscriptions.length() == 0 {
                          h.text("No subscriptions")
                        } else {
                          h.fragment(
                            &[h.text("Subscribed to "), h.text(String.view(&model.subscribed))],
                          )
                        },
                      ],
                    ),
                    h.button(
                      &[
                        h.onClick(PanelMessage.Clear),
                        ui(h, 12.0, 16.0),
                        h.style(
                          &[
                            css.flexShrink(0.0),
                            css.paddingTop(px(2.0)),
                            css.paddingBottom(px(2.0)),
                            css.paddingLeft(px(8.0)),
                            css.paddingRight(px(8.0)),
                            css.borderRadius(px(4.0)),
                            css.color(rgb(MUTED)),
                          ],
                        ),
                        h.hover(&[css.color(rgb(TEXT)), css.backgroundColor(rgb(LINE))]),
                      ],
                      &[h.text("Clear")],
                    ),
                  ],
                ),
              ],
            ),
          ],
        ),
        modelView(model, h),
      ],
    )
  }
}

/// The app's side of the panel's view as a [`Backend`]: batches go out, event records come in.
/// A client's view has no viewport or layout here.
pub struct ViewBackend<'v> {
  pub view: &'v mut View,
}

impl<'v> Backend for ViewBackend<'v> {
  effect fn mutate(self: &mut Self, batch: List<Mutation>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    run self.view.send(batch.asSlice())
  }

  effect fn events(self: &mut Self, out: &mut List<Event>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.view.takeEvents(&mut out)
  }

  effect fn rootEvents(self: &mut Self, out: &mut List<RootEvent>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {}

  fn viewport(self: &Self, root: u32) -> Rect<f32> {
    return Rect<f32>.new(0.0, 0.0, 0.0, 0.0)
  }

  fn roots(self: &Self) -> RootSupport {
    return RootSupport.single()
  }

  effect fn measure(self: &Self, id: u32) -> Option<Measured>
    ! OutOfMemoryError
    ? &mut Allocator {
    return Option<Measured>.None
  }
}
