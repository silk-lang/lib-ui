#!/usr/bin/env node
// Regenerate committed byte literals; ordinary Silk builds require no generator.
import { readFileSync, readdirSync, writeFileSync } from 'node:fs';
import { dirname, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
const assets = resolve(root, 'assets');
const output = resolve(root, 'src/generated_assets.silk');
const files = ['fonts', 'icons', 'photos'].flatMap(folder => readdirSync(resolve(assets, folder))
  .filter(name => folder === 'fonts' ? name.endsWith('.ttf') : folder === 'icons' ? name.endsWith('.svg') : /\.(png|jpg)$/.test(name))
  .map(name => `${folder}/${name}`)).sort();
const lines = ['// Generated by scripts/embed-assets from modules/assets/assets; do not edit.'];
for (const file of files) {
  const words = file.replace(/\.[^.]+$/, '').replace(/[^0-9a-zA-Z]+/g, ' ').split(' ');
  const name = words[0].toLowerCase() + words.slice(1).map(word => word[0].toUpperCase() + word.slice(1)).join('');
  const literal = [...readFileSync(resolve(assets, file))].map(byte => byte >= 32 && byte < 127 && byte !== 34 && byte !== 92 ? String.fromCharCode(byte) : `\\x${byte.toString(16).padStart(2, '0')}`).join('');
  lines.push(`/// assets/${file}`, `pub fn ${name}() -> &'static [u8] { return b"${literal}" }`);
}
const text = lines.join('\n') + '\n';
if (process.argv.slice(2).some(arg => arg !== '--check')) throw new Error('Usage: node modules/assets/scripts/embed-assets [--check]');
if (process.argv.includes('--check')) {
  if (readFileSync(output, 'utf8') !== text) throw new Error(`${output} is stale; run node modules/assets/scripts/embed-assets`);
} else writeFileSync(output, text);
