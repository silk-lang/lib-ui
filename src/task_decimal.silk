import silk.cli.value { Arg, ArgValue }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.format { Format, ParseError }
import silk.num.f64

pub struct Decimal { pub value: f64 }
impl ArgValue for Decimal {
  fn takesValue() -> bool { return true }
  fn repeats() -> bool { return false }
  effect fn initial() -> Decimal ! OutOfMemoryError ? &mut Allocator {
    return Decimal { value: 0.0 }
  }
  effect fn accept(self: &mut Decimal, arg: Arg<'_>) -> bool
    ! OutOfMemoryError ? &mut Allocator {
    return match move Format.f64Value(arg.text) {
      Result<f64, ParseError>.Success { value } => {
        if !f64.isFinite(value) { return false }
        self.value = value
        true
      }
      Result<f64, ParseError>.Failure { .. } => false
    }
  }
}
