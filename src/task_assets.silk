import silk.cli.task { TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.usize
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { DirectoryEntry, FileError, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { String }
import task_support { require, rootPath }
pub import task_assets_photos { photos }

pub effect fn embed(check: bool) -> ()
  ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let assets = run rootPath("modules/assets/assets")
  let output = run rootPath("modules/assets/src/generated_assets.silk")
  let mut text = run Bytes.copy(b"// Generated by silk task embed-assets from modules/assets/assets; do not edit.\n")
  // These folders and each FileSystem listing are already in ascending path order.
  let folders = ["fonts", "icons", "photos"]
  let mut folderIndex: usize = 0
  while folderIndex < folders.length {
    let folder = folders[folderIndex]
    let directory = run Path.join(&assets, folder)
    let entries = run FileSystem.listDirectory(&directory)
    let children = List<DirectoryEntry>.asSlice(&entries)
    let mut index: usize = 0
    while index < children.length {
      let child = &children[index]
      let name = match Path.name(&child.path) {
        Option<string>.Some { value } => value
        Option<string>.None => {
          fail TaskError { message: run String.copy("asset filename is not UTF-8"), status: 1 }
        }
      }
      if included(folder, name) {
        let content = run FileSystem.readFile(&child.path)
        run Bytes.append(&mut text, b"/// assets/")
        run Bytes.append(&mut text, String.utf8Bytes(folder))
        run Bytes.append(&mut text, b"/")
        run Bytes.append(&mut text, String.utf8Bytes(name))
        run Bytes.append(&mut text, b"\npub fn ")
        run Bytes.append(&mut text, String.utf8Bytes(folder))
        run appendName(&mut text, name)
        run Bytes.append(&mut text, b"() -> &'static [u8] { return b\"")
        run appendLiteral(&mut text, Bytes.asSlice(&content))
        run Bytes.append(&mut text, b"\" }\n")
      }
      index = index + 1
    }
    folderIndex = folderIndex + 1
  }
  if check {
    let existing = run FileSystem.readFile(&output)
    run require(equal(Bytes.asSlice(&existing), Bytes.asSlice(&text)),
      "modules/assets/src/generated_assets.silk is stale; run silk task embed-assets")
  } else {
    run FileSystem.writeFile(&output, Bytes.asSlice(&text))
  }
  run embedPrelude(check)
}

/// The JavaScript every ui-js realm starts with and the `@silk/ui` package, as Silk byte
/// strings.
effect fn embedPrelude(check: bool) -> ()
  ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  run embedScript(check, "modules/js/src/prelude.js", "modules/js/src/generated_prelude.silk",
    b"// Generated by silk task embed-assets from modules/js/src/prelude.js; do not edit.\npub fn prelude",
    "modules/js/src/generated_prelude.silk is stale; run silk task embed-assets")
  run embedScript(check, "modules/js/packages/ui/src/index.js", "modules/js/src/generated_library.silk",
    b"// Generated by silk task embed-assets from modules/js/packages/ui/src/index.js; do not edit.\npub fn library",
    "modules/js/src/generated_library.silk is stale; run silk task embed-assets")
}

/// Writes the file at `from` to `to` as a function that returns its bytes. `head` is the
/// file's first line and the function's name.
effect fn embedScript(check: bool, from: string, to: string, head: &[u8], stale: string) -> ()
  ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let source = run rootPath(from)
  let output = run rootPath(to)
  let content = run FileSystem.readFile(&source)
  let mut text = run Bytes.copy(head)
  run Bytes.append(&mut text, b"() -> &'static [u8] { return b\"")
  run appendLiteral(&mut text, Bytes.asSlice(&content))
  run Bytes.append(&mut text, b"\" }\n")
  if check {
    let existing = run FileSystem.readFile(&output)
    run require(equal(Bytes.asSlice(&existing), Bytes.asSlice(&text)), stale)
  } else {
    run FileSystem.writeFile(&output, Bytes.asSlice(&text))
  }
}

fn included(folder: string, name: string) -> bool {
  if folder == "fonts" { return String.endsWith(name, ".ttf") }
  if folder == "icons" { return String.endsWith(name, ".svg") }
  return String.endsWith(name, ".png") || String.endsWith(name, ".jpg")
}

effect fn appendName(output: &mut Bytes, name: string) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let bytes = String.utf8Bytes(name)
  // Every accepted extension has four bytes, including its dot.
  let end = bytes.length - 4
  let mut capitalize = true
  let mut index: usize = 0
  while index < end {
    let mut value = bytes[index]
    if (value >= 48 && value <= 57) || (value >= 65 && value <= 90) || (value >= 97 && value <= 122) {
      if capitalize && value >= 97 && value <= 122 { value = value - 32 }
      run Bytes.append(&mut output, &[value])
      capitalize = false
    } else {
      capitalize = true
    }
    index = index + 1
  }
}

effect fn appendLiteral(output: &mut Bytes, bytes: &[u8]) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let digits = b"0123456789abcdef"
  let mut index: usize = 0
  let mut start: usize = 0
  while index < bytes.length {
    let value = bytes[index]
    if value < 32 || value >= 127 || value == 34 || value == 92 {
      run Bytes.append(&mut output, Slice.view<u8>(bytes, start, index - start))
      let high = digits[u8.toUsize(value / 16)]
      let low = digits[u8.toUsize(value % 16)]
      run Bytes.append(&mut output, &[92, 120, high, low])
      start = index + 1
    }
    index = index + 1
  }
  run Bytes.append(&mut output, Slice.view<u8>(bytes, start, bytes.length - start))
}

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut index: usize = 0
  while index < left.length {
    if left[index] != right[index] { return false }
    index = index + 1
  }
  return true
}
