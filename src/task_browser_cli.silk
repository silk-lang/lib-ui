import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.task { Task, TaskError, TaskSet }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileError, FileSystem }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { String }
import task_browser as Browser
import task_decimal { Decimal }
import task_browser_server as Server
static if Intrinsic.targetOperatingSystem() != "windows" {
  import task_browser_text { TextOptions, runText }
  import task_browser_tree { WindowOptions }
}
pub union Tasks {
  Check,
  CheckTree,
  Build { pub package: String, pub debug: bool },
  Serve { pub package: String, pub debug: bool, pub port: u16 },
  BrowserTreeServer { pub wasm: String, pub port: u16, pub tree: bool },
  Test { pub package: String, pub debug: bool, pub width: u32, pub height: u32, pub scale: Decimal, pub click: bool, pub clickX: Decimal, pub clickY: Decimal, pub typed: String, pub screenshot: String, pub stored: String, pub chromium: String },
  ChromeText { pub cli: String, pub chrome: String, pub tolerance: Decimal, pub blockTolerance: Decimal, pub only: String, pub cases: String, pub verbose: bool },
}
impl CommandLine for Tasks {
  static fn command() -> Command<Tasks> {
    return Command<Tasks>.make("browser-tasks", "WebAssembly builds, serving and Chromium verification")
      |> Command.variant("Check", "Compare Chrome text, GPU trees and real window input")
      |> Command.variant("CheckTree", "Compare browser trees with CPU references")
      |> Command.variant("Build", "Build WebAssembly with an 8 MiB stack")
      |> Command.variant("Serve", "Build and serve a browser application")
      |> Command.variant("BrowserTreeServer", "Serve an already-built wasm module")
      |> Command.variant("Test", "Exercise browser window rendering and input")
      |> Command.variant("ChromeText", "Compare text layout with Chromium")
      |> Command.option("package", Opt.about("Browser package directory") |> Opt.default("modules/tree/window/demo"))
      |> Command.option("port", Opt.about("Loopback HTTP port") |> Opt.default("8050"))
      |> Command.option("width", Opt.about("Viewport width") |> Opt.default("800"))
      |> Command.option("height", Opt.about("Viewport height") |> Opt.default("600"))
      |> Command.option("scale", Opt.about("Device scale") |> Opt.default("1"))
      |> Command.option("tolerance", Opt.about("Inline text tolerance") |> Opt.default("0.1"))
      |> Command.option("blockTolerance", Opt.about("Block text tolerance") |> Opt.default("0.5"))
  }
}
impl TaskSet for Tasks {
  effect fn perform(self: Tasks) -> ()
    ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    match move self {
      Tasks.Build { package, debug } => run Browser.printBrowserBuild(String.view(&package), !debug)
      Tasks.Serve { package, debug, port } => run Browser.serveBrowser(String.view(&package), !debug, port)
      Tasks.BrowserTreeServer { wasm, port, tree } => run Server.server(String.view(&wasm), port, tree)
      Tasks.Check => {
        static if Intrinsic.targetOperatingSystem() == "windows" { run unsupported() }
        else { run Browser.checkBrowser() }
      }
      Tasks.CheckTree => {
        static if Intrinsic.targetOperatingSystem() == "windows" { run unsupported() }
        else { run Browser.checkTreeBrowser() }
      }
      Tasks.Test { package, debug, width, height, scale, click, clickX, clickY, typed, screenshot, stored, chromium } => {
        static if Intrinsic.targetOperatingSystem() == "windows" {
          drop package
          drop debug
          drop width
          drop height
          drop scale
          drop click
          drop clickX
          drop clickY
          drop typed
          drop screenshot
          drop stored
          drop chromium
          run unsupported()
        } else {
          let options = WindowOptions { width: width, height: height, scale: scale.value, click: click,
            clickX: clickX.value, clickY: clickY.value, typed: String.view(&typed), screenshot: String.view(&screenshot), stored: String.view(&stored), chromium: String.view(&chromium) }
          run Browser.testBrowser(String.view(&package), !debug, move options)
        }
      }
      Tasks.ChromeText { cli, chrome, tolerance, blockTolerance, only, cases, verbose } => {
        static if Intrinsic.targetOperatingSystem() == "windows" {
          drop cli
          drop chrome
          drop tolerance
          drop blockTolerance
          drop only
          drop cases
          drop verbose
          run unsupported()
        } else {
          let options = TextOptions { cli: String.view(&cli), chrome: String.view(&chrome), tolerance: tolerance.value,
            blockTolerance: blockTolerance.value, only: String.view(&only), cases: String.view(&cases), verbose: verbose }
          run runText(&options)
        }
      }
    }
  }
}
static if Intrinsic.targetOperatingSystem() == "windows" {
  effect fn unsupported() -> never ! TaskError | OutOfMemoryError ? &mut Allocator {
    run Task.abort("Windows managed subprocess support is unavailable: https://github.com/silk-lang/silk/issues/3034")
  }
}
