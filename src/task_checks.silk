import silk.cli.task { Task, TaskError }
import silk.collections.bytes { Bytes }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { String }
import silk.num.usize
import task_support { build, pathText, repositoryRoot, require, rootPath }

pub effect fn packages() -> ()
  ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  run Task.silk(&["check", "--workspace"])
  let portable = ["modules/text", "modules/sprites", "modules/protocol", "modules/tree", "modules/app", "modules/app/examples", "modules/components", "modules/components/gallery", "modules/inspect", "modules/inspect/devtools"]
  let mut at: usize = 0
  while at < portable.length {
    let directory = run rootPath(portable[at])
    let manifest = run Path.join(&directory, "silk.toml")
    run Task.silk(&["check", "--manifest-path", pathText(&manifest), "--target", "wasm32-unknown-unknown"])
    at = at + 1
  }
}

pub effect fn unitTests() -> ()
  ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let members = ["modules/text", "modules/sprites", "modules/tree/tests", "modules/tree/window/tests", "modules/app/tests", "modules/app/window/tests", "modules/components/tests", "modules/inspect/tests", "modules/inspect/server/tests", "modules/inspect/devtools/tests", "docs/tests"]
  let mut at: usize = 0
  while at < members.length {
    let directory = run rootPath(members[at])
    let manifest = run Path.join(&directory, "silk.toml")
    run Task.silk(&["test", "--manifest-path", pathText(&manifest), "--root", "src/tests.silk"])
    at = at + 1
  }
}

/// The embedded JavaScript host. It stays out of the workspace because the SilkJS engine does
/// not build for Windows yet, so the Windows jobs never see it.
pub effect fn javascript() -> ()
  ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let library = run rootPath("modules/js")
  let libraryManifest = run Path.join(&library, "silk.toml")
  run Task.silk(&["check", "--manifest-path", pathText(&libraryManifest)])
  let tests = run rootPath("modules/js/tests")
  let testsManifest = run Path.join(&tests, "silk.toml")
  run Task.silk(&["test", "--manifest-path", pathText(&testsManifest), "--root", "src/tests.silk"])
}

pub effect fn goldens() -> ()
  ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let members = ["modules/tree/tests", "modules/app/tests", "modules/components/tests", "modules/inspect/tests", "modules/inspect/devtools/tests"]
  let mut at: usize = 0
  while at < members.length {
    let binary = run build(members[at], false, false)
    let directory = run rootPath(members[at])
    let golden = run Path.join(&directory, "goldens")
    run Task.exec(String.view(&binary), &[pathText(&golden)])
    at = at + 1
  }
}

pub effect fn tools() -> ()
  ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let members = ["modules/text/tools/cli", "modules/tree/tools/parity", "modules/inspect/cli", "modules/inspect/mcp"]
  let mut at: usize = 0
  while at < members.length {
    let _binary = run build(members[at], false, false)
    at = at + 1
  }
}

pub effect fn browserExports(check: bool) -> ()
  ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let native = run repositoryRoot("lib-native")
  let source = run Path.join(&native, "modules/gpu/webgpu/browser/generated_webgpu_exports.silk")
  // Silk's Git cache checks lib-native out with the host's line endings (CRLF on Windows runners),
  // while this repository's text is LF (.gitattributes): compare and write LF.
  let checkedOut = run FileSystem.readFile(&source)
  let bytes = run lineFeeds(Bytes.asSlice(&checkedOut))
  let destinations = ["modules/tree/browser/src/generated_webgpu_exports.silk", "modules/tree/window/demo/src/generated_webgpu_exports.silk"]
  let mut at: usize = 0
  while at < destinations.length {
    let target = run rootPath(destinations[at])
    if check {
      let existing = run FileSystem.readFile(&target)
      run require(equal(Bytes.asSlice(&bytes), Bytes.asSlice(&existing)), "Stale browser exports; run silk task generate-browser-exports")
    } else { run FileSystem.writeFile(&target, Bytes.asSlice(&bytes)) }
    at = at + 1
  }
}

effect fn lineFeeds(bytes: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut output = Bytes.make()
  let mut at: usize = 0
  while at < bytes.length {
    if !(bytes[at] == 13 && at + 1 < bytes.length && bytes[at + 1] == 10) { run Bytes.append(&mut output, &[bytes[at]]) }
    at = at + 1
  }
  return move output
}

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + 1
  }
  return true
}
