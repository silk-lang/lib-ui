import silk.cli.task { TaskError }
import silk.core.effect { Effect }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileError, FileSystem }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { String }
import task_support { build }
import task_browser_server { serve }

// The compiler profile sets an 8 MiB wasm stack. No generated clang shell wrapper is needed.
pub effect fn browserBuild(packagePath: string, release: bool) -> String
! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  return run build(packagePath, release, true)
}

pub effect fn printBrowserBuild(packagePath: string, release: bool) -> ()
! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let wasm = run browserBuild(packagePath, release)
  let mut stdout = StdoutWriter.make()
  run Writer.writeString(String.view(&wasm)) |> Effect.provideMut<Writer>(&mut stdout)
  run Writer.writeString("\n") |> Effect.provideMut<Writer>(&mut stdout)
}

pub effect fn serveBrowser(packagePath: string, release: bool, port: u16) -> ()
! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let wasm = run browserBuild(packagePath, release)
  run serve(String.view(&wasm), port)
}
static if Intrinsic.targetOperatingSystem() == "darwin" || Intrinsic.targetOperatingSystem() == "linux" {
import task_browser_text { TextOptions, runText }
import task_browser_tree { WindowOptions, treeTest, windowTest }

pub effect fn checkBrowser() -> ()
! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let cli = run build("modules/text/tools/cli", false, false)
  let options = TextOptions { cli: String.view(&cli), chrome: "", tolerance: 0.1,
    blockTolerance: 0.5, only: "", cases: "", verbose: false }
  run runText(&options)
  run checkTreeBrowser()
  let wasm = run browserBuild("modules/tree/window/demo", true)
  let windowOptions = WindowOptions { width: 400, height: 250, scale: 1.0, click: true,
    clickX: 90.0, clickY: 35.0, typed: "", screenshot: "", stored: "", chromium: "" }
  run windowTest(String.view(&wasm), move windowOptions)
}

pub effect fn checkTreeBrowser() -> ()
! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let wasm = run browserBuild("modules/tree/browser", true)
  run treeTest(String.view(&wasm))
}


pub effect fn testBrowser(packagePath: string, release: bool, options: WindowOptions<'_>) -> ()
! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let wasm = run browserBuild(packagePath, release)
  run windowTest(String.view(&wasm), move options)
}
}
