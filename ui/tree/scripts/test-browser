#!/usr/bin/env node
import { resolve } from 'node:path';
import { root } from '../../../scripts/internal.mjs';
import { browserBuild } from '../../../scripts/browser-build.mjs';
import { withDisplay, execute } from '../../../scripts/native-run.mjs';
const wasm = browserBuild('ui/tree/browser');
await withDisplay('x11', env => execute(process.execPath, [resolve(root, 'ui/tree/browser/test.mjs'), '--wasm', wasm], env, 1200000));
