#!/usr/bin/env node
import { demo } from '../../../../scripts/demo.mjs';
const mode = process.argv[2];
if (mode === 'inspect' || mode === 'mcp') {
  const { inspect, mcp } = await import('../../../../scripts/inspect-check.mjs');
  await (mode === 'inspect' ? inspect() : mcp());
} else await demo('ui/tree/demo');
