#!/usr/bin/env node
import { resolve } from 'node:path';
import { root } from '../../../../scripts/internal.mjs';
import { browserBuild } from '../../../../scripts/browser-build.mjs';
import { withDisplay, execute } from '../../../../scripts/native-run.mjs';
const argv = process.argv.slice(2);
const split = argv.indexOf('--');
const args = split < 0 ? argv : argv.slice(0, split);
const rest = split < 0 ? [] : argv.slice(split + 1);
const mode = args[0];
if (!['build', 'serve', 'test'].includes(mode)) throw new Error('Usage: browser build|serve|test [PACKAGE] [--debug] [--port PORT] [-- TEST OPTIONS]');
const packagePath = args[1] && !args[1].startsWith('--') ? resolve(args[1]) : 'ui/tree/window/demo';
const wasm = browserBuild(packagePath, { release: !args.includes('--debug') });
if (mode === 'build') console.log(wasm);
else if (mode === 'serve') {
  const { serve } = await import('../browser/serve.mjs');
  const port = args.indexOf('--port');
  const server = await serve(wasm, port < 0 ? 8050 : Number(args[port + 1]));
  console.log('App: http://127.0.0.1:' + server.address().port + '/');
} else await withDisplay('x11', env => execute(process.execPath, [resolve(root, 'ui/tree/window/browser/test.mjs'), '--wasm', wasm, ...rest], env, 1200000));
