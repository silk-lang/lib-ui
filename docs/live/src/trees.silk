  effect fn pump(self: &mut Self, state: &mut FieldClientState, tree: &mut UiTree<'_>) -> ()
    ! EngineError | OutOfMemoryError
    ? &mut Allocator {
    run Effect.catch<TreeError>(pumpFieldClient(&mut state, &mut tree), ignored)
  }
}

// The remote client of the protocol page: its first batch is what the host applies before
// anything else, and a click on its button is answered with the batch it would send next.

pub struct RemoteState {
  pub answered: bool,
}

pub struct RemoteClient {}

impl WindowClient<RemoteState, never, never> for RemoteClient {
  effect fn start(self: &mut Self, state: &mut RemoteState, tree: &mut UiTree<'_>) -> ()
    ! EngineError | OutOfMemoryError
    ? &mut Allocator {}

  effect fn pump(self: &mut Self, state: &mut RemoteState, tree: &mut UiTree<'_>) -> ()
    ! EngineError | OutOfMemoryError
    ? &mut Allocator {
    let mut events = List<Event>.make()
    run tree.takeEvents(&mut events)
    let all = events.asSlice()
    let mut i: usize = 0
    while i < all.length {
      if all[i].kind == EventKind.Click && all[i].target == remote.BUTTON && !state.answered {
        state.answered = true
        run tree.apply(run remote.sent())
      }
      i = i + 1
    }
  }
}
