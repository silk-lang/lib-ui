  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut tree = run Tree.borrowing(&mut engine)
  if let Option<Greeting>.Some { value } = &mut state.built {
    run value.pump(&mut tree)
  }
  tree.giveBack(&mut engine)
}

pub struct FieldClient {}

impl WindowClient<FieldClientState, never, never> for FieldClient {
  effect fn start(self: &mut Self, state: &mut FieldClientState, tree: &mut UiTree<'_>) -> ()
