//! The tree guide's examples in the window host. They are written against `Tree`, and the
//! host hands its client the engine under it. So each client here borrows the engine as a
//! `Tree` for the length of a call (`Tree.borrowing`), runs the example's own code, and gives
//! it back.
import examples.tree.card as card
import examples.tree.clicker as clicker
import examples.tree.clicker { Clicker }
import examples.tree.field as field
import examples.tree.field { Greeting }
import examples.tree.remote as remote
import ui_tree.legacy { TreeError as EngineError, UiTree }
import ui_tree.lib { Tree, TreeError }
import ui_tree.node { Event, EventKind }
import ui_tree_window.host { WindowClient }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

const SANS: string<'static> = "Noto Sans, sans-serif"

/// An example cannot fail here in a way the page could answer: the picture it replaced is
/// drawn by the same code.
effect fn ignored(error: TreeError) -> () {
  drop error
}

// The card of the nodes page.

pub struct CardClientState {
  pub built: Option<card.Card>,
}

effect fn startCardClient(state: &mut CardClientState, engine: &mut UiTree<'_>) -> ()
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut tree = run Tree.borrowing(&mut engine)
  let sans = run tree.fontFamily(SANS)
  state.built = Option<card.Card>.Some { value: run card.build(&mut tree, sans) }
  tree.giveBack(&mut engine)
}

pub struct CardClient {}

impl WindowClient<CardClientState, never, never> for CardClient {
  effect fn start(self: &mut Self, state: &mut CardClientState, tree: &mut UiTree<'_>) -> ()
    ! EngineError | OutOfMemoryError
    ? &mut Allocator {
    run Effect.catch<TreeError>(startCardClient(&mut state, &mut tree), ignored)
  }
}

// The counter of the events page.

pub struct ClickerClientState {
  pub built: Option<Clicker>,
}

effect fn startClickerClient(state: &mut ClickerClientState, engine: &mut UiTree<'_>) -> ()
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut tree = run Tree.borrowing(&mut engine)
  let sans = run tree.fontFamily(SANS)
  state.built = Option<Clicker>.Some { value: run clicker.build(&mut tree, sans) }
  tree.giveBack(&mut engine)
}

effect fn pumpClickerClient(state: &mut ClickerClientState, engine: &mut UiTree<'_>) -> ()
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut tree = run Tree.borrowing(&mut engine)
  if let Option<Clicker>.Some { value } = &mut state.built {
    run value.pump(&mut tree)
  }
  tree.giveBack(&mut engine)
}

pub struct ClickerClient {}

impl WindowClient<ClickerClientState, never, never> for ClickerClient {
  effect fn start(self: &mut Self, state: &mut ClickerClientState, tree: &mut UiTree<'_>) -> ()
    ! EngineError | OutOfMemoryError
    ? &mut Allocator {
    run Effect.catch<TreeError>(startClickerClient(&mut state, &mut tree), ignored)
  }

  effect fn pump(self: &mut Self, state: &mut ClickerClientState, tree: &mut UiTree<'_>) -> ()
    ! EngineError | OutOfMemoryError
    ? &mut Allocator {
    run Effect.catch<TreeError>(pumpClickerClient(&mut state, &mut tree), ignored)
  }
}

