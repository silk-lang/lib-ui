//! The docs' window examples on a WebGPU canvas: the same programs, with a canvas in the page
//! as their window. One module holds them all, and the page says which one to run.
//!
//! What differs from `docs/examples/apps` is what a page cannot give: there are no system
//! fonts, so the fonts come with the module, and there are no files, so Pad's `Disk` keeps
//! its one note in memory.
import examples.core.counter { Counter, Message as CounterMessage }
import examples.native.pad { Command as PadCommand, Disk, Message as PadMessage, Pad }
import examples.native.swatches { Message as SwatchesMessage, Swatches }
import window_client.client { Client, Counter as Clicks }
import generated_webgpu_exports as _generated_webgpu_exports
import libm as _libm
import ui_app.lib { NoCommand, Shell }
import ui_app_window.program { Launched, Window, failed, show }
import ui_fixtures.fixtures as fixtures
import ui_inspect_server.lib { Inspector }
import ui_tree.legacy { Mutation, TreeError }
import ui_tree_window.host { RunOptions, runWindow }
import atlas.atlas { AtlasError }
import vector.geometry_error { GeometryError }
import webgpu.runtime { GpuError }
import window.types { WindowError }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

/// The fonts that come with the module, as family 1.
const SANS: string<'static> = "Noto Sans, sans-serif"

static if Intrinsic.targetArchitecture() == "wasm32" {
  /// Which example the page asked for: `live/index.html` answers from its address.
  unsafe extern "C" fn hostApp() -> u32 as "docs#app"

  fn asked() -> u32 {
    return unsafe hostApp()
  }
} else {
  /// Off the page there is nobody to ask. The module is built for wasm32 only, and this is
  /// here so the workspace's checks cover it on every target.
  fn asked() -> u32 {
    return 0
  }
}

effect fn hello() -> i32
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut window = run Window.make("Counter", 360.0, 160.0)
  run window.font(1, SANS)
  let fonts = run fixtures.fonts()
  return run show<Counter, CounterMessage, NoCommand, never>(
    move window,
    &fonts,
    Option<Launched>.None,
  )
}

/// One note, kept while the page is open: what stands in for the machine's files.
struct Note {
  text: String,
}

impl Disk for Note {
  effect fn read(self: &mut Self, path: string) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    drop path
    return run String.copy(String.view(&self.text))
  }

  effect fn write(self: &mut Self, path: string, text: string) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    drop path
    self.text = run String.copy(text)
    return true
  }
}

effect fn pad() -> i32
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut window = run Window.make("Pad", 640.0, 440.0)
  run window.font(1, SANS)
  let mut shell = window.shell()
  let mut note = Note { text: String.make() }
  let fonts = run fixtures.fonts()
  return run show<Pad, PadMessage, PadCommand, &mut Shell | &mut Disk | &mut Allocator>(
    move window,
    &fonts,
    Option<Launched>.None,
  )
    |> Effect.provideMut<Shell>(&mut shell)
    |> Effect.provideMut<Disk>(&mut note)
}

effect fn swatches() -> i32
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut window = run Window.make("Swatches", 320.0, 180.0)
  run window.font(1, SANS)
  let fonts = run fixtures.fonts()
  return run show<Swatches, SwatchesMessage, NoCommand, never>(
    move window,
    &fonts,
    Option<Launched>.None,
  )
}

/// The tree guide's window client, handed to the window host.
effect fn clicks() -> i32
  ! TreeError | WindowError | GpuError | AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut state = Clicks { clicks: 0 }
  let mut client = Client {}
  let options = RunOptions {
    title: "Tree counter",
    width: 400.0,
    height: 250.0,
    check: false,
    checkClick: "",
    checkExpect: "",
    lowestLatency: false,
    platform: Option<Launched>.None,
  }
  return run runWindow(
    &mut state,
    &fonts,
    List<Mutation>.make(),
    move options,
    Inspector.off(),
    &mut client,
  )
}

effect fn chosen(app: u32) -> i32
  ! TreeError | WindowError | GpuError | AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  return if app == 1 {
    run pad()
  } else if app == 2 {
    run swatches()
  } else if app == 3 {
    run clicks()
  } else {
    run hello()
  }
}

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(chosen(asked()), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}
