//! The album in a page. The program is the same as in the window; the page gives it its photos,
//! icons and fonts as files the browser loads (see `web/index.html`).
import examples.core.album { Album, Message }
import ui_app.lib { NoCommand }
import ui_app_dom.page
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator }

// The page calls these, so they only exist in the WebAssembly build.
static if Intrinsic.targetArchitecture() == "wasm32" {
  /// Called once, when the page loads the program.
  export "C" fn open() -> ?*mut u8 as "silk_ui_open" {
    let mut allocator = Allocator.systemAllocatorProvider()
    return run Effect.catchAll(page.open<Album, Message, NoCommand>(), page.unopened)
      |> Effect.provideMut<Allocator>(&mut allocator)
  }

  /// Called for everything after that: an event, a timer, a new location.
  export "C" fn call(token: ?*mut u8, op: u32, a: f64, b: f64, c: f64) -> f64 as "silk_ui_call" {
    let mut allocator = Allocator.systemAllocatorProvider()
    return run Effect.catchAll(page.call<Album, Message, NoCommand>(token, op, a, b, c), page.failed)
      |> Effect.provideMut<Allocator>(&mut allocator)
  }
}

pub fn main() -> i32 {
  return 0
}
