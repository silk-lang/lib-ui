//! A counter in a native window, on the tree alone: no framework. The window host owns the
//! window, the GPU, the input and the frames, and calls the client at two moments: `start`
//! to build the tree, and `pump` after input to answer its events.
//!
//! The host hands the client the tree's engine, `UiTree`, so the client speaks the mutation
//! protocol: a `Batch` of mutations with node numbers of its own.
import ui_fixtures.fixtures as fixtures
import ui_inspect_server.lib { Inspector }
import ui_tree.css
import ui_tree.css { px, percent, Keyword }
import ui_tree.legacy { Attribute, Batch, Mutation, NodeKind, TreeError, UiTree }
import ui_tree.mutation { Align, Role, StyleState, LISTEN_CLICK }
import ui_tree.node { Event, EventKind }
import ui_tree_window.console { StderrWriter }
import ui_tree_window.host { RunOptions, WindowClient, runWindow }
import ui_tree_window.platform_thread { Launched, launch }
import atlas.atlas { AtlasError }
import vector.geometry_error { GeometryError }
import webgpu.runtime { GpuError }
import window.types { WindowError }
import silk.collections.list { List }
import silk.color.rgba { Rgba }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

// The client's node numbers.
const ROOT: u32 = 1

const BUTTON: u32 = 2

const LABEL: u32 = 3

/// What the client remembers between calls.
struct Counter {
  clicks: u32,
}

struct Client {}

impl WindowClient<Counter, never, never> for Client {
  /// Called once, before the first frame.
  effect fn start(self: &mut Self, state: &mut Counter, tree: &mut UiTree<'_>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut batch = Batch.make()
    run batch.fontFamily(1, "Noto Sans, sans-serif")
    run batch.create(ROOT, NodeKind.Box)
    run batch.style(
      ROOT,
      &[
        css.display(Keyword.Flex),
        css.height(percent(100.0)),
        css.alignItems(Align.Center),
        css.justifyContent(Align.Center),
        css.fontFamily(1),
        css.fontSize(px(18.0)),
      ],
    )
    run batch.root(ROOT)
    run batch.box(
      ROOT,
      BUTTON,
      &[
        css.padding(px(12.0)),
        css.borderRadius(px(10.0)),
        css.color(Rgba<f32> { r: 1.0, g: 1.0, b: 1.0, a: 1.0 }),
        css.backgroundColor(Rgba<f32> { r: 0.06, g: 0.46, b: 0.43, a: 1.0 }),
      ],
    )
    run batch.styleFor(
      BUTTON,
      StyleState.Hover,
      &[css.backgroundColor(Rgba<f32> { r: 0.05, g: 0.37, b: 0.35, a: 1.0 })],
    )
    run batch.attribute(BUTTON, Attribute.Role { value: Role.Button })
    run batch.attribute(BUTTON, Attribute.TabIndex { value: 0 })
    run batch.listen(BUTTON, LISTEN_CLICK)
    run batch.text(BUTTON, LABEL, "Click me")
    run tree.apply(run batch.take())
  }

  /// Called after input reached the tree: take its events and answer them.
  effect fn pump(self: &mut Self, state: &mut Counter, tree: &mut UiTree<'_>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut events = List<Event>.make()
    run tree.takeEvents(&mut events)
    let all = events.asSlice()
    let mut i: usize = 0
    while i < all.length {
      if all[i].kind == EventKind.Click && all[i].target == BUTTON {
        state.clicks = state.clicks + 1
        let mut batch = Batch.make()
        run batch.setText(
          LABEL,
          if state.clicks == 1 {
            "Clicked once"
          } else {
            "Clicked again"
          },
        )
        run tree.apply(run batch.take())
      }
      i = i + 1
    }
  }
}

effect fn counter(platform: Option<Launched>) -> i32
  ! TreeError | WindowError | GpuError | AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut state = Counter { clicks: 0 }
  let mut client = Client {}
  let options = RunOptions {
    title: "Tree counter",
    width: 400.0,
    height: 250.0,
    check: false,
    checkClick: "",
    checkExpect: "",
    lowestLatency: false,
    platform: move platform,
  }
  return run runWindow(
    &mut state,
    &fonts,
    List<Mutation>.make(),
    move options,
    Inspector.off(),
    &mut client,
  )
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  StderrWriter.print("tree-window: the window could not be shown\n", &())
  return 2
}

fn app(platform: Option<Launched>) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(counter(move platform), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()

  // The main thread keeps the system's event loop. The client runs on a thread of its own.
  return run Effect.catchAll(
    launch(
      fn(platform: Option<Launched>) -> i32 {
        return app(move platform)
      },
    ),
    failed,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}
