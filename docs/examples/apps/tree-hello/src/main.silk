//! The smallest whole program on the UI tree: it builds three nodes, asks for one frame, and
//! writes the picture to `hello.png`. No window, no GPU.
import ui_assets.assets
import ui_tree.css
import ui_tree.css { px, percent, Keyword }
import ui_tree.inspect { CpuSnapshot, encodePng }
import ui_tree.lib { Align, Tree, TreeError, Viewport }
import codec.image { ImageError }
import font_collection.lib { FontCollection }
import vector.geometry_error { GeometryError }
import silk.collections.bytes { Bytes }
import silk.color.rgba { Rgba }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.system.host_input { HostInput, HostInputError }

effect fn draw() -> i32
  ! TreeError | GeometryError | ImageError | FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  // 1. Fonts. The tree shapes text with the fonts of a collection it borrows.
  let mut fonts = FontCollection.make()
  let mut font = Bytes.make()
  run font.append(assets.regularFont())
  drop run fonts.add(move font)

  // 2. Nodes. A box as tall as the viewport, a box in its middle, and a text in that.
  let mut tree = run Tree.make(&fonts)
  let sans = run tree.fontFamily("Noto Sans, sans-serif")
  let page = run tree.box(
    &[
      css.display(Keyword.Flex),
      css.height(percent(100.0)),
      css.alignItems(Align.Center),
      css.justifyContent(Align.Center),
      css.fontFamily(sans.raw()),
      css.fontSize(px(28.0)),
      css.backgroundColor(Rgba<f32> { r: 0.94, g: 0.99, b: 0.98, a: 1.0 }),
    ],
  )
  let badge = run tree.box(
    &[
      css.padding(px(20.0)),
      css.borderRadius(px(16.0)),
      css.color(Rgba<f32> { r: 1.0, g: 1.0, b: 1.0, a: 1.0 }),
      css.backgroundColor(Rgba<f32> { r: 0.06, g: 0.46, b: 0.43, a: 1.0 }),
    ],
  )
  let words = run tree.text("Hello, tree")
  run tree.append(badge, words)
  run tree.append(page, badge)
  run tree.setRoot(page)

  // 3. A frame: style, layout and paint, for a viewport of 480 by 240 at two device pixels
  // per pixel.
  drop run tree.frame(Viewport { width: 480.0, height: 240.0, scale: 2.0 }, 0.0)

  // 4. Pixels. A window would hand the frame's scene to the GPU; this draws it on the CPU.
  let mut snapshot = CpuSnapshot.make()
  run snapshot.sync(tree.engineMut())
  let pixels = run snapshot.render(tree.engine())
  let file = run encodePng(&pixels)

  // 5. The file, in the directory the program was started in.
  let directory = run Path.fromBytes(Bytes.asSlice(&run HostInput.workingDirectory()))
  let place = run Path.join(&directory, "hello.png")
  let mut files = run MachineFileSystem.make()
  run FileSystem.writeFile(&place, Bytes.asSlice(&file))
    |> Effect.provideMut<FileSystem>(&mut files)
  return 0
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  return 1
}

pub effect fn main() -> i32
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(draw(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}
