//! Swatches in native windows. Nothing here knows about the second window: the program
//! declares it, and the host opens an OS window for it.
import examples.native.swatches { Message, Swatches }
import ui_app.lib { NoCommand }
import ui_app_window.program { Launched, Window, failed, launch, show, systemFonts }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

effect fn swatches(platform: Option<Launched>) -> i32
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut window = run Window.make("Swatches", 320.0, 180.0)
  run window.font(1, "system-ui, sans-serif")
  let fonts = run systemFonts()
  return run show<Swatches, Message, NoCommand, never>(move window, &fonts, move platform)
}

fn app(platform: Option<Launched>) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(swatches(move platform), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

pub fn main() -> i32 {
  return launch(
    fn(platform: Option<Launched>) -> i32 {
      return app(move platform)
    },
  )
}
