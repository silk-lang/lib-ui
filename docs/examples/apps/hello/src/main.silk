//! The counter from the Silk UI guide, in a native window. The program is unchanged: this
//! file is everything a window needs besides it.
import examples.core.counter { Counter, Message }
import ui_app.lib { NoCommand }
import ui_app_window.program { Launched, Window, failed, launch, show, systemFonts }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// Font family 1: the family the program's text is drawn in. A style names a family by its
/// number, `css.fontFamily(1)`, and the window says which fonts that is.
const SANS: u32 = 1

/// Opens the window and runs the program in it until the window closes.
effect fn counter(platform: Option<Launched>) -> i32
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut window = run Window.make("Counter", 360.0, 160.0)
  run window.font(SANS, "system-ui, sans-serif")
  let fonts = run systemFonts()
  return run show<Counter, Message, NoCommand, never>(move window, &fonts, move platform)
}

/// The app, on the thread `launch` made for it.
fn app(platform: Option<Launched>) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(counter(move platform), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

pub fn main() -> i32 {
  // The main thread keeps the system's event loop. The app runs on a thread of its own.
  return launch(
    fn(platform: Option<Launched>) -> i32 {
      return app(move platform)
    },
  )
}
