//! The dice program in a page. This file is everything a browser needs besides the program:
//! the service its commands ask for, and the two functions the page calls.
import examples.core.dice { Command, Dice, Message, Random }
import ui_app_dom.page
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator }
import silk.num.f64
import silk.num.u32

// Everything here is for a page, so it only exists in the WebAssembly build.
static if Intrinsic.targetArchitecture() == "wasm32" {
  /// `Math.random`, which `web/index.html` passes to `mount` as `app.random`.
  unsafe extern "C" fn hostRandom() -> f64 as "app#random"

  /// The die of a page.
  struct PageRandom {}

  impl Random for PageRandom {
    effect fn roll(self: &mut Self, sides: u32) -> u32 {
      let face = f64.toU32(unsafe hostRandom() * u32.toF64(sides)) + 1
      return if face > sides {
        sides
      } else {
        face
      }
    }
  }

  /// Called once, when the page loads the program.
  export "C" fn open() -> ?*mut u8 as "silk_ui_open" {
    let mut allocator = Allocator.systemAllocatorProvider()
    return run Effect.catchAll(page.open<Dice, Message, Command>(), page.unopened)
      |> Effect.provideMut<Allocator>(&mut allocator)
  }

  /// Called for everything after that: an event, a timer, a new location.
  export "C" fn call(token: ?*mut u8, op: u32, a: f64, b: f64, c: f64) -> f64 as "silk_ui_call" {
    let mut allocator = Allocator.systemAllocatorProvider()
    let mut random = PageRandom {}
    return run Effect.catchAll(page.call<Dice, Message, Command>(token, op, a, b, c), page.failed)
      |> Effect.provideMut<Random>(&mut random)
      |> Effect.provideMut<Allocator>(&mut allocator)
  }
}

pub fn main() -> i32 {
  return 0
}
