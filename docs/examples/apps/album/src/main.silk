//! The album in a native window. The program names its pictures and fonts by URL;
//! `files.silk` builds those files into the program.
import examples.core.album { Album, Message }
import files
import ui_app.lib { NoCommand }
import ui_app_window.program { Launched, Window, failed, launch, show, systemFonts }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

effect fn album(platform: Option<Launched>) -> i32
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut window = run Window.make("Album", 640.0, 420.0)

  // The photos, icons and fonts, for the URLs the album names.
  run files.carry(&mut window)
  let fonts = run systemFonts()

  return run show<Album, Message, NoCommand, never>(move window, &fonts, move platform)
}

fn app(platform: Option<Launched>) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(album(move platform), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

pub fn main() -> i32 {
  return launch(
    fn(platform: Option<Launched>) -> i32 {
      return app(move platform)
    },
  )
}
