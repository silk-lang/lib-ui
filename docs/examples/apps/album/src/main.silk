//! The album in a native window. The program names its pictures and fonts by number; this file
//! says what each number is, from the files `files.silk` builds into the program.
import examples.core.album { Album, DISPLAY, HEART, LABEL, Message, PHOTO, SEARCH }
import files
import ui_app.lib { NoCommand }
import ui_app_window.program { Launched, Window, failed, launch, show, systemFonts }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

effect fn album(platform: Option<Launched>) -> i32
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut window = run Window.make("Album", 640.0, 420.0)

  // Images: photo `i` is resource `PHOTO + i`. The window decodes PNG and JPEG files.
  let mut i: u32 = 0
  while i < files.PHOTOS {
    run window.image(PHOTO + i, files.photo(i))
    i = i + 1
  }
  // Icons are SVG files. They are drawn in the color of the text around them.
  run window.icon(HEART, files.heart())
  run window.icon(SEARCH, files.search())

  // Font families: what `css.fontFamily(n)` stands for, as a CSS font-family list.
  run window.font(1, "system-ui, sans-serif")
  run window.font(DISPLAY, "Geist, system-ui, sans-serif")
  run window.font(LABEL, "Geist Mono, monospace")

  // The fonts the families find: the ones on this machine, and the two the album ships.
  let mut fonts = run systemFonts()
  drop run fonts.add(run Bytes.copy(files.geist()))
  drop run fonts.add(run Bytes.copy(files.geistMono()))

  return run show<Album, Message, NoCommand, never>(move window, &fonts, move platform)
}

fn app(platform: Option<Launched>) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(album(move platform), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

pub fn main() -> i32 {
  return launch(
    fn(platform: Option<Launched>) -> i32 {
      return app(move platform)
    },
  )
}
