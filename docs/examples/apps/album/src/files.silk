//! The files behind the album's numbers, from `assets/` beside `silk.toml`. They are part of the
//! program: `Source.read` makes each file's bytes a constant when the package compiles, so
//! there is nothing to ship beside it.
import examples.core.album { COUNT }
import silk.build.source { Source }

/// The PNG or JPEG file of photo `index`.
pub fn photo(index: u32) -> &'static [u8] {
  return match index {
    0 => Source.read("assets/photos/dusk.png")
    1 => Source.read("assets/photos/meadow.jpg")
    2 => Source.read("assets/photos/moonrise.png")
    3 => Source.read("assets/photos/ember.jpg")
    4 => Source.read("assets/photos/snowline.png")
    5 => Source.read("assets/photos/canyon.jpg")
    6 => Source.read("assets/photos/night-walk.png")
    7 => Source.read("assets/photos/glacier.jpg")
    8 => Source.read("assets/photos/lagoon.png")
    9 => Source.read("assets/photos/red-ridge.jpg")
    10 => Source.read("assets/photos/violet-hour.png")
    _ => Source.read("assets/photos/mist.jpg")
  }
}

/// The heart, an SVG. Its shapes are filled; the color comes from the text color.
pub fn heart() -> &'static [u8] {
  return Source.read("assets/icons/heart.svg")
}

/// The magnifier, an SVG drawn with strokes.
pub fn search() -> &'static [u8] {
  return Source.read("assets/icons/search.svg")
}

/// Geist, a variable font: one file has every weight from 100 to 900.
pub fn geist() -> &'static [u8] {
  return Source.read("assets/fonts/Geist.ttf")
}

/// Geist Mono, for labels and numbers.
pub fn geistMono() -> &'static [u8] {
  return Source.read("assets/fonts/GeistMono.ttf")
}

/// How many photos there are.
pub const PHOTOS: u32 = COUNT
