//! The files the album names by URL, from `assets/` beside `silk.toml`. They are part of the
//! program: `Source.read` makes each file's bytes a constant when the package compiles, so
//! there is nothing to ship beside it.
import ui_app_window.program { Window }
import silk.build.source { Source }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// Serves the photos, icons and fonts for the relative URLs the album names
/// (`"photos/dusk.png"`, `"fonts/Geist.ttf"`).
pub effect fn carry(window: &mut Window) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run window.file("photos/dusk.png", Source.read("assets/photos/dusk.png"))
  run window.file("photos/meadow.jpg", Source.read("assets/photos/meadow.jpg"))
  run window.file("photos/moonrise.png", Source.read("assets/photos/moonrise.png"))
  run window.file("photos/ember.jpg", Source.read("assets/photos/ember.jpg"))
  run window.file("photos/snowline.png", Source.read("assets/photos/snowline.png"))
  run window.file("photos/canyon.jpg", Source.read("assets/photos/canyon.jpg"))
  run window.file("photos/night-walk.png", Source.read("assets/photos/night-walk.png"))
  run window.file("photos/glacier.jpg", Source.read("assets/photos/glacier.jpg"))
  run window.file("photos/lagoon.png", Source.read("assets/photos/lagoon.png"))
  run window.file("photos/red-ridge.jpg", Source.read("assets/photos/red-ridge.jpg"))
  run window.file("photos/violet-hour.png", Source.read("assets/photos/violet-hour.png"))
  run window.file("photos/mist.jpg", Source.read("assets/photos/mist.jpg"))
  // Icons are SVG files. They are drawn in the color of the text around them.
  run window.file("icons/heart.svg", Source.read("assets/icons/heart.svg"))
  run window.file("icons/search.svg", Source.read("assets/icons/search.svg"))
  // Geist is a variable font: one file has every weight from 100 to 900.
  run window.file("fonts/Geist.ttf", Source.read("assets/fonts/Geist.ttf"))
  run window.file("fonts/GeistMono.ttf", Source.read("assets/fonts/GeistMono.ttf"))
}
