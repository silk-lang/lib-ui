//! The look the examples share: a few colors, a button and a text field. Each is a plain
//! function that works for any message type.
import ui_app.css
import ui_app.css { px, BorderStyle }
import ui_app.lib { Attr, Document, Node }
import silk.color.rgba { Rgba }
import silk.num.u32

/// A color from its hex code: `rgb(0x0F766E)`.
pub fn rgb(hex: u32) -> Rgba<f32> {
  let r = u32.toF32(u32.bitAnd(u32.shiftRight(hex, 16), 255)) / 255.0
  let g = u32.toF32(u32.bitAnd(u32.shiftRight(hex, 8), 255)) / 255.0
  let b = u32.toF32(u32.bitAnd(hex, 255)) / 255.0
  return Rgba<f32> { r: r, g: g, b: b, a: 1.0 }
}

pub const INK: u32 = 0x1F2937

pub const MUTED: u32 = 0x6B7280

pub const LINE: u32 = 0xD1D5DB

pub const ACCENT: u32 = 0x0F766E

/// The style every button starts from. `filled` is for the one action that matters most.
pub fn buttonLook<M>(h: &Document<M>, filled: bool) -> Attr {
  let base = h.style(
    &[
      css.paddingTop(px(6.0)),
      css.paddingBottom(px(6.0)),
      css.paddingLeft(px(14.0)),
      css.paddingRight(px(14.0)),
      css.borderWidth(px(1.0)),
      css.borderStyle(BorderStyle.Solid),
      css.borderRadius(px(8.0)),
      css.borderColor(rgb(LINE)),
      css.backgroundColor(rgb(0xFFFFFF)),
      css.color(rgb(INK)),
    ],
  )
  if filled {
    return h.attrs(
      &[
        base,
        h.style(
          &[
            css.backgroundColor(rgb(ACCENT)),
            css.borderColor(rgb(ACCENT)),
            css.color(rgb(0xFFFFFF)),
          ],
        ),
        h.hover(&[css.backgroundColor(rgb(0x0D5F58))]),
        h.focusVisible(&[css.borderColor(rgb(INK))]),
      ],
    )
  }
  return h.attrs(
    &[
      base,
      h.hover(&[css.backgroundColor(rgb(0xF3F4F6))]),
      h.active(&[css.backgroundColor(rgb(0xE5E7EB))]),
      h.focusVisible(&[css.borderColor(rgb(ACCENT))]),
    ],
  )
}

/// A button that sends `message` when it is clicked.
pub fn button<M>(h: &Document<M>, label: string, message: M) -> Node {
  return h.button(&[h.onClick(move message), buttonLook<M>(h, false)], &[h.text(label)])
}

/// The button for the main action of a view.
pub fn primary<M>(h: &Document<M>, label: string, message: M) -> Node {
  return h.button(&[h.onClick(move message), buttonLook<M>(h, true)], &[h.text(label)])
}

/// The border and padding of a text field.
pub fn fieldLook<M>(h: &Document<M>) -> Attr {
  return h.attrs(
    &[
      h.style(
        &[
          css.minWidth(px(0.0)),
          css.paddingTop(px(6.0)),
          css.paddingBottom(px(6.0)),
          css.paddingLeft(px(10.0)),
          css.paddingRight(px(10.0)),
          css.borderWidth(px(1.0)),
          css.borderStyle(BorderStyle.Solid),
          css.borderRadius(px(8.0)),
          css.borderColor(rgb(LINE)),
          css.backgroundColor(rgb(0xFFFFFF)),
          css.color(rgb(INK)),
        ],
      ),
      h.focused(&[css.borderColor(rgb(ACCENT))]),
    ],
  )
}
