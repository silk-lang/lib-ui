//! Two pages and a page that is not there: the address is state, like anything else.
import core.look { ACCENT, INK, MUTED, button, rgb }
import ui_app.css
import ui_app.css { px }
import ui_app.lib { Document, Node, NoCommand, NoOutput, Program, Subscriptions, Update }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// Where the program is.
pub enum Route {
  Home,
  About,
  NotFound,
}

/// The route of a path. Parsing is a plain function, so it is easy to test.
pub fn routeOf(path: string) -> Route {
  if path == "/" {
    return Route.Home
  }
  if path == "/about" {
    return Route.About
  }
  return Route.NotFound
}

pub struct Pages {
  pub route: Route,
}

pub union Message {
  ChangedLocation { pub route: Route },
  ClickedBackHome,
}

type Next = Update<Pages, NoCommand, NoOutput>

impl Program<Message, NoCommand> for Pages {
  effect fn init() -> Next
    ! OutOfMemoryError
    ? &mut Allocator {
    return Next.of(Pages { route: Route.Home })
  }

  effect fn update(mut model: Pages, message: Message) -> Next
    ! OutOfMemoryError
    ? &mut Allocator {
    match move message {
      Message.ChangedLocation { route } => {
        model.route = route
      }
      Message.ClickedBackHome => {
        // An update may move the location itself. The subscription below hears of it next.
        return run Next.of(move model).navigating("/")
      }
    }
    return Next.of(move model)
  }

  fn view(model: &Pages, h: &Document<Message>) -> Node {
    return h.column(
      &[h.style(&[css.padding(px(16.0)), css.rowGap(px(12.0)), css.color(rgb(INK))])],
      &[
        h.row(
          &[h.style(&[css.columnGap(px(16.0))])],
          &[tab(h, "/", "Home", model.route == Route.Home), tab(h, "/about", "About", model.route == Route.About)],
        ),
        match model.route {
          Route.Home => h.text("This is the home page.")
          Route.About => h.text("This page is about the program.")
          Route.NotFound => h.column(
            &[h.style(&[css.rowGap(px(8.0)), css.color(rgb(MUTED))])],
            &[h.text("There is no page here."), button(h, "Back home", Message.ClickedBackHome)],
          )
        },
      ],
    )
  }

  fn subscriptions(model: &Pages, subs: &mut Subscriptions<Message>) -> () {
    subs.location(1, |path| Message.ChangedLocation { route: routeOf(path) })
  }
}

/// A link to a page, marked when it is the page shown.
fn tab(h: &Document<Message>, path: string, label: string, current: bool) -> Node {
  return h.link(
    path,
    &[
      h.selected(current),
      h.style(
        &[
          css.color(
            if current {
              rgb(ACCENT)
            } else {
              rgb(INK)
            },
          ),
          css.fontWeight(
            if current {
              700.0
            } else {
              400.0
            },
          ),
        ],
      ),
    ],
    &[h.text(label)],
  )
}
