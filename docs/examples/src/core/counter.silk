//! A counter: the smallest complete Silk UI program.
import ui_app.css
import ui_app.css { px, Align, BorderStyle }
import ui_app.lib { Document, Node, NoCommand, NoOutput, Program, Update }
import silk.color.rgba { Rgba }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// Everything the program remembers.
pub struct Counter {
  pub count: i64,
}

/// Everything that can happen.
pub union Message {
  ClickedIncrement,
  ClickedDecrement,
  ClickedReset,
}

type Next = Update<Counter, NoCommand, NoOutput>

impl Program<Message, NoCommand> for Counter {
  /// The model the program starts with.
  effect fn init() -> Next
    ! OutOfMemoryError
    ? &mut Allocator {
    return Next.of(Counter { count: 0 })
  }

  /// The model after a message. Nothing else changes the model.
  effect fn update(mut model: Counter, message: Message) -> Next
    ! OutOfMemoryError
    ? &mut Allocator {
    match move message {
      Message.ClickedIncrement => {
        model.count = model.count + 1
      }
      Message.ClickedDecrement => {
        model.count = model.count - 1
      }
      Message.ClickedReset => {
        model.count = 0
      }
    }
    return Next.of(move model)
  }

  /// What the screen shows for a model.
  fn view(model: &Counter, h: &Document<Message>) -> Node {
    return h.row(
      &[h.style(&[css.alignItems(Align.Center), css.gap(px(12.0)), css.padding(px(16.0))])],
      &[
        button(h, "-", Message.ClickedDecrement),
        h.row(
          &[
            h.testId("count"),
            h.style(
              &[css.fontSize(px(24.0)), css.minWidth(px(48.0)), css.justifyContent(Align.Center)],
            ),
          ],
          &[h.number(model.count)],
        ),
        button(h, "+", Message.ClickedIncrement),
        button(h, "Reset", Message.ClickedReset),
      ],
    )
  }
}

/// A button is a function: it takes what to show and the message a click sends.
fn button(h: &Document<Message>, label: string, message: Message) -> Node {
  let gray = Rgba<f32> { r: 0.82, g: 0.84, b: 0.86, a: 1.0 }
  let hovered = Rgba<f32> { r: 0.95, g: 0.96, b: 0.96, a: 1.0 }
  return h.button(
    &[
      h.onClick(move message),
      h.style(
        &[
          css.padding(px(6.0)),
          css.paddingLeft(px(14.0)),
          css.paddingRight(px(14.0)),
          css.borderWidth(px(1.0)),
          css.borderStyle(BorderStyle.Solid),
          css.borderColor(gray),
          css.borderRadius(px(8.0)),
        ],
      ),
      h.hover(&[css.backgroundColor(hovered)]),
    ],
    &[h.text(label)],
  )
}
