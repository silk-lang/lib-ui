//! A plan picker: styles that come from the model, and styles that follow the pointer.
import core.look { ACCENT, INK, LINE, MUTED, rgb }
import ui_app.css
import ui_app.css { px, Align, BorderStyle, Property }
import ui_app.lib { Document, Node, NoCommand, NoOutput, Program, Role, Update }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub struct Plans {
  /// The plan that is chosen: 0, 1 or 2.
  pub chosen: u32,
}

pub union Message {
  ClickedPlan { pub plan: u32 },
}

type Next = Update<Plans, NoCommand, NoOutput>

impl Program<Message, NoCommand> for Plans {
  effect fn init() -> Next
    ! OutOfMemoryError
    ? &mut Allocator {
    return Next.of(Plans { chosen: 1 })
  }

  effect fn update(mut model: Plans, message: Message) -> Next
    ! OutOfMemoryError
    ? &mut Allocator {
    match move message {
      Message.ClickedPlan { plan } => {
        model.chosen = plan
      }
    }
    return Next.of(move model)
  }

  fn view(model: &Plans, h: &Document<Message>) -> Node {
    return h.row(
      &[
        h.accessRole(Role.Group),
        h.label("Plan"),
        h.style(&[css.padding(px(16.0)), css.columnGap(px(12.0)), css.color(rgb(INK))]),
      ],
      &[
        plan(h, model, 0, "Solo", "One person", 0),
        plan(h, model, 1, "Team", "Up to ten people", 12),
        plan(h, model, 2, "Company", "Everyone", 40),
      ],
    )
  }
}

/// One plan, as a card that can be chosen.
fn plan(
  h: &Document<Message>,
  model: &Plans,
  index: u32,
  name: string,
  about: string,
  dollars: i64,
) -> Node {
  let chosen = model.chosen == index
  return h.button(
    &[
      h.accessRole(Role.Radio),
      h.checked(chosen),
      h.onClick(Message.ClickedPlan { plan: index }),
      // The base style. The last declaration of a property wins.
      h.style(
        &[
          css.flexGrow(1.0),
          css.flexBasis(px(0.0)),
          css.padding(px(14.0)),
          css.borderWidth(px(1.0)),
          css.borderStyle(BorderStyle.Solid),
          css.borderRadius(px(12.0)),
          css.borderColor(rgb(LINE)),
          css.backgroundColor(rgb(0xFFFFFF)),
        ],
      ),
      // A style that depends on the model is an `if`.
      if chosen {
        h.style(&[css.borderColor(rgb(ACCENT)), css.backgroundColor(rgb(0xF0FDFA))])
      } else {
        // A style that depends on the pointer is a variant. The model never hears of it.
        h.hover(&[css.borderColor(rgb(MUTED))])
      },
      h.active(&[css.raw(Property.Translate, "0 1px")]),
      h.focusVisible(&[css.borderColor(rgb(INK))]),
      h.transition("border-color 150ms ease, background-color 150ms ease"),
    ],
    &[
      // A button's content flows inline, like text. A column stacks it.
      h.column(
        &[h.style(&[css.rowGap(px(4.0)), css.alignItems(Align.Start)])],
        &[
          h.box(&[h.style(&[css.fontWeight(700.0)])], &[h.text(name)]),
          h.box(&[h.style(&[css.color(rgb(MUTED)), css.fontSize(px(13.0))])], &[h.text(about)]),
          h.row(
            &[h.style(&[css.marginTop(px(8.0)), css.fontSize(px(20.0)), css.fontWeight(700.0)])],
            &[h.text("$"), h.number(dollars)],
          ),
        ],
      ),
    ],
  )
}
