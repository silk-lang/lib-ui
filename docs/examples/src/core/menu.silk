//! A cafe menu: a view built from small functions, a list, and one condition.
import core.look { ACCENT, INK, LINE, MUTED, button, rgb }
import ui_app.css
import ui_app.css { px, Align, BorderStyle }
import ui_app.lib { Document, Node, NoCommand, NoOutput, Program, Update }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// One thing on the menu.
pub struct Dish {
  pub name: string<'static>,
  pub about: string<'static>,
  /// The price, in cents.
  pub price: i64,
  pub vegetarian: bool,
}

impl Copy for Dish {}

const DISHES: [Dish; 4] = [
  Dish { name: "Shakshuka", about: "Eggs in tomato and pepper", price: 1150, vegetarian: true },
  Dish { name: "Smoked trout toast", about: "Rye, dill, lemon", price: 1300, vegetarian: false },
  Dish { name: "Mushroom omelette", about: "Three eggs, chives", price: 1050, vegetarian: true },
  Dish { name: "Chicken congee", about: "Ginger, scallion, egg", price: 1200, vegetarian: false },
]

pub struct Cafe {
  pub vegetarianOnly: bool,
}

pub union Message {
  ClickedFilter,
}

type Next = Update<Cafe, NoCommand, NoOutput>

impl Program<Message, NoCommand> for Cafe {
  effect fn init() -> Next
    ! OutOfMemoryError
    ? &mut Allocator {
    return Next.of(Cafe { vegetarianOnly: false })
  }

  effect fn update(mut model: Cafe, message: Message) -> Next
    ! OutOfMemoryError
    ? &mut Allocator {
    match move message {
      Message.ClickedFilter => {
        model.vegetarianOnly = !model.vegetarianOnly
      }
    }
    return Next.of(move model)
  }

  fn view(model: &Cafe, h: &Document<Message>) -> Node {
    return h.column(
      &[h.style(&[css.padding(px(16.0)), css.rowGap(px(12.0)), css.color(rgb(INK))])],
      &[
        h.row(
          &[h.style(&[css.alignItems(Align.Center), css.columnGap(px(12.0))])],
          &[
            h.box(
              &[h.style(&[css.fontSize(px(20.0)), css.fontWeight(700.0), css.flexGrow(1.0)])],
              &[h.text("Breakfast")],
            ),
            button(
              h,
              if model.vegetarianOnly {
                "Show everything"
              } else {
                "Vegetarian only"
              },
              Message.ClickedFilter,
            ),
          ],
        ),
        h.column(
          &[h.testId("dishes")],
          &[
            h.each(
              &DISHES,
              |dish| if model.vegetarianOnly && !dish.vegetarian {
                h.empty()
              } else {
                row(h, dish)
              },
            ),
          ],
        ),
      ],
    )
  }
}

/// One line of the menu.
fn row(h: &Document<Message>, dish: &Dish) -> Node {
  return h.row(
    &[
      h.style(
        &[
          css.alignItems(Align.Center),
          css.columnGap(px(10.0)),
          css.paddingTop(px(10.0)),
          css.paddingBottom(px(10.0)),
          css.borderTopWidth(px(1.0)),
          css.borderStyle(BorderStyle.Solid),
          css.borderColor(rgb(LINE)),
        ],
      ),
    ],
    &[
      h.column(
        &[h.style(&[css.flexGrow(1.0), css.rowGap(px(2.0))])],
        &[
          h.row(
            &[h.style(&[css.alignItems(Align.Center), css.columnGap(px(8.0))])],
            &[
              h.span(&[h.style(&[css.fontWeight(600.0)])], &[h.text(dish.name)]),
              if dish.vegetarian {
                badge(h, "vegetarian")
              } else {
                h.empty()
              },
            ],
          ),
          h.span(&[h.style(&[css.color(rgb(MUTED)), css.fontSize(px(13.0))])], &[h.text(dish.about)]),
        ],
      ),
      price(h, dish.price),
    ],
  )
}

/// A price in cents, as dollars: `1150` shows as `$11.50`.
fn price(h: &Document<Message>, cents: i64) -> Node {
  let rest = cents % 100
  return h.row(
    &[h.style(&[css.fontVariantNumeric("tabular-nums")])],
    &[
      h.text("$"),
      h.number(cents / 100),
      h.text("."),
      if rest < 10 {
        h.text("0")
      } else {
        h.empty()
      },
      h.number(rest),
    ],
  )
}

fn badge(h: &Document<Message>, label: string) -> Node {
  return h.span(
    &[
      h.style(
        &[
          css.fontSize(px(11.0)),
          css.paddingLeft(px(6.0)),
          css.paddingRight(px(6.0)),
          css.borderRadius(px(999.0)),
          css.borderWidth(px(1.0)),
          css.borderStyle(BorderStyle.Solid),
          css.borderColor(rgb(ACCENT)),
          css.color(rgb(ACCENT)),
        ],
      ),
    ],
    &[h.text(label)],
  )
}
