//! Album: twelve photos, a search field and likes. Photos are raster images, the heart and the
//! magnifier are SVG icons, and the titles and labels use two fonts of their own.
//!
//! The program only names its pictures and fonts by number. Whoever starts it says what each
//! number is. `apps/album` builds the files into a native app, and `apps/album-web` gives a
//! page their addresses.
import core.look { ACCENT, INK, LINE, MUTED, fieldLook, rgb }
import ui_app.css
import ui_app.css { px, Align, BorderStyle, FlexWrap, ObjectFit, Overflow, Position, WhiteSpace }
import ui_app.lib { Attr, Document, Node, NoCommand, NoOutput, Program, Role, Update }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.usize
import silk.text.string { String }

// The resources the album shows. Photo `i` is image `PHOTO + i`.

pub const PHOTO: u32 = 101

pub const HEART: u32 = 121

pub const SEARCH: u32 = 122

// The font families of the titles and of the labels, for `css.fontFamily`.

pub const DISPLAY: u32 = 11

pub const LABEL: u32 = 12

/// One photo: its title, and whether its file is a PNG or a JPEG.
pub struct Photo {
  pub index: u32,
  pub title: string<'static>,
  pub png: bool,
}

pub const COUNT: u32 = 12

pub const PHOTOS: [Photo; 12] = [
  Photo { index: 0, title: "Dusk", png: true },
  Photo { index: 1, title: "Meadow", png: false },
  Photo { index: 2, title: "Moonrise", png: true },
  Photo { index: 3, title: "Ember", png: false },
  Photo { index: 4, title: "Snowline", png: true },
  Photo { index: 5, title: "Canyon", png: false },
  Photo { index: 6, title: "Night walk", png: true },
  Photo { index: 7, title: "Glacier", png: false },
  Photo { index: 8, title: "Lagoon", png: true },
  Photo { index: 9, title: "Red ridge", png: false },
  Photo { index: 10, title: "Violet hour", png: true },
  Photo { index: 11, title: "Mist", png: false },
]

pub struct Album {
  /// The photo shown large.
  pub open: u32,
  pub liked: [bool; 12],
  pub query: String,
  /// Whether only liked photos are listed.
  pub likedOnly: bool,
}

pub union Message {
  ClickedPhoto { pub index: u32 },
  ClickedLike { pub index: u32 },
  ChangedQuery { pub value: String },
  ClickedLikedOnly,
}

type Next = Update<Album, NoCommand, NoOutput>

impl Program<Message, NoCommand> for Album {
  effect fn init() -> Next
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut liked: [bool; 12] = [false; 12]
    liked[2] = true
    liked[8] = true
    return Next.of(Album { open: 2, liked: liked, query: String.make(), likedOnly: false })
  }

  effect fn update(mut model: Album, message: Message) -> Next
    ! OutOfMemoryError
    ? &mut Allocator {
    match move message {
      Message.ClickedPhoto { index } => {
        model.open = index
      }
      Message.ClickedLike { index } => {
        let at = u32.toUsize(index)
        model.liked[at] = !model.liked[at]
      }
      Message.ChangedQuery { value } => {
        model.query = move value
      }
      Message.ClickedLikedOnly => {
        model.likedOnly = !model.likedOnly
      }
    }
    return Next.of(move model)
  }

  fn view(model: &Album, h: &Document<Message>) -> Node {
    return h.row(
      &[
        h.style(
          &[
            css.flexWrap(FlexWrap.Wrap),
            css.columnGap(px(20.0)),
            css.rowGap(px(16.0)),
            css.padding(px(16.0)),
            css.color(rgb(INK)),
            css.alignItems(Align.Start),
          ],
        ),
      ],
      &[viewer(h, model), browser(h, model)],
    )
  }
}

/// How many photos are liked.
pub fn likes(model: &Album) -> u32 {
  let mut count: u32 = 0
  let mut i: usize = 0
  while i < 12 {
    if model.liked[i] {
      count = count + 1
    }
    i = i + 1
  }
  return count
}

/// How many photos are listed.
pub fn shown(model: &Album) -> u32 {
  let mut count: u32 = 0
  let mut i: usize = 0
  while i < 12 {
    if listed(model, &PHOTOS[i]) {
      count = count + 1
    }
    i = i + 1
  }
  return count
}

/// Whether `photo` is listed: it matches the search, and it is liked when only liked ones are.
pub fn listed(model: &Album, photo: &Photo) -> bool {
  if model.likedOnly && !model.liked[u32.toUsize(photo.index)] {
    return false
  }
  return contains(String.utf8Bytes(photo.title), String.utf8Bytes(String.view(&model.query)))
}

/// Whether `text` has `part` in it, ignoring case (for ASCII letters).
fn contains(text: &[u8], part: &[u8]) -> bool {
  if part.length > text.length {
    return false
  }
  let mut at: usize = 0
  while at + part.length <= text.length {
    let mut i: usize = 0
    while i < part.length && lower(text[at + i]) == lower(part[i]) {
      i = i + 1
    }
    if i == part.length {
      return true
    }
    at = at + 1
  }
  return false
}

fn lower(byte: u8) -> u8 {
  if byte >= 65 && byte <= 90 {
    return byte + 32
  }
  return byte
}

/// The open photo, large, with its title, what kind of file it is, and its like button.
fn viewer(h: &Document<Message>, model: &Album) -> Node {
  let photo = &PHOTOS[u32.toUsize(model.open)]
  return h.column(
    &[h.style(&[css.rowGap(px(10.0)), css.width(px(288.0))])],
    &[
      h.image(
        PHOTO + photo.index,
        &[
          h.testId("open"),
          h.label(photo.title),
          h.style(
            &[
              css.width(px(288.0)),
              css.height(px(216.0)),
              css.borderRadius(px(14.0)),
              css.objectFit(ObjectFit.Cover),
            ],
          ),
        ],
      ),
      h.row(
        &[h.style(&[css.alignItems(Align.Center), css.columnGap(px(10.0))])],
        &[
          h.column(
            &[h.style(&[css.flexGrow(1.0), css.rowGap(px(2.0))])],
            &[
              h.box(
                &[
                  h.style(
                    &[
                      css.fontFamily(DISPLAY),
                      css.fontWeight(650.0),
                      css.fontSize(px(22.0)),
                      css.letterSpacing("-0.02em"),
                    ],
                  ),
                ],
                &[h.text(photo.title)],
              ),
              h.box(
                &[label(h), h.style(&[css.color(rgb(MUTED))])],
                &[
                  h.text(
                    if photo.png {
                      "PNG · 160 × 120"
                    } else {
                      "JPEG · 160 × 120"
                    },
                  ),
                ],
              ),
            ],
          ),
          like(h, model, photo.index, 36.0),
        ],
      ),
    ],
  )
}

/// The search field, the liked filter and the photos that are listed.
fn browser(h: &Document<Message>, model: &Album) -> Node {
  return h.column(
    &[h.style(&[css.rowGap(px(12.0)), css.flexGrow(1.0), css.flexBasis(px(300.0))])],
    &[
      h.row(
        &[h.style(&[css.columnGap(px(8.0)), css.alignItems(Align.Center)])],
        &[
          h.row(
            &[h.style(&[css.position(Position.Relative), css.flexGrow(1.0)])],
            &[
              h.icon(
                SEARCH,
                &[
                  h.style(
                    &[
                      css.position(Position.Absolute),
                      css.left(px(10.0)),
                      css.top(px(9.0)),
                      css.width(px(16.0)),
                      css.height(px(16.0)),
                      css.color(rgb(MUTED)),
                    ],
                  ),
                ],
              ),
              h.input(
                String.view(&model.query),
                &[
                  h.testId("query"),
                  h.label("Search photos"),
                  h.placeholder("Search"),
                  h.onInput(|value| Message.ChangedQuery { value: move value }),
                  fieldLook<Message>(h),
                  h.style(&[css.flexGrow(1.0), css.paddingLeft(px(32.0))]),
                ],
              ),
            ],
          ),
          likedOnly(h, model),
        ],
      ),
      h.row(
        &[
          h.testId("photos"),
          h.accessRole(Role.List),
          h.style(&[css.flexWrap(FlexWrap.Wrap), css.gap(px(8.0))]),
        ],
        &[
          h.each(
            &PHOTOS,
            |photo| if listed(model, photo) {
              h.keyed(u32.toU64(photo.index), thumbnail(h, model, photo))
            } else {
              h.empty()
            },
          ),
        ],
      ),
      if shown(model) == 0 {
        h.box(
          &[h.style(&[css.color(rgb(MUTED)), css.paddingTop(px(24.0)), css.paddingBottom(px(24.0))])],
          &[h.text("No photos match.")],
        )
      } else {
        h.empty()
      },
    ],
  )
}

/// A photo in the list: a button that opens it, with a small heart when it is liked.
fn thumbnail(h: &Document<Message>, model: &Album, photo: &Photo) -> Node {
  let open = model.open == photo.index
  return h.button(
    &[
      h.label(photo.title),
      h.onClick(Message.ClickedPhoto { index: photo.index }),
      h.style(
        &[
          css.position(Position.Relative),
          css.padding(px(0.0)),
          css.borderWidth(px(2.0)),
          css.borderStyle(BorderStyle.Solid),
          css.borderRadius(px(10.0)),
          css.borderColor(
            rgb(
              if open {
                ACCENT
              } else {
                0xFFFFFF
              },
            ),
          ),
          css.overflow(Overflow.Hidden),
        ],
      ),
    ],
    &[
      h.image(
        PHOTO + photo.index,
        &[h.style(&[css.width(px(88.0)), css.height(px(66.0)), css.objectFit(ObjectFit.Cover)])],
      ),
      if model.liked[u32.toUsize(photo.index)] {
        h.icon(
          HEART,
          &[
            h.style(
              &[
                css.position(Position.Absolute),
                css.right(px(5.0)),
                css.bottom(px(5.0)),
                css.width(px(14.0)),
                css.height(px(14.0)),
                css.color(rgb(0xFFFFFF)),
              ],
            ),
          ],
        )
      } else {
        h.empty()
      },
    ],
  )
}

/// The button that likes photo `index`: a heart outlined in gray, or filled in red.
fn like(h: &Document<Message>, model: &Album, index: u32, size: f32) -> Node {
  let liked = model.liked[u32.toUsize(index)]
  return h.button(
    &[
      h.testId("like"),
      h.label(
        if liked {
          "Unlike"
        } else {
          "Like"
        },
      ),
      h.onClick(Message.ClickedLike { index: index }),
      h.style(
        &[
          css.width(px(size)),
          css.height(px(size)),
          css.padding(px(0.0)),
          css.borderWidth(px(1.0)),
          css.borderStyle(BorderStyle.Solid),
          css.borderRadius(px(size)),
          css.borderColor(rgb(LINE)),
          css.backgroundColor(rgb(0xFFFFFF)),
          // The icon is drawn in the text color.
          css.color(
            rgb(
              if liked {
                0xE11D48
              } else {
                0xD1D5DB
              },
            ),
          ),
        ],
      ),
      h.hover(&[css.backgroundColor(rgb(0xFFF1F2))]),
    ],
    &[
      h.row(
        &[
          h.style(
            &[
              css.width(px(size - 2.0)),
              css.height(px(size - 2.0)),
              css.alignItems(Align.Center),
              css.justifyContent(Align.Center),
            ],
          ),
        ],
        &[h.icon(HEART, &[h.style(&[css.width(px(18.0)), css.height(px(18.0))])])],
      ),
    ],
  )
}

/// The filter that lists only liked photos, with how many there are.
fn likedOnly(h: &Document<Message>, model: &Album) -> Node {
  let on = model.likedOnly
  return h.button(
    &[
      h.testId("liked-only"),
      h.accessRole(Role.Checkbox),
      h.checked(on),
      h.onClick(Message.ClickedLikedOnly),
      h.style(
        &[
          css.paddingTop(px(6.0)),
          css.paddingBottom(px(6.0)),
          css.paddingLeft(px(10.0)),
          css.paddingRight(px(12.0)),
          css.borderWidth(px(1.0)),
          css.borderStyle(BorderStyle.Solid),
          css.borderRadius(px(8.0)),
          css.borderColor(
            rgb(
              if on {
                0xE11D48
              } else {
                LINE
              },
            ),
          ),
          css.backgroundColor(
            rgb(
              if on {
                0xFFF1F2
              } else {
                0xFFFFFF
              },
            ),
          ),
          css.whiteSpace(WhiteSpace.NoWrap),
        ],
      ),
    ],
    &[
      h.row(
        &[h.style(&[css.alignItems(Align.Center), css.columnGap(px(6.0))])],
        &[
          h.icon(
            HEART,
            &[h.style(&[css.width(px(14.0)), css.height(px(14.0)), css.color(rgb(0xE11D48))])],
          ),
          h.box(&[label(h)], &[h.number(u32.toI64(likes(model)))]),
        ],
      ),
    ],
  )
}

/// The look of a small label: the label font, a little smaller than the text.
fn label(h: &Document<Message>) -> Attr {
  return h.style(&[css.fontFamily(LABEL), css.fontSize(px(12.0)), css.fontVariantNumeric("tabular-nums")])
}
