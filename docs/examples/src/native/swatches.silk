//! Swatches: a color picker whose preview lives in a second window. Both windows show the
//! one model, and the model decides which windows exist.
import core.look { INK, LINE, button, rgb }
import ui_app.css
import ui_app.css { px, percent, Align, BorderStyle }
import ui_app.lib {
  Document,
  Node,
  NoCommand,
  NoOutput,
  Program,
  Update,
  Windows,
  WindowSpec
}
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// The key of the preview window. Keys tell the windows apart, as keys tell list items apart.
pub const PREVIEW: u64 = 1

const COLORS: [u32; 4] = [0x0F766E, 0xB45309, 0x1D4ED8, 0xBE123C]

pub struct Swatches {
  /// The chosen color: an index into `COLORS`.
  pub chosen: usize,
  /// Whether the preview window is open.
  pub previewing: bool,
}

pub union Message {
  ClickedSwatch { pub index: usize },
  ClickedTogglePreview,
  /// The user asked to close the preview window.
  RequestedClosePreview,
}

type Next = Update<Swatches, NoCommand, NoOutput>

impl Program<Message, NoCommand> for Swatches {
  effect fn init() -> Next
    ! OutOfMemoryError
    ? &mut Allocator {
    return Next.of(Swatches { chosen: 0, previewing: false })
  }

  effect fn update(mut model: Swatches, message: Message) -> Next
    ! OutOfMemoryError
    ? &mut Allocator {
    match move message {
      Message.ClickedSwatch { index } => {
        model.chosen = index
      }
      Message.ClickedTogglePreview => {
        model.previewing = !model.previewing
      }
      Message.RequestedClosePreview => {
        // The window stays open until the model stops declaring it.
        model.previewing = false
      }
    }
    return Next.of(move model)
  }

  /// The first window.
  fn view(model: &Swatches, h: &Document<Message>) -> Node {
    return h.column(
      &[h.style(&[css.padding(px(20.0)), css.rowGap(px(16.0)), css.color(rgb(INK))])],
      &[
        h.row(
          &[h.style(&[css.columnGap(px(10.0))])],
          &[swatch(h, model, 0), swatch(h, model, 1), swatch(h, model, 2), swatch(h, model, 3)],
        ),
        h.row(
          &[],
          &[
            button(
              h,
              if model.previewing {
                "Close preview"
              } else {
                "Open preview"
              },
              Message.ClickedTogglePreview,
            ),
          ],
        ),
      ],
    )
  }

  /// The windows besides the first. The runtime asks after every update and opens and closes
  /// windows to match.
  fn windows(model: &Swatches, w: &mut Windows<Message>) -> () {
    if model.previewing {
      w.window(
        PREVIEW,
        WindowSpec.titled("Preview").sized(240.0, 240.0),
        |h| preview(model, h),
        || Message.RequestedClosePreview,
      )
    }
  }
}

fn swatch(h: &Document<Message>, model: &Swatches, index: usize) -> Node {
  return h.button(
    &[
      h.label("Color"),
      h.checked(model.chosen == index),
      h.onClick(Message.ClickedSwatch { index: index }),
      h.style(
        &[
          css.width(px(44.0)),
          css.height(px(44.0)),
          css.borderRadius(px(10.0)),
          css.borderWidth(px(3.0)),
          css.borderStyle(BorderStyle.Solid),
          css.borderColor(
            if model.chosen == index {
              rgb(INK)
            } else {
              rgb(LINE)
            },
          ),
          css.backgroundColor(rgb(COLORS[index])),
        ],
      ),
    ],
    &[],
  )
}

/// The preview window: the chosen color, edge to edge.
fn preview(model: &Swatches, h: &Document<Message>) -> Node {
  return h.column(
    &[
      h.testId("preview"),
      h.style(
        &[
          css.height(percent(100.0)),
          css.alignItems(Align.Center),
          css.justifyContent(Align.Center),
          css.fontSize(px(14.0)),
          css.color(rgb(0xFFFFFF)),
          css.backgroundColor(rgb(COLORS[model.chosen])),
        ],
      ),
    ],
    &[h.text("One model, two windows")],
  )
}
