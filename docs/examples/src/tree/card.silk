//! A card built node by node: boxes, text, styles and a hover look.
import ui_tree.css
import ui_tree.css { px, percent, Keyword }
import ui_tree.lib {
  Align,
  BorderStyle,
  BoxNode,
  FlexDirection,
  FontFamily,
  Role,
  StyleState,
  Tree,
  TreeError
}
import silk.color.rgba { Rgba }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32

/// A color from its hex code.
pub fn rgb(hex: u32) -> Rgba<f32> {
  let r = u32.toF32(u32.bitAnd(u32.shiftRight(hex, 16), 255)) / 255.0
  let g = u32.toF32(u32.bitAnd(u32.shiftRight(hex, 8), 255)) / 255.0
  let b = u32.toF32(u32.bitAnd(hex, 255)) / 255.0
  return Rgba<f32> { r: r, g: g, b: b, a: 1.0 }
}

/// Puts the text `value` at the end of `parent`.
pub effect fn write(tree: &mut Tree<'_>, parent: BoxNode, value: string) -> ()
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let text = run tree.text(value)
  run tree.append(parent, text)
}

/// The handles a client keeps: the nodes it will change or listen to later.
pub struct Card {
  pub root: BoxNode,
  pub button: BoxNode,
}

/// Builds the card and makes it the root of `tree`.
pub effect fn build(tree: &mut Tree<'_>, sans: FontFamily) -> Card
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  // The root is as wide as the viewport, and as tall as its style says. Text properties set here are inherited by everything below.
  let root = run tree.box(
    &[
      css.display(Keyword.Flex),
      css.height(percent(100.0)),
      css.alignItems(Align.Center),
      css.justifyContent(Align.Center),
      css.fontFamily(sans.raw()),
      css.fontSize(px(15.0)),
      css.color(rgb(0x1F2937)),
      css.backgroundColor(rgb(0xF3F4F6)),
    ],
  )
  let card = run tree.box(
    &[
      css.display(Keyword.Flex),
      css.flexDirection(FlexDirection.Column),
      css.rowGap(px(8.0)),
      css.width(px(280.0)),
      css.padding(px(20.0)),
      css.borderRadius(px(14.0)),
      css.borderWidth(px(1.0)),
      css.borderStyle(BorderStyle.Solid),
      css.borderColor(rgb(0xD1D5DB)),
      css.backgroundColor(rgb(0xFFFFFF)),
    ],
  )
  let title = run tree.box(&[css.fontSize(px(20.0)), css.fontWeight(700.0)])
  run write(&mut tree, title, "Tide tables")

  // A sentence with one word in another weight: text, a span, text.
  let about = run tree.box(&[css.color(rgb(0x6B7280))])
  run write(&mut tree, about, "High water at ")
  let strong = run tree.span(&[css.fontWeight(700.0), css.color(rgb(0x1F2937))])
  run write(&mut tree, strong, "06:42")
  run tree.append(about, strong)
  run write(&mut tree, about, ", low at 12:57.")

  let button = run tree.box(
    &[
      css.display(Keyword.Flex),
      css.justifyContent(Align.Center),
      css.marginTop(px(8.0)),
      css.padding(px(8.0)),
      css.borderRadius(px(8.0)),
      css.color(rgb(0xFFFFFF)),
      css.backgroundColor(rgb(0x0F766E)),
    ],
  )
  // The look while the pointer is over the button. The tree switches looks itself.
  run tree.setStyleFor(button, StyleState.Hover, &[css.backgroundColor(rgb(0x0D5F58))])
  run tree.setRole(button, Role.Button)
  run tree.setTestId(button, "refresh")
  run write(&mut tree, button, "Refresh")

  run tree.append(card, title)
  run tree.append(card, about)
  run tree.append(card, button)
  run tree.append(root, card)
  run tree.setRoot(root)
  return Card { root: root, button: button }
}
