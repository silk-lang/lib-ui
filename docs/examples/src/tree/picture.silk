//! Pictures of a tree: a frame drawn on the CPU and encoded as a PNG. No window and no GPU,
//! so it runs anywhere, a test or a server included.
import ui_tree.inspect { CpuSnapshot, encodePng }
import ui_tree.lib { Tree, TreeError, Viewport }
import codec.image { ImageError }
import vector.geometry_error { GeometryError }
import silk.collections.bytes { Bytes }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// Takes pictures of one tree. Keep it for as long as the tree: it holds the glyphs and
/// images earlier frames made, which later frames use again.
pub struct Camera {
  snapshot: CpuSnapshot,
}

impl Camera {
  pub fn make() -> Camera {
    return Camera { snapshot: CpuSnapshot.make() }
  }

  /// The tree as it looks in `viewport` at `time`, as the bytes of a PNG file.
  pub effect fn png(self: &mut Self, tree: &mut Tree<'_>, viewport: Viewport, time: f64) -> Bytes
    ! TreeError | GeometryError | ImageError | OutOfMemoryError
    ? &mut Allocator {
    // A frame styles, lays out and paints what changed, into a scene.
    drop run tree.frame(viewport, time)

    // The snapshot copies the glyphs and images the frame made, then draws the scene.
    run self.snapshot.sync(tree.engineMut())
    let pixels = run self.snapshot.render(tree.engine())
    return run encodePng(&pixels)
  }
}
