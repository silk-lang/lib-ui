//! The same kind of tree, described as data. A client that cannot call the tree directly (a
//! JavaScript host, another process, a recording) sends mutations: it chooses the node
//! numbers itself and gets event records with those numbers back.
import tree.card { rgb }
import ui_tree.css
import ui_tree.css { px, percent, Keyword }
import ui_tree.lib { Align, Batch, EventKind, Mutation, NodeKind, StyleState }
import ui_tree.event { listenFlags }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }

// The client's own numbers.
pub const SANS: u32 = 1

pub const ROOT: u32 = 1

pub const BUTTON: u32 = 2

pub const LABEL: u32 = 3

/// Everything the first frame needs, as one batch.
pub effect fn first() -> List<Mutation>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.fontFamily(SANS, "Noto Sans, sans-serif")
  run batch.create(ROOT, NodeKind.Box)
  run batch.style(
    ROOT,
    &[
      css.display(Keyword.Flex),
      css.height(percent(100.0)),
      css.alignItems(Align.Center),
      css.justifyContent(Align.Center),
      css.fontFamily(SANS),
      css.fontSize(px(16.0)),
      css.backgroundColor(rgb(0xF3F4F6)),
    ],
  )
  run batch.root(ROOT)

  // `box` is create, style and append in one call; `text` is create, set text and append.
  run batch.box(
    ROOT,
    BUTTON,
    &[
      css.padding(px(12.0)),
      css.borderRadius(px(10.0)),
      css.color(rgb(0xFFFFFF)),
      css.backgroundColor(rgb(0x0F766E)),
    ],
  )
  run batch.styleFor(BUTTON, StyleState.Hover, &[css.backgroundColor(rgb(0x0D5F58))])
  run batch.testId(BUTTON, "send")
  run batch.listen(BUTTON, listenFlags(&[EventKind.Click]))
  run batch.text(BUTTON, LABEL, "Send")
  return run batch.take()
}

/// What the client sends after a click: one mutation.
pub effect fn sent() -> List<Mutation>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.setText(LABEL, "Sent")
  return run batch.take()
}
