//! A text field on the bare tree. The tree edits the text itself: it places the caret, moves
//! it with the arrow keys, selects, and scrolls the field to keep the caret in view. The
//! client only hears what the value became.
import tree.card { rgb, write }
import ui_tree.css
import ui_tree.css { px, Keyword }
import ui_tree.lib {
  Attribute,
  BorderStyle,
  Event,
  EventKind,
  FlexDirection,
  FontFamily,
  InputNode,
  StyleState,
  TextNode,
  Tree,
  TreeError
}
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

pub struct Greeting {
  pub name: InputNode,
  pub hello: TextNode,
}

pub effect fn build(tree: &mut Tree<'_>, sans: FontFamily) -> Greeting
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let root = run tree.box(
    &[
      css.display(Keyword.Flex),
      css.flexDirection(FlexDirection.Column),
      css.rowGap(px(10.0)),
      css.padding(px(24.0)),
      css.fontFamily(sans.raw()),
      css.fontSize(px(16.0)),
      css.color(rgb(0x1F2937)),
      css.backgroundColor(rgb(0xFFFFFF)),
    ],
  )
  let caption = run tree.box(&[css.color(rgb(0x6B7280)), css.fontSize(px(13.0))])
  run write(&mut tree, caption, "Your name")

  let name = run tree.input(
    &[
      css.width(px(240.0)),
      css.padding(px(8.0)),
      css.borderWidth(px(1.0)),
      css.borderStyle(BorderStyle.Solid),
      css.borderRadius(px(8.0)),
      css.borderColor(rgb(0xD1D5DB)),
      css.caretColor(rgb(0x0F766E)),
    ],
  )
  // The look while the field has focus.
  run tree.setStyleFor(name, StyleState.Focus, &[css.borderColor(rgb(0x0F766E))])
  run tree.setAttribute(name, Attribute.Placeholder { value: run String.copy("Ada") })
  run tree.setLabel(name, "Your name")
  run tree.listen(name, &[EventKind.Input])

  let line = run tree.box(&[css.fontSize(px(20.0)), css.fontWeight(700.0)])
  let hello = run tree.text("Hello.")
  run tree.append(line, hello)

  run tree.append(root, caption)
  run tree.append(root, name)
  run tree.append(root, line)
  run tree.setRoot(root)
  return Greeting { name: name, hello: hello }
}

impl Greeting {
  /// Answers each change of the field by greeting whoever is named in it.
  pub effect fn pump(self: &mut Self, tree: &mut Tree<'_>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let records = run tree.events()
    let all = records.asSlice()
    let mut i: usize = 0
    while i < all.length {
      if let Event.Input { change } = &all[i].event {
        let mut text = run String.copy("Hello")
        if change.value.ownedByteLength() != 0 {
          run text.append(", ")
          run text.append(String.view(&change.value))
        }
        run text.append(".")
        run tree.setText(self.hello, String.view(&text))
      }
      i = i + 1
    }
  }
}
