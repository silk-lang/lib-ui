//! A counter on the bare tree: the client listens, feeds input in, reads records out, and
//! changes the nodes itself. This loop is what a framework over the tree does for you.
import tree.card { rgb }
import ui_tree.css
import ui_tree.css { px, percent, Keyword }
import ui_tree.lib {
  Align,
  Attribute,
  BoxNode,
  Event,
  EventKind,
  FontFamily,
  Role,
  StyleState,
  TextNode,
  Tree,
  TreeError
}
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.text.string { InvalidUtf8, String }

pub struct Clicker {
  pub button: BoxNode,
  pub label: TextNode,
  pub clicks: u32,
}

pub effect fn build(tree: &mut Tree<'_>, sans: FontFamily) -> Clicker
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let root = run tree.box(
    &[
      css.display(Keyword.Flex),
      css.height(percent(100.0)),
      css.alignItems(Align.Center),
      css.justifyContent(Align.Center),
      css.fontFamily(sans.raw()),
      css.fontSize(px(16.0)),
      css.backgroundColor(rgb(0xF3F4F6)),
    ],
  )
  let button = run tree.box(
    &[
      css.paddingTop(px(10.0)),
      css.paddingBottom(px(10.0)),
      css.paddingLeft(px(18.0)),
      css.paddingRight(px(18.0)),
      css.borderRadius(px(10.0)),
      css.color(rgb(0xFFFFFF)),
      css.backgroundColor(rgb(0x0F766E)),
    ],
  )
  run tree.setStyleFor(button, StyleState.Hover, &[css.backgroundColor(rgb(0x0D5F58))])
  run tree.setStyleFor(button, StyleState.Active, &[css.backgroundColor(rgb(0x134E4A))])
  run tree.setRole(button, Role.Button)
  // Tab order 0 makes the box focusable, so Enter and Space click it too.
  run tree.setAttribute(button, Attribute.TabIndex { value: 0 })
  let label = run tree.text("Clicked 0 times")
  run tree.append(button, label)
  run tree.append(root, button)
  run tree.setRoot(root)

  // Nothing is recorded for a node until it listens.
  run tree.listen(button, &[EventKind.Click])
  return Clicker { button: button, label: label, clicks: 0 }
}

/// "Clicked 3 times".
effect fn labelFor(clicks: u32) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  // The digits, last first.
  let mut digits: [u8; 10] = [0; 10]
  let mut count: usize = 0
  let mut rest = clicks
  while count == 0 || rest > 0 {
    digits[count] = u32.toU8(rest % 10) + 48
    rest = rest / 10
    count = count + 1
  }
  let mut bytes = Bytes.make()
  run bytes.append(b"Clicked ")
  while count > 0 {
    count = count - 1
    run bytes.append(Slice.view<u8>(&digits, count, 1))
  }
  run bytes.append(b" times")
  return String.fromBytes(move bytes) |> Result<String, InvalidUtf8>.unwrapOr(String.make())
}

impl Clicker {
  /// Takes the records the tree queued and answers each click by changing the label.
  pub effect fn pump(self: &mut Self, tree: &mut Tree<'_>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let records = run tree.events()
    let all = records.asSlice()
    let mut i: usize = 0
    while i < all.length {
      if let Event.Click { .. } = &all[i].event {
        if all[i].hits(self.button.id()) {
          self.clicks = self.clicks + 1
          let text = run labelFor(self.clicks)
          run tree.setText(self.label, String.view(&text))
        }
      }
      i = i + 1
    }
  }
}
