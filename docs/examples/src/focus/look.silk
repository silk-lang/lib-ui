//! How the Focus tutorial looks. The steps import these so their own code stays about
//! behavior. Each is a plain function that works for any message type.
import core.look { ACCENT, INK, LINE, MUTED, rgb }
import ui_app.css
import ui_app.css { px, Align, BorderStyle, Keyword }
import ui_app.lib { Attr, Document, Node, Role }

/// A checkbox: a small square that sends `message` when it is clicked.
pub fn check<M>(h: &Document<M>, done: bool, label: string, message: M) -> Node {
  let color = if done {
    rgb(ACCENT)
  } else {
    rgb(LINE)
  }
  let fill = if done {
    rgb(ACCENT)
  } else {
    rgb(0xFFFFFF)
  }
  return h.button(
    &[
      h.accessRole(Role.Checkbox),
      h.checked(done),
      h.label(label),
      h.onClick(move message),
      h.style(
        &[
          css.width(px(18.0)),
          css.height(px(18.0)),
          css.flexShrink(0.0),
          css.borderWidth(px(1.0)),
          css.borderStyle(BorderStyle.Solid),
          css.borderRadius(px(5.0)),
          css.borderColor(color),
          css.backgroundColor(fill),
        ],
      ),
    ],
    &[],
  )
}

/// The line under each task and the space around it.
pub fn rowLook<M>(h: &Document<M>) -> Attr {
  return h.style(
    &[
      css.alignItems(Align.Center),
      css.columnGap(px(10.0)),
      css.minHeight(px(44.0)),
      css.borderTopWidth(px(1.0)),
      css.borderStyle(BorderStyle.Solid),
      css.borderColor(rgb(LINE)),
    ],
  )
}

/// A task's title: struck through once it is done. It takes the room the row has left.
pub fn titleLook<M>(h: &Document<M>, done: bool) -> Attr {
  if done {
    return h.style(
      &[
        css.flexGrow(1.0),
        css.color(rgb(MUTED)),
        css.textDecorationLine(Keyword.LineThrough),
      ],
    )
  }
  return h.style(&[css.flexGrow(1.0), css.color(rgb(INK))])
}

/// Two numbers with a colon between them, the second with two digits: `0:07`, `14:32`.
pub fn pair<M>(h: &Document<M>, first: i64, second: i64) -> Node {
  return h.row(
    &[h.style(&[css.fontVariantNumeric("tabular-nums")])],
    &[
      h.number(first),
      h.text(
        if second < 10 {
          ":0"
        } else {
          ":"
        },
      ),
      h.number(second),
    ],
  )
}
