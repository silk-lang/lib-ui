//! The pictures the build draws from the examples (`docs/shots`), by name. Each is an image
//! resource: `web/index.html` and the static build give `mount` and `Html` the same numbers.

import silk.num.u32
import silk.text.string { String }

/// One picture: its file under `/shots/`, and its width in CSS pixels. The files hold two
/// device pixels per pixel.
pub struct Shot {
  pub name: string<'static>,
  pub width: f32,
}

const SHOTS: [Shot; 16] = [
  Shot { name: "tree-hello.png", width: 480.0 },
  Shot { name: "tree-card.png", width: 400.0 },
  Shot { name: "tree-card-hover.png", width: 400.0 },
  Shot { name: "tree-clicker.png", width: 400.0 },
  Shot { name: "tree-field.png", width: 400.0 },
  Shot { name: "tree-remote.png", width: 400.0 },
  Shot { name: "tree-window.png", width: 400.0 },
  Shot { name: "native-hello.png", width: 360.0 },
  Shot { name: "native-board.png", width: 720.0 },
  Shot { name: "native-pad.png", width: 520.0 },
  Shot { name: "native-pad-closing.png", width: 520.0 },
  Shot { name: "native-swatches.png", width: 320.0 },
  Shot { name: "native-swatches-preview.png", width: 240.0 },
  Shot { name: "native-search.png", width: 420.0 },
  Shot { name: "native-search-done.png", width: 420.0 },
  Shot { name: "native-album.png", width: 640.0 },
]

/// How many pictures there are; resource `n` is picture `n - 1`.
pub const COUNT: u32 = 16

/// The file name of picture `index`, under `/shots/`.
pub fn name(index: u32) -> string<'static> {
  return SHOTS[u32.toUsize(index)].name
}

/// The width of picture `index`, in CSS pixels.
pub fn width(index: u32) -> f32 {
  return SHOTS[u32.toUsize(index)].width
}

/// The image resource of the picture called `value` (its file name without `.png`), or zero
/// when there is none.
pub fn resourceOf(value: string) -> u32 {
  let mut index: u32 = 0
  while index < COUNT {
    let file = name(index)
    if String.slice(file, 0, String.byteLength(file) - 4) == value {
      return index + 1
    }
    index = index + 1
  }
  return 0
}
