//! The pictures the build draws from the examples (`docs/shots`), by name. Each is a file
//! under `/shots/`, named by its relative URL.

import silk.num.u32
import silk.text.string { String }

/// One picture: its URL, `shots/<name>.png`, and its width in CSS pixels. The files hold two
/// device pixels per pixel.
pub struct Shot {
  pub url: string<'static>,
  pub width: f32,
}

const SHOTS: [Shot; 16] = [
  Shot { url: "shots/tree-hello.png", width: 480.0 },
  Shot { url: "shots/tree-card.png", width: 400.0 },
  Shot { url: "shots/tree-card-hover.png", width: 400.0 },
  Shot { url: "shots/tree-clicker.png", width: 400.0 },
  Shot { url: "shots/tree-field.png", width: 400.0 },
  Shot { url: "shots/tree-remote.png", width: 400.0 },
  Shot { url: "shots/tree-window.png", width: 400.0 },
  Shot { url: "shots/native-hello.png", width: 360.0 },
  Shot { url: "shots/native-board.png", width: 720.0 },
  Shot { url: "shots/native-pad.png", width: 520.0 },
  Shot { url: "shots/native-pad-closing.png", width: 520.0 },
  Shot { url: "shots/native-swatches.png", width: 320.0 },
  Shot { url: "shots/native-swatches-preview.png", width: 240.0 },
  Shot { url: "shots/native-search.png", width: 420.0 },
  Shot { url: "shots/native-search-done.png", width: 420.0 },
  Shot { url: "shots/native-album.png", width: 640.0 },
]

/// How many pictures there are.
pub const COUNT: u32 = 16

/// The URL of picture `index`: `shots/<name>.png`.
pub fn url(index: u32) -> string<'static> {
  return SHOTS[u32.toUsize(index)].url
}

/// The width of picture `index`, in CSS pixels.
pub fn width(index: u32) -> f32 {
  return SHOTS[u32.toUsize(index)].width
}

/// The picture called `value` (its file name without `shots/` and `.png`), or `COUNT` when
/// there is none.
pub fn find(value: string) -> u32 {
  let mut index: u32 = 0
  while index < COUNT {
    let file = url(index)
    if String.slice(file, 6, String.byteLength(file) - 10) == value {
      return index
    }
    index = index + 1
  }
  return COUNT
}
