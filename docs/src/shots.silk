//! The pictures the build draws from the examples, by name. Each is an image resource:
//! `web/index.html` and the static build give `mount` and `Html` the same numbers.

/// How many pictures there are; resource `n` is picture `n - 1`.
pub const COUNT: u32 = 0

/// The file name of picture `index`, under `/shots/`.
pub fn name(index: u32) -> string<'static> {
  return ""
}

/// The image resource of the picture called `value`, or zero when there is none.
pub fn resourceOf(value: string) -> u32 {
  let mut index: u32 = 0
  while index < COUNT {
    if name(index) == value {
      return index + 1
    }
    index = index + 1
  }
  return 0
}
