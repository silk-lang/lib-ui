//! The site's look: colors, fonts and the few layout rules everything shares.
//!
//! Colors are CSS custom properties that `web/index.html` defines twice, for light and dark.
//! The program only names them, so a page drawn ahead of time is right in either scheme
//! before the program loads, and the theme switch never draws a view again.
import ui_app.css
import ui_app.css { px, Declaration, Property }
import ui_app.lib { Attr, Document }

/// The font families `web/index.html` gives `mount`.
pub const SANS: u32 = 1

pub const MONO: u32 = 2

pub const PAPER: string = "var(--paper)"

pub const PANEL: string = "var(--panel)"

pub const INK: string = "var(--ink)"

pub const BODY: string = "var(--body)"

pub const MUTED: string = "var(--muted)"

pub const FAINT: string = "var(--faint)"

pub const RULE: string = "var(--rule)"

pub const SIGNAL: string = "var(--signal)"

pub const SIGNAL_INK: string = "var(--signal-ink)"

pub const SIGNAL_SOFT: string = "var(--signal-soft)"

pub const ON_SIGNAL: string = "var(--on-signal)"

pub const CODE_SURFACE: string = "var(--code-surface)"

pub const CODE_PLAIN: string = "var(--code-plain)"

pub const CODE_KEYWORD: string = "var(--code-keyword)"

pub const CODE_TYPE: string = "var(--code-type)"

pub const CODE_TEXT: string = "var(--code-string)"

pub const CODE_COMMENT: string = "var(--code-comment)"

pub const CODE_NUMBER: string = "var(--code-number)"

pub const CODE_CALL: string = "var(--code-call)"

/// Below this width the sidebar gives way to a menu.
pub const NARROW: string = "920px"

/// Below this width the page has no "On this page" column.
pub const MEDIUM: string = "1240px"

pub fn color(token: string) -> Declaration {
  return css.raw(Property.Color, token)
}

pub fn background(token: string) -> Declaration {
  return css.raw(Property.BackgroundColor, token)
}

pub fn borderColor(token: string) -> Declaration {
  return css.raw(Property.BorderColor, token)
}

pub fn round(radius: f32) -> Declaration {
  return css.borderRadius(px(radius))
}

pub fn pad(vertical: f32, horizontal: f32) -> [Declaration; 4] {
  return [
    css.paddingTop(px(vertical)),
    css.paddingBottom(px(vertical)),
    css.paddingLeft(px(horizontal)),
    css.paddingRight(px(horizontal)),
  ]
}

/// A one pixel line on every side.
pub fn outline<M>(h: &Document<M>, token: string) -> Attr {
  return h.style(&[css.raw(Property.Border, "1px solid"), borderColor(token)])
}

/// Takes no room unless the window is at least `width` wide: its width shrinks to nothing.
/// Plain CSS does this, so a page drawn ahead of time needs no program to fit a phone.
pub fn wideOnly<M>(h: &Document<M>, width: string) -> Attr {
  return h.style(
    &[
      css.raw(Property.MaxWidth, wideLimit(width)),
      css.raw(Property.Overflow, "clip"),
      css.flexShrink(0.0),
    ],
  )
}

/// Takes no room unless the window is narrower than `width`: its height shrinks to nothing.
pub fn narrowOnly<M>(h: &Document<M>, width: string) -> Attr {
  return h.style(
    &[css.raw(Property.MaxHeight, narrowLimit(width)), css.raw(Property.Overflow, "clip")],
  )
}

fn wideLimit(width: string) -> string<'static> {
  if width == NARROW {
    return "max(0px, calc((100vw - 920px) * 9999))"
  }
  return "max(0px, calc((100vw - 1240px) * 9999))"
}

fn narrowLimit(width: string) -> string<'static> {
  if width == NARROW {
    return "max(0px, calc((920px - 100vw) * 9999))"
  }
  return "max(0px, calc((1240px - 100vw) * 9999))"
}
