//! A page's blocks, with the examples it names put in: `::source file "item"` becomes the
//! listing of that file, or of one item of it.
import sources { source }
import markdown { Block, codeBlock, excerpt, parse }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

/// What a listing is written in, from its file's name.
fn languageOf(file: string) -> string<'static> {
  if String.endsWith(file, ".silk") {
    return "silk"
  }
  if String.endsWith(file, ".toml") {
    return "toml"
  }
  if String.endsWith(file, ".js") {
    return "js"
  }
  if String.endsWith(file, ".html") {
    return "html"
  }
  if String.endsWith(file, ".sh") {
    return "sh"
  }
  if String.endsWith(file, ".yml") {
    return "yaml"
  }
  return "text"
}

/// The listing `argument` names: a file under `docs/`, then maybe the start of one
/// of its items, in quotes.
effect fn listing(argument: string<'static>) -> Block
  ! OutOfMemoryError
  ? &mut Allocator {
  let bytes = String.utf8Bytes(argument)
  let mut space: usize = 0
  while space < bytes.length && bytes[space] != 32 {
    space = space + 1
  }
  let file = String.slice(argument, 0, space)
  let mut body: string<'static> = "This file is missing from docs/src/sources.silk."
  let mut language: string<'static> = "text"
  if let Option<string<'static>>.Some { value } = source(file) {
    body = String.trimEnd(value)
    language = languageOf(file)
    let mut open = space
    while open < bytes.length && bytes[open] != 34 {
      open = open + 1
    }
    if open < bytes.length {
      let mut close = open + 1
      while close < bytes.length && bytes[close] != 34 {
        close = close + 1
      }
      body = excerpt(body, String.slice(argument, open + 1, close - open - 1))
    }
  }
  return run codeBlock(language, file, body)
}

/// The blocks of the page whose Markdown is `text`.
pub effect fn load(text: string<'static>) -> List<Block>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut parsed = run parse(text)
  let mut blocks = List<Block>.make()
  while parsed.length() > 0 {
    let block = parsed.remove(0)
    let mut wanted: string<'static> = ""
    if let Block.Directive { name, argument } = &block {
      if name == "source" {
        wanted = argument
      }
    }
    let placed = if wanted == "" {
      move block
    } else {
      run listing(wanted)
    }
    run blocks.append(move placed)
  }
  return move blocks
}
