//! The home page: what Silk UI is, its three parts, and a program running in the page.
import model { Message, Site }
import prose
import silk.collections.list { List }
import theme {
  BODY, INK, MONO, MUTED, ON_SIGNAL, PANEL, RULE, SIGNAL, SIGNAL_INK, background,
  color, outline, pad, round,
}
import ui_app.css
import ui_app.css { px, Align, Keyword, Property }
import ui_app.lib { Document, Node, Role }

/// One of the three guides, as a card that is a link.
fn card(
  h: &Document<Message>,
  path: string,
  kicker: string,
  title: string,
  body: string,
  action: string,
) -> Node {
  return h.link(
    path,
    &[
      h.style(
        &[
          css.display(Keyword.Flex),
          css.raw(Property.FlexDirection, "column"),
          css.raw(Property.Flex, "1 1 260px"),
          css.raw(Property.TextDecoration, "none"),
          css.rowGap(px(10.0)),
          background(PANEL),
          round(14.0),
        ],
      ),
      h.style(&pad(22.0, 22.0)),
      outline(h, RULE),
      h.hover(
        &[
          css.raw(Property.Transform, "translateY(-2px)"),
          css.raw(Property.BoxShadow, "0 0 0 1.5px var(--signal)"),
        ],
      ),
      h.focusVisible(&[css.raw(Property.BoxShadow, "0 0 0 2px var(--signal)")]),
    ],
    &[
      h.box(
        &[
          h.style(
            &[
              css.fontFamily(MONO),
              css.fontSize(px(11.0)),
              css.fontWeight(500.0),
              css.letterSpacing("0.1em"),
              css.textTransform("uppercase"),
              color(SIGNAL_INK),
            ],
          ),
        ],
        &[h.text(kicker)],
      ),
      h.box(
        &[h.style(&[color(INK), css.fontSize(px(21.0)), css.fontWeight(650.0)])],
        &[h.text(title)],
      ),
      h.box(
        &[
          h.style(
            &[
              color(BODY),
              css.fontSize(px(15.0)),
              css.raw(Property.LineHeight, "1.6"),
              css.raw(Property.Flex, "1 1 auto"),
            ],
          ),
        ],
        &[h.text(body)],
      ),
      h.box(
        &[h.style(&[color(SIGNAL_INK), css.fontSize(px(14.5)), css.fontWeight(600.0)])],
        &[h.text(action)],
      ),
    ],
  )
}

/// A band of the stack picture: a name and what it does.
fn layer(h: &Document<Message>, name: string, body: string, strong: bool) -> Node {
  let surface = if strong {
    PANEL
  } else {
    "transparent"
  }
  return h.row(
    &[
      h.style(
        &[
          css.alignItems(Align.Baseline),
          css.columnGap(px(18.0)),
          css.raw(Property.FlexWrap, "wrap"),
          css.rowGap(px(4.0)),
          background(surface),
          round(10.0),
        ],
      ),
      h.style(&pad(14.0, 18.0)),
      outline(h, RULE),
    ],
    &[
      h.box(
        &[
          h.style(
            &[
              color(INK),
              css.fontWeight(650.0),
              css.fontSize(px(15.5)),
              css.raw(Property.Flex, "0 0 190px"),
            ],
          ),
        ],
        &[h.text(name)],
      ),
      h.box(
        &[
          h.style(
            &[
              color(BODY),
              css.fontSize(px(15.0)),
              css.raw(Property.LineHeight, "1.55"),
              css.raw(Property.Flex, "1 1 320px"),
            ],
          ),
        ],
        &[h.text(body)],
      ),
    ],
  )
}

fn sectionTitle(h: &Document<Message>, text: string) -> Node {
  return h.box(
    &[
      h.accessRole(Role.Heading),
      h.style(
        &[
          color(INK),
          css.fontSize(px(26.0)),
          css.fontWeight(680.0),
          css.letterSpacing("-0.02em"),
          css.marginTop(px(72.0)),
        ],
      ),
    ],
    &[h.text(text)],
  )
}

fn sectionLead(h: &Document<Message>, text: string) -> Node {
  let mut nodes = List<Node>.make()
  prose.inline(h, text, &mut nodes)
  return h.box(
    &[
      h.style(
        &[
          color(BODY),
          css.fontSize(px(16.5)),
          css.raw(Property.LineHeight, "1.65"),
          css.marginTop(px(12.0)),
          css.maxWidth(px(720.0)),
        ],
      ),
    ],
    nodes.asSlice(),
  )
}

pub fn view(model: &Site, h: &Document<Message>) -> Node {
  return h.column(
    &[
      h.accessRole(Role.Main),
      h.style(
        &[
          css.maxWidth(px(1040.0)),
          css.raw(Property.Margin, "0 auto"),
          css.raw(Property.Padding, "clamp(40px, 8vw, 96px) clamp(18px, 4vw, 48px) 110px"),
        ],
      ),
    ],
    &[
      h.box(
        &[
          h.accessRole(Role.Heading),
          h.style(
            &[
              color(INK),
              css.raw(Property.FontSize, "clamp(38px, 7vw, 68px)"),
              css.fontWeight(700.0),
              css.raw(Property.LineHeight, "1.02"),
              css.letterSpacing("-0.045em"),
            ],
          ),
        ],
        &[h.text("Silk UI"), h.span(&[h.style(&[color(SIGNAL)])], &[h.text(".")])],
      ),
      h.box(
        &[
          h.style(
            &[
              color(BODY),
              css.raw(Property.FontSize, "clamp(18px, 2.4vw, 22px)"),
              css.raw(Property.LineHeight, "1.5"),
              css.marginTop(px(20.0)),
              css.maxWidth(px(680.0)),
            ],
          ),
        ],
        &[
          h.text(
            "Write an app as a model, an update function and a view. Run it in a browser tab or in a native window, from the same code, with no browser engine inside.",
          ),
        ],
      ),
      h.row(
        &[
          h.style(
            &[
              css.columnGap(px(12.0)),
              css.rowGap(px(12.0)),
              css.raw(Property.FlexWrap, "wrap"),
              css.marginTop(px(28.0)),
            ],
          ),
        ],
        &[
          h.link(
            "/core/",
            &[
              h.style(
                &[
                  background(SIGNAL),
                  color(ON_SIGNAL),
                  css.fontWeight(600.0),
                  css.fontSize(px(15.5)),
                  css.raw(Property.TextDecoration, "none"),
                  round(10.0),
                ],
              ),
              h.style(&pad(11.0, 20.0)),
              h.focusVisible(&[css.raw(Property.BoxShadow, "0 0 0 3px var(--signal-soft)")]),
            ],
            &[h.text("Start with the big picture")],
          ),
          h.link(
            "https://github.com/silk-lang/lib-ui",
            &[
              h.style(
                &[
                  color(INK),
                  css.fontWeight(600.0),
                  css.fontSize(px(15.5)),
                  css.raw(Property.TextDecoration, "none"),
                  round(10.0),
                ],
              ),
              h.style(&pad(11.0, 20.0)),
              outline(h, RULE),
              h.hover(&[background(PANEL)]),
            ],
            &[h.text("Source on GitHub")],
          ),
        ],
      ),
      sectionTitle(h, "This is a whole program"),
      sectionLead(
        h,
        "A model holds the state. Messages say what happened. `update` is the only place the state changes, and `view` draws it. The frame below is this exact file running, inside a page that is a Silk UI program too.",
      ),
      prose.demo(h, model, "counter"),
      prose.code(h, model, 0),
      sectionTitle(h, "Three guides, one stack"),
      sectionLead(
        h,
        "Each guide stands on its own. Read the first to build apps, the second to ship them as desktop programs, and the third to use the engine underneath without the framework.",
      ),
      h.row(
        &[
          h.style(
            &[
              css.columnGap(px(16.0)),
              css.rowGap(px(16.0)),
              css.raw(Property.FlexWrap, "wrap"),
              css.marginTop(px(24.0)),
            ],
          ),
        ],
        &[
          card(
            h,
            "/core/",
            "Guide 1",
            "Silk UI",
            "The framework. Models, messages, views, styling, commands, subscriptions, routing, composition and tests, each with a program you can click.",
            "Read the guide",
          ),
          card(
            h,
            "/native/",
            "Guide 2",
            "Native apps",
            "The same programs in real windows: menus, file dialogs, several windows, worker threads, the built-in devtools, and tests that need no display.",
            "Open a window",
          ),
          card(
            h,
            "/tree/",
            "Guide 3",
            "The UI tree",
            "The engine underneath: nodes, CSS layout, text, input and paint as a library. Use it directly to host your own framework or to drive a UI from another process.",
            "Meet the tree",
          ),
        ],
      ),
      sectionTitle(h, "How the parts stack"),
      sectionLead(
        h,
        "Your program never talks to a window or a DOM. It returns a view, and a host turns that view into something on screen. Swap the host and the same program runs somewhere else.",
      ),
      h.column(
        &[h.style(&[css.rowGap(px(8.0)), css.marginTop(px(24.0))])],
        &[
          layer(h, "Your program", "A model, an update function and a view. Plain data and pure functions.", true),
          layer(
            h,
            "Silk UI",
            "Runs the loop: delivers messages, performs commands, keeps subscriptions, and diffs each view into patches.",
            false,
          ),
          layer(
            h,
            "A host",
            "In a browser, a small script applies the patches to the DOM. In a native app, the patches go to the UI tree.",
            false,
          ),
          layer(
            h,
            "The UI tree",
            "Lays out with CSS, shapes text, routes pointer and keyboard input the way the web does, and paints with the GPU.",
            false,
          ),
          layer(h, "A window", "One OS window per root, on macOS, Windows and Linux.", false),
        ],
      ),
      h.box(
        &[h.style(&[color(MUTED), css.fontSize(px(14.0)), css.marginTop(px(72.0))])],
        &[h.text("This site is a Silk UI program. Every demo on it is the code shown beside it.")],
      ),
    ],
  )
}
