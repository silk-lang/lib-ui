//! The site's model, its messages and its commands.
import demos { Demos, DemoMessage }
import markdown { Block }
import ui_app.lib { CommandSet }
import silk.collections.list { List }
import silk.mem.allocator { OutOfMemoryError }

/// No block: nothing was copied lately.
pub const NO_BLOCK: u32 = 4294967295

pub struct Site {
  /// The page shown: an index into `pages`, or `pages.NOT_FOUND`.
  pub route: u32,
  /// The page's blocks, parsed when the location moved to it.
  pub blocks: List<Block>,
  /// Whether the location has been heard once: the first one is where the site opened.
  pub located: bool,
  /// Whether the menu of a narrow window is open.
  pub menu: bool,
  /// The code block whose text was copied a moment ago.
  pub copied: u32,
  pub demos: Demos,
}

pub union Message {
  /// The location is the page `route` now.
  ChangedLocation { pub route: u32 },
  ClickedMenu,
  ClickedTheme,
  ClickedCopy { pub block: u32 },
  /// The "Copied" label was up long enough.
  CopyNoticeExpired,
  /// The page did what a command asked; nothing to remember.
  CompletedPageRequest,
  GotDemoMessage { pub message: DemoMessage },
}

/// What the page the program runs in does for it. `main.silk` provides the real one, and
/// one that does nothing for the build that draws the pages ahead of time.
pub service Browser {
  effect fn setTitle(title: string) -> () ? &mut Browser

  effect fn copy(text: string) -> () ? &mut Browser

  /// Switches between the light and the dark colors, and remembers the choice.
  effect fn toggleTheme() -> () ? &mut Browser

  effect fn scrollToTop() -> () ? &mut Browser
}

pub union Command {
  SetTitle { pub title: string<'static> },
  Copy { pub text: string<'static> },
  ToggleTheme,
  ScrollToTop,
}

impl CommandSet<Message ? &mut Browser> for Command {
  effect fn execute(self: Self) -> Message
    ! OutOfMemoryError
    ? &mut Browser {
    match move self {
      Command.SetTitle { title } => {
        run Browser.setTitle(title)
      }
      Command.Copy { text } => {
        run Browser.copy(text)
      }
      Command.ToggleTheme => {
        run Browser.toggleTheme()
      }
      Command.ScrollToTop => {
        run Browser.scrollToTop()
      }
    }
    return Message.CompletedPageRequest
  }
}
