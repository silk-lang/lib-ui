//! The pages of the site: where each one is, which guide it belongs to, and its text.
import markdown { titleOf }
import silk.build.source { Source }
import silk.core.ownership { Copy }
import silk.text.string { String }

/// The guides, in the order the top bar lists them.
pub const CORE: u32 = 0

pub const NATIVE: u32 = 1

pub const TREE: u32 = 2

/// The home page belongs to no guide.
pub const NO_GUIDE: u32 = 3

pub const GUIDES: u32 = 3

/// The route of a location that is no page.
pub const NOT_FOUND: u32 = 4294967295

pub const HOME: u32 = 0

pub struct Page {
  /// The page's path, with the slash it ends with: `"/core/views/"`.
  pub path: string<'static>,
  pub guide: u32,
  /// The page's Markdown. Empty for the home page, which is a view of its own.
  pub source: string<'static>,
}

impl Copy for Page {}

pub const COUNT: u32 = 25

/// Page `index`, in reading order. `Source.text` takes its path as a literal, so each page
/// has its own line.
pub fn page(index: u32) -> Page {
  if index == 1 {
    return Page { path: "/core/", guide: CORE, source: Source.text("content/core/first-program.md") }
  }
  if index == 2 {
    return Page { path: "/core/how-it-runs/", guide: CORE, source: Source.text("content/core/how-it-runs.md") }
  }
  if index == 3 {
    return Page { path: "/core/views/", guide: CORE, source: Source.text("content/core/views.md") }
  }
  if index == 4 {
    return Page { path: "/core/styling/", guide: CORE, source: Source.text("content/core/styling.md") }
  }
  if index == 5 {
    return Page { path: "/core/events/", guide: CORE, source: Source.text("content/core/events.md") }
  }
  if index == 6 {
    return Page { path: "/core/commands/", guide: CORE, source: Source.text("content/core/commands.md") }
  }
  if index == 7 {
    return Page { path: "/core/subscriptions/", guide: CORE, source: Source.text("content/core/subscriptions.md") }
  }
  if index == 8 {
    return Page { path: "/core/routing/", guide: CORE, source: Source.text("content/core/routing.md") }
  }
  if index == 9 {
    return Page { path: "/core/composition/", guide: CORE, source: Source.text("content/core/composition.md") }
  }
  if index == 10 {
    return Page { path: "/core/testing/", guide: CORE, source: Source.text("content/core/testing.md") }
  }
  if index == 11 {
    return Page { path: "/core/browser/", guide: CORE, source: Source.text("content/core/browser.md") }
  }
  if index == 12 {
    return Page { path: "/native/", guide: NATIVE, source: Source.text("content/native/first-window.md") }
  }
  if index == 13 {
    return Page { path: "/native/shell/", guide: NATIVE, source: Source.text("content/native/shell.md") }
  }
  if index == 14 {
    return Page { path: "/native/windows/", guide: NATIVE, source: Source.text("content/native/windows.md") }
  }
  if index == 15 {
    return Page { path: "/native/background-work/", guide: NATIVE, source: Source.text("content/native/background-work.md") }
  }
  if index == 16 {
    return Page { path: "/native/devtools/", guide: NATIVE, source: Source.text("content/native/devtools.md") }
  }
  if index == 17 {
    return Page { path: "/native/testing/", guide: NATIVE, source: Source.text("content/native/testing.md") }
  }
  if index == 18 {
    return Page { path: "/tree/", guide: TREE, source: Source.text("content/tree/first-tree.md") }
  }
  if index == 19 {
    return Page { path: "/tree/nodes-and-styles/", guide: TREE, source: Source.text("content/tree/nodes-and-styles.md") }
  }
  if index == 20 {
    return Page { path: "/tree/events/", guide: TREE, source: Source.text("content/tree/events.md") }
  }
  if index == 21 {
    return Page { path: "/tree/text-input/", guide: TREE, source: Source.text("content/tree/text-input.md") }
  }
  if index == 22 {
    return Page { path: "/tree/window/", guide: TREE, source: Source.text("content/tree/window.md") }
  }
  if index == 23 {
    return Page { path: "/tree/protocol/", guide: TREE, source: Source.text("content/tree/protocol.md") }
  }
  if index == 24 {
    return Page { path: "/tree/inspecting/", guide: TREE, source: Source.text("content/tree/inspecting.md") }
  }
  return Page { path: "/", guide: NO_GUIDE, source: "" }
}

pub fn title(index: u32) -> string<'static> {
  if index == HOME {
    return "Silk UI"
  }
  if index >= COUNT {
    return "Page not found"
  }
  return titleOf(page(index).source)
}

pub fn guideName(guide: u32) -> string<'static> {
  if guide == CORE {
    return "Silk UI"
  }
  if guide == NATIVE {
    return "Native apps"
  }
  return "UI tree"
}

/// The first page of `guide`.
pub fn guideStart(guide: u32) -> u32 {
  let mut index: u32 = 0
  while index < COUNT {
    if page(index).guide == guide {
      return index
    }
    index = index + 1
  }
  return HOME
}

/// The page at `path`. A query, a fragment and the last slash do not count.
pub fn routeAt(path: string) -> u32 {
  let bytes = String.utf8Bytes(path)
  let mut length: usize = 0
  while length < bytes.length && bytes[length] != 63 && bytes[length] != 35 {
    length = length + 1
  }
  while length > 1 && bytes[length - 1] == 47 {
    length = length - 1
  }
  let wanted = String.slice(path, 0, length)
  let mut index: u32 = 0
  while index < COUNT {
    let own = page(index).path
    let ownLength = String.byteLength(own)
    let trimmed = if ownLength > 1 {
      String.slice(own, 0, ownLength - 1)
    } else {
      own
    }
    if trimmed == wanted {
      return index
    }
    index = index + 1
  }
  return NOT_FOUND
}
