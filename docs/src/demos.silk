//! The examples that run in the pages. Each is a whole `Program` from `docs/examples`, kept
//! in the site's model and driven by the site's own update: the code a page shows is the code
//! that runs under it.
import examples.core.counter as counter
import examples.core.counter { Counter }
import examples.core.dice as dice
import examples.core.dice { Dice }
import silk.system.random { Random }
import examples.core.menu as menu
import examples.core.menu { Cafe }
import examples.core.order as order
import examples.core.order { Order }
import examples.core.plans as plans
import examples.core.plans { Plans }
import examples.core.stopwatch as stopwatch
import examples.core.stopwatch { Stopwatch }
import examples.core.todo as todo
import examples.showcase.board as board
import examples.showcase.board { Board }
import examples.focus.step1 as step1
import examples.focus.step2 as step2
import examples.focus.step3 as step3
import examples.focus.step4 as step4
import examples.focus.step4 { Clock }
import examples.core.todo { Todo }
import ui_app.lib {
  CommandSet,
  Document,
  Node,
  NoCommand,
  NoOutput,
  Program,
  Subscriptions,
  Update
}
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }

pub struct Demos {
  pub counter: Counter,
  pub menu: Cafe,
  pub plans: Plans,
  pub todo: Todo,
  pub board: Board,
  pub dice: Dice,
  pub stopwatch: Stopwatch,
  pub order: Order,
  /// The four stages of the tutorial's app.
  pub focus1: step1.Focus,
  pub focus2: step2.Focus,
  pub focus3: step3.Focus,
  pub focus4: step4.Focus,
}

pub union DemoMessage {
  Counter { pub message: counter.Message },
  Menu { pub message: menu.Message },
  Plans { pub message: plans.Message },
  Todo { pub message: todo.Message },
  Board { pub message: board.Message },
  Dice { pub message: dice.Message },
  Stopwatch { pub message: stopwatch.Message },
  Order { pub message: order.Message },
  Focus1 { pub message: step1.Message },
  Focus2 { pub message: step2.Message },
  Focus3 { pub message: step3.Message },
  Focus4 { pub message: step4.Message },
}

/// A command of a demo. The dice and the last stage of the tutorial have some.
pub union DemoCommand {
  Dice { pub command: dice.Command },
  Focus4 { pub command: step4.Command },
}

impl CommandSet<DemoMessage ? &mut Random | &mut Clock> for DemoCommand {
  effect fn execute(self: Self) -> DemoMessage
    ! OutOfMemoryError
    ? &mut Random | &mut Clock {
    match move self {
      DemoCommand.Dice { command } => {
        return DemoMessage.Dice { message: run CommandSet.execute(move command) }
      }
      DemoCommand.Focus4 { command } => {
        return DemoMessage.Focus4 { message: run CommandSet.execute(move command) }
      }
    }
  }
}

/// The first model of program `P`.
effect fn begin<P: Program<M, C>, M, C>() -> P
  ! OutOfMemoryError
  ? &mut Allocator {
  let first: Update<P, C, NoOutput> = run Program.init()
  return move first.model
}

/// Runs the update of the program at `place`, where it lies, and returns its commands.
effect fn step<P: Program<M, C>, M, C>(place: &mut P, message: M) -> List<C>
  ! OutOfMemoryError
  ? &mut Allocator {
  let pointer = Pointer.fromMutRef(&mut place.*)

  // The model is moved out, updated, and put back before anything else can see the hole.
  let before = unsafe Pointer.take(pointer)
  let next: Update<P, C, NoOutput> = run Program.update(move before, move message)
  unsafe Pointer.put(pointer, move next.model)
  return move next.commands
}

pub effect fn start() -> Demos
  ! OutOfMemoryError
  ? &mut Allocator {
  return Demos {
    counter: run begin<Counter, counter.Message, NoCommand>(),
    menu: run begin<Cafe, menu.Message, NoCommand>(),
    plans: run begin<Plans, plans.Message, NoCommand>(),
    todo: run begin<Todo, todo.Message, NoCommand>(),
    board: run begin<Board, board.Message, NoCommand>(),
    dice: run begin<Dice, dice.Message, dice.Command>(),
    stopwatch: run begin<Stopwatch, stopwatch.Message, NoCommand>(),
    order: run begin<Order, order.Message, NoCommand>(),
    focus1: run begin<step1.Focus, step1.Message, NoCommand>(),
    focus2: run begin<step2.Focus, step2.Message, NoCommand>(),
    focus3: run begin<step3.Focus, step3.Message, NoCommand>(),
    focus4: run begin<step4.Focus, step4.Message, step4.Command>(),
  }
}

/// Updates the demo `message` is for, and returns the commands it asks for.
pub effect fn update(demos: &mut Demos, message: DemoMessage) -> List<DemoCommand>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut commands = List<DemoCommand>.make()
  match move message {
    DemoMessage.Counter { message: inner } => {
      drop run step<Counter, counter.Message, NoCommand>(&mut demos.counter, move inner)
    }
    DemoMessage.Menu { message: inner } => {
      drop run step<Cafe, menu.Message, NoCommand>(&mut demos.menu, move inner)
    }
    DemoMessage.Plans { message: inner } => {
      drop run step<Plans, plans.Message, NoCommand>(&mut demos.plans, move inner)
    }
    DemoMessage.Todo { message: inner } => {
      drop run step<Todo, todo.Message, NoCommand>(&mut demos.todo, move inner)
    }
    DemoMessage.Board { message: inner } => {
      drop run step<Board, board.Message, NoCommand>(&mut demos.board, move inner)
    }
    DemoMessage.Dice { message: inner } => {
      let mut asked = run step<Dice, dice.Message, dice.Command>(&mut demos.dice, move inner)
      while asked.length() > 0 {
        run commands.append(DemoCommand.Dice { command: asked.remove(0) })
      }
    }
    DemoMessage.Stopwatch { message: inner } => {
      drop run step<Stopwatch, stopwatch.Message, NoCommand>(&mut demos.stopwatch, move inner)
    }
    DemoMessage.Order { message: inner } => {
      drop run step<Order, order.Message, NoCommand>(&mut demos.order, move inner)
    }
    DemoMessage.Focus1 { message: inner } => {
      drop run step<step1.Focus, step1.Message, NoCommand>(&mut demos.focus1, move inner)
    }
    DemoMessage.Focus2 { message: inner } => {
      drop run step<step2.Focus, step2.Message, NoCommand>(&mut demos.focus2, move inner)
    }
    DemoMessage.Focus3 { message: inner } => {
      drop run step<step3.Focus, step3.Message, NoCommand>(&mut demos.focus3, move inner)
    }
    DemoMessage.Focus4 { message: inner } => {
      let mut asked = run step<step4.Focus, step4.Message, step4.Command>(&mut demos.focus4, move inner)
      while asked.length() > 0 {
        run commands.append(DemoCommand.Focus4 { command: asked.remove(0) })
      }
    }
  }
  return move commands
}

/// The view of the demo called `name`, or nothing when there is none.
pub fn view(demos: &Demos, name: string, h: &Document<DemoMessage>) -> Node {
  if name == "counter" {
    return h.map(
      |inner: &Document<counter.Message>| Program.view(&demos.counter, inner),
      |message| DemoMessage.Counter { message: move message },
    )
  }
  if name == "menu" {
    return h.map(
      |inner: &Document<menu.Message>| Program.view(&demos.menu, inner),
      |message| DemoMessage.Menu { message: move message },
    )
  }
  if name == "plans" {
    return h.map(
      |inner: &Document<plans.Message>| Program.view(&demos.plans, inner),
      |message| DemoMessage.Plans { message: move message },
    )
  }
  if name == "board" {
    return h.map(
      |inner: &Document<board.Message>| Program.view(&demos.board, inner),
      |message| DemoMessage.Board { message: move message },
    )
  }
  if name == "todo" {
    return h.map(
      |inner: &Document<todo.Message>| Program.view(&demos.todo, inner),
      |message| DemoMessage.Todo { message: move message },
    )
  }
  if name == "dice" {
    return h.map(
      |inner: &Document<dice.Message>| Program.view(&demos.dice, inner),
      |message| DemoMessage.Dice { message: move message },
    )
  }
  if name == "stopwatch" {
    return h.map(
      |inner: &Document<stopwatch.Message>| Program.view(&demos.stopwatch, inner),
      |message| DemoMessage.Stopwatch { message: move message },
    )
  }
  if name == "order" {
    return h.map(
      |inner: &Document<order.Message>| Program.view(&demos.order, inner),
      |message| DemoMessage.Order { message: move message },
    )
  }
  if name == "focus-1" {
    return h.map(
      |inner: &Document<step1.Message>| Program.view(&demos.focus1, inner),
      |message| DemoMessage.Focus1 { message: move message },
    )
  }
  if name == "focus-2" {
    return h.map(
      |inner: &Document<step2.Message>| Program.view(&demos.focus2, inner),
      |message| DemoMessage.Focus2 { message: move message },
    )
  }
  if name == "focus-3" {
    return h.map(
      |inner: &Document<step3.Message>| Program.view(&demos.focus3, inner),
      |message| DemoMessage.Focus3 { message: move message },
    )
  }
  if name == "focus-4" {
    return h.map(
      |inner: &Document<step4.Message>| Program.view(&demos.focus4, inner),
      |message| DemoMessage.Focus4 { message: move message },
    )
  }
  return h.empty()
}

/// Whether a demo called `name` exists.
pub fn exists(name: string) -> bool {
  return name == "counter" || name == "menu" || name == "plans" || name == "todo" || name == "board" || name == "dice" || name == "stopwatch" || name == "order" || name == "focus-1" || name == "focus-2" || name == "focus-3" || name == "focus-4"
}

/// The subscriptions of the demos.
pub fn subscriptions(demos: &Demos, subs: &mut Subscriptions<DemoMessage>) -> () {
  subs.lift(
    1,
    |inner: &mut Subscriptions<stopwatch.Message>| Program.subscriptions(&demos.stopwatch, &mut inner),
    |message| DemoMessage.Stopwatch { message: move message },
  )
  subs.lift(
    2,
    |inner: &mut Subscriptions<step3.Message>| Program.subscriptions(&demos.focus3, &mut inner),
    |message| DemoMessage.Focus3 { message: move message },
  )
  subs.lift(
    3,
    |inner: &mut Subscriptions<step4.Message>| Program.subscriptions(&demos.focus4, &mut inner),
    |message| DemoMessage.Focus4 { message: move message },
  )
}
