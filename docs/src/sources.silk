//! The source text of the examples, for the docs to show.
import silk.build.source { Source }
import silk.core.option { Option }

/// The text of the example file `name`, a path under `docs/examples`.
pub fn source(name: string) -> Option<string<'static>> {
  if name == "src/core/counter.silk" {
    return Option<string<'static>>.Some { value: Source.text("examples/src/core/counter.silk") }
  }
  return Option<string<'static>>.None
}
