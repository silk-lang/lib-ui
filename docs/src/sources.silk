//! The source text of the examples, for the docs to show. Every file a page lists with
//! `::source` has a line here, because `Source.text` takes its path as a literal.
import silk.build.source { Source }
import silk.core.option { Option }

/// The text of the file `name`, a path under `docs/`.
pub fn source(name: string) -> Option<string<'static>> {
  if name == "examples/src/focus/look.silk" {
    return Option<string<'static>>.Some { value: Source.text("examples/src/focus/look.silk") }
