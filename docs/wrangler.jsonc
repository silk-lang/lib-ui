// The docs site on Cloudflare: a Worker with no code, only the static files docs/build.sh
// writes into docs/dist.
{
  "name": "silk-ui-docs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
